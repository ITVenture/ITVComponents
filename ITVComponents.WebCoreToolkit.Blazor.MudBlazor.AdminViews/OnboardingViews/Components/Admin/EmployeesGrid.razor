@using Microsoft.AspNetCore.Components.Authorization

@inject IOnboardingAdminHandler Handler
@inject AuthenticationStateProvider AuthState
@inject IDialogService DialogService
@inject ISnackbar Snackbar

<MudDataGrid T="EmployeeViewModel" Items="employees" Dense="true" Hover="true">
    <ToolBarContent>
        <RefreshButton OnClick="Reload" />
        <MudText Typo="Typo.subtitle2">Employees</MudText>
        <MudSpacer />
        <MudButton StartIcon="@Icons.Material.Filled.Add" Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small" OnClick="Add">
            Add employee
        </MudButton>
    </ToolBarContent>
    <Columns>
        <PropertyColumn Property="x => x.EMail" Title="Email" />
        <PropertyColumn Property="x => x.FirstName" Title="First name" />
        <PropertyColumn Property="x => x.LastName" Title="Last name" />
        <PropertyColumn Property="x => x.InvitationStatus" Title="Status" />
        <TemplateColumn T="EmployeeViewModel" Title="" Sortable="false">
            <CellTemplate>
                <MudStack Row="true" Spacing="1">
                    <MudIconButton Icon="@Icons.Material.Filled.AdminPanelSettings" Size="Size.Small" Title="Roles" OnClick="@(() => ManageRoles(context.Item))" />
                    <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" OnClick="@(() => Edit(context.Item))" />
                    <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" Size="Size.Small" OnClick="@(() => Delete(context.Item))" />
                </MudStack>
            </CellTemplate>
        </TemplateColumn>
    </Columns>
</MudDataGrid>

@code {
    [Parameter, EditorRequired] public int BillingProfileId { get; set; }

    private System.Security.Claims.ClaimsPrincipal? currentUser;
    private EmployeeViewModel[] employees = Array.Empty<EmployeeViewModel>();

    protected override async Task OnInitializedAsync()
    {
        var auth = await AuthState.GetAuthenticationStateAsync();
        currentUser = auth.User;
        await Reload();
    }

    private async Task Reload()
    {
        if (currentUser is null)
        {
            return;
        }

        employees = await Handler.ListEmployeesAsync(currentUser, BillingProfileId);
    }

    private async Task Add()
    {
        var model = new EmployeeViewModel { BillingProfileId = BillingProfileId, InvitationStatus = InvitationStatus.Pending };
        await ShowEditor(model, "Add employee");
    }

    private async Task Edit(EmployeeViewModel employee)
    {
        var copy = new EmployeeViewModel
        {
            EmployeeId = employee.EmployeeId,
            BillingProfileId = employee.BillingProfileId,
            TenantId = employee.TenantId,
            FirstName = employee.FirstName,
            LastName = employee.LastName,
            EMail = employee.EMail,
            InvitationStatus = employee.InvitationStatus
        };
        await ShowEditor(copy, "Edit employee");
    }

    private async Task ShowEditor(EmployeeViewModel model, string title)
    {
        var parameters = new DialogParameters<EmployeeDialog> { { d => d.Model, model } };
        var dlg = await DialogService.ShowAsync<EmployeeDialog>(title, parameters, EditDialogDefaults.Edit);
        var result = await dlg.Result;
        if (result is { Canceled: false, Data: EmployeeViewModel input } && currentUser is not null)
        {
            var id = await Handler.SaveEmployeeAsync(currentUser, input);
            if (id is not null) { Snackbar.Add("Employee saved", Severity.Success); await Reload(); }
            else Snackbar.Add("Failed to save employee", Severity.Error);
        }
    }

    private async Task Delete(EmployeeViewModel employee)
    {
        if (currentUser is null) return;
        var ok = await DialogService.ShowMessageBoxAsync("Delete employee", $"Really delete '{employee.EMail}'?", yesText: "Delete", cancelText: "Cancel");
        if (ok != true) return;
        var success = await Handler.DeleteEmployeeAsync(currentUser, employee.EmployeeId);
        if (success) { Snackbar.Add("Employee deleted", Severity.Success); await Reload(); }
        else Snackbar.Add("Failed to delete employee", Severity.Error);
    }

    private async Task ManageRoles(EmployeeViewModel employee)
    {
        var parameters = new DialogParameters<EmployeeRolesDialog>
        {
            { d => d.EmployeeId, employee.EmployeeId },
            { d => d.EmployeeLabel, string.IsNullOrWhiteSpace(employee.EMail) ? $"{employee.FirstName} {employee.LastName}".Trim() : employee.EMail }
        };
        var dlg = await DialogService.ShowAsync<EmployeeRolesDialog>("Employee roles", parameters, EditDialogDefaults.Edit);
        await dlg.Result;
    }
}
