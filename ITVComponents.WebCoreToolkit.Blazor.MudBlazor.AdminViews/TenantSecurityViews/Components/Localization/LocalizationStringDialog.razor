<EditDialogShell Model="Model" IsCreate="IsCreate" InvalidMessage="Please correct invalid fields">
    <MudTextField @bind-Value="Model.LocalizationKey" Label="Key" Required="true" MaxLength="256" />
    <MudTextField @bind-Value="Model.LocalizationValue" Label="Value" Required="true" Lines="4" />
</EditDialogShell>

@code {
    [Parameter, EditorRequired] public LocalizationStringViewModel Model { get; set; } = default!;
    [Parameter] public bool IsCreate { get; set; }
}
