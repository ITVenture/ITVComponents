@page "/Workflow/Definitions"
@page "/Workflow/env/{Environment}/Definitions"
@rendermode @(RenderMode.InteractiveServer)
@attribute [Microsoft.AspNetCore.Authorization.Authorize]

@inject IWorkflowDesignHandler Handler
@inject AuthenticationStateProvider AuthState
@inject NavigationManager Nav
@inject IJSRuntime JS
@inject ISnackbar Snackbar
@using ITVComponents.Helpers
@using ITVComponents.Logging

<PageTitle>Workflow definitions</PageTitle>

<MudText Typo="Typo.h5" GutterBottom="true">Workflow definitions</MudText>

<SecureView RequiredPermissions="Workflow.Design" RequiredFeatures="ITVWorkflow">
    <Permitted>
        @if (currentUser is null)
        {
            <MudProgressCircular Indeterminate="true" />
        }
        else
        {
            <MudDataGrid T="WorkflowDefinitionListItem"
                         @ref="grid"
                         ServerData="LoadData"
                         SortMode="SortMode.Single"
                         RowsPerPage="25"
                         Hover="true"
                         Dense="true">
                <ToolBarContent>
                    <MudIconButton Icon="@Icons.Material.Filled.Refresh" Title="Refresh" OnClick="ReloadGrid" />
                    <MudText Typo="Typo.h6">Definitions</MudText>
                    <MudButton StartIcon="@Icons.Material.Filled.Add" Variant="Variant.Filled" Color="Color.Primary"
                               Class="ml-2" Href="@($"{EnvPrefix}/Editor/new")">New</MudButton>
                    @* Umgebungs-Auswahl - nur, wenn die Umgebung NICHT schon aus dem Nav-Segment feststeht. *@
                    @if (Environment is null)
                    {
                        <div class="ml-3">
                            <WorkflowEnvironmentPicker Value="@pickedEnvironment" ValueChanged="OnEnvChanged"
                                                       Required="Designer" />
                        </div>
                    }
                    else
                    {
                        <MudChip T="string" Icon="@Icons.Material.Filled.Dns" Size="Size.Small" Class="ml-3">@Environment</MudChip>
                    }
                    <MudSpacer />
                    <MudTextField @bind-Value="search"
                                  Placeholder="Search name…"
                                  Adornment="Adornment.Start"
                                  AdornmentIcon="@Icons.Material.Filled.Search"
                                  Class="mt-0 ml-2"
                                  DebounceInterval="300"
                                  OnDebounceIntervalElapsed="ReloadGrid" />
                </ToolBarContent>
                <Columns>
                    @* Der Schluessel steht vorn und laesst sich kopieren: er ist der Aufhaenger jeder
                       Aktion und der Wert, den man in Einstellungen hinterlegt. Eine laufende Nummer
                       abzutippen ist die Sorte Fehler, die erst spaeter auffaellt. *@
                    <TemplateColumn T="WorkflowDefinitionListItem" Title="Key" SortBy="x => x.Key">
                        <CellTemplate>
                            <MudStack Row="true" Spacing="0" AlignItems="AlignItems.Center">
                                <MudText Typo="Typo.body2"><b>@context.Item.Key</b></MudText>
                                <MudIconButton Icon="@Icons.Material.Filled.ContentCopy" Size="Size.Small"
                                               Title="Copy key" OnClick="@(() => CopyKey(context.Item))" />
                            </MudStack>
                        </CellTemplate>
                    </TemplateColumn>
                    <PropertyColumn Property="x => x.TechnicalName" Title="Technical name" />
                    <PropertyColumn Property="x => x.Version" Title="Ver" />
                    <PropertyColumn Property="x => x.Name" Title="Name" />
                    <PropertyColumn Property="x => x.NodeCount" Title="Nodes" Sortable="false" />
                    <PropertyColumn Property="x => x.FlowCount" Title="Flows" Sortable="false" />
                    <TemplateColumn T="WorkflowDefinitionListItem" Title="" Sortable="false">
                        <CellTemplate>
                            <MudStack Row="true" Spacing="1">
                                <MudIconButton Icon="@Icons.Material.Filled.AccountTree" Size="Size.Small" Title="Open graph"
                                               OnClick="@(() => OpenGraph(context.Item))" />
                                <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" Title="Edit"
                                               OnClick="@(() => OpenEditor(context.Item))" />
                            </MudStack>
                        </CellTemplate>
                    </TemplateColumn>
                </Columns>
                <PagerContent>
                    <MudDataGridPager T="WorkflowDefinitionListItem" />
                </PagerContent>
            </MudDataGrid>
        }
    </Permitted>
    <NotPermitted>
        <MudAlert Severity="Severity.Warning">No permission to view workflow definitions.</MudAlert>
    </NotPermitted>
</SecureView>

@code {
    /// <summary>Die (optional) über das Nav-Segment fest vorgegebene Umgebung. Null = Auswahl über den Picker.</summary>
    [Parameter] public string? Environment { get; set; }

    private MudDataGrid<WorkflowDefinitionListItem>? grid;
    private ClaimsPrincipal? currentUser;
    private string? search;
    private string? pickedEnvironment;

    /// <summary>Die wirksame Umgebung: das Nav-Segment gewinnt, sonst die Picker-Auswahl.</summary>
    private string? Env => Environment ?? pickedEnvironment;

    /// <summary>URL-Präfix für Navigationsziele - env-scoped, wenn eine Umgebung wirksam ist.</summary>
    private string EnvPrefix => string.IsNullOrEmpty(Env)
        ? "Workflow"
        : $"Workflow/env/{Uri.EscapeDataString(Env!)}";

    protected override async Task OnInitializedAsync()
    {
        var auth = await AuthState.GetAuthenticationStateAsync();
        currentUser = auth.User;
    }

    private async Task<GridData<WorkflowDefinitionListItem>> LoadData(GridState<WorkflowDefinitionListItem> state,
        CancellationToken ct)
    {
        if (currentUser is null)
        {
            return new GridData<WorkflowDefinitionListItem> { Items = Array.Empty<WorkflowDefinitionListItem>(), TotalItems = 0 };
        }

        var sort = state.SortDefinitions.FirstOrDefault();
        var query = new WorkflowListQuery
        {
            Page = state.Page,
            PageSize = state.PageSize,
            SortColumn = sort?.SortBy,
            SortDescending = sort?.Descending ?? false,
            Search = search
        };

        var result = await Handler.ListDefinitionsAsync(currentUser, query, Env);
        return new GridData<WorkflowDefinitionListItem> { Items = result.Items, TotalItems = result.TotalCount };
    }

    private async Task ReloadGrid()
    {
        if (grid is not null)
        {
            await grid.ReloadServerData();
        }
    }

    /// <summary>Umgebung im Picker gewechselt (nur ohne Nav-Segment) - die Liste neu laden.</summary>
    private async Task OnEnvChanged(string? environment)
    {
        pickedEnvironment = environment;
        await ReloadGrid();
    }

    // Ziele bewusst RELATIV (ohne fuehrenden Slash): NavigateTo loest sie gegen die Basis-URI
    // (<base href="/{tenant}/">) auf und bleibt damit im Tenant. Ein fuehrender Slash zielt auf den
    // Root und laeuft in einen 404, weil die Toolkit-Routen tenant-gebunden sind.
    private void OpenGraph(WorkflowDefinitionListItem item)
    {
        Nav.NavigateTo($"{EnvPrefix}/Definitions/{item.Key}");
    }

    private void OpenEditor(WorkflowDefinitionListItem item)
    {
        Nav.NavigateTo($"{EnvPrefix}/Definitions/{item.Key}/edit");
    }

    /// <summary>
    /// Legt den Schluessel in die Zwischenablage. Schlaegt das fehl (kein sicherer Kontext, Berechtigung
    /// verweigert), wird der Wert wenigstens angezeigt - stillschweigend nichts zu tun waere das
    /// Schlimmste, weil der Benutzer dann einen Wert einfuegt, der noch von vorher stammt.
    /// </summary>
    private async Task CopyKey(WorkflowDefinitionListItem item)
    {
        try
        {
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", item.Key.ToString());
            Snackbar.Add($"Key {item.Key} copied", Severity.Success);
        }
        catch (Exception ex)
        {
            LogEnvironment.LogEvent(
                $"Schluessel {item.Key} konnte nicht in die Zwischenablage gelegt werden: {ex.OutlineException()}",
                LogSeverity.Warning);
            Snackbar.Add($"Key is {item.Key} (copying failed)", Severity.Info);
        }
    }
}
