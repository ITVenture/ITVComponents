@using ITVComponents.WebCoreToolkit.Net.TelerikUi.ViewComponents
@{
    var targetView = "Default";
    if (ViewData["permissionId"] is int)
    {
        targetView = "PermissionRolesView";
    }
    else if (ViewData["tenantUserId"] is int)
    {
        targetView = "TenantUserRolesView";
    }
    else if (ViewData["roleId"] is int)
    {
        targetView = "RoleRolesView";
    }
}

@await Component.InvokeAsync(typeof(ShowTable),new{customViewData = new Dictionary<string,object>{{"tenantId", ViewData["tenantId"] },{"permissionId",ViewData["permissionId"]}, { "tenantUserId", ViewData["tenantUserId"] }, {"roleId", ViewData["roleId"]} }, targetView=targetView})