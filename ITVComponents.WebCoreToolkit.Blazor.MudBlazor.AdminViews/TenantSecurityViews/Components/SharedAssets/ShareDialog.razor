@using Microsoft.Extensions.Logging
@using ITVComponents.WebCoreToolkit.Security.SharedAssets

@inject ILogger<ShareDialog> Logger

<EditDialogShell Model="Model" IsCreate="true" CreateLabel="Create link" OnValidated="Share" Result="@(() => created)" Busy="@busy">
    @if (Templates.Length == 0)
    {
        <MudAlert Severity="Severity.Info">There is nothing to share here.</MudAlert>
    }
    else
    {
        @* Value/ValueChanged statt @bind-Value: die Auswahl loescht zusaetzlich die Fehlermeldung, und
           @bind-Value erzeugt selbst ein ValueChanged - beides zusammen ist ein Doppelparameter. *@
        <MudSelect T="string" Value="@Model.TemplateKey" ValueChanged="TemplateChanged" Label="What to share"
                   Required="true" RequiredError="Pick what to share">
            @foreach (var template in Templates)
            {
                <MudSelectItem T="string" Value="@template.TemplateKey">@template.AssetTemplateTitle</MudSelectItem>
            }
        </MudSelect>

        @* Ein ausgeblendetes Pflichtfeld ohne Vorgabe ist ein Fehler AN DER VORLAGE. Er gehoert hierhin,
           wo jemand ihn beim Oeffnen sieht - und nicht ans Ende, wo das Ausstellen wortlos scheitert. *@
        @foreach (var problem in Options.Validate())
        {
            <MudAlert Severity="Severity.Error" Dense="true" Class="mt-2">@problem</MudAlert>
        }

        @if (Options.Title.Shown)
        {
            <MudTextField @bind-Value="Model.Title" Label="Title" Required="true" RequiredError="A title is required"
                          MaxLength="512" Class="mt-2"
                          HelperText="What the recipient sees, and what you will recognise it by later." />
        }

        @* Die Felder kommen aus der Vorlage, in IHRER Reihenfolge. Was die Stelle ueber sich selbst
           weiss, steht schon drin - der Benutzer soll keine Nummer abtippen, die zwei Zentimeter
           weiter oben auf dem Bildschirm steht. Abgefragt wird nur, was danach noch offen ist. *@
        @foreach (var argument in Selected?.Arguments ?? Array.Empty<AssetArgumentDeclaration>())
        {
            var name = argument.Name;
            if (IsKnown(name))
            {
                @* Sichtbar, aber nicht editierbar: der Wert bestimmt, WORAUF der Link zeigt. Ihn hier
                   umbiegen zu koennen hiesse, von einer Seite aus etwas anderes zu teilen als das,
                   was man vor sich hat - und der Riegel wuerde es spaeter ohnehin ablehnen. *@
                <MudTextField T="string" Label="@($"{name} ({argument.Type})")" Class="mt-2"
                              Value="@GetArgument(name)" ReadOnly="true" Variant="Variant.Filled"
                              Adornment="Adornment.End" AdornmentIcon="@Icons.Material.Filled.Link"
                              HelperText="Taken from the page you are sharing." />
            }
            else
            {
                <MudTextField T="string" Label="@($"{name} ({argument.Type})")" Class="mt-2"
                              Required="@argument.Required" RequiredError="@($"{name} is required")"
                              Value="@GetArgument(name)" ValueChanged="@(v => SetArgument(name, v))" />
            }
        }

        @if (Options.Recipient.Shown)
        {
            <MudTextField @bind-Value="Model.RecipientLabel" Label="Recipient" MaxLength="256" Class="mt-2"
                          HelperText="Optional, for your own records. It is a note, not a proof of identity." />
        }

        @if (Options.AdHoc.Shown)
        {
            <MudSwitch T="bool" @bind-Value="Model.AdHoc" Label="Temporary - store nothing" Color="Color.Warning"
                       Class="mt-2" />
        }
        @if (Model.AdHoc)
        {
            @if (Options.Lifetime.Shown)
            {
                <MudNumericField T="int?" @bind-Value="Model.LifetimeMinutes" Label="Valid for (minutes)" Min="1"
                                 HelperText="Empty uses the template's maximum, which is also the upper limit." />
            }
            <MudAlert Severity="Severity.Info" Dense="true" Class="mt-1">
                Nothing is stored: the whole share travels encrypted inside the link. It can not be taken
                back one by one - it ends on its own.
            </MudAlert>
        }

        @if (Options.Anonymous.Shown)
        {
            <MudSwitch T="bool" @bind-Value="Model.Anonymous" Label="Works without signing in" Color="Color.Warning"
                       Class="mt-2" />
        }
        @if (Model.Anonymous)
        {
            <MudAlert Severity="Severity.Warning" Dense="true" Class="mt-1">
                Everyone holding this link gets in. Give it a validity window and treat it like a password.
            </MudAlert>
        }

        @* Die Reichweite entscheidet, wer an die Daten kommt - deshalb ohne Vorbelegung. Ein anonymer
           Link braucht sie nicht: dort IST "ohne Anmeldung" die Reichweite. Ein Ad-hoc-Ticket auch
           nicht: es wird nirgends gespeichert, seine Rechte kommen aus der Vorlage. *@
        @if (!Model.Anonymous && !Model.AdHoc && Options.Reach.Shown)
        {
            <MudSelect T="ShareReach?" Value="@Model.Reach" ValueChanged="ReachChanged" Label="Who can use this"
                       Required="true" RequiredError="Pick who can use this" Class="mt-2">
                <MudSelectItem T="ShareReach?" Value="@(ShareReach.AnyoneSignedIn)">Anyone signed in who has the link</MudSelectItem>
                <MudSelectItem T="ShareReach?" Value="@(ShareReach.Recipients)">Only these users</MudSelectItem>
                <MudSelectItem T="ShareReach?" Value="@(ShareReach.Tenants)">Only members of these tenants</MudSelectItem>
            </MudSelect>

            @if (Model.Reach == ShareReach.AnyoneSignedIn)
            {
                <MudAlert Severity="Severity.Warning" Dense="true" Class="mt-1">
                    Anyone with an account gets in, no matter which tenant they belong to. They work inside
                    this tenant while they are here.
                </MudAlert>
            }
            else if (Model.Reach == ShareReach.Recipients)
            {
                <FilterList Values="Model.UserFilters" Placeholder="User identification" />
            }
            else if (Model.Reach == ShareReach.Tenants)
            {
                <FilterList Values="Model.TenantFilters" Placeholder="Tenant" />
            }
        }

        @if (!string.IsNullOrEmpty(error))
        {
            <MudAlert Severity="Severity.Error" Dense="true" Class="mt-2">@error</MudAlert>
        }
    }
</EditDialogShell>

@code {
    [Parameter, EditorRequired] public ShareRequestViewModel Model { get; set; } = default!;
    [Parameter, EditorRequired] public AssetTemplateInfo[] Templates { get; set; } = Array.Empty<AssetTemplateInfo>();

    /// <summary>
    /// Legt die Freigabe an. Der Rueckgabewert entscheidet, ob der Dialog schliesst - bei einer
    /// abgelehnten Eingabe bleibt er stehen und zeigt, was fehlt.
    /// </summary>
    [Parameter, EditorRequired] public Func<ShareRequestViewModel, Task<ShareResultViewModel>> OnShare { get; set; } = default!;

    private AssetTemplateInfo? Selected =>
        Array.Find(Templates, n => n.TemplateKey == Model.TemplateKey);

    /// <summary>
    /// Was die GEWAEHLTE Vorlage vorgibt. Ohne Auswahl der heutige Dialog - dann steht ohnehin nur die
    /// Vorlagenauswahl da.
    /// </summary>
    /// <remarks>
    /// Einmal je Vorlage gedeutet und gemerkt: die Eigenschaft wird beim Zeichnen mehrfach gelesen, und
    /// jedes Lesen waere sonst ein JSON-Durchgang.
    /// </remarks>
    private ShareDialogOptions Options
    {
        get
        {
            var key = Selected?.TemplateKey;
            if (optionsResolved && key == optionsFor)
            {
                return options;
            }

            optionsResolved = true;
            optionsFor = key;
            options = ShareDialogOptions.Parse(Selected?.ShareDialogConfig, out var optionError);
            if (optionError != null)
            {
                // Fehlertolerant gedeutet - aber nicht stillschweigend. Sonst sucht jemand lange, warum
                // seine Vorgaben nicht ankommen.
                Logger.LogError("The sharing-form settings of template '{Template}' could not be read and are ignored: {Reason}",
                    key, optionError);
            }

            return options;
        }
    }

    /// <summary>Fuer welche Vorlage <c>options</c> gilt - und ob ueberhaupt schon fuer eine.</summary>
    private bool optionsResolved;
    private string? optionsFor;
    private ShareDialogOptions options = ShareDialogOptions.Default;

    private string? error;
    private bool busy;
    private bool defaultsApplied;

    /// <summary>
    /// Das Ergebnis der Freigabe - es ist die Nutzlast beim Schliessen. Der Link entsteht hier und wird
    /// nicht ein zweites Mal geholt: ein zweiter Aufruf wuerde bei einem anonymen Link ein NEUES Token
    /// erzeugen wollen oder schlicht den falschen Schluessel benutzen.
    /// </summary>
    private ShareResultViewModel? created;

    protected override void OnParametersSet()
    {
        if (string.IsNullOrEmpty(Model.TemplateKey) && Templates.Length == 1)
        {
            // Gibt es nur eine Moeglichkeit, ist die Auswahl keine Frage.
            Model.TemplateKey = Templates[0].TemplateKey;
        }

        if (!defaultsApplied)
        {
            // Einmal beim Oeffnen. OnParametersSet laeuft mehrfach, und ein zweiter Durchgang wuerde
            // zurueckschreiben, was der Benutzer inzwischen geaendert hat.
            defaultsApplied = true;
            ApplyTemplateDefaults();
        }

        ApplyPathValues();
    }

    private void TemplateChanged(string value)
    {
        Model.TemplateKey = value;
        error = null;
        ApplyTemplateDefaults();
        ApplyPathValues();
    }

    /// <summary>
    /// Uebernimmt die Vorgaben der gewaehlten Vorlage ins Modell.
    /// </summary>
    /// <remarks>
    /// <b>Auch fuer die ausgeblendeten Felder</b> - ausgeblendet heisst ja nicht "ohne Wert", sondern
    /// "die Vorlage hat schon entschieden". Genau deshalb ist ein ausgeblendetes Pflichtfeld ohne
    /// Vorgabe ein Konfigurationsfehler und keine leere Eingabe.
    /// <para>
    /// Gesetzt wird nur, was die Vorlage auch sagt: ein fehlender Wert laesst die bisherige Vorgabe
    /// stehen. Und was sichtbar ist, darf der Benutzer hinterher aendern - die Vorbelegung ist dort ein
    /// Angebot, kein Riegel.
    /// </para>
    /// </remarks>
    private void ApplyTemplateDefaults()
    {
        var options = Options;
        if (options.Title.Value != null)
        {
            Model.Title = options.Title.Value;
        }

        if (options.Recipient.Value != null)
        {
            Model.RecipientLabel = options.Recipient.Value;
        }

        if (options.AdHoc.Value != null)
        {
            Model.AdHoc = options.AdHoc.Value.Value;
        }

        if (options.Lifetime.Value != null)
        {
            Model.LifetimeMinutes = options.Lifetime.Value;
        }

        if (options.Anonymous.Value != null)
        {
            Model.Anonymous = options.Anonymous.Value.Value;
        }

        if (options.Reach.Value != null)
        {
            Model.Reach = options.Reach.Value;
        }
    }

    /// <summary>
    /// Uebernimmt die aus dem Pfad ablesbaren Werte der GEWAEHLTEN Vorlage ins Modell.
    /// </summary>
    /// <remarks>
    /// Erst hier und nicht schon im Knopf: welche Namen der Pfad hergibt, bestimmen die benannten
    /// Gruppen im Muster - und das gehoert der Vorlage. Ein Wechsel der Vorlage kann also andere Werte
    /// bedeuten.
    /// <para>
    /// <b>Der Pfad ueberschreibt nichts.</b> Was schon im Modell steht, kommt von der Seite selbst oder
    /// wurde ausdruecklich gesetzt - beides ist die genauere Aussage. Der Pfad fuellt nur Luecken.
    /// </para>
    /// </remarks>
    private void ApplyPathValues()
    {
        var values = Selected?.PathValues;
        if (values == null)
        {
            return;
        }

        foreach (var pair in values)
        {
            if (!Model.ArgumentValues.ContainsKey(pair.Key)
                || string.IsNullOrEmpty(Model.ArgumentValues[pair.Key]))
            {
                Model.ArgumentValues[pair.Key] = pair.Value;
            }
        }
    }

    private void ReachChanged(ShareReach? value)
    {
        Model.Reach = value;
        error = null;
    }

    /// <summary>
    /// Prueft, was die Datenannotationen nicht sehen: eine gewaehlte Reichweite, zu der niemand eingetragen
    /// ist, ist genauso leer wie gar keine - und ergaebe eine Freigabe, die niemand benutzen kann.
    /// </summary>
    /// <returns>die Meldung, oder null, wenn die Reichweite steht</returns>
    private string? ValidateReach()
    {
        if (Model.Anonymous || Model.AdHoc)
        {
            return null;
        }

        return Model.Reach switch
        {
            null => "Pick who can use this.",
            ShareReach.Recipients when Model.UserFilters.Count == 0 => "Name at least one user, or pick another reach.",
            ShareReach.Tenants when Model.TenantFilters.Count == 0 => "Name at least one tenant, or pick another reach.",
            _ => null
        };
    }

    private string GetArgument(string name)
        => Model.ArgumentValues.TryGetValue(name, out var value) ? value : string.Empty;

    /// <summary>
    /// Steht dieser Wert schon fest, weil die Stelle ihn hergibt?
    /// </summary>
    /// <remarks>
    /// Zu diesem Zeitpunkt sind beide Quellen schon im Modell: was die Seite ueber ihren
    /// <c>AssetScope</c> gemeldet hat (der Knopf), und was der Pfad hergab (<see cref="ApplyPathValues"/>).
    /// Was danach noch leer ist, muss der Benutzer beantworten.
    /// </remarks>
    private bool IsKnown(string name) => !string.IsNullOrEmpty(GetArgument(name));

    private void SetArgument(string name, string value) => Model.ArgumentValues[name] = value;

    private async Task<bool> Share()
    {
        error = ValidateReach();
        if (error != null)
        {
            return false;
        }

        busy = true;
        try
        {
            var result = await OnShare(Model);
            error = result.Error;
            created = result.Success ? result : null;
            return result.Success;
        }
        finally
        {
            busy = false;
        }
    }
}
