@using Microsoft.AspNetCore.Components.Authorization

@inject IFeatureAdminHandler Handler
@inject AuthenticationStateProvider AuthState
@inject IDialogService DialogService
@inject ISnackbar Snackbar

<SecureView RequiredPermissions="Features.View,Features.Write"><Permitted>
    <MudDataGrid T="TemplateModuleScriptViewModel"
                 @ref="grid"
                 ServerData="LoadData"
                 SortMode="SortMode.None"
                 RowsPerPage="10"
                 Hover="true"
                 Dense="true">
        <ToolBarContent>
            <RefreshButton OnClick="@(() => grid is null ? Task.CompletedTask : grid.ReloadServerData())" />
            <MudText Typo="Typo.subtitle2">Scripts</MudText>
            <MudSpacer />
            <SecureView RequiredPermissions="Features.Write"><Permitted>
                <MudButton StartIcon="@Icons.Material.Filled.Add" Variant="Variant.Filled" Size="Size.Small" Color="Color.Primary" OnClick="OpenCreate">
                    Add script
                </MudButton>
            </Permitted></SecureView>
        </ToolBarContent>
        <Columns>
            <PropertyColumn Property="x => x.ScriptFile" Title="Script file" />
            <TemplateColumn T="TemplateModuleScriptViewModel" Title="" Sortable="false">
                <CellTemplate>
                    <SecureView RequiredPermissions="Features.Write"><Permitted>
                        <MudStack Row="true" Spacing="1">
                            <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" OnClick="@(() => OpenEdit(context.Item))" />
                            <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error" OnClick="@(() => Delete(context.Item))" />
                        </MudStack>
                    </Permitted></SecureView>
                </CellTemplate>
            </TemplateColumn>
        </Columns>
        <PagerContent>
            <MudDataGridPager T="TemplateModuleScriptViewModel" />
        </PagerContent>
    </MudDataGrid>
</Permitted><NotPermitted>
    <MudAlert Severity="Severity.Info">No permission to view scripts.</MudAlert>
</NotPermitted></SecureView>

@code {
    [Parameter, EditorRequired] public int TemplateModuleId { get; set; }

    private MudDataGrid<TemplateModuleScriptViewModel>? grid;
    private System.Security.Claims.ClaimsPrincipal? currentUser;
    private bool hasView;
    private bool hasWrite;

    protected override async Task OnInitializedAsync()
    {
        var auth = await AuthState.GetAuthenticationStateAsync();
        currentUser = auth.User;
        hasView = Handler.HasPermission(currentUser, "Features.View", "Features.Write");
        hasWrite = Handler.HasPermission(currentUser, "Features.Write");
    }

    private async Task<GridData<TemplateModuleScriptViewModel>> LoadData(GridState<TemplateModuleScriptViewModel> state, CancellationToken ct)
    {
        if (currentUser is null || !hasView)
            return new GridData<TemplateModuleScriptViewModel> { Items = Array.Empty<TemplateModuleScriptViewModel>(), TotalItems = 0 };
        var query = new ListQuery { Page = state.Page, PageSize = state.PageSize };
        var result = await Handler.ListScriptsAsync(currentUser, TemplateModuleId, query);
        return new GridData<TemplateModuleScriptViewModel> { Items = result.Items, TotalItems = result.TotalCount };
    }

    private async Task OpenCreate()
    {
        var parameters = new DialogParameters<TemplateModuleScriptDialog>
        {
            { d => d.Model, new TemplateModuleScriptViewModel { TemplateModuleId = TemplateModuleId } },
            { d => d.IsCreate, true }
        };
        var dlg = await DialogService.ShowAsync<TemplateModuleScriptDialog>("Create script", parameters, EditDialogDefaults.Edit);
        var result = await dlg.Result;
        if (result is { Canceled: false, Data: TemplateModuleScriptViewModel input })
        {
            var created = await Handler.CreateScriptAsync(currentUser!, TemplateModuleId, input);
            if (created != null) { Snackbar.Add("Script created", Severity.Success); if (grid is not null) await grid.ReloadServerData(); }
            else Snackbar.Add("Failed to create script", Severity.Error);
        }
    }

    private async Task OpenEdit(TemplateModuleScriptViewModel item)
    {
        var copy = new TemplateModuleScriptViewModel
        {
            TemplateModuleScriptId = item.TemplateModuleScriptId,
            ScriptFile = item.ScriptFile,
            TemplateModuleId = item.TemplateModuleId
        };
        var parameters = new DialogParameters<TemplateModuleScriptDialog> { { d => d.Model, copy }, { d => d.IsCreate, false } };
        var dlg = await DialogService.ShowAsync<TemplateModuleScriptDialog>("Edit script", parameters, EditDialogDefaults.Edit);
        var result = await dlg.Result;
        if (result is { Canceled: false, Data: TemplateModuleScriptViewModel input })
        {
            var updated = await Handler.UpdateScriptAsync(currentUser!, input);
            if (updated != null) { Snackbar.Add("Script updated", Severity.Success); if (grid is not null) await grid.ReloadServerData(); }
            else Snackbar.Add("Failed to update script", Severity.Error);
        }
    }

    private async Task Delete(TemplateModuleScriptViewModel item)
    {
        var ok = await DialogService.ShowMessageBoxAsync("Delete script", $"Really delete '{item.ScriptFile}'?", yesText: "Delete", cancelText: "Cancel");
        if (ok != true) return;
        var success = await Handler.DeleteScriptAsync(currentUser!, item.TemplateModuleScriptId);
        if (success) { Snackbar.Add("Script deleted", Severity.Success); if (grid is not null) await grid.ReloadServerData(); }
        else Snackbar.Add("Failed to delete script", Severity.Error);
    }
}
