@using ITVComponents.WebCoreToolkit.Net.Extensions
@using Microsoft.AspNetCore.Mvc.ModelBinding.Metadata
@using System.Text.Encodings.Web
@using System.Collections
@using ITVComponents.WebCoreToolkit.Extensions
@using ITVComponents.WebCoreToolkit.Net.TelerikUi.Extensions
@using ITVComponents.WebCoreToolkit.Net.TelerikUi.Options
@using ITVComponents.WebCoreToolkit.Net.TelerikUi.TenantSecurityViews.Resources
@using ITVComponents.WebCoreToolkit.Net.TelerikUi.TenantSecurityViews.ViewModel
@using ITVComponents.WebCoreToolkit.Net.ViewModel
@using ITVComponents.WebCoreToolkit.Routing
@using Kendo.Mvc.UI
@using Microsoft.AspNetCore.Routing
@using Microsoft.Extensions.Options


@(Html.Kendo().Grid<LocalizationCultureViewModel>().Name($"DbResCultureList{ViewData["localizationId"]}")
        //.HtmlAttributes(new { style = "width:50vw;" })
        .Columns(columns =>
        {
            //columns.Bound(c => c.).Title(TextsAndMessagesHelper.IWCN_General_Name);
            columns.AjaxFk(c => c.CultureId, "sys", "Cultures", "LocalizationCultureId");
            /*columns.ForeignKey(p => p.PermissionId, ds =>
            {
                ds.Ajax().Read(cfg =>
                {
                    cfg.Url("/ForeignKey/sys/Permissions");
                }).ServerOperation(true);
            }, "Key", "Label");*/
if (Context.RequestServices.VerifyUserPermissions(new[] { "DbResources.Write" }))
            {
                columns.Command(ga =>
                {
                    ga.Edit();
                    ga.PopupConfirmDelete();
                }).Width(180);
            }

        })
        .ToolBar(toolbar =>
        {
            toolbar.RefreshTable();
if (Context.RequestServices.VerifyUserPermissions(new[] { "DbResources.Write" }))
            {
                toolbar.Create();
            }
        })
        //.Events(e => e.UseForeignKeyFilter())
        .DataSource(dataSource =>
        {
            var src = dataSource
                .Ajax()
    .Read(read => read.Action("ReadCultures", "DbResource", new RouteValueDictionary { { "localizationId", ViewData["localizationId"] } }));
            if (Context.RequestServices.VerifyUserPermissions(new[] { "DbResources.Write" }))
            {
    src.Create(create => create.Action("CreateCulture", "DbResource", new RouteValueDictionary { { "localizationId", ViewData["localizationId"] } }))
        .Update(update => update.Action("UpdateCulture", "DbResource"))
        .Destroy(destroy => destroy.Action("DestroyCulture", "DbResource"));
            }
            src.Model(m => m.Id(t => t.LocalizationCultureId))
                .Sort(n => n.Add(m => m.LocalizationCultureId));
        })
        .Scrollable(s => s.Height("auto"))
        .Pageable(p => p.Input(false).Numeric(true).Info(true).PreviousNext(true).PageSizes(true))
        .Sortable(c => c.Enabled(true))
    .Resizable(c => c.Columns(true))
    .Filterable(f => f.Enabled(true))
    .ClientDetailTemplateId("CultureDetails"))
