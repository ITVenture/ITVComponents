@using BlazorMonaco
@using BlazorMonaco.Editor
@inject Microsoft.JSInterop.IJSRuntime JS

@*
    Monaco-Editor fuer einen CScript-Ausdruck (Kantenbedingung, Timer-/Korrelations-Ausdruck).
    Der Wert wird einmal als Startwert gesetzt und beim Verlassen des Editors (Blur) zurueckgelesen -
    kein Zwei-Wege-@bind, das unter Blazor Server je Tastendruck einen Server-Roundtrip ausloesen wuerde.
    Der Aufrufer kann den aktuellen Text jederzeit ueber GetValueAsync() abholen (z.B. beim Speichern).

    Host-Voraussetzung: nur <ITVentureReferences /> in der statisch gerenderten Host-Seite. Die drei
    BlazorMonaco-Skripte meldet das WebPart des Moduls selbst an (WebPartInit.RegisterServices) -
    von Hand gesetzte <script>-Tags sind nicht noetig und koennen entfernt werden.
*@

@* Der Modus steht UEBER dem Editor, weil er die Bedeutung des Textes darunter aendert - und weil ein
   falsch gesetzter Modus nicht auffaellt: ein Block, als Ausdruck ausgewertet, liefert keinen Fehler,
   sondern still einen falschen Wert. Nur sichtbar, wenn der Aufrufer den Modus auch fuehrt. *@
@if (ModeChanged.HasDelegate)
{
    <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center" Class="mb-1">
        <MudButtonGroup Size="Size.Small" Variant="Variant.Outlined">
            <MudButton Color="@(Mode == ScriptMode.Expression ? Color.Primary : Color.Default)"
                       Variant="@(Mode == ScriptMode.Expression ? Variant.Filled : Variant.Outlined)"
                       OnClick="@(() => ModeChanged.InvokeAsync(ScriptMode.Expression))">Expression</MudButton>
            <MudButton Color="@(Mode == ScriptMode.Block ? Color.Primary : Color.Default)"
                       Variant="@(Mode == ScriptMode.Block ? Variant.Filled : Variant.Outlined)"
                       OnClick="@(() => ModeChanged.InvokeAsync(ScriptMode.Block))">Script block</MudButton>
        </MudButtonGroup>
        <MudText Typo="Typo.caption" Class="mud-text-secondary">
            @(Mode == ScriptMode.Block
                ? "Statements, ending in an explicit return — without a return the result is null."
                : "A single expression; its value is the result.")
        </MudText>
    </MudStack>
}

@* Die Hoehe muss ueber die Klasse an das von Monaco erzeugte Kind-div durchgereicht werden
   (CScriptField.razor.css) - eine Hoehe nur am aeusseren div laesst den Editor auf ~5px kollabieren. *@
<div class="itv-cscript-host"
     style="border:1px solid var(--mud-palette-lines-inputs); border-radius:var(--mud-default-borderradius); overflow:hidden; height:@(Height)px;">
    <StandaloneCodeEditor @ref="editor" ConstructionOptions="BuildOptions" OnDidBlurEditorText="OnBlur" />
</div>

@code {
    /// <summary>Startwert des Ausdrucks. Rueckgabe ueber <see cref="GetValueAsync"/> oder <see cref="ValueChanged"/>.</summary>
    [Parameter] public string? Value { get; set; }

    /// <summary>Wird beim Verlassen des Editors mit dem aktuellen Text aufgerufen.</summary>
    [Parameter] public EventCallback<string> ValueChanged { get; set; }

    /// <summary>Editorhoehe in px.</summary>
    [Parameter] public int Height { get; set; } = 90;

    /// <summary>
    /// Wie der Text zu lesen ist. Der Umschalter erscheint nur, wenn <see cref="ModeChanged"/> gesetzt
    /// ist - Felder, die den Modus (noch) nicht führen, sehen unverändert aus.
    /// </summary>
    [Parameter] public ScriptMode Mode { get; set; } = ScriptMode.Expression;

    /// <summary>Wird beim Umschalten des Modus aufgerufen.</summary>
    [Parameter] public EventCallback<ScriptMode> ModeChanged { get; set; }

    /// <summary>
    /// Monaco-Sprache. Standard "javascript" (kommt CScript syntaktisch am naechsten). Fuer reine
    /// Datenfelder, die JSON erwarten (z.B. Kultur-/Formatting-Records), kann "json" gesetzt werden.
    /// </summary>
    [Parameter] public string Language { get; set; } = "javascript";

    private StandaloneCodeEditor? editor;

    // Sprache siehe Parameter Language: "javascript" fuer CScript-Ausdruecke, "json" fuer Datenfelder.
    private StandaloneEditorConstructionOptions BuildOptions(StandaloneCodeEditor _)
        => new StandaloneEditorConstructionOptions
        {
            Language = Language,
            Value = Value ?? string.Empty,
            AutomaticLayout = true,
            Minimap = new EditorMinimapOptions { Enabled = false },
            LineNumbers = "off",
            ScrollBeyondLastLine = false,
            FontSize = 13,
            WordWrap = "on"
        };

    /// <summary>Liefert den aktuellen Editortext (faellt auf den Startwert zurueck, wenn nicht initialisiert).</summary>
    public async Task<string> GetValueAsync()
        => editor is null ? (Value ?? string.Empty) : await editor.GetValue();

    private async Task OnBlur()
    {
        if (ValueChanged.HasDelegate)
        {
            await ValueChanged.InvokeAsync(await GetValueAsync());
        }
    }
}
