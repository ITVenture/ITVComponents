@page "/Account/Manage"
@rendermode @(RenderMode.InteractiveServer)

@layout ManageLayout
@attribute [Microsoft.AspNetCore.Authorization.Authorize]

@using System.ComponentModel.DataAnnotations
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.Extensions.Localization
@using ITVComponents.WebCoreToolkit.Blazor.MudBlazor.IdentityPages.Components.Account.Shared
@using ITVComponents.WebCoreToolkit.IdentityShared.Areas.Identity
@using ITVComponents.WebCoreToolkit.IdentityShared.Areas.Identity.Pages.Account.Manage
@using ITVComponents.WebCoreToolkit.IdentityShared.PageHandlers.Identity.Account.Manage

@inject IPageHandlerProvider<IndexModel, IIndexHandler> HandlerProvider
@inject AuthenticationStateProvider AuthState
@inject IStringLocalizer<IdentityMessages> L
@inject NavigationManager Nav

<PageTitle>@L["Profile"]</PageTitle>

<MudText Typo="Typo.h5" GutterBottom="true">@L["Profile"]</MudText>

@if (!HandlerProvider.Handler.UsePage)
{
    <MudAlert Severity="Severity.Info">@L["This page is not available."]</MudAlert>
}
else if (loading)
{
    <MudProgressCircular Indeterminate="true" />
}
else if (notFound)
{
    <MudAlert Severity="Severity.Error">@notFoundMessage</MudAlert>
}
else
{
    @if (!string.IsNullOrEmpty(StatusMessage))
    {
        <MudAlert Severity="Severity.Success" Class="mb-3">@StatusMessage</MudAlert>
    }

    <EditForm Model="Input" OnValidSubmit="OnSubmit">
        <ToolkitDataAnnotationsValidator />

        @if (errors.Count > 0)
        {
            <MudAlert Severity="Severity.Error" Class="mb-3">
                @foreach (var err in errors) { <div>@err</div> }
            </MudAlert>
        }

        <MudTextField T="string" Value="@username" Label="@L["Username"]" Disabled="true" Class="mb-3" />

        <MudTextField @bind-Value="Input.PhoneNumber" Label="@L["Phone number"]"
                      For="@(() => Input.PhoneNumber)" Class="mb-3" />

        <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary" Disabled="@busy">
            @L["Save profile"]
        </MudButton>
    </EditForm>
}

@code {
    private string username = "";
    private bool loading = true;
    private bool notFound;
    private string? notFoundMessage;
    private bool busy;
    private List<string> errors = new();

    private InputModel Input { get; set; } = new();

    /// <summary>
    /// Ueberlebt den vollen Seitenaufbau des Cookie-Ruecksprungs, weil sie in der Adresse steht — ein Feld auf
    /// dem Circuit waere danach weg.
    /// </summary>
    [SupplyParameterFromQuery(Name = "status")]
    private string? StatusMessage { get; set; }

    protected override async Task OnInitializedAsync()
    {
        if (!HandlerProvider.Handler.UsePage)
        {
            loading = false;
            return;
        }

        var principal = (await AuthState.GetAuthenticationStateAsync()).User;
        var user = await HandlerProvider.Handler.FetchUser(principal);
        try
        {
            if (!user.UserExists)
            {
                notFound = true;
                notFoundMessage = L["Unable to load user with ID '{0}'.", HandlerProvider.Handler.GetUserId(principal)];
                return;
            }

            username = user.UserName ?? "";
            Input.PhoneNumber = user.PhoneNumber ?? "";
        }
        finally
        {
            HandlerProvider.Handler.ReleaseUser(user);
            loading = false;
        }
    }

    private async Task OnSubmit()
    {
        busy = true;
        errors.Clear();
        var principal = (await AuthState.GetAuthenticationStateAsync()).User;
        var user = await HandlerProvider.Handler.FetchUser(principal);
        try
        {
            if (!user.UserExists)
            {
                notFound = true;
                notFoundMessage = L["Unable to load user with ID '{0}'.", HandlerProvider.Handler.GetUserId(principal)];
                return;
            }

            if (Input.PhoneNumber != user.PhoneNumber)
            {
                var setPhoneResult = await HandlerProvider.Handler.ChangePhoneNumber(user, Input.PhoneNumber);
                if (!setPhoneResult.Succeeded)
                {
                    errors = new() { L["Unexpected error when trying to set phone number."] };
                    return;
                }
            }

            // Die Telefonnummer aendert den Security-Stamp NICHT — der Ruecksprung ist hier also nur die
            // Cookie-Auffrischung, die das Original an dieser Stelle auch gemacht hat, und ohne das Zeitfenster
            // der Passwort-Seiten.
            ManageRedirects.RefreshSignIn(Nav, "Account/Manage", L["Your profile has been updated"].Value);
        }
        finally
        {
            HandlerProvider.Handler.ReleaseUser(user);
            busy = false;
        }
    }

    public sealed class InputModel
    {
        [Phone]
        public string PhoneNumber { get; set; } = "";
    }
}
