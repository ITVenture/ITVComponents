<EditDialogShell Model="Model" IsCreate="IsCreate">
    <MudTextField @bind-Value="Model.FeatureName" Label="Name" Required="true" RequiredError="Name is required" />
    <MudTextField @bind-Value="Model.FeatureDescription" Label="Description" Lines="3" />
    <MudCheckBox @bind-Value="Model.Enabled" Label="Enabled" />
</EditDialogShell>

@code {
    [Parameter, EditorRequired] public FeatureViewModel Model { get; set; } = default!;
    [Parameter] public bool IsCreate { get; set; }
}
