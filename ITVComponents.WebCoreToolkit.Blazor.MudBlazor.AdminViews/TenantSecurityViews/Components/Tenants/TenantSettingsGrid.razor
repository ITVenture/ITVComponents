@using Microsoft.AspNetCore.Components.Authorization

@inject ITenantAdminHandler Handler
@inject AuthenticationStateProvider AuthState
@inject IDialogService DialogService
@inject ISnackbar Snackbar

<SecureView RequiredPermissions="Tenants.View,Tenants.WriteSettings"><Permitted>
    <MudDataGrid T="TenantSettingViewModel"
                 @ref="grid"
                 ServerData="LoadData"
                 SortMode="SortMode.None"
                 RowsPerPage="25"
                 Hover="true"
                 Dense="true">
        <ToolBarContent>
            <RefreshButton OnClick="@(() => grid is null ? Task.CompletedTask : grid.ReloadServerData())" />
            <MudText Typo="Typo.subtitle2">Settings</MudText>
            <MudSpacer />
            <MudTextField @bind-Value="search" Placeholder="Search…" DebounceInterval="300" OnDebounceIntervalElapsed="@(() => grid is null ? Task.CompletedTask : grid.ReloadServerData())" Class="mt-0" />
            <SecureView RequiredPermissions="Tenants.WriteSettings"><Permitted>
                <MudButton StartIcon="@Icons.Material.Filled.Add" Variant="Variant.Filled" Size="Size.Small" Color="Color.Primary" OnClick="OpenCreate">Add setting</MudButton>
            </Permitted></SecureView>
        </ToolBarContent>
        <Columns>
            <PropertyColumn Property="x => x.SettingsKey" Title="Key" />
            <PropertyColumn Property="x => x.JsonSetting" Title="JSON" />
            <PropertyColumn Property="x => x.SettingsValue" Title="Value" />
            <TemplateColumn T="TenantSettingViewModel" Title="" Sortable="false">
                <CellTemplate>
                    <SecureView RequiredPermissions="Tenants.WriteSettings"><Permitted>
                        <MudStack Row="true" Spacing="1">
                            <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" OnClick="@(() => OpenEdit(context.Item))" />
                            <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error" OnClick="@(() => Delete(context.Item))" />
                        </MudStack>
                    </Permitted></SecureView>
                </CellTemplate>
            </TemplateColumn>
        </Columns>
        <PagerContent><MudDataGridPager T="TenantSettingViewModel" /></PagerContent>
    </MudDataGrid>
</Permitted><NotPermitted>
    <MudAlert Severity="Severity.Info">No permission to view tenant settings.</MudAlert>
</NotPermitted></SecureView>

@code {
    [Parameter, EditorRequired] public int TenantId { get; set; }

    private MudDataGrid<TenantSettingViewModel>? grid;
    private System.Security.Claims.ClaimsPrincipal? currentUser;
    private bool hasView, hasWrite;
    private string? search;

    protected override async Task OnInitializedAsync()
    {
        var auth = await AuthState.GetAuthenticationStateAsync();
        currentUser = auth.User;
        hasView = Handler.HasPermission("Tenants.View", "Tenants.WriteSettings");
        hasWrite = Handler.HasPermission("Tenants.WriteSettings");
    }

    private async Task<GridData<TenantSettingViewModel>> LoadData(GridState<TenantSettingViewModel> state, CancellationToken ct)
    {
        if (currentUser is null || !hasView) return new GridData<TenantSettingViewModel>();
        var result = await Handler.ListSettingsAsync(currentUser, TenantId, new ListQuery { Page = state.Page, PageSize = state.PageSize, Search = search });
        return new GridData<TenantSettingViewModel> { Items = result.Items, TotalItems = result.TotalCount };
    }

    private async Task OpenCreate()
    {
        var p = new DialogParameters<TenantSettingDialog> { { d => d.Model, new TenantSettingViewModel { TenantId = TenantId } }, { d => d.IsCreate, true } };
        var dlg = await DialogService.ShowAsync<TenantSettingDialog>("Create setting", p, EditDialogDefaults.Edit);
        var r = await dlg.Result;
        if (r is { Canceled: false, Data: TenantSettingViewModel m } && await Handler.CreateSettingAsync(currentUser!, TenantId, m) != null)
        { Snackbar.Add("Setting created", Severity.Success); if (grid is not null) await grid.ReloadServerData(); }
    }

    private async Task OpenEdit(TenantSettingViewModel item)
    {
        var copy = new TenantSettingViewModel { TenantSettingId = item.TenantSettingId, TenantId = item.TenantId, SettingsKey = item.SettingsKey, SettingsValue = item.SettingsValue, JsonSetting = item.JsonSetting };
        var p = new DialogParameters<TenantSettingDialog> { { d => d.Model, copy }, { d => d.IsCreate, false } };
        var dlg = await DialogService.ShowAsync<TenantSettingDialog>("Edit setting", p, EditDialogDefaults.Edit);
        var r = await dlg.Result;
        if (r is { Canceled: false, Data: TenantSettingViewModel m } && await Handler.UpdateSettingAsync(currentUser!, m) != null)
        { Snackbar.Add("Setting updated", Severity.Success); if (grid is not null) await grid.ReloadServerData(); }
    }

    private async Task Delete(TenantSettingViewModel item)
    {
        var ok = await DialogService.ShowMessageBoxAsync("Delete setting", $"Really delete '{item.SettingsKey}'?", yesText: "Delete", cancelText: "Cancel");
        if (ok != true) return;
        if (await Handler.DeleteSettingAsync(currentUser!, item.TenantSettingId))
        { Snackbar.Add("Setting deleted", Severity.Success); if (grid is not null) await grid.ReloadServerData(); }
        else Snackbar.Add("Failed to delete", Severity.Error);
    }
}
