@implements IUserTaskView
@inject IStringLocalizer<WorkflowTaskMessages> L

@* Die Maske fuer den einfachen Fall: aus der Feld-Deklaration des Knotens gebaut, ohne eine Zeile
   Code beim Konsumenten. Sie teilt Mantel, Rechte und Abschluss mit einer eigenen Komponente - der
   Unterschied ist nur, WER die Felder rendert. Das Rendern selbst macht UserTaskFieldsForm, das
   dieselbe Deklaration auch fuer den Start-Dialog darstellt. *@

@if (TaskContext is null)
{
    <MudAlert Severity="Severity.Error">@L["TaskGone"]</MudAlert>
}
else
{
    @if (!string.IsNullOrWhiteSpace(TaskContext.Description))
    {
        <MudText Typo="Typo.body2" Class="mb-4">@TaskContext.Description</MudText>
    }

    @if (TaskContext.FormFields.Count == 0)
    {
        <MudAlert Severity="Severity.Info" Class="mb-2">@L["NoFormConfigured"]</MudAlert>
    }

    <UserTaskFieldsForm @ref="fields"
                        Fields="TaskContext.FormFields"
                        Payload="TaskContext.Payload"
                        TranslateText="@(v => TaskContext.Translate(v))"
                        ResetKey="@TaskContext.TokenId" />
}

@code {
    /// <summary>Der Aufgaben-Kontext des Mantels.</summary>
    [CascadingParameter]
    public WorkflowTaskContext? TaskContext { get; set; }

    private UserTaskFieldsForm? fields;

    /// <summary>
    /// Sammelt das Ergebnis ein und prueft die Pflichtfelder. Fehlt etwas, hat die Feld-Maske es bereits
    /// an Ort und Stelle markiert - dann braucht es keine zusaetzliche Meldung.
    /// </summary>
    /// <remarks>
    /// Die generische Maske erfuellt denselben Vertrag wie eine eigene (<see cref="IUserTaskView"/>).
    /// Genau darum gibt es im Mantel nur EINEN Abschlussweg, und die Fusszeile sieht ueberall gleich aus.
    /// </remarks>
    public Task<UserTaskViewResult> ResolveActivityAsync()
    {
        if (TaskContext is null)
        {
            return Task.FromResult(UserTaskViewResult.Incomplete(L["TaskGone"]));
        }

        if (fields is null || !fields.TryGetResult(out Dictionary<string, object> result))
        {
            return Task.FromResult(UserTaskViewResult.Incomplete());
        }

        return Task.FromResult(UserTaskViewResult.Complete(result));
    }
}
