@using ITVComponents.WebCoreToolkit.Extensions
@model ITVComponents.WebCoreToolkit.Models.ExternalServiceConnect.ExternalOAuthConnection

<table class="k-grid">
    <thead>
    <tr>
        <th>Parameter</th>
        <th>Value</th>
    </tr>
    </thead>
    <tbody>
    <tr>
        <td>
            UniqueConnectionName
        </td>
        <td>@Model.UniqueConnectionName</td>
    </tr>
    <tr>
        <td>
            AuthorizationEndpoint
        </td>
        <td>@Model.AuthorizationEndpoint</td>
    </tr>
    <tr>
        <td>
