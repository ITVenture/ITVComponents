@page "/Util/Sequences"
@rendermode @(RenderMode.InteractiveServer)
@attribute [Microsoft.AspNetCore.Authorization.Authorize]

@using Microsoft.AspNetCore.Components.Authorization

@inject ISequenceAdminHandler Handler
@inject AuthenticationStateProvider AuthState
@inject IDialogService DialogService
@inject ISnackbar Snackbar

<PageTitle>Sequences</PageTitle>

<MudText Typo="Typo.h5" GutterBottom="true">Sequences</MudText>

<SecureView RequiredPermissions="Sequences.View,Sequences.Write">
    <Permitted>
@if (currentUser is null)
{
    <MudProgressCircular Indeterminate="true" />
}
else
{
    <MudDataGrid T="SequenceViewModel"
                 @ref="grid"
                 ServerData="LoadData"
                 SortMode="SortMode.None"
                 RowsPerPage="25"
                 Hover="true"
                 Dense="true">
        <ToolBarContent>
            <RefreshButton OnClick="ReloadGrid" />
            <MudText Typo="Typo.h6">Sequences</MudText>
            <MudSpacer />
            <MudTextField @bind-Value="search"
                          Placeholder="Search…"
                          Adornment="Adornment.Start"
                          AdornmentIcon="@Icons.Material.Filled.Search"
                          Class="mt-0"
                          DebounceInterval="300"
                          OnDebounceIntervalElapsed="ReloadGrid" />
            <SecureView RequiredPermissions="Sequences.Write">
                <Permitted>
                    <MudButton StartIcon="@Icons.Material.Filled.Add" Variant="Variant.Filled" Color="Color.Primary" Class="ml-2" OnClick="OpenCreate">
                        Add sequence
                    </MudButton>
                </Permitted>
            </SecureView>
        </ToolBarContent>
        <Columns>
            <PropertyColumn Property="x => x.SequenceName" Title="Name" />
            <PropertyColumn Property="x => x.MinValue" Title="Min" />
            <PropertyColumn Property="x => x.MaxValue" Title="Max" />
            <PropertyColumn Property="x => x.StepSize" Title="Step" />
            <PropertyColumn Property="x => x.Cycle" Title="Cycle" />
            <PropertyColumn Property="x => x.CurrentValue" Title="Current" />
            <TemplateColumn T="SequenceViewModel" Title="" Sortable="false">
                <CellTemplate>
                    <SecureView RequiredPermissions="Sequences.Write">
                        <Permitted>
                        <MudStack Row="true" Spacing="1">
                            <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" OnClick="@(() => OpenEdit(context.Item))" />
                            <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error" OnClick="@(() => Delete(context.Item))" />
                        </MudStack>
                        </Permitted>
                    </SecureView>
                </CellTemplate>
            </TemplateColumn>
        </Columns>
        <PagerContent>
            <MudDataGridPager T="SequenceViewModel" />
        </PagerContent>
    </MudDataGrid>
}
    </Permitted>
    <NotPermitted>
        <MudAlert Severity="Severity.Warning">No permission to view sequences.</MudAlert>
    </NotPermitted>
</SecureView>

@code {
    private MudDataGrid<SequenceViewModel>? grid;
    private System.Security.Claims.ClaimsPrincipal? currentUser;
    private bool hasView;
    private bool hasWrite;
    private string? search;

    [SupplyParameterFromQuery(Name = "tenantId")]
    private int? TenantIdQuery { get; set; }

    /// <summary>
    /// Optional parameter that overrides <c>tenantId</c> query parameter.
    /// Used when the page is rendered as a sub-component inside <c>TenantDetailDialog</c>.
    /// </summary>
    [Parameter] public int? EmbeddedTenantId { get; set; }

    private int? EffectiveTenantId => EmbeddedTenantId ?? TenantIdQuery;

    protected override async Task OnInitializedAsync()
    {
        var auth = await AuthState.GetAuthenticationStateAsync();
        currentUser = auth.User;
        hasView = Handler.HasPermission(currentUser, "Sequences.View", "Sequences.Write");
        hasWrite = Handler.HasPermission(currentUser, "Sequences.Write");
    }

    private async Task<GridData<SequenceViewModel>> LoadData(GridState<SequenceViewModel> state, CancellationToken ct)
    {
        if (currentUser is null) return new GridData<SequenceViewModel> { Items = Array.Empty<SequenceViewModel>(), TotalItems = 0 };
        var query = new ListQuery { Page = state.Page, PageSize = state.PageSize, Search = search };
        var result = await Handler.ListAsync(currentUser, EffectiveTenantId, query);
        return new GridData<SequenceViewModel> { Items = result.Items, TotalItems = result.TotalCount };
    }

    private async Task ReloadGrid()
    {
        if (grid is not null) await grid.ReloadServerData();
    }

    private async Task OpenCreate()
    {
        var parameters = new DialogParameters<SequenceDialog> { { d => d.Model, new SequenceViewModel() }, { d => d.IsCreate, true } };
        var dlg = await DialogService.ShowAsync<SequenceDialog>("Create sequence", parameters, EditDialogDefaults.Edit);
        var result = await dlg.Result;
        if (result is { Canceled: false, Data: SequenceViewModel input })
        {
            var created = await Handler.CreateAsync(currentUser!, EffectiveTenantId, input);
            if (created != null) { Snackbar.Add("Sequence created", Severity.Success); await ReloadGrid(); }
            else Snackbar.Add("Failed to create", Severity.Error);
        }
    }

    private async Task OpenEdit(SequenceViewModel item)
    {
        var copy = new SequenceViewModel
        {
            SequenceId = item.SequenceId,
            TenantId = item.TenantId,
            SequenceName = item.SequenceName,
            MinValue = item.MinValue,
            MaxValue = item.MaxValue,
            Cycle = item.Cycle,
            StepSize = item.StepSize,
            CurrentValue = item.CurrentValue
        };
        var parameters = new DialogParameters<SequenceDialog> { { d => d.Model, copy }, { d => d.IsCreate, false } };
        var dlg = await DialogService.ShowAsync<SequenceDialog>("Edit sequence", parameters, EditDialogDefaults.Edit);
        var result = await dlg.Result;
        if (result is { Canceled: false, Data: SequenceViewModel input })
        {
            var updated = await Handler.UpdateAsync(currentUser!, input);
            if (updated != null) { Snackbar.Add("Sequence updated", Severity.Success); await ReloadGrid(); }
            else Snackbar.Add("Failed to update", Severity.Error);
        }
    }

    private async Task Delete(SequenceViewModel item)
    {
        var ok = await DialogService.ShowMessageBoxAsync("Delete sequence", $"Really delete '{item.SequenceName}'?", yesText: "Delete", cancelText: "Cancel");
        if (ok != true) return;
        var success = await Handler.DeleteAsync(currentUser!, item.SequenceId);
        if (success) { Snackbar.Add("Sequence deleted", Severity.Success); await ReloadGrid(); }
        else Snackbar.Add("Failed to delete", Severity.Error);
    }
}
