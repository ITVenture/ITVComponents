@page "/Account/Manage/Subscription"
@rendermode @(RenderMode.InteractiveServer)
@attribute [Microsoft.AspNetCore.Authorization.Authorize]

@inject IBillingHandler Handler
@inject AuthenticationStateProvider AuthState
@inject NavigationManager Nav
@inject ISnackbar Snackbar
@inject IStringLocalizer<BillingMessages> L

<PageTitle>@L["Subscription_Title"]</PageTitle>

<MudText Typo="Typo.h5" GutterBottom="true">@L["Subscription_Title"]</MudText>

<SecureView RequiredPermissions="ManageSubscription,Sysadmin,TenantAdmin">
    <Permitted>
@if (currentUser is null)
{
    <MudProgressCircular Indeterminate="true" />
}
else if (!canManage)
{
    <MudAlert Severity="Severity.Warning">@L["NoManagePermission"]</MudAlert>
}
else if (overview.HasSubscription)
{
    <MudCard Class="mb-4">
        <MudCardContent>
            <MudText Typo="Typo.h6">@L["CurrentSubscription"]</MudText>
            <MudStack Row="true" Spacing="2" Class="my-2">
                <MudChip T="string" Color="@StatusColor(overview.Status)">@overview.Status</MudChip>
                @if (overview.CancelAtPeriodEnd)
                {
                    <MudChip T="string" Color="Color.Warning">@L["CancelsAtPeriodEnd"]</MudChip>
                }
            </MudStack>
            @if (overview.CurrentPeriodEnd is { } end)
            {
                <MudText Typo="Typo.body2">@L["CurrentPeriodEnds", end.ToString("d")]</MudText>
            }
            <MudList T="string" Dense="true" Class="mt-2">
                @foreach (var item in overview.Items)
                {
                    <MudListItem T="string" Icon="@(item.IsAddOn ? Icons.Material.Filled.Add : Icons.Material.Filled.Star)">
                        @item.Name @(item.IsAddOn ? L["AddOnSuffix"].Value : "")
                    </MudListItem>
                }
            </MudList>
        </MudCardContent>
        <MudCardActions>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Settings" OnClick="OpenPortal">
                @L["ManageSubscription"]
            </MudButton>
        </MudCardActions>
    </MudCard>
}
else if (awaitingConfirmation)
{
    @* Rueckkehr aus einem erfolgreichen Checkout: das Abo entsteht erst, wenn der Webhook eintrifft. Ohne
       diesen Zwischenzustand zeigte die Seite direkt nach der Bestellung wieder die Planliste - fuer den
       Benutzer nicht von einem Fehlschlag zu unterscheiden. *@
    <MudCard Class="mb-4">
        <MudCardContent>
            <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center">
                <MudProgressCircular Indeterminate="true" Size="Size.Small" />
                <MudText Typo="Typo.body1">@L["Checkout_Processing"]</MudText>
            </MudStack>
        </MudCardContent>
        <MudCardActions>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Refresh"
                       Disabled="@busy" OnClick="RefreshOverview">@L["Checkout_Refresh"]</MudButton>
            <MudButton Variant="Variant.Text" Disabled="@busy" OnClick="ShowPlans">@L["Checkout_ShowPlans"]</MudButton>
        </MudCardActions>
    </MudCard>
}
else
{
    @if (checkout == "cancel")
    {
        <MudAlert Severity="Severity.Info" Class="mb-3">@L["Checkout_Canceled"]</MudAlert>
    }
    else if (overview.Status == SubscriptionStatus.Canceled)
    {
        @* Die Zeile ueberlebt die Kuendigung (Kundenbezug + Historie). Ohne diesen Hinweis wirkt die
           zurueckkehrende Planliste wie Datenverlust. *@
        <MudAlert Severity="Severity.Info" Class="mb-3">@L["PreviousSubscriptionCanceled"]</MudAlert>
    }

    <MudText Typo="Typo.body1" Class="mb-3">@L["ChoosePlan"]</MudText>

    @if (availableCurrencies.Count > 1)
    {
        <MudSelect T="string" Value="selectedCurrency" ValueChanged="OnCurrencyChanged" Label="@(L["Field_Currency"])"
                   Dense="true" Class="mb-3" Style="max-width:160px">
            @foreach (var c in availableCurrencies)
            {
                <MudSelectItem T="string" Value="@c">@c</MudSelectItem>
            }
        </MudSelect>
    }

    <MudGrid>
        @foreach (var plan in plans)
        {
            var bookableAddOns = plan.AddOns.Where(a => a.PriceFor(selectedCurrency) is not null).ToList();
            <MudItem xs="12" sm="6" md="4">
                <MudCard Outlined="true">
                    <MudCardContent>
                        <MudText Typo="Typo.h6">@plan.Name</MudText>
                        <MudText Typo="Typo.subtitle1">@FormatPrice(plan.PriceFor(selectedCurrency), plan.BillingInterval)</MudText>
                        @if (!string.IsNullOrEmpty(plan.Description))
                        {
                            <MudText Typo="Typo.body2" Class="my-1">@plan.Description</MudText>
                        }
                        @if (plan.TrialDays is > 0)
                        {
                            <MudChip T="string" Size="Size.Small" Color="Color.Info">@L["TrialChip", plan.TrialDays]</MudChip>
                        }
                        @if (plan.FeatureKeys.Count > 0)
                        {
                            <MudList T="string" Dense="true">
                                @foreach (var key in plan.FeatureKeys)
                                {
                                    <MudListItem T="string" Icon="@Icons.Material.Filled.Check">@key</MudListItem>
                                }
                            </MudList>
                        }
                        @if (bookableAddOns.Count > 0)
                        {
                            <MudDivider Class="my-2" />
                            <MudText Typo="Typo.subtitle2">@L["OptionalAddOns"]</MudText>
                            @foreach (var addOn in bookableAddOns)
                            {
                                <MudCheckBox T="bool"
                                             Value="@IsAddOnSelected(plan.PlanId, addOn.AddOnId)"
                                             ValueChanged="@(v => ToggleAddOn(plan.PlanId, addOn.AddOnId, v))"
                                             Label="@($"{addOn.Name} — {FormatPrice(addOn.PriceFor(selectedCurrency), plan.BillingInterval)}")" />
                            }
                        }
                    </MudCardContent>
                    <MudCardActions>
                        <MudButton Variant="Variant.Filled" Color="Color.Primary"
                                   Disabled="@(busy || plan.PriceFor(selectedCurrency) is null)"
                                   OnClick="@(() => Subscribe(plan.PlanId))">
                            @L["Subscribe"]
                        </MudButton>
                    </MudCardActions>
                </MudCard>
            </MudItem>
        }
    </MudGrid>
}
    </Permitted>
    <NotPermitted>
        <MudAlert Severity="Severity.Warning">@L["NoManagePermission"]</MudAlert>
    </NotPermitted>
</SecureView>

@code {
    private System.Security.Claims.ClaimsPrincipal? currentUser;
    private bool canManage;
    private bool busy;
    private SubscriptionOverviewViewModel overview = new();
    private IReadOnlyList<PlanViewModel> plans = System.Array.Empty<PlanViewModel>();
    // Add-on selection per plan (a subscription targets exactly one plan; add-ons are plan-scoped).
    private readonly Dictionary<int, HashSet<int>> selectedAddOnsByPlan = new();
    private List<string> availableCurrencies = new();
    private string? selectedCurrency;

    /// <summary>Rueckkehrmarke aus dem Checkout ("success" / "cancel"), von Subscribe in beide Provider-URLs gesetzt.</summary>
    [SupplyParameterFromQuery(Name = "checkout")]
    private string? checkout { get; set; }

    /// <summary>Nach "success", solange der Webhook das Abo noch nicht eingetragen hat.</summary>
    private bool awaitingConfirmation;

    protected override async Task OnInitializedAsync()
    {
        var auth = await AuthState.GetAuthenticationStateAsync();
        currentUser = auth.User;
        canManage = Handler.CanManage(currentUser);
        if (!canManage)
        {
            return;
        }

        await LoadOverviewAsync();
    }

    private async Task LoadOverviewAsync()
    {
        overview = await Handler.GetOverviewAsync(currentUser!);
        awaitingConfirmation = checkout == "success" && !overview.HasSubscription;
        if (!overview.HasSubscription && !awaitingConfirmation)
        {
            plans = await Handler.GetActivePlansAsync();

            // Currencies a customer can actually subscribe in = those offered by at least one plan.
            availableCurrencies = plans.SelectMany(p => p.Prices).Select(pr => pr.Currency.ToUpperInvariant())
                .Distinct().OrderBy(c => c).ToList();
            selectedCurrency = availableCurrencies.Contains("EUR") ? "EUR" : availableCurrencies.FirstOrDefault();
        }
    }

    /// <summary>Nochmals nachsehen, ob der Webhook inzwischen eingetroffen ist.</summary>
    private async Task RefreshOverview()
    {
        busy = true;
        try
        {
            await LoadOverviewAsync();
        }
        finally
        {
            busy = false;
        }
    }

    /// <summary>Ausweg aus dem Wartezustand: der Benutzer will die Planliste sehen, statt weiter zu warten.</summary>
    private async Task ShowPlans()
    {
        busy = true;
        try
        {
            checkout = null;
            await LoadOverviewAsync();
        }
        finally
        {
            busy = false;
        }
    }

    private void OnCurrencyChanged(string? currency)
    {
        selectedCurrency = currency;
        // Drop any selected add-on that is not priced in the newly chosen currency (subscription is single-currency).
        foreach (var plan in plans)
        {
            if (selectedAddOnsByPlan.TryGetValue(plan.PlanId, out var set))
            {
                set.RemoveWhere(id => plan.AddOns.FirstOrDefault(a => a.AddOnId == id)?.PriceFor(selectedCurrency) is null);
            }
        }
    }

    private bool IsAddOnSelected(int planId, int addOnId)
        => selectedAddOnsByPlan.TryGetValue(planId, out var set) && set.Contains(addOnId);

    private void ToggleAddOn(int planId, int addOnId, bool selected)
    {
        if (!selectedAddOnsByPlan.TryGetValue(planId, out var set))
        {
            set = new HashSet<int>();
            selectedAddOnsByPlan[planId] = set;
        }

        if (selected)
        {
            set.Add(addOnId);
        }
        else
        {
            set.Remove(addOnId);
        }
    }

    private async Task Subscribe(int planId)
    {
        busy = true;
        try
        {
            var addOnIds = selectedAddOnsByPlan.TryGetValue(planId, out var set) ? set.ToList() : new List<int>();
            var basePath = Nav.BaseUri.TrimEnd('/');
            var success = $"{basePath}/Account/Manage/Subscription?checkout=success";
            var cancel = $"{basePath}/Account/Manage/Subscription?checkout=cancel";
            var url = await Handler.StartCheckoutAsync(currentUser!, planId, addOnIds, success, cancel, selectedCurrency);
            Nav.NavigateTo(url, forceLoad: true);
        }
        catch (System.Exception ex)
        {
            Snackbar.Add(L["CheckoutFailed", ex.Message], Severity.Error);
            busy = false;
        }
    }

    private async Task OpenPortal()
    {
        var url = await Handler.OpenPortalAsync(currentUser!, Nav.Uri);
        if (string.IsNullOrEmpty(url))
        {
            Snackbar.Add(L["NoPortal"], Severity.Info);
            return;
        }

        Nav.NavigateTo(url, forceLoad: true);
    }

    private static Color StatusColor(SubscriptionStatus status) => status switch
    {
        SubscriptionStatus.Active => Color.Success,
        SubscriptionStatus.Trialing => Color.Info,
        SubscriptionStatus.PastDue => Color.Warning,
        SubscriptionStatus.Canceled => Color.Error,
        _ => Color.Default
    };

    private string FormatPrice(PriceViewModel? price, BillingInterval interval)
    {
        if (price is null)
        {
            return L["PriceUnavailable"];
        }

        var suffix = interval switch
        {
            BillingInterval.Monthly => "/mo",
            BillingInterval.Yearly => "/yr",
            _ => ""
        };
        return $"{price.Amount:0.00} {price.Currency.ToUpperInvariant()}{suffix}";
    }
}
