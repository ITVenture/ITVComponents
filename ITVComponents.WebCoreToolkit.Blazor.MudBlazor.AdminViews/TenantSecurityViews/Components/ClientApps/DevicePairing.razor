@page "/Connectivity/DevicePairing"
@rendermode @(RenderMode.InteractiveServer)
@attribute [Microsoft.AspNetCore.Authorization.Authorize]

@using Microsoft.Extensions.Localization
@using ITVComponents.WebCoreToolkit.Security.DevicePairing

@inject IDevicePairingService Pairing
@inject IStringLocalizer<ClientAppMessages> L
@inject ISnackbar Snackbar

<PageTitle>@L["Pair_Title"]</PageTitle>

<MudText Typo="Typo.h5" GutterBottom="true">@L["Pair_Title"]</MudText>

@* Dieselbe Ueberlegung wie bei den Client-Anwendungen: die Kopplung bestaetigt der KUNDE an seinem
   eigenen Mandanten, nicht der System-Administrator. *@
<SecureView RequiredPermissions="Apps.Pairing.Confirm" RequiredFeatures="ITVCustomerViews,ITVAdminViews">
    <Permitted>
        <MudPaper Class="pa-4" MaxWidth="640px">
            <MudText Typo="Typo.body1" GutterBottom="true">
                @L["Pair_Intro"]
            </MudText>

            <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center">
                <MudTextField @bind-Value="userCode"
                              Label="@L["Pair_Code"]"
                              Placeholder="K7M4-9QPZ"
                              Immediate="true"
                              OnKeyUp="OnKey"
                              Style="font-family: monospace; font-size: 1.2rem;" />
                <MudButton Variant="Variant.Filled" Color="Color.Primary"
                           OnClick="Look" Disabled="@(busy || string.IsNullOrWhiteSpace(userCode))">
                    @L["Pair_Look"]
                </MudButton>
            </MudStack>

            @if (busy)
            {
                <MudProgressLinear Indeterminate="true" Class="mt-4" />
            }

            @if (preview is { Found: false })
            {
                <MudAlert Severity="Severity.Warning" Class="mt-4">
                    @L["Pair_NotFound"]
                </MudAlert>
            }

            @if (preview is { Found: true })
            {
                <MudDivider Class="my-4" />
                <MudText Typo="Typo.subtitle1">@preview.ClientAppName</MudText>
                <MudText Typo="Typo.body2" Class="mb-3">@L["Pair_Device", preview.DeviceLabel]</MudText>

                @* Der Punkt dieser Maske: zeigen, WAS gerade erteilt wird. Ein Knopf, hinter dem niemand
                   weiss, was er freigibt, ist keine Zustimmung. *@
                <MudText Typo="Typo.body2"><b>@L["Pair_WillGrant"]</b></MudText>
                @if (preview.PermissionSets.Count == 0)
                {
                    <MudAlert Severity="Severity.Info" Class="mt-2">
                        @L["Pair_NothingGranted"]
                    </MudAlert>
                }
                else
                {
                    <MudList T="string" Dense="true">
                        @foreach (var set in preview.PermissionSets)
                        {
                            <MudListItem T="string" Icon="@Icons.Material.Filled.Check">@set</MudListItem>
                        }
                    </MudList>
                }

                <MudButton Variant="Variant.Filled" Color="Color.Primary" Class="mt-4"
                           OnClick="Confirm" Disabled="@busy">
                    @L["Pair_Confirm"]
                </MudButton>
            }

            @if (confirmed)
            {
                <MudAlert Severity="Severity.Success" Class="mt-4">
                    @L["Pair_Confirmed"]
                </MudAlert>
            }
        </MudPaper>
    </Permitted>
    <NotPermitted>
        <MudAlert Severity="Severity.Warning">@L["Pair_NoPermission"]</MudAlert>
    </NotPermitted>
</SecureView>

@code {
    private string? userCode;
    private PairingPreview? preview;
    private bool busy;
    private bool confirmed;

    private async Task OnKey(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !string.IsNullOrWhiteSpace(userCode))
        {
            await Look();
        }
    }

    private async Task Look()
    {
        busy = true;
        confirmed = false;
        try
        {
            preview = await Pairing.DescribeAsync(userCode);
        }
        finally
        {
            busy = false;
        }
    }

    private async Task Confirm()
    {
        busy = true;
        try
        {
            var result = await Pairing.ConfirmAsync(userCode);
            if (result.Success)
            {
                confirmed = true;
                preview = null;
                userCode = null;
                Snackbar.Add(L["Pair_ConfirmedToast"], Severity.Success);
            }
            else
            {
                // Der Grund kommt vom Dienst - etwa "gehoert einem anderen Mandanten".
                // result.Reason kommt vom Dienst und ist NICHT uebersetzt - siehe Leitfaden 68.
                Snackbar.Add(result.Reason ?? L["Pair_ConfirmFailed"], Severity.Error);
            }
        }
        finally
        {
            busy = false;
        }
    }
}
