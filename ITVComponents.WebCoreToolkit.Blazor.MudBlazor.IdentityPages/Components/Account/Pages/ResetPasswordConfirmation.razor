@page "/Account/ResetPasswordConfirmation"
@attribute [Microsoft.AspNetCore.Components.ExcludeFromInteractiveRouting]

@using Microsoft.Extensions.Localization
@using ITVComponents.WebCoreToolkit.Net.TelerikUi.IdentityPages.Areas.Identity

@inject IStringLocalizer<IdentityMessages> L

<PageTitle>@L["Reset password confirmation"]</PageTitle>

<MudContainer MaxWidth="MaxWidth.Small" Class="mt-8">
    <MudPaper Elevation="2" Class="pa-6">
        <MudText Typo="Typo.h4" GutterBottom="true">@L["Reset password confirmation"]</MudText>
        <MudText>
            @L["Your password has been reset."]
            <MudLink Href="Account/Login">@L["Click here to log in."]</MudLink>
        </MudText>
    </MudPaper>
</MudContainer>
