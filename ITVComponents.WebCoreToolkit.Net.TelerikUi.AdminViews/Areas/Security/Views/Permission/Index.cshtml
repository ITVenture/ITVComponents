@using ITVComponents.WebCoreToolkit.Extensions
@using ITVComponents.WebCoreToolkit.Net.Extensions
@using ITVComponents.WebCoreToolkit.Net.TelerikUi.AdminViews.Extensions
@using ITVComponents.WebCoreToolkit.Net.TelerikUi.AdminViews.Helpers
@using ITVComponents.WebCoreToolkit.Net.TelerikUi.AdminViews.Options
@using ITVComponents.WebCoreToolkit.Net.TelerikUi.AdminViews.TenantSecurityViews.Helpers
@using ITVComponents.WebCoreToolkit.Net.TelerikUi.AdminViews.ViewComponents
@using Microsoft.Extensions.Options
@using TextsAndMessagesHelper = ITVComponents.WebCoreToolkit.Net.TelerikUi.AdminViews.TenantSecurityViews.Resources.TextsAndMessagesHelper
@inject IOptions<ViewOptions> viewOptions
@{
    Layout = viewOptions.Value.LayoutPage;
}
@{

    ViewBag.Title = TextsAndMessagesHelper.IWCN_Titles_Permissions;
    var isAdmin = Context.RequestServices.VerifyUserPermissions(new[] {ITVComponents.WebCoreToolkit.EntityFramework.TenantSecurity.Shared.Helpers.ToolkitPermission.Sysadmin});
}
<script src="@("/_content/ITVComponents.WebCoreToolkit.Net.TelerikUi.AdminViews/js/viewScripts.min.js".ExtendUrlWithVersion())"></script>


    @await Component.InvokeAsync(typeof(ShowTable), new { customViewData = new Dictionary<string, object> { { "tenantId", null }, { "roleId", null }, {"renderDetails", !isAdmin} } })

@if (!isAdmin)
{
    @Html.DetailViewScript("PermissionDetails", "Perm#=PermissionId#_#=TenantId#", "~/Security/Role/RoleTable?permissionId=#=PermissionId#&tenantId=#=TenantId#")
}