@using Microsoft.AspNetCore.Components.Authorization

@inject ITenantAdminHandler Handler
@inject AuthenticationStateProvider AuthState
@inject ISnackbar Snackbar

<SecureView RequiredPermissions="Tenants.AssignNav,Sysadmin"><Permitted>
    <MudDataGrid T="TenantNavigationAssignmentViewModel"
                 @ref="grid"
                 ServerData="LoadData"
                 SortMode="SortMode.None"
                 RowsPerPage="25"
                 Hover="true"
                 Dense="true">
        <ToolBarContent>
            <RefreshButton OnClick="@(() => grid is null ? Task.CompletedTask : grid.ReloadServerData())" />
            <MudText Typo="Typo.subtitle2">Navigation items</MudText>
            <MudSpacer />
            <MudTextField @bind-Value="search" Placeholder="Search…" DebounceInterval="300" OnDebounceIntervalElapsed="@(() => grid is null ? Task.CompletedTask : grid.ReloadServerData())" Class="mt-0" />
        </ToolBarContent>
        <Columns>
            <TemplateColumn T="TenantNavigationAssignmentViewModel" Title="" Sortable="false">
                <CellTemplate>
                    <SecureView RequiredPermissions="Tenants.AssignNav,Sysadmin">
                        <Permitted><MudCheckBox T="bool"
                                     Value="context.Item.Assigned"
                                     ValueChanged="@(v => Toggle(context.Item, v))" /></Permitted>
                        <NotPermitted><MudCheckBox T="bool"
                                     Value="context.Item.Assigned"
                                     Disabled="true" /></NotPermitted>
                    </SecureView>
                </CellTemplate>
            </TemplateColumn>
            <PropertyColumn Property="x => x.DisplayName" Title="Item" />
            <PropertyColumn Property="x => x.Url" Title="URL" />
        </Columns>
        <PagerContent><MudDataGridPager T="TenantNavigationAssignmentViewModel" /></PagerContent>
    </MudDataGrid>
</Permitted><NotPermitted>
    <MudAlert Severity="Severity.Info">No permission to view navigation assignments.</MudAlert>
</NotPermitted></SecureView>

@code {
    [Parameter, EditorRequired] public int TenantId { get; set; }

    private MudDataGrid<TenantNavigationAssignmentViewModel>? grid;
    private System.Security.Claims.ClaimsPrincipal? currentUser;
    private bool hasView, hasWrite;
    private string? search;

    protected override async Task OnInitializedAsync()
    {
        var auth = await AuthState.GetAuthenticationStateAsync();
        currentUser = auth.User;
        hasView = Handler.HasPermission(currentUser, "Tenants.AssignNav", "Sysadmin");
        hasWrite = Handler.HasPermission(currentUser, "Tenants.AssignNav", "Sysadmin");
    }

    private async Task<GridData<TenantNavigationAssignmentViewModel>> LoadData(GridState<TenantNavigationAssignmentViewModel> state, CancellationToken ct)
    {
        if (currentUser is null || !hasView) return new GridData<TenantNavigationAssignmentViewModel>();
        var result = await Handler.ListNavigationForTenantAsync(currentUser, TenantId, new ListQuery { Page = state.Page, PageSize = state.PageSize, Search = search });
        return new GridData<TenantNavigationAssignmentViewModel> { Items = result.Items, TotalItems = result.TotalCount };
    }

    private async Task Toggle(TenantNavigationAssignmentViewModel item, bool newValue)
    {
        if (currentUser is null || !hasWrite) return;
        var ok = await Handler.SetNavigationForTenantAsync(currentUser, TenantId, item.NavigationMenuId, newValue);
        if (ok)
        {
            item.Assigned = newValue;
            Snackbar.Add(newValue ? "Navigation item assigned" : "Navigation item removed", Severity.Success);
        }
        else
        {
            Snackbar.Add("Failed to update assignment", Severity.Error);
            if (grid is not null) await grid.ReloadServerData();
        }
    }
}
