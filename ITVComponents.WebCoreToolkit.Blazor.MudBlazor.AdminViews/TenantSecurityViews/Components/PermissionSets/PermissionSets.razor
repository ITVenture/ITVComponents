@page "/Connectivity/PermissionSets"
@rendermode @(RenderMode.InteractiveServer)
@attribute [Microsoft.AspNetCore.Authorization.Authorize]

@using Microsoft.AspNetCore.Components.Authorization
@using ITVComponents.WebCoreToolkit.Blazor.MudBlazor.AdminViews.TenantSecurityViews.Components.CrossGrids

@inject IPermissionSetAdminHandler Handler
@inject AuthenticationStateProvider AuthState
@inject IDialogService DialogService
@inject ISnackbar Snackbar

<PageTitle>App permission sets</PageTitle>

<MudText Typo="Typo.h5" GutterBottom="true">App permission sets</MudText>

<SecureView RequiredPermissions="Apps.PermissionSets.View,Apps.PermissionSets.Write" RequiredFeatures="ITVAdminViews">
    <Permitted>
@if (currentUser is null)
{
    <MudProgressCircular Indeterminate="true" />
}
else
{
    <MudDataGrid T="PermissionSetViewModel"
                 @ref="grid"
                 ServerData="LoadData"
                 SortMode="SortMode.Single"
                 RowsPerPage="25"
                 Hover="true"
                 Dense="true">
        <ToolBarContent>
            <CrudGridToolbar OnRefresh="ReloadGrid" Title="App permission sets" @bind-Search="search" OnSearch="ReloadGrid">
                <SecureView RequiredPermissions="Apps.PermissionSets.Write">
                    <Permitted>
                    <MudButton StartIcon="@Icons.Material.Filled.Add" Variant="Variant.Filled" Color="Color.Primary" Class="ml-2" OnClick="OpenCreate">
                        Add set
                    </MudButton>
                    </Permitted>
                </SecureView>
            </CrudGridToolbar>
        </ToolBarContent>
        <Columns>
            <HierarchyColumn T="PermissionSetViewModel" />
            @* Ohne diese Spalte stehen die Buendel aller Templates ununterscheidbar untereinander -
               "Vollzugriff" gibt es seit PRE240 je Template einmal. *@
            <PropertyColumn Property="x => x.ClientAppTemplateName" Title="Template" Sortable="false" />
            <PropertyColumn Property="x => x.Name" Title="Name" />
            <TemplateColumn T="PermissionSetViewModel" Title="" Sortable="false">
                <CellTemplate>
                    <SecureView RequiredPermissions="Apps.PermissionSets.Write">
                        <Permitted>
                        <MudStack Row="true" Spacing="1">
                            <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" OnClick="@(() => OpenEdit(context.Item))" />
                            <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error" OnClick="@(() => Delete(context.Item))" />
                        </MudStack>
                        </Permitted>
                    </SecureView>
                </CellTemplate>
            </TemplateColumn>
        </Columns>
        <ChildRowContent>
            <MudPaper Elevation="0" Class="pa-2">
                <MudTabs Elevation="0" Rounded="true">
                    <MudTabPanel Text="Permissions">
                        <PermissionsForSetGrid AppPermissionSetId="@context.Item.AppPermissionSetId" />
                    </MudTabPanel>
                </MudTabs>
            </MudPaper>
        </ChildRowContent>
        <PagerContent>
            <MudDataGridPager T="PermissionSetViewModel" />
        </PagerContent>
    </MudDataGrid>
}
    </Permitted>
    <NotPermitted>
        <MudAlert Severity="Severity.Warning">No permission to view permission sets.</MudAlert>
    </NotPermitted>
</SecureView>

@code {
    private MudDataGrid<PermissionSetViewModel>? grid;
    private System.Security.Claims.ClaimsPrincipal? currentUser;
    private bool hasView;
    private bool hasWrite;
    private string? search;
    private IReadOnlyList<ClientAppTemplateViewModel> templates = Array.Empty<ClientAppTemplateViewModel>();

    protected override async Task OnInitializedAsync()
    {
        var auth = await AuthState.GetAuthenticationStateAsync();
        currentUser = auth.User;
        hasView = Handler.HasPermission("Apps.PermissionSets.View", "Apps.PermissionSets.Write");
        hasWrite = Handler.HasPermission("Apps.PermissionSets.Write");
        templates = await Handler.ListTemplatesAsync(currentUser);
    }

    private async Task<GridData<PermissionSetViewModel>> LoadData(GridState<PermissionSetViewModel> state, CancellationToken ct)
    {
        if (currentUser is null) return new GridData<PermissionSetViewModel> { Items = Array.Empty<PermissionSetViewModel>(), TotalItems = 0 };
        var query = state.ToListQuery(search);
        var result = await Handler.ListAsync(currentUser, query);
        return new GridData<PermissionSetViewModel> { Items = result.Items, TotalItems = result.TotalCount };
    }

    private async Task ReloadGrid()
    {
        if (grid is not null) await grid.ReloadServerData();
    }

    private async Task OpenCreate()
    {
        if (templates.Count == 0)
        {
            // Ein Buendel ohne Template kann es nicht geben - ohne Template waere der Dialog eine
            // Sackgasse, an deren Ende der Fremdschluessel steht.
            Snackbar.Add("Create a client app template first - a permission set belongs to exactly one template.", Severity.Warning);
            return;
        }

        var model = new PermissionSetViewModel { ClientAppTemplateId = templates[0].ClientAppTemplateId };
        var parameters = new DialogParameters<PermissionSetDialog>
        {
            { d => d.Model, model }, { d => d.IsCreate, true }, { d => d.Templates, templates }
        };
        var dlg = await DialogService.ShowAsync<PermissionSetDialog>("Create permission set", parameters, EditDialogDefaults.Edit);
        var result = await dlg.Result;
        if (result is { Canceled: false, Data: PermissionSetViewModel input })
        {
            var created = await Handler.CreateAsync(currentUser!, input);
            if (created != null) { Snackbar.Add("Permission set created", Severity.Success); await ReloadGrid(); }
            else Snackbar.Add("Could not create the permission set - the template may already have a set of that name. See the log.", Severity.Error);
        }
    }

    private async Task OpenEdit(PermissionSetViewModel item)
    {
        var copy = new PermissionSetViewModel
        {
            AppPermissionSetId = item.AppPermissionSetId,
            ClientAppTemplateId = item.ClientAppTemplateId,
            ClientAppTemplateName = item.ClientAppTemplateName,
            Name = item.Name
        };
        var parameters = new DialogParameters<PermissionSetDialog>
        {
            { d => d.Model, copy }, { d => d.IsCreate, false }, { d => d.Templates, templates }
        };
        var dlg = await DialogService.ShowAsync<PermissionSetDialog>("Edit permission set", parameters, EditDialogDefaults.Edit);
        var result = await dlg.Result;
        if (result is { Canceled: false, Data: PermissionSetViewModel input })
        {
            var updated = await Handler.UpdateAsync(currentUser!, input);
            if (updated != null) { Snackbar.Add("Permission set updated", Severity.Success); await ReloadGrid(); }
            else Snackbar.Add("Could not update the permission set - the name may be taken within the template, or a client app still uses the set. See the log.", Severity.Error);
        }
    }

    private async Task Delete(PermissionSetViewModel item)
    {
        var ok = await DialogService.ShowMessageBoxAsync("Delete permission set", $"Really delete '{item.Name}'?", yesText: "Delete", cancelText: "Cancel");
        if (ok != true) return;
        var success = await Handler.DeleteAsync(currentUser!, item.AppPermissionSetId);
        if (success) { Snackbar.Add("Permission set deleted", Severity.Success); await ReloadGrid(); }
        else Snackbar.Add("Failed to delete", Severity.Error);
    }
}
