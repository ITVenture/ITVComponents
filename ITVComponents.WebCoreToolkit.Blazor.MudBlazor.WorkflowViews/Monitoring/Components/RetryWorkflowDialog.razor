@inject IWorkflowMonitorHandler Handler
@inject AuthenticationStateProvider AuthState
@inject IStringLocalizer<WorkflowMonitorMessages> L

@*
    Nimmt eine fehlgeschlagene Instanz an ihren Fehlerstellen wieder auf. Der Token steht beim Fault noch
    AKTIV auf seinem Knoten - es wird also nichts zurueckgespult und nichts uebersprungen, sondern genau
    der Schritt wiederholt, der scheiterte.

    Es kann MEHRERE stehen gebliebene Zweige geben (nebenlaeufiger Betrieb: ein Fault sperrt RunBranch
    nicht, ein bereits laufender Zweig fuehrt seinen Schritt zu Ende). Jeder hat nach einem Split seinen
    EIGENEN Scope - deshalb ein Reiter je Zweig statt einer gemeinsamen Variablenliste. Der Aufrufer kann
    ueber FocusNodeId direkt auf einen Zweig springen (Doppelklick im Graphen).
*@

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">
            <MudIcon Icon="@Icons.Material.Filled.RestartAlt" Class="mr-2" />
            <span>@L["RetryTitle"]</span>
        </MudText>
    </TitleContent>
    <DialogContent>
        @if (info is null)
        {
            <MudProgressCircular Indeterminate="true" />
        }
        else if (!info.CanRetry)
        {
            <MudAlert Severity="Severity.Error" Dense="true" Class="mb-3">
                @(info.FaultMessage ?? L["RetryNoMessage"].Value)
            </MudAlert>
            <MudAlert Severity="Severity.Warning">@info.Reason</MudAlert>
        }
        else
        {
            @if (branches.Count > 1)
            {
                <MudAlert Severity="Severity.Info" Dense="true" Class="mb-3">
                    @L["RetryManyBranches", branches.Count(b => b.Source.Faulted), branches.Count]
                </MudAlert>
            }

            <MudTabs Elevation="0" Rounded="true" PanelClass="pt-3" KeepPanelsAlive="true"
                     @bind-ActivePanelIndex="activeTab">
                @foreach (BranchRows branch in branches)
                {
                    <MudTabPanel Text="@BranchTitle(branch)"
                                 Icon="@(branch.Source.Faulted ? Icons.Material.Filled.ErrorOutline : null)"
                                 IconColor="Color.Error">
                        @if (branch.Source.Faulted)
                        {
                            <MudAlert Severity="Severity.Error" Dense="true" Class="mb-3">
                                @(branch.Source.FaultMessage ?? info.FaultMessage
                                  ?? L["RetryStepNoMessage"].Value)
                            </MudAlert>
                        }
                        else
                        {
                            @* Kein eigener Fehler: dieser Zweig kam nur nicht mehr dran. Er laeuft beim
                               Retry trotzdem weiter - das muss man ihm ansehen. *@
                            <MudAlert Severity="Severity.Info" Dense="true" Class="mb-3">@L["RetryBranchNotFailed"]</MudAlert>
                        }

                        <MudText Typo="Typo.caption" Class="mud-text-secondary mb-2">@L["RetryDataHint"]</MudText>

                        <MudTable Items="@branch.Rows" Dense="true" Hover="true" Breakpoint="Breakpoint.Sm"
                                  RowsPerPageOptions="@(new[] { 10, 25, 50 })">
                            <HeaderContent>
                                <MudTh Style="width:30%">@L["RetryColumnVariable"]</MudTh>
                                <MudTh>@L["DetailVarValue"]</MudTh>
                                <MudTh Style="width:1%"></MudTh>
                            </HeaderContent>
                            <RowTemplate>
                                <MudTd DataLabel="@L["RetryColumnVariable"]">
                                    <MudText Typo="Typo.body2">@context.Name</MudText>
                                    <MudText Typo="Typo.caption" Class="mud-text-secondary">@context.Kind</MudText>
                                </MudTd>
                                <MudTd DataLabel="@L["DetailVarValue"]">
                                    @if (context.Kind == WorkflowVariableKind.Complex)
                                    {
                                        <MudText Typo="Typo.caption" Class="mud-text-secondary">@context.Text</MudText>
                                    }
                                    else if (context.Kind == WorkflowVariableKind.Boolean)
                                    {
                                        <MudSelect T="string" Value="@context.Text" Dense="true" Margin="Margin.Dense"
                                                   ValueChanged="@(v => context.Text = v)">
                                            <MudSelectItem T="string" Value="@("true")">true</MudSelectItem>
                                            <MudSelectItem T="string" Value="@("false")">false</MudSelectItem>
                                        </MudSelect>
                                    }
                                    else
                                    {
                                        <MudTextField T="string" Value="@context.Text" Margin="Margin.Dense"
                                                      ValueChanged="@(v => context.Text = v)" />
                                    }
                                </MudTd>
                                <MudTd>
                                    @if (context.IsNew)
                                    {
                                        <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small"
                                                       Color="Color.Error"
                                                       OnClick="@(() => branch.Rows.Remove(context))" />
                                    }
                                    else if (context.Changed)
                                    {
                                        <MudTooltip Text="@L["RetryWasValue", context.Original ?? string.Empty].Value">
                                            <MudIcon Icon="@Icons.Material.Filled.Edit" Size="Size.Small"
                                                     Color="Color.Warning" />
                                        </MudTooltip>
                                    }
                                </MudTd>
                            </RowTemplate>
                        </MudTable>

                        @* Der Fehler ist oft eine FEHLENDE Variable - dann muss man eine anlegen koennen. *@
                        <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center" Class="mt-2">
                            <MudTextField T="string" Value="@branch.NewName" Placeholder="@L["RetryNewVariable"]"
                                          Margin="Margin.Dense" Style="max-width:200px"
                                          ValueChanged="@(v => branch.NewName = v)" />
                            <MudSelect T="WorkflowVariableKind" Value="@branch.NewKind" Dense="true"
                                       Margin="Margin.Dense" Style="max-width:150px"
                                       ValueChanged="@(k => branch.NewKind = k)">
                                <MudSelectItem T="WorkflowVariableKind" Value="WorkflowVariableKind.Text">@L["KindText"]</MudSelectItem>
                                <MudSelectItem T="WorkflowVariableKind" Value="WorkflowVariableKind.Number">@L["KindNumber"]</MudSelectItem>
                                <MudSelectItem T="WorkflowVariableKind" Value="WorkflowVariableKind.Boolean">@L["KindBoolean"]</MudSelectItem>
                                <MudSelectItem T="WorkflowVariableKind" Value="WorkflowVariableKind.DateTime">@L["KindDate"]</MudSelectItem>
                            </MudSelect>
                            <MudIconButton Icon="@Icons.Material.Filled.Add" Size="Size.Small" Color="Color.Primary"
                                           OnClick="@(() => AddVariable(branch))" />
                        </MudStack>
                    </MudTabPanel>
                }
            </MudTabs>
        }

        @if (!string.IsNullOrEmpty(error))
        {
            <MudAlert Severity="Severity.Error" Class="mt-3">@error</MudAlert>
        }
    </DialogContent>
    <DialogActions>
        <DialogMaximizeToggle NormalMaxWidth="MaxWidth.Medium" />
        <MudSpacer />
        <MudButton OnClick="Cancel" Disabled="@retrying">@L["Cancel"]</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.RestartAlt"
                   OnClick="Retry" Disabled="@(retrying || info is null || !info.CanRetry)">
            @(branches.Count > 1 ? L["RetryAllBranches"] : L["RetryAction"])
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    /// <summary>Eine bearbeitbare Zeile der Variablen-Tabelle.</summary>
    private sealed class Row
    {
        public string Name { get; init; } = "";
        public string Original { get; init; } = "";
        public string? Text { get; set; }
        public WorkflowVariableKind Kind { get; init; }
        public bool IsNew { get; init; }

        /// <summary>Wurde der Wert angefasst? Nur geaenderte Werte werden ueberhaupt geschickt.</summary>
        public bool Changed => IsNew || !string.Equals(Text ?? string.Empty, Original, StringComparison.Ordinal);
    }

    /// <summary>Ein Zweig samt seinen bearbeitbaren Zeilen (jeder Zweig hat seinen eigenen Scope).</summary>
    private sealed class BranchRows
    {
        public WorkflowRetryBranch Source { get; init; } = default!;
        public List<Row> Rows { get; init; } = new();
        public string? NewName { get; set; }
        public WorkflowVariableKind NewKind { get; set; } = WorkflowVariableKind.Text;
    }

    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;

    /// <summary>Die fehlgeschlagene Instanz.</summary>
    [Parameter] public string InstanceId { get; set; } = default!;

    /// <summary>Die (optional) gewählte Workflow-Umgebung.</summary>
    [Parameter] public string? Environment { get; set; }

    /// <summary>
    /// Optional: der Knoten, dessen Zweig beim Öffnen aktiv sein soll (Doppelklick im Graphen).
    /// </summary>
    [Parameter] public string? FocusNodeId { get; set; }

    private WorkflowRetryInfo? info;
    private List<BranchRows> branches = new();
    private ClaimsPrincipal? currentUser;
    private int activeTab;
    private string? error;
    private bool retrying;

    protected override async Task OnInitializedAsync()
    {
        AuthenticationState auth = await AuthState.GetAuthenticationStateAsync();
        currentUser = auth.User;
        info = await Handler.GetRetryInfoAsync(currentUser, InstanceId, Environment);
        if (info is null)
        {
            error = L["RetryLoadFailed"];
            return;
        }

        branches = info.Branches
            .Select(b => new BranchRows
            {
                Source = b,
                Rows = b.Variables
                    .Select(v => new Row { Name = v.Name, Original = v.Value, Text = v.Value, Kind = v.Kind })
                    .ToList()
            })
            .ToList();

        // Auf den angeklickten Zweig springen; ohne Vorgabe steht der zuletzt gemeldete Fehler vorne.
        int idx = FocusNodeId is null
            ? -1
            : branches.FindIndex(b => b.Source.NodeId == FocusNodeId);
        activeTab = idx >= 0 ? idx : 0;
    }

    private string BranchTitle(BranchRows branch)
        => branch.Source.NodeName ?? branch.Source.NodeId ?? L["RetryBranchFallback"];

    private void AddVariable(BranchRows branch)
    {
        if (string.IsNullOrWhiteSpace(branch.NewName)
            || branch.Rows.Any(r => string.Equals(r.Name, branch.NewName, StringComparison.OrdinalIgnoreCase)))
        {
            return;
        }

        branch.Rows.Add(new Row
        {
            Name = branch.NewName!.Trim(),
            Original = string.Empty,
            Text = branch.NewKind == WorkflowVariableKind.Boolean ? "false" : string.Empty,
            Kind = branch.NewKind,
            IsNew = true
        });
        branch.NewName = null;
    }

    private async Task Retry()
    {
        if (info is null || !info.CanRetry || retrying)
        {
            return;
        }

        error = null;
        retrying = true;
        try
        {
            // Je Zweig nur das schicken, was der Benutzer tatsaechlich angefasst hat - sonst wuerde jeder
            // Retry den ganzen Scope neu schreiben und dabei Typen umformen, die niemand aendern wollte.
            var updates = new Dictionary<string, IDictionary<string, object?>>(StringComparer.Ordinal);
            foreach (BranchRows branch in branches)
            {
                var changed = branch.Rows
                    .Where(r => r.Kind != WorkflowVariableKind.Complex && r.Changed)
                    .ToDictionary(r => r.Name, r => WorkflowVariableValue.Parse(r.Text, r.Kind),
                        StringComparer.Ordinal);
                if (changed.Count > 0)
                {
                    updates[branch.Source.TokenId] = changed;
                }
            }

            WorkflowRetryResult result = await Handler.RetryAsync(currentUser!, InstanceId, updates, Environment);
            if (!result.Resumed)
            {
                error = result.Error ?? L["RetryFailed"];
                return;
            }

            MudDialog.Close(DialogResult.Ok(true));
        }
        finally
        {
            retrying = false;
        }
    }

    private void Cancel() => MudDialog.Cancel();
}
