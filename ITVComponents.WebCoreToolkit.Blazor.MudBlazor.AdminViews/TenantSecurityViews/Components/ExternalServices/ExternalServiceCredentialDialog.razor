@using Microsoft.AspNetCore.Components.Authorization
@using ITVComponents.WebCoreToolkit.Models.ExternalServiceConnect

@inject IExternalServiceAdminHandler Handler
@inject AuthenticationStateProvider AuthState

@* Speichert im Dialog: der Handler prueft Sichtbarkeit, Besitz und Pflichtfelder, und eine Ablehnung haelt den Dialog mit
   dem Grund offen. Gespeicherte Werte kommen nie zurueck in die Maske - leer lassen heisst behalten. *@
<EditDialogShell Model="Model" IsCreate="!HasStoredSecret" OnValidated="SaveAsync" Busy="busy">
    @if (!string.IsNullOrEmpty(error))
    {
        <MudAlert Severity="Severity.Error" Dense="true" Class="mb-2">@error</MudAlert>
    }
    @if (HasUser)
    {
        <MudTextField @bind-Value="Model.User" Label="@UserLabel" Required="true" RequiredError="@($"{UserLabel} is required")" />
    }
    <MudTextField @bind-Value="Model.Secret" Label="@SecretLabel" InputType="InputType.Password"
                  Required="@(!HasStoredSecret)" RequiredError="@($"{SecretLabel} is required")"
                  HelperText="@(HasStoredSecret ? "Stored encrypted. Leave empty to keep the current value." : "Stored encrypted; it will not be shown again.")" />
    @if (SupportsInheritance)
    {
        <MudSwitch T="bool" @bind-Value="Model.Inheritable" Label="Pass on to sub-tenants without own credentials" Color="Color.Primary" Class="mt-2" />
    }
</EditDialogShell>

@code {
    [Parameter, EditorRequired] public ExternalServiceCredentialInputViewModel Model { get; set; } = default!;
    [Parameter] public ExternalServiceAuthenticationType AuthenticationType { get; set; }
    [Parameter] public bool HasStoredSecret { get; set; }
    [Parameter] public bool SupportsInheritance { get; set; }

    private string? error;
    private bool busy;

    private bool HasUser => AuthenticationType is ExternalServiceAuthenticationType.Basic or ExternalServiceAuthenticationType.OAuthPasswordFlow
        or ExternalServiceAuthenticationType.OAuthClientCredentialsFlow or ExternalServiceAuthenticationType.OAuthBasicClientCredentialsFlow;

    private string UserLabel => AuthenticationType is ExternalServiceAuthenticationType.Basic or ExternalServiceAuthenticationType.OAuthPasswordFlow
        ? "Username" : "Client ID";

    private string SecretLabel => AuthenticationType switch
    {
        ExternalServiceAuthenticationType.ApiKey => "API key",
        ExternalServiceAuthenticationType.BearerToken => "Bearer token",
        ExternalServiceAuthenticationType.Basic or ExternalServiceAuthenticationType.OAuthPasswordFlow => "Password",
        _ => "Client secret"
    };

    private async Task<bool> SaveAsync()
    {
        busy = true;
        error = null;
        try
        {
            var auth = await AuthState.GetAuthenticationStateAsync();
            var result = await Handler.SaveCredentialsAsync(auth.User, Model);
            if (!result.Success)
            {
                error = result.Error;
                return false;
            }

            return true;
        }
        finally
        {
            busy = false;
        }
    }
}
