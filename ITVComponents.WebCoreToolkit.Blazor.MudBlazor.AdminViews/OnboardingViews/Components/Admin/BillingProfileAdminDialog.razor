@using Microsoft.AspNetCore.Components.Authorization
@using ITVComponents.WebCoreToolkit.Blazor.MudBlazor.AdminViews.OnboardingViews.Components.Shared

@inject IOnboardingAdminHandler Handler
@inject AuthenticationStateProvider AuthState
@inject ISnackbar Snackbar

<MudDialog>
    <DialogContent>
        @if (model is null)
        {
            <MudProgressCircular Indeterminate="true" />
        }
        else
        {
            <MudTabs Elevation="0" Rounded="true" Outlined="true" PanelClass="pa-2">
                <MudTabPanel Text="Profile">
                    <MudForm @ref="form" Model="model">
                        <MudGrid Spacing="2">
                            <MudItem xs="12" sm="6">
                                <MudSelect T="ProfileType" @bind-Value="model.ProfileType" Label="Profile type">
                                    @foreach (var pt in System.Enum.GetValues<ProfileType>())
                                    {
                                        <MudSelectItem T="ProfileType" Value="@pt">@pt</MudSelectItem>
                                    }
                                </MudSelect>
                            </MudItem>
                            <MudItem xs="12" sm="6">
                                <MudTextField @bind-Value="model.Email" Label="Email" Required="true" For="@(() => model.Email)" />
                            </MudItem>

                            @if (model.ProfileType == ProfileType.Company)
                            {
                                <MudItem xs="12" sm="8">
                                    <MudTextField @bind-Value="model.CompanyName" Label="Company name" For="@(() => model.CompanyName)" />
                                </MudItem>
                                <MudItem xs="12" sm="4">
                                    <MudTextField @bind-Value="model.VatNumber" Label="VAT number" For="@(() => model.VatNumber)" />
                                </MudItem>
                            }
                            else
                            {
                                <MudItem xs="12" sm="6">
                                    <MudTextField @bind-Value="model.FirstName" Label="First name" For="@(() => model.FirstName)" />
                                </MudItem>
                                <MudItem xs="12" sm="6">
                                    <MudTextField @bind-Value="model.LastName" Label="Last name" For="@(() => model.LastName)" />
                                </MudItem>
                            }

                            <MudItem xs="12" sm="6">
                                <MudTextField @bind-Value="model.PhoneNumber" Label="Phone" For="@(() => model.PhoneNumber)" />
                            </MudItem>
                        </MudGrid>

                        <MudText Typo="Typo.subtitle1" Class="mt-3 mb-1">Address</MudText>
                        <AddressEditor Title="Default address" Address="model.DefaultAddress" />

                        <MudCheckBox T="bool" @bind-Value="model.UseInvoiceAddr" Label="Use a separate invoice address" />
                        @if (model.UseInvoiceAddr)
                        {
                            <AddressEditor Title="Invoice address" Address="model.InvoiceAddress" />
                        }

                        <MudButton Variant="Variant.Filled" Color="Color.Primary" Class="mt-2" Disabled="@busy" OnClick="Save">Save profile</MudButton>
                    </MudForm>
                </MudTabPanel>
                <MudTabPanel Text="Employees">
                    @if (BillingProfileId == 0 || model.BillingProfileId == 0)
                    {
                        <MudAlert Severity="Severity.Info">Save the profile first to manage its employees.</MudAlert>
                    }
                    else
                    {
                        <EmployeesGrid BillingProfileId="model.BillingProfileId" />
                    }
                </MudTabPanel>
            </MudTabs>
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Close">Close</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;
    [Parameter] public int BillingProfileId { get; set; }

    private System.Security.Claims.ClaimsPrincipal? currentUser;
    private BillingProfileAdminViewModel? model;
    private MudForm? form;
    private bool busy;

    protected override async Task OnInitializedAsync()
    {
        var auth = await AuthState.GetAuthenticationStateAsync();
        currentUser = auth.User;
        model = BillingProfileId != 0
            ? await Handler.GetBillingProfileAsync(currentUser, BillingProfileId) ?? new BillingProfileAdminViewModel()
            : new BillingProfileAdminViewModel();
    }

    private async Task Save()
    {
        if (form is null || model is null || currentUser is null)
        {
            return;
        }

        await form.Validate();
        if (!form.IsValid)
        {
            Snackbar.Add("Please correct invalid fields", Severity.Warning);
            return;
        }

        busy = true;
        try
        {
            var id = await Handler.SaveBillingProfileAsync(currentUser, model);
            if (id is null)
            {
                Snackbar.Add("Failed to save profile", Severity.Error);
                return;
            }

            model.BillingProfileId = id.Value;
            Snackbar.Add("Profile saved", Severity.Success);
        }
        finally
        {
            busy = false;
        }
    }

    private void Close() => MudDialog.Close();
}
