@using System.Globalization
@using System.Security.Claims
@using System.Threading
@using ITVComponents.Workflow.Activities
@using ITVComponents.Workflow.Model
@using ITVComponents.WebCoreToolkit.Blazor.MudBlazor.WorkflowViews.Design.Handlers
@using ITVComponents.WebCoreToolkit.Blazor.MudBlazor.WorkflowViews.Runtime
@using Microsoft.AspNetCore.Components.Authorization
@inject IDialogService DialogService
@inject IWorkflowDesignHandler Handler
@inject AuthenticationStateProvider AuthState
@inject IServiceProvider Services

@*
    Tab-basierter Editor für einen AutomatedActivityNode. Löst den früheren, überladenen Flach-Editor
    ab: die Belange sind auf Reiter verteilt, Listen sind seitenweise Tabellen, Details (Config-Werte,
    Ein-/Ausgabe-Bindungen) werden in eigenen Popups bearbeitet - dort ist Platz für Ausdrücke.
    Reiter: General, Configuration, Variable mapping, Scope, Error handling.
*@

@if (Node is not null)
{
    <MudTabs Elevation="0" Rounded="true" ApplyEffectsToContainer="true" PanelClass="pt-4" MinimumTabWidth="70px">
        @* --- General --- *@
        <MudTabPanel Text="General" Icon="@Icons.Material.Filled.Info">
            <SectionSelect Node="Node" Def="Def" />
            <MudTextField Value="@Node.Id" Label="Id" ReadOnly="true" Margin="Margin.Dense" />
            <MudTextField @bind-Value="Node.Name" Label="Name" Margin="Margin.Dense" />
            @if (activityTypes.Count > 0)
            {
                <MudSelect T="string" Value="@Node.ActivityRef" ValueChanged="OnActivitySelected"
                           Label="Activity" Margin="Margin.Dense" Dense="true">
                    @foreach (var at in activityTypes)
                    {
                        <MudSelectItem T="string" Value="@at.ActivityRef">@at.DisplayName</MudSelectItem>
                    }
                </MudSelect>
            }
            else
            {
                <MudTextField @bind-Value="Node.ActivityRef" Label="Activity reference" Margin="Margin.Dense" />
            }
            <MudAutocomplete T="string" Value="@Node.ExecutionTarget" ValueChanged="SetExecutionTarget"
                             SearchFunc="SearchInstances" CoerceValue="true" CoerceText="false"
                             ResetValueOnEmptyText="false" Clearable="true"
                             Label="Execution target" Placeholder="(any host)" Margin="Margin.Dense" />
            <MudText Typo="Typo.caption" Class="mud-text-secondary">
                Name of the worker instance this activity must run on. Picks that instance's activity catalog.
                Suggestions come from the environment's instances; free text is allowed. Empty = any runner.
            </MudText>
        </MudTabPanel>

        @* --- Basic configuration (rohe Key/Value-Dictionary generischer Aktivitäten) --- *@
        <MudTabPanel Text="Configuration" Icon="@Icons.Material.Filled.Settings">
            <MudText Typo="Typo.caption" Class="mud-text-secondary mb-2">
                Static configuration for generic activities that read their own settings. Typed activities
                usually use the variable mapping instead.
            </MudText>
            <MudTable Items="@ConfigRows" Hover="true" Dense="true" Breakpoint="Breakpoint.Sm"
                      RowsPerPageOptions="@(new[] { 5, 10, 25 })">
                <ToolBarContent>
                    <MudButton StartIcon="@Icons.Material.Filled.Add" Size="Size.Small" Variant="Variant.Outlined"
                               Color="Color.Primary" OnClick="AddConfig">Add value</MudButton>
                    <MudSpacer />
                </ToolBarContent>
                <HeaderContent>
                    <MudTh>Key</MudTh>
                    <MudTh>Value</MudTh>
                    <MudTh Style="width:1%"></MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="Key">@context.Key</MudTd>
                    <MudTd DataLabel="Value">@Clip(ToStr(context.Value))</MudTd>
                    <MudTd>
                        <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small"
                                       OnClick="@(() => EditConfig(context.Key))" />
                    </MudTd>
                </RowTemplate>
                <PagerContent>
                    <MudTablePager />
                </PagerContent>
            </MudTable>
        </MudTabPanel>

        @* --- Variable mapping (Ein-/Ausgabe-Bindungen) --- *@
        <MudTabPanel Text="Variable mapping" Icon="@Icons.Material.Filled.SwapHoriz">
            <BindingMappingTables Inputs="Node.Inputs" Outputs="Node.Outputs"
                                  InputParameterOptions="InputParameterNames()"
                                  OutputParameterOptions="OutputParameterNames()" />
        </MudTabPanel>

        @* --- Iteration (je Element einer Sammlung, optional parallel) --- *@
        <MudTabPanel Text="Iteration" Icon="@Icons.Material.Filled.Repeat">
            <MudSwitch T="bool" Value="@IterationEnabled" ValueChanged="ToggleIteration" Color="Color.Primary"
                       Label="Run this activity once per item of a collection" />
            @if (Node.Iteration is not null)
            {
                <MudText Typo="Typo.caption" Class="mud-text-secondary mb-2">
                    The activity is invoked once per item instead of once. This stays a single branch — no extra
                    tokens, no extra commits. Each output parameter is collected into a list in input order.
                </MudText>

                <MudAutocomplete T="string" Value="@Node.Iteration.ItemsInput"
                                 ValueChanged="@(v => Node.Iteration.ItemsInput = v)"
                                 SearchFunc="SearchBoundInputs" CoerceValue="true" CoerceText="false"
                                 ResetValueOnEmptyText="false" Clearable="true"
                                 Label="Collection comes from input parameter" Margin="Margin.Dense" />
                <MudText Typo="Typo.caption" Class="mud-text-secondary">
                    Must be one of this node's input bindings and must resolve to something enumerable. Null counts
                    as an empty collection; a string is rejected rather than split into characters.
                </MudText>

                <MudTextField @bind-Value="Node.Iteration.ItemParameter" Label="Item → input parameter"
                              Placeholder="(same as above)" Margin="Margin.Dense" Class="mt-3" />
                <MudTextField @bind-Value="Node.Iteration.IndexParameter" Label="Index → input parameter (optional)"
                              Margin="Margin.Dense" />

                <MudNumericField @bind-Value="Node.Iteration.MaxParallel" Label="Items at a time" Min="0"
                                 Margin="Margin.Dense" Class="mt-3" />
                <MudText Typo="Typo.caption" Class="mud-text-secondary">
                    1 = strictly one after another. 0 = as many as there are processor cores. Anything above 1
                    requires the activity to be <b>thread-safe</b>: it is resolved once and called from several
                    threads at the same time. Writes to <code>context.Variables</code> are discarded per item
                    (each item gets its own copy) — return values through the outputs.
                </MudText>

                <MudDivider Class="my-3" />
                <MudSwitch T="bool" @bind-Value="Node.Iteration.ContinueOnError" Color="Color.Primary"
                           Label="Keep going when an item fails" />
                <MudText Typo="Typo.caption" Class="mud-text-secondary">
                    Off: the first failure stops the run (items already started finish) and the node fails. On:
                    every item is attempted, and the node fails at the end if any did — with the full result.
                </MudText>
                <MudTextField @bind-Value="Node.Iteration.PendingItemsOutput"
                              Label="Still pending (failed + never attempted) → output parameter (optional)"
                              Margin="Margin.Dense" Class="mt-3" />
                <MudTextField @bind-Value="Node.Iteration.FailedItemsOutput"
                              Label="Failures → output parameter (optional)" Margin="Margin.Dense" />
                <MudTextField @bind-Value="Node.Iteration.SucceededCountOutput"
                              Label="Number of successful items → output parameter (optional)" Margin="Margin.Dense" />
                <MudText Typo="Typo.caption" Class="mud-text-secondary">
                    Feed the <b>pending</b> list into a retry — it holds the plain originals, and it is the only
                    one that also contains items that were never tried after an abort. The <b>failures</b> list is
                    for diagnosis: one entry per failed item with <code>Item</code>, <code>Index</code>,
                    <code>Message</code> and — if it crashed rather than declined — <code>ExceptionType</code> and
                    <code>ExceptionDetail</code>.
                </MudText>

                <MudDivider Class="my-3" />
                <MudText Typo="Typo.subtitle2">Carrying results across attempts</MudText>
                <MudText Typo="Typo.caption" Class="mud-text-secondary mb-2">
                    For a retry loop: each pass only works on what is left, but the result should end up complete.
                </MudText>
                <MudAutocomplete T="string" Value="@Node.Iteration.ItemResultOutput"
                                 ValueChanged="@(v => Node.Iteration.ItemResultOutput = v)"
                                 SearchFunc="SearchDeclaredOutputs" CoerceValue="true" CoerceText="false"
                                 ResetValueOnEmptyText="false" Clearable="true"
                                 Label="The finished item is the per-item output parameter" Margin="Margin.Dense" />
                <MudTextField @bind-Value="Node.Iteration.SucceededItemsOutput"
                              Label="Succeeded items → output parameter (optional)" Margin="Margin.Dense" />
                <MudAutocomplete T="string" Value="@Node.Iteration.CarryOverInput"
                                 ValueChanged="@(v => Node.Iteration.CarryOverInput = v)"
                                 SearchFunc="SearchBoundInputs" CoerceValue="true" CoerceText="false"
                                 ResetValueOnEmptyText="false" Clearable="true"
                                 Label="Prepend already finished items from input parameter" Margin="Margin.Dense" />
                <MudText Typo="Typo.caption" Class="mud-text-secondary">
                    Succeeded items hold the <b>results</b> (the parameter above), the failed and pending lists hold
                    the <b>originals</b> — that asymmetry is what makes the loop fit together. The carried-over list
                    is prepended to the succeeded items only; the other result lists stay strictly "this pass".
                </MudText>
                <MudText Typo="Typo.caption" Class="mud-text-secondary">
                    Map all of these on the "Variable mapping" tab like any other output.
                </MudText>
            }
        </MudTabPanel>

        @* --- Scope consolidation --- *@
        <MudTabPanel Text="Scope" Icon="@Icons.Material.Filled.FilterAlt">
            <ScopeModeSection Mode="Node.ScopeMode" ModeChanged="@(m => Node.ScopeMode = m)"
                              RetainVariables="Node.RetainVariables"
                              HelperText="@("After this activity the scope contains only its outputs plus the variables kept here. Place on a single branch (after a join), not inside a parallel region.")" />
        </MudTabPanel>

        @* --- Error handling --- *@
        <MudTabPanel Text="Error handling" Icon="@Icons.Material.Filled.ErrorOutline">
            @if (string.IsNullOrEmpty(Node.ErrorFlowId))
            {
                <MudText Typo="Typo.body2" Class="mud-text-secondary">
                    No error output. Drag from the red port in the graph to add one — on failure (exception or
                    ctx.Fail) the token then takes that flow instead of faulting the instance.
                </MudText>
            }
            else
            {
                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                    <MudIcon Icon="@Icons.Material.Filled.CallSplit" Color="Color.Error" Size="Size.Small" />
                    <MudText Typo="Typo.body2">Error output → <b>@ErrorTargetName(Node.ErrorFlowId)</b></MudText>
                    <MudSpacer />
                    <MudTooltip Text="Make it a normal connection again">
                        <MudIconButton Icon="@Icons.Material.Filled.LinkOff" Size="Size.Small"
                                       OnClick="@(() => Node.ErrorFlowId = null)" />
                    </MudTooltip>
                </MudStack>
                <MudTextField @bind-Value="Node.ErrorVariable" Label="Error message → variable" Margin="Margin.Dense" />
                <MudTextField @bind-Value="Node.AttemptVariable" Label="Attempt count → variable" Margin="Margin.Dense" />
                <MudText Typo="Typo.caption" Class="mud-text-secondary">
                    The single other outgoing flow is the success path. The attempt counter increments per failure
                    and resets on success — branch on it for retries.
                </MudText>
            }
        </MudTabPanel>
    </MudTabs>
}

@code {
    /// <summary>Der zu konfigurierende Aktivitäts-Knoten.</summary>
    [Parameter] public AutomatedActivityNode? Node { get; set; }

    /// <summary>Die (optional) gewählte Umgebung - bestimmt zusammen mit dem ExecutionTarget den
    /// per-Instanz-Katalog. Ohne Umgebung/passende Instanz greift der Default-Katalog.</summary>
    [Parameter] public string? Environment { get; set; }

    /// <summary>Die Definition - für die Anzeige des Fehler-Zielknotens.</summary>
    [Parameter] public WorkflowDefinition? Def { get; set; }

    // Aktivitätstypen und -parameter kommen jetzt PRO INSTANZ (ExecutionTarget) über den Handler, der den
    // passenden Katalog least, abfragt und wieder freigibt. Ergebnisse werden gecacht und nur bei Wechsel von
    // ExecutionTarget (Katalog) bzw. ActivityRef (Parameter) neu geladen.
    private IReadOnlyList<ActivityTypeInfo> activityTypes = new List<ActivityTypeInfo>();
    private IReadOnlyList<ActivityParameter> parameters = new List<ActivityParameter>();
    private ClaimsPrincipal? user;
    private string[] instanceNames = Array.Empty<string>();

    protected override async Task OnInitializedAsync()
    {
        // Node/Environment stehen hier bereits; der Benutzer wird fuer die Handler-Aufrufe geholt und die
        // Aktivitaetstypen/-parameter EINMAL initial geladen (spaetere Wechsel laufen ueber die Setter).
        AuthenticationState auth = await AuthState.GetAuthenticationStateAsync();
        user = auth.User;
        RefreshInstanceNames();
        await ReloadTypesAsync();
        await ReloadParametersAsync();
    }

    protected override void OnParametersSet()
    {
        // Umgebung koennte sich aendern -> Instanz-Vorschlaege auffrischen (Typen/Parameter haengen an den Settern).
        RefreshInstanceNames();
    }

    // Die Configuration-Einträge als stabile Liste je Render (MudTable braucht IEnumerable<T>).
    private List<KeyValuePair<string, object>> ConfigRows
        => Node?.Configuration?.ToList() ?? new List<KeyValuePair<string, object>>();

    // --- Katalog-Auflösung (per Instanz) --------------------------------------------------------

    private void RefreshInstanceNames()
    {
        instanceNames = WorkflowEnvironmentResolver.Resolve(Services, Environment)?.Instances?
            .Where(i => !string.IsNullOrWhiteSpace(i.Name)).Select(i => i.Name!).ToArray()
            ?? Array.Empty<string>();
    }

    private async Task ReloadTypesAsync()
    {
        if (user is null || Node is null)
        {
            return;
        }

        activityTypes = await Handler.GetActivityTypesAsync(user, Environment, Node.ExecutionTarget);
    }

    private async Task ReloadParametersAsync()
    {
        if (user is null || Node is null || string.IsNullOrWhiteSpace(Node.ActivityRef))
        {
            parameters = new List<ActivityParameter>();
            return;
        }

        parameters = await Handler.GetActivityParametersAsync(user, Environment, Node.ExecutionTarget, Node.ActivityRef);
    }

    private Task<IEnumerable<string>> SearchInstances(string value, CancellationToken ct)
    {
        IEnumerable<string> names = instanceNames;
        if (!string.IsNullOrWhiteSpace(value))
        {
            names = names.Where(n => n.Contains(value, StringComparison.OrdinalIgnoreCase));
        }

        return Task.FromResult(names);
    }

    private async Task OnActivitySelected(string activityRef)
    {
        if (Node is null)
        {
            return;
        }

        // Anderer Typ = anderer Parametersatz: alte Bindungen/Konfiguration würden verwaisen.
        if (!string.Equals(activityRef, Node.ActivityRef, StringComparison.Ordinal))
        {
            Node.Inputs.Clear();
            Node.Outputs.Clear();
            Node.Configuration.Clear();
        }

        Node.ActivityRef = activityRef;
        await ReloadParametersAsync();
    }

    private async Task SetExecutionTarget(string? value)
    {
        if (Node is null)
        {
            return;
        }

        Node.ExecutionTarget = string.IsNullOrWhiteSpace(value) ? null : value.Trim();
        // Der Katalog hängt am ExecutionTarget: Typen UND Parameter neu laden.
        await ReloadTypesAsync();
        await ReloadParametersAsync();
    }

    // --- Deklarierte Parameternamen aus dem (gecachten) Katalog (für die Auswahl in den Popups) --

    private IReadOnlyList<string>? InputParameterNames()
    {
        if (parameters.Count == 0)
        {
            return null;
        }

        return parameters.Where(p => p.Direction != ActivityParameterDirection.Output)
            .Select(p => p.Name).ToList();
    }

    private IReadOnlyList<string>? OutputParameterNames()
    {
        if (parameters.Count == 0)
        {
            return null;
        }

        return parameters.Where(p => p.Direction == ActivityParameterDirection.Output)
            .Select(p => p.Name).ToList();
    }

    // --- Iteration ----------------------------------------------------------------------------

    private bool IterationEnabled => Node?.Iteration is not null;

    /// <summary>
    /// Schaltet die Iteration ein oder aus. Ausschalten setzt sie auf null zurück statt nur die Felder
    /// zu leeren — ein leerer Block wäre ein stiller Nicht-Effekt (die Aktivität liefe einmal), und
    /// genau davor warnt auch der Validator.
    /// </summary>
    private void ToggleIteration(bool enabled)
    {
        if (Node is null)
        {
            return;
        }

        // Beim Einschalten gleich das naheliegende vorschlagen: gibt es genau eine Eingabe-Bindung, ist
        // sie mit hoher Wahrscheinlichkeit die Sammlung.
        Node.Iteration = enabled
            ? new ActivityIteration { ItemsInput = Node.Inputs?.Count == 1 ? Node.Inputs[0].Parameter : null }
            : null;
    }

    /// <summary>
    /// Vorschläge für die Sammlungs-Eingabe: die Parameter, die dieser Knoten tatsächlich bindet (nicht
    /// der ganze Katalog) — die Iteration kann nur lesen, was gebunden ist.
    /// </summary>
    private Task<IEnumerable<string>> SearchBoundInputs(string value, CancellationToken ct)
    {
        IEnumerable<string> names = Node?.Inputs?
            .Where(b => b is not null && !string.IsNullOrWhiteSpace(b.Parameter))
            .Select(b => b.Parameter!)
            .Distinct() ?? Enumerable.Empty<string>();
        return Filter(names, value);
    }

    /// <summary>
    /// Vorschläge für den Ergebnis-Parameter des Einzeldurchlaufs: die deklarierten Ausgaben aus dem
    /// Katalog. Freitext bleibt erlaubt — eine generische Aktivität hat keine Deklaration.
    /// </summary>
    private Task<IEnumerable<string>> SearchDeclaredOutputs(string value, CancellationToken ct)
        => Filter(OutputParameterNames() ?? Array.Empty<string>(), value);

    private static Task<IEnumerable<string>> Filter(IEnumerable<string> names, string value)
    {
        if (!string.IsNullOrWhiteSpace(value))
        {
            names = names.Where(n => n.Contains(value, StringComparison.OrdinalIgnoreCase));
        }

        return Task.FromResult(names);
    }

    // --- Configuration ------------------------------------------------------------------------

    private async Task AddConfig()
    {
        var parameters = new DialogParameters
        {
            { nameof(KeyValueEditDialog.IsNew), true }
        };
        var result = await ShowDialog<KeyValueEditDialog>(parameters);
        if (result?.Data is KeyValueEditDialog.Result r && !r.Delete && Node is not null)
        {
            Node.Configuration[r.Key] = r.Value;
        }
    }

    private async Task EditConfig(string key)
    {
        if (Node is null || !Node.Configuration.TryGetValue(key, out object? current))
        {
            return;
        }

        var parameters = new DialogParameters
        {
            { nameof(KeyValueEditDialog.Key), key },
            { nameof(KeyValueEditDialog.Value), ToStr(current) },
            { nameof(KeyValueEditDialog.IsNew), false }
        };
        var result = await ShowDialog<KeyValueEditDialog>(parameters);
        if (result?.Data is not KeyValueEditDialog.Result r)
        {
            return;
        }

        if (r.Delete)
        {
            Node.Configuration.Remove(r.OriginalKey ?? key);
            return;
        }

        // Umbenennung: den alten Eintrag entfernen, bevor der neue gesetzt wird.
        if (!string.IsNullOrEmpty(r.OriginalKey) && !string.Equals(r.OriginalKey, r.Key, StringComparison.Ordinal))
        {
            Node.Configuration.Remove(r.OriginalKey);
        }

        Node.Configuration[r.Key] = r.Value;
    }

    // --- Helpers ------------------------------------------------------------------------------

    private async Task<DialogResult?> ShowDialog<TDialog>(DialogParameters parameters)
        where TDialog : ComponentBase
    {
        var options = new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true, CloseOnEscapeKey = true };
        IDialogReference dialog = await DialogService.ShowAsync<TDialog>(string.Empty, parameters, options);
        return await dialog.Result;
    }

    private string ErrorTargetName(string flowId)
    {
        SequenceFlow? f = Def?.Flows.FirstOrDefault(x => x.Id == flowId);
        if (f is null)
        {
            return "(missing)";
        }

        WorkflowNode? n = Def?.GetNode(f.TargetId);
        return n is null ? (f.TargetId ?? "?") : (string.IsNullOrEmpty(n.Name) ? n.Id : n.Name);
    }

    private static string ToStr(object? value) => value switch
    {
        null => string.Empty,
        IFormattable f => f.ToString(null, CultureInfo.InvariantCulture),
        _ => value.ToString() ?? string.Empty
    };

    private static string Clip(string s) => s.Length <= 60 ? s : s.Substring(0, 58) + "…";
}
