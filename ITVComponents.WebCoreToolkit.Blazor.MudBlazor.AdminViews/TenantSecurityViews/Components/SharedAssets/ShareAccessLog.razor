@page "/Account/ShareLog"
@rendermode @(RenderMode.InteractiveServer)
@attribute [Microsoft.AspNetCore.Authorization.Authorize]

@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.Extensions.Localization

@inject IAssetAccessLogAdminHandler Handler
@inject AuthenticationStateProvider AuthState
@inject IStringLocalizer<ShareMessages> L

<PageTitle>@L["ShareLog_PageTitle"]</PageTitle>

<MudText Typo="Typo.h5" GutterBottom="true">@L["ShareLog_PageTitle"]</MudText>

@if (currentUser is null)
{
    <MudProgressCircular Indeterminate="true" />
}
else
{
    <MudDataGrid T="AssetAccessViewModel"
                 @ref="grid"
                 ServerData="LoadData"
                 SortMode="SortMode.None"
                 RowsPerPage="50"
                 Hover="true"
                 Dense="true">
        <ToolBarContent>
            <CrudGridToolbar OnRefresh="ReloadGrid" Title="@L["ShareLog_PageTitle"]" @bind-Search="search" OnSearch="ReloadGrid">
                @* Der Filter, den man in einem Zugriffsprotokoll fast immer zuerst will. *@
                <MudSwitch T="bool" Value="@deniedOnly" ValueChanged="ToggleDenied" Label="@L["ShareLog_DeniedOnly"]"
                           Color="Color.Error" Class="ml-4" />
            </CrudGridToolbar>
        </ToolBarContent>
        <Columns>
            <TemplateColumn T="AssetAccessViewModel" Title="@L["ShareLog_ColWhen"]" Sortable="false">
                <CellTemplate>@context.Item.Created.ToLocalTime().ToString("g")</CellTemplate>
            </TemplateColumn>
            <TemplateColumn T="AssetAccessViewModel" Title="@L["ShareLog_ColResult"]" Sortable="false">
                <CellTemplate>
                    @if (context.Item.Granted)
                    {
                        <MudIcon Icon="@Icons.Material.Filled.Check" Size="Size.Small" Color="Color.Success" />
                    }
                    else
                    {
                        @* NotConfirmed heisst "niemand hat bestaetigt", Denied heisst "jemand hat auf
                           etwas Fremdes gezeigt" - nur das zweite ist ein Alarmzeichen. *@
                        <MudChip T="string" Size="Size.Small"
                                 Color="@(context.Item.DenyReason == "Denied" ? Color.Error : Color.Warning)">
                            @DenyLabel(context.Item.DenyReason)
                        </MudChip>
                    }
                </CellTemplate>
            </TemplateColumn>
            <PropertyColumn Property="x => x.AccessedBy" Title="@L["ShareLog_ColBy"]" />
            <PropertyColumn Property="x => x.RequestPath" Title="@L["ShareLog_ColPath"]" />
            <PropertyColumn Property="x => x.ArgumentSummary" Title="@L["Shares_ColPointsAt"]" />
            <TemplateColumn T="AssetAccessViewModel" Title="@L["ShareLog_ColShare"]" Sortable="false">
                <CellTemplate>
                    @if (!string.IsNullOrEmpty(context.Item.TicketNonce))
                    {
                        <MudTooltip Text="@L["ShareLog_TicketTooltip"]">
                            <MudChip T="string" Size="Size.Small" Color="Color.Warning">@L["ShareLog_Ticket"]</MudChip>
                        </MudTooltip>
                    }
                    else
                    {
                        <MudText Typo="Typo.body2">@context.Item.TemplateSystemKey</MudText>
                    }
                </CellTemplate>
            </TemplateColumn>
            <PropertyColumn Property="x => x.RecipientLabel" Title="@L["ShareLog_ColRecipient"]" />
        </Columns>
        <PagerContent>
            <MudDataGridPager T="AssetAccessViewModel" />
        </PagerContent>
    </MudDataGrid>
}

@code {
    /// <summary>Auf eine Freigabe einschraenken - leer zeigt alle des Mandanten.</summary>
    [Parameter, SupplyParameterFromQuery(Name = "asset")] public string? AssetKey { get; set; }

    private MudDataGrid<AssetAccessViewModel>? grid;
    private System.Security.Claims.ClaimsPrincipal? currentUser;
    private string? search;
    private bool deniedOnly;

    protected override async Task OnInitializedAsync()
    {
        var auth = await AuthState.GetAuthenticationStateAsync();
        currentUser = auth.User;
    }

    private async Task<GridData<AssetAccessViewModel>> LoadData(GridState<AssetAccessViewModel> state, CancellationToken ct)
    {
        if (currentUser is null) return new GridData<AssetAccessViewModel> { Items = Array.Empty<AssetAccessViewModel>(), TotalItems = 0 };
        var result = await Handler.ListAsync(currentUser, AssetKey, deniedOnly, state.ToListQuery(search));
        return new GridData<AssetAccessViewModel> { Items = result.Items, TotalItems = result.TotalCount };
    }

    private async Task ReloadGrid()
    {
        if (grid is not null) await grid.ReloadServerData();
    }

    /// <summary>
    /// Der Ablehnungsgrund, so wie ihn der Benutzer lesen kann. Die Spalte haelt den rohen Wert - ein Grund,
    /// den spaeter jemand hinzufuegt und hier noch nicht uebersetzt ist, erscheint roh statt als Schluessel.
    /// </summary>
    private string? DenyLabel(string? reason)
    {
        if (string.IsNullOrEmpty(reason))
        {
            return reason;
        }

        var text = L[$"ShareLog_Deny_{reason}"];
        return text.ResourceNotFound ? reason : text.Value;
    }

    private async Task ToggleDenied(bool value)
    {
        deniedOnly = value;
        await ReloadGrid();
    }
}
