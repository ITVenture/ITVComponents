@* Der gemeinsame Teil beider Diagramm-Renderer: aus den Deklarationen werden MudCharts.

   Er kennt weder Scriban noch CScript - die beiden unterscheiden sich nur darin, wie aus dem
   Konfigurationstext Eintraege werden. Alles danach passiert hier.

   Eine Konfiguration darf ein Diagramm beschreiben oder mehrere. Mehrere ordnen sich nach dem Platz:
   nebeneinander, solange jedes noch seine Mindestbreite bekommt, sonst untereinander. Bewusst ueber
   Flex und nicht ueber Breakpoints - wie breit die Kachel wirklich ist, haengt an ihrem ColSpan UND am
   Fenster, und das weiss nur der Browser.

   Wer dem Diagramm eine eigene Groesse gibt (width/height), bekommt einen Platz, der sich DANACH richtet
   und nicht nach Mindestbreite und Restplatz - siehe SizeStyle. Sonst waere der Platz breiter als das
   Diagramm darin, und alles, was darin ausgerichtet wird (die Ueberschrift), saesse daneben. *@

@namespace ITVComponents.WebCoreToolkit.Blazor.SharedComponents.Widgets.Charts
@using System.Globalization
@using Microsoft.AspNetCore.Components
@using ITVComponents.WebCoreToolkit.Blazor.SharedComponents.Widgets
@inject NavigationManager Navigation

@if (Errors.Count != 0)
{
    @* Was die ganze Kachel betrifft: unlesbares JSON, ein Skript das wirft. Dann gibt es nichts zu
       zeichnen - im Unterschied zum Fehler eines einzelnen Diagramms weiter unten. *@
    <MudAlert Severity="Severity.Error" Dense="true">
        @ErrorTitle
        <ul class="mt-1">
            @foreach (string error in Errors)
            {
                <li><MudText Typo="Typo.caption">@error</MudText></li>
            }
        </ul>
    </MudAlert>
}
else if (Panels.Count == 1 && Panels[0].DeclaredWidth == null)
{
    @* Der Regelfall - ein Diagramm, dessen Breite sich nach der Kachel richtet. Ohne Mantel, damit eine
       bestehende Kachel exakt so aussieht wie vorher. *@
    @Panel(Panels[0])
}
else if (Panels.Count == 1)
{
    @* Ein Diagramm mit EIGENER Breite bekommt auch als einziges einen Mantel: sonst nimmt der Block die
       ganze Kachelbreite ein, und die mittig gesetzte Ueberschrift stuende ueber der Kachel statt ueber
       dem Diagramm. *@
    <div style="@SizeStyle(Panels[0], flexChild: false)">
        @Panel(Panels[0])
    </div>
}
else
{
    @* Ein Raster und kein Flex-Streifen: nur so lassen sich Ueberschrift und Diagramm ZEILENWEISE
       ausrichten (siehe RowStyle). Es bricht genauso um wie vorher, nur eben in Rasterzeilen - und
       innerhalb einer solchen Zeile teilen sich alle Diagramme dieselben zwei Baender. *@
    <div style="@RowStyle">
        @foreach (ChartWidgetPanel panel in Panels)
        {
            <div class="pa-1" style="@SizeStyle(panel, flexChild: true)">
                @Panel(panel)
            </div>
        }
    </div>
}

@code {
    /// <summary>What to draw - one entry per chart.</summary>
    [Parameter] public IReadOnlyList<ChartWidgetPanel> Panels { get; set; } = Array.Empty<ChartWidgetPanel>();

    /// <summary>
    /// What was wrong with the configuration AS A WHOLE. Empty = nothing; the individual charts carry
    /// their own complaints.
    /// </summary>
    [Parameter] public IReadOnlyList<string> Errors { get; set; } = Array.Empty<string>();

    /// <summary>Raised when a category was clicked and it carries no navigation target.</summary>
    [Parameter] public EventCallback<WidgetAction> OnAction { get; set; }

    [Parameter] public string ErrorTitle { get; set; } = "This chart cannot be drawn:";

    /// <summary>
    /// Wie viel Platz ein Diagramm beansprucht.
    /// </summary>
    /// <param name="panel">das Diagramm</param>
    /// <param name="flexChild">true, wenn der Platz ein Flex-Kind ist (mehrere Diagramme in einer Kachel)</param>
    /// <remarks>
    /// <para>
    /// Hat das Diagramm eine EIGENE, absolute Groesse (<c>width: "150px"</c>), richtet sich der Platz nach
    /// ihm statt nach Mindestbreite und Restplatz. Vorher zog das Flex-Kind allen freien Platz an sich - der
    /// Platz war dann viel breiter als das Diagramm darin, und die mittig gesetzte Ueberschrift stand
    /// irgendwo, nur nicht darueber.
    /// </para>
    /// <para>
    /// <c>min-content</c> und nicht <c>fit-content</c>: eine Ueberschrift darf die Breite NICHT bestimmen.
    /// Mit <c>fit-content</c> haette ein laengerer Titel den Platz wieder aufgezogen, ungebrochen bis zur
    /// Kachelbreite - genau derselbe schiefe Sitz, nur mit anderer Ursache. Mit <c>min-content</c> traegt er
    /// nur sein laengstes Wort bei und bricht um. Das Diagramm bleibt trotzdem vollstaendig: sein eigenes
    /// Wurzelelement traegt <c>min-width: fit-content</c>, eine Legende daneben gehoert also dazu. Die
    /// Untergrenze ist die gewuenschte Breite selbst - eine feste Breite waere hier falsch, sie wuerde die
    /// Legende abschneiden. Die Reserve ist der Innenabstand des Mantels.
    /// </para>
    /// <para>
    /// Ohne eigene Groesse bleibt es beim bisherigen Verhalten: Mindestbreite, darueber hinaus zu gleichen
    /// Teilen. <c>min(100%, …)</c> ist die Sicherung fuer den schmalen Fall - ohne sie wuerde eine Kachel,
    /// die selbst schmaler ist als die Mindestbreite, seitlich ueberlaufen. <c>minWidth</c> hat neben einer
    /// absoluten Breite keine Wirkung mehr: was die Breite ist, steht dann schon fest.
    /// </para>
    /// </remarks>
    private static string SizeStyle(ChartWidgetPanel panel, bool flexChild)
    {
        string? width = panel.DeclaredWidth;
        var style = new System.Text.StringBuilder();
        if (width != null)
        {
            style.Append(FormattableString.Invariant(
                $"width: min-content; min-width: min(100%, {width}); max-width: 100%;"));
            if (flexChild)
            {
                // In der Rasterzeile ist die Spalte breiter als das Diagramm mit eigener Breite - also
                // mittig hinein, statt es an den linken Rand zu haengen. Eine Flex-Angabe stuende hier
                // wirkungslos: wie breit die Spalte ist, entscheidet das Raster (siehe RowStyle).
                style.Append(" justify-self: center;");
            }
        }
        else if (!flexChild)
        {
            int min = panel.Declaration?.MinWidth ?? ChartWidgetDeclaration.DefaultMinWidth;
            style.Append(min <= 0
                ? "flex: 1 1 0; min-width: 0;"
                : FormattableString.Invariant($"flex: 1 1 {min}px; min-width: min(100%, {min}px);"));
        }
        else
        {
            // Die Mindestbreite steht im Raster (RowStyle) und gilt dort fuer die ganze Zeile. Hier NUR
            // die Freigabe zum Schrumpfen: ein Rasterplatz ist von sich aus mindestens so breit wie sein
            // Inhalt, und ein Diagramm, das nicht schrumpfen darf, sprengte die schmale Kachel seitlich.
            style.Append("min-width: 0;");
        }

        if (flexChild)
        {
            // Der Platz uebernimmt die beiden Baender seiner Rasterzeile (Ueberschrift, Diagramm) als
            // eigenes Raster. Dadurch ist das Ueberschriften-Band bei ALLEN Diagrammen einer Zeile gleich
            // hoch - und damit beginnen die Diagramme darunter auf einer Linie, ohne dass irgendwo eine
            // Hoehe steht. Siehe RowStyle.
            style.Append(" display: grid; grid-template-rows: subgrid; grid-row: span 2;");
        }

        return style.ToString();
    }

    /// <summary>
    /// Die Rasterzeile, in der mehrere Diagramme einer Kachel nebeneinander stehen.
    /// </summary>
    /// <remarks>
    /// <para>
    /// Zwei Baender je Diagramm - Ueberschrift und Diagramm -, und weil jeder Platz sie per
    /// <c>subgrid</c> uebernimmt, gelten sie fuer alle Diagramme einer Zeile GEMEINSAM. Das ist der
    /// Unterschied zur vorherigen Flex-Fassung: die konnte nur die Gesamthoehe angleichen und musste den
    /// Ueberschuss irgendwo hinlegen - sie legte ihn in die Ueberschrift. Sobald aber die LEGENDEN
    /// unterschiedlich hoch waren (eine Kategorie mehr als beim Nachbarn), stammte der Ueberschuss aus
    /// der Legende und schob Ueberschrift und Ring des Nachbarn nach unten. Ausgerichtet waren dann die
    /// untersten Legendenzeilen, waehrend Titel und Ringe sichtbar gegeneinander verrutschten.
    /// </para>
    /// <para>
    /// Mit den zwei Baendern kommt der Ausgleich nur noch von den Ueberschriften (mehrzeilige heben das
    /// Band, siehe <see cref="CaptionStyle"/>), und alles darunter - Ring wie Legende - beginnt bei jedem
    /// Diagramm an derselben Stelle. Eine laengere Legende reicht dann weiter nach unten als die des
    /// Nachbarn; das faellt neben buendigen Ringen kaum auf, waehrend die vorherige Loesung genau
    /// umgekehrt das Auffaellige ausrichtete und das Ruhige verschob.
    /// </para>
    /// <para>
    /// <c>auto-fit</c> mit <c>minmax</c> haelt das bisherige Umbruchverhalten: nebeneinander, solange
    /// jedes noch seinen Platz bekommt, sonst in die naechste Rasterzeile - und die richtet sich dann
    /// eigenstaendig aus. <c>min(100%, …)</c> ist wie bisher die Sicherung fuer die Kachel, die selbst
    /// schmaler ist als diese Breite.
    /// </para>
    /// <para>
    /// <b>Was eine Spalte breit sein muss, entscheidet je Diagramm dasselbe wie vorher in
    /// <see cref="SizeStyle"/>:</b> hat es eine EIGENE Breite, dann diese - eine Mindestbreite hat daneben
    /// keine Wirkung mehr, weil die Breite schon feststeht. Sonst seine Mindestbreite. Ueber die Kachel
    /// hinweg gilt das groesste dieser Masse, damit keines unter das seine gedrueckt wird; gerechnet wird
    /// per <c>max()</c> im Stylesheet und nicht hier, denn eine deklarierte Breite ist Text (<c>150px</c>)
    /// und soll dafuer nicht zerlegt werden.
    /// </para>
    /// <para>
    /// Das war der Fehler der ersten Fassung: sie nahm ausschliesslich die Mindestbreiten und begann
    /// obendrein beim Vorgabewert. Diagramme mit eigener, kleinerer Breite bekamen dadurch Spalten von
    /// mindestens <see cref="ChartWidgetDeclaration.DefaultMinWidth"/> Pixeln - in einer Kachel, in der
    /// vorher drei nebeneinander standen, passte danach nur noch eines.
    /// </para>
    /// <para>
    /// Verlangt kein Diagramm eine Breite (<c>minWidth: 0</c> ueberall), gibt es nichts zu unterschreiten
    /// und damit auch keinen Grund umzubrechen: dann bekommt jedes seine gleich breite Spalte in EINER
    /// Zeile. Das entspricht dem frueheren <c>flex: 1 1 0</c>. Ohne diesen Zweig stuende in der
    /// <c>minmax</c>-Untergrenze eine Null, aus der <c>auto-fit</c> beliebig viele Spalten ableitet.
    /// </para>
    /// <para>
    /// Faellt <c>subgrid</c> aus (sehr alter Browser), wird die Regel verworfen und jeder Platz ist ein
    /// gewoehnliches Raster: die Ueberschriften sind dann nicht mehr untereinander abgestimmt, alles
    /// andere bleibt. Das ist genau der Zustand, den es vor dieser Ausrichtung ohnehin gab.
    /// </para>
    /// </remarks>
    private string RowStyle
    {
        get
        {
            var tracks = new List<string>();
            foreach (ChartWidgetPanel panel in Panels)
            {
                // Dieselbe Rangfolge wie in SizeStyle: eigene Breite schlaegt Mindestbreite.
                string? width = panel.DeclaredWidth;
                if (width != null)
                {
                    tracks.Add(width);
                    continue;
                }

                int min = panel.Declaration?.MinWidth ?? ChartWidgetDeclaration.DefaultMinWidth;
                if (min > 0)
                {
                    tracks.Add(FormattableString.Invariant($"{min}px"));
                }
            }

            if (tracks.Count == 0)
            {
                return FormattableString.Invariant(
                    $"display: grid; grid-template-columns: repeat({Panels.Count}, 1fr); grid-auto-rows: auto; align-items: start;");
            }

            string track = tracks.Count == 1 ? tracks[0] : $"max({string.Join(", ", tracks)})";
            return FormattableString.Invariant(
                $"display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, {track}), 1fr)); grid-auto-rows: auto; align-items: start;");
        }
    }

    /// <summary>
    /// Ein einzelnes Diagramm - oder, wenn an ihm etwas nicht stimmt, dessen Meldung an seinem Platz. Die
    /// uebrigen Diagramme der Kachel bleiben davon unberuehrt.
    /// </summary>
    private RenderFragment<ChartWidgetPanel> Panel => panel =>
        @<text>
            @* Die Ueberschrift steht IMMER in einem eigenen Block - auch wenn es keine gibt. Er ist der
               Ausgleich, mit dem die Diagramme einer Zeile buendig werden (siehe CaptionStyle). *@
            <div style="@CaptionStyle">
                @if (!string.IsNullOrEmpty(panel.Declaration?.Title))
                {
                    @* Uebersetzt wird HIER und nicht beim Lesen der Deklaration: der Titel darf ein
                       Kultur-Datensatz sein, und die Aufloesung gehoert zur Anzeige. *@
                    <MudText Typo="Typo.subtitle2" Align="Align.Center">
                        @WidgetTemplateFunctions.Translate(panel.Declaration!.Title!)
                    </MudText>
                }
            </div>
            <div style="@ChartBlockStyle">
                @if (panel.Errors.Count != 0)
                {
                    <MudAlert Severity="Severity.Error" Dense="true">
                        @ErrorTitle
                        <ul class="mt-1">
                            @foreach (string error in panel.Errors)
                            {
                                <li><MudText Typo="Typo.caption">@error</MudText></li>
                            }
                        </ul>
                    </MudAlert>
                }
                else if (panel.Declaration is not null)
                {
                    @* Die drei aufbereiteten Felder ausdruecklich - so prueft der Uebersetzer ihre Namen.
                       Der Rest kommt als geprueftes Woerterbuch dazu; T bleibt double, damit es ohne
                       Typinferenz auskommt. *@
                    <MudChart T="double"
                              ChartType="@panel.Declaration.Type"
                              ChartLabels="@panel.LabelTexts"
                              ChartSeries="@panel.Declaration.Series"
                              SelectedIndexChanged="@(index => OnSelected(panel, index))"
                              @attributes="@panel.Parameters">
                        @* Immer gesetzt, auch wenn die Liste leer ist: eine zweite Markup-Fassung "mit"
                           und "ohne" waere derselbe Aufruf zweimal - und beim naechsten Parameter waere
                           eine davon vergessen. Leer rendert nichts. *@
                        @* Fertiges Markup und keine <text>-Elemente hier: Razor deutet <text> als
                           eigenes Steuer-Tag und lehnt Attribute daran ab (RZ1023) - dieselbe Stelle
                           steht aus demselben Grund schon in WorkflowGraph.razor. Kodiert wird beim
                           Erzeugen, siehe ChartWidgetPanel.OverlayMarkup. *@
                        <CustomGraphics>@((MarkupString)panel.OverlayMarkup)</CustomGraphics>
                    </MudChart>
                }
            </div>
        </text>;

    /// <summary>
    /// Der Block, in dem die Ueberschrift sitzt - und der Ausgleich, mit dem die Diagramme einer Zeile
    /// buendig werden.
    /// </summary>
    /// <remarks>
    /// <para>
    /// Das Problem: eine Ueberschrift, die umbricht, ist eine Zeile hoeher als eine einzeilige - das
    /// Diagramm darunter beginnt dann tiefer als das daneben. Eine feste Hoehe fuer die Ueberschrift waere
    /// die naheliegende, aber falsche Antwort: bei einzeiligen Titeln verschenkt sie Platz und bei einem
    /// dreizeiligen sitzt wieder alles schief.
    /// </para>
    /// <para>
    /// Stattdessen ist die Ueberschrift ein eigenes BAND der Rasterzeile (siehe <see cref="RowStyle"/>):
    /// es ist so hoch wie die hoechste Ueberschrift der Zeile, und der Text sitzt darin unten
    /// (<c>align-self: end</c>). Damit beginnen die Diagramme auf einer Linie, ohne dass irgendwo eine
    /// Hoehe steht - und zwar an der OBERkante, nicht ueber eine gemeinsame Standlinie.
    /// </para>
    /// <para>
    /// Der Unterschied zur frueheren Flex-Fassung ist genau der: die konnte nur die Gesamthoehe
    /// angleichen und musste den Ueberschuss irgendwohin legen. Sie legte ihn in die Ueberschrift - was
    /// stimmt, solange er von den Ueberschriften stammt. Sobald aber die LEGENDEN unterschiedlich hoch
    /// waren, kam er von unten und schob Titel und Ring des Nachbarn nach unten: ausgerichtet war dann
    /// die unterste Legendenzeile, waehrend das Auffaellige - Ueberschrift und Ring - verrutschte.
    /// </para>
    /// </remarks>
    private const string CaptionStyle
        = "align-self: end; display: flex; align-items: flex-end; justify-content: center;";

    /// <summary>
    /// Das Diagramm selbst - im zweiten Band, an dessen OBERkante. Es wird nicht auf die Bandhoehe
    /// gestreckt: waere es das, sitzt der Ring bei jedem Diagramm anderswo in seinem Band, je nachdem wie
    /// hoch dessen Legende ist. So beginnen Ring und Legende bei allen an derselben Stelle, und nur das
    /// Ende einer laengeren Legende reicht weiter nach unten.
    /// </summary>
    private const string ChartBlockStyle = "align-self: start;";

    /// <summary>
    /// Klick auf ein Segment oder einen Legendeneintrag. Der Regelfall ist der Sprung auf eine Seite;
    /// ohne Ziel bleibt es bei der Aktion, die eine Anwendung ueber OnWidgetAction bekommt - dasselbe,
    /// was ein HTML-Template ueber data-widget-action ausloest.
    /// </summary>
    private void OnSelected(ChartWidgetPanel panel, int index)
    {
        ChartWidgetDeclaration? declaration = panel.Declaration;
        if (declaration is null || index < 0 || index >= declaration.Labels.Count)
        {
            return;
        }

        ChartWidgetLabel label = declaration.Labels[index];
        if (!string.IsNullOrWhiteSpace(label.NavigateTo))
        {
            // Relative Ziele loest NavigateTo gegen die Basis der Anwendung auf - und genau die traegt in
            // einer mandanten-praefixierten Anwendung den Praefix. Ein root-absolutes Ziel ginge daran
            // vorbei (BUG-PRE141); das bleibt Sache dessen, der es so schreibt.
            Navigation.NavigateTo(label.NavigateTo!);
            return;
        }

        if (OnAction.HasDelegate)
        {
            // Der Aktionsname kommt aus der Deklaration: bei mehreren Diagrammen in einer Kachel koennte
            // die Anwendung sonst nicht unterscheiden, welches geklickt wurde.
            _ = OnAction.InvokeAsync(new WidgetAction(declaration.Action, label.Text));
        }
    }
}
