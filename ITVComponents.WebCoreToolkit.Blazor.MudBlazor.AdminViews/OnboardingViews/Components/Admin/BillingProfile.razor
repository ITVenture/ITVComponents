@page "/Onboarding/BillingProfile"
@rendermode @(RenderMode.InteractiveServer)
@attribute [Microsoft.AspNetCore.Authorization.Authorize]

@using Microsoft.AspNetCore.Components.Authorization
@using ITVComponents.WebCoreToolkit.Blazor.MudBlazor.AdminViews.OnboardingViews.Components.Shared

@using ITVComponents.WebCoreToolkit.EntityFramework.Onboarding.Shared.Extensibility

@inject IOnboardingAdminHandler Handler
@inject ICustomCompanyInfoProvider CustomInfo
@inject ITenantInvitationHandler InvitationHandler
@inject AuthenticationStateProvider AuthState
@inject ISnackbar Snackbar
@inject IStringLocalizer<OnboardingMessages> L

@* Single tenant-administration surface for the tenant the signed-in user administers (their own tenant).
   Replaces the former BillingProfiles list, EmployeeRoleMappings and Invitations pages with one tabbed
   detail view. Each tab is permission-gated (View/Write) under the Onboarding.Admin.* prefix; Write implies
   View. A tenant has at most one billing profile, so tab 1 IS the profile (no listing) — an empty form
   implicitly creates it. (Tabs 2-4 are filled in the following commits.) *@

<PageTitle>@L["OnbAdm_PageTitle"]</PageTitle>

<MudText Typo="Typo.h5" GutterBottom="true">@L["OnbAdm_PageTitle"]</MudText>

@if (loading)
{
    <MudProgressCircular Indeterminate="true" />
}
else if (currentTenant is null)
{
    <MudAlert Severity="Severity.Warning">@L["OnbAdm_NoTenant"]</MudAlert>
}
else
{
    <MudText Typo="Typo.body2" Class="mb-2">@L["OnbAdm_TenantLabel"]: <b>@currentTenant.DisplayName</b></MudText>

    @* Reiner Messpunkt: MudHidden meldet ueber Hidden, ob wir auf einem schmalen Geraet sind. Die vier
       Reiter-Titel brauchen zusammen 845px; bei 272px verfuegbarer Breite sind knapp anderthalb sichtbar,
       den Rest erreicht man nur ueber die Scrollpfeile - ohne je zu sehen, welche Bereiche es gibt. Auf xs
       tragen die Reiter deshalb nur ihr Icon (4 x ~48px passen nebeneinander); der Titel bleibt als Tooltip
       und als aria-label erhalten. Das geht hier, weil die Seite interaktiv rendert - auf den static-SSR
       Identity-Seiten waere MudHidden wirkungslos. *@
    <MudHidden Breakpoint="Breakpoint.Xs" @bind-Hidden="narrow" />

    @* mb-6: sonst endet die Reiter-Flaeche buendig am Seitenende und der Speichern-Knopf sitzt auf dem
       unteren Displayrand - dort, wo bei vielen Geraeten die Systemgeste liegt. *@
    <MudTabs Elevation="1" Rounded="true" ApplyEffectsToContainer="true" PanelClass="pa-4" Class="mb-6">

        @* ---- Tab 1: billing profile / address -------------------------------------------------- *@
        <MudTabPanel Text="@TabText("OnbAdm_Tab_Address")" ToolTip="@L["OnbAdm_Tab_Address"]" Icon="@Icons.Material.Filled.ReceiptLong">
            <SecureView RequiredPermissions="Onboarding.Admin.BillingProfile.View,Onboarding.Admin.BillingProfile.Write">
                <Permitted>
                    @if (model is null)
                    {
                        <MudProgressCircular Indeterminate="true" />
                    }
                    else
                    {
                        <MudForm @ref="form" Model="model">
                            <MudGrid Spacing="2">
                                <MudItem xs="12" sm="6">
                                    <MudSelect T="ProfileType" @bind-Value="model.ProfileType" Label="@L["OnbAdm_ProfileType"]">
                                        @foreach (var pt in System.Enum.GetValues<ProfileType>())
                                        {
                                            <MudSelectItem T="ProfileType" Value="@pt">@(pt == ProfileType.Company ? L["Onb_Company"] : L["Onb_Personal"])</MudSelectItem>
                                        }
                                    </MudSelect>
                                </MudItem>
                                <MudItem xs="12" sm="6">
                                    <MudTextField @bind-Value="model.Email" Label="@L["Onb_ContactEmail"]" Required="true" For="@(() => model.Email)" />
                                </MudItem>

                                @if (model.ProfileType == ProfileType.Company)
                                {
                                    <MudItem xs="12" sm="8">
                                        <MudTextField @bind-Value="model.CompanyName" Label="@L["Onb_CompanyName"]" For="@(() => model.CompanyName)" />
                                    </MudItem>
                                    <MudItem xs="12" sm="4">
                                        <MudTextField @bind-Value="model.VatNumber" Label="@L["Onb_VatNumber"]" For="@(() => model.VatNumber)" />
                                    </MudItem>
                                }
                                else
                                {
                                    <MudItem xs="12" sm="6">
                                        <MudTextField @bind-Value="model.FirstName" Label="@L["Onb_FirstName"]" For="@(() => model.FirstName)" />
                                    </MudItem>
                                    <MudItem xs="12" sm="6">
                                        <MudTextField @bind-Value="model.LastName" Label="@L["Onb_LastName"]" For="@(() => model.LastName)" />
                                    </MudItem>
                                }

                                <MudItem xs="12" sm="6">
                                    <MudTextField @bind-Value="model.PhoneNumber" Label="@L["Onb_Phone"]" For="@(() => model.PhoneNumber)" />
                                </MudItem>
                            </MudGrid>

                            <MudText Typo="Typo.subtitle1" Class="mt-3 mb-1">@L["Onb_DefaultAddress"]</MudText>
                            <AddressEditor Title="@L["Onb_DefaultAddress"]" Address="model.DefaultAddress" />

                            <MudCheckBox T="bool" @bind-Value="model.UseInvoiceAddr" Label="@L["Onb_UseInvoiceAddr"]" />
                            @if (model.UseInvoiceAddr)
                            {
                                <AddressEditor Title="@L["Onb_InvoiceAddress"]" Address="model.InvoiceAddress" />
                            }

                            @* Die Zusatzangaben zum Nachtragen. Der Provider hat die Reiter bereits um die
                               Module gekuerzt, deren eigene Berechtigung dem Benutzer fehlt - was hier steht,
                               darf er auch bearbeiten. *@
                            @if (customTabs is { Count: > 0 } && customCtx is not null)
                            {
                                <CustomCompanyInfoTabs @ref="customInfoTabs" Tabs="customTabs" Info="customCtx"
                                                       Values="model.CustomInfo" Narrow="narrow" />
                            }

                            <SecureView RequiredPermissions="Onboarding.Admin.BillingProfile.Write">
                                <Permitted>
                                    <MudButton Variant="Variant.Filled" Color="Color.Primary" Class="mt-2" Disabled="@busy" OnClick="Save">@L["OnbAdm_Save"]</MudButton>
                                </Permitted>
                            </SecureView>
                        </MudForm>
                    }
                </Permitted>
                <NotPermitted>
                    <MudAlert Severity="Severity.Warning">@L["OnbAdm_NoPermission"]</MudAlert>
                </NotPermitted>
            </SecureView>
        </MudTabPanel>

        @* ---- Tab 2: users & invitations (filled in commit 2) ----------------------------------- *@
        <MudTabPanel Text="@TabText("OnbAdm_Tab_Users")" ToolTip="@L["OnbAdm_Tab_Users"]" Icon="@Icons.Material.Filled.People">
            <SecureView RequiredPermissions="Onboarding.Admin.Employees.View,Onboarding.Admin.Employees.Write">
                <Permitted>
                    <EmployeesTab BillingProfileId="@(model?.BillingProfileId ?? 0)" TenantId="@currentTenant.TenantId" />
                </Permitted>
                <NotPermitted>
                    <MudAlert Severity="Severity.Warning">@L["OnbAdm_NoPermission"]</MudAlert>
                </NotPermitted>
            </SecureView>
        </MudTabPanel>

        @* ---- Tab 3: role-mapping definitions (filled in commit 3) ------------------------------ *@
        <MudTabPanel Text="@TabText("OnbAdm_Tab_RoleMappings")" ToolTip="@L["OnbAdm_Tab_RoleMappings"]" Icon="@Icons.Material.Filled.AdminPanelSettings">
            <SecureView RequiredPermissions="Onboarding.Admin.RoleMappings.View,Onboarding.Admin.RoleMappings.Write,Onboarding.Admin.RoleMappings.DirectRole,Onboarding.Admin.RoleMappings.PermissionSet">
                <Permitted>
                    <RoleMappingsTab />
                </Permitted>
                <NotPermitted>
                    <MudAlert Severity="Severity.Warning">@L["OnbAdm_NoPermission"]</MudAlert>
                </NotPermitted>
            </SecureView>
        </MudTabPanel>

        @* ---- Tab 4: erteilte Zustimmungen (nur Einsicht) --------------------------------------- *@
        <MudTabPanel Text="@TabText("OnbAdm_Tab_Consents")" ToolTip="@L["OnbAdm_Tab_Consents"]" Icon="@Icons.Material.Filled.FactCheck">
            <SecureView RequiredPermissions="Onboarding.Admin.Consents.View">
                <Permitted>
                    <ConsentsTab />
                </Permitted>
                <NotPermitted>
                    <MudAlert Severity="Severity.Warning">@L["OnbAdm_NoPermission"]</MudAlert>
                </NotPermitted>
            </SecureView>
        </MudTabPanel>

        @* ---- Tab 5: sub-tenant invitations (hierarchy only) ------------------------------------ *@
        @if (subTenantSupported)
        {
            <MudTabPanel Text="@TabText("OnbAdm_Tab_SubTenants")" ToolTip="@L["OnbAdm_Tab_SubTenants"]" Icon="@Icons.Material.Filled.AccountTree">
                <SecureView RequiredPermissions="Onboarding.Admin.SubTenants.View,Onboarding.Admin.SubTenants.Write">
                    <Permitted>
                        <SubTenantInvitationsTab TenantId="@currentTenant.TenantId" />
                    </Permitted>
                    <NotPermitted>
                        <MudAlert Severity="Severity.Warning">@L["OnbAdm_NoPermission"]</MudAlert>
                    </NotPermitted>
                </SecureView>
            </MudTabPanel>
        }

    </MudTabs>
}

@code {
    private System.Security.Claims.ClaimsPrincipal? currentUser;
    private TenantPickerItem? currentTenant;
    private BillingProfileAdminViewModel? model;
    private MudForm? form;
    private bool loading = true;
    private bool busy;
    private bool subTenantSupported;

    private CustomCompanyInfoTabs? customInfoTabs;
    private IReadOnlyList<CustomInfoTab>? customTabs;
    private CustomInfoContext? customCtx;

    /// <summary>Schmales Geraet (xs) - gesetzt vom MudHidden-Messpunkt oben.</summary>
    private bool narrow;

    /// <summary>Reiter-Beschriftung: auf xs entfaellt sie, dort traegt das Icon den Reiter.</summary>
    private string? TabText(string key) => narrow ? null : L[key].Value;

    protected override async Task OnInitializedAsync()
    {
        var auth = await AuthState.GetAuthenticationStateAsync();
        currentUser = auth.User;
        subTenantSupported = InvitationHandler.SupportsTenantInvitations;
        currentTenant = await Handler.GetCurrentTenantAsync(currentUser);
        if (currentTenant is not null && currentUser is not null)
        {
            await LoadProfile();
        }

        loading = false;
    }

    // A tenant has at most one billing profile: take the first if present, otherwise start an empty model
    // (an implicit create on first save). The list projection has no addresses, so re-load the full profile.
    private async Task LoadProfile()
    {
        var profiles = await Handler.ListBillingProfilesAsync(currentUser!);
        var first = profiles.FirstOrDefault();
        model = first is not null
            ? await Handler.GetBillingProfileAsync(currentUser!, first.BillingProfileId) ?? new BillingProfileAdminViewModel()
            : new BillingProfileAdminViewModel();

        await DescribeCustomAsync();
    }

    /// <summary>
    /// Fragt die Zusatzangaben-Module, was hier nachzutragen ist - mit <c>loadExisting</c>, damit die Masken
    /// den abgelegten Stand zeigen und nicht leer beginnen.
    /// </summary>
    /// <remarks>
    /// Der Erfassungsfall ist hier <see cref="CustomInfoMode.Edit"/>: erst dadurch greift die eigene
    /// Berechtigung eines Moduls, und erst dadurch darf es entscheiden, dass es sich nachtraeglich gar
    /// nicht mehr aendern laesst.
    /// </remarks>
    private async Task DescribeCustomAsync()
    {
        if (currentTenant is null || model is null)
        {
            return;
        }

        customCtx = new CustomInfoContext
        {
            Mode = CustomInfoMode.Edit,
            Origin = CustomInfoOrigin.SelfService,
            ProfileType = model.ProfileType,
            TenantId = currentTenant.TenantId,
            User = currentUser
        };
        customTabs = await CustomInfo.DescribeAsync(customCtx, loadExisting: true);
    }

    /// <summary>Die erfassten Datensaetze ohne die leeren Eintraege.</summary>
    private IReadOnlyDictionary<string, System.Text.Json.Nodes.JsonNode> Buckets()
        => model!.CustomInfo
            .Where(e => e.Value is not null)
            .ToDictionary(e => e.Key, e => e.Value!, StringComparer.Ordinal);

    private async Task Save()
    {
        if (form is null || model is null || currentUser is null)
        {
            return;
        }

        await form.Validate();
        if (!form.IsValid)
        {
            Snackbar.Add(L["OnbAdm_FixInvalid"], Severity.Warning);
            return;
        }

        // Die Zusatzangaben einsammeln, bevor irgendetwas geschrieben wird: fehlt in einem Reiter ein
        // Pflichtfeld, springt die Maske ihn an und das Profil bleibt unangetastet.
        if (customInfoTabs is not null && !await customInfoTabs.TryCollectAsync())
        {
            return;
        }

        busy = true;
        try
        {
            if (customCtx is not null)
            {
                customCtx.ProfileType = model.ProfileType;
                CustomInfoCheckResult check = await CustomInfo.ValidateAsync(customCtx, Buckets());
                if (!check.Valid)
                {
                    customInfoTabs?.ShowError(check.HandlerKey, check.Message);
                    return;
                }
            }

            var id = await Handler.SaveBillingProfileAsync(currentUser, model);
            if (id is null)
            {
                Snackbar.Add(L["OnbAdm_SaveFailed"], Severity.Error);
                return;
            }

            model.BillingProfileId = id.Value;

            // Die Angaben der Module liegen in fremden Ablagen - mit dem Speichern des Profils gibt es
            // keine gemeinsame Transaktion. Deshalb danach, und ein Fehlschlag hier macht das gespeicherte
            // Profil nicht rueckgaengig; der Provider protokolliert, welches Modul es war.
            if (customCtx is not null)
            {
                CustomInfoPersistResult result = await CustomInfo.PersistAsync(customCtx, Buckets());
                if (!result.Complete)
                {
                    Snackbar.Add(L["OnbAdm_CustomPartlySaved"], Severity.Warning);
                    return;
                }
            }

            Snackbar.Add(L["OnbAdm_Saved"], Severity.Success);
        }
        finally
        {
            busy = false;
        }
    }
}
