@page "/Util/TenantTypes"
@rendermode @(RenderMode.InteractiveServer)
@attribute [Microsoft.AspNetCore.Authorization.Authorize]

@using Microsoft.AspNetCore.Components.Authorization

@inject ITenantTypeAdminHandler Handler
@inject AuthenticationStateProvider AuthState
@inject IDialogService DialogService
@inject ISnackbar Snackbar

<PageTitle>Tenant types</PageTitle>

<MudText Typo="Typo.h5" GutterBottom="true">Tenant types</MudText>

<SecureView RequiredPermissions="TenantTypes.View,TenantTypes.Write" RequiredFeatures="ITVAdminViews">
    <Permitted>
@if (currentUser is null)
{
    <MudProgressCircular Indeterminate="true" />
}
else
{
    <MudDataGrid T="TenantTypeViewModel"
                 @ref="grid"
                 ServerData="LoadData"
                 SortMode="SortMode.Single"
                 RowsPerPage="25"
                 Hover="true"
                 Dense="true">
        <ToolBarContent>
            <CrudGridToolbar OnRefresh="ReloadGrid" Title="Tenant types" @bind-Search="search" OnSearch="ReloadGrid">
                <SecureView RequiredPermissions="TenantTypes.Write">
                    <Permitted>
                        <MudButton StartIcon="@Icons.Material.Filled.Add" Variant="Variant.Filled" Color="Color.Primary" Class="ml-2" OnClick="OpenCreate">
                            Add tenant type
                        </MudButton>
                    </Permitted>
                </SecureView>
            </CrudGridToolbar>
        </ToolBarContent>
        <Columns>
            <PropertyColumn Property="x => x.TenantTypeName" Title="Name" />
            <PropertyColumn Property="x => x.TenantTemplateId" Title="Template id" />
            <TemplateColumn T="TenantTypeViewModel" Title="" Sortable="false">
                <CellTemplate>
                    <SecureView RequiredPermissions="TenantTypes.Write">
                        <Permitted>
                        <MudStack Row="true" Spacing="1">
                            <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" OnClick="@(() => OpenEdit(context.Item))" />
                            <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error" OnClick="@(() => Delete(context.Item))" />
                        </MudStack>
                        </Permitted>
                    </SecureView>
                </CellTemplate>
            </TemplateColumn>
        </Columns>
        <PagerContent>
            <MudDataGridPager T="TenantTypeViewModel" />
        </PagerContent>
    </MudDataGrid>
}
    </Permitted>
    <NotPermitted>
        <MudAlert Severity="Severity.Warning">No permission to view tenant types.</MudAlert>
    </NotPermitted>
</SecureView>

@code {
    private MudDataGrid<TenantTypeViewModel>? grid;
    private System.Security.Claims.ClaimsPrincipal? currentUser;
    private bool hasView;
    private bool hasWrite;
    private string? search;

    protected override async Task OnInitializedAsync()
    {
        var auth = await AuthState.GetAuthenticationStateAsync();
        currentUser = auth.User;
        hasView = Handler.HasPermission("TenantTypes.View", "TenantTypes.Write");
        hasWrite = Handler.HasPermission("TenantTypes.Write");
    }

    private async Task<GridData<TenantTypeViewModel>> LoadData(GridState<TenantTypeViewModel> state, CancellationToken ct)
    {
        if (currentUser is null) return new GridData<TenantTypeViewModel> { Items = Array.Empty<TenantTypeViewModel>(), TotalItems = 0 };
        var query = state.ToListQuery(search);
        var result = await Handler.ListAsync(currentUser, query);
        return new GridData<TenantTypeViewModel> { Items = result.Items, TotalItems = result.TotalCount };
    }

    private async Task ReloadGrid()
    {
        if (grid is not null) await grid.ReloadServerData();
    }

    private async Task OpenCreate()
    {
        var parameters = new DialogParameters<TenantTypeDialog> { { d => d.Model, new TenantTypeViewModel() }, { d => d.IsCreate, true } };
        var dlg = await DialogService.ShowAsync<TenantTypeDialog>("Create tenant type", parameters, EditDialogDefaults.Edit);
        var result = await dlg.Result;
        if (result is { Canceled: false, Data: TenantTypeViewModel input })
        {
            var created = await Handler.CreateAsync(currentUser!, input);
            if (created != null) { Snackbar.Add("Tenant type created", Severity.Success); await ReloadGrid(); }
            else Snackbar.Add("Failed to create", Severity.Error);
        }
    }

    private async Task OpenEdit(TenantTypeViewModel item)
    {
        var copy = new TenantTypeViewModel
        {
            TenantTypeId = item.TenantTypeId,
            TenantTypeName = item.TenantTypeName,
            TypeMetaData = item.TypeMetaData,
            TenantTemplateId = item.TenantTemplateId
        };
        var parameters = new DialogParameters<TenantTypeDialog> { { d => d.Model, copy }, { d => d.IsCreate, false } };
        var dlg = await DialogService.ShowAsync<TenantTypeDialog>("Edit tenant type", parameters, EditDialogDefaults.Edit);
        var result = await dlg.Result;
        if (result is { Canceled: false, Data: TenantTypeViewModel input })
        {
            var updated = await Handler.UpdateAsync(currentUser!, input);
            if (updated != null) { Snackbar.Add("Tenant type updated", Severity.Success); await ReloadGrid(); }
            else Snackbar.Add("Failed to update", Severity.Error);
        }
    }

    private async Task Delete(TenantTypeViewModel item)
    {
        var ok = await DialogService.ShowMessageBoxAsync("Delete tenant type", $"Really delete '{item.TenantTypeName}'?", yesText: "Delete", cancelText: "Cancel");
        if (ok != true) return;
        var success = await Handler.DeleteAsync(currentUser!, item.TenantTypeId);
        if (success) { Snackbar.Add("Tenant type deleted", Severity.Success); await ReloadGrid(); }
        else Snackbar.Add("Failed to delete", Severity.Error);
    }
}
