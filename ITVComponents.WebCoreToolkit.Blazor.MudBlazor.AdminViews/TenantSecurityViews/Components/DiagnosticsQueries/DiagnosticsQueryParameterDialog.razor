@using QueryParameterTypes = ITVComponents.WebCoreToolkit.EntityFramework.Models.QueryParameterTypes

<EditDialogShell Model="Model" IsCreate="IsCreate">
    <MudTextField @bind-Value="Model.ParameterName" Label="Parameter name" Required="true" RequiredError="Name is required" MaxLength="128" />
    <MudSelect T="QueryParameterTypes" @bind-Value="Model.ParameterType" Label="Type">
        @foreach (var pt in Enum.GetValues<QueryParameterTypes>())
        {
            <MudSelectItem T="QueryParameterTypes" Value="@pt">@pt</MudSelectItem>
        }
    </MudSelect>
    <MudTextField @bind-Value="Model.Format" Label="Format" MaxLength="64" />
    <MudCheckBox @bind-Value="Model.Optional" Label="Optional" />
    <MudTextField @bind-Value="Model.DefaultValue" Label="Default value" />
</EditDialogShell>

@code {
    [Parameter, EditorRequired] public DiagnosticsQueryParameterViewModel Model { get; set; } = default!;
    [Parameter] public bool IsCreate { get; set; }
}
