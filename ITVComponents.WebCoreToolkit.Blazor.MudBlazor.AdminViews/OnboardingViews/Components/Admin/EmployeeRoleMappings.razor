@page "/Onboarding/EmployeeRoleMappings"
@rendermode @(RenderMode.InteractiveServer)
@attribute [Microsoft.AspNetCore.Authorization.Authorize]

@using Microsoft.AspNetCore.Components.Authorization

@inject IOnboardingAdminHandler Handler
@inject AuthenticationStateProvider AuthState
@inject IDialogService DialogService
@inject ISnackbar Snackbar

<PageTitle>Employee role mappings</PageTitle>

<MudText Typo="Typo.h5" GutterBottom="true">Employee role mappings</MudText>

<SecureView RequiredPermissions="ManageEmployees" RequiredFeatures="ITVAdminViews">
    <Permitted>
        @if (loading)
        {
            <MudProgressCircular Indeterminate="true" />
        }
        else if (currentTenant is null)
        {
            <MudAlert Severity="Severity.Warning">No tenant is currently selected, or you are not a member of it.</MudAlert>
        }
        else
        {
            <MudText Typo="Typo.body2" Class="mb-2">Tenant: <b>@currentTenant.DisplayName</b></MudText>
            <MudDataGrid T="EmployeeRoleMappingViewModel" Items="mappings" Dense="true" Hover="true" Groupable="false">
                <ToolBarContent>
                    <RefreshButton OnClick="Reload" />
                    <MudText Typo="Typo.h6">Mappings</MudText>
                    <MudSpacer />
                    <MudButton StartIcon="@Icons.Material.Filled.Add" Variant="Variant.Filled" Color="Color.Primary" OnClick="OpenCreate">
                        Add mapping
                    </MudButton>
                </ToolBarContent>
                <Columns>
                    <PropertyColumn Property="x => x.Kind" Title="Kind" />
                    <PropertyColumn Property="x => x.RoleName" Title="Role" />
                    <TemplateColumn T="EmployeeRoleMappingViewModel" Title="" Sortable="false">
                        <CellTemplate>
                            <MudStack Row="true" Spacing="1">
                                <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" Title="Edit" OnClick="@(() => OpenManage(context.Item))" />
                                <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" Size="Size.Small" OnClick="@(() => Delete(context.Item))" />
                            </MudStack>
                        </CellTemplate>
                    </TemplateColumn>
                </Columns>
            </MudDataGrid>
        }
    </Permitted>
    <NotPermitted>
        <MudAlert Severity="Severity.Warning">No permission to manage employee role mappings.</MudAlert>
    </NotPermitted>
</SecureView>

@code {
    private System.Security.Claims.ClaimsPrincipal? currentUser;
    private TenantPickerItem? currentTenant;
    private EmployeeRoleMappingViewModel[] mappings = Array.Empty<EmployeeRoleMappingViewModel>();
    private bool loading = true;

    protected override async Task OnInitializedAsync()
    {
        var auth = await AuthState.GetAuthenticationStateAsync();
        currentUser = auth.User;
        currentTenant = await Handler.GetCurrentTenantAsync(currentUser);
        await Reload();
        loading = false;
    }

    private async Task Reload()
    {
        if (currentUser is null || currentTenant is null)
        {
            mappings = Array.Empty<EmployeeRoleMappingViewModel>();
            return;
        }

        mappings = await Handler.ListRoleMappingsAsync(currentUser);
    }

    private Task OpenCreate() => OpenDialog(new EmployeeRoleMappingViewModel());

    private Task OpenManage(EmployeeRoleMappingViewModel mapping) => OpenDialog(new EmployeeRoleMappingViewModel
    {
        EmployeeRoleMappingId = mapping.EmployeeRoleMappingId,
        Kind = mapping.Kind,
        RoleId = mapping.RoleId,
        RoleName = mapping.RoleName,
        DisplayNameJson = mapping.DisplayNameJson
    });

    private async Task OpenDialog(EmployeeRoleMappingViewModel model)
    {
        var parameters = new DialogParameters<EmployeeRoleMappingDialog> { { d => d.Model, model } };
        var title = model.EmployeeRoleMappingId == 0 ? "New mapping" : "Mapping";
        var dlg = await DialogService.ShowAsync<EmployeeRoleMappingDialog>(title, parameters, EditDialogDefaults.Detail);
        await dlg.Result;
        await Reload();
    }

    private async Task Delete(EmployeeRoleMappingViewModel mapping)
    {
        if (currentUser is null) return;
        var ok = await DialogService.ShowMessageBoxAsync("Delete mapping",
            $"Really delete the mapping for '{mapping.RoleName}'? Employee assignments to it are removed; the underlying role is kept.",
            yesText: "Delete", cancelText: "Cancel");
        if (ok != true) return;
        var success = await Handler.DeleteRoleMappingAsync(currentUser, mapping.EmployeeRoleMappingId);
        if (success) { Snackbar.Add("Mapping deleted", Severity.Success); await Reload(); }
        else Snackbar.Add("Failed to delete mapping", Severity.Error);
    }
}
