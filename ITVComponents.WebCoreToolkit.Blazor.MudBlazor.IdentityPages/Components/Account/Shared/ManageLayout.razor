@inherits LayoutComponentBase

@using Microsoft.Extensions.Localization
@using ITVComponents.WebCoreToolkit.Net.TelerikUi.AspNetCoreIdentityPages.Areas.Identity

@inject IStringLocalizer<IdentityMessages> L

<MudContainer MaxWidth="MaxWidth.Large" Class="mt-8">
    <MudText Typo="Typo.h4" GutterBottom="true">@L["Manage your account"]</MudText>
    <MudText Typo="Typo.h5" GutterBottom="true">@L["Change your account settings"]</MudText>
    <MudDivider Class="my-3" />

    <MudGrid>
        <MudItem xs="12" md="3">
            <MudPaper Elevation="1" Class="pa-2">
                <ManageNavMenu />
            </MudPaper>
        </MudItem>
        <MudItem xs="12" md="9">
            @Body
        </MudItem>
    </MudGrid>
</MudContainer>
