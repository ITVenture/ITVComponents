@using Microsoft.AspNetCore.Components.Authorization

@inject IDiagnosticsQueryAdminHandler Handler
@inject AuthenticationStateProvider AuthState
@inject IDialogService DialogService
@inject ISnackbar Snackbar

<MudDataGrid T="DiagnosticsQueryParameterViewModel"
             @ref="grid"
             ServerData="LoadData"
             SortMode="SortMode.None"
             RowsPerPage="10"
             Hover="true"
             Dense="true">
    <ToolBarContent>
        <CrudGridToolbar OnRefresh="@(() => grid is null ? Task.CompletedTask : grid.ReloadServerData())" Title="Parameters" TitleTypo="Typo.subtitle2">
            <SecureView RequiredPermissions="DiagnosticsQueries.Write">
                <Permitted>
                    <MudButton StartIcon="@Icons.Material.Filled.Add" Variant="Variant.Outlined" Size="Size.Small" OnClick="OpenCreate">
                        Add parameter
                    </MudButton>
                </Permitted>
            </SecureView>
        </CrudGridToolbar>
    </ToolBarContent>
    <Columns>
        <PropertyColumn Property="x => x.ParameterName" Title="Name" />
        <PropertyColumn Property="x => x.ParameterType" Title="Type" />
        <PropertyColumn Property="x => x.Format" Title="Format" />
        <PropertyColumn Property="x => x.Optional" Title="Optional" />
        <PropertyColumn Property="x => x.DefaultValue" Title="Default" />
        <TemplateColumn T="DiagnosticsQueryParameterViewModel" Title="" Sortable="false">
            <CellTemplate>
                <SecureView RequiredPermissions="DiagnosticsQueries.Write">
                    <Permitted>
                        <MudStack Row="true" Spacing="1">
                            <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" OnClick="@(() => OpenEdit(context.Item))" />
                            <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error" OnClick="@(() => Delete(context.Item))" />
                        </MudStack>
                    </Permitted>
                </SecureView>
            </CellTemplate>
        </TemplateColumn>
    </Columns>
    <PagerContent>
        <MudDataGridPager T="DiagnosticsQueryParameterViewModel" />
    </PagerContent>
</MudDataGrid>

@code {
    [Parameter, EditorRequired] public int DiagnosticsQueryId { get; set; }
    [Parameter] public bool CanWrite { get; set; }

    private MudDataGrid<DiagnosticsQueryParameterViewModel>? grid;
    private System.Security.Claims.ClaimsPrincipal? currentUser;

    protected override async Task OnInitializedAsync()
    {
        var auth = await AuthState.GetAuthenticationStateAsync();
        currentUser = auth.User;
    }

    private async Task<GridData<DiagnosticsQueryParameterViewModel>> LoadData(GridState<DiagnosticsQueryParameterViewModel> state, CancellationToken ct)
    {
        if (currentUser is null) return new GridData<DiagnosticsQueryParameterViewModel> { Items = Array.Empty<DiagnosticsQueryParameterViewModel>(), TotalItems = 0 };
        var query = new ListQuery { Page = state.Page, PageSize = state.PageSize };
        var result = await Handler.ListParametersAsync(currentUser, DiagnosticsQueryId, query);
        return new GridData<DiagnosticsQueryParameterViewModel> { Items = result.Items, TotalItems = result.TotalCount };
    }

    private async Task OpenCreate()
    {
        var parameters = new DialogParameters<DiagnosticsQueryParameterDialog>
        {
            { d => d.Model, new DiagnosticsQueryParameterViewModel() },
            { d => d.IsCreate, true }
        };
        var dlg = await DialogService.ShowAsync<DiagnosticsQueryParameterDialog>("Add parameter", parameters, EditDialogDefaults.Edit);
        var result = await dlg.Result;
        if (result is { Canceled: false, Data: DiagnosticsQueryParameterViewModel input })
        {
            var created = await Handler.CreateParameterAsync(currentUser!, DiagnosticsQueryId, input);
            if (created != null) { Snackbar.Add("Parameter added", Severity.Success); if (grid is not null) await grid.ReloadServerData(); }
            else Snackbar.Add("Failed to add", Severity.Error);
        }
    }

    private async Task OpenEdit(DiagnosticsQueryParameterViewModel item)
    {
        var copy = new DiagnosticsQueryParameterViewModel
        {
            DiagnosticsQueryParameterId = item.DiagnosticsQueryParameterId,
            DiagnosticsQueryId = item.DiagnosticsQueryId,
            ParameterName = item.ParameterName,
            ParameterType = item.ParameterType,
            Format = item.Format,
            Optional = item.Optional,
            DefaultValue = item.DefaultValue
        };
        var parameters = new DialogParameters<DiagnosticsQueryParameterDialog>
        {
            { d => d.Model, copy },
            { d => d.IsCreate, false }
        };
        var dlg = await DialogService.ShowAsync<DiagnosticsQueryParameterDialog>("Edit parameter", parameters, EditDialogDefaults.Edit);
        var result = await dlg.Result;
        if (result is { Canceled: false, Data: DiagnosticsQueryParameterViewModel input })
        {
            var updated = await Handler.UpdateParameterAsync(currentUser!, input);
            if (updated != null) { Snackbar.Add("Parameter updated", Severity.Success); if (grid is not null) await grid.ReloadServerData(); }
            else Snackbar.Add("Failed to update", Severity.Error);
        }
    }

    private async Task Delete(DiagnosticsQueryParameterViewModel item)
    {
        var ok = await DialogService.ShowMessageBoxAsync("Delete parameter", $"Really delete '{item.ParameterName}'?", yesText: "Delete", cancelText: "Cancel");
        if (ok != true) return;
        var success = await Handler.DeleteParameterAsync(currentUser!, item.DiagnosticsQueryParameterId);
        if (success) { Snackbar.Add("Parameter deleted", Severity.Success); if (grid is not null) await grid.ReloadServerData(); }
        else Snackbar.Add("Failed to delete", Severity.Error);
    }
}
