@page "/Account/Manage/ResetAuthenticator"
@rendermode @(RenderMode.InteractiveServer)

@layout ManageLayout
@attribute [Microsoft.AspNetCore.Authorization.Authorize]

@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.Extensions.Localization
@using Microsoft.Extensions.Logging
@using ITVComponents.WebCoreToolkit.Blazor.MudBlazor.IdentityPages.Components.Account.Shared
@using ITVComponents.WebCoreToolkit.IdentityShared.Areas.Identity
@using ITVComponents.WebCoreToolkit.IdentityShared.Areas.Identity.Pages.Account.Manage
@using ITVComponents.WebCoreToolkit.IdentityShared.PageHandlers.Identity.Account.Manage

@inject IPageHandlerProvider<ResetAuthenticatorModel, IResetAuthenticatorHandler> HandlerProvider
@inject AuthenticationStateProvider AuthState
@inject IStringLocalizer<IdentityMessages> L
@inject ILogger<ResetAuthenticator> Logger
@inject NavigationManager Nav

<PageTitle>@L["Reset authenticator key"]</PageTitle>

<MudText Typo="Typo.h5" GutterBottom="true">@L["Reset authenticator key"]</MudText>

@if (loading)
{
    <MudProgressCircular Indeterminate="true" />
}
else if (!usePage)
{
    <MudAlert Severity="Severity.Info">@L["This page is not available."]</MudAlert>
}
else if (notFound)
{
    <MudAlert Severity="Severity.Error">@notFoundMessage</MudAlert>
}
else
{
    <MudAlert Severity="Severity.Warning" Class="mb-3">
        <strong>@L["If you reset your authenticator key your authenticator app will not work until you reconfigure it."]</strong>
        <div>
            @L["This process disables 2FA until you verify your authenticator app. If you do not complete your authenticator app configuration you may lose access to your account."]
        </div>
    </MudAlert>

    <MudButton Variant="Variant.Filled" Color="Color.Error" Disabled="@busy" OnClick="OnSubmit">
        @L["Reset authenticator key"]
    </MudButton>
}

@code {
    private bool loading = true;
    private bool usePage;
    private bool notFound;
    private string? notFoundMessage;
    private bool busy;

    protected override async Task OnInitializedAsync()
    {
        await using var op = HandlerProvider.BeginOperation();
        usePage = op.Handler.UsePage;
        if (!usePage)
        {
            loading = false;
            return;
        }

        var principal = (await AuthState.GetAuthenticationStateAsync()).User;
        var user = await op.Handler.FetchUser(principal);
        try
        {
            if (!user.UserExists)
            {
                notFound = true;
                notFoundMessage = L["Unable to load user with ID '{0}'.", op.Handler.GetUserId(principal)];
            }
        }
        finally
        {
            op.Handler.ReleaseUser(user);
            loading = false;
        }
    }

    private async Task OnSubmit()
    {
        await using var op = HandlerProvider.BeginOperation();
        busy = true;
        var principal = (await AuthState.GetAuthenticationStateAsync()).User;
        var user = await op.Handler.FetchUser(principal);
        var userId = op.Handler.GetUserId(principal);
        try
        {
            if (!user.UserExists)
            {
                notFound = true;
                notFoundMessage = L["Unable to load user with ID '{0}'.", userId];
                return;
            }

            // refreshSignIn: false â€” der Handler wuerde sonst selbst das Cookie neu ausstellen, was auf dem
            // Circuit nicht geht. Das uebernimmt der Ruecksprung, der direkt danach auf die Einrichtungsseite
            // weiterleitet.
            await op.Handler.ResetAuthenticator(user, refreshSignIn: false);
            Logger.LogInformation("User with ID '{UserId}' has reset their authentication app key.", userId);
            ManageRedirects.RefreshSignIn(Nav, "Account/Manage/EnableAuthenticator");
        }
        finally
        {
            op.Handler.ReleaseUser(user);
            busy = false;
        }
    }
}
