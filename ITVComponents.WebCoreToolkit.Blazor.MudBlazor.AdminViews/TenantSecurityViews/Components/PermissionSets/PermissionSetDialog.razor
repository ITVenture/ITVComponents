<EditDialogShell Model="Model" IsCreate="IsCreate">
    <MudTextField @bind-Value="Model.Name" Label="Name" Required="true" RequiredError="Name is required" MaxLength="150" />
</EditDialogShell>

@code {
    [Parameter, EditorRequired] public PermissionSetViewModel Model { get; set; } = default!;
    [Parameter] public bool IsCreate { get; set; }
}
