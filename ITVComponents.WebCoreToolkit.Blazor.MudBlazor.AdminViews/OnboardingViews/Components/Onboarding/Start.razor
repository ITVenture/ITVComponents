@namespace ITVComponents.WebCoreToolkit.Blazor.MudBlazor.AdminViews.OnboardingViews.Components.Onboarding
@page "/Account/Onboarding/Start"
@rendermode @(RenderMode.InteractiveServer)
@using Microsoft.AspNetCore.Authorization
@using System.Text.Json.Nodes
@using ITVComponents.WebCoreToolkit.Blazor.MudBlazor.AdminViews.OnboardingViews.Components.Shared
@using ITVComponents.WebCoreToolkit.Security
@attribute [AllowAnonymous]

@inject IOnboardingHandler Handler
@inject ICustomCompanyInfoProvider CustomInfo
@inject IAccountConfirmationMailer Mailer
@inject NavigationManager Nav
@inject ISnackbar Snackbar
@inject IStringLocalizer<OnboardingMessages> L

<PageTitle>@L["Onb_Start_Title"]</PageTitle>

<MudContainer MaxWidth="MaxWidth.Medium" Class="my-4">
    <MudText Typo="Typo.h4" GutterBottom="true">@L["Onb_Start_Title"]</MudText>
    <MudText Typo="Typo.body1" Class="mb-4">@L["Onb_Start_Intro"]</MudText>

    @if (done)
    {
        <MudAlert Severity="Severity.Success" Class="my-4">@L["Onb_Start_CheckMail"]</MudAlert>
        <MudButton Href="/Account/Login" Variant="Variant.Filled" Color="Color.Primary">@L["Onb_Start_ToLogin"]</MudButton>
    }
    else
    {
        <EditForm Model="model" OnValidSubmit="OnSubmitAsync">
            <DataAnnotationsValidator />

            <BillingProfileForm @ref="profileForm" Model="model" ShowParentTenantPicker="false"
                                CustomTabs="customTabs"
                                CustomInfo="customCtx"
                                ProfileTypeChanged="DescribeCustomAsync" />

            <MudPaper Class="pa-4 mb-3" Outlined="true">
                <MudText Typo="Typo.h6" GutterBottom="true">@L["Onb_Start_Account"]</MudText>
                <MudGrid Spacing="2">
                    <MudItem xs="12" sm="6">
                        <MudTextField @bind-Value="model.Password" Label="@(L["Onb_Start_Password"])"
                                      For="@(() => model.Password)" InputType="InputType.Password" />
                    </MudItem>
                    <MudItem xs="12" sm="6">
                        <MudTextField @bind-Value="model.ConfirmPassword" Label="@(L["Onb_Start_ConfirmPassword"])"
                                      For="@(() => model.ConfirmPassword)" InputType="InputType.Password" />
                    </MudItem>
                </MudGrid>
            </MudPaper>

            <MudStack Row="true" Justify="Justify.FlexEnd" Spacing="2" Class="mt-3">
                <MudButton Href="/Account/Login" Variant="Variant.Text" Color="Color.Default">@L["Onb_Cancel"]</MudButton>
                <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary" Disabled="busy">
                    @(busy ? L["Onb_Creating"].Value : L["Onb_Start_Submit"].Value)
                </MudButton>
            </MudStack>

            <ValidationSummary />
        </EditForm>
    }
</MudContainer>

@code {
    private DirectOnboardingViewModel model = new();
    private BillingProfileForm? profileForm;
    private IReadOnlyList<CustomInfoTab>? customTabs;
    private CustomInfoContext? customCtx;
    private bool busy;
    private bool done;

    /// <summary>Optional tenant-invitation token carried over from the accept page; pins the future parent.</summary>
    [SupplyParameterFromQuery(Name = "invitation")]
    private string? InvitationToken { get; set; }

    protected override async Task OnInitializedAsync()
    {
        model.InvitationToken = InvitationToken;
        await DescribeCustomAsync();
    }

    /// <summary>
    /// Fragt die Zusatzangaben-Module, welche Reiter dieser Fall braucht. Der Benutzer ist hier noch
    /// nicht angemeldet - der Erfassungsfall traegt deshalb keinen Benutzer.
    /// </summary>
    private async Task DescribeCustomAsync()
    {
        customCtx = new CustomInfoContext
        {
            Mode = CustomInfoMode.Create,
            Origin = string.IsNullOrEmpty(InvitationToken)
                ? CustomInfoOrigin.SelfService
                : CustomInfoOrigin.Invitation,
            ProfileType = model.ProfileType
        };
        customTabs = await CustomInfo.DescribeAsync(customCtx);
    }

    private async Task OnSubmitAsync()
    {
        busy = true;
        try
        {
            // Erst die Zusatzangaben einsammeln - sie werden mit dem uebrigen Formular geparkt und erst
            // nach der Mailbestaetigung abgelegt.
            if (profileForm is not null && !await profileForm.TryCollectCustomAsync())
            {
                return;
            }

            if (customCtx is not null)
            {
                customCtx.ProfileType = model.ProfileType;
                CustomInfoCheckResult check = await CustomInfo.ValidateAsync(customCtx, Buckets());
                if (!check.Valid)
                {
                    profileForm?.ShowCustomError(check.HandlerKey, check.Message);
                    return;
                }
            }

            // The billing-profile e-mail doubles as the login e-mail. The token (when present) is parked
            // with the pending onboarding and re-applied on completion to pin the parent tenant.
            var result = await Handler.StartOnboardingAsync(new OnboardingStartInput(model.Email, model.Password, model, InvitationToken));
            if (!result.Succeeded)
            {
                Snackbar.Add(string.Join(" ", result.Errors), Severity.Error);
                return;
            }

            // Send the confirmation mail via the identity layer's own mailer (no Identity-UI dependency here).
            var confirmUri = Nav.ToAbsoluteUri("/Account/ConfirmEmail").AbsoluteUri;
            await Mailer.SendConfirmationAsync(result.UserId!, confirmUri, "/Account/Onboarding/MyTenants");

            done = true;
        }
        finally
        {
            busy = false;
        }
    }

    /// <summary>Die erfassten Datensaetze ohne die leeren Eintraege.</summary>
    private IReadOnlyDictionary<string, JsonNode> Buckets()
        => model.CustomInfo
            .Where(e => e.Value is not null)
            .ToDictionary(e => e.Key, e => e.Value!, StringComparer.Ordinal);
}
