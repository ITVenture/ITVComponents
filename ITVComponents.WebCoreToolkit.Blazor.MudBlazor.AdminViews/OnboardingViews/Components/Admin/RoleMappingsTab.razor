@using Microsoft.AspNetCore.Components.Authorization

@inject IOnboardingAdminHandler Handler
@inject AuthenticationStateProvider AuthState
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject IStringLocalizer<OnboardingMessages> L

@* Tab 3: the tenant's EmployeeRoleMapping catalog. A mapping is a friendly wrapper around a security role,
   either a DirectRole (assignable to employees) or a PermissionSet (a permission bundle activated on a
   DirectRole). Creating each kind is gated separately (Onboarding.Admin.RoleMappings.DirectRole /
   .PermissionSet) so a tenant can be limited to one kind. DirectRole rows expand to assign PermissionSets;
   the onboarding interceptor / role inheritance applies everything onto the underlying tenant roles. *@

<MudDataGrid T="EmployeeRoleMappingViewModel" Items="mappings" Dense="true" Hover="true" Groupable="false">
    <ToolBarContent>
        <RefreshButton OnClick="Reload" />
        <MudText Typo="Typo.subtitle2">@L["OnbAdm_Tab_RoleMappings"]</MudText>
        <MudSpacer />
        <SecureView RequiredPermissions="Onboarding.Admin.RoleMappings.DirectRole,Onboarding.Admin.RoleMappings.Write">
            <Permitted>
                <MudButton StartIcon="@Icons.Material.Filled.Add" Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small" Class="mr-2"
                           OnClick="@(() => Create(EmployeeRoleMappingKind.DirectRole))">@L["OnbAdm_Rm_AddDirect"]</MudButton>
            </Permitted>
        </SecureView>
        <SecureView RequiredPermissions="Onboarding.Admin.RoleMappings.PermissionSet,Onboarding.Admin.RoleMappings.Write">
            <Permitted>
                <MudButton StartIcon="@Icons.Material.Filled.Add" Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Small" Class="mr-2"
                           OnClick="@(() => Create(EmployeeRoleMappingKind.PermissionSet))">@L["OnbAdm_Rm_AddPermSet"]</MudButton>
            </Permitted>
        </SecureView>
        <SecureView RequiredPermissions="Onboarding.Admin.RoleMappings.Delegation,Onboarding.Admin.RoleMappings.Write">
            <Permitted>
                <MudButton StartIcon="@Icons.Material.Filled.Add" Variant="Variant.Outlined" Color="Color.Secondary" Size="Size.Small"
                           OnClick="@(() => Create(EmployeeRoleMappingKind.Delegation))">@L["OnbAdm_Rm_AddDelegation"]</MudButton>
            </Permitted>
        </SecureView>
    </ToolBarContent>
    <Columns>
        <HierarchyColumn T="EmployeeRoleMappingViewModel" ButtonDisabledFunc="@(x => x.Kind != EmployeeRoleMappingKind.DirectRole && x.Kind != EmployeeRoleMappingKind.Delegation)" />
        <TemplateColumn T="EmployeeRoleMappingViewModel" Title="@L["OnbAdm_Rm_Kind"]" Sortable="false">
            <CellTemplate>
                @(context.Item.Kind switch
                {
                    EmployeeRoleMappingKind.DirectRole => L["OnbAdm_Rm_KindDirect"],
                    EmployeeRoleMappingKind.PermissionSet => L["OnbAdm_Rm_KindPermSet"],
                    _ => L["OnbAdm_Rm_KindDelegation"]
                })
            </CellTemplate>
        </TemplateColumn>
        <PropertyColumn Property="x => x.Label" Title="@L["OnbAdm_Roles_Col"]" />
        <TemplateColumn T="EmployeeRoleMappingViewModel" Title="@L["OnbAdm_Rm_Feature"]" Sortable="false">
            <CellTemplate>
                @if (!string.IsNullOrEmpty(context.Item.VisibilityFeature))
                {
                    <MudChip T="string" Size="Size.Small" Color="Color.Info" Icon="@Icons.Material.Filled.Lock">@context.Item.VisibilityFeature</MudChip>
                }
            </CellTemplate>
        </TemplateColumn>
        <TemplateColumn T="EmployeeRoleMappingViewModel" Title="" Sortable="false">
            <CellTemplate>
                <SecureView RequiredPermissions="@WritePermFor(context.Item.Kind)">
                    <Permitted>
                        <MudStack Row="true" Spacing="1">
                            <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" Title="@L["OnbAdm_Edit"]" OnClick="@(() => Edit(context.Item))" />
                            <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" Size="Size.Small" Title="@L["OnbAdm_Delete"]" OnClick="@(() => Delete(context.Item))" />
                        </MudStack>
                    </Permitted>
                </SecureView>
            </CellTemplate>
        </TemplateColumn>
    </Columns>
    <ChildRowContent>
        @if (context.Item.Kind == EmployeeRoleMappingKind.DirectRole || context.Item.Kind == EmployeeRoleMappingKind.Delegation)
        {
            <MudPaper Elevation="0" Class="pa-2">
                <PermissionSetsGrid DirectMappingId="context.Item.EmployeeRoleMappingId" AssignPermissions="@AssignPermFor(context.Item.Kind)" />
            </MudPaper>
        }
    </ChildRowContent>
</MudDataGrid>

@code {
    private System.Security.Claims.ClaimsPrincipal? currentUser;
    private EmployeeRoleMappingViewModel[] mappings = Array.Empty<EmployeeRoleMappingViewModel>();

    protected override async Task OnInitializedAsync()
    {
        var auth = await AuthState.GetAuthenticationStateAsync();
        currentUser = auth.User;
        await Reload();
    }

    private async Task Reload()
    {
        if (currentUser is null)
        {
            mappings = Array.Empty<EmployeeRoleMappingViewModel>();
            return;
        }

        mappings = await Handler.ListRoleMappingsAsync(currentUser);
    }

    // Full-edit (create/edit/delete/rename) permissions per kind — drives the per-row edit/delete buttons.
    private static string WritePermFor(EmployeeRoleMappingKind kind) => kind switch
    {
        EmployeeRoleMappingKind.DirectRole => "Onboarding.Admin.RoleMappings.DirectRole,Onboarding.Admin.RoleMappings.Write",
        EmployeeRoleMappingKind.PermissionSet => "Onboarding.Admin.RoleMappings.PermissionSet,Onboarding.Admin.RoleMappings.Write",
        _ => "Onboarding.Admin.RoleMappings.Delegation,Onboarding.Admin.RoleMappings.Write"
    };

    // Permissions that allow activating PermissionSets on an expandable parent (sub-grid checkbox). A Delegation
    // parent additionally accepts the weaker delegate-assign tier; a DirectRole parent needs DirectRole write.
    private static string AssignPermFor(EmployeeRoleMappingKind kind) =>
        kind == EmployeeRoleMappingKind.Delegation
            ? "Onboarding.Admin.RoleMappings.Delegation,Onboarding.Admin.RoleMappings.Write,Onboarding.Admin.RoleMappings.DelegationAssign"
            : "Onboarding.Admin.RoleMappings.DirectRole,Onboarding.Admin.RoleMappings.Write";

    private Task Create(EmployeeRoleMappingKind kind) => OpenDialog(new EmployeeRoleMappingViewModel { Kind = kind });

    private Task Edit(EmployeeRoleMappingViewModel mapping) => OpenDialog(new EmployeeRoleMappingViewModel
    {
        EmployeeRoleMappingId = mapping.EmployeeRoleMappingId,
        Kind = mapping.Kind,
        RoleId = mapping.RoleId,
        RoleName = mapping.RoleName,
        DisplayNameJson = mapping.DisplayNameJson,
        VisibilityFeature = mapping.VisibilityFeature
    });

    private async Task OpenDialog(EmployeeRoleMappingViewModel model)
    {
        var parameters = new DialogParameters<RoleMappingDialog> { { d => d.Model, model } };
        var title = model.EmployeeRoleMappingId == 0 ? L["OnbAdm_Rm_AddTitle"] : L["OnbAdm_Rm_EditTitle"];
        var dlg = await DialogService.ShowAsync<RoleMappingDialog>(title, parameters, EditDialogDefaults.Detail);
        await dlg.Result;
        await Reload();
    }

    private async Task Delete(EmployeeRoleMappingViewModel mapping)
    {
        if (currentUser is null)
        {
            return;
        }

        var confirmed = await DialogService.ShowMessageBoxAsync(L["OnbAdm_Delete"], L["OnbAdm_Rm_DeleteConfirm", mapping.Label], yesText: L["OnbAdm_Delete"], cancelText: L["Onb_Cancel"]);
        if (confirmed != true)
        {
            return;
        }

        var success = await Handler.DeleteRoleMappingAsync(currentUser, mapping.EmployeeRoleMappingId);
        if (success)
        {
            Snackbar.Add(L["OnbAdm_Rm_Deleted"], Severity.Success);
            await Reload();
        }
        else
        {
            Snackbar.Add(L["OnbAdm_SaveFailed"], Severity.Error);
        }
    }
}
