@using ITVComponents.WebCoreToolkit.Blazor.MudBlazor.AdminViews.HelpViews.Rendering
@inject IHelpAdminHandler Handler
@inject AuthenticationStateProvider AuthState
@inject ISnackbar Snackbar
@inject IHelpContentRenderer Renderer

@* Create/edit a help topic. Metadata plus a per-language editor: pick or add a language, enter the title and
   (for content pages) the body in the WYSIWYG Markdown editor, with a server-rendered preview. Editing one
   language at a time keeps a single editor instance; switching flushes the current text into the model first
   and loads the other language explicitly (SetValueAsync) - see SwitchCultureAsync.

   Die Vorschau bleibt neben dem Editor bestehen, obwohl der WYSIWYG-Modus schon zeigt, was dasteht: sie
   rendert ueber IHelpContentRenderer und ist damit die WAHRHEIT - dieselbe Pipeline, die der Leser
   spaeter sieht (kein rohes HTML, module:-Verweise nur fuer Angemeldete). *@

<style>
    /* Preview media is injected via MarkupString, so scoped CSS cannot reach it.
       Force large images/videos to shrink to the container width while keeping aspect-ratio. */
    .itv-help-content img,
    .itv-help-content video,
    .itv-help-content iframe {
        max-width: 100%;
        height: auto;
    }
</style>

<MudDialog Class="itv-fill-editor">
    <DialogContent>
        <DialogFillStyles />
        <MudForm @ref="form" Model="Model">
            <MudGrid Spacing="2">
                <MudItem xs="12" sm="6">
                    <MudTextField @bind-Value="Model.Slug" Label="Slug" Required="true" For="@(() => Model.Slug)"
                                  HelperText="Stable key for deep-links (/help/{slug})." />
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudSelect T="HelpTopicKind" @bind-Value="Model.Kind" Label="Kind">
                        <MudSelectItem T="HelpTopicKind" Value="HelpTopicKind.Container">Container (group, no content)</MudSelectItem>
                        <MudSelectItem T="HelpTopicKind" Value="HelpTopicKind.ContentPage">Content page (Markdown)</MudSelectItem>
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudTextField @bind-Value="Model.Icon" Label="Icon (optional MudBlazor name)" />
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudNumericField @bind-Value="Model.SortOrder" Label="Sort order" />
                </MudItem>
                <MudItem xs="12" sm="6" Class="d-flex align-center">
                    <MudSwitch @bind-Value="Model.IsPublished" Label="Published" Color="Color.Primary" />
                </MudItem>
                <MudItem xs="12" sm="6" Class="d-flex align-center">
                    @* Listing is not visibility: a topic that is off the menu is still served under its slug.
                       That is deliberate - linked documents (terms, privacy) must be readable without cluttering
                       the product help. Use "Published" to take a topic off the air. *@
                    <MudSwitch @bind-Value="Model.ShowInMenu" Label="Show in menu" Color="Color.Primary" />
                </MudItem>
                <MudItem xs="12">
                    @if (!Model.ShowInMenu)
                    {
                        <MudText Typo="Typo.caption" Class="mud-text-secondary">
                            Hidden from the navigation tree, together with everything below it. Still reachable at
                            /help/@Model.Slug — link it from wherever it belongs.
                        </MudText>
                    }
                </MudItem>

                <MudItem xs="12"><MudDivider Class="my-1" /></MudItem>

                <MudItem xs="12">
                    <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center">
                        <MudSelect T="string" Value="selectedCulture" ValueChanged="OnCultureChanged" Label="Language"
                                   Dense="true" Style="max-width:200px">
                            @foreach (var ct in Model.Contents)
                            {
                                <MudSelectItem T="string" Value="@ct.Culture">@ct.Culture</MudSelectItem>
                            }
                        </MudSelect>
                        <MudTextField @bind-Value="newCulture" Label="Add language (DEFAULT, de, de-CH, …)" Style="max-width:280px" />
                        <MudIconButton Icon="@Icons.Material.Filled.Add" Color="Color.Primary" OnClick="AddCulture" Title="Add language" />
                        @if (CurrentContent is not null)
                        {
                            <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" OnClick="RemoveCurrentCulture" Title="Remove this language" />
                        }
                    </MudStack>
                </MudItem>

                @if (CurrentContent is not null)
                {
                    <MudItem xs="12">
                        <MudTextField @bind-Value="CurrentContent.Title" Label="Title" Required="true" />
                    </MudItem>
                    @if (Model.Kind == HelpTopicKind.ContentPage)
                    {
                        <MudItem xs="12">
                            <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center" Class="mb-1">
                                <MudText Typo="Typo.subtitle2">Content</MudText>
                                <MudText Typo="Typo.caption" Class="mud-text-secondary">
                                    Insert media with the camera button; paste or drop an image to add it to the library.
                                </MudText>
                                <MudSpacer />
                                <MudButton Size="Size.Small" StartIcon="@Icons.Material.Filled.Visibility" OnClick="Preview">Preview</MudButton>
                            </MudStack>
                            @* Bewusst ohne @key: ein Sprachwechsel tauscht nur den Text (siehe
                               SwitchCultureAsync), statt den Editor wegzuwerfen und neu aufzubauen. *@
                            <MarkdownEditor @ref="bodyEditor" Value="@CurrentContent.Body" Lines="14" />
                        </MudItem>
                        @if (!string.IsNullOrEmpty(previewHtml))
                        {
                            <MudItem xs="12">
                                <MudText Typo="Typo.caption" Class="mud-text-secondary">Preview</MudText>
                                <MudPaper Outlined="true" Class="pa-3 itv-help-content">@((MarkupString)previewHtml!)</MudPaper>
                            </MudItem>
                        }
                    }
                }
                else
                {
                    <MudItem xs="12">
                        <MudAlert Severity="Severity.Info">Add a language to enter a title@(Model.Kind == HelpTopicKind.ContentPage ? " and content" : "").</MudAlert>
                    </MudItem>
                }
            </MudGrid>
        </MudForm>
    </DialogContent>
    <DialogActions>
        <DialogMaximizeToggle NormalMaxWidth="MaxWidth.ExtraLarge" />
        <MudSpacer />
        <MudButton OnClick="Cancel">Cancel</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="@busy" OnClick="Save">Save</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;
    [Parameter, EditorRequired] public HelpTopicEditViewModel Model { get; set; } = default!;

    private System.Security.Claims.ClaimsPrincipal? currentUser;
    private MarkdownEditor? bodyEditor;
    private MudForm? form;
    private bool busy;
    private string selectedCulture = string.Empty;
    private string? newCulture;
    private string? previewHtml;

    private HelpTopicContentViewModel? CurrentContent
        => Model.Contents.FirstOrDefault(c => string.Equals(c.Culture, selectedCulture, StringComparison.OrdinalIgnoreCase));

    protected override async Task OnInitializedAsync()
    {
        var auth = await AuthState.GetAuthenticationStateAsync();
        currentUser = auth.User;
        selectedCulture = Model.Contents.FirstOrDefault()?.Culture ?? string.Empty;
    }

    private async Task OnCultureChanged(string culture) => await SwitchCultureAsync(culture);

    /// <summary>
    /// Wechselt die bearbeitete Sprache: den aktuellen Text sichern, umschalten, den anderen Text in
    /// den Editor laden.
    /// </summary>
    /// <remarks>
    /// Das Laden ist ausdruecklich und nicht der Bindung ueberlassen: der Editor besitzt seinen Text
    /// und meldet ihn nur gebuendelt zurueck - fuer die Maske sehen zwei Sprachen mit (noch) gleichem
    /// Inhalt deshalb aus wie "nichts zu tun", und der Text der einen bliebe in der anderen stehen.
    /// </remarks>
    private async Task SwitchCultureAsync(string culture)
    {
        await FlushAsync();
        selectedCulture = culture;
        previewHtml = null;

        if (bodyEditor is not null && Model.Kind == HelpTopicKind.ContentPage)
        {
            await bodyEditor.SetValueAsync(CurrentContent?.Body);
        }
    }

    // Pull the live editor text into the model before we swap the language or save (not two-way bound).
    private async Task FlushAsync()
    {
        if (bodyEditor is not null && CurrentContent is not null && Model.Kind == HelpTopicKind.ContentPage)
        {
            CurrentContent.Body = await bodyEditor.GetValueAsync() ?? string.Empty;
        }
    }

    private async Task AddCulture()
    {
        var culture = newCulture?.Trim();
        if (string.IsNullOrEmpty(culture))
        {
            return;
        }

        if (Model.Contents.Any(c => string.Equals(c.Culture, culture, StringComparison.OrdinalIgnoreCase)))
        {
            // Die Sprache gibt es schon - dann ist "hinzufuegen" ein Umschalten, und zwar ueber
            // denselben Weg: sonst behielte der Editor den Text der vorigen Sprache.
            await SwitchCultureAsync(culture);
            newCulture = string.Empty;
            return;
        }

        Model.Contents.Add(new HelpTopicContentViewModel { Culture = culture, Title = string.Empty });
        await SwitchCultureAsync(culture);
        newCulture = string.Empty;
    }

    private async Task RemoveCurrentCulture()
    {
        var current = CurrentContent;
        if (current is null)
        {
            return;
        }

        Model.Contents.Remove(current);
        selectedCulture = Model.Contents.FirstOrDefault()?.Culture ?? string.Empty;
        previewHtml = null;

        // Ohne dieses Nachladen zeigte der Editor weiter den Text der geloeschten Sprache - und
        // schriebe ihn beim Speichern in die nun ausgewaehlte.
        if (bodyEditor is not null && Model.Kind == HelpTopicKind.ContentPage)
        {
            await bodyEditor.SetValueAsync(CurrentContent?.Body);
        }
    }

    private async Task Preview()
    {
        await FlushAsync();
        // Preview is shown to the signed-in admin, so module links render as (tenant-scoped) links.
        previewHtml = Renderer.ToHtml(CurrentContent?.Body, selectedCulture, userAuthenticated: true);
    }

    private async Task Save()
    {
        if (form is null || currentUser is null)
        {
            return;
        }

        await form.ValidateAsync();
        if (!form.IsValid)
        {
            Snackbar.Add("Please fix the highlighted fields.", Severity.Warning);
            return;
        }

        if (Model.Contents.Count == 0)
        {
            Snackbar.Add("Add at least one language with a title.", Severity.Warning);
            return;
        }

        busy = true;
        try
        {
            await FlushAsync();
            var id = await Handler.SaveTopicAsync(currentUser, Model);
            if (id is null)
            {
                Snackbar.Add("Save failed (duplicate slug or missing permission).", Severity.Error);
                return;
            }

            Snackbar.Add("Topic saved.", Severity.Success);
            MudDialog.Close(DialogResult.Ok(id.Value));
        }
        finally
        {
            busy = false;
        }
    }

    private void Cancel() => MudDialog.Close(DialogResult.Cancel());
}
