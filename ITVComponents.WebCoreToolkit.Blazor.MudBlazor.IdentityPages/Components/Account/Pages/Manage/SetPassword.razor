@page "/Account/Manage/SetPassword"
@attribute [Microsoft.AspNetCore.Components.ExcludeFromInteractiveRouting]

@layout ManageLayout
@attribute [Microsoft.AspNetCore.Authorization.Authorize]

@using System.ComponentModel.DataAnnotations
@using Microsoft.AspNetCore.Http
@using Microsoft.Extensions.Localization
@using ITVComponents.WebCoreToolkit.Blazor.MudBlazor.IdentityPages.Components.Account.Shared
@using ITVComponents.WebCoreToolkit.IdentityShared.Areas.Identity
@using ITVComponents.WebCoreToolkit.IdentityShared.Areas.Identity.Pages.Account.Manage
@using ITVComponents.WebCoreToolkit.IdentityShared.PageHandlers.Identity.Account.Manage

@inject IPageHandlerProvider<SetPasswordModel, ISetPasswordHandler> HandlerProvider
@inject IStringLocalizer<IdentityMessages> L
@inject NavigationManager Nav

<PageTitle>@L["Set password"]</PageTitle>

<MudText Typo="Typo.h5" GutterBottom="true">@L["Set your password"]</MudText>

@if (!HandlerProvider.Handler.UsePage)
{
    <MudAlert Severity="Severity.Info">@L["This page is not available."]</MudAlert>
}
else if (notFound)
{
    <MudAlert Severity="Severity.Error">@notFoundMessage</MudAlert>
}
else
{
    @if (!string.IsNullOrEmpty(StatusMessage))
    {
        <MudAlert Severity="Severity.Success" Class="mb-3">@StatusMessage</MudAlert>
    }

    <MudAlert Severity="Severity.Info" Class="mb-3">
        @L["You do not have a local username/password for this site. Add a local account so you can log in without an external login."]
    </MudAlert>

    <EditForm Model="Input" method="post" OnValidSubmit="OnSubmit" FormName="set-password">
        <ToolkitDataAnnotationsValidator />

        @if (errors.Count > 0)
        {
            <MudAlert Severity="Severity.Error" Class="mb-3">
                @foreach (var err in errors) { <div>@err</div> }
            </MudAlert>
        }

        <div class="form-floating mb-3">
            <InputText @bind-Value="Input.NewPassword" id="Input.NewPassword" class="form-control" type="password" autocomplete="new-password" />
            <label for="Input.NewPassword">@L["New password"]</label>
            <ValidationMessage For="() => Input.NewPassword" class="text-danger" />
        </div>

        <div class="form-floating mb-3">
            <InputText @bind-Value="Input.ConfirmPassword" id="Input.ConfirmPassword" class="form-control" type="password" autocomplete="new-password" />
            <label for="Input.ConfirmPassword">@L["Confirm new password"]</label>
            <ValidationMessage For="() => Input.ConfirmPassword" class="text-danger" />
        </div>

        <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary">
            @L["Set password"]
        </MudButton>
    </EditForm>
}

@code {
    private bool notFound;
    private string? notFoundMessage;
    private List<string> errors = new();

    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    [SupplyParameterFromForm]
    private InputModel Input { get; set; } = new();

    [SupplyParameterFromQuery(Name = "status")]
    private string? StatusMessage { get; set; }

    protected override async Task OnInitializedAsync()
    {
        if (!HandlerProvider.Handler.UsePage) return;
        if (HttpMethods.IsPost(HttpContext.Request.Method)) return;

        var user = await HandlerProvider.Handler.FetchUser(HttpContext.User);
        try
        {
            if (!user.UserExists)
            {
                notFound = true;
                notFoundMessage = L["Unable to load user with ID '{0}'.", HandlerProvider.Handler.GetUserId(HttpContext.User)];
                return;
            }

            if (user.HasPassword)
            {
                Nav.NavigateTo("Account/Manage/ChangePassword", forceLoad: true);
            }
        }
        finally
        {
            HandlerProvider.Handler.ReleaseUser(user);
        }
    }

    private async Task OnSubmit()
    {
        var user = await HandlerProvider.Handler.FetchUser(HttpContext.User);
        try
        {
            if (!user.UserExists)
            {
                notFound = true;
                notFoundMessage = L["Unable to load user with ID '{0}'.", HandlerProvider.Handler.GetUserId(HttpContext.User)];
                return;
            }

            var result = await HandlerProvider.Handler.AddPassword(user, Input.NewPassword);
            if (!result.Succeeded)
            {
                errors = result.Errors.Select(e => e.Description).ToList();
                return;
            }

            await HandlerProvider.Handler.RefreshSignIn(user);
            Nav.NavigateTo(
                Nav.GetUriWithQueryParameters("Account/Manage/SetPassword",
                    new Dictionary<string, object?> { ["status"] = L["Your password has been set."].Value }),
                forceLoad: true);
        }
        finally
        {
            HandlerProvider.Handler.ReleaseUser(user);
        }
    }

    public sealed class InputModel
    {
        [Required]
        [StringLength(100, MinimumLength = 6)]
        [DataType(DataType.Password)]
        public string NewPassword { get; set; } = "";

        [DataType(DataType.Password)]
        [Compare("NewPassword")]
        public string ConfirmPassword { get; set; } = "";
    }
}
