@page "/Util/TenantTemplates"
@rendermode @(RenderMode.InteractiveServer)
@attribute [Microsoft.AspNetCore.Authorization.Authorize]

@using Microsoft.AspNetCore.Components.Authorization

@inject ITenantTemplateAdminHandler Handler
@inject AuthenticationStateProvider AuthState
@inject IDialogService DialogService
@inject ISnackbar Snackbar

<PageTitle>Tenant templates</PageTitle>

<MudText Typo="Typo.h5" GutterBottom="true">Tenant templates</MudText>

<SecureView RequiredPermissions="TenantTemplates.View,TenantTemplates.Write" RequiredFeatures="ITVAdminViews">
    <Permitted>
@if (currentUser is null)
{
    <MudProgressCircular Indeterminate="true" />
}
else
{
    <MudDataGrid T="TenantTemplateViewModel"
                 @ref="grid"
                 ServerData="LoadData"
                 SortMode="SortMode.Single"
                 RowsPerPage="25"
                 Hover="true"
                 Dense="true">
        <ToolBarContent>
            <CrudGridToolbar OnRefresh="ReloadGrid" Title="Tenant templates" @bind-Search="search" OnSearch="ReloadGrid">
                <SecureView RequiredPermissions="TenantTemplates.Write">
                    <Permitted>
                        <MudButton StartIcon="@Icons.Material.Filled.Add" Variant="Variant.Filled" Color="Color.Primary" Class="ml-2" OnClick="OpenCreate">
                            Add template
                        </MudButton>
                    </Permitted>
                </SecureView>
            </CrudGridToolbar>
        </ToolBarContent>
        <Columns>
            <PropertyColumn Property="x => x.Name" Title="Name" />
            <PropertyColumn Property="x => x.Description" Title="Description" />
            <TemplateColumn T="TenantTemplateViewModel" Title="" Sortable="false">
                <CellTemplate>
                    <SecureView RequiredPermissions="TenantTemplates.Write">
                        <Permitted>
                        <MudStack Row="true" Spacing="1">
                            <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" OnClick="@(() => OpenEdit(context.Item))" />
                            <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error" OnClick="@(() => Delete(context.Item))" />
                        </MudStack>
                        </Permitted>
                    </SecureView>
                </CellTemplate>
            </TemplateColumn>
        </Columns>
        <PagerContent>
            <MudDataGridPager T="TenantTemplateViewModel" />
        </PagerContent>
    </MudDataGrid>
}
    </Permitted>
    <NotPermitted>
        <MudAlert Severity="Severity.Warning">No permission to view tenant templates.</MudAlert>
    </NotPermitted>
</SecureView>

@code {
    private MudDataGrid<TenantTemplateViewModel>? grid;
    private System.Security.Claims.ClaimsPrincipal? currentUser;
    private bool hasView;
    private bool hasWrite;
    private string? search;

    protected override async Task OnInitializedAsync()
    {
        var auth = await AuthState.GetAuthenticationStateAsync();
        currentUser = auth.User;
        hasView = Handler.HasPermission(currentUser, "TenantTemplates.View", "TenantTemplates.Write");
        hasWrite = Handler.HasPermission(currentUser, "TenantTemplates.Write");
    }

    private async Task<GridData<TenantTemplateViewModel>> LoadData(GridState<TenantTemplateViewModel> state, CancellationToken ct)
    {
        if (currentUser is null) return new GridData<TenantTemplateViewModel> { Items = Array.Empty<TenantTemplateViewModel>(), TotalItems = 0 };
        var query = state.ToListQuery(search);
        var result = await Handler.ListAsync(currentUser, query);
        return new GridData<TenantTemplateViewModel> { Items = result.Items, TotalItems = result.TotalCount };
    }

    private async Task ReloadGrid()
    {
        if (grid is not null) await grid.ReloadServerData();
    }

    private async Task OpenCreate()
    {
        var parameters = new DialogParameters<TenantTemplateDialog> { { d => d.Model, new TenantTemplateViewModel() }, { d => d.IsCreate, true } };
        var dlg = await DialogService.ShowAsync<TenantTemplateDialog>("Create template", parameters, EditDialogDefaults.Edit);
        var result = await dlg.Result;
        if (result is { Canceled: false, Data: TenantTemplateViewModel input })
        {
            var created = await Handler.CreateAsync(currentUser!, input);
            if (created != null) { Snackbar.Add("Template created", Severity.Success); await ReloadGrid(); }
            else Snackbar.Add("Failed to create", Severity.Error);
        }
    }

    private async Task OpenEdit(TenantTemplateViewModel item)
    {
        var copy = new TenantTemplateViewModel
        {
            TenantTemplateId = item.TenantTemplateId,
            Name = item.Name,
            Description = item.Description,
            Markup = item.Markup
        };
        var parameters = new DialogParameters<TenantTemplateDialog> { { d => d.Model, copy }, { d => d.IsCreate, false } };
        var dlg = await DialogService.ShowAsync<TenantTemplateDialog>("Edit template", parameters, EditDialogDefaults.Edit);
        var result = await dlg.Result;
        if (result is { Canceled: false, Data: TenantTemplateViewModel input })
        {
            var updated = await Handler.UpdateAsync(currentUser!, input);
            if (updated != null) { Snackbar.Add("Template updated", Severity.Success); await ReloadGrid(); }
            else Snackbar.Add("Failed to update", Severity.Error);
        }
    }

    private async Task Delete(TenantTemplateViewModel item)
    {
        var ok = await DialogService.ShowMessageBoxAsync("Delete template", $"Really delete '{item.Name}'?", yesText: "Delete", cancelText: "Cancel");
        if (ok != true) return;
        var success = await Handler.DeleteAsync(currentUser!, item.TenantTemplateId);
        if (success) { Snackbar.Add("Template deleted", Severity.Success); await ReloadGrid(); }
        else Snackbar.Add("Failed to delete", Severity.Error);
    }
}
