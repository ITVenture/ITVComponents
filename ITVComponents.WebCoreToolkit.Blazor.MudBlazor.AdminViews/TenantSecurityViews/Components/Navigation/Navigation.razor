@page "/Security/Navigation"
@rendermode @(RenderMode.InteractiveServer)
@attribute [Microsoft.AspNetCore.Authorization.Authorize]

@using Microsoft.AspNetCore.Components.Authorization

@inject INavigationAdminHandler Handler
@inject AuthenticationStateProvider AuthState

<PageTitle>Navigation</PageTitle>

<MudText Typo="Typo.h5" GutterBottom="true">Navigation</MudText>

<SecureView RequiredPermissions="Navigation.View,Navigation.Write" RequiredFeatures="ITVAdminViews">
    <Permitted>
@if (currentUser is null)
{
    <MudProgressCircular Indeterminate="true" />
}
else if (!choicesLoaded)
{
    @* Wait for ReloadChoices to finish before rendering the tree grid.
       Otherwise the grid's own LoadData starts in parallel with ReloadChoices
       and both compete for the same scoped DbContext → "second operation" crash. *@
    <MudProgressCircular Indeterminate="true" />
}
else
{
    <NavigationTreeGrid ParentId="@null"
                        CurrentUser="@currentUser"
                        HasWrite="@hasWrite"
                        AllParents="@allParents"
                        AllTenants="@allTenants"
                        OnDataChanged="@ReloadChoices" />
}
    </Permitted>
    <NotPermitted>
        <MudAlert Severity="Severity.Warning">No permission to view navigation.</MudAlert>
    </NotPermitted>
</SecureView>

@code {
    private System.Security.Claims.ClaimsPrincipal? currentUser;
    private bool hasView;
    private bool hasWrite;
    private bool choicesLoaded;
    private IReadOnlyList<NavigationParentChoice> allParents = Array.Empty<NavigationParentChoice>();
    private IReadOnlyList<TenantChoice> allTenants = Array.Empty<TenantChoice>();

    protected override async Task OnInitializedAsync()
    {
        var auth = await AuthState.GetAuthenticationStateAsync();
        currentUser = auth.User;
        hasView = Handler.HasPermission(currentUser, "Navigation.View", "Navigation.Write");
        hasWrite = Handler.HasPermission(currentUser, "Navigation.Write");
        // Choices are loaded in OnAfterRenderAsync — see comment there.
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // Two DB queries (ListAllNavigationItemsAsync + ListAllTenantsAsync) are too slow
        // to complete reliably inside the static-SSR HTTP-request scope. If the scope
        // disposes mid-flight, the next `services.GetService<>()` inside the handler throws
        // ObjectDisposedException. Loading after the first interactive render keeps the work
        // strictly inside the persistent Circuit scope.
        if (firstRender && hasView && !choicesLoaded)
        {
            await ReloadChoices();
            choicesLoaded = true;  // flip AFTER queries finish so the tree grid renders only then
            StateHasChanged();
        }
    }

    private async Task ReloadChoices()
    {
        if (currentUser is null) return;
        allParents = await Handler.ListAllNavigationItemsAsync(currentUser);
        allTenants = await Handler.ListAllTenantsAsync(currentUser);
    }
}
