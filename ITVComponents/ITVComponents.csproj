<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <Version>5.0.0-PRE182</Version>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <RepositoryUrl>https://github.com/ITVenture/ITVComponents</RepositoryUrl>
    <Authors>mw</Authors>
    <Company>IT-Venture GmbH</Company>
    <Copyright>2020 by IT-Venture GmbH</Copyright>
    <RepositoryType>git</RepositoryType>
    <Description>ITV Core Components Basic classes</Description>
    <PackageProjectUrl>https://github.com/ITVenture/IT-Venture-Core-Libraries</PackageProjectUrl>
    <ApplicationIcon />
    <OutputType>Library</OutputType>
    <LangVersion>9</LangVersion>
    <StartupObject />
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="Settings\XmlSettings.cs" />
    <Compile Remove="Settings\XmlSettingsSection.cs" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="microsoft.extensions.configuration" Version="10.0.10" />
    <PackageReference Include="microsoft.extensions.configuration.binder" Version="10.0.10" />
    <PackageReference Include="microsoft.extensions.configuration.Json" Version="10.0.10" />
    <PackageReference Include="microsoft.extensions.primitives" Version="10.0.10" />
    <!--PackageReference Include="newtonsoft.json" Version="13.0.3" /-->
    <PackageReference Include="system.directoryservices" Version="10.0.10" />
    <PackageReference Include="system.directoryservices.accountmanagement" Version="10.0.10" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.10" />
    <!-- Microsoft.CSharp and System.Security.Principal.Windows removed: in-box on net10.0
         (see dotnet/runtime#54365). -->
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\ITVComponents.Logging\ITVComponents.Logging.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Reference Include="System.DirectoryServices.AccountManagement" />
  </ItemGroup>
  <ItemGroup>
    <Folder Include="PowerShell\" />
  </ItemGroup>
  <Target Name="PostBuild" AfterTargets="PostBuildEvent">
    <!--Exec Command="md &quot;$(solutiondir)bin\$(targetFramework)&quot;&#xD;&#xA;md &quot;$(solutiondir)symbols\$(targetFramework)&quot;&#xD;&#xA;copy &quot;$(TargetPath)&quot; &quot;$(solutiondir)bin\$(targetFramework)\$(targetName).dll&quot;&#xD;&#xA;copy &quot;$(targetDir)$(targetName).deps.json&quot; &quot;$(solutiondir)bin\$(targetFramework)\$(targetName).deps.json&quot;&#xD;&#xA;copy &quot;$(targetDir)$(targetName).pdb&quot; &quot;$(solutiondir)symbols\$(targetFramework)\$(targetName).pdb&quot;" /-->
  </Target>
</Project>