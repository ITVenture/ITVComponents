<EditDialogShell Model="Model" IsCreate="IsCreate" CreateLabel="Add">
    <MudTextField @bind-Value="Model.IncomingClaimName" Label="Incoming claim name" Required="true" />
    <MudTextField @bind-Value="Model.Condition" Label="Condition (optional)" />
    <MudTextField @bind-Value="Model.OutgoingClaimName" Label="Outgoing claim name" Required="true" />
    <MudTextField @bind-Value="Model.OutgoingClaimValue" Label="Outgoing claim value" Required="true" Lines="2" />
    <MudTextField @bind-Value="Model.OutgoingValueType" Label="Outgoing value type" />
    <MudTextField @bind-Value="Model.OutgoingIssuer" Label="Outgoing issuer" />
    <MudTextField @bind-Value="Model.OutgoingOriginalIssuer" Label="Outgoing original issuer" />
</EditDialogShell>

@code {
    [Parameter, EditorRequired] public AuthenticationClaimMappingViewModel Model { get; set; } = default!;
    [Parameter] public bool IsCreate { get; set; }
}
