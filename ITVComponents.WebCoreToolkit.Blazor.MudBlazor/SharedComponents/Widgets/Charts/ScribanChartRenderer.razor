@* Diagramm-Kachel, deren Konfiguration ein Scriban-Template ist, das eine JSON-Deklaration rendert.

   Gerendert wird mit demselben Modell und denselben Funktionen wie eine HTML-Kachel; nur was mit der
   Ausgabe geschieht, ist anders. Kurz bleibt die Deklaration ueber column(...) und json(...):

     { "type": "pie",
       "labels": {{ json (column Rows "Status") }},
       "series": [ { "name": "Anzahl", "data": {{ json (column Rows "Anzahl") }} } ] }

   Wer umformen will, schreibt statt column eine eigene Schleife - genau wie im HTML-Template. *@

@namespace ITVComponents.WebCoreToolkit.Blazor.SharedComponents.Widgets.Charts
@using System.Collections.Generic
@using System.Text.Json
@using Microsoft.AspNetCore.Components
@using ITVComponents.WebCoreToolkit.Blazor.SharedComponents.Widgets
@using Microsoft.Extensions.Logging
@using Scriban
@using Scriban.Runtime
@attribute [WidgetRenderer("chart.scriban", DisplayName = "{\"de\":\"Diagramm (Scriban)\",\"Default\":\"Chart (Scriban)\"}", EditorLanguage = "json")]
@implements IWidgetRenderer
@inject ILogger<ScribanChartRenderer> Logger

<ChartWidgetView Declaration="@declaration"
                 Parameters="@parameters"
                 Errors="@errors"
                 OnAction="@OnAction" />

@code {
    /// <inheritdoc />
    [Parameter] public string TemplateSource { get; set; } = "";

    /// <inheritdoc />
    [Parameter] public WidgetTemplateModel? Data { get; set; }

    /// <inheritdoc />
    /// <remarks>Dieser Renderer hat keine Einstellungen - das Template sagt alles.</remarks>
    [Parameter] public IReadOnlyDictionary<string, string?> Options { get; set; }
        = new Dictionary<string, string?>();

    /// <inheritdoc />
    [Parameter] public EventCallback<WidgetAction> OnAction { get; set; }

    /// <inheritdoc />
    [Parameter] public EventCallback<Exception> OnRenderError { get; set; }

    private ChartWidgetDeclaration? declaration;
    private Dictionary<string, object?> parameters = new();
    private List<string> errors = new();

    private string? lastSource;
    private object? lastData;

    protected override void OnParametersSet()
    {
        // Wie beim HTML-Renderer: das Parameter-Woerterbuch der DynamicComponent ist bei jedem Zeichnen
        // neu, das Template soll aber nur bei geaenderter Quelle neu laufen.
        if (ReferenceEquals(lastSource, TemplateSource) && ReferenceEquals(lastData, Data))
        {
            return;
        }

        lastSource = TemplateSource;
        lastData = Data;
        Render();
    }

    private void Render()
    {
        declaration = null;
        parameters = new Dictionary<string, object?>();
        errors = new List<string>();

        if (string.IsNullOrWhiteSpace(TemplateSource))
        {
            errors.Add("The configuration is empty.");
            return;
        }

        try
        {
            Template template = Template.Parse(TemplateSource);
            if (template.HasErrors)
            {
                errors.AddRange(template.Messages.Select(m => m.ToString()));
                return;
            }

            ScriptObject globals = WidgetTemplateFunctions.CreateGlobals(Data);
            string rendered = template.Render(WidgetTemplateFunctions.CreateContext(globals));

            IDictionary<string, object?>? map = ChartJson.ToMap(rendered, errors);
            if (map == null)
            {
                return;
            }

            declaration = ChartWidgetDeclaration.FromMap(map, errors);
            if (declaration != null)
            {
                parameters = ChartParameterBinder.Bind(declaration.Extra, typeof(MudChart<double>), errors);
            }
        }
        catch (Exception ex)
        {
            errors.Add(ex.Message);
            Logger.LogError(ex,
                "Die Scriban-Diagramm-Konfiguration konnte nicht gerendert werden. Text: {Configuration}",
                TemplateSource);
            if (OnRenderError.HasDelegate)
            {
                _ = OnRenderError.InvokeAsync(ex);
            }
        }
    }

    /// <summary>
    /// Lists the pass-through parameters of the chart component - for the editor's "insert parameters"
    /// button. Was hier steht, kommt aus der Komponente selbst und ist damit immer der Stand der
    /// eingesetzten Fassung; die Beispiele dazu stehen in der Hilfe.
    /// </summary>
    public static string DescribeParameters()
        => ChartParameterBinder.Describe(typeof(MudChart<double>), asJson: true);

    /// <summary>
    /// Checks a configuration when the widget is saved - <b>syntactically</b>.
    /// </summary>
    /// <remarks>
    /// Nur das Template wird uebersetzt, nicht gerendert. Ein Rendern ohne Daten beanstandete sonst
    /// Templates, die erst MIT Zeilen gueltiges JSON ergeben - und liess sie nicht mehr speichern. Ob die
    /// Deklaration am Ende lesbar ist und ob ihre Parameter existieren, zeigt die Kachel zur Laufzeit;
    /// dort steht die Meldung und dort entsteht der Log-Eintrag.
    /// </remarks>
    public static string? Validate(string? configuration, IReadOnlyDictionary<string, string?> options)
    {
        if (string.IsNullOrWhiteSpace(configuration))
        {
            return "The configuration is empty.";
        }

        try
        {
            Template template = Template.Parse(configuration);
            return template.HasErrors
                ? string.Join(" ", template.Messages.Select(m => m.ToString()))
                : null;
        }
        catch (Exception ex)
        {
            return ex.Message;
        }
    }

}
