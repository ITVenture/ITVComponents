@using Microsoft.AspNetCore.Components.Authorization
@using ITVComponents.WebCoreToolkit.Models

@inject IUserAdminHandler Handler
@inject AuthenticationStateProvider AuthState
@inject IDialogService DialogService
@inject ISnackbar Snackbar

<SecureView RequiredPermissions="Users.Properties.View,Users.Properties.Write">
    <Permitted>
    <MudDataGrid T="CustomUserPropertyViewModel"
                 @ref="grid"
                 ServerData="LoadData"
                 SortMode="SortMode.Single"
                 RowsPerPage="10"
                 Hover="true"
                 Dense="true">
        <ToolBarContent>
            <CrudGridToolbar OnRefresh="ReloadGrid" Title="Properties" TitleTypo="Typo.subtitle2">
                <SecureView RequiredPermissions="Users.Properties.Write">
                    <Permitted>
                    <MudButton StartIcon="@Icons.Material.Filled.Add" Variant="Variant.Outlined" Size="Size.Small" OnClick="OpenCreate">
                        Add property
                    </MudButton>
                    </Permitted>
                </SecureView>
            </CrudGridToolbar>
        </ToolBarContent>
        <Columns>
            <PropertyColumn Property="x => x.PropertyName" Title="Name" />
            <PropertyColumn Property="x => x.Value" Title="Value" />
            <PropertyColumn Property="x => x.PropertyType" Title="Type" />
            <TemplateColumn T="CustomUserPropertyViewModel" Title="" Sortable="false">
                <CellTemplate>
                    <SecureView RequiredPermissions="Users.Properties.Write">
                        <Permitted>
                        <MudStack Row="true" Spacing="1">
                            <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" OnClick="@(() => OpenEdit(context.Item))" />
                            <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error" OnClick="@(() => Delete(context.Item))" />
                        </MudStack>
                        </Permitted>
                    </SecureView>
                </CellTemplate>
            </TemplateColumn>
        </Columns>
        <PagerContent>
            <MudDataGridPager T="CustomUserPropertyViewModel" />
        </PagerContent>
    </MudDataGrid>
    </Permitted>
    <NotPermitted>
        <MudAlert Severity="Severity.Info">No permission to view properties.</MudAlert>
    </NotPermitted>
</SecureView>

@code {
    [Parameter, EditorRequired] public string UserId { get; set; } = "";
    [Parameter] public bool CanView { get; set; }
    [Parameter] public bool CanWrite { get; set; }

    private MudDataGrid<CustomUserPropertyViewModel>? grid;
    private System.Security.Claims.ClaimsPrincipal? currentUser;

    protected override async Task OnInitializedAsync()
    {
        var auth = await AuthState.GetAuthenticationStateAsync();
        currentUser = auth.User;
    }

    private async Task<GridData<CustomUserPropertyViewModel>> LoadData(GridState<CustomUserPropertyViewModel> state, CancellationToken ct)
    {
        if (currentUser is null || !CanView)
            return new GridData<CustomUserPropertyViewModel> { Items = Array.Empty<CustomUserPropertyViewModel>(), TotalItems = 0 };

        var sort = state.SortDefinitions.FirstOrDefault();
        var query = new UserListQuery
        {
            Page = state.Page,
            PageSize = state.PageSize,
            SortColumn = sort?.SortBy,
            SortDescending = sort?.Descending ?? false
        };
        var result = await Handler.ListPropertiesAsync(currentUser, UserId, query);
        return new GridData<CustomUserPropertyViewModel> { Items = result.Items, TotalItems = result.TotalCount };
    }

    private async Task OpenCreate()
    {
        var parameters = new DialogParameters<UserPropertyDialog>
        {
            { d => d.Model, new CustomUserPropertyViewModel() },
            { d => d.IsCreate, true }
        };
        var dlg = await DialogService.ShowAsync<UserPropertyDialog>("Add property", parameters, EditDialogDefaults.Edit);
        var result = await dlg.Result;
        if (result is { Canceled: false, Data: CustomUserPropertyViewModel input })
        {
            var created = await Handler.CreatePropertyAsync(currentUser!, UserId, input);
            if (created != null) { Snackbar.Add("Property added", Severity.Success); await ReloadGrid(); }
            else Snackbar.Add("Failed to add", Severity.Error);
        }
    }

    private async Task OpenEdit(CustomUserPropertyViewModel item)
    {
        var copy = new CustomUserPropertyViewModel
        {
            CustomUserPropertyId = item.CustomUserPropertyId,
            PropertyName = item.PropertyName,
            Value = item.Value,
            PropertyType = item.PropertyType
        };
        var parameters = new DialogParameters<UserPropertyDialog>
        {
            { d => d.Model, copy },
            { d => d.IsCreate, false }
        };
        var dlg = await DialogService.ShowAsync<UserPropertyDialog>("Edit property", parameters, EditDialogDefaults.Edit);
        var result = await dlg.Result;
        if (result is { Canceled: false, Data: CustomUserPropertyViewModel input })
        {
            var updated = await Handler.UpdatePropertyAsync(currentUser!, input);
            if (updated != null) { Snackbar.Add("Property updated", Severity.Success); await ReloadGrid(); }
            else Snackbar.Add("Failed to update", Severity.Error);
        }
    }

    private async Task Delete(CustomUserPropertyViewModel item)
    {
        var ok = await DialogService.ShowMessageBoxAsync(
            "Delete property",
            $"Really delete '{item.PropertyName}'?",
            yesText: "Delete", cancelText: "Cancel");
        if (ok != true) return;

        var success = await Handler.DeletePropertyAsync(currentUser!, item.CustomUserPropertyId);
        if (success) { Snackbar.Add("Property deleted", Severity.Success); await ReloadGrid(); }
        else Snackbar.Add("Failed to delete", Severity.Error);
    }

    private async Task ReloadGrid()
    {
        if (grid is not null) await grid.ReloadServerData();
    }
}
