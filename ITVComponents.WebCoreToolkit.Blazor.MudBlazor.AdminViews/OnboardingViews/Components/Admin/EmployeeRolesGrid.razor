@using Microsoft.AspNetCore.Components.Authorization

@inject IOnboardingAdminHandler Handler
@inject AuthenticationStateProvider AuthState
@inject ISnackbar Snackbar
@inject IStringLocalizer<OnboardingMessages> L

<MudDataGrid T="EmployeeRoleAssignmentViewModel" Items="roles" SortMode="SortMode.None" Dense="true" Hover="true">
    <ToolBarContent>
        <RefreshButton OnClick="Reload" />
        <MudText Typo="Typo.subtitle2">@L["OnbAdm_Roles_Title"]</MudText>
        <MudSpacer />
    </ToolBarContent>
    <Columns>
        <TemplateColumn T="EmployeeRoleAssignmentViewModel" Title="" Sortable="false">
            <CellTemplate>
                <SecureView RequiredPermissions="Onboarding.Admin.Employees.Write">
                    <Permitted>
                        <MudCheckBox T="bool" Value="context.Item.Assigned" ValueChanged="@(v => Toggle(context.Item, v))" />
                    </Permitted>
                    <NotPermitted>
                        <MudCheckBox T="bool" Value="context.Item.Assigned" Disabled="true" />
                    </NotPermitted>
                </SecureView>
            </CellTemplate>
        </TemplateColumn>
        <PropertyColumn Property="x => x.RoleName" Title="@L["OnbAdm_Roles_Col"]" />
    </Columns>
</MudDataGrid>

@code {
    [Parameter, EditorRequired] public int EmployeeId { get; set; }

    private System.Security.Claims.ClaimsPrincipal? currentUser;
    private EmployeeRoleAssignmentViewModel[] roles = Array.Empty<EmployeeRoleAssignmentViewModel>();

    protected override async Task OnInitializedAsync()
    {
        var auth = await AuthState.GetAuthenticationStateAsync();
        currentUser = auth.User;
        await Reload();
    }

    private async Task Reload()
    {
        if (currentUser is null)
        {
            return;
        }

        roles = await Handler.ListEmployeeRolesAsync(currentUser, EmployeeId);
    }

    private async Task Toggle(EmployeeRoleAssignmentViewModel item, bool newValue)
    {
        if (currentUser is null) return;
        var ok = await Handler.SetEmployeeRoleAsync(currentUser, EmployeeId, item.RoleId, newValue);
        if (ok)
        {
            item.Assigned = newValue;
            Snackbar.Add(L["OnbAdm_Role_Updated"], Severity.Success);
        }
        else
        {
            Snackbar.Add(L["OnbAdm_Role_Failed"], Severity.Error);
            await Reload();
        }
    }
}
