@page "/Account/Manage/ExternalLogins"
@rendermode @(RenderMode.InteractiveServer)

@layout ManageLayout
@attribute [Microsoft.AspNetCore.Authorization.Authorize]

@using Microsoft.AspNetCore.Authentication
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Hosting
@using Microsoft.AspNetCore.Identity
@using Microsoft.Extensions.Localization
@using ITVComponents.WebCoreToolkit.Blazor.MudBlazor.IdentityPages.Components.Account.Shared
@using ITVComponents.WebCoreToolkit.Options
@using ITVComponents.WebCoreToolkit.IdentityShared.Areas.Identity
@using ITVComponents.WebCoreToolkit.IdentityShared.Areas.Identity.Pages.Account.Manage
@using ITVComponents.WebCoreToolkit.IdentityShared.PageHandlers.Identity.Account.Manage

@inject IPageHandlerProvider<ExternalLoginsModel, IExternalLoginsHandler> HandlerProvider
@inject AuthenticationStateProvider AuthState
@inject IStringLocalizer<IdentityMessages> L
@inject IWebHostEnvironment HostingEnvironment
@inject NavigationManager Nav

<PageTitle>@L["Manage your external logins"]</PageTitle>

<MudText Typo="Typo.h5" GutterBottom="true">@L["Manage your external logins"]</MudText>

@if (!HandlerProvider.Handler.UsePage)
{
    <MudAlert Severity="Severity.Info">@L["This page is not available."]</MudAlert>
}
else if (loading)
{
    <MudProgressCircular Indeterminate="true" />
}
else if (notFound)
{
    <MudAlert Severity="Severity.Error">@notFoundMessage</MudAlert>
}
else
{
    @if (!string.IsNullOrEmpty(StatusMessage))
    {
        <MudAlert Severity="Severity.Info" Class="mb-3">@StatusMessage</MudAlert>
    }

    @if (currentLogins is { Count: > 0 })
    {
        <MudText Typo="Typo.h6" Class="mt-3" GutterBottom="true">@L["Registered Logins"]</MudText>
        <MudTable Items="currentLogins" Hover="true" Dense="true" Class="mb-3" Context="login" Breakpoint="Breakpoint.Sm">
            <RowTemplate>
                <MudTd DataLabel="@L["Provider"]">@login.ProviderDisplayName</MudTd>
                <MudTd DataLabel="" Style="width: 1%; white-space: nowrap;">
                    @if (showRemoveButton)
                    {
                        <MudButton Variant="Variant.Outlined"
                                   Color="Color.Error"
                                   Size="Size.Small"
                                   Disabled="@busy"
                                   title="@L["Remove this {0} login from your account", login.ProviderDisplayName ?? string.Empty]"
                                   OnClick="@(() => OnRemoveAsync(login.LoginProvider, login.ProviderKey))">
                            @L["Remove"]
                        </MudButton>
                    }
                </MudTd>
            </RowTemplate>
        </MudTable>
    }

    @if (otherLogins is { Length: > 0 })
    {
        <MudText Typo="Typo.h6" Class="mt-3" GutterBottom="true">@L["Add another service to log in."]</MudText>
        <MudDivider Class="mb-3" />

        @* Kein Formular mehr: das Verknuepfen ist eine echte Umleitung zum Anbieter und laeuft ueber den
           Endpunkt /Account/Manage/LinkLogin. Ein Klick fuehrt darum bewusst aus dem Circuit heraus. *@
        <MudStack Row="true" Spacing="2" Wrap="Wrap.Wrap">
            @foreach (var provider in otherLogins)
            {
                var logoExists = HostingEnvironment.WebRootFileProvider.GetFileInfo(provider.LogoFile).Exists;
                var title = L["Log in using your {0} account", provider.DisplayName].Value;
                var scheme = provider.AuthenticationSchemeName;
                <MudButton Variant="Variant.Filled"
                           Color="Color.Primary"
                           Disabled="@busy"
                           title="@title"
                           OnClick="@(() => OnLinkAsync(scheme))"
                           Style="@(logoExists
                               ? $"background-image: url('{provider.LogoFile}'); width: {provider.ImageWidth + 5}px; height: {provider.ImageHeight + 5}px; background-position: center; background-repeat: no-repeat; background-size: {provider.ImageWidth}px auto;"
                               : null)">
                    @if (!logoExists)
                    {
                        @provider.DisplayName
                    }
                </MudButton>
            }
        </MudStack>
    }
}

@code {
    private bool loading = true;
    private bool notFound;
    private string? notFoundMessage;
    private bool busy;
    private IList<UserLoginInfo>? currentLogins;
    private AuthenticationHandlerDefinition[]? otherLogins;
    private bool showRemoveButton;

    [SupplyParameterFromQuery(Name = "status")]
    private string? StatusMessage { get; set; }

    protected override async Task OnInitializedAsync()
    {
        if (!HandlerProvider.Handler.UsePage)
        {
            loading = false;
            return;
        }

        await LoadConfigurationAsync();
        loading = false;
    }

    private async Task LoadConfigurationAsync()
    {
        var principal = (await AuthState.GetAuthenticationStateAsync()).User;
        var user = await HandlerProvider.Handler.FetchUser(principal);
        try
        {
            if (!user.UserExists)
            {
                notFound = true;
                notFoundMessage = L["Unable to load user with ID '{0}'.", HandlerProvider.Handler.GetUserId(principal)];
                return;
            }

            var cfg = await HandlerProvider.Handler.GetUserExternalLoginConfiguration(user);
            currentLogins = cfg.ExternalUserLogins;
            otherLogins = cfg.AvailableLogins;
            showRemoveButton = user.HasPassword || (currentLogins?.Count ?? 0) > 1;
        }
        finally
        {
            HandlerProvider.Handler.ReleaseUser(user);
        }
    }

    private async Task OnRemoveAsync(string loginProvider, string providerKey)
    {
        busy = true;
        var principal = (await AuthState.GetAuthenticationStateAsync()).User;
        var user = await HandlerProvider.Handler.FetchUser(principal);
        try
        {
            if (!user.UserExists)
            {
                notFound = true;
                notFoundMessage = L["Unable to load user with ID '{0}'.", HandlerProvider.Handler.GetUserId(principal)];
                return;
            }

            // refreshSignIn: false — das Cookie stellt der Ruecksprung aus, der Handler koennte es auf dem
            // Circuit nicht. Eine entfernte Anmeldung aendert den Security-Stamp.
            var result = await HandlerProvider.Handler.RemoveExternalAuthentication(
                user, loginProvider, providerKey, refreshSignIn: false);
            var message = result.Success
                ? L["The external login was removed."].Value
                : L["The external login was not removed."].Value;
            ManageRedirects.RefreshSignIn(Nav, "Account/Manage/ExternalLogins", message);
        }
        finally
        {
            HandlerProvider.Handler.ReleaseUser(user);
            busy = false;
        }
    }

    private void OnLinkAsync(string provider)
    {
        if (string.IsNullOrEmpty(provider))
        {
            return;
        }

        busy = true;
        Nav.NavigateTo($"Account/Manage/LinkLogin?provider={Uri.EscapeDataString(provider)}", forceLoad: true);
    }
}
