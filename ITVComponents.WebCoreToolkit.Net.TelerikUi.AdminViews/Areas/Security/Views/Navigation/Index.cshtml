@using ITVComponents.WebCoreToolkit.Net.Extensions
@using ITVComponents.WebCoreToolkit.Net.TelerikUi.AdminViews.Extensions
@using ITVComponents.WebCoreToolkit.Net.TelerikUi.AdminViews.Options
@using ITVComponents.WebCoreToolkit.Net.TelerikUi.AdminViews.Resources
@using ITVComponents.WebCoreToolkit.Net.TelerikUi.AdminViews.TenantSecurityViews.Options
@using ITVComponents.WebCoreToolkit.Net.TelerikUi.AdminViews.ViewComponents
@using Microsoft.Extensions.Options
@using TextsAndMessagesHelper = ITVComponents.WebCoreToolkit.Net.TelerikUi.AdminViews.TenantSecurityViews.Resources.TextsAndMessagesHelper
@inject IOptions<SecurityViewsOptions> options
@inject IOptions<ViewOptions> viewOptions
@{
    Layout = viewOptions.Value.LayoutPage;
}
@{

    ViewBag.Title =TextsAndMessagesHelper.IWCN_Titles_Navigation;
}
<script src="@("/_content/ITVComponents.WebCoreToolkit.Net.TelerikUi.AdminViews/js/viewScripts.min.js".ExtendUrlWithVersion())"></script>

    @await Component.InvokeAsync(typeof(ShowTable), new { customViewData = new Dictionary<string, object> { { "parentId", null }, { "Permissions", ViewData["Permissions"] } } })

@if (options.Value.TenantLinkMode == LinkMode.MultiSelect)
{
    @Html.DetailViewScript("NavDetails", "Nav#=NavigationMenuId#", "~/Security/Navigation/NavTable?parentId=#=NavigationMenuId#")
}
else
{
    @Html.DetailViewScript("NavDetails", "Nav#=NavigationMenuId#", "~/Security/Navigation/NavDetailTabs?parentId=#=NavigationMenuId#")
}