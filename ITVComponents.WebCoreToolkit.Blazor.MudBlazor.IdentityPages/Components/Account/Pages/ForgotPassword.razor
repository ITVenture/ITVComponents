@page "/Account/ForgotPassword"
@attribute [Microsoft.AspNetCore.Components.ExcludeFromInteractiveRouting]

@using System.ComponentModel.DataAnnotations
@using System.Text
@using System.Text.Encodings.Web
@using Microsoft.AspNetCore.Identity.UI.Services
@using Microsoft.AspNetCore.WebUtilities
@using Microsoft.Extensions.Localization
@using ITVComponents.WebCoreToolkit.IdentityShared.Areas.Identity
@using ITVComponents.WebCoreToolkit.IdentityShared.Areas.Identity.Pages.Account

@inject IPageHandlerProvider<ForgotPasswordModel, IForgotPasswordHandler> HandlerProvider
@inject IEmailSender EmailSender
@inject IStringLocalizer<IdentityMessages> L
@inject NavigationManager Nav

<PageTitle>@L["Forgot your password?"]</PageTitle>

<MudContainer MaxWidth="MaxWidth.Small" Class="mt-8">
    <MudPaper Elevation="2" Class="pa-6">
        <MudText Typo="Typo.h4" GutterBottom="true">@L["Forgot your password?"]</MudText>

        @if (!HandlerProvider.Handler.UsePage)
        {
            <MudAlert Severity="Severity.Info">@L["This page is not available."]</MudAlert>
        }
        else
        {
            <MudText Typo="Typo.subtitle1" GutterBottom="true">@L["Enter your email."]</MudText>
            <MudDivider Class="my-3" />

            <EditForm Model="Input" method="post" OnValidSubmit="OnSubmit" FormName="forgot-password">
                <ToolkitDataAnnotationsValidator />

                <div class="form-floating mb-3">
                    <InputText @bind-Value="Input.Email" id="Input.Email" class="form-control" autocomplete="username" type="email" />
                    <label for="Input.Email">@L["Email"]</label>
                    <ValidationMessage For="() => Input.Email" class="text-danger" />
                </div>

                <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary">
                    @L["PwdReset_Submit"]
                </MudButton>
            </EditForm>
        }
    </MudPaper>
</MudContainer>

@code {
    [SupplyParameterFromForm]
    private InputModel Input { get; set; } = new();

    private async Task OnSubmit()
    {
        if (!HandlerProvider.Handler.UsePage)
        {
            return;
        }

        var user = await HandlerProvider.Handler.FetchUser(Input.Email);
        try
        {
            if (!user.UserExists || !user.EmailConfirmed)
            {
                Nav.NavigateTo("Account/ForgotPasswordConfirmation", forceLoad: true);
                return;
            }

            var code = await HandlerProvider.Handler.GeneratePasswordResetToken(user);
            if (!string.IsNullOrEmpty(code))
            {
                code = WebEncoders.Base64UrlEncode(Encoding.UTF8.GetBytes(code));
                var callbackUrl = Nav.ToAbsoluteUri(
                    Nav.GetUriWithQueryParameters("Account/ResetPassword",
                        new Dictionary<string, object?> { ["code"] = code })).ToString();

                await EmailSender.SendEmailAsync(
                    Input.Email,
                    L["Reset Password"],
                    L["ResetPasswordMailBody", HtmlEncoder.Default.Encode(callbackUrl)]);

                Nav.NavigateTo("Account/ForgotPasswordConfirmation", forceLoad: true);
            }
        }
        finally
        {
            HandlerProvider.Handler.ReleaseUser(user);
        }
    }

    public sealed class InputModel
    {
        [Required]
        [EmailAddress(ErrorMessage = "ITV:DataTypeAttribute.EmailAddress_ValidationError")]
        public string Email { get; set; } = "";
    }
}
