@page "/Security/AssetTemplates"
@rendermode @(RenderMode.InteractiveServer)
@attribute [Microsoft.AspNetCore.Authorization.Authorize]

@using Microsoft.AspNetCore.Components.Authorization

@inject IAssetTemplateAdminHandler Handler
@inject AuthenticationStateProvider AuthState
@inject IDialogService DialogService
@inject ISnackbar Snackbar

<PageTitle>Asset templates</PageTitle>

<MudText Typo="Typo.h5" GutterBottom="true">Asset templates</MudText>

<SecureView RequiredPermissions="Sysadmin">
    <Permitted>
@if (currentUser is null)
{
    <MudProgressCircular Indeterminate="true" />
}
else
{
    <MudDataGrid T="AssetTemplateViewModel"
                 @ref="grid"
                 ServerData="LoadData"
                 SortMode="SortMode.Single"
                 RowsPerPage="25"
                 Hover="true"
                 Dense="true">
        <ToolBarContent>
            <RefreshButton OnClick="ReloadGrid" />
            <MudText Typo="Typo.h6">Asset templates</MudText>
            <MudSpacer />
            <MudTextField @bind-Value="search"
                          Placeholder="Search…"
                          Adornment="Adornment.Start"
                          AdornmentIcon="@Icons.Material.Filled.Search"
                          IconSize="Size.Medium"
                          Class="mt-0"
                          DebounceInterval="300"
                          OnDebounceIntervalElapsed="ReloadGrid" />
            <MudButton StartIcon="@Icons.Material.Filled.Add" Variant="Variant.Filled" Color="Color.Primary" Class="ml-2" OnClick="OpenCreate">
                Add template
            </MudButton>
        </ToolBarContent>
        <Columns>
            <HierarchyColumn T="AssetTemplateViewModel" />
            <PropertyColumn Property="x => x.SystemKey" Title="System key" />
            <PropertyColumn Property="x => x.Name" Title="Name" />
            <TemplateColumn T="AssetTemplateViewModel" Title="" Sortable="false">
                <CellTemplate>
                    <MudStack Row="true" Spacing="1">
                        <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" OnClick="@(() => OpenEdit(context.Item))" />
                        <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error" OnClick="@(() => Delete(context.Item))" />
                    </MudStack>
                </CellTemplate>
            </TemplateColumn>
        </Columns>
        <ChildRowContent>
            <MudPaper Elevation="0" Class="pa-2">
                <MudTabs Elevation="0" Rounded="true">
                    <MudTabPanel Text="Paths">
                        <AssetTemplatePathsGrid AssetTemplateId="@context.Item.AssetTemplateId" CanWrite="@isSysAdmin" />
                    </MudTabPanel>
                    <MudTabPanel Text="Permissions">
                        <AssetTemplatePermissionsGrid AssetTemplateId="@context.Item.AssetTemplateId" CanWrite="@isSysAdmin" />
                    </MudTabPanel>
                    <MudTabPanel Text="Features">
                        <AssetTemplateFeaturesGrid AssetTemplateId="@context.Item.AssetTemplateId" CanWrite="@isSysAdmin" />
                    </MudTabPanel>
                </MudTabs>
            </MudPaper>
        </ChildRowContent>
        <PagerContent>
            <MudDataGridPager T="AssetTemplateViewModel" />
        </PagerContent>
    </MudDataGrid>
}
    </Permitted>
    <NotPermitted>
        <MudAlert Severity="Severity.Warning">Sysadmin access required.</MudAlert>
    </NotPermitted>
</SecureView>

@code {
    private MudDataGrid<AssetTemplateViewModel>? grid;
    private System.Security.Claims.ClaimsPrincipal? currentUser;
    private bool isSysAdmin;
    private string? search;

    protected override async Task OnInitializedAsync()
    {
        var auth = await AuthState.GetAuthenticationStateAsync();
        currentUser = auth.User;
        isSysAdmin = Handler.HasPermission(currentUser, "Sysadmin");
    }

    private async Task<GridData<AssetTemplateViewModel>> LoadData(GridState<AssetTemplateViewModel> state, CancellationToken ct)
    {
        if (currentUser is null) return new GridData<AssetTemplateViewModel> { Items = Array.Empty<AssetTemplateViewModel>(), TotalItems = 0 };
        var sort = state.SortDefinitions.FirstOrDefault();
        var query = new ListQuery
        {
            Page = state.Page,
            PageSize = state.PageSize,
            SortColumn = sort?.SortBy,
            SortDescending = sort?.Descending ?? false,
            Search = search
        };
        var result = await Handler.ListAsync(currentUser, query);
        return new GridData<AssetTemplateViewModel> { Items = result.Items, TotalItems = result.TotalCount };
    }

    private async Task ReloadGrid()
    {
        if (grid is not null) await grid.ReloadServerData();
    }

    private async Task OpenCreate()
    {
        var parameters = new DialogParameters<AssetTemplateDialog> { { d => d.Model, new AssetTemplateViewModel() }, { d => d.IsCreate, true } };
        var dlg = await DialogService.ShowAsync<AssetTemplateDialog>("Create asset template", parameters, EditDialogDefaults.Edit);
        var result = await dlg.Result;
        if (result is { Canceled: false, Data: AssetTemplateViewModel input })
        {
            var created = await Handler.CreateAsync(currentUser!, input);
            if (created != null) { Snackbar.Add("Asset template created", Severity.Success); await ReloadGrid(); }
            else Snackbar.Add("Failed to create", Severity.Error);
        }
    }

    private async Task OpenEdit(AssetTemplateViewModel item)
    {
        var copy = new AssetTemplateViewModel
        {
            AssetTemplateId = item.AssetTemplateId,
            Name = item.Name,
            SystemKey = item.SystemKey,
            FeatureId = item.FeatureId,
            PermissionId = item.PermissionId
        };
        var parameters = new DialogParameters<AssetTemplateDialog> { { d => d.Model, copy }, { d => d.IsCreate, false } };
        var dlg = await DialogService.ShowAsync<AssetTemplateDialog>("Edit asset template", parameters, EditDialogDefaults.Edit);
        var result = await dlg.Result;
        if (result is { Canceled: false, Data: AssetTemplateViewModel input })
        {
            var updated = await Handler.UpdateAsync(currentUser!, input);
            if (updated != null) { Snackbar.Add("Asset template updated", Severity.Success); await ReloadGrid(); }
            else Snackbar.Add("Failed to update", Severity.Error);
        }
    }

    private async Task Delete(AssetTemplateViewModel item)
    {
        var ok = await DialogService.ShowMessageBoxAsync("Delete asset template", $"Really delete '{item.SystemKey}'?", yesText: "Delete", cancelText: "Cancel");
        if (ok != true) return;
        var success = await Handler.DeleteAsync(currentUser!, item.AssetTemplateId);
        if (success) { Snackbar.Add("Asset template deleted", Severity.Success); await ReloadGrid(); }
        else Snackbar.Add("Failed to delete", Severity.Error);
    }
}
