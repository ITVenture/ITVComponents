@using System.Globalization
@using System.Text
@using System.Net
@using ITVComponents.Helpers
@using ITVComponents.Logging
@using ITVComponents.Workflow.Model
@implements IDisposable
@inject IJSRuntime JS

@*
    Zeichnet eine WorkflowDefinition als statisches, theme-faehiges SVG (read-only). Genutzt vom
    Definition-Viewer und - mit hervorgehobenen Token-Positionen - vom Monitoring-Detail.
    Zahlen werden invariant formatiert (SVG verlangt '.' als Dezimaltrenner). Der Zeichenkoerper wird
    als MarkupString erzeugt, weil Razor das SVG-<text>-Element sonst als eigenes Steuer-Tag deutet.
*@

@if (Definition is null)
{
    <MudText Typo="Typo.body2">No definition.</MudText>
}
else
{
    <div @ref="hostEl"
         style="overflow:auto; width:100%; border:1px solid var(--mud-palette-lines-default); border-radius:6px;">
        <svg width="@N(layout.Width)" height="@N(layout.Height)"
             viewBox="0 0 @N(layout.Width) @N(layout.Height)"
             style="display:block; min-width:100%; font-family:var(--mud-typography-body1-family, sans-serif);">
            <defs>
                <marker id="wf-arrow" markerWidth="10" markerHeight="8" refX="8" refY="4" orient="auto">
                    <path d="M0,0 L8,4 L0,8 z" fill="var(--mud-palette-lines-default)" />
                </marker>
                @* Fehlerpfad, gleiche Lesart wie im Editor. *@
                <marker id="wf-arrow-error" markerWidth="10" markerHeight="8" refX="8" refY="4" orient="auto">
                    <path d="M0,0 L8,4 L0,8 z" fill="var(--mud-palette-error)" />
                </marker>
            </defs>
            @Body()
        </svg>
    </div>
}

@code {
    /// <summary>Die zu zeichnende Definition.</summary>
    [Parameter] public WorkflowDefinition? Definition { get; set; }

    /// <summary>Optional hervorzuhebende Knoten (z.B. aktuelle Token-Positionen).</summary>
    [Parameter] public IReadOnlyCollection<string>? HighlightedNodeIds { get; set; }

    /// <summary>
    /// Optional als FEHLERSTELLE zu markierende Knoten. Sie gewinnen gegen
    /// <see cref="HighlightedNodeIds"/> - ein gescheiterter Schritt ist die wichtigere Aussage als
    /// "hier steht ein Token".
    /// </summary>
    [Parameter] public IReadOnlyCollection<string>? FaultedNodeIds { get; set; }

    /// <summary>
    /// Doppelklick auf einen Knoten (liefert dessen Id). Nur wenn gesetzt, wird ueberhaupt JS angehaengt -
    /// die reine Anzeige bleibt ohne Interop.
    /// </summary>
    [Parameter] public EventCallback<string> OnNodeActivated { get; set; }

    /// <summary>Einfacher Klick auf einen Knoten (liefert dessen Id).</summary>
    [Parameter] public EventCallback<string> OnNodeSelected { get; set; }

    private GraphLayout layout = GraphLayout.Compute(new WorkflowDefinition());
    private ElementReference hostEl;
    private DotNetObjectReference<WorkflowGraph>? selfRef;
    private bool jsAttached;

    private bool Interactive => OnNodeActivated.HasDelegate || OnNodeSelected.HasDelegate;

    protected override void OnParametersSet()
    {
        if (Definition is not null)
        {
            layout = GraphLayout.Compute(Definition, HighlightedNodeIds);
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // Nur EINMAL anhaengen: der Listener sitzt am Container, der ueber alle Renders derselbe bleibt.
        if (jsAttached || !Interactive || Definition is null)
        {
            return;
        }

        jsAttached = true;
        selfRef ??= DotNetObjectReference.Create(this);
        try
        {
            await JS.InvokeAsync<IJSObjectReference>("import",
                "./_content/ITVComponents.WebCoreToolkit.Blazor.MudBlazor.WorkflowViews/workflow-graph.js");
            await JS.InvokeVoidAsync("itvWfGraph.attach", hostEl, selfRef);
        }
        catch (Microsoft.JSInterop.JSDisconnectedException ex)
        {
            // Erwarteter Normalfall (Dialog geschlossen, Circuit weg) - nur als Spur.
            jsAttached = false;
            LogEnvironment.LogEvent(
                $"WorkflowGraph: Circuit vor dem Anhaengen des JS-Interop beendet: {ex.Message}",
                LogSeverity.Report);
        }
        catch (Exception ex)
        {
            // Ohne JS bleibt der Graph als Anzeige nutzbar - nur eben nicht anklickbar. Der Grund
            // muss ins Log, sonst sucht jemand den Fehler in der Maske.
            jsAttached = false;
            LogEnvironment.LogEvent(
                $"WorkflowGraph: JS-Interop nicht initialisiert - Knoten sind nicht anklickbar: " +
                $"{ex.OutlineException()}", LogSeverity.Warning);
        }
    }

    @* Der JS-Name ist explizit gesetzt: die Methode kann nicht heissen wie der gleichnamige Parameter. *@
    /// <summary>Vom JS-Modul gerufen: Doppelklick auf einen Knoten.</summary>
    [JSInvokable("OnNodeActivated")]
    public Task OnNodeActivatedFromJs(string nodeId) => OnNodeActivated.InvokeAsync(nodeId);

    /// <summary>Vom JS-Modul gerufen: einfacher Klick auf einen Knoten.</summary>
    [JSInvokable("OnNodeSelected")]
    public Task OnNodeSelectedFromJs(string nodeId) => OnNodeSelected.InvokeAsync(nodeId);

    public void Dispose() => selfRef?.Dispose();

    private MarkupString Body()
    {
        var sb = new StringBuilder();

        HashSet<string> errorFlowIds = ErrorFlowIds();

        // Abschnitts-Rahmen ganz zuerst - sie liegen hinter allem, was sie umschliessen (SVG zeichnet in
        // Dokumentreihenfolge).
        foreach (var frame in layout.Nodes.Where(n => n.IsContainer))
        {
            sb.Append($"<rect x=\"{N(frame.X)}\" y=\"{N(frame.Y)}\" width=\"{N(frame.Width)}\" ")
              .Append($"height=\"{N(frame.Height)}\" rx=\"10\" ry=\"10\" fill=\"none\" ")
              .Append("stroke=\"var(--mud-palette-lines-default)\" stroke-width=\"1.5\" stroke-dasharray=\"6 4\" />")
              .Append($"<rect x=\"{N(frame.X)}\" y=\"{N(frame.Y)}\" width=\"{N(frame.Width)}\" ")
              .Append($"height=\"{N(GraphLayout.ContainerHeader)}\" rx=\"10\" ry=\"10\" ")
              .Append("fill=\"var(--mud-palette-background-grey)\" opacity=\"0.65\" />");
            Text(sb, frame.X + 10, frame.Y + GraphLayout.ContainerHeader - 8, "start",
                "var(--mud-palette-text-secondary)", 11, frame.Label, null);
        }

        foreach (var edge in layout.Edges)
        {
            bool err = errorFlowIds.Contains(edge.Id);
            string stroke = err ? "var(--mud-palette-error)" : "var(--mud-palette-lines-default)";
            string marker = err ? "wf-arrow-error" : "wf-arrow";
            sb.Append($"<path d=\"{edge.PathData}\" fill=\"none\" stroke-linejoin=\"round\" ")
              .Append($"stroke=\"{stroke}\" stroke-width=\"1.5\" marker-end=\"url(#{marker})\" />");
            if (!string.IsNullOrEmpty(edge.Label))
            {
                Text(sb, edge.LabelX, edge.LabelY - 4, "middle", "var(--mud-palette-text-secondary)", 11, edge.Label!, null);
            }
        }

        foreach (var node in layout.Nodes)
        {
            if (node.IsContainer)
            {
                continue; // Schon als Rahmen gezeichnet.
            }

            // Eine Gruppe je Knoten: sie traegt die Id, ueber die das JS-Modul den Klick zuordnet (per
            // Delegation ueber closest - deshalb genuegt EIN Listener am Container).
            sb.Append($"<g data-wf-node=\"{WebUtility.HtmlEncode(node.Id)}\">");

            // Eine Fehlerstelle gewinnt gegen die blosse Token-Hervorhebung: dass hier etwas gescheitert
            // ist, ist die wichtigere Aussage als dass hier ein Token steht.
            bool faulted = FaultedNodeIds is not null && FaultedNodeIds.Contains(node.Id);
            // Eine Fehlerstelle gewinnt auch gegen die eigene Konturfarbe eines Knotens; sonst gilt sie
            // (Fristen-Timer: unterbrechend/nicht) vor der Token-Hervorhebung - sie ist die dauerhafte
            // Aussage, das Token steht nur gerade dort.
            string stroke = faulted
                ? "var(--mud-palette-error)"
                : node.OutlineColor
                  ?? (node.Highlighted ? "var(--mud-palette-primary)" : "var(--mud-palette-lines-default)");
            string strokeWidth = faulted || node.Highlighted ? "3" : (node.OutlineColor != null ? "2" : "1.5");
            string dash = node.DashedOutline ? " stroke-dasharray=\"5 3\"" : string.Empty;
            string fill = faulted
                ? "var(--mud-palette-error-hover, var(--mud-palette-surface))"
                : node.Highlighted
                    ? "var(--mud-palette-primary-hover, var(--mud-palette-surface))"
                    : "var(--mud-palette-surface)";
            string style = $"fill=\"{fill}\" stroke=\"{stroke}\" stroke-width=\"{strokeWidth}\"{dash}";

            switch (node.Shape)
            {
                case NodeShape.Ellipse:
                    sb.Append($"<ellipse cx=\"{N(node.CenterX)}\" cy=\"{N(node.CenterY)}\" rx=\"{N(node.Width / 2)}\" ry=\"{N(node.Height / 2)}\" {style} />");
                    break;
                case NodeShape.Diamond:
                    sb.Append($"<polygon points=\"{DiamondPoints(node)}\" {style} />");
                    break;
                case NodeShape.Hexagon:
                    sb.Append($"<polygon points=\"{HexagonPoints(node)}\" {style} />");
                    break;
                case NodeShape.Rectangle:
                    sb.Append($"<rect x=\"{N(node.X)}\" y=\"{N(node.Y)}\" width=\"{N(node.Width)}\" height=\"{N(node.Height)}\" {style} />");
                    break;
                default:
                    sb.Append($"<rect x=\"{N(node.X)}\" y=\"{N(node.Y)}\" width=\"{N(node.Width)}\" height=\"{N(node.Height)}\" rx=\"8\" ry=\"8\" {style} />");
                    break;
            }

            if (node.Symbol is { } symbol)
            {
                Text(sb, node.CenterX, node.CenterY, "middle", "var(--mud-palette-text-primary)",
                    symbol.FontSize, symbol.Text, "central");
            }

            if (node.LabelBelow)
            {
                Text(sb, node.CenterX, node.Y + node.Height + 13, "middle", "var(--mud-palette-text-primary)", 11, node.Label, null);
            }
            else
            {
                Text(sb, node.CenterX, node.CenterY, "middle", "var(--mud-palette-text-primary)", 12, Clip(node.Label), "central");
            }

            sb.Append("</g>");
        }

        return new MarkupString(sb.ToString());
    }

    /// <summary>
    /// Die Kanten, die Fehler-Ausgang eines Knotens sind - sie werden rot gezeichnet. Ohne das sieht
    /// ein Fehlerpfad im Bild aus wie der normale Weiterlauf.
    /// </summary>
    private HashSet<string> ErrorFlowIds()
    {
        var result = new HashSet<string>(StringComparer.Ordinal);
        if (Definition?.Nodes is null)
        {
            return result;
        }

        foreach (WorkflowNode n in Definition.Nodes)
        {
            string? id = n switch
            {
                AutomatedActivityNode a => a.ErrorFlowId,
                CallWorkflowNode c => c.ErrorFlowId,
                _ => null
            };

            if (!string.IsNullOrEmpty(id))
            {
                result.Add(id);
            }
        }

        return result;
    }

    private static void Text(StringBuilder sb, double x, double y, string anchor, string fill, int fontSize,
        string content, string? baseline)
    {
        sb.Append($"<text x=\"{N(x)}\" y=\"{N(y)}\" text-anchor=\"{anchor}\" fill=\"{fill}\" font-size=\"{fontSize}\"");
        if (baseline != null)
        {
            sb.Append($" dominant-baseline=\"{baseline}\"");
        }

        sb.Append('>').Append(WebUtility.HtmlEncode(content)).Append("</text>");
    }

    private static string N(double value) => value.ToString(CultureInfo.InvariantCulture);

    private static string DiamondPoints(LaidOutNode n)
    {
        return string.Join(" ",
            $"{N(n.CenterX)},{N(n.Y)}",
            $"{N(n.X + n.Width)},{N(n.CenterY)}",
            $"{N(n.CenterX)},{N(n.Y + n.Height)}",
            $"{N(n.X)},{N(n.CenterY)}");
    }

    private static string HexagonPoints(LaidOutNode n)
    {
        double k = GraphLayout.HexagonInset(n.Width, n.Height);
        return string.Join(" ",
            $"{N(n.X + k)},{N(n.Y)}",
            $"{N(n.X + n.Width - k)},{N(n.Y)}",
            $"{N(n.X + n.Width)},{N(n.CenterY)}",
            $"{N(n.X + n.Width - k)},{N(n.Y + n.Height)}",
            $"{N(n.X + k)},{N(n.Y + n.Height)}",
            $"{N(n.X)},{N(n.CenterY)}");
    }

    private static string Clip(string label) => label.Length <= 18 ? label : label.Substring(0, 16) + "…";
}
