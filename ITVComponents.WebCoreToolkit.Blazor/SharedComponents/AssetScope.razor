@namespace ITVComponents.WebCoreToolkit.Blazor.SharedComponents
@using ITVComponents.WebCoreToolkit.Security.SharedAssets
@using Microsoft.AspNetCore.Components.Authorization

@implements IDisposable
@inject ISharedAssetContext AssetContext
@inject IServiceProvider Services
@inject NavigationManager Navigation
@inject AuthenticationStateProvider AuthState

@* Der Riegel am Ausgang, Blazor-Fassung. Dort gibt es keinen Ausgang, aber eine Render-Grenze: der
   Inhalt entsteht erst, wenn die Argumente bestaetigt sind.

   Dasselbe Muster wie SecureView, nur eine Achse weiter - SecureView beantwortet "darf der hier
   ueberhaupt rein", diese Komponente "darf DIESES Objekt an ihn raus". *@

@if (permitted)
{
    @ChildContent
}
else
{
    @Refused
}

@code {
    /// <summary>
    /// Die Werte, die der aktuelle Vorgang betrifft - typischerweise die Route-Parameter der Seite oder
    /// die Schluessel des geladenen Datensatzes.
    /// </summary>
    [Parameter, EditorRequired] public IDictionary<string, object> Args { get; set; } = default!;

    /// <summary>Der geschuetzte Inhalt.</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    /// <summary>
    /// Was statt des Inhalts erscheint. Vorgabe: nichts - die Seite bleibt leer, was aus Sicht des
    /// Besuchers ehrlicher ist als eine Meldung, die verraet, dass es das Objekt gibt.
    /// </summary>
    [Parameter] public RenderFragment? Refused { get; set; }

    private bool permitted = true;

    protected override async Task OnParametersSetAsync()
    {
        // ZUERST melden, und ausdruecklich VOR dem Ausstieg ohne Asset: diese Werte sind es, mit denen
        // der Teilen-Knopf im Mantel eine Freigabe vorbelegt - und geteilt wird von einer Seite, auf der
        // noch KEINE Freigabe aktiv ist. Haenge die Meldung hinter den Ausstieg, und sie kaeme genau
        // dann nie, wenn sie gebraucht wird.
        //
        // Dass es dieselben Werte sind, die der Riegel unten bestaetigt, ist der ganze Gewinn: Link und
        // Riegel koennen nicht auseinanderlaufen, weil die Seite sie nur EINMAL erklaert.
        (Services.GetService(typeof(IShareArgumentSource)) as IShareArgumentSource)?.Publish(Args);

        if (!AssetContext.HasAsset)
        {
            // Ohne Asset ist die Komponente durchsichtig: dieselbe Seite soll ohne Freigabe genauso
            // funktionieren wie mit.
            permitted = true;
            return;
        }

        // Jeder Parametersatz ist ein neuer Vorgang. Unter Strict verfaellt damit eine frueher erteilte
        // Bestaetigung - im Circuit ist das der Unterschied, den es ausmacht.
        AssetContext.ResetConfirmation();
        AssetContext.Require(Args);
        permitted = !AssetContext.MustHoldBack;

        // Ein Parametersatz ist der Vorgang dieser Welt - das Gegenstueck zur Aktion in MVC.
        var auth = await AuthState.GetAuthenticationStateAsync();
        AssetAccessRecorder.Record(Services.GetService(typeof(IAssetAccessLog)) as IAssetAccessLog,
            AssetContext, auth.User, new Uri(Navigation.Uri).AbsolutePath);
    }

    /// <summary>
    /// Raeumt die gemeldeten Werte weg. Ohne das behielte der Mantel die Auskunft einer Seite, die nicht
    /// mehr da ist - und der Teilen-Knopf belegte die naechste Freigabe mit dem vorigen Datensatz vor.
    /// </summary>
    public void Dispose()
        => (Services.GetService(typeof(IShareArgumentSource)) as IShareArgumentSource)?.Clear();
}
