<EditDialogShell Model="Model" IsCreate="IsCreate" SaveVariant="Variant.Filled" InvalidMessage="Please correct invalid fields">
    <MudTextField @bind-Value="Model.ScriptFile" Label="Script file" Required="true" MaxLength="1024" />
</EditDialogShell>

@code {
    [Parameter, EditorRequired] public TemplateModuleScriptViewModel Model { get; set; } = default!;
    [Parameter] public bool IsCreate { get; set; }
}
