@using Microsoft.AspNetCore.Components.Authorization

@inject IExternalServiceAdminHandler Handler
@inject AuthenticationStateProvider AuthState

@* Saves inside the dialog: the handler checks reserved names and duplicates, and a rejected parameter keeps the dialog
   open with the reason - the same messages as the Kendo detail-grid. *@
<EditDialogShell Model="Model" IsCreate="IsCreate" OnValidated="SaveAsync" Result="@(() => saved)" Busy="busy">
    @if (!string.IsNullOrEmpty(error))
    {
        <MudAlert Severity="Severity.Error" Dense="true" Class="mb-2">@error</MudAlert>
    }
    <MudTextField @bind-Value="Model.ParameterName" Label="Parameter name" Required="true" RequiredError="A parameter name is required." MaxLength="255" />
    <MudSwitch T="bool" @bind-Value="Model.IsSecret" Label="Secret (stored encrypted)" Color="Color.Warning" Class="mt-2" />
    @if (Model.IsSecret)
    {
        @* Ein gespeichertes Geheimnis kommt nicht zurueck in die Maske. Leer lassen heisst behalten. *@
        <MudTextField @bind-Value="Model.ParameterValue" Label="Value" InputType="InputType.Password"
                      HelperText="@(Model.HasValue ? "Stored encrypted. Leave empty to keep the current value." : "Stored encrypted; it will not be shown again.")" />
    }
    else
    {
        <MudTextField @bind-Value="Model.ParameterValue" Label="Value"
                      HelperText="@(wasSecret ? "This value was secret - enter it again to store it as plain text." : null)" />
    }
</EditDialogShell>

@code {
    [Parameter, EditorRequired] public ExternalOAuthServiceParameterViewModel Model { get; set; } = default!;
    [Parameter] public bool IsCreate { get; set; }

    private ExternalOAuthServiceParameterViewModel? saved;

    /// <summary>Ob der Parameter beim Oeffnen geheim war - dann muss der Wert fuer Klartext neu eingegeben werden.</summary>
    private bool wasSecret;

    protected override void OnInitialized() => wasSecret = Model.IsSecret && Model.HasValue;
    private string? error;
    private bool busy;

    private async Task<bool> SaveAsync()
    {
        busy = true;
        error = null;
        try
        {
            var auth = await AuthState.GetAuthenticationStateAsync();
            var result = await Handler.SaveParameterAsync(auth.User, Model);
            if (!result.Success)
            {
                error = result.Error;
                return false;
            }

            saved = result.Parameter;
            return true;
        }
        finally
        {
            busy = false;
        }
    }
}
