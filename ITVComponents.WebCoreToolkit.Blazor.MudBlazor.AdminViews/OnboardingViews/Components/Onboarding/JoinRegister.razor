@namespace ITVComponents.WebCoreToolkit.Blazor.MudBlazor.AdminViews.OnboardingViews.Components.Onboarding
@page "/Account/Onboarding/JoinRegister"
@rendermode @(RenderMode.InteractiveServer)
@using Microsoft.AspNetCore.Authorization
@using ITVComponents.WebCoreToolkit.Blazor.MudBlazor.AdminViews.OnboardingViews.Components.Shared
@attribute [AllowAnonymous]

@inject IStringLocalizer<OnboardingMessages> L

@* Konto anlegen, um einer Einladung zu folgen. Die Seite unterscheidet sich von der freien Registrierung
   (/Account/Register) allein durch den erklaerenden Text - alles Weitere steht in RegisterAccountForm,
   damit beide Wege sich gleich verhalten und nicht mit der Zeit auseinanderlaufen. *@

<PageTitle>@L["Onb_JoinReg_Title"]</PageTitle>

<MudContainer MaxWidth="MaxWidth.Small" Class="my-4">
    <MudText Typo="Typo.h4" GutterBottom="true">@L["Onb_JoinReg_Title"]</MudText>

    <RegisterAccountForm Email="@EmailParam" SubmitText="@(L["Onb_JoinReg_Submit"].Value)">
        <Intro>
            <MudText Typo="Typo.body1" Class="mb-4">@L["Onb_JoinReg_Intro"]</MudText>
        </Intro>
    </RegisterAccountForm>
</MudContainer>

@code {
    [SupplyParameterFromQuery(Name = "email")]
    private string? EmailParam { get; set; }
}
