@page "/Account/ConfirmEmailChange"
@attribute [Microsoft.AspNetCore.Components.ExcludeFromInteractiveRouting]

@using System.Text
@using Microsoft.AspNetCore.WebUtilities
@using Microsoft.Extensions.Localization
@using Microsoft.Extensions.Options
@using ITVComponents.WebCoreToolkit.Net.TelerikUi.IdentityPages.Areas.Identity
@using ITVComponents.WebCoreToolkit.Net.TelerikUi.IdentityPages.Areas.Identity.Pages.Account
@using ITVComponents.WebCoreToolkit.Net.TelerikUi.IdentityPages.Options

@inject IPageHandlerProvider<ConfirmEmailChangeModel, IConfirmEmailChangeHandler> HandlerProvider
@inject IStringLocalizer<IdentityMessages> L
@inject IOptions<LoginOptions> LoginOpts
@inject NavigationManager Nav

<PageTitle>@L["Confirm email change"]</PageTitle>

<MudContainer MaxWidth="MaxWidth.Small" Class="mt-8">
    <MudPaper Elevation="2" Class="pa-6">
        <MudText Typo="Typo.h4" GutterBottom="true">@L["Confirm email change"]</MudText>

        @if (!HandlerProvider.Handler.UsePage)
        {
            <MudAlert Severity="Severity.Info">@L["This page is not available."]</MudAlert>
        }
        else if (!string.IsNullOrEmpty(statusMessage))
        {
            <MudAlert Severity="@statusSeverity">@statusMessage</MudAlert>
        }
    </MudPaper>
</MudContainer>

@code {
    private string? statusMessage;
    private Severity statusSeverity = Severity.Info;

    [SupplyParameterFromQuery]
    private string? UserId { get; set; }

    [SupplyParameterFromQuery]
    private string? Email { get; set; }

    [SupplyParameterFromQuery]
    private string? Code { get; set; }

    protected override async Task OnInitializedAsync()
    {
        if (!HandlerProvider.Handler.UsePage)
        {
            return;
        }

        if (UserId is null || Email is null || Code is null)
        {
            Nav.NavigateTo(HandlerProvider.Handler.RedirectOnNoCode, forceLoad: true);
            return;
        }

        var user = await HandlerProvider.Handler.FetchUser(UserId);
        if (!user.UserExists)
        {
            statusMessage = L["Unable to load user with ID '{0}'.", UserId];
            statusSeverity = Severity.Error;
            return;
        }

        try
        {
            var decoded = Encoding.UTF8.GetString(WebEncoders.Base64UrlDecode(Code));
            var result = await HandlerProvider.Handler.ChangeEmailAddress(user, Email, decoded, LoginOpts.Value.UserNameIsEmail);
            if (!result.Succeeded)
            {
                statusMessage = L["Error changing email."];
                statusSeverity = Severity.Error;
                return;
            }

            await HandlerProvider.Handler.RefreshSignIn(user);
            statusMessage = L["Thank you for confirming your email change."];
            statusSeverity = Severity.Success;
        }
        finally
        {
            HandlerProvider.Handler.ReleaseUser(user);
        }
    }
}
