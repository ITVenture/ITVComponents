@page "/Help/Admin/Resources"
@using Microsoft.Extensions.Logging
@rendermode @(RenderMode.InteractiveServer)
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@inject IHelpResourceHandler Handler
@inject AuthenticationStateProvider AuthState
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject IJSRuntime JS
@inject ILogger<HelpResources> Logger
@implements IAsyncDisposable

<PageTitle>Help resources</PageTitle>

<MudText Typo="Typo.h5" GutterBottom="true">Help resources</MudText>

<SecureView RequiredPermissions="Help.Admin.Resources.View,Help.Admin.Resources.Write" RequiredFeatures="ITVAdminViews">
    <Permitted>
        <MudText Typo="Typo.body2" Class="mb-3">
            Named media (images / videos) referenced from help content as <code>resource:{name}</code>. Each
            resource can hold one file per language (<code>DEFAULT</code> is the fallback). Folders are for
            <b>organising this list only</b> — a resource keeps its unique name and is always referenced flat,
            no matter which folder it sits in.
        </MudText>

        @if (currentUser is null)
        {
            <MudProgressCircular Indeterminate="true" />
        }
        else
        {
            @* data-itv-dnd-into="only": hier wird nicht sortiert, es gibt genau eine Zone - "hinein".
               Die ganze Zeile eines Ordners ist damit das Ziel. *@
            <div @ref="hostEl" data-itv-dnd-host="@hostId" data-itv-dnd-into="only">
                <MudToolBar Dense="true" Class="px-0">
                    <MudIconButton Icon="@Icons.Material.Filled.Refresh" OnClick="ReloadAll" />
                    @if (canWrite)
                    {
                        <MudButton StartIcon="@Icons.Material.Filled.CreateNewFolder" Size="Size.Small"
                                   OnClick="@(() => AddFolder(null))">Add folder</MudButton>
                        <MudButton StartIcon="@Icons.Material.Filled.Add" Variant="Variant.Filled" Color="Color.Primary"
                                   Size="Size.Small" Class="ml-2" OnClick="AddResource">Add resource</MudButton>
                    }
                    <MudSpacer />
                    @if (canWrite)
                    {
                        @* Die Ablage fuer die Wurzel: ohne sie kaeme nichts wieder aus einem Ordner heraus.
                           Sie ist Ziel, aber selbst nicht ziehbar. *@
                        <div data-itv-dnd-id="@HelpResourceNodeKey.Root"
                             class="pa-2 mud-border-lines-default"
                             style="border:1px dashed var(--mud-palette-lines-default);border-radius:var(--mud-default-borderradius);">
                            <MudStack Row="true" Spacing="1" AlignItems="AlignItems.Center">
                                <MudIcon Icon="@Icons.Material.Filled.DriveFileMove" Size="Size.Small" />
                                <MudText Typo="Typo.caption">Drop here to move to the top level</MudText>
                            </MudStack>
                        </div>
                    }
                </MudToolBar>

                @* Nach einem Ablegen wird der Baum neu aufgebaut: der verschobene Eintrag kann ueberall
                   gelandet sein, und eine halb aktualisierte Ansicht ist schlimmer als eine, die einmal
                   neu aufbaut. Die aufgeklappten Ordner ueberleben das, weil expandedFolders hier liegt
                   und nicht im Baum - sonst waere nach jedem Ablegen alles zu. *@
                <HelpResourceTree @key="treeKey" @ref="tree"
                                  FolderId="null"
                                  CurrentUser="@currentUser"
                                  CanWrite="@canWrite"
                                  ExpandedFolders="@expandedFolders" />
            </div>
        }
    </Permitted>
    <NotPermitted>
        <MudAlert Severity="Severity.Warning">You don't have permission to manage help resources.</MudAlert>
    </NotPermitted>
</SecureView>

@code {
    private System.Security.Claims.ClaimsPrincipal? currentUser;
    private bool canWrite;
    private HelpResourceTree? tree;
    private int treeKey;

    /// <summary>
    /// Die aufgeklappten Ordner des ganzen Baums. Liegt hier, damit das Neuaufbauen (treeKey) die
    /// Aufklapp-Zustaende nicht mitnimmt; alle Ebenen schreiben in dieses eine Set.
    /// </summary>
    private readonly HashSet<int> expandedFolders = new();

    private ElementReference hostEl;
    private readonly string hostId = Guid.NewGuid().ToString("N");
    private DotNetObjectReference<HelpResources>? selfRef;
    private bool jsAttached;

    protected override async Task OnInitializedAsync()
    {
        var auth = await AuthState.GetAuthenticationStateAsync();
        currentUser = auth.User;
        canWrite = Handler.CanWrite(currentUser);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // Nicht an firstRender gebunden: beim ersten Rendern steht currentUser noch nicht fest, also gibt
        // es das Wirtselement noch gar nicht.
        if (jsAttached || !canWrite || currentUser is null)
        {
            return;
        }

        selfRef = DotNetObjectReference.Create(this);
        try
        {
            await JS.InvokeAsync<IJSObjectReference>("import",
                "./_content/ITVComponents.WebCoreToolkit.Blazor.MudBlazor.AdminViews/grid-dnd.js");
            await JS.InvokeVoidAsync("itvGridDnd.attach", hostEl, selfRef);
            jsAttached = true;
        }
        catch (Microsoft.JSInterop.JSDisconnectedException) { /* Kreis weg */ }
        catch (Exception ex)
        {
            // Nicht durchwerfen: die Ablage bleibt ohne Ziehen benutzbar (Ordner im Dialog waehlen).
            // Ohne Log waere aber unklar, warum das Ziehen nichts tut.
            Logger.LogError(ex, "Der Drag-and-drop-Helfer konnte nicht angebunden werden - die Ressourcen-Ablage laeuft ohne ihn.");
            Snackbar.Add("Drag & drop could not be activated.", Severity.Warning);
        }
    }

    /// <summary>
    /// Ein Eintrag wurde auf einem Ordner oder auf der Wurzel abgelegt.
    /// </summary>
    /// <param name="draggedKey">der gezogene Eintrag ("f:12" / "r:34")</param>
    /// <param name="targetKey">das Ziel - ein Ordner oder <c>root</c></param>
    /// <param name="zone">bei dieser Ablage immer "into"</param>
    [JSInvokable]
    public async Task HandleDrop(string draggedKey, string targetKey, string zone)
    {
        if (!canWrite || currentUser is null)
        {
            return;
        }

        string? error = await Handler.MoveNodeAsync(currentUser, draggedKey, targetKey);
        if (error is not null)
        {
            // Verstaendliche Ablehnungen (Ordner in sich selbst, Ziel ist eine Ressource) kommen als Text
            // zurueck - der Benutzer soll wissen, warum nichts passiert ist.
            Snackbar.Add(error, Severity.Warning);
            return;
        }

        Snackbar.Add("Moved", Severity.Success);
        await ReloadAll();
    }

    private async Task AddFolder(int? parentId)
    {
        var parameters = new DialogParameters<HelpResourceFolderDialog>
        {
            { d => d.FolderId, 0 },
            { d => d.ParentId, parentId }
        };
        var dialog = await DialogService.ShowAsync<HelpResourceFolderDialog>("New folder", parameters);
        if (await dialog.Result is { Canceled: false })
        {
            await ReloadAll();
        }
    }

    /// <summary>
    /// Legt eine Ressource an. Sie erscheint in der Wurzel und wird von dort per Ziehen einsortiert - der
    /// Dialog kennt bewusst keinen Ordner: schriebe er ihn bei JEDEM Speichern mit, wuerde ein spaeteres
    /// Bearbeiten die per Ziehen gewaehlte Ablage stillschweigend zuruecksetzen.
    /// </summary>
    private async Task AddResource()
    {
        var parameters = new DialogParameters<HelpResourceDialog>
        {
            { d => d.Model, new HelpResourceEditViewModel() }
        };
        await (await DialogService.ShowAsync<HelpResourceDialog>("New resource", parameters,
            EditDialogDefaults.Detail)).Result;
        await ReloadAll();
    }

    private Task ReloadAll()
    {
        treeKey++;
        StateHasChanged();
        return Task.CompletedTask;
    }

    public async ValueTask DisposeAsync()
    {
        if (jsAttached)
        {
            try { await JS.InvokeVoidAsync("itvGridDnd.detach", hostEl); }
            catch (Microsoft.JSInterop.JSDisconnectedException) { /* Kreis weg */ }
            catch (Exception ex)
            {
                Logger.LogWarning(ex, "Der Drag-and-drop-Helfer konnte nicht abgemeldet werden - das Element ist vermutlich schon weg.");
            }
        }

        selfRef?.Dispose();
    }
}
