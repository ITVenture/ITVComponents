@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.Extensions.Localization
@using Microsoft.Extensions.Logging
@using ITVComponents.WebCoreToolkit.Security.SharedAssets

@implements IDisposable
@inject ISharedAssetAdminHandler Handler
@inject AuthenticationStateProvider AuthState
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject NavigationManager Navigation
@inject IServiceProvider Services
@inject ILogger<ShareButton> Logger
@inject IStringLocalizer<ShareMessages> L

@* "Hier teilen" - auf der Seite, auf der geteilt wird, und nicht in der Administration.

   Der Knopf erscheint nur, wenn an dieser Stelle ueberhaupt etwas zu teilen ist: welche Vorlagen
   passen, entscheidet der Adapter aus Pfad, Berechtigung und Feature. *@

@if (templates.Length != 0)
{
    <MudTooltip Text="@L["Share_Tooltip"]">
        <MudIconButton Icon="@Icons.Material.Filled.Share" Size="@Size" OnClick="Open" />
    </MudTooltip>
}

@code {
    /// <summary>
    /// Die Argumentwerte dieser Stelle, ausdruecklich gesetzt. <b>Meist unnoetig</b> - was die Seite
    /// ohnehin ihrem <c>AssetScope</c> erklaert und was im Pfad steht, findet der Knopf allein. Diese
    /// Angabe ist die Uebersteuerung fuer den Rest.
    /// </summary>
    [Parameter] public IDictionary<string, string>? Context { get; set; }

    /// <summary>Der Pfad, auf dem geteilt wird. Vorgabe: der aktuelle.</summary>
    [Parameter] public string? Path { get; set; }

    [Parameter] public Size Size { get; set; } = Size.Small;

    /// <summary>
    /// Zeigt die neue Freigabe zuerst als QR-Code und den Link erst auf Wunsch - fuer Stellen, an denen
    /// der Link einem Gegenueber hingehalten und nicht verschickt wird (Kasse, Aushang).
    /// </summary>
    [Parameter] public bool QrFirst { get; set; }

    private AssetTemplateInfo[] templates = Array.Empty<AssetTemplateInfo>();
    private System.Security.Claims.ClaimsPrincipal? currentUser;
    private int resolveSequence;

    protected override void OnInitialized()
    {
        // Der Knopf sitzt typischerweise im Mantel und wird beim Seitenwechsel nicht neu aufgebaut - seine
        // Parameter aendern sich dabei nicht, also entschiede er ohne dieses Ereignis weiterhin fuer die
        // Seite, auf der man einmal war. Genau wie der Hilfe-Knopf muss er beim Navigieren neu entscheiden.
        Navigation.LocationChanged += OnLocationChanged;
    }

    protected override async Task OnParametersSetAsync() => await ResolveAsync();

    private async void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        await ResolveAsync();
        try
        {
            await InvokeAsync(StateHasChanged);
        }
        catch (Exception ex)
        {
            // Wurde der Knopf waehrend des Wechsels abgeraeumt, ist das der Normalfall und kein Fehler.
            Logger.LogDebug(ex, "The share button could not be redrawn after navigating to {Path}.",
                EffectivePath);
        }
    }

    private async Task ResolveAsync()
    {
        var mine = ++resolveSequence;
        try
        {
            var auth = await AuthState.GetAuthenticationStateAsync();
            var user = auth.User;
            var eligible = await Handler.GetEligibleAsync(user, EffectivePath);
            if (mine != resolveSequence)
            {
                // Zwischenzeitlich wurde erneut navigiert: das ist die Antwort auf die alte Frage.
                return;
            }

            currentUser = user;
            templates = eligible;
        }
        catch (Exception ex)
        {
            if (mine == resolveSequence)
            {
                // Im Zweifel nichts anbieten - ein Knopf, der ins Leere fuehrt, ist schlimmer als keiner.
                currentUser = null;
                templates = Array.Empty<AssetTemplateInfo>();
            }

            Logger.LogError(ex, "Could not determine the shareable templates for {Path}.", EffectivePath);
        }
    }

    public void Dispose() => Navigation.LocationChanged -= OnLocationChanged;

    private string EffectivePath => Path ?? new Uri(Navigation.Uri).AbsolutePath;

    private string Origin => new Uri(Navigation.BaseUri).GetLeftPart(UriPartial.Authority);

    private async Task Open()
    {
        var model = new ShareRequestViewModel { RequestPath = EffectivePath };

        // Drei Quellen, aufsteigend nach Verbindlichkeit - jede spaetere ueberschreibt die fruehere:
        //
        //  1. der PFAD (benannte Gruppen im Muster der Vorlage) - eine Ablesung, ohne Mitwirkung
        //     der Seite, und deshalb die schwaechste Aussage.
        //  2. die SEITE (was sie ihrem AssetScope erklaert) - dieselben Werte, die der Riegel spaeter
        //     bestaetigt. Sie muessen gewinnen, sonst baut man Links, die der eigene Riegel ablehnt.
        //  3. der Parameter Context - jemand hat es ausdruecklich hingeschrieben.
        //
        // Die Vorlagen-abhaengige Quelle (1) wird erst im Dialog je gewaehlter Vorlage aufgeloest; hier
        // steht der gemeinsame Anteil.
        var fromPage = (Services.GetService(typeof(IShareArgumentSource)) as IShareArgumentSource)?.Current;
        if (fromPage != null)
        {
            foreach (var pair in fromPage)
            {
                model.ArgumentValues[pair.Key] = pair.Value;
            }
        }

        if (Context != null)
        {
            foreach (var pair in Context)
            {
                model.ArgumentValues[pair.Key] = pair.Value;
            }
        }

        // Eine Freigabe je Ort: gibt es sie schon, ist der Dialog keine Frage mehr - es wird gezeigt, was
        // an der Tuer haengt. Nur bei GENAU einer Vorlage, sonst waere die Wahl der Vorlage uebergangen.
        if (templates is [{ ReuseStoredShare: true } only] && await FindReusable(only, model) is { } existing)
        {
            await ShowLink(existing, model.Title);
            return;
        }

        var parameters = new DialogParameters<ShareDialog>
        {
            { d => d.Model, model },
            { d => d.Templates, templates },
            { d => d.OnShare, request => Handler.CreateAsync(currentUser!, request, Origin) }
        };
        var dlg = await DialogService.ShowAsync<ShareDialog>(L["Share_DialogTitle"], parameters, EditDialogDefaults.Edit);
        var result = await dlg.Result;
        if (result is { Canceled: false, Data: ShareResultViewModel created })
        {
            if (created is { Success: true, Created: false })
            {
                Snackbar.Add(L["Share_AlreadyShared"], Severity.Info);
            }

            // Der Link kommt aus dem Ergebnis und wird nicht neu geholt - und er gehoert dorthin, wo man
            // ihn kopieren kann, nicht in eine Meldung, die nach drei Sekunden verschwindet.
            await ShowLink(created, model.Title);
        }
    }

    /// <summary>
    /// Die bestehende Freigabe dieses Orts, mit denselben Argumentwerten, die der Dialog vorbelegen wuerde:
    /// Seite und <see cref="Context"/> stehen schon im Modell, der Pfad fuellt nur Luecken.
    /// </summary>
    private async Task<ShareResultViewModel?> FindReusable(AssetTemplateInfo template, ShareRequestViewModel model)
    {
        var values = new Dictionary<string, string>(model.ArgumentValues, StringComparer.OrdinalIgnoreCase);
        foreach (var pair in template.PathValues ?? new Dictionary<string, string>())
        {
            if (!values.TryGetValue(pair.Key, out var known) || string.IsNullOrEmpty(known))
            {
                values[pair.Key] = pair.Value;
            }
        }

        try
        {
            return await Handler.FindReusableAsync(currentUser!, model.RequestPath, template.TemplateKey, values, Origin);
        }
        catch (Exception ex)
        {
            // Dann eben der Dialog - CreateAsync sucht ohnehin noch einmal, bevor es anlegt.
            Logger.LogError(ex, "Could not look up the stored share of '{Template}' on {Path}.", template.TemplateKey,
                model.RequestPath);
            return null;
        }
    }

    private async Task ShowLink(ShareResultViewModel result, string? fallbackTitle)
    {
        var link = result.Link;
        if (string.IsNullOrEmpty(link))
        {
            Snackbar.Add(L["Share_LinkNotBuilt"], Severity.Warning);
            return;
        }

        // Erneuern gibt es nur fuer ein Geheimnis, das gespeichert ist: ein Ad-hoc-Ticket hat keines, ein
        // Link mit Anmeldung braucht keines.
        var assetKey = result.AssetKey;
        Func<Task<string?>>? renew = result.Anonymous && !string.IsNullOrEmpty(assetKey)
            ? () => RenewAsync(assetKey)
            : null;

        // Der Titel geht mit: er benennt die Datei, wenn der QR-Code gespeichert wird, und steht auf dem
        // Ausdruck.
        var parameters = new DialogParameters<ShareLinkDialog>
        {
            { d => d.Link, link },
            { d => d.Title, string.IsNullOrEmpty(result.Title) ? fallbackTitle : result.Title },
            { d => d.QrFirst, QrFirst },
            { d => d.Renew, renew }
        };
        await DialogService.ShowAsync<ShareLinkDialog>(L["Share_LinkDialogTitle"], parameters, EditDialogDefaults.Edit);
    }

    private async Task<string?> RenewAsync(string assetKey)
    {
        if (!await Handler.RotateAsync(currentUser!, assetKey))
        {
            Logger.LogError("The secret of share '{AssetKey}' was not renewed.", assetKey);
            return null;
        }

        var link = await Handler.GetLinkAsync(currentUser!, assetKey, true, Origin);
        if (string.IsNullOrEmpty(link))
        {
            Logger.LogError("Share '{AssetKey}' was renewed, but its new link could not be built.", assetKey);
            return null;
        }

        return link;
    }
}
