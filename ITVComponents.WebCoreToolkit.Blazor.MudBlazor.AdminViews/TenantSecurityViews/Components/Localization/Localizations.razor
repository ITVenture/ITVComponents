@page "/Util/Localizations"
@rendermode @(RenderMode.InteractiveServer)
@attribute [Microsoft.AspNetCore.Authorization.Authorize]

@using Microsoft.AspNetCore.Components.Authorization

@inject IDbResourceAdminHandler Handler
@inject AuthenticationStateProvider AuthState
@inject IDialogService DialogService
@inject ISnackbar Snackbar

<PageTitle>Localizations</PageTitle>

<MudText Typo="Typo.h5" GutterBottom="true">Localizations</MudText>

<SecureView RequiredPermissions="DbResources.View,DbResources.Write" RequiredFeatures="ITVAdminViews">
    <Permitted>
@if (currentUser is null)
{
    <MudProgressCircular Indeterminate="true" />
}
else
{
    <MudDataGrid T="LocalizationViewModel"
                 @ref="grid"
                 ServerData="LoadData"
                 SortMode="SortMode.None"
                 RowsPerPage="25" Hover="true" Dense="true">
        <ToolBarContent>
            <RefreshButton OnClick="@(() => grid is null ? Task.CompletedTask : grid.ReloadServerData())" />
            <MudText Typo="Typo.h6">Localizations</MudText>
            <MudSpacer />
            <MudTextField @bind-Value="search" Placeholder="Search…" DebounceInterval="300" OnDebounceIntervalElapsed="@(() => grid is null ? Task.CompletedTask : grid.ReloadServerData())" Class="mt-0" />
            <SecureView RequiredPermissions="DbResources.Write">
                <Permitted>
                <MudButton StartIcon="@Icons.Material.Filled.Add" Variant="Variant.Filled" Color="Color.Primary" Class="ml-2" OnClick="OpenCreate">Add localization</MudButton>
                </Permitted>
            </SecureView>
        </ToolBarContent>
        <Columns>
            <HierarchyColumn T="LocalizationViewModel" />
            <PropertyColumn Property="x => x.Identifier" Title="Identifier" />
            <TemplateColumn T="LocalizationViewModel" Title="" Sortable="false">
                <CellTemplate>
                    <SecureView RequiredPermissions="DbResources.Write">
                        <Permitted>
                        <MudStack Row="true" Spacing="1">
                            <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" OnClick="@(() => OpenEdit(context.Item))" />
                            <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error" OnClick="@(() => Delete(context.Item))" />
                        </MudStack>
                        </Permitted>
                    </SecureView>
                </CellTemplate>
            </TemplateColumn>
        </Columns>
        <ChildRowContent>
            <MudPaper Elevation="0" Class="pa-2">
                <LocalizationCulturesGrid LocalizationId="@context.Item.LocalizationId" />
            </MudPaper>
        </ChildRowContent>
        <PagerContent><MudDataGridPager T="LocalizationViewModel" /></PagerContent>
    </MudDataGrid>
}
    </Permitted>
    <NotPermitted>
        <MudAlert Severity="Severity.Warning">No permission to view localizations.</MudAlert>
    </NotPermitted>
</SecureView>

@code {
    private MudDataGrid<LocalizationViewModel>? grid;
    private System.Security.Claims.ClaimsPrincipal? currentUser;
    private bool hasView, hasWrite;
    private string? search;

    protected override async Task OnInitializedAsync()
    {
        var auth = await AuthState.GetAuthenticationStateAsync();
        currentUser = auth.User;
        hasView = Handler.HasPermission(currentUser, "DbResources.View", "DbResources.Write");
        hasWrite = Handler.HasPermission(currentUser, "DbResources.Write");
    }

    private async Task<GridData<LocalizationViewModel>> LoadData(GridState<LocalizationViewModel> state, CancellationToken ct)
    {
        if (currentUser is null || !hasView) return new GridData<LocalizationViewModel>();
        var result = await Handler.ListLocalizationsAsync(currentUser, new ListQuery { Page = state.Page, PageSize = state.PageSize, Search = search });
        return new GridData<LocalizationViewModel> { Items = result.Items, TotalItems = result.TotalCount };
    }

    private async Task OpenCreate()
    {
        var p = new DialogParameters<LocalizationDialog> { { d => d.Model, new LocalizationViewModel() }, { d => d.IsCreate, true } };
        var dlg = await DialogService.ShowAsync<LocalizationDialog>("Create localization", p, EditDialogDefaults.Edit);
        var r = await dlg.Result;
        if (r is { Canceled: false, Data: LocalizationViewModel m } && await Handler.CreateLocalizationAsync(currentUser!, m) != null)
        { Snackbar.Add("Localization created", Severity.Success); if (grid is not null) await grid.ReloadServerData(); }
    }

    private async Task OpenEdit(LocalizationViewModel item)
    {
        var copy = new LocalizationViewModel { LocalizationId = item.LocalizationId, Identifier = item.Identifier };
        var p = new DialogParameters<LocalizationDialog> { { d => d.Model, copy }, { d => d.IsCreate, false } };
        var dlg = await DialogService.ShowAsync<LocalizationDialog>("Edit localization", p, EditDialogDefaults.Edit);
        var r = await dlg.Result;
        if (r is { Canceled: false, Data: LocalizationViewModel m } && await Handler.UpdateLocalizationAsync(currentUser!, m) != null)
        { Snackbar.Add("Localization updated", Severity.Success); if (grid is not null) await grid.ReloadServerData(); }
    }

    private async Task Delete(LocalizationViewModel item)
    {
        var ok = await DialogService.ShowMessageBoxAsync("Delete localization", $"Really delete '{item.Identifier}'?", yesText: "Delete", cancelText: "Cancel");
        if (ok != true) return;
        if (await Handler.DeleteLocalizationAsync(currentUser!, item.LocalizationId))
        { Snackbar.Add("Localization deleted", Severity.Success); if (grid is not null) await grid.ReloadServerData(); }
        else Snackbar.Add("Failed to delete", Severity.Error);
    }
}
