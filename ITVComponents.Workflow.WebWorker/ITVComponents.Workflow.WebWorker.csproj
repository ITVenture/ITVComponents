<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <Version>5.0.0-PRE213</Version>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <RepositoryUrl>https://github.com/ITVenture/ITVComponents</RepositoryUrl>
  </PropertyGroup>
  <ItemGroup>
    <!-- Fuer BackgroundService/IHostedService und System.Threading.Channels (im Shared Framework). -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>
  <ItemGroup>
    <!-- Die Zusammenfassung der Poll-Deskriptoren ist eine Entscheidung mit stillen Fehlern in beide
         Richtungen (Doppelverarbeitung bzw. ein Mandant, der gar keinen Worker wollte) - sie gehoert
         gepruft, ohne dafuer oeffentlich werden zu muessen. -->
    <InternalsVisibleTo Include="ITVComponents.Workflow.Plugins.WebCoreToolkit.Test" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\ITVComponents.Workflow\ITVComponents.Workflow.csproj" />
    <ProjectReference Include="..\ITVComponents.Workflow.EntityFramework\ITVComponents.Workflow.EntityFramework.csproj" />
    <ProjectReference Include="..\ITVComponents.WebCoreToolkit\ITVComponents.WebCoreToolkit.csproj" />
  </ItemGroup>
</Project>