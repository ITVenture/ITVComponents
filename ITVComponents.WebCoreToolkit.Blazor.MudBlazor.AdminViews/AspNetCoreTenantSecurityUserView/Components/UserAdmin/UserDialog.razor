@using System.ComponentModel.DataAnnotations

<EditDialogShell Model="Model" IsCreate="IsCreate">
    <MudTextField @bind-Value="Model.UserName" Label="User name" Required="true" RequiredError="User name is required" />
    <MudTextField @bind-Value="Model.Email" Label="Email" InputType="InputType.Email" />
    <MudCheckBox @bind-Value="Model.EmailConfirmed" Label="Email confirmed" />
    <MudTextField @bind-Value="Model.PhoneNumber" Label="Phone number" />
    <MudCheckBox @bind-Value="Model.PhoneNumberConfirmed" Label="Phone confirmed" />
    <MudCheckBox @bind-Value="Model.TwoFactorEnabled" Label="Two-factor enabled" />
    <MudCheckBox @bind-Value="Model.LockoutEnabled" Label="Lockout enabled" />
    <MudDatePicker @bind-Date="lockoutDate" Label="Locked until" Editable="true" Clearable="true" />
    <ForeignKeySelect T="int?" @bind-Value="Model.AuthenticationTypeId" Table="AuthenticationTypes" Label="Authentication type" />
</EditDialogShell>

@code {
    [Parameter, EditorRequired] public UserViewModel Model { get; set; } = default!;
    [Parameter] public bool IsCreate { get; set; }

    private DateTime? lockoutDate
    {
        get => Model.LockoutEnd?.UtcDateTime;
        set => Model.LockoutEnd = value.HasValue ? new DateTimeOffset(DateTime.SpecifyKind(value.Value, DateTimeKind.Utc)) : null;
    }
}
