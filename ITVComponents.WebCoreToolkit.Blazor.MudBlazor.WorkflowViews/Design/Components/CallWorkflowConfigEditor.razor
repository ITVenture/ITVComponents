@using ITVComponents.Workflow.Model

@*
    Konfiguriert einen CallWorkflowNode (Subworkflow-Aufruf): die aufzurufende Definition, optional
    deren Version, sowie den Datenfluss - Inputs setzen Startvariablen des Kindes (Konstante/Variable/
    Ausdruck des Elternprozesses), Outputs bilden Endvariablen des Kindes auf Eltern-Variablen ab.
*@

@if (Node is not null)
{
    <MudText Typo="Typo.caption" Class="mt-2">Sub-workflow</MudText>
    @if (Definitions is { Count: > 0 })
    {
        <MudSelect T="string" Value="@Node.SubDefinitionId" ValueChanged="@(v => Node.SubDefinitionId = v)"
                   Label="Definition" Margin="Margin.Dense" Clearable="true">
            @foreach (var id in Definitions)
            {
                <MudSelectItem T="string" Value="@id">@id</MudSelectItem>
            }
        </MudSelect>
    }
    else
    {
        <MudTextField T="string" @bind-Value="Node.SubDefinitionId" Label="Definition id" Margin="Margin.Dense" />
    }
    <MudNumericField T="int?" Value="@Node.SubDefinitionVersion" ValueChanged="@(v => Node.SubDefinitionVersion = v)"
                     Label="Version (empty = latest)" Margin="Margin.Dense" Clearable="true" Min="1" />

    @* Inputs: Startvariablen des Kindes aus dem Elternprozess speisen. Deklariert der Subworkflow
       eigene Start-Parameter, laufen diese Werte anschliessend noch durch dessen Signatur. *@
    <MudText Typo="Typo.caption" Class="mt-4">Inputs → child start variables</MudText>
    <InputBindingList Bindings="Node.Inputs" NamePlaceholder="child variable" SourcePlaceholder="parent variable"
                      AddPlaceholder="new child variable" NameWidth="120px" />

    @* Outputs: Endvariablen des Kindes auf Eltern-Variablen abbilden. *@
    <MudText Typo="Typo.caption" Class="mt-4">Outputs → parent variables</MudText>
    <OutputBindingList Bindings="Node.Outputs" SourcePlaceholder="child variable" TargetPlaceholder="parent variable"
                       AddPlaceholder="new child variable" />

    @* Konsolidierung: wie bei der Aktivitaet - entweder additiv (Standard) oder der Eltern-Scope
       besteht nach dem Aufruf genau aus den Ausgaben oben plus der Erhaltungs-Liste. *@
    <ScopeModeSection Mode="Node.ScopeMode" ModeChanged="@(m => Node.ScopeMode = m)"
                      RetainVariables="Node.RetainVariables"
                      HelperText="@("After this call the parent scope contains only the outputs mapped above plus the variables kept here. Place on a single branch (after a join), not inside a parallel region.")" />
}

@code {
    /// <summary>Der zu konfigurierende Subworkflow-Aufruf-Knoten.</summary>
    [Parameter] public CallWorkflowNode? Node { get; set; }

    /// <summary>Die verfuegbaren (aufrufbaren) Definition-Ids fuer das Dropdown, oder null (dann Freitext).</summary>
    [Parameter] public IReadOnlyList<string>? Definitions { get; set; }
}
