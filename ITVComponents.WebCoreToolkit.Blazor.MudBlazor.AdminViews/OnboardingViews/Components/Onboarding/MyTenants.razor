@namespace ITVComponents.WebCoreToolkit.Blazor.MudBlazor.AdminViews.OnboardingViews.Components.Onboarding
@page "/Account/Onboarding/MyTenants"
@rendermode @(RenderMode.InteractiveServer)
@using Microsoft.AspNetCore.Authorization
@using Microsoft.Extensions.Logging
@using Microsoft.Extensions.DependencyInjection
@using Microsoft.Extensions.Options
@using ITVComponents.WebCoreToolkit.Security
@using ITVComponents.WebCoreToolkit.Blazor.Security
@attribute [Authorize]

@inject IOnboardingHandler Handler
@inject IServiceProvider Services
@inject NavigationManager Nav
@inject ISnackbar Snackbar
@inject AuthenticationStateProvider AuthState
@inject IStringLocalizer<OnboardingMessages> L
@inject ILogger<MyTenants> Logger

<PageTitle>@L["Onb_MyTenants"]</PageTitle>

<MudContainer MaxWidth="MaxWidth.Large" Class="my-4">
    <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mb-3">
        <MudText Typo="Typo.h4">@L["Onb_MyTenants"]</MudText>
        <MudButton Variant="Variant.Filled" Color="Color.Primary"
                   Href="/Account/Onboarding/CreateTenant" StartIcon="@Icons.Material.Filled.Add">
            @L["Onb_Register"]
        </MudButton>
    </MudStack>

    @if (loading)
    {
        <MudProgressLinear Color="Color.Primary" Indeterminate="true" />
    }
    else if (tenants.Length == 0)
    {
        <MudPaper Class="pa-4" Outlined="true">
            <MudText Typo="Typo.body1">@L["Onb_NoTenants"]</MudText>
        </MudPaper>
    }
    else
    {
        <MudDataGrid T="ParticipatingTenantViewModel" Items="tenants" Hover="true" Dense="true">
            <Columns>
                <PropertyColumn Property="x => x.Name" Title="@(L["Onb_Col_Name"])" />
                <PropertyColumn Property="x => x.ProfileType" Title="@(L["Onb_Col_Type"])" />
                <PropertyColumn Property="x => x.DefaultEmail" Title="@(L["Onb_Col_Email"])" />
                <PropertyColumn Property="x => x.StatusText" Title="@(L["Onb_Col_Status"])" />
                <TemplateColumn T="ParticipatingTenantViewModel" Title="" Sortable="false">
                    <CellTemplate>
                        @if (context.Item.Status == InvitationStatus.Pending)
                        {
                            <MudButton Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Small"
                                       OnClick="() => AcceptAsync(context.Item)">
                                @L["Onb_AcceptInvitation"]
                            </MudButton>
                        }
                    </CellTemplate>
                </TemplateColumn>
            </Columns>
        </MudDataGrid>
    }
</MudContainer>

@code {
    private ParticipatingTenantViewModel[] tenants = Array.Empty<ParticipatingTenantViewModel>();
    private bool loading = true;

    protected override async Task OnInitializedAsync()
    {
        var state = await AuthState.GetAuthenticationStateAsync();
        if (state.User.Identity?.IsAuthenticated == true && RendererInfo.IsInteractive)
        {
            // Finish a deferred direct onboarding: the tenant is created on the first authenticated landing after
            // the user confirmed their e-mail. Interactive pass ONLY — this page prerenders, so OnInitializedAsync
            // runs twice, and a tenant-creating write must not happen in the prerender pass: that pass runs on the
            // HTTP request scope, can be discarded, and would attempt the whole unit of work a second time.
            try
            {
                var completed = await Handler.CompletePendingOnboardingAsync(state.User);
                Logger.LogInformation("Pending onboarding completion for {User} returned {Completed}.",
                    state.User.Identity?.Name, completed);

                if (completed)
                {
                    // A tenant was just created for a user who arrived without any tenant scope. The host resolves
                    // the current tenant on a full request (nav menu, permissions and their icons are tenant-scoped);
                    // the interactive circuit that ran the completion never went through that resolution, so the
                    // shell renders half-initialised until a reload. Force one full navigation so the freshly owned
                    // tenant becomes the active scope. Loop-free: after the reload the pending record is Committed,
                    // so completion returns false and this branch is not taken again.
                    Nav.NavigateTo(ReloadTarget(), forceLoad: true);
                    return;
                }
            }
            catch (Exception ex)
            {
                // A failed completion must not block the tenant list — but it must not vanish either: without
                // this log the tenant silently never appears and the only trace is EF's MARS/savepoint warning.
                Logger.LogError(ex, "Completing the pending onboarding for {User} failed; the tenant was not created.",
                    state.User.Identity?.Name);
            }

            // Wer sich selbst registriert hat, bringt kein geparktes Onboarding mit und gehoert deshalb
            // noch nirgends hin. Ist ein Standard-Mandant konfiguriert, bekommt er ihn hier - nach der
            // Mailbestaetigung, auf derselben ersten angemeldeten Landung.
            try
            {
                if (await Handler.AssignDefaultTenantAsync(state.User))
                {
                    // Wie oben: der Circuit hat die Mandanten-Aufloesung des Hosts nie durchlaufen, die
                    // Shell bliebe halb gezeichnet. Schleifenfrei, weil die Zuweisung danach schon besteht.
                    Nav.NavigateTo(ReloadTarget(), forceLoad: true);
                    return;
                }
            }
            catch (Exception ex)
            {
                // Auch hier: nicht blockieren, aber auch nicht verschweigen - sonst steht der Benutzer vor
                // einer leeren Liste und niemand kann sagen, warum die Zuweisung ausblieb.
                Logger.LogError(ex, "Die Zuweisung zum Standard-Mandanten fuer {User} ist fehlgeschlagen; der Benutzer bleibt ohne Mandanten.",
                    state.User.Identity?.Name);
            }
        }
        else if (state.User.Identity?.IsAuthenticated == true)
        {
            // So that "no completion log at all" is unambiguous rather than a silent skip.
            Logger.LogDebug("Onboarding completion deferred to the interactive pass (current pass: {Renderer}).",
                RendererInfo.Name);
        }
        await ReloadAsync();
    }

    private const string PageRoute = "Account/Onboarding/MyTenants";

    /// <summary>
    /// Die Adresse, auf die nach einer Mandanten-Anlage voll neu geladen wird.
    /// <para>
    /// Nicht <c>Nav.Uri</c>: diese Seite liegt unter <c>/Account/</c> und damit in den Vorgaben von
    /// <c>AuthPathExclusions</c>, die <c>TenantPathPrefixMiddleware</c> unangetastet durchreicht. Sie setzt dort
    /// also auch beim Full-Reload kein Praefix, <c>&lt;base href&gt;</c> bleibt bei <c>/</c>, und die neu geladene
    /// Seite stuende wieder genau da, wo sie vorher stand - ohne Mandantensegment, obwohl der Benutzer jetzt
    /// einen Mandanten hat. Das Segment muss deshalb hier selbst davor.
    /// </para>
    /// </summary>
    private string ReloadTarget()
    {
        var options = Services.GetService<IOptions<ScopedPermissionScopeOptions>>();
        if (options?.Value.TenantSource != TenantSource.PathSegment)
        {
            // Ohne Mandantensegment in der Adresse ist Nav.Uri bereits die vollstaendige Adresse; ein Praefix
            // waere hier nicht bloss unnoetig, sondern falsch.
            return Nav.Uri;
        }

        var scope = Services.GetService<IPermissionScope>();
        if (scope == null)
        {
            Logger.LogWarning(
                "Reloading to {Uri} without a tenant segment: TenantSource is PathSegment, but no IPermissionScope is registered. The reloaded page keeps a tenant-free address and its sub-resources are requested without the prefix.",
                Nav.Uri);
            return Nav.Uri;
        }

        // Der Geltungsbereich dieses Circuits wurde aufgeloest, als es den Mandanten noch nicht gab, und dieses
        // Ergebnis - keiner - ist gemerkt. Ohne Refresh liefert der Prefix genau diese veraltete Antwort.
        scope.Refresh();
        var prefix = scope.PermissionPrefix;
        if (string.IsNullOrEmpty(prefix))
        {
            // Ein leeres Segment ergaebe "//Account/..." - protokoll-relativ, der Browser suchte einen fremden
            // Host. Nach einer erfolgreichen Anlage ist ein leerer Geltungsbereich ohnehin nicht erwartbar.
            Logger.LogWarning(
                "Reloading to {Uri} without a tenant segment: the permission scope is still empty after Refresh, although a tenant was just created for this user.",
                Nav.Uri);
            return Nav.Uri;
        }

        // Ueber BaseUri und nicht root-absolut: der Praefix, den eine vorgelagerte Middleware bereits aus dem
        // Pfad genommen hat - die Kultur aus UseCulturePath(), ein virtuelles Verzeichnis -, steckt dort drin
        // und ginge bei "/{prefix}/..." verloren. BaseUri endet immer auf "/".
        var baseUri = Nav.BaseUri;
        if (baseUri.EndsWith($"/{prefix}/", StringComparison.Ordinal))
        {
            // Die Seite steht schon im Mandantenkontext; ein zweites Segment ergaebe "/ADM/ADM/Account/...".
            return Nav.Uri;
        }

        return $"{baseUri}{prefix}/{PageRoute}";
    }

    private async Task ReloadAsync()
    {
        loading = true;
        try
        {
            var state = await AuthState.GetAuthenticationStateAsync();
            if (state.User.Identity?.IsAuthenticated == true)
            {
                tenants = await Handler.ListMyTenantsAsync(state.User);
            }
        }
        finally
        {
            loading = false;
        }
    }

    private async Task AcceptAsync(ParticipatingTenantViewModel item)
    {
        var state = await AuthState.GetAuthenticationStateAsync();
        var ok = await Handler.AcceptInvitationAsync(state.User, item.BillingProfileId);
        if (ok)
        {
            Snackbar.Add(L["Onb_InvitationAccepted"], Severity.Success);
            await ReloadAsync();
        }
        else
        {
            Snackbar.Add(L["Onb_AcceptFailed"], Severity.Error);
        }
    }
}
