@*
    Die Einstellungen der Definition als Ganzes - alles, was nicht an einem Knoten haengt. Ein eigener
    Dialog statt weiterer Felder in der Werkzeugleiste: die ist eine Zeile, und diese Einstellungen sind
    seltene, erklaerungsbeduerftige Griffe. Id/Name/Version bleiben in der Leiste - die aendert man
    tatsaechlich staendig.

    Der Dialog aendert das Definitions-Objekt direkt (wie die Knoten-Editoren auch); gespeichert wird
    erst mit dem Speichern der Definition.
*@

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">
            <MudIcon Icon="@Icons.Material.Filled.Tune" Class="mr-2" />
            <span>Workflow settings</span>
        </MudText>
    </TitleContent>
    <DialogContent>
        @if (Def is not null)
        {
            <WorkflowPrioritySelect Value="@Def.DefaultPriority" ValueChanged="OnPriorityChanged"
                                    Label="Default priority for new instances"
                                    InheritLabel="(Normal)"
                                    HelperText="How urgently background workers pick up instances of this workflow. Whoever starts an instance can override it." />

            <MudDivider Class="my-4" />

            @* Sichtbarkeit: die folgenreichste Einstellung dieses Dialogs, deshalb mit Ansage statt als
               Schalter unter vielen. Ohne die Berechtigung gar nicht erst bedienbar - der Server weist
               es ohnehin ab, aber ein Schalter, der beim Speichern still nichts tut, waere schlimmer. *@
            <MudText Typo="Typo.subtitle2">Visibility</MudText>
            <MudRadioGroup T="bool" Value="@(Def.IsPublic)" ValueChanged="OnVisibilityChanged">
                <MudRadio T="bool" Value="false" Dense="true">This tenant only</MudRadio>
                <MudRadio T="bool" Value="true" Dense="true" Disabled="@(!CanPublish)">
                    Public — every tenant can see and start it
                </MudRadio>
            </MudRadioGroup>
            @if (!CanPublish)
            {
                <MudText Typo="Typo.caption" Class="mud-text-secondary">
                    Creating or changing a public workflow needs the <b>Workflow.DesignPublic</b>
                    permission.
                </MudText>
            }
            else
            {
                <MudText Typo="Typo.caption" Class="mud-text-secondary">
                    A public workflow belongs to nobody in particular: every tenant sees it, can start it,
                    and every change reaches all of them at once. A tenant that needs its own variant
                    creates one under the same id — it then takes precedence over the public one for that
                    tenant. Running instances are unaffected; they stay on the definition they started on.
                </MudText>
            }

            @* Wer die Definition VERWENDEN darf. Nur fuer den Sysadmin bedienbar - es ist eine Aussage
               ueber alle Mandanten, nicht ueber diesen einen. Wie bei der Sichtbarkeit gilt: lieber gar
               kein Feld als eines, das beim Speichern still nichts tut. *@
            @if (CanGate)
            {
                <MudDivider Class="my-4" />
                <MudText Typo="Typo.subtitle2">Who may use it</MudText>

                <MudTextField @bind-Value="Def.RequiredFeature" Label="Required feature"
                              Margin="Margin.Dense" Clearable="true"
                              HelperText="@("Empty = none required.")" />
                <MudText Typo="Typo.caption" Class="mud-text-secondary">
                    Hangs on the <b>tenant</b> and is therefore the one condition that is checked
                    <b>on every run</b>, not just when somebody takes the workflow over — a scheduled run
                    has no user. If the feature lapses, the schedule pauses and writes that to the log; it
                    resumes by itself once the feature is back, and stays ticked in the meantime.
                </MudText>

                <MudTextField @bind-Value="Def.RequiredPermission" Label="Required permission"
                              Margin="Margin.Dense" Clearable="true" Class="mt-3"
                              HelperText="@("Empty = none required.")" />
                <MudText Typo="Typo.caption" Class="mud-text-secondary">
                    Hangs on a <b>user</b> and gates taking the workflow over and starting it by hand.
                    It cannot be checked when a schedule fires — there is nobody to check. Taking the
                    permission away from somebody therefore does <b>not</b> undo a takeover he set earlier.
                </MudText>
            }

            <MudDivider Class="my-4" />

            <MudSelect T="HistorySeverity?" Value="@Def.MinHistorySeverity" ValueChanged="OnSeverityChanged"
                       Label="Execution log detail" Dense="true" Margin="Margin.Dense" Clearable="true">
                <MudSelectItem T="HistorySeverity?" Value="@((HistorySeverity?)null)">(as configured for the host)</MudSelectItem>
                <MudSelectItem T="HistorySeverity?" Value="@((HistorySeverity?)HistorySeverity.Verbose)">Everything — every step entered and completed</MudSelectItem>
                <MudSelectItem T="HistorySeverity?" Value="@((HistorySeverity?)HistorySeverity.Info)">Milestones — start, waits, signals, joins, end</MudSelectItem>
                <MudSelectItem T="HistorySeverity?" Value="@((HistorySeverity?)HistorySeverity.Warning)">Only warnings and errors</MudSelectItem>
                <MudSelectItem T="HistorySeverity?" Value="@((HistorySeverity?)HistorySeverity.Error)">Only errors</MudSelectItem>
            </MudSelect>
            <MudText Typo="Typo.caption" Class="mud-text-secondary">
                Entries below this level are never written for instances of this workflow — they are not just
                hidden, they never reach the database. Errors always get through, whatever is set here.
            </MudText>

            <MudDivider Class="my-4" />

            @* Aufbewahrung. Die einzige Einstellung in diesem Dialog, an der das LOESCHEN von Daten
               haengt - deshalb sagt die Erklaerung zuerst, dass leer nichts bedeutet. *@
            <MudText Typo="Typo.subtitle2">Retention</MudText>
            <MudText Typo="Typo.caption" Class="mud-text-secondary">
                Leave both empty and nothing is ever cleaned up — whoever configures nothing loses nothing.
                Both periods are counted <b>from the moment a process ends</b>, not from its start:
                otherwise a process that runs for a year would archive itself mid-flight. <b>0</b> is a
                valid setting and means „right after it ends".
            </MudText>

            <div class="d-flex gap-4 mt-3">
                <MudNumericField T="int?" @bind-Value="Def.RetentionDays" Label="Archive after (days)"
                                 Min="0" Clearable="true" Margin="Margin.Dense"
                                 HelperText="@("Empty = the host's default")" />
                <MudNumericField T="int?" @bind-Value="Def.AttachmentRetentionDays"
                                 Label="Drop attachment contents after (days)"
                                 Min="0" Clearable="true" Margin="Margin.Dense"
                                 HelperText="@("Empty = the host's default")" />
            </div>
            <MudText Typo="Typo.caption" Class="mud-text-secondary">
                Two periods, because files may go earlier than the process they belonged to. What is
                deleted are the <b>contents</b>; the description of an attachment — name, size, who, when —
                always stays, otherwise the archived process could not even say „there was a file here".
            </MudText>

            <MudSwitch T="bool" @bind-Value="Def.AllowTenantRetentionOverride" Color="Color.Primary"
                       Class="mt-3" Label="A tenant may set its own periods" />
            <MudText Typo="Typo.caption" Class="mud-text-secondary">
                Off by default, and deliberately so: a period a tenant can quietly overrule is not a
                period. An objection raised while this is off is <b>not rejected</b> — it stays and takes
                effect the moment you allow it.
            </MudText>

            @if (Def.AllowTenantRetentionOverride)
            {
                <MudText Typo="Typo.caption" Class="mt-3">
                    How far a tenant may go. Empty = no limit in that direction.
                </MudText>
                <div class="d-flex gap-4">
                    <MudNumericField T="int?" @bind-Value="Def.MinTenantRetentionDays"
                                     Label="Archive: at least (days)" Min="0" Clearable="true"
                                     Margin="Margin.Dense" />
                    <MudNumericField T="int?" @bind-Value="Def.MaxTenantRetentionDays"
                                     Label="Archive: at most (days)" Min="0" Clearable="true"
                                     Margin="Margin.Dense" />
                </div>
                <div class="d-flex gap-4 mt-2">
                    <MudNumericField T="int?" @bind-Value="Def.MinTenantAttachmentRetentionDays"
                                     Label="Attachments: at least (days)" Min="0" Clearable="true"
                                     Margin="Margin.Dense" />
                    <MudNumericField T="int?" @bind-Value="Def.MaxTenantAttachmentRetentionDays"
                                     Label="Attachments: at most (days)" Min="0" Clearable="true"
                                     Margin="Margin.Dense" />
                </div>
                <MudText Typo="Typo.caption" Class="mud-text-secondary">
                    A wish outside these bounds is <b>limited, not thrown away</b> — and the tenant is told
                    that it was. The bounds limit only the tenant's objection, never the periods above:
                    those are the norm, and a workflow may well be stricter with itself than with others.
                </MudText>
            }
        }
    </DialogContent>
    <DialogActions>
        <MudSpacer />
        <MudButton Color="Color.Primary" OnClick="Close">Close</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;

    /// <summary>Die bearbeitete Definition. Wird direkt geändert (gespeichert wird sie vom Editor).</summary>
    [Parameter] public WorkflowDefinition? Def { get; set; }

    /// <summary>Ob der Benutzer öffentliche Definitionen anlegen/ändern darf (Workflow.DesignPublic).</summary>
    [Parameter] public bool CanPublish { get; set; }

    /// <summary>
    /// Ob der Benutzer Feature und Berechtigung der Definition festlegen darf (Sysadmin). Bewusst
    /// getrennt von <see cref="CanPublish"/>: eine öffentliche Definition zu <b>modellieren</b> ist eine
    /// fachliche Handlung, festzulegen <b>wer sie bekommt</b> eine betriebliche.
    /// </summary>
    [Parameter] public bool CanGate { get; set; }

    /// <summary>
    /// Umschalten der Sichtbarkeit. „Öffentlich" heisst: kein Mandant — beides zugleich wäre ein
    /// Widerspruch, und die Ablage weist ihn ab.
    /// </summary>
    private void OnVisibilityChanged(bool isPublic)
    {
        if (Def is null)
        {
            return;
        }

        Def.IsPublic = isPublic;
        if (isPublic)
        {
            Def.TenantId = null;
        }
    }

    private void OnPriorityChanged(int? value)
    {
        if (Def is not null)
        {
            Def.DefaultPriority = value;
        }
    }

    private void OnSeverityChanged(HistorySeverity? value)
    {
        if (Def is not null)
        {
            Def.MinHistorySeverity = value;
        }
    }

    private void Close() => MudDialog.Close(DialogResult.Ok(true));
}
