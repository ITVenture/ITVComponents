@page "/Account/Shares"
@rendermode @(RenderMode.InteractiveServer)
@attribute [Microsoft.AspNetCore.Authorization.Authorize]

@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.Extensions.Localization
@using ITVComponents.WebCoreToolkit.Security.SharedAssets

@inject ISharedAssetAdminHandler Handler
@inject AuthenticationStateProvider AuthState
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject NavigationManager Navigation
@inject IStringLocalizer<ShareMessages> L

<PageTitle>@L["Shares_PageTitle"]</PageTitle>

<MudText Typo="Typo.h5" GutterBottom="true">@L["Shares_PageTitle"]</MudText>

@if (currentUser is null)
{
    <MudProgressCircular Indeterminate="true" />
}
else
{
    <MudDataGrid T="SharedAssetListItem"
                 @ref="grid"
                 ServerData="LoadData"
                 SortMode="SortMode.None"
                 RowsPerPage="25"
                 Hover="true"
                 Dense="true">
        <ToolBarContent>
            <CrudGridToolbar OnRefresh="ReloadGrid" Title="@L["Shares_PageTitle"]" @bind-Search="search" OnSearch="ReloadGrid" />
        </ToolBarContent>
        <Columns>
            <PropertyColumn Property="x => x.AssetTitle" Title="@L["Shares_ColTitle"]" />
            <PropertyColumn Property="x => x.TemplateTitle" Title="@L["Shares_ColTemplate"]" />
            <TemplateColumn T="SharedAssetListItem" Title="@L["Shares_ColPointsAt"]" Sortable="false">
                <CellTemplate>
                    @if (string.IsNullOrEmpty(context.Item.ArgumentSummary))
                    {
                        @* Ohne Argumente gilt die Freigabe fuer alles, was die Pfadmuster der Vorlage
                           zulassen - das muss man sehen koennen. *@
                        <MudTooltip Text="@L["Shares_NoBinding"]">
                            <MudText Typo="Typo.body2" Color="Color.Warning">@context.Item.RootPath</MudText>
                        </MudTooltip>
                    }
                    else
                    {
                        <MudText Typo="Typo.body2">@context.Item.ArgumentSummary</MudText>
                    }
                </CellTemplate>
            </TemplateColumn>
            <TemplateColumn T="SharedAssetListItem" Title="@L["Shares_ColReach"]" Sortable="false">
                <CellTemplate>
                    <MudStack Row="true" Spacing="1">
                        @if (context.Item.IsAnonymous)
                        {
                            <MudChip T="string" Size="Size.Small" Color="Color.Warning">@L["Shares_ChipAnonymous"]</MudChip>
                        }
                        @if (context.Item.IsPublic)
                        {
                            <MudChip T="string" Size="Size.Small" Color="Color.Error">@L["Shares_ChipEveryone"]</MudChip>
                        }
                        @if (!string.IsNullOrEmpty(context.Item.RecipientLabel))
                        {
                            <MudChip T="string" Size="Size.Small">@context.Item.RecipientLabel</MudChip>
                        }
                    </MudStack>
                </CellTemplate>
            </TemplateColumn>
            <TemplateColumn T="SharedAssetListItem" Title="@L["Shares_ColValid"]" Sortable="false">
                <CellTemplate>@Validity(context.Item)</CellTemplate>
            </TemplateColumn>
            <TemplateColumn T="SharedAssetListItem" Title="" Sortable="false">
                <CellTemplate>
                    <MudStack Row="true" Spacing="1">
                        <MudTooltip Text="@L["Shares_ShowLink"]">
                            <MudIconButton Icon="@Icons.Material.Filled.Link" Size="Size.Small"
                                           OnClick="@(() => ShowLink(context.Item))" />
                        </MudTooltip>
                        <MudTooltip Text="@L["Share_Edit"]">
                            <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small"
                                           OnClick="@(() => Edit(context.Item))" />
                        </MudTooltip>
                        @if (context.Item.IsAnonymous)
                        {
                            <MudTooltip Text="@L["Shares_InvalidateTooltip"]">
                                <MudIconButton Icon="@Icons.Material.Filled.Autorenew" Size="Size.Small"
                                               OnClick="@(() => Rotate(context.Item))" />
                            </MudTooltip>
                        }
                        <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error"
                                       OnClick="@(() => Delete(context.Item))" />
                    </MudStack>
                </CellTemplate>
            </TemplateColumn>
        </Columns>
        <PagerContent>
            <MudDataGridPager T="SharedAssetListItem" />
        </PagerContent>
    </MudDataGrid>
}

@code {
    private MudDataGrid<SharedAssetListItem>? grid;
    private System.Security.Claims.ClaimsPrincipal? currentUser;
    private string? search;

    protected override async Task OnInitializedAsync()
    {
        var auth = await AuthState.GetAuthenticationStateAsync();
        currentUser = auth.User;
    }

    private string Origin => new Uri(Navigation.BaseUri).GetLeftPart(UriPartial.Authority);

    private async Task<GridData<SharedAssetListItem>> LoadData(GridState<SharedAssetListItem> state, CancellationToken ct)
    {
        if (currentUser is null) return new GridData<SharedAssetListItem> { Items = Array.Empty<SharedAssetListItem>(), TotalItems = 0 };
        var result = await Handler.ListAsync(currentUser, state.ToListQuery(search));
        return new GridData<SharedAssetListItem> { Items = result.Items, TotalItems = result.TotalCount };
    }

    private async Task ReloadGrid()
    {
        if (grid is not null) await grid.ReloadServerData();
    }

    private string Validity(SharedAssetListItem item)
    {
        if (item.NotBefore == null && item.NotAfter == null) return L["Shares_Unlimited"];
        var from = item.NotBefore?.ToString("d") ?? "…";
        var to = item.NotAfter?.ToString("d") ?? "…";
        return $"{from} – {to}";
    }

    private async Task ShowLink(SharedAssetListItem item)
    {
        var link = await Handler.GetLinkAsync(currentUser!, item.AssetKey, item.IsAnonymous, Origin);
        if (string.IsNullOrEmpty(link))
        {
            Snackbar.Add(L["Shares_LinkNotBuilt"], Severity.Warning);
            return;
        }

        var parameters = new DialogParameters<ShareLinkDialog>
        {
            { d => d.Link, link },
            { d => d.Title, item.AssetTitle }
        };
        await DialogService.ShowAsync<ShareLinkDialog>(L["Share_LinkDialogTitle"], parameters, EditDialogDefaults.Edit);
    }

    private async Task Edit(SharedAssetListItem item)
    {
        var model = await Handler.GetForEditAsync(currentUser!, item.AssetKey);
        if (model is null)
        {
            // Die vollen Angaben gibt es nur mit den Rechten der Vorlage - wer sie nicht hat, sieht die
            // Zeile zwar, darf sie aber nicht aendern.
            Snackbar.Add(L["Shares_NotEditable"], Severity.Warning);
            return;
        }

        var parameters = new DialogParameters<SharedAssetEditDialog> { { d => d.Model, model } };
        var dlg = await DialogService.ShowAsync<SharedAssetEditDialog>(L["Shares_EditTitle"], parameters, EditDialogDefaults.Edit);
        var result = await dlg.Result;
        if (result is { Canceled: false, Data: SharedAssetEditViewModel input })
        {
            if (await Handler.UpdateAsync(currentUser!, input))
            {
                Snackbar.Add(L["Shares_Updated"], Severity.Success);
                await ReloadGrid();
            }
            else
            {
                Snackbar.Add(L["Shares_UpdateFailed"], Severity.Error);
            }
        }
    }

    private async Task Rotate(SharedAssetListItem item)
    {
        var ok = await DialogService.ShowMessageBoxAsync(L["Shares_InvalidateTitle"],
            L["Shares_InvalidateConfirm", item.AssetTitle],
            yesText: L["Shares_Invalidate"], cancelText: L["Share_Cancel"]);
        if (ok != true) return;
        if (await Handler.RotateAsync(currentUser!, item.AssetKey))
        {
            Snackbar.Add(L["Shares_Invalidated"], Severity.Success);
            await ReloadGrid();
        }
        else
        {
            Snackbar.Add(L["Shares_InvalidateFailed"], Severity.Error);
        }
    }

    private async Task Delete(SharedAssetListItem item)
    {
        var ok = await DialogService.ShowMessageBoxAsync(L["Shares_DeleteTitle"],
            L["Shares_DeleteConfirm", item.AssetTitle], yesText: L["Share_Delete"], cancelText: L["Share_Cancel"]);
        if (ok != true) return;
        if (await Handler.DeleteAsync(currentUser!, item.AssetKey))
        {
            Snackbar.Add(L["Shares_Deleted"], Severity.Success);
            await ReloadGrid();
        }
        else
        {
            Snackbar.Add(L["Shares_DeleteFailed"], Severity.Error);
        }
    }
}
