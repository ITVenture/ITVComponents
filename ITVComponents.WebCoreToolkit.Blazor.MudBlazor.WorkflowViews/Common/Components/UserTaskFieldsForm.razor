@inject IStringLocalizer<WorkflowTaskMessages> L

@*
    Die Feld-Deklaration einer Aufgabe als Maske - der Rendervorgang selbst liegt seit der Extraktion in
    DeclaredFieldsForm (gemeinsames Basispaket), das dieselbe Maske auch fuer die Zusatzangaben im
    Onboarding zeichnet. Hier bleibt nur, was workflow-spezifisch ist: die Projektion von UserTaskField
    auf das neutrale Modell und die Texte aus den Sprachdateien dieses Moduls.

    Warum die Projektion und kein gemeinsames Interface: UserTaskField liegt in der Workflow-Engine, die
    weder das WebCoreToolkit noch Blazor kennt. Ein Interface aus dem Basispaket haette ihr diese
    Abhaengigkeit angehaengt - die Richtung waere falsch herum.
*@

<DeclaredFieldsForm @ref="inner"
                    Fields="Declared"
                    Prefill="Prefilled"
                    TranslateText="TranslateText"
                    AllowReadOnly="AllowReadOnly"
                    ResetKey="@ResetKey"
                    RequiredFieldMessage="@(L["RequiredField"])"
                    YesText="@(L["Yes"])"
                    NoText="@(L["No"])" />

@code {
    /// <summary>Die zu rendernde Feld-Deklaration.</summary>
    [Parameter] public IReadOnlyList<UserTaskField>? Fields { get; set; }

    /// <summary>
    /// Die Werte, aus denen vorbelegt (und bei ReadOnly-Feldern angezeigt) wird. Null = keine
    /// Vorbelegung - so laeuft der Start-Dialog, bei dem es noch nichts gibt, woraus vorzubelegen waere.
    /// </summary>
    [Parameter] public IReadOnlyDictionary<string, object>? Payload { get; set; }

    /// <summary>
    /// Uebersetzt Beschriftung/Hilfetext (Klartext oder Kultur-JSON) in die Kultur des Lesers. Null = der
    /// Wert wird unveraendert angezeigt.
    /// </summary>
    [Parameter] public Func<string?, string?>? TranslateText { get; set; }

    /// <summary>
    /// Duerfen Nur-Anzeige-Felder erscheinen? Beim Start nein: ReadOnly bezieht sich auf einen Payload,
    /// den es vor der Instanz noch nicht gibt - ein leeres Feld waere dort nur verwirrend.
    /// </summary>
    [Parameter] public bool AllowReadOnly { get; set; } = true;

    /// <summary>
    /// Wechselt dieser Schluessel, wird neu vorbelegt (neue Aufgabe / andere Definition). Ohne ihn wuerde
    /// jedes Rendern die Eingaben des Benutzers wieder mit der Vorbelegung ueberschreiben.
    /// </summary>
    [Parameter] public string? ResetKey { get; set; }

    private DeclaredFieldsForm? inner;
    private IReadOnlyList<DeclaredField>? declared;
    private IReadOnlyList<UserTaskField>? declaredFor;
    private IReadOnlyDictionary<string, object?>? prefill;
    private IReadOnlyDictionary<string, object>? prefillFor;

    /// <summary>
    /// Die projizierte Deklaration. Gepuffert, damit nicht jedes Rendern eine neue Liste erzeugt - der
    /// Renderer haengt seine Vorbelegung am ResetKey auf, nicht an der Identitaet dieser Liste, aber die
    /// Projektion umsonst zu wiederholen waere trotzdem Verschwendung.
    /// </summary>
    private IReadOnlyList<DeclaredField>? Declared
    {
        get
        {
            if (!ReferenceEquals(declaredFor, Fields))
            {
                declaredFor = Fields;
                declared = Fields?.Where(f => f is not null).Select(Project).ToArray();
            }

            return declared;
        }
    }

    private IReadOnlyDictionary<string, object?>? Prefilled
    {
        get
        {
            if (!ReferenceEquals(prefillFor, Payload))
            {
                prefillFor = Payload;
                prefill = Payload?.ToDictionary(p => p.Key, p => (object?)p.Value, StringComparer.Ordinal);
            }

            return prefill;
        }
    }

    /// <summary>
    /// Sammelt das Ergebnis ein und prueft die Pflichtfelder. Liefert false samt angezeigter Meldung, wenn
    /// etwas fehlt - der Aufrufer schliesst dann nicht ab.
    /// </summary>
    public bool TryGetResult(out Dictionary<string, object> result)
    {
        result = new Dictionary<string, object>(StringComparer.Ordinal);
        if (inner is null || !inner.TryGetResult(out Dictionary<string, object?> raw))
        {
            return false;
        }

        foreach (KeyValuePair<string, object?> entry in raw)
        {
            result[entry.Key] = entry.Value!;
        }

        return true;
    }

    private static DeclaredField Project(UserTaskField field)
        => new DeclaredField
        {
            Name = field.Name,
            Label = field.Label,
            Kind = Project(field.Kind),
            Required = field.Required,
            ReadOnly = field.ReadOnly,
            HelpText = field.HelpText,
            PrefillName = field.PayloadName,
            Choices = field.Choices?.Where(c => c is not null)
                .Select(c => new DeclaredChoice { Value = c.Value, Label = c.Label }).ToArray()
        };

    // Bewusst ausgeschrieben und nicht gecastet: die beiden Aufzaehlungen sind heute deckungsgleich, aber
    // sie gehoeren verschiedenen Paketen - ein spaeterer Eintrag auf einer Seite wuerde sonst still den
    // falschen Feldtyp rendern.
    private static DeclaredFieldKind Project(UserTaskFieldKind kind)
        => kind switch
        {
            UserTaskFieldKind.MultilineText => DeclaredFieldKind.MultilineText,
            UserTaskFieldKind.Number => DeclaredFieldKind.Number,
            UserTaskFieldKind.Boolean => DeclaredFieldKind.Boolean,
            UserTaskFieldKind.Date => DeclaredFieldKind.Date,
            UserTaskFieldKind.Choice => DeclaredFieldKind.Choice,
            _ => DeclaredFieldKind.Text
        };
}
