<Project Sdk="Microsoft.NET.Sdk" ToolsVersion="15.0">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <Version>5.0.0-PRE265</Version>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <RepositoryUrl>https://github.com/ITVenture/ITVComponents</RepositoryUrl>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>
  <ItemGroup>
    <!-- Bewusst ohne das NuGet-Paket "SumUp": gebraucht werden sechs REST-Aufrufe, und jeder davon muss mit
         dem Token DES MANDANTEN laufen und das Affiliate-Feld mitschicken. Ein eigener HttpClient haelt beides
         in der Hand, statt einen SDK-Client je Mandant und Aufruf aufzubauen. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.13" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\ITVComponents.WebCoreToolkit.EntityFramework.Billing\ITVComponents.WebCoreToolkit.EntityFramework.Billing.csproj" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="ITVComponents.WebCoreToolkit.Billing.Test" />
  </ItemGroup>
</Project>