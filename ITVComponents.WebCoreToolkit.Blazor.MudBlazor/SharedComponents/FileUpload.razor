@*
    Reusable, strategy-neutral file upload. Delegates all plugin-handling (resolve, authorize, AddFile,
    responding-handler payload) to the shared IFileServiceHandler — no MVC /File endpoint required.
    Validation feedback comes back as FileOperationResult; a responding handler's payload (e.g. a config
    diff) is surfaced via OnUploaded. The JS helper only opens the native picker.
*@
@namespace ITVComponents.WebCoreToolkit.Blazor.SharedComponents
@using System.IO
@using System.Text
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Components.Forms
@using ITVComponents.WebCoreToolkit.ServiceShared.FileHandling
@using ITVComponents.WebCoreToolkit.ServiceShared.Model
@using ITVComponents.WebCoreToolkit.ServiceShared.Options
@using ITVComponents.WebCoreToolkit.ServiceShared.Service
@using global::MudBlazor
@implements IAsyncDisposable
@inject IJSRuntime JS
@inject IFileServiceHandler FileService
@inject AuthenticationStateProvider AuthState

<MudPaper Class="pa-4" Outlined="true">
    <InputFile id="@inputId" OnChange="OnFilesSelected" multiple="@Multiple" accept="@Accept" style="display:none" />
    <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center">
        <MudButton StartIcon="@Icons.Material.Filled.AttachFile"
                   Variant="Variant.Filled"
                   Color="Color.Primary"
                   OnClick="PickFiles"
                   Disabled="@busy">
            @(Multiple ? MultiButtonText : ButtonText)
        </MudButton>
        @if (selected.Count > 0)
        {
            <MudText Typo="Typo.body2">@string.Join(", ", selected.Select(f => f.Name))</MudText>
        }
        @if (!AutoUpload && selected.Count > 0)
        {
            <MudButton StartIcon="@Icons.Material.Filled.CloudUpload" Color="Color.Secondary" OnClick="Upload" Disabled="@busy">Upload</MudButton>
        }
        @if (busy)
        {
            <MudProgressCircular Indeterminate="true" Size="Size.Small" />
        }
    </MudStack>
</MudPaper>

@code {
    /// <summary>Name of the FileHandler plugin that processes the upload (resolved in-process via DI).</summary>
    [Parameter, EditorRequired] public string UploadModule { get; set; } = "";

    /// <summary>Reason passed to the handler; drives the required-permission lookup.</summary>
    [Parameter, EditorRequired] public string UploadReason { get; set; } = "";

    /// <summary>Optional hint forwarded to the handler (e.g. an id when replacing a file).</summary>
    [Parameter] public string? UploadHint { get; set; }

    [Parameter] public bool Multiple { get; set; }

    /// <summary>File picker filter, e.g. ".json,.zip".</summary>
    [Parameter] public string? Accept { get; set; }

    /// <summary>Upload immediately after selection (default) or wait for an explicit Upload button.</summary>
    [Parameter] public bool AutoUpload { get; set; } = true;

    /// <summary>
    /// Hard per-file cap for the SignalR read-stream in bytes (default 50 MB). The authoritative upload limit is
    /// the server-side <c>MaxUploadSize</c> resolved from the upload-settings; this only bounds the read-stream.
    /// </summary>
    [Parameter] public long MaxFileSize { get; set; } = 50L * 1024 * 1024;

    [Parameter] public string ButtonText { get; set; } = "Choose file";
    [Parameter] public string MultiButtonText { get; set; } = "Choose files";

    /// <summary>Raised after each upload attempt with the handler's status and (optional) response payload.</summary>
    [Parameter] public EventCallback<FileUploadResult> OnUploaded { get; set; }

    private readonly string inputId = "itvup_" + Guid.NewGuid().ToString("N");
    private List<IBrowserFile> selected = new();
    private bool busy;
    private IJSObjectReference? module;

    private async Task EnsureModuleAsync()
        => module ??= await JS.InvokeAsync<IJSObjectReference>("import",
            "./_content/ITVComponents.WebCoreToolkit.Blazor.MudBlazor/file-transfer.js");

    private async Task PickFiles()
    {
        await EnsureModuleAsync();
        await module!.InvokeVoidAsync("clickInput", inputId);
    }

    private async Task OnFilesSelected(InputFileChangeEventArgs e)
    {
        selected = e.GetMultipleFiles(int.MaxValue).ToList();
        if (AutoUpload)
        {
            await Upload();
        }
    }

    private async Task Upload()
    {
        if (selected.Count == 0) return;
        busy = true;
        try
        {
            var result = await UploadInProcessAsync();
            await OnUploaded.InvokeAsync(result);
            if (result.Success)
            {
                selected.Clear();
            }
        }
        finally
        {
            busy = false;
        }
    }

    private async Task<FileUploadResult> UploadInProcessAsync()
    {
        var authState = await AuthState.GetAuthenticationStateAsync();

        // Resolve the upload-options from the scoped/global settings — identical resolution as the MVC host.
        var options = FileService.ResolveUploadOptions(UploadModule, UploadReason);

        // Reject oversize uploads up-front (analog to the MVC request-body-size limit).
        var totalSize = selected.Sum(f => f.Size);
        if (totalSize > options.MaxUploadSize)
        {
            return new FileUploadResult
            {
                Success = false,
                Message = $"Upload too large: {totalSize} bytes exceed the configured maximum of {options.MaxUploadSize} bytes."
            };
        }

        // OpenReadStream needs a per-file cap >= the file size; the total is already bounded by MaxUploadSize above.
        var openCap = Math.Max(options.MaxUploadSize, MaxFileSize);

        // Read the picked browser file(s) into the framework-neutral transport model the shared handler expects.
        var files = new List<ParsedMultipartFile>();
        foreach (var file in selected)
        {
            byte[] bytes;
            await using (var stream = file.OpenReadStream(openCap))
            using (var ms = new MemoryStream())
            {
                await stream.CopyToAsync(ms);
                bytes = ms.ToArray();
            }

            files.Add(new ParsedMultipartFile
            {
                FileName = file.Name,
                ContentType = file.ContentType,
                Content = bytes,
                IsFormData = false
            });
        }

        var result = await FileService.ProcessFileUpload(UploadModule, UploadReason, UploadHint,
            authState.User, files.ToArray(), options);

        switch (result.Code)
        {
            case FileOperationCode.OkWithContent when result.Success:
            {
                // surface a responding handler's payload (e.g. the configuration diff)
                var response = result.ReadResult;
                string payload = "";
                if (response?.FileContent is not null)
                {
                    try
                    {
                        using var reader = new StreamReader(response.FileContent, Encoding.UTF8);
                        payload = await reader.ReadToEndAsync();
                    }
                    finally
                    {
                        foreach (var d in response.DeferredDisposals)
                        {
                            try { d.Dispose(); } catch { }
                        }
                    }
                }

                return new FileUploadResult { Success = true, ContentType = response?.ContentType, Message = payload };
            }
            case FileOperationCode.OK when result.Success:
                return new FileUploadResult { Success = true, Message = "Upload complete." };
            case FileOperationCode.UnAuthorized:
            case FileOperationCode.Forbid:
                return new FileUploadResult { Success = false, Message = "Not authorized for this upload." };
            default:
                var message = result.Errors is { Count: > 0 }
                    ? string.Join(Environment.NewLine, result.Errors.Select(er => er.Message))
                    : "Upload failed.";
                return new FileUploadResult { Success = false, Message = message };
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (module is not null)
        {
            try { await module.DisposeAsync(); }
            catch (Microsoft.JSInterop.JSDisconnectedException) { }
            catch { }
        }
    }

    public sealed class FileUploadResult
    {
        public bool Success { get; set; }
        public string? ContentType { get; set; }
        public string? Message { get; set; }
    }
}
