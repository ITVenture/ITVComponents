@using Microsoft.AspNetCore.Components.Authorization

@inject IPermissionSetAdminHandler Handler
@inject AuthenticationStateProvider AuthState
@inject ISnackbar Snackbar

<SecureView RequiredPermissions="Apps.PermissionSets.View,Apps.PermissionSets.Write">
    <Permitted>
    <MudDataGrid T="AppPermissionAssignmentViewModel"
                 @ref="grid"
                 ServerData="LoadData"
                 SortMode="SortMode.None"
                 RowsPerPage="10"
                 Hover="true"
                 Dense="true">
        <ToolBarContent>
            @* Ohne Suche blaettert man bei einigen hundert globalen Berechtigungen zehn Zeilen weit -
               der Handler konnte laengst suchen, nur reichte die Maske nichts durch. *@
            <CrudGridToolbar OnRefresh="@(() => grid is null ? Task.CompletedTask : grid.ReloadServerData())"
                             Title="Permissions"
                             TitleTypo="Typo.subtitle2"
                             @bind-Search="search"
                             OnSearch="ReloadGrid" />
        </ToolBarContent>
        <Columns>
            <TemplateColumn T="AppPermissionAssignmentViewModel" Title="" Sortable="false">
                <CellTemplate>
                    <SecureView RequiredPermissions="Apps.PermissionSets.Write">
                        <Permitted>
                            <MudCheckBox T="bool"
                                         Value="context.Item.Assigned"
                                         ValueChanged="@(v => Toggle(context.Item, v))" />
                        </Permitted>
                        <NotPermitted>
                            <MudCheckBox T="bool"
                                         Value="context.Item.Assigned"
                                         Disabled="true" />
                        </NotPermitted>
                    </SecureView>
                </CellTemplate>
            </TemplateColumn>
            <PropertyColumn Property="x => x.PermissionName" Title="Permission" />
            <PropertyColumn Property="x => x.Description" Title="Description" />
        </Columns>
        <PagerContent>
            <MudDataGridPager T="AppPermissionAssignmentViewModel" />
        </PagerContent>
    </MudDataGrid>
    </Permitted>
    <NotPermitted>
        <MudAlert Severity="Severity.Info">No permission to view permission assignments.</MudAlert>
    </NotPermitted>
</SecureView>

@code {
    [Parameter, EditorRequired] public int AppPermissionSetId { get; set; }

    private MudDataGrid<AppPermissionAssignmentViewModel>? grid;
    private System.Security.Claims.ClaimsPrincipal? currentUser;
    private bool hasView;
    private bool hasWrite;
    private string? search;

    protected override async Task OnInitializedAsync()
    {
        var auth = await AuthState.GetAuthenticationStateAsync();
        currentUser = auth.User;
        hasView = Handler.HasPermission("Apps.PermissionSets.View", "Apps.PermissionSets.Write");
        hasWrite = Handler.HasPermission("Apps.PermissionSets.Write");
    }

    private async Task<GridData<AppPermissionAssignmentViewModel>> LoadData(GridState<AppPermissionAssignmentViewModel> state, CancellationToken ct)
    {
        if (currentUser is null || !hasView)
            return new GridData<AppPermissionAssignmentViewModel> { Items = Array.Empty<AppPermissionAssignmentViewModel>(), TotalItems = 0 };

        var query = new ListQuery { Page = state.Page, PageSize = state.PageSize, Search = search };
        var result = await Handler.ListPermissionsForSetAsync(currentUser, AppPermissionSetId, query);
        return new GridData<AppPermissionAssignmentViewModel> { Items = result.Items, TotalItems = result.TotalCount };
    }

    private async Task ReloadGrid()
    {
        if (grid is not null) await grid.ReloadServerData();
    }

    private async Task Toggle(AppPermissionAssignmentViewModel item, bool newValue)
    {
        if (!hasWrite || currentUser is null) return;
        var ok = await Handler.SetPermissionForSetAsync(currentUser, AppPermissionSetId, item.PermissionId, newValue);
        if (ok)
        {
            item.Assigned = newValue;
            Snackbar.Add(newValue ? "Permission assigned" : "Permission unassigned", Severity.Success);
        }
        else
        {
            Snackbar.Add("Failed to update assignment", Severity.Error);
            if (grid is not null) await grid.ReloadServerData();
        }
    }
}
