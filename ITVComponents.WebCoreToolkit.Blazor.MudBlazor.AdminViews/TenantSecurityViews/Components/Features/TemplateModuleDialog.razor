<EditDialogShell Model="Model" IsCreate="IsCreate" InvalidMessage="Please correct invalid fields">
    <MudTextField @bind-Value="Model.TemplateModuleName" Label="Module name" Required="true" MaxLength="255" />
</EditDialogShell>

@code {
    [Parameter, EditorRequired] public TemplateModuleViewModel Model { get; set; } = default!;
    [Parameter] public bool IsCreate { get; set; }
}
