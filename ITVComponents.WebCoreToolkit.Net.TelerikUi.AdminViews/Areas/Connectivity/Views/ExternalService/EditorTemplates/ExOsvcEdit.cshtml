@using ITVComponents.Helpers
@using ITVComponents.WebCoreToolkit.Extensions
@using ITVComponents.WebCoreToolkit.Models.ExternalServiceConnect
@using ITVComponents.WebCoreToolkit.Net.TelerikUi.AdminViews.Extensions
@using ITVComponents.WebCoreToolkit.Net.TelerikUi.AdminViews.TenantSecurityViews.Helpers
@using ITVComponents.WebCoreToolkit.Net.TelerikUi.AdminViews.TenantSecurityViews.Resources
@using ITVComponents.WebCoreToolkit.Net.TelerikUi.AdminViews.TenantSecurityViews.ViewModel
@using Kendo.Mvc.UI
@using ToolkitPermission = ITVComponents.WebCoreToolkit.EntityFramework.TenantSecurity.Shared.Helpers.ToolkitPermission
@model ITVComponents.WebCoreToolkit.Net.TelerikUi.AdminViews.TenantSecurityViews.ViewModel.ExternalOAuthServiceViewModel
@{
    var isAdmin = Context.RequestServices.VerifyUserPermissions(new[] { ToolkitPermission.Sysadmin });
    // Baum: die Definition laesst sich an Untermandanten weitergeben (kommt von der Dienstliste, Leitfaden §94)
    var definitionInheritance = ViewData["DefinitionInheritance"] is true;
    // data-auth-type lists the (two-digit) ExternalServiceAuthenticationType values for which a field is visible:
    // 00 AuthorizationFlow, 01 ClientCredentials, 02 BasicClientCredentials, 03 Basic, 04 ApiKey, 05 BearerToken, 06 PasswordFlow
}
<div class="container col">
    @Html.HiddenFor(model => model.OAuthServiceId)
    <div class="form-group row">
        @Html.LabelFor(model => model.AuthenticationType, TextsAndMessagesHelper.IWCN_ES_AuthenticationType, htmlAttributes: new { @class = "col-sm-4 col-form-label" })
        <div class="col-sm-8">
            @(Html.Kendo().DropDownListFor(n => n.AuthenticationType).BindTo(EnumHelper.DescribeEnum<ExternalServiceAuthenticationType>()).DataTextField(nameof(EnumHelper.EnumValueDescription.Description)).DataValueField(nameof(EnumHelper.EnumValueDescription.Value))
                .HtmlAttributes(new { style = "width:100%" })
                .Events(ev => ev.Select("ITVenture.Pages.ExternalOAuthServices.OnAuthTypeSelected"))
            )
        </div>
    </div>
    <div class="form-group row">
        @Html.LabelFor(model => model.UniqueConnectionName, TextsAndMessagesHelper.IWCN_ES_UniqueName, htmlAttributes: new { @class = "col-sm-4 col-form-label" })
        <div class="col-sm-8">
            @Html.Kendo().TextBoxFor(model => model.UniqueConnectionName).HtmlAttributes(new { required = "required", @class = "w-100" })
            @Html.ValidationMessageFor(model => model.UniqueConnectionName, "", new { @class = "text-danger" })
        </div>
    </div>
    @if (isAdmin)
    {
        <div class="form-group row">
            @Html.LabelFor(model => model.Global, TextsAndMessagesHelper.IWCN_ES_Global, htmlAttributes: new { @class = "col-sm-4 col-form-label" })
            <div class="col-sm-8">
                @Html.Kendo().SwitchFor(model => model.Global)
            </div>
        </div>
        <div class="form-group row">
            @Html.LabelFor(model => model.AllowPlatformCredentials, TextsAndMessagesHelper.IWCN_ES_AllowPlatformCredentials, htmlAttributes: new { @class = "col-sm-4 col-form-label" })
            <div class="col-sm-8">
                @Html.Kendo().SwitchFor(model => model.AllowPlatformCredentials)
            </div>
        </div>
    }

    @if (definitionInheritance)
    {
        @* Nur die Definition - ob Untermandanten auch das Konto mitbenutzen, steht im Reiter "Zugangsdaten". Bei einem
           globalen Dienst wirkungslos (er ist fuer alle da) und beim Speichern ignoriert. *@
        <div class="form-group row">
            @Html.LabelFor(model => model.Inheritable, TextsAndMessagesHelper.IWCN_ES_DefinitionInheritable, htmlAttributes: new { @class = "col-sm-4 col-form-label" })
            <div class="col-sm-8">
                @Html.Kendo().SwitchFor(model => model.Inheritable)
                <small class="form-text text-muted">@TextsAndMessagesHelper.IWCN_ES_DefinitionInheritableHint</small>
            </div>
        </div>
    }

    @* Die direkten Grants (01, 02, 06) holen ihr Token am Token-Endpunkt (Leitfaden §90) - der Authorization-Endpunkt
       gehoert nur zum Authorization-Code-Flow. *@
    <div class="form-group row authTypeControlContainer" data-auth-type="00">
        @Html.LabelFor(model => model.AuthorizationEndpoint, TextsAndMessagesHelper.IWCN_ES_AuthEndpoint, htmlAttributes: new { @class = "col-sm-4 col-form-label authTypeConfig authLabel", Data_Auth_Type = "00" })
        <div class="col-sm-8">
            @Html.Kendo().TextBoxFor(model => model.AuthorizationEndpoint).HtmlAttributes(new { required = "required", @class = "authTypeConfig w-100", Data_Auth_Type = "00", Data_Auth_Required = "true" })
            @Html.ValidationMessageFor(model => model.AuthorizationEndpoint, "", new { @class = "text-danger" })
        </div>
    </div>
    <div class="form-group row authTypeControlContainer" data-auth-type="00.01.02.06">
        @Html.LabelFor(model => model.TokenEndpoint, TextsAndMessagesHelper.IWCN_ES_TokenEndpoint, htmlAttributes: new { @class = "col-sm-4 col-form-label authTypeConfig authLabel", Data_Auth_Type = "00.01.02.06" })
        <div class="col-sm-8">
            @Html.Kendo().TextBoxFor(model => model.TokenEndpoint).HtmlAttributes(new { required = "required", @class = "authTypeConfig w-100", Data_Auth_Type = "00.01.02.06", Data_Auth_Required = "true" })
            @Html.ValidationMessageFor(model => model.TokenEndpoint, "", new { @class = "text-danger" })
        </div>
    </div>
    <div class="form-group row authTypeControlContainer" data-auth-type="00">
        @Html.LabelFor(model => model.RevocationEndpoint, TextsAndMessagesHelper.IWCN_ES_RevocationEndpoint, htmlAttributes: new { @class = "col-sm-4 col-form-label authTypeConfig authLabel", Data_Auth_Type = "00" })
        <div class="col-sm-8">
            @Html.Kendo().TextBoxFor(model => model.RevocationEndpoint).HtmlAttributes(new { @class = "authTypeConfig w-100", Data_Auth_Type = "00", Data_Auth_Required = "false" })
        </div>
    </div>
    @* ClientId gehoert nur bei Authorization-Code (App) und ApiKey (Header-Name) zur Definition; sonst ist es der Benutzer
       des Kontos und steht im Reiter "Zugangsdaten" (Leitfaden §93). *@
    <div class="form-group row authTypeControlContainer" data-auth-type="00.04">
        @Html.LabelFor(model => model.ClientId, TextsAndMessagesHelper.IWCN_ES_ClientId, htmlAttributes: new { @class = "col-sm-4 col-form-label authTypeConfig authLabel", Data_Auth_Type = "00.04", Data_Auth_Label = "labelForClientId" })
        <div class="col-sm-8">
            @Html.Kendo().TextBoxFor(model => model.ClientId).HtmlAttributes(new { required = "required", @class = "authTypeConfig w-100", Data_Auth_Type = "00.04", Data_Auth_Required = "true" })
            @Html.ValidationMessageFor(model => model.ClientId, "", new { @class = "text-danger" })
        </div>
    </div>
    <div class="form-group row authTypeControlContainer" data-auth-type="00">
        @Html.LabelFor(model => model.ClientSecret, TextsAndMessagesHelper.IWCN_ES_ClientSecret, htmlAttributes: new { @class = "col-sm-4 col-form-label authTypeConfig authLabel", Data_Auth_Type = "00", Data_Auth_Label = "labelForClientSecret" })
        <div class="col-sm-8">
            @Html.Kendo().TextBoxFor(model => model.ClientSecret).Placeholder("encrypt:...").HtmlAttributes(new { @class = "authTypeConfig w-100", Data_Auth_Type = "00", Data_Auth_Required = "false" })
            <small class="form-text text-muted">@TextsAndMessagesHelper.IWCN_ES_EncryptHint</small>
        </div>
    </div>
    <div class="form-group row authTypeControlContainer" data-auth-type="01.02.03.04.05.06">
        <div class="col-sm-12">
            <small class="form-text text-info">@TextsAndMessagesHelper.IWCN_ES_CredHint</small>
        </div>
    </div>
    <div class="form-group row authTypeControlContainer" data-auth-type="00.06">
        @Html.LabelFor(model => model.Scope, TextsAndMessagesHelper.IWCN_ES_Scope, htmlAttributes: new { @class = "col-sm-4 col-form-label authTypeConfig authLabel", Data_Auth_Type = "00.06" })
        <div class="col-sm-8">
            @Html.Kendo().TextBoxFor(model => model.Scope).HtmlAttributes(new { @class = "authTypeConfig w-100", Data_Auth_Type = "00.06", Data_Auth_Required = "00" })
            @Html.ValidationMessageFor(model => model.Scope, "", new { @class = "text-danger" })
        </div>
    </div>

</div>
