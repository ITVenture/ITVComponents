@page
@using Microsoft.Extensions.Localization
@using ITVComponents.WebCoreToolkit.IdentityShared.Areas.Identity.Pages.Account.Manage
@using Kendo.Mvc.TagHelpers
@using Microsoft.AspNetCore.Mvc.TagHelpers
@using FormTagHelper = Microsoft.AspNetCore.Mvc.TagHelpers.FormTagHelper
@using ITVComponents.WebCoreToolkit.IdentityShared.Services
@model SetPasswordModel
@inject IManageNavigator manageNavigator
@inject IStringLocalizer<IdentityMessages> localizer
@{
    ViewData["Title"] = localizer["Set password"];
    manageNavigator.ActivePage = "changePassword";
}
@{
    Layout = "_Layout.cshtml";
}

<h4>@localizer["Set your password"]</h4>
<partial name="_StatusMessage" for="StatusMessage" />
<p class="text-info">
    @localizer["You do not have a local username/password for this site. Add a local account so you can log in without an external login."]
</p>
<div class="row">
    <div class="col-md-6">
        <form id="set-password-form" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-group">
                <label asp-for="Input.NewPassword"></label>
                <input asp-for="Input.NewPassword" class="form-control" />
                <span asp-validation-for="Input.NewPassword" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Input.ConfirmPassword"></label>
                <input asp-for="Input.ConfirmPassword" class="form-control" />
                <span asp-validation-for="Input.ConfirmPassword" class="text-danger"></span>
            </div>
            <button type="submit" class="btn btn-primary">@localizer["Set password"]</button>
        </form>
    </div>
</div>