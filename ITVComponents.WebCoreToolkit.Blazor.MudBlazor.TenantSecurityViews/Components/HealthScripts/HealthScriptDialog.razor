<MudDialog>
    <DialogContent>
        <MudForm @ref="form" Model="Model">
            <MudTextField @bind-Value="Model.HealthScriptName" Label="Name" Required="true" RequiredError="Name is required" MaxLength="128" />
            <MudText Typo="Typo.caption" Class="mt-3" Color="@(scriptError ? Color.Error : Color.Default)">Script</MudText>
            <CodeEditor @ref="scriptEditor" Value="@Model.Script" Language="javascript" Height="400" />
            @if (scriptError)
            {
                <MudText Typo="Typo.caption" Color="Color.Error">Script is required</MudText>
            }
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Cancel</MudButton>
        <MudButton Color="Color.Primary" OnClick="Save">@(IsCreate ? "Create" : "Save")</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter, EditorRequired] public HealthScriptViewModel Model { get; set; } = default!;
    [Parameter] public bool IsCreate { get; set; }

    private MudForm? form;
    private CodeEditor? scriptEditor;
    private bool scriptError;

    private void Cancel() => MudDialog.Cancel();

    private async Task Save()
    {
        if (form is null) return;
        await form.Validate();
        if (scriptEditor is not null) Model.Script = await scriptEditor.GetValueAsync();
        scriptError = string.IsNullOrWhiteSpace(Model.Script);
        if (!form.IsValid || scriptError) return;
        MudDialog.Close(DialogResult.Ok(Model));
    }
}
