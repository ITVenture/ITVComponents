@page "/Account/ResendEmailConfirmation"
@rendermode @(RenderMode.InteractiveServer)

@using System.ComponentModel.DataAnnotations
@using System.Text
@using System.Text.Encodings.Web
@using Microsoft.AspNetCore.Identity.UI.Services
@using Microsoft.AspNetCore.WebUtilities
@using Microsoft.Extensions.Localization
@using ITVComponents.WebCoreToolkit.IdentityShared.Areas.Identity
@using ITVComponents.WebCoreToolkit.IdentityShared.Areas.Identity.Pages.Account

@inject IPageHandlerProvider<ResendEmailConfirmationModel, IResendEmailConfirmationHandler> HandlerProvider
@inject IEmailSender EmailSender
@inject IStringLocalizer<IdentityMessages> L
@inject NavigationManager Nav

<PageTitle>@L["Resend email confirmation"]</PageTitle>

<MudContainer MaxWidth="MaxWidth.Small" Class="mt-8">
    <MudPaper Elevation="2" Class="pa-6">
        <MudText Typo="Typo.h4" GutterBottom="true">@L["Resend email confirmation"]</MudText>

        @if (loading)
        {
            <MudProgressCircular Indeterminate="true" />
        }
        else if (!usePage)
        {
            <MudAlert Severity="Severity.Info">@L["This page is not available."]</MudAlert>
        }
        else
        {
            <MudText Typo="Typo.subtitle1" GutterBottom="true">@L["Enter your email."]</MudText>
            <MudDivider Class="my-3" />

            @if (!string.IsNullOrEmpty(statusMessage))
            {
                <MudAlert Severity="Severity.Info" Class="mb-3">@statusMessage</MudAlert>
            }

            <EditForm Model="Input" OnValidSubmit="OnSubmit">
                <ToolkitDataAnnotationsValidator />

                <MudTextField @bind-Value="Input.Email" Label="@L["Email"]" For="@(() => Input.Email)"
                              InputType="InputType.Email" autocomplete="username" Class="mb-3" />

                <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary" Disabled="@busy">
                    @L["Resend_Button"]
                </MudButton>
            </EditForm>
        }
    </MudPaper>
</MudContainer>

@code {
    private string? statusMessage;
    private bool busy;
    private bool loading = true;
    private bool usePage;

    private InputModel Input { get; set; } = new();

    protected override async Task OnInitializedAsync()
    {
        await using (var op = HandlerProvider.BeginOperation())
        {
            usePage = op.Handler.UsePage;
        }

        loading = false;
    }

    private async Task OnSubmit()
    {
        if (!usePage)
        {
            return;
        }

        await using var op = HandlerProvider.BeginOperation();

        busy = true;
        var user = await op.Handler.FetchUser(Input.Email);
        try
        {
            if (!user.UserExists)
            {
                statusMessage = L["Verification email sent. Please check your email."];
                return;
            }

            var mailToken = await op.Handler.GetMailToken(user);
            if (mailToken.Success)
            {
                var code = WebEncoders.Base64UrlEncode(Encoding.UTF8.GetBytes(mailToken.Code));
                var callbackUrl = Nav.ToAbsoluteUri(
                    Nav.GetUriWithQueryParameters("Account/ConfirmEmail",
                        new Dictionary<string, object?>
                        {
                            ["userId"] = mailToken.UserId,
                            ["code"] = code
                        })).ToString();

                await EmailSender.SendEmailAsync(
                    Input.Email,
                    L["Confirm your email"],
                    L["Please confirm your account by <a href='{0}'>clicking here</a>.",
                        HtmlEncoder.Default.Encode(callbackUrl)]);
            }

            statusMessage = L["Verification email sent. Please check your email."];
        }
        finally
        {
            op.Handler.ReleaseUser(user);
            busy = false;
        }
    }

    public sealed class InputModel
    {
        [Required]
        [EmailAddress(ErrorMessage = "ITV:DataTypeAttribute.EmailAddress_ValidationError")]
        public string Email { get; set; } = "";
    }
}
