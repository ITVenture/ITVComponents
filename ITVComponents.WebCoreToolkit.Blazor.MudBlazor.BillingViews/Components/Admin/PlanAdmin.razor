@page "/Billing/Plans"
@rendermode @(RenderMode.InteractiveServer)
@attribute [Microsoft.AspNetCore.Authorization.Authorize]

@inject IBillingHandler Handler
@inject AuthenticationStateProvider AuthState
@inject ISnackbar Snackbar

<PageTitle>Plans</PageTitle>

<MudText Typo="Typo.h5" GutterBottom="true">Billing plans</MudText>

@if (currentUser is null)
{
    <MudProgressCircular Indeterminate="true" />
}
else if (!canAdmin)
{
    <MudAlert Severity="Severity.Warning">You do not have permission to administer plans.</MudAlert>
}
else
{
    <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" Class="mb-3" OnClick="@(() => Edit(new PlanViewModel()))">
        New plan
    </MudButton>

    <MudTable Items="plans" Dense="true" Hover="true">
        <HeaderContent>
            <MudTh>Name</MudTh>
            <MudTh>Price</MudTh>
            <MudTh>Interval</MudTh>
            <MudTh>Active</MudTh>
            <MudTh>Provider price</MudTh>
            <MudTh></MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="Name">@context.Name</MudTd>
            <MudTd DataLabel="Price">@context.Amount.ToString("0.00") @(context.Currency ?? "EUR")</MudTd>
            <MudTd DataLabel="Interval">@context.BillingInterval</MudTd>
            <MudTd DataLabel="Active">@(context.IsActive ? "yes" : "no")</MudTd>
            <MudTd DataLabel="Provider price">@(string.IsNullOrEmpty(context.ProviderPriceId) ? "—" : context.ProviderPriceId)</MudTd>
            <MudTd>
                <MudStack Row="true" Spacing="1">
                    <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" OnClick="@(() => Edit(context))" />
                    <MudButton Size="Size.Small" StartIcon="@Icons.Material.Filled.CloudUpload" Disabled="@busy" OnClick="@(() => Push(context.PlanId))">
                        Push to Stripe
                    </MudButton>
                </MudStack>
            </MudTd>
        </RowTemplate>
    </MudTable>

    @if (editModel is not null)
    {
        <MudPaper Class="pa-4 mt-4" Outlined="true">
            <MudText Typo="Typo.h6">@(editModel.PlanId == 0 ? "New plan" : $"Edit: {editModel.Name}")</MudText>
            <MudGrid>
                <MudItem xs="12" sm="6"><MudTextField @bind-Value="editModel.Name" Label="Name" Required="true" /></MudItem>
                <MudItem xs="12" sm="6"><MudTextField @bind-Value="editModel.Description" Label="Description" /></MudItem>
                <MudItem xs="6" sm="3"><MudNumericField T="decimal" @bind-Value="editModel.Amount" Label="Amount" /></MudItem>
                <MudItem xs="6" sm="3"><MudTextField @bind-Value="editModel.Currency" Label="Currency" /></MudItem>
                <MudItem xs="6" sm="3">
                    <MudSelect T="BillingInterval" @bind-Value="editModel.BillingInterval" Label="Interval">
                        @foreach (var interval in System.Enum.GetValues<BillingInterval>())
                        {
                            <MudSelectItem T="BillingInterval" Value="@interval">@interval</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
                <MudItem xs="6" sm="3"><MudNumericField T="int?" @bind-Value="editModel.TrialDays" Label="Trial days" /></MudItem>
                <MudItem xs="12"><MudTextField @bind-Value="featureKeysText" Label="Feature keys (comma-separated)" /></MudItem>
                <MudItem xs="12"><MudCheckBox T="bool" @bind-Value="editModel.IsActive" Label="Active" /></MudItem>
            </MudGrid>
            <MudStack Row="true" Spacing="2" Class="mt-2">
                <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="@busy" OnClick="Save">Save</MudButton>
                <MudButton Variant="Variant.Text" OnClick="@(() => editModel = null)">Cancel</MudButton>
            </MudStack>
        </MudPaper>
    }
}

@code {
    private System.Security.Claims.ClaimsPrincipal? currentUser;
    private bool canAdmin;
    private bool busy;
    private IReadOnlyList<PlanViewModel> plans = System.Array.Empty<PlanViewModel>();
    private PlanViewModel? editModel;
    private string featureKeysText = "";

    protected override async Task OnInitializedAsync()
    {
        var auth = await AuthState.GetAuthenticationStateAsync();
        currentUser = auth.User;
        canAdmin = Handler.CanAdminister(currentUser);
        if (canAdmin)
        {
            await Reload();
        }
    }

    private async Task Reload() => plans = await Handler.GetAllPlansAsync();

    private void Edit(PlanViewModel model)
    {
        editModel = new PlanViewModel
        {
            PlanId = model.PlanId,
            Name = model.Name,
            Description = model.Description,
            Amount = model.Amount,
            Currency = model.Currency,
            BillingInterval = model.BillingInterval,
            TrialDays = model.TrialDays,
            IsActive = model.IsActive,
            FeatureKeys = new List<string>(model.FeatureKeys)
        };
        featureKeysText = string.Join(", ", editModel.FeatureKeys);
    }

    private async Task Save()
    {
        if (editModel is null)
        {
            return;
        }

        editModel.FeatureKeys = featureKeysText
            .Split(',', System.StringSplitOptions.RemoveEmptyEntries | System.StringSplitOptions.TrimEntries)
            .ToList();

        busy = true;
        try
        {
            await Handler.SavePlanAsync(editModel);
            Snackbar.Add("Plan saved.", Severity.Success);
            editModel = null;
            await Reload();
        }
        catch (System.Exception ex)
        {
            Snackbar.Add($"Save failed: {ex.Message}", Severity.Error);
        }
        finally
        {
            busy = false;
        }
    }

    private async Task Push(int planId)
    {
        busy = true;
        try
        {
            await Handler.PushPlanAsync(planId);
            Snackbar.Add("Pushed to Stripe.", Severity.Success);
            await Reload();
        }
        catch (System.Exception ex)
        {
            Snackbar.Add($"Push failed: {ex.Message}", Severity.Error);
        }
        finally
        {
            busy = false;
        }
    }
}
