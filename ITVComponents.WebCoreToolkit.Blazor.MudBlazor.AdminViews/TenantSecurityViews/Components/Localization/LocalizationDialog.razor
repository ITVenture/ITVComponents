<EditDialogShell Model="Model" IsCreate="IsCreate" InvalidMessage="Please correct invalid fields">
    <MudTextField @bind-Value="Model.Identifier" Label="Identifier (e.g. resource fully-qualified name)" Required="true" MaxLength="1024" />
</EditDialogShell>

@code {
    [Parameter, EditorRequired] public LocalizationViewModel Model { get; set; } = default!;
    [Parameter] public bool IsCreate { get; set; }
}
