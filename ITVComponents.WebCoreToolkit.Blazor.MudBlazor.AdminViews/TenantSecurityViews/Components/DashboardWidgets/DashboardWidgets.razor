@page "/Util/DashboardWidgets"
@rendermode @(RenderMode.InteractiveServer)
@attribute [Microsoft.AspNetCore.Authorization.Authorize]

@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.Extensions.Logging

@inject IDashboardWidgetAdminHandler Handler
@inject AuthenticationStateProvider AuthState
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject IJSRuntime JS
@inject ILogger<DashboardWidgets> Logger
@implements IAsyncDisposable

<PageTitle>Dashboard widgets</PageTitle>

<MudText Typo="Typo.h5" GutterBottom="true">Dashboard widgets</MudText>

<SecureView RequiredPermissions="DashboardWidgets.View,DashboardWidgets.Write" RequiredFeatures="ITVAdminViews">
    <Permitted>
@if (currentUser is null)
{
    <MudProgressCircular Indeterminate="true" />
}
else
{
    @* Kein data-itv-dnd-into: die Standard-Sammlung ist flach, eine Zeile kennt nur davor und
       dahinter. Das Ziehen ordnet die SortOrder, nach der die Sammlung fuer einen neuen Benutzer
       angelegt wird. *@
    <div @ref="hostEl" data-itv-dnd-host="@hostId">
    <MudDataGrid T="DashboardWidgetViewModel"
                 @ref="grid"
                 ServerData="LoadData"
                 SortMode="SortMode.Single"
                 RowsPerPage="25"
                 Hover="true"
                 Dense="true">
        <ToolBarContent>
            <RefreshButton OnClick="ReloadGrid" />
            <MudText Typo="Typo.h6">Dashboard widgets</MudText>
            <MudSpacer />
            <MudTextField @bind-Value="search"
                          Placeholder="Search…"
                          Adornment="Adornment.Start"
                          AdornmentIcon="@Icons.Material.Filled.Search"
                          IconSize="Size.Medium"
                          Class="mt-0"
                          DebounceInterval="300"
                          OnDebounceIntervalElapsed="ReloadGrid" />
            <SecureView RequiredPermissions="DashboardWidgets.Write">
                <Permitted>
                    <MudButton StartIcon="@Icons.Material.Filled.Add" Variant="Variant.Filled" Color="Color.Primary" Class="ml-2" OnClick="OpenCreate">
                        Add widget
                    </MudButton>
                </Permitted>
            </SecureView>
        </ToolBarContent>
        <Columns>
            @if (hasWrite)
            {
                <TemplateColumn T="DashboardWidgetViewModel" Title="" Sortable="false">
                    <CellTemplate>
                        @* Eine Zelle, Quelle UND Ziel - das JS entscheidet aus der Maus-Y-Position, ob
                           davor oder dahinter abgelegt wird. Der Griff bleibt stehen, wenn gerade nach
                           etwas anderem sortiert ist, ist aber stumpf: sonst haette der Benutzer eine
                           Reihenfolge vor Augen, die mit der berechneten Zielposition nichts zu tun hat. *@
                        @* draggable MUSS als Zeichenkette "true"/"false" gesetzt werden und darf kein
                           bool sein: Blazor rendert ein true als WERTLOSES Attribut, und draggable ist
                           in HTML kein boolesches, sondern ein aufzaehlendes Attribut - ohne ="true"
                           gilt "auto", und ein span ist damit nicht ziehbar. *@
                        <span draggable="@(canReorder ? "true" : "false")"
                              data-itv-dnd-id="@context.Item.DashboardWidgetId"
                              title="@(canReorder
                                         ? "Drag to change the order of the default collection"
                                         : "Sort by 'Sort order' ascending to rearrange by dragging")"
                              class="@(canReorder ? null : "mud-text-disabled")"
                              style="display:inline-flex;align-items:center;padding:0 4px;">
                            <MudIcon Icon="@Icons.Material.Filled.DragIndicator" Size="Size.Small" />
                        </span>
                    </CellTemplate>
                </TemplateColumn>
            }
            <HierarchyColumn T="DashboardWidgetViewModel" />
            <PropertyColumn Property="x => x.SystemName" Title="System name" />
            <PropertyColumn Property="x => x.DisplayName" Title="Display name" />
            <PropertyColumn Property="x => x.Area" Title="Area" />
            <PropertyColumn Property="x => x.SortOrder" Title="Sort order" />
            <TemplateColumn T="DashboardWidgetViewModel" Title="Initially active" Sortable="false">
                <CellTemplate>
                    @* Nur anzeigen, nicht hier umschalten: das Umschalten gehoert in den Dialog, damit es
                       mit dem uebrigen Speichern eine Operation bleibt. *@
                    @if (context.Item.InitiallyActive)
                    {
                        <MudIcon Icon="@Icons.Material.Filled.Check" Color="Color.Success" Size="Size.Small" />
                    }
                </CellTemplate>
            </TemplateColumn>
            <TemplateColumn T="DashboardWidgetViewModel" Title="" Sortable="false">
                <CellTemplate>
                    <SecureView RequiredPermissions="DashboardWidgets.Write">
                        <Permitted>
                        <MudStack Row="true" Spacing="1">
                            <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" OnClick="@(() => OpenEdit(context.Item))" />
                            <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error" OnClick="@(() => Delete(context.Item))" />
                        </MudStack>
                        </Permitted>
                    </SecureView>
                </CellTemplate>
            </TemplateColumn>
        </Columns>
        <ChildRowContent>
            <MudPaper Elevation="0" Class="pa-2">
                <MudTabs Elevation="0" Rounded="true">
                    <MudTabPanel Text="Parameters">
                        <DashboardParamsGrid DashboardWidgetId="@context.Item.DashboardWidgetId" CanWrite="@hasWrite" />
                    </MudTabPanel>
                    <MudTabPanel Text="Localizations">
                        <WidgetLocalizationsGrid DashboardWidgetId="@context.Item.DashboardWidgetId" CanWrite="@hasWrite" />
                    </MudTabPanel>
                </MudTabs>
            </MudPaper>
        </ChildRowContent>
        <PagerContent>
            <MudDataGridPager T="DashboardWidgetViewModel" />
        </PagerContent>
    </MudDataGrid>
    </div>
}
    </Permitted>
    <NotPermitted>
        <MudAlert Severity="Severity.Warning">No permission to view dashboard widgets.</MudAlert>
    </NotPermitted>
</SecureView>

@code {
    private MudDataGrid<DashboardWidgetViewModel>? grid;
    private System.Security.Claims.ClaimsPrincipal? currentUser;
    private bool hasView;
    private bool hasWrite;
    private string? search;

    /// <summary>Darf im aktuellen Zustand des Gitters per Ziehen umsortiert werden?</summary>
    private bool canReorder;

    private ElementReference hostEl;
    private readonly string hostId = Guid.NewGuid().ToString("N");
    private DotNetObjectReference<DashboardWidgets>? selfRef;
    private bool jsAttached;

    protected override async Task OnInitializedAsync()
    {
        var auth = await AuthState.GetAuthenticationStateAsync();
        currentUser = auth.User;
        hasView = Handler.HasPermission(currentUser, "DashboardWidgets.View", "DashboardWidgets.Write");
        hasWrite = Handler.HasPermission(currentUser, "DashboardWidgets.Write");
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // Nicht auf firstRender: beim ersten Rendern steht currentUser noch nicht fest, also gibt es das
        // Wirtselement mit der Drag-Spalte noch gar nicht.
        if (jsAttached || !hasWrite || currentUser is null)
        {
            return;
        }

        selfRef = DotNetObjectReference.Create(this);
        try
        {
            // Seiteneffekt-Import: der erste Aufruf laedt den Helfer (installiert die Listener auf
            // document und window.itvGridDnd), spaetere treffen den Modul-Cache.
            await JS.InvokeAsync<IJSObjectReference>("import",
                "./_content/ITVComponents.WebCoreToolkit.Blazor.MudBlazor.AdminViews/grid-dnd.js");
            await JS.InvokeVoidAsync("itvGridDnd.attach", hostEl, selfRef);
            jsAttached = true;
        }
        catch (Microsoft.JSInterop.JSDisconnectedException) { /* Kreis weg */ }
        catch (Exception ex)
        {
            // Nicht durchwerfen: das Gitter bleibt ohne Ziehen benutzbar, die Sortierung ist ja auch im
            // Dialog zu pflegen. Ohne Log waere aber unklar, warum das Ziehen nichts tut.
            Logger.LogError(ex, "The drag-and-drop helper could not be attached - the widget grid stays usable without it.");
            Snackbar.Add("Drag & drop could not be activated - use the sort order field instead.", Severity.Warning);
        }
    }

    /// <summary>
    /// Ruft das JS auf, wenn eine Zeile auf einer anderen abgelegt wurde.
    /// </summary>
    /// <param name="draggedId">die gezogene Zeile</param>
    /// <param name="anchorId">die Zeile, auf der losgelassen wurde</param>
    /// <param name="zone">"above" oder "below" - dieses Gitter ist flach, "into" kommt hier nie an</param>
    [JSInvokable]
    public async Task HandleDrop(int draggedId, int anchorId, string zone)
    {
        if (!hasWrite) return;
        var ok = await Handler.MoveAsync(currentUser!, draggedId, anchorId, zone == "below");
        if (ok)
        {
            Snackbar.Add("Order changed", Severity.Success);
            await ReloadGrid();
        }
        else
        {
            Snackbar.Add("Could not change the order", Severity.Warning);
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (jsAttached)
        {
            try { await JS.InvokeVoidAsync("itvGridDnd.detach", hostEl); }
            catch (Microsoft.JSInterop.JSDisconnectedException) { /* Kreis weg */ }
            catch (Exception ex)
            {
                Logger.LogWarning(ex, "The drag-and-drop helper could not be detached - the element is probably already gone.");
            }
        }

        selfRef?.Dispose();
    }

    private async Task<GridData<DashboardWidgetViewModel>> LoadData(GridState<DashboardWidgetViewModel> state, CancellationToken ct)
    {
        if (currentUser is null) return new GridData<DashboardWidgetViewModel> { Items = Array.Empty<DashboardWidgetViewModel>(), TotalItems = 0 };
        var sort = state.SortDefinitions.FirstOrDefault();
        // Umsortieren per Ziehen ergibt nur Sinn, solange die angezeigte Reihenfolge DIE Reihenfolge ist,
        // die dabei geschrieben wird: ohne Sortierung (der Handler ordnet dann nach SortOrder) oder
        // ausdruecklich aufsteigend nach SortOrder.
        canReorder = hasWrite
                     && (sort is null
                         || (sort.SortBy == nameof(DashboardWidgetViewModel.SortOrder) && !sort.Descending));
        var query = new ListQuery
        {
            Page = state.Page,
            PageSize = state.PageSize,
            SortColumn = sort?.SortBy,
            SortDescending = sort?.Descending ?? false,
            Search = search
        };
        var result = await Handler.ListAsync(currentUser, query);
        return new GridData<DashboardWidgetViewModel> { Items = result.Items, TotalItems = result.TotalCount };
    }

    private async Task ReloadGrid()
    {
        if (grid is not null) await grid.ReloadServerData();
    }

    private async Task OpenCreate()
    {
        var parameters = new DialogParameters<DashboardWidgetDialog> { { d => d.Model, new DashboardWidgetViewModel() }, { d => d.IsCreate, true } };
        var dlg = await DialogService.ShowAsync<DashboardWidgetDialog>("Create widget", parameters, EditDialogDefaults.Edit);
        var result = await dlg.Result;
        if (result is { Canceled: false, Data: DashboardWidgetViewModel input })
        {
            var created = await Handler.CreateAsync(currentUser!, input);
            if (created != null) { Snackbar.Add("Widget created", Severity.Success); await ReloadGrid(); }
            else Snackbar.Add("Failed to create", Severity.Error);
        }
    }

    private async Task OpenEdit(DashboardWidgetViewModel item)
    {
        var copy = new DashboardWidgetViewModel
        {
            DashboardWidgetId = item.DashboardWidgetId,
            DisplayName = item.DisplayName,
            TitleTemplate = item.TitleTemplate,
            SystemName = item.SystemName,
            DiagnosticsQueryId = item.DiagnosticsQueryId,
            Area = item.Area,
            CustomQueryString = item.CustomQueryString,
            Template = item.Template,
            // Die beiden muessen mit: der Dialog bekommt eine KOPIE, und was hier fehlt, wuerde beim
            // Speichern als geleert zurueckgeschrieben.
            RendererKey = item.RendererKey,
            RendererOptions = item.RendererOptions,
            InitiallyActive = item.InitiallyActive,
            SortOrder = item.SortOrder
        };
        var parameters = new DialogParameters<DashboardWidgetDialog> { { d => d.Model, copy }, { d => d.IsCreate, false } };
        var dlg = await DialogService.ShowAsync<DashboardWidgetDialog>("Edit widget", parameters, EditDialogDefaults.Edit);
        var result = await dlg.Result;
        if (result is { Canceled: false, Data: DashboardWidgetViewModel input })
        {
            var updated = await Handler.UpdateAsync(currentUser!, input);
            if (updated != null) { Snackbar.Add("Widget updated", Severity.Success); await ReloadGrid(); }
            else Snackbar.Add("Failed to update", Severity.Error);
        }
    }

    private async Task Delete(DashboardWidgetViewModel item)
    {
        var ok = await DialogService.ShowMessageBoxAsync("Delete widget", $"Really delete '{item.SystemName}'?", yesText: "Delete", cancelText: "Cancel");
        if (ok != true) return;
        var success = await Handler.DeleteAsync(currentUser!, item.DashboardWidgetId);
        if (success) { Snackbar.Add("Widget deleted", Severity.Success); await ReloadGrid(); }
        else Snackbar.Add("Failed to delete", Severity.Error);
    }
}
