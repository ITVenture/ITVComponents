@inject ISnackbar Snackbar

<MudDialog>
    <DialogContent>
        <MudForm @ref="form" Model="Model">
            <MudTextField @bind-Value="Model.Name" Label="Name" Required="true" MaxLength="100" />
            <MudTextField @bind-Value="Model.DisplayName" Label="Display name" Lines="2" />
            <MudTextField @bind-Value="Model.ConfiguratorTypeBack"
                          Label="Configurator type (back-end)"
                          Required="true"
                          MaxLength="2048"
                          Lines="3" />
            <MudTextField @bind-Value="Model.CustomConfiguratorView"
                          Label="Custom configurator view"
                          MaxLength="2048" />
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Cancel</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="Save">@(IsCreate ? "Create" : "Save")</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;
    [Parameter, EditorRequired] public TemplateModuleConfiguratorViewModel Model { get; set; } = default!;
    [Parameter] public bool IsCreate { get; set; }

    private MudForm? form;

    private async Task Save()
    {
        if (form is null) return;
        await form.Validate();
        if (!form.IsValid) { Snackbar.Add("Please correct invalid fields", Severity.Warning); return; }
        MudDialog.Close(DialogResult.Ok(Model));
    }

    private void Cancel() => MudDialog.Cancel();
}
