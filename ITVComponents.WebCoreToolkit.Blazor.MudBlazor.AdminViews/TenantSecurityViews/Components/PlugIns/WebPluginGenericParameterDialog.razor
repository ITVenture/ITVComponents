<EditDialogShell Model="Model" IsCreate="IsCreate" InvalidMessage="Please correct invalid fields">
    <MudTextField @bind-Value="Model.GenericTypeName" Label="Generic type name" MaxLength="200" />
    <MudTextField @bind-Value="Model.TypeExpression" Label="Type expression" Lines="3" MaxLength="2048" />
</EditDialogShell>

@code {
    [Parameter, EditorRequired] public WebPluginGenericParameterViewModel Model { get; set; } = default!;
    [Parameter] public bool IsCreate { get; set; }
}
