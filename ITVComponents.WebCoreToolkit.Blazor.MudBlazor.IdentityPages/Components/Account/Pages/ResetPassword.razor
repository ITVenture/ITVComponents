@page "/Account/ResetPassword"
@rendermode @(RenderMode.InteractiveServer)

@using System.ComponentModel.DataAnnotations
@using System.Text
@using Microsoft.AspNetCore.WebUtilities
@using Microsoft.Extensions.Localization
@using Microsoft.Extensions.Logging
@using ITVComponents.WebCoreToolkit.IdentityShared.Areas.Identity
@using ITVComponents.WebCoreToolkit.IdentityShared.Areas.Identity.Pages.Account

@inject IPageHandlerProvider<ResetPasswordModel, IResetPasswordHandler> HandlerProvider
@inject IStringLocalizer<IdentityMessages> L
@inject ILogger<ResetPassword> Logger
@inject NavigationManager Nav

<PageTitle>@L["Reset password"]</PageTitle>

<MudContainer MaxWidth="MaxWidth.Small" Class="mt-8">
    <MudPaper Elevation="2" Class="pa-6">
        <MudText Typo="Typo.h4" GutterBottom="true">@L["Reset password"]</MudText>

        @if (!HandlerProvider.Handler.UsePage)
        {
            <MudAlert Severity="Severity.Info">@L["This page is not available."]</MudAlert>
        }
        else if (Code is null || codeUnreadable)
        {
            <MudAlert Severity="Severity.Error">@L["A code must be supplied for password reset."]</MudAlert>
        }
        else
        {
            <MudText Typo="Typo.subtitle1" GutterBottom="true">@L["Reset your password."]</MudText>
            <MudDivider Class="my-3" />

            <EditForm Model="Input" OnValidSubmit="OnSubmit">
                <ToolkitDataAnnotationsValidator />

                @if (errors.Count > 0)
                {
                    <MudAlert Severity="Severity.Error" Class="mb-3">
                        @foreach (var err in errors)
                        {
                            <div>@err</div>
                        }
                    </MudAlert>
                }

                @* Der Token aus der Mail bleibt in der Komponente - er lief frueher als verstecktes Feld
                   durch das Formular, weil static SSR die Eingaben nur ueber den Post zurueckbekam. *@

                <MudTextField @bind-Value="Input.Email" Label="@L["Email"]" For="@(() => Input.Email)"
                              InputType="InputType.Email" autocomplete="username" Class="mb-3" />

                <MudTextField @bind-Value="Input.Password" Label="@L["Password"]" For="@(() => Input.Password)"
                              InputType="InputType.Password" autocomplete="new-password" Class="mb-3" />

                <MudTextField @bind-Value="Input.ConfirmPassword" Label="@L["Confirm password"]" For="@(() => Input.ConfirmPassword)"
                              InputType="InputType.Password" autocomplete="new-password" Class="mb-3" />

                <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary" Disabled="@busy">
                    @L["Reset_Button"]
                </MudButton>
            </EditForm>
        }
    </MudPaper>
</MudContainer>

@code {
    private List<string> errors = new();
    private bool busy;
    private bool codeUnreadable;

    [SupplyParameterFromQuery]
    private string? Code { get; set; }

    private InputModel Input { get; set; } = new();

    protected override void OnInitialized()
    {
        if (Code is null)
        {
            return;
        }

        try
        {
            Input.Code = Encoding.UTF8.GetString(WebEncoders.Base64UrlDecode(Code));
        }
        catch (Exception ex)
        {
            // Eine verstuemmelte Adresse ist der Normalfall, wenn ein Mail-Programm den Link umbricht. Frueher
            // endete das in der Fehlerseite; interaktiv wuerde es den Circuit reissen, darum hier abgefangen -
            // der Benutzer sieht dieselbe Meldung wie bei fehlendem Code.
            codeUnreadable = true;
            Logger.LogError(ex, "Der Rueckstell-Token in der Adresse liess sich nicht dekodieren.");
        }
    }

    private async Task OnSubmit()
    {
        if (!HandlerProvider.Handler.UsePage)
        {
            return;
        }

        busy = true;
        var user = await HandlerProvider.Handler.FetchUser(Input.Email);
        try
        {
            if (!user.UserExists)
            {
                Nav.NavigateTo("Account/ResetPasswordConfirmation");
                return;
            }

            var result = await HandlerProvider.Handler.ResetPassword(user, Input.Code, Input.Password);
            if (result.Succeeded)
            {
                Nav.NavigateTo("Account/ResetPasswordConfirmation");
                return;
            }

            errors = result.Errors.Select(e => e.Description).ToList();
        }
        finally
        {
            HandlerProvider.Handler.ReleaseUser(user);
            busy = false;
        }
    }

    public sealed class InputModel
    {
        [Required]
        [EmailAddress(ErrorMessage = "ITV:DataTypeAttribute.EmailAddress_ValidationError")]
        public string Email { get; set; } = "";

        [Required]
        [StringLength(100, MinimumLength = 6)]
        [DataType(DataType.Password)]
        public string Password { get; set; } = "";

        [DataType(DataType.Password)]
        [Compare("Password")]
        public string ConfirmPassword { get; set; } = "";

        public string Code { get; set; } = "";
    }
}
