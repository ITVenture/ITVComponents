@page "/Account/Manage/Email"
@rendermode @(RenderMode.InteractiveServer)

@layout ManageLayout
@attribute [Microsoft.AspNetCore.Authorization.Authorize]

@using System.ComponentModel.DataAnnotations
@using System.Text
@using System.Text.Encodings.Web
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Identity.UI.Services
@using Microsoft.AspNetCore.WebUtilities
@using Microsoft.Extensions.Localization
@using ITVComponents.WebCoreToolkit.Blazor.MudBlazor.IdentityPages.Components.Account.Shared
@using ITVComponents.WebCoreToolkit.Extras.EmailDnsValidation
@using ITVComponents.WebCoreToolkit.Helpers
@using ITVComponents.WebCoreToolkit.IdentityShared.Areas.Identity
@using ITVComponents.WebCoreToolkit.IdentityShared.Areas.Identity.Pages.Account.Manage
@using ITVComponents.WebCoreToolkit.IdentityShared.PageHandlers.Identity.Account.Manage

@inject IPageHandlerProvider<EmailModel, IEmailHandler> HandlerProvider
@inject AuthenticationStateProvider AuthState
@inject IEmailSender EmailSender
@inject IStringLocalizer<IdentityMessages> L
@inject NavigationManager Nav

<PageTitle>@L["Manage Email"]</PageTitle>

<MudText Typo="Typo.h5" GutterBottom="true">@L["Manage Email"]</MudText>

@if (loading)
{
    <MudProgressCircular Indeterminate="true" />
}
else if (!usePage)
{
    <MudAlert Severity="Severity.Info">@L["This page is not available."]</MudAlert>
}
else if (notFound)
{
    <MudAlert Severity="Severity.Error">@notFoundMessage</MudAlert>
}
else
{
    @if (!string.IsNullOrEmpty(status))
    {
        <MudAlert Severity="Severity.Info" Class="mb-3">@status</MudAlert>
    }

    <MudTextField T="string" Value="@email" Label="@L["Email"]" Disabled="true"
                  AdornmentIcon="@(isEmailConfirmed ? Icons.Material.Filled.CheckCircle : null)"
                  Adornment="@(isEmailConfirmed ? Adornment.End : Adornment.None)"
                  AdornmentColor="Color.Success" Class="mb-1" />

    @if (isEmailConfirmed)
    {
        <MudText Typo="Typo.caption" Color="Color.Success" Class="mb-3 d-block">@L["Email confirmed"]</MudText>
    }
    else
    {
        <MudButton Variant="Variant.Text" Color="Color.Primary" Class="mb-3"
                   Disabled="@busy" OnClick="OnSendVerification">
            @L["Send verification email"]
        </MudButton>
    }

    <EditForm Model="Input" OnValidSubmit="OnChangeEmail">
        <ToolkitDataAnnotationsValidator />

        <MudTextField @bind-Value="Input.NewEmail" Label="@L["New email"]" For="@(() => Input.NewEmail)"
                      InputType="InputType.Email" autocomplete="email" Class="mb-3" />

        <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary" Disabled="@busy">
            @L["Change email"]
        </MudButton>
    </EditForm>
}

@code {
    private bool loading = true;
    private bool usePage;
    private bool notFound;
    private string? notFoundMessage;
    private bool busy;
    private string email = "";
    private bool isEmailConfirmed;

    /// <summary>
    /// Angezeigte Rueckmeldung. Diese Seite schreibt kein Cookie, braucht also keinen Ruecksprung â€” die Meldung
    /// erscheint ohne Seitenaufbau. Der Anfangswert kommt weiter aus der Adresse, damit ein Verweis von aussen
    /// (z.B. aus einer Bestaetigungsmail) seine Meldung mitbringen kann.
    /// </summary>
    private string? status;

    [SupplyParameterFromQuery(Name = "status")]
    private string? StatusMessage { get; set; }

    private InputModel Input { get; set; } = new();

    protected override async Task OnInitializedAsync()
    {
        status = StatusMessage;
        await using var op = HandlerProvider.BeginOperation();
        usePage = op.Handler.UsePage;
        if (!usePage)
        {
            loading = false;
            return;
        }

        await LoadAsync();
        loading = false;
    }

    private async Task LoadAsync()
    {
        await using var op = HandlerProvider.BeginOperation();
        var principal = (await AuthState.GetAuthenticationStateAsync()).User;
        var user = await op.Handler.FetchUser(principal);
        if (!user.UserExists)
        {
            notFound = true;
            notFoundMessage = L["Unable to load user with ID '{0}'.", op.Handler.GetUserId(principal)];
            return;
        }

        try
        {
            email = user.Email ?? "";
            isEmailConfirmed = user.EmailConfirmed;
            if (string.IsNullOrEmpty(Input.NewEmail))
            {
                Input.NewEmail = email;
            }
        }
        finally
        {
            op.Handler.ReleaseUser(user);
        }
    }

    private async Task OnChangeEmail()
    {
        await using var op = HandlerProvider.BeginOperation();
        busy = true;
        var principal = (await AuthState.GetAuthenticationStateAsync()).User;
        var user = await op.Handler.FetchUser(principal);
        if (!user.UserExists)
        {
            notFound = true;
            notFoundMessage = L["Unable to load user with ID '{0}'.", op.Handler.GetUserId(principal)];
            busy = false;
            return;
        }

        try
        {
            if (Input.NewEmail == user.Email)
            {
                status = L["Your email is unchanged."].Value;
                return;
            }

            var mail = new EmailAddress(Input.NewEmail, new MailDomainValidator());
            if (!mail.FormatOk)
            {
                status = L["InvalidMailFormat"].Value;
                return;
            }
            if (!mail.DomainOk)
            {
                status = L["InvalidMailDomain"].Value;
                return;
            }

            var tokenData = await op.Handler.GetMailToken(user, Input.NewEmail);
            var code = WebEncoders.Base64UrlEncode(Encoding.UTF8.GetBytes(tokenData.Code));
            var callbackUrl = Nav.ToAbsoluteUri(
                Nav.GetUriWithQueryParameters("Account/ConfirmEmailChange",
                    new Dictionary<string, object?>
                    {
                        ["userId"] = tokenData.UserId,
                        ["email"] = Input.NewEmail,
                        ["code"] = code
                    })).ToString();

            var username = op.Handler.GetUserName(principal);
            await EmailSender.SendEmailAsync(
                Input.NewEmail,
                L["Confirm your email"],
                L["Hello {0}\r\nPlease confirm your account by <a href='{1}'>clicking here</a>.",
                    username, HtmlEncoder.Default.Encode(callbackUrl)]);

            status = L["Verification email sent. Please check your email."].Value;
        }
        finally
        {
            op.Handler.ReleaseUser(user);
            busy = false;
        }
    }

    private async Task OnSendVerification()
    {
        await using var op = HandlerProvider.BeginOperation();
        busy = true;
        var principal = (await AuthState.GetAuthenticationStateAsync()).User;
        var user = await op.Handler.FetchUser(principal);
        if (!user.UserExists)
        {
            notFound = true;
            notFoundMessage = L["Unable to load user with ID '{0}'.", op.Handler.GetUserId(principal)];
            busy = false;
            return;
        }

        try
        {
            var tokenData = await op.Handler.GetMailToken(user);
            var code = WebEncoders.Base64UrlEncode(Encoding.UTF8.GetBytes(tokenData.Code));
            var callbackUrl = Nav.ToAbsoluteUri(
                Nav.GetUriWithQueryParameters("Account/ConfirmEmail",
                    new Dictionary<string, object?>
                    {
                        ["userId"] = tokenData.UserId,
                        ["code"] = code
                    })).ToString();

            var username = op.Handler.GetUserName(principal);
            await EmailSender.SendEmailAsync(
                user.Email,
                L["Confirm your email"],
                L["Hello {0}\r\nPlease confirm your account by <a href='{1}'>clicking here</a>.",
                    username, HtmlEncoder.Default.Encode(callbackUrl)]);

            status = L["Verification email sent. Please check your email."].Value;
        }
        finally
        {
            op.Handler.ReleaseUser(user);
            busy = false;
        }
    }

    public sealed class InputModel
    {
        [Required]
        [EmailAddress(ErrorMessage = "ITV:DataTypeAttribute.EmailAddress_ValidationError")]
        public string NewEmail { get; set; } = "";
    }
}
