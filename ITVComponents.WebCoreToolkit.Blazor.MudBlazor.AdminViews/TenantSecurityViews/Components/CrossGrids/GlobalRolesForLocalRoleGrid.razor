@using Microsoft.AspNetCore.Components.Authorization

@inject IGlobalRoleAdminHandler Handler
@inject AuthenticationStateProvider AuthState
@inject ISnackbar Snackbar

<SecureView RequiredPermissions="GlobalRoles.View,GlobalRoles.AssignRole,Sysadmin">
    <Permitted>
    <MudDataGrid T="GlobalRoleForLocalRoleAssignmentViewModel"
                 @ref="grid"
                 ServerData="LoadData"
                 SortMode="SortMode.None"
                 RowsPerPage="10"
                 Hover="true"
                 Dense="true">
        <ToolBarContent>
            <CrudGridToolbar OnRefresh="@(() => grid is null ? Task.CompletedTask : grid.ReloadServerData())" Title="Global roles" TitleTypo="Typo.subtitle2" />
        </ToolBarContent>
        <Columns>
            <TemplateColumn T="GlobalRoleForLocalRoleAssignmentViewModel" Title="" Sortable="false">
                <CellTemplate>
                    <SecureView RequiredPermissions="GlobalRoles.AssignRole,Sysadmin">
                        <Permitted>
                            <MudCheckBox T="bool"
                                         Value="context.Item.Assigned"
                                         ValueChanged="@(v => Toggle(context.Item, v))" />
                        </Permitted>
                        <NotPermitted>
                            <MudCheckBox T="bool"
                                         Value="context.Item.Assigned"
                                         Disabled="true" />
                        </NotPermitted>
                    </SecureView>
                </CellTemplate>
            </TemplateColumn>
            <PropertyColumn Property="x => x.RoleName" Title="Global role" />
        </Columns>
        <PagerContent>
            <MudDataGridPager T="GlobalRoleForLocalRoleAssignmentViewModel" />
        </PagerContent>
    </MudDataGrid>
    </Permitted>
    <NotPermitted>
        <MudAlert Severity="Severity.Info">No permission to view global-role assignments.</MudAlert>
    </NotPermitted>
</SecureView>

@code {
    [Parameter, EditorRequired] public int LocalRoleId { get; set; }

    private MudDataGrid<GlobalRoleForLocalRoleAssignmentViewModel>? grid;
    private System.Security.Claims.ClaimsPrincipal? currentUser;
    private bool hasView;
    private bool hasWrite;

    protected override async Task OnInitializedAsync()
    {
        var auth = await AuthState.GetAuthenticationStateAsync();
        currentUser = auth.User;
        hasView = Handler.HasPermission(currentUser, "GlobalRoles.View", "GlobalRoles.AssignRole", "Sysadmin");
        hasWrite = Handler.HasPermission(currentUser, "GlobalRoles.AssignRole", "Sysadmin");
    }

    private async Task<GridData<GlobalRoleForLocalRoleAssignmentViewModel>> LoadData(GridState<GlobalRoleForLocalRoleAssignmentViewModel> state, CancellationToken ct)
    {
        if (currentUser is null || !hasView)
            return new GridData<GlobalRoleForLocalRoleAssignmentViewModel> { Items = Array.Empty<GlobalRoleForLocalRoleAssignmentViewModel>(), TotalItems = 0 };
        var query = new ListQuery { Page = state.Page, PageSize = state.PageSize };
        var result = await Handler.ListGlobalRolesForLocalRoleAsync(currentUser, LocalRoleId, query);
        return new GridData<GlobalRoleForLocalRoleAssignmentViewModel> { Items = result.Items, TotalItems = result.TotalCount };
    }

    private async Task Toggle(GlobalRoleForLocalRoleAssignmentViewModel item, bool newValue)
    {
        if (!hasWrite || currentUser is null) return;
        var ok = await Handler.SetGlobalRoleForLocalRoleAsync(currentUser, item.GlobalRoleId, LocalRoleId, newValue);
        if (ok)
        {
            item.Assigned = newValue;
            Snackbar.Add(newValue ? "Global role assigned" : "Global role unassigned", Severity.Success);
        }
        else
        {
            Snackbar.Add("Failed to update assignment", Severity.Error);
            if (grid is not null) await grid.ReloadServerData();
        }
    }
}
