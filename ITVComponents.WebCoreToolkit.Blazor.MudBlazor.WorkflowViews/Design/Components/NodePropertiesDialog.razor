@using ITVComponents.Workflow.Activities
@using ITVComponents.Workflow.Model

@*
    Eigenschaften-Popup fuer einen Knoten ODER eine Verbindung. Loest das fruehere Dauer-Panel an der
    rechten Seite ab: es kam nur auf Verlangen hoch (Doppelklick / Toolbar) und ist maximierbar, damit
    Ausdruecke (Monaco) genug Platz haben. Die Editoren mutieren die uebergebenen Modell-Objekte direkt
    per Referenz - der Editor rendert nach dem Schliessen neu. Nur die Monaco-Felder melden ihren Text
    erst beim Verlassen; deshalb wird beim Schliessen einmal geflusht.
*@

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">
            @if (Node is not null)
            {
                <MudIcon Icon="@Icons.Material.Filled.Tune" Class="mr-2" />
                <span>@NodeTitle</span>
            }
            else
            {
                <MudIcon Icon="@Icons.Material.Filled.Timeline" Class="mr-2" />
                <span>Connection</span>
            }
        </MudText>
    </TitleContent>
    <DialogContent>
        @* Tab-basierte Editoren bringen Id/Name in ihrem General-Reiter selbst mit - daher eigene Zweige
           statt des generischen Id/Name-Kopfes. *@
        @if (Node is AutomatedActivityNode act)
        {
            <AutomatedActivityEditor Node="act" Environment="Environment" Def="Def" />
        }
        else if (Node is UserActivityNode userTask)
        {
            <UserActivityEditor Node="userTask" @ref="userTaskEditor" />
        }
        else if (Node is CallWorkflowNode call)
        {
            <CallWorkflowEditor Node="call" SubDefinitionIds="SubDefinitionIds" Def="Def" />
        }
        else if (Node is not null)
        {
            <MudTextField Value="@Node.Id" Label="Id" ReadOnly="true" Margin="Margin.Dense" />
            <MudTextField @bind-Value="Node.Name" Label="Name" Margin="Margin.Dense" />
            <MudText Typo="Typo.caption" Class="mt-1">Kind: @Node.Kind</MudText>

            @* Zugehoerigkeit zu einem eingebetteten Abschnitt. Solange der Editor keine Container
               zeichnet, ist diese Auswahl der Weg, einen Knoten hineinzulegen. *@
            @if (SubProcessIds.Any() && Node is not SubProcessNode)
            {
                <MudSelect T="string" Value="@Node.ParentNodeId" ValueChanged="SetParent"
                           Label="Inside sub-process" Clearable="true" Dense="true" Margin="Margin.Dense"
                           Class="mt-2">
                    @foreach (var sp in SubProcessIds)
                    {
                        <MudSelectItem T="string" Value="@sp.Id">@sp.Label</MudSelectItem>
                    }
                </MudSelect>
                <MudText Typo="Typo.caption" Class="mud-text-secondary">
                    Empty = top level. A sub-process needs its own start and end node inside it.
                </MudText>
            }

            @switch (Node)
            {
                case StartNode start:
                    <StartConfigEditor Node="start" @ref="startEditor" />
                    break;
                case EndNode end:
                    <EndConfigEditor Node="end" />
                    break;
                case BoundaryTimerNode boundary:
                    <BoundaryTimerConfigEditor Node="boundary" Def="Def" />
                    break;
                case SidePathEndNode:
                    <MudAlert Severity="Severity.Info" Dense="true" Class="mt-2">
                        Closes an escalation path: the token is consumed and nothing else happens — the
                        workflow is <b>not</b> completed. Its deadline waits for the next interval.
                    </MudAlert>
                    break;
                case TerminateEndNode terminate:
                    <MudAlert Severity="Severity.Warning" Dense="true" Class="mt-2">
                        Ends the <b>whole instance</b> at once: every other branch is dropped and running
                        subworkflows are cancelled. The workflow counts as completed, not cancelled.
                    </MudAlert>
                    <EndConfigEditor Node="terminate"
                                     HelperText="@("Why did it stop? Without a result the outcome says nothing about the reason. The source is the scope of the branch that terminated - it is published to the instance first.")" />
                    break;
                case SubProcessNode subProcess:
                    <MudAlert Severity="Severity.Info" Dense="true" Class="mt-2">
                        An embedded section: drag nodes into its frame (or assign them via
                        <b>Inside sub-process</b> in their properties). It has its own variable scope, but
                        it is <b>not</b> a separate instance. A <b>deadline can hang on the whole
                        section</b> — that is what a plain sequence of steps cannot do.
                    </MudAlert>
                    <MudSwitch T="bool" @bind-Value="subProcess.Collapsed" Color="Color.Primary"
                               Label="Collapsed in the diagram" Class="mt-2" />
                    <MudText Typo="Typo.caption" Class="mud-text-secondary">
                        Collapsed the section is drawn as a single node and its content is hidden — for
                        keeping a large process readable. Purely visual; the run is unaffected.
                    </MudText>

                    <MudText Typo="Typo.caption" Class="mt-3">Result of the section</MudText>
                    <MudText Typo="Typo.caption" Class="mud-text-secondary">
                        Map inner variables to outer ones. Leave empty and everything the section produced
                        flows out.
                    </MudText>
                    <OutputBindingList Bindings="subProcess.Outputs" SourcePlaceholder="inner variable"
                                       TargetPlaceholder="outer variable" AddPlaceholder="new result" />
                    <ScopeModeSection Mode="subProcess.ScopeMode"
                                      ModeChanged="@(m => subProcess.ScopeMode = m)"
                                      RetainVariables="subProcess.RetainVariables"
                                      HelperText="@("After the section the outer scope contains only its declared result plus the variables kept here.")" />
                    @if (!string.IsNullOrEmpty(subProcess.ErrorFlowId))
                    {
                        <MudTextField @bind-Value="subProcess.ErrorVariable"
                                      Label="Error message → variable" Margin="Margin.Dense" />
                    }
                    break;
                case EventGatewayNode:
                    <MudAlert Severity="Severity.Info" Dense="true" Class="mt-2">
                        Waits for several events at once — the first one to arrive wins, the others are
                        dropped. Every outgoing connection must lead to a <b>wait point</b>, a <b>timer</b>
                        or a <b>user task</b>; anything else would run straight through and always win.
                    </MudAlert>
                    break;
                case WaitNode wait:
                    <MudTextField @bind-Value="wait.SignalName" Label="Signal name" Margin="Margin.Dense" />
                    <MudSelect T="WaitKind" @bind-Value="wait.WaitKind" Label="Kind" Dense="true"
                               Margin="Margin.Dense" Class="mt-2">
                        <MudSelectItem T="WaitKind" Value="WaitKind.Message">Message — reaches only the matching instance (correlated)</MudSelectItem>
                        <MudSelectItem T="WaitKind" Value="WaitKind.Signal">Signal — a broadcast reaches every waiting instance</MudSelectItem>
                    </MudSelect>
                    <MudText Typo="Typo.caption" Class="mud-text-secondary">
                        A <b>message</b> without a matching correlation key does not arrive at all. A
                        <b>signal</b> ignores correlation — use it for events that concern the whole system.
                    </MudText>
                    @if (wait.WaitKind == WaitKind.Message)
                    {
                        <MudText Typo="Typo.caption" Class="mt-2">Correlation (CScript)</MudText>
                        <CScriptField @key="@("corr-" + Node.Id)" @ref="exprField" Height="240"
                                      Value="@wait.CorrelationExpression"
                                      ValueChanged="@(v => wait.CorrelationExpression = v)"
                                      Mode="wait.CorrelationExpressionMode"
                                      ModeChanged="@(m => wait.CorrelationExpressionMode = m)" />
                        <MudText Typo="Typo.caption" Class="mud-text-secondary">
                            Evaluated when the branch parks, over its variables — so it can key on something
                            the process itself just produced. Empty = the instance's own correlation key.
                        </MudText>
                    }
                    break;
                case TimerNode timer:
                    <MudText Typo="Typo.caption" Class="mt-2">Due (CScript: DateTime or TimeSpan)</MudText>
                    <CScriptField @key="@("due-" + Node.Id)" @ref="exprField" Height="240"
                                  Value="@timer.DueExpression"
                                  ValueChanged="@(v => timer.DueExpression = v)"
                                  Mode="timer.DueExpressionMode"
                                  ModeChanged="@(m => timer.DueExpressionMode = m)" />
                    break;
                case ParallelGatewayNode par:
                    <ParallelGatewayConfigEditor Node="par" IsJoin="@(IncomingCount(par.Id) > 1)" />
                    break;
                case ExclusiveGatewayNode xor:
                    <MudSelect T="string" @bind-Value="xor.DefaultFlowId" Label="Default flow" Clearable="true"
                               Margin="Margin.Dense">
                        @foreach (var f in Def.Flows.Where(f => f.SourceId == xor.Id))
                        {
                            <MudSelectItem T="string" Value="@f.Id">@FlowLabel(f)</MudSelectItem>
                        }
                    </MudSelect>
                    break;
            }
        }
        else if (Flow is not null)
        {
            <MudText Typo="Typo.caption">@NodeName(Flow.SourceId) → @NodeName(Flow.TargetId)</MudText>
            <MudTextField @bind-Value="Flow.Name" Label="Label" Margin="Margin.Dense" />
            <MudText Typo="Typo.caption" Class="mt-2">Condition (CScript, for XOR gateways)</MudText>
            <CScriptField @key="@("cond-" + Flow.Id)" @ref="exprField" Height="240"
                          Value="@Flow.Condition"
                          ValueChanged="@(v => Flow.Condition = v)"
                          Mode="Flow.ConditionMode"
                          ModeChanged="@(m => Flow.ConditionMode = m)" />

            @* Mapping der Kante: was der Stack ist, wenn ein Token hier ankommt. Ergaenzt das
               Mapping am Zielknoten - typisch, um mehrere Pfade auf gleiche Namen zu bringen. *@
            <MudDivider Class="my-3" />
            <MudText Typo="Typo.caption">Mapping on arrival (optional)</MudText>
            <MudText Typo="Typo.caption" Class="mud-text-secondary">
                Runs when a token takes this connection — after the condition decided it. Use it to
                normalise the variables the target node sees.
            </MudText>
            <InputBindingList Bindings="Flow.Inputs" NamePlaceholder="variable"
                              AddPlaceholder="new variable" />
            <ScopeModeSection Mode="Flow.ScopeMode"
                              ModeChanged="@(m => Flow.ScopeMode = m)"
                              RetainVariables="Flow.RetainVariables"
                              SwitchLabel="Consolidate scope (replace)"
                              HelperText="After this connection the scope consists of the mapping above plus the variables kept here." />
        }
    </DialogContent>
    <DialogActions>
        <DialogMaximizeToggle NormalMaxWidth="MaxWidth.Medium" />
        <MudButton StartIcon="@Icons.Material.Filled.Delete" Color="Color.Error" Variant="Variant.Text"
                   OnClick="RequestDelete">@(Node is not null ? "Delete node" : "Delete connection")</MudButton>
        <MudSpacer />
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="ApplyAndClose">Done</MudButton>
    </DialogActions>
</MudDialog>

@code {
    /// <summary>Was der Editor nach dem Schliessen tun soll.</summary>
    public enum PropAction
    {
        /// <summary>Aenderungen uebernehmen (die Modelle wurden bereits per Referenz mutiert).</summary>
        Apply,

        /// <summary>Das bearbeitete Element loeschen.</summary>
        Delete
    }

    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;

    /// <summary>Die Definition - fuer Nachschlage-Helfer (Default-Flow, Ziel-Namen, Join-Erkennung).</summary>
    [Parameter] public WorkflowDefinition Def { get; set; } = default!;

    /// <summary>Der bearbeitete Knoten, oder null wenn eine Verbindung bearbeitet wird.</summary>
    [Parameter] public WorkflowNode? Node { get; set; }

    /// <summary>Die bearbeitete Verbindung, oder null wenn ein Knoten bearbeitet wird.</summary>
    [Parameter] public SequenceFlow? Flow { get; set; }

    /// <summary>Die (optional) gewählte Umgebung - für die per-Instanz-Katalog-Auflösung im Aktivitäts-Editor.</summary>
    [Parameter] public string? Environment { get; set; }

    /// <summary>Aufrufbare Definition-Ids fuer das Subworkflow-Dropdown (null -> Freitext).</summary>
    [Parameter] public IReadOnlyList<string>? SubDefinitionIds { get; set; }

    private CScriptField? exprField;
    private UserActivityEditor? userTaskEditor;
    private StartConfigEditor? startEditor;

    private string NodeTitle => Node is null
        ? "Node"
        : string.IsNullOrEmpty(Node.Name) ? Node.Kind.ToString() : Node.Name!;

    private async Task ApplyAndClose()
    {
        await FlushExprAsync();
        MudDialog.Close(DialogResult.Ok(PropAction.Apply));
    }

    private async Task RequestDelete()
    {
        // Vor dem Loeschen NICHT flushen - das Element verschwindet ohnehin.
        MudDialog.Close(DialogResult.Ok(PropAction.Delete));
        await Task.CompletedTask;
    }

    /// <summary>
    /// Holt den aktuellen Text des sichtbaren Ausdrucks-Editors ins Modell. Der Monaco-Editor meldet
    /// seinen Wert erst beim Verlassen (Blur) - ohne diesen Aufruf ginge das zuletzt Getippte beim
    /// Schliessen verloren.
    /// </summary>
    private async Task FlushExprAsync()
    {
        if (Node is UserActivityNode && userTaskEditor is not null)
        {
            await userTaskEditor.FlushAsync();
            return;
        }

        if (Node is StartNode && startEditor is not null)
        {
            // Der Start-Editor hat ein eigenes Monaco-Feld (Beschreibung der Start-Maske).
            await startEditor.FlushAsync();
            return;
        }

        if (exprField is null)
        {
            return;
        }

        string v = await exprField.GetValueAsync();
        switch ((object?)Flow ?? Node)
        {
            case SequenceFlow f:
                f.Condition = v;
                break;
            case TimerNode t:
                t.DueExpression = v;
                break;
            case WaitNode w:
                w.CorrelationExpression = v;
                break;
        }
    }

    // --- Nachschlage-Helfer (aus der Definition, ohne eigenen Zustand) -----------------------

    private int IncomingCount(string? nodeId)
        => nodeId is null ? 0 : Def.Flows.Count(f => f.TargetId == nodeId);

    /// <summary>Die eingebetteten Abschnitte der Definition, für die Zugehörigkeits-Auswahl.</summary>
    private IEnumerable<(string Id, string Label)> SubProcessIds
        => Def is null
            ? Enumerable.Empty<(string, string)>()
            : Def.Nodes.OfType<SubProcessNode>()
                .Where(n => n.Id != Node?.Id)
                .Select(n => (n.Id, string.IsNullOrEmpty(n.Name) ? n.Id : n.Name));

    /// <summary>
    /// Legt den Knoten in einen Abschnitt (oder auf die oberste Ebene). Ein Knoten kann sich nicht selbst
    /// enthalten — die Auswahl blendet ihn deshalb schon aus.
    /// </summary>
    private void SetParent(string? parentId)
    {
        if (Node is not null)
        {
            Node.ParentNodeId = string.IsNullOrWhiteSpace(parentId) ? null : parentId;
        }
    }

    private string NodeName(string? id)
    {
        WorkflowNode? n = id is null ? null : Def.GetNode(id);
        return n is null ? (id ?? "?") : (string.IsNullOrEmpty(n.Name) ? n.Id : n.Name);
    }

    private static string FlowLabel(SequenceFlow f)
        => string.IsNullOrWhiteSpace(f.Name) ? (f.Id ?? "?") : f.Name!;
}
