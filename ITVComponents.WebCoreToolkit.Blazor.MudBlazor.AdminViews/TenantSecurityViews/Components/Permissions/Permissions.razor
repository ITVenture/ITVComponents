@page "/Security/Permissions"
@rendermode @(RenderMode.InteractiveServer)
@attribute [Microsoft.AspNetCore.Authorization.Authorize]

@using Microsoft.AspNetCore.Components.Authorization

@inject IPermissionAdminHandler Handler
@inject AuthenticationStateProvider AuthState
@inject IDialogService DialogService
@inject ISnackbar Snackbar

<PageTitle>Permissions</PageTitle>

<MudText Typo="Typo.h5" GutterBottom="true">Permissions</MudText>

@if (currentUser is null)
{
    <MudProgressCircular Indeterminate="true" />
}
else if (!hasView)
{
    <MudAlert Severity="Severity.Warning">No permission to view permissions.</MudAlert>
}
else
{
    <MudDataGrid T="PermissionViewModel"
                 @ref="grid"
                 ServerData="LoadData"
                 SortMode="SortMode.Single"
                 RowsPerPage="25"
                 Hover="true"
                 Dense="true">
        <ToolBarContent>
            <RefreshButton OnClick="ReloadGrid" />
            <MudText Typo="Typo.h6">Permissions</MudText>
            <MudSpacer />
            <MudTextField @bind-Value="search"
                          Placeholder="Search…"
                          Adornment="Adornment.Start"
                          AdornmentIcon="@Icons.Material.Filled.Search"
                          IconSize="Size.Medium"
                          Class="mt-0"
                          DebounceInterval="300"
                          OnDebounceIntervalElapsed="ReloadGrid" />
            @if (hasWrite)
            {
                <MudButton StartIcon="@Icons.Material.Filled.Add" Variant="Variant.Filled" Color="Color.Primary" Class="ml-2" OnClick="OpenCreate">
                    Add permission
                </MudButton>
            }
        </ToolBarContent>
        <Columns>
            <PropertyColumn Property="x => x.PermissionName" Title="Name" />
            <PropertyColumn Property="x => x.Description" Title="Description" />
            <PropertyColumn Property="x => x.IsGlobal" Title="Global" />
            <TemplateColumn T="PermissionViewModel" Title="" Sortable="false">
                <CellTemplate>
                    @if (hasWrite && context.Item.Editable)
                    {
                        <MudStack Row="true" Spacing="1">
                            <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" OnClick="@(() => OpenEdit(context.Item))" />
                            <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error" OnClick="@(() => Delete(context.Item))" />
                        </MudStack>
                    }
                </CellTemplate>
            </TemplateColumn>
        </Columns>
        <PagerContent>
            <MudDataGridPager T="PermissionViewModel" />
        </PagerContent>
    </MudDataGrid>
}

@code {
    private MudDataGrid<PermissionViewModel>? grid;
    private System.Security.Claims.ClaimsPrincipal? currentUser;
    private bool hasView;
    private bool hasWrite;
    private bool isSysAdmin;
    private int? effectiveTenantId;
    private string? search;

    [SupplyParameterFromQuery(Name = "tenantId")]
    private int? TenantIdQuery { get; set; }

    /// <summary>
    /// Optional parameter that overrides <c>tenantId</c> query parameter and the user's current tenant.
    /// Used when the page is rendered as a sub-component inside <c>TenantDetailDialog</c>.
    /// </summary>
    [Parameter] public int? EmbeddedTenantId { get; set; }

    protected override async Task OnInitializedAsync()
    {
        var auth = await AuthState.GetAuthenticationStateAsync();
        currentUser = auth.User;
        hasView = Handler.HasPermission(currentUser, "Permissions.View", "Permissions.Write");
        hasWrite = Handler.HasPermission(currentUser, "Permissions.Write");
        var ctx = Handler.GetContext(currentUser);
        isSysAdmin = ctx.IsSysAdmin;
        // Sysadmins default to the global catalog (tenantId=null) — they manage global permissions
        // unless they explicitly scope to a tenant via ?tenantId=. Tenant-users fall back to their
        // own tenant (the handler ignores the param for non-sysadmins anyway).
        effectiveTenantId = EmbeddedTenantId ?? TenantIdQuery ?? (isSysAdmin ? (int?)null : ctx.CurrentTenantId);
    }

    private async Task<GridData<PermissionViewModel>> LoadData(GridState<PermissionViewModel> state, CancellationToken ct)
    {
        if (currentUser is null) return new GridData<PermissionViewModel> { Items = Array.Empty<PermissionViewModel>(), TotalItems = 0 };
        var sort = state.SortDefinitions.FirstOrDefault();
        var query = new ListQuery
        {
            Page = state.Page,
            PageSize = state.PageSize,
            SortColumn = sort?.SortBy,
            SortDescending = sort?.Descending ?? false,
            Search = search
        };
        var result = await Handler.ListPermissionsAsync(currentUser, effectiveTenantId, query);
        return new GridData<PermissionViewModel> { Items = result.Items, TotalItems = result.TotalCount };
    }

    private async Task ReloadGrid()
    {
        if (grid is not null) await grid.ReloadServerData();
    }

    private async Task OpenCreate()
    {
        var parameters = new DialogParameters<PermissionDialog>
        {
            { d => d.Model, new PermissionViewModel { TenantId = effectiveTenantId } },
            { d => d.IsCreate, true }
        };
        var dlg = await DialogService.ShowAsync<PermissionDialog>("Create permission", parameters, EditDialogDefaults.Edit);
        var result = await dlg.Result;
        if (result is { Canceled: false, Data: PermissionViewModel input })
        {
            var created = await Handler.CreatePermissionAsync(currentUser!, effectiveTenantId, input);
            if (created != null) { Snackbar.Add("Permission created", Severity.Success); await ReloadGrid(); }
            else Snackbar.Add("Failed to create permission", Severity.Error);
        }
    }

    private async Task OpenEdit(PermissionViewModel permission)
    {
        var copy = new PermissionViewModel
        {
            PermissionId = permission.PermissionId,
            PermissionName = permission.PermissionName,
            Description = permission.Description,
            TenantId = permission.TenantId,
            IsGlobal = permission.IsGlobal,
            Editable = permission.Editable
        };
        var parameters = new DialogParameters<PermissionDialog>
        {
            { d => d.Model, copy },
            { d => d.IsCreate, false }
        };
        var dlg = await DialogService.ShowAsync<PermissionDialog>("Edit permission", parameters, EditDialogDefaults.Edit);
        var result = await dlg.Result;
        if (result is { Canceled: false, Data: PermissionViewModel input })
        {
            var updated = await Handler.UpdatePermissionAsync(currentUser!, input);
            if (updated != null) { Snackbar.Add("Permission updated", Severity.Success); await ReloadGrid(); }
            else Snackbar.Add("Failed to update permission", Severity.Error);
        }
    }

    private async Task Delete(PermissionViewModel permission)
    {
        var ok = await DialogService.ShowMessageBoxAsync(
            "Delete permission",
            $"Really delete '{permission.PermissionName}'?",
            yesText: "Delete", cancelText: "Cancel");
        if (ok != true) return;
        var success = await Handler.DeletePermissionAsync(currentUser!, permission.PermissionId);
        if (success) { Snackbar.Add("Permission deleted", Severity.Success); await ReloadGrid(); }
        else Snackbar.Add("Failed to delete permission", Severity.Error);
    }
}
