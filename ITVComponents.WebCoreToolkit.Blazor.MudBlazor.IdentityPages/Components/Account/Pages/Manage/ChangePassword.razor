@page "/Account/Manage/ChangePassword"
@rendermode @(RenderMode.InteractiveServer)

@layout ManageLayout
@attribute [Microsoft.AspNetCore.Authorization.Authorize]

@using System.ComponentModel.DataAnnotations
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.Extensions.Localization
@using Microsoft.Extensions.Logging
@using ITVComponents.WebCoreToolkit.Blazor.MudBlazor.IdentityPages.Components.Account.Shared
@using ITVComponents.WebCoreToolkit.IdentityShared.Areas.Identity
@using ITVComponents.WebCoreToolkit.IdentityShared.Areas.Identity.Pages.Account.Manage
@using ITVComponents.WebCoreToolkit.IdentityShared.PageHandlers.Identity.Account.Manage

@inject IPageHandlerProvider<ChangePasswordModel, IChangePasswordHandler> HandlerProvider
@inject AuthenticationStateProvider AuthState
@inject IStringLocalizer<IdentityMessages> L
@inject ILogger<ChangePassword> Logger
@inject NavigationManager Nav

<PageTitle>@L["Change password"]</PageTitle>

<MudText Typo="Typo.h5" GutterBottom="true">@L["Change password"]</MudText>

@if (!HandlerProvider.Handler.UsePage)
{
    <MudAlert Severity="Severity.Info">@L["This page is not available."]</MudAlert>
}
else if (loading)
{
    <MudProgressCircular Indeterminate="true" />
}
else if (notFound)
{
    <MudAlert Severity="Severity.Error">@notFoundMessage</MudAlert>
}
else
{
    @if (!string.IsNullOrEmpty(StatusMessage))
    {
        <MudAlert Severity="Severity.Success" Class="mb-3">@StatusMessage</MudAlert>
    }

    <EditForm Model="Input" OnValidSubmit="OnSubmit">
        <ToolkitDataAnnotationsValidator />

        @if (errors.Count > 0)
        {
            <MudAlert Severity="Severity.Error" Class="mb-3">
                @foreach (var err in errors) { <div>@err</div> }
            </MudAlert>
        }

        <MudTextField @bind-Value="Input.OldPassword" Label="@L["Current password"]" For="@(() => Input.OldPassword)"
                      InputType="InputType.Password" autocomplete="current-password" Class="mb-3" />

        <MudTextField @bind-Value="Input.NewPassword" Label="@L["New password"]" For="@(() => Input.NewPassword)"
                      InputType="InputType.Password" autocomplete="new-password" Class="mb-3" />

        <MudTextField @bind-Value="Input.ConfirmPassword" Label="@L["Confirm new password"]" For="@(() => Input.ConfirmPassword)"
                      InputType="InputType.Password" autocomplete="new-password" Class="mb-3" />

        <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary" Disabled="@busy">
            @L["Update password"]
        </MudButton>
    </EditForm>
}

@code {
    private bool loading = true;
    private bool notFound;
    private string? notFoundMessage;
    private bool busy;
    private List<string> errors = new();

    private InputModel Input { get; set; } = new();

    [SupplyParameterFromQuery(Name = "status")]
    private string? StatusMessage { get; set; }

    protected override async Task OnInitializedAsync()
    {
        if (!HandlerProvider.Handler.UsePage)
        {
            loading = false;
            return;
        }

        var principal = (await AuthState.GetAuthenticationStateAsync()).User;
        var user = await HandlerProvider.Handler.FetchUser(principal);
        try
        {
            if (!user.UserExists)
            {
                notFound = true;
                notFoundMessage = L["Unable to load user with ID '{0}'.", HandlerProvider.Handler.GetUserId(principal)];
                return;
            }

            if (!user.HasPassword)
            {
                Nav.NavigateTo("Account/Manage/SetPassword");
            }
        }
        finally
        {
            HandlerProvider.Handler.ReleaseUser(user);
            loading = false;
        }
    }

    private async Task OnSubmit()
    {
        busy = true;
        errors.Clear();
        var principal = (await AuthState.GetAuthenticationStateAsync()).User;
        var user = await HandlerProvider.Handler.FetchUser(principal);
        try
        {
            if (!user.UserExists)
            {
                notFound = true;
                notFoundMessage = L["Unable to load user with ID '{0}'.", HandlerProvider.Handler.GetUserId(principal)];
                return;
            }

            var result = await HandlerProvider.Handler.ChangePassword(user, Input.OldPassword, Input.NewPassword);
            if (!result.Succeeded)
            {
                errors = result.Errors.Select(e => e.Description).ToList();
                return;
            }

            Logger.LogInformation("User changed their password successfully.");

            // Der Passwortwechsel aendert den Security-Stamp: ohne frisches Cookie meldet der Stamp-Validator
            // den Benutzer beim naechsten Intervall ab. Auf dem Circuit laesst sich keins schreiben, darum der
            // Ruecksprung ueber den Endpunkt.
            ManageRedirects.RefreshSignIn(Nav, "Account/Manage/ChangePassword", L["Your password has been changed."].Value);
        }
        finally
        {
            HandlerProvider.Handler.ReleaseUser(user);
            busy = false;
        }
    }

    public sealed class InputModel
    {
        [Required]
        [DataType(DataType.Password)]
        public string OldPassword { get; set; } = "";

        [Required]
        [StringLength(100, MinimumLength = 6)]
        [DataType(DataType.Password)]
        public string NewPassword { get; set; } = "";

        [DataType(DataType.Password)]
        [Compare("NewPassword")]
        public string ConfirmPassword { get; set; } = "";
    }
}
