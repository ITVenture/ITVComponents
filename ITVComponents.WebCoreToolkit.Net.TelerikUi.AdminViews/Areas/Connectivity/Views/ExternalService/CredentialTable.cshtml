@using ITVComponents.WebCoreToolkit.Extensions
@using ITVComponents.WebCoreToolkit.Net.TelerikUi.AdminViews.Extensions
@using ITVComponents.WebCoreToolkit.Net.TelerikUi.AdminViews.TenantSecurityViews.Resources
@using ITVComponents.WebCoreToolkit.Net.TelerikUi.AdminViews.TenantSecurityViews.ViewModel
@using Kendo.Mvc.UI
@{
    var oauthServiceId = ViewData["OAuthServiceId"];
    var hasFixed = ViewData["HasFixedCredentials"] is true;
    var hasUser = ViewData["HasUser"] is true;
    var tree = ViewData["SupportsInheritance"] is true;
    var canPlatform = ViewData["CanSetPlatform"] is true;
    var canWrite = Context.RequestServices.VerifyUserPermissions(new[] { "Services.Connections.Write" });
    var gridName = $"OAuthCredTab{oauthServiceId}";
}
@* Die Zugangsdaten-Zeilen eines Dienstes: je Besitzer (Mandant oder Plattform) Token und/oder feste Zugangsdaten. Welche
   Zeile zur Laufzeit gilt, entscheidet die Aufloesung (eigene, dann die naechste weitergegebene im Baum, dann die der
   Plattform, falls der Dienst es erlaubt) - Leitfaden §90/§93. Gespeicherte Werte kommen nie zurueck in die Maske. *@
<small class="form-text text-muted">@TextsAndMessagesHelper.IWCN_ES_CredHint</small>
@(Html.Kendo().Grid<ExternalServiceCredentialViewModel>().Name(gridName)
    .Columns(columns =>
    {
        columns.Bound(c => c.OwnerName).Title(TextsAndMessagesHelper.IWCN_ES_CredOwner);
        if (canPlatform)
        {
            columns.Bound(c => c.Platform).Title(TextsAndMessagesHelper.IWCN_ES_CredPlatform).Width(110);
        }
        if (hasFixed && hasUser)
        {
            columns.Bound(c => c.User).Title(TextsAndMessagesHelper.IWCN_ES_CredUser)
                .ClientTemplate("#: HasCredentials ? '••••••' : '—' #");
        }
        if (hasFixed)
        {
            columns.Bound(c => c.Secret).Title(TextsAndMessagesHelper.IWCN_ES_CredSecret).EditorTemplateName("CredentialSecret")
                .ClientTemplate("#: HasCredentials ? '••••••' : '—' #");
        }
        columns.Bound(c => c.HasToken).Title(TextsAndMessagesHelper.IWCN_ES_CredToken)
            .ClientTemplate("#: Revoked ? '✗' : (HasToken ? '✓' : '—') #").Width(90);
        if (tree)
        {
            columns.Bound(c => c.Inheritable).Title(TextsAndMessagesHelper.IWCN_ES_CredInheritable).Width(150);
        }
        if (canWrite)
        {
            columns.Command(ga =>
            {
                if (hasFixed)
                {
                    ga.Edit();
                }
                ga.Custom("revokeCredential").Text(TextsAndMessagesHelper.IWCN_ES_CredRevoke).Click("itvRevokeCredential");
                ga.PopupConfirmDelete();
            }).Width(260);
        }
    })
    .ToolBar(toolbar =>
    {
        toolbar.RefreshTable();
        if (canWrite && hasFixed)
        {
            toolbar.Create();
        }
    })
    .Editable(e => e.Mode(GridEditMode.InLine))
    .DataSource(dataSource =>
    {
        var src = dataSource
            .Ajax()
            .Read(read => read.Action("ReadCredentials", "ExternalService", new { area = "Connectivity", oauthServiceId }));
        if (canWrite)
        {
            src.Create(create => create.Action("CreateCredential", "ExternalService", new { area = "Connectivity", oauthServiceId }))
                .Update(update => update.Action("UpdateCredential", "ExternalService", new { area = "Connectivity" }))
                .Destroy(destroy => destroy.Action("DestroyCredential", "ExternalService", new { area = "Connectivity" }));
        }
        src.Model(m =>
        {
            m.Id(t => t.ExternalOAuthServiceTenantLoginId);
            m.Field(t => t.OAuthServiceId).DefaultValue(oauthServiceId is int i ? i : 0);
            m.Field(t => t.OwnerName).Editable(false);
            m.Field(t => t.HasToken).Editable(false);
            m.Field(t => t.HasCredentials).Editable(false);
            m.Field(t => t.Revoked).Editable(false);
        });
    })
    .Scrollable(s => s.Height("auto"))
    .Resizable(c => c.Columns(true)))
<script>
    // Widerruf als eigener Befehl: setzt die Zeile zurueck und widerruft die eigene auch beim Anbieter.
    window.itvRevokeCredential = window.itvRevokeCredential || function (e) {
        e.preventDefault();
        var grid = this;
        var item = grid.dataItem($(e.currentTarget).closest("tr"));
        if (!confirm("@TextsAndMessagesHelper.IWCN_ES_CredRevokeConfirm")) {
            return;
        }
        $.post("@Url.Action("RevokeCredential", "ExternalService", new { area = "Connectivity" })", { id: item.ExternalOAuthServiceTenantLoginId })
            .done(function () { grid.dataSource.read(); });
    };
</script>
