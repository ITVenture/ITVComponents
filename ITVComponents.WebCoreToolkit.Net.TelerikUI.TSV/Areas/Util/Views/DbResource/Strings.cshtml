@using ITVComponents.WebCoreToolkit.Net.Extensions
@using Microsoft.AspNetCore.Mvc.ModelBinding.Metadata
@using System.Text.Encodings.Web
@using System.Collections
@using ITVComponents.WebCoreToolkit.Extensions
@using ITVComponents.WebCoreToolkit.Net.TelerikUi.Extensions
@using ITVComponents.WebCoreToolkit.Net.TelerikUi.Options
@using ITVComponents.WebCoreToolkit.Net.TelerikUi.TenantSecurityViews.Resources
@using ITVComponents.WebCoreToolkit.Net.TelerikUi.TenantSecurityViews.ViewModel
@using ITVComponents.WebCoreToolkit.Net.ViewModel
@using ITVComponents.WebCoreToolkit.Routing
@using Kendo.Mvc.UI
@using Microsoft.AspNetCore.Routing
@using Microsoft.Extensions.Options

@{
    bool stringsRebuildable = (bool)ViewData["CanResetStrings"];
}

@(
Html.Kendo().Grid<LocalizationStringViewModel>().Name($"DbCultureStringList{ViewData["localizationCultureId"]}").HtmlAttributes(new Dictionary<string, object> { { "localizationCultureId", ViewData["localizationCultureId"] } })
        //.HtmlAttributes(new { style = "width:50vw;" })
        .Columns(columns =>
        {
        //columns.Bound(c => c.).Title(TextsAndMessagesHelper.IWCN_General_Name);
        columns.Bound(n => n.LocalizationKey).Title(TextsAndMessagesHelper.IWCN_General_Name);
        columns.Bound(n => n.LocalizationValue).Title(TextsAndMessagesHelper.IWCN_General_Value);
        /*columns.ForeignKey(p => p.PermissionId, ds =>
        {
            ds.Ajax().Read(cfg =>
            {
    cfg.Url("/ForeignKey/sys/Permissions");
    }).ServerOperation(true);
            }, "Key", "Label");*/
if (Context.RequestServices.VerifyUserPermissions(new[] { "DbResources.Write" }))
{
    columns.Command(ga =>
    {
        ga.Edit();
        ga.PopupConfirmDelete();
    }).Width(180);
}

        })
        .ToolBar(toolbar =>
        {
toolbar.RefreshTable();
if (Context.RequestServices.VerifyUserPermissions(new[] { "DbResources.Write" }))
{
    toolbar.Create();
    toolbar.Custom().Name("CopyStrings").Text(TextsAndMessagesHelper.IWCN_DRI_CopyFromOrigin).HtmlAttributes(new Dictionary<string, object>
                {
                    { "onclick", "ITVenture.Pages.Util.DbResources.CopyFromOrigin(event)" }
                });
}
        })
        //.Events(e => e.UseForeignKeyFilter())
        .DataSource(dataSource =>
        {
var src = dataSource
    .Ajax()
    .Read(read => read.Action("ReadStrings", "DbResource", new RouteValueDictionary { { "localizationCultureId", ViewData["localizationCultureId"] } }));
if (Context.RequestServices.VerifyUserPermissions(new[] { "DbResources.Write" }))
{
    src.Create(create => create.Action("CreateString", "DbResource", new RouteValueDictionary { { "localizationCultureId", ViewData["localizationCultureId"] } }))
        .Update(update => update.Action("UpdateString", "DbResource"))
        .Destroy(destroy => destroy.Action("DestroyString", "DbResource"));
}
src.Model(m => m.Id(t => t.LocalizationStringId))
    .Sort(n => n.Add(m => m.LocalizationKey));
        })
        .Scrollable(s => s.Height("auto"))
        .Pageable(p => p.Input(false).Numeric(true).Info(true).PreviousNext(true).PageSizes(true))
        .Sortable(c => c.Enabled(true))
    .Resizable(c => c.Columns(true))
    .Filterable(f => f.Enabled(true))
)
