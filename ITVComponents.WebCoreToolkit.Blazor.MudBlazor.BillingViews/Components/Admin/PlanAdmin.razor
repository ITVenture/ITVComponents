@page "/Billing/Plans"
@rendermode @(RenderMode.InteractiveServer)
@attribute [Microsoft.AspNetCore.Authorization.Authorize]

@inject IBillingHandler Handler
@inject AuthenticationStateProvider AuthState
@inject ISnackbar Snackbar
@inject IStringLocalizer<BillingMessages> L

<PageTitle>@L["Plans_Title"]</PageTitle>

<MudText Typo="Typo.h5" GutterBottom="true">@L["Plans_Title"]</MudText>

@if (currentUser is null)
{
    <MudProgressCircular Indeterminate="true" />
}
else if (!canAdmin)
{
    <MudAlert Severity="Severity.Warning">@L["NoAdminPermission"]</MudAlert>
}
else
{
    <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" Class="mb-3" OnClick="@(() => Edit(new PlanViewModel()))">
        @L["NewPlan"]
    </MudButton>

    <MudTable Items="plans" Dense="true" Hover="true">
        <HeaderContent>
            <MudTh>@L["Col_Name"]</MudTh>
            <MudTh>@L["Col_Price"]</MudTh>
            <MudTh>@L["Col_Interval"]</MudTh>
            <MudTh>@L["Col_Active"]</MudTh>
            <MudTh>@L["Col_ProviderPrice"]</MudTh>
            <MudTh></MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="Name">@context.Name</MudTd>
            <MudTd DataLabel="Price">@PriceSummary(context)</MudTd>
            <MudTd DataLabel="Interval">@context.BillingInterval</MudTd>
            <MudTd DataLabel="Active">@(context.IsActive ? "yes" : "no")</MudTd>
            <MudTd DataLabel="Provider price">@PushSummary(context)</MudTd>
            <MudTd>
                <MudStack Row="true" Spacing="1">
                    <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" OnClick="@(() => Edit(context))" />
                    <MudButton Size="Size.Small" StartIcon="@Icons.Material.Filled.CloudUpload" Disabled="@busy" OnClick="@(() => Push(context.PlanId))">
                        @L["PushToStripe"]
                    </MudButton>
                </MudStack>
            </MudTd>
        </RowTemplate>
    </MudTable>

    @if (editModel is not null)
    {
        <MudPaper Class="pa-4 mt-4" Outlined="true">
            <MudText Typo="Typo.h6">@(editModel.PlanId == 0 ? L["NewPlan"].Value : L["EditPlan", editModel.Name].Value)</MudText>
            <MudGrid>
                <MudItem xs="12" sm="6"><MudTextField @bind-Value="editModel.Name" Label="@(L["Col_Name"])" Required="true" /></MudItem>
                <MudItem xs="12" sm="6"><MudTextField @bind-Value="editModel.Description" Label="@(L["Field_Description"])" /></MudItem>
                <MudItem xs="6" sm="3">
                    <MudSelect T="BillingInterval" @bind-Value="editModel.BillingInterval" Label="@(L["Col_Interval"])">
                        @foreach (var interval in System.Enum.GetValues<BillingInterval>())
                        {
                            <MudSelectItem T="BillingInterval" Value="@interval">@interval</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
                <MudItem xs="6" sm="3"><MudNumericField T="int?" @bind-Value="editModel.TrialDays" Label="@(L["Field_TrialDays"])" /></MudItem>
                <MudItem xs="12">
                    <MudSelect T="string" Label="@(L["Field_Features"])" MultiSelection="true"
                               SelectedValues="selectedFeatures" SelectedValuesChanged="OnFeaturesChanged"
                               AnchorOrigin="Origin.BottomCenter">
                        @foreach (var opt in featureOptions)
                        {
                            <MudSelectItem T="string" Value="@opt.Name">@opt.Display</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
                <MudItem xs="12"><MudCheckBox T="bool" @bind-Value="editModel.IsActive" Label="@(L["Col_Active"])" /></MudItem>

                <MudItem xs="12">
                    <MudText Typo="Typo.subtitle2" Class="mt-2">@L["PricesPerCurrency"]</MudText>
                    @foreach (var price in editModel.Prices)
                    {
                        <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center" Class="my-1">
                            <MudTextField @bind-Value="price.Currency" Label="@(L["Field_Currency"])" Style="max-width:120px" Immediate="true" />
                            <MudNumericField T="decimal" @bind-Value="price.Amount" Label="@(L["Field_Amount"])" Style="max-width:160px" />
                            <MudText Typo="Typo.caption">@(string.IsNullOrEmpty(price.ProviderPriceId) ? L["NotPushed"].Value : price.ProviderPriceId)</MudText>
                            <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" OnClick="@(() => editModel.Prices.Remove(price))" />
                        </MudStack>
                    }
                    <MudButton Size="Size.Small" StartIcon="@Icons.Material.Filled.Add" OnClick="AddPrice">@L["AddPrice"]</MudButton>
                </MudItem>

                <MudItem xs="12">
                    <MudText Typo="Typo.subtitle2" Class="mt-2">@L["BookableAddOns"]</MudText>
                    @if (editAddOns.Count == 0)
                    {
                        <MudText Typo="Typo.caption">@L["NoAddOnsDefined"]</MudText>
                    }
                    @foreach (var addOn in editAddOns)
                    {
                        <MudPaper Class="pa-2 my-1" Outlined="true">
                            <MudCheckBox T="bool" @bind-Value="addOn.Selected" Label="@addOn.Name" />
                            @if (addOn.Selected)
                            {
                                <MudText Typo="Typo.caption" Class="ml-8">@L["PricesPerCurrency"] (@editModel.BillingInterval)</MudText>
                                @foreach (var price in addOn.Prices)
                                {
                                    <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center" Class="my-1 ml-8">
                                        <MudTextField @bind-Value="price.Currency" Label="@(L["Field_Currency"])" Style="max-width:120px" Immediate="true" />
                                        <MudNumericField T="decimal" @bind-Value="price.Amount" Label="@(L["Field_Amount"])" Style="max-width:160px" />
                                        <MudText Typo="Typo.caption">@(string.IsNullOrEmpty(price.ProviderPriceId) ? L["NotPushed"].Value : price.ProviderPriceId)</MudText>
                                        <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" OnClick="@(() => addOn.Prices.Remove(price))" />
                                    </MudStack>
                                }
                                <MudButton Size="Size.Small" Class="ml-8" StartIcon="@Icons.Material.Filled.Add" OnClick="@(() => AddAddOnPrice(addOn))">@L["AddPrice"]</MudButton>
                            }
                        </MudPaper>
                    }
                </MudItem>
            </MudGrid>
            <MudStack Row="true" Spacing="2" Class="mt-2">
                <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="@busy" OnClick="Save">@L["Save"]</MudButton>
                <MudButton Variant="Variant.Text" OnClick="@(() => editModel = null)">@L["Cancel"]</MudButton>
            </MudStack>
        </MudPaper>
    }
}

@code {
    private System.Security.Claims.ClaimsPrincipal? currentUser;
    private bool canAdmin;
    private bool busy;
    private IReadOnlyList<PlanViewModel> plans = System.Array.Empty<PlanViewModel>();
    private PlanViewModel? editModel;
    private IReadOnlyList<FeatureCatalogItemViewModel> catalog = System.Array.Empty<FeatureCatalogItemViewModel>();
    private IReadOnlyCollection<string> selectedFeatures = System.Array.Empty<string>();
    private List<FeatureOption> featureOptions = new();
    private IReadOnlyList<AddOnViewModel> allAddOns = System.Array.Empty<AddOnViewModel>();
    private List<PlanAddOnViewModel> editAddOns = new();

    private sealed record FeatureOption(string Name, string Display);

    protected override async Task OnInitializedAsync()
    {
        var auth = await AuthState.GetAuthenticationStateAsync();
        currentUser = auth.User;
        canAdmin = Handler.CanAdminister(currentUser);
        if (canAdmin)
        {
            catalog = await Handler.GetFeatureCatalogAsync();
            allAddOns = await Handler.GetActiveAddOnsAsync();
            await Reload();
        }
    }

    private async Task Reload() => plans = await Handler.GetAllPlansAsync();

    private void OnFeaturesChanged(IEnumerable<string> values) => selectedFeatures = values.ToList();

    // Options = catalog features (disabled ones marked) plus any keys already on the plan that no longer exist in
    // the catalog (marked "unknown"), so editing never silently drops an orphaned key.
    private void BuildFeatureOptions()
    {
        var opts = new List<FeatureOption>();
        var seen = new HashSet<string>(System.StringComparer.OrdinalIgnoreCase);
        foreach (var f in catalog)
        {
            opts.Add(new FeatureOption(f.Name, f.Enabled ? f.Name : $"{f.Name} ({L["Feature_Disabled"]})"));
            seen.Add(f.Name);
        }
        foreach (var key in editModel!.FeatureKeys.Where(k => !seen.Contains(k)))
        {
            opts.Add(new FeatureOption(key, $"{key} ({L["Feature_Unknown"]})"));
            seen.Add(key);
        }
        featureOptions = opts.OrderBy(o => o.Name).ToList();
    }

    private void Edit(PlanViewModel model)
    {
        editModel = new PlanViewModel
        {
            PlanId = model.PlanId,
            Name = model.Name,
            Description = model.Description,
            BillingInterval = model.BillingInterval,
            TrialDays = model.TrialDays,
            IsActive = model.IsActive,
            Prices = model.Prices.Select(p => new PriceViewModel { Currency = p.Currency, Amount = p.Amount, ProviderPriceId = p.ProviderPriceId }).ToList(),
            FeatureKeys = new List<string>(model.FeatureKeys)
        };
        selectedFeatures = new List<string>(editModel.FeatureKeys);
        BuildFeatureOptions();
        BuildAddOnEditors(model);
    }

    // Offer every active add-on as a checkbox; pre-select and pre-fill prices for the ones already linked to the
    // plan (carried on the plan's AddOns), leaving the rest unselected with an empty price list.
    private void BuildAddOnEditors(PlanViewModel model)
    {
        var linked = model.AddOns.ToDictionary(a => a.AddOnId);
        editAddOns = allAddOns.Select(a =>
        {
            if (linked.TryGetValue(a.AddOnId, out var existing))
            {
                return new PlanAddOnViewModel
                {
                    AddOnId = a.AddOnId,
                    Name = a.Name,
                    Description = a.Description,
                    Selected = true,
                    Prices = existing.Prices.Select(p => new PriceViewModel { Currency = p.Currency, Amount = p.Amount, ProviderPriceId = p.ProviderPriceId }).ToList()
                };
            }

            return new PlanAddOnViewModel { AddOnId = a.AddOnId, Name = a.Name, Description = a.Description, Selected = false };
        }).OrderBy(a => a.Name).ToList();
    }

    private void AddPrice() => editModel?.Prices.Add(new PriceViewModel { Currency = "EUR" });

    private static void AddAddOnPrice(PlanAddOnViewModel addOn) => addOn.Prices.Add(new PriceViewModel { Currency = "EUR" });

    private string PriceSummary(PlanViewModel plan)
        => plan.Prices.Count == 0 ? "—" : string.Join(", ", plan.Prices.Select(p => $"{p.Amount:0.00} {p.Currency.ToUpperInvariant()}"));

    private string PushSummary(PlanViewModel plan)
        => plan.Prices.Count == 0 ? "—" : $"{plan.Prices.Count(p => !string.IsNullOrEmpty(p.ProviderPriceId))}/{plan.Prices.Count}";

    private async Task Save()
    {
        if (editModel is null)
        {
            return;
        }

        editModel.FeatureKeys = selectedFeatures
            .Where(k => !string.IsNullOrWhiteSpace(k))
            .Distinct(System.StringComparer.OrdinalIgnoreCase)
            .ToList();

        // Only selected add-ons are persisted as plan links (the handler filters on Selected too).
        editModel.AddOns = editAddOns.Where(a => a.Selected).ToList();

        busy = true;
        try
        {
            await Handler.SavePlanAsync(editModel);
            Snackbar.Add(L["PlanSaved"], Severity.Success);
            editModel = null;
            await Reload();
        }
        catch (System.Exception ex)
        {
            Snackbar.Add(L["SaveFailed", ex.Message], Severity.Error);
        }
        finally
        {
            busy = false;
        }
    }

    private async Task Push(int planId)
    {
        busy = true;
        try
        {
            await Handler.PushPlanAsync(planId);
            Snackbar.Add(L["PushedToStripe"], Severity.Success);
            await Reload();
        }
        catch (System.Exception ex)
        {
            Snackbar.Add(L["PushFailed", ex.Message], Severity.Error);
        }
        finally
        {
            busy = false;
        }
    }
}
