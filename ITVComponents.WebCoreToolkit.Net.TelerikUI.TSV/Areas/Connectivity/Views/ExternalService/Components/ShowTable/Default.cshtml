@using ITVComponents.WebCoreToolkit.Net.Extensions
@using Microsoft.AspNetCore.Mvc.ModelBinding.Metadata
@using System.Text.Encodings.Web
@using System.Collections
@using ITVComponents.WebCoreToolkit.Extensions
@using ITVComponents.WebCoreToolkit.Net.TelerikUi.Resources
@using ITVComponents.WebCoreToolkit.Net.TelerikUi.Extensions
@using ITVComponents.WebCoreToolkit.Net.TelerikUi.TenantSecurityViews.ViewModel
@using Kendo.Mvc.UI
@using Microsoft.AspNetCore.Http
@using TextsAndMessagesHelper = ITVComponents.WebCoreToolkit.Net.TelerikUi.TenantSecurityViews.Resources.TextsAndMessagesHelper
@{
    var tenantIdRaw = ViewData["tenantId"];
    var useConnect = ViewData["useConnect"] is bool b && b;
    var tenantDisp = tenantIdRaw != null ? tenantIdRaw.ToString() : "Public";
    var tmp = Html.Kendo().Grid<ExternalOAuthServiceViewModel>().Name($"ServicesFor{tenantDisp}")
        //.HtmlAttributes(new { style = "width:50vw;" })
        .Columns(columns =>
        {
            columns.Bound(c => c.UniqueConnectionName).Filterable(true).Title(TextsAndMessagesHelper.IWCN_General_Name);
            columns.InlineCheckbox(c => c.Global, nameof(ExternalOAuthServiceViewModel.OAuthServiceId), readOnly: true).Title(TextsAndMessagesHelper.IWCN_ES_Global);
            if (Context.RequestServices.VerifyUserPermissions(new[] { "Services.Connections.Write" }))
            {
                columns.Command(cmd =>
                {
                    if (!useConnect)
                    {
                        cmd.Edit();
                        cmd.PopupConfirmDelete();
                    }
                    else
                    {
                        cmd.Custom("connectSvc").Text("\u200B").Click("ITVenture.Pages.ExternalOAuthServices.ConnectService").HtmlAttributes(new { @class = "itv-grid-button itv-fa-gbx glyphSprite", title = TextsAndMessagesHelper.IWCN_ES_ConnectSvc }).IconClass("fa-duotone fa-link-simple");
                    }
                });
            }

        })
        .ToolBar(toolbar =>
        {
            toolbar.RefreshTable();
            if (Context.RequestServices.VerifyUserPermissions(new[] { "Services.Connections.Write" }) && !useConnect)
            {
                toolbar.Create();
            }
        })
        .DataSource(dataSource =>
        {
            var tmp = dataSource
                .Ajax();
            if (!useConnect)
            {
                tmp.Read(read => read.Action("Read", "ExternalService", new { tenantId = tenantIdRaw }));
            }
            else
            {
                tmp.Read(read => read.Action("ReadForConnect", "ExternalService"));
            }
            if (Context.RequestServices.VerifyUserPermissions(new[] { "Services.Connections.Write" }))
            {
                tmp.Update(update => update.Action("Update", "ExternalService"))
                    .Create(cr => cr.Action("Create", "ExternalService", new { tenantId = tenantIdRaw }))
                    .Destroy(ds => ds.Action("Delete", "ExternalService"));
            }

            tmp.Model(m => m.Id(t => t.OAuthServiceId))
                .Sort(n => n.Add(m => m.UniqueConnectionName));
        })
        //.Scrollable(s => s.Height("auto"))
        .Pageable(p => p.Input(false).Numeric(true).Info(true).PreviousNext(true).PageSizes(true))
        .Sortable(c => c.Enabled(true))
        .Filterable(f => f.Enabled(true))
        .Resizable(c => c.Columns(true))
        .Editable(ed => ed.Mode(GridEditMode.PopUp).TemplateName("ExOsvcEdit"));
    if (useConnect)
    {
        tmp.ClientDetailTemplateId("serviceDetails");
    }
}
@tmp