@using Microsoft.Extensions.Localization
@using Microsoft.Extensions.Logging
@using ITVComponents.WebCoreToolkit.Blazor.MudBlazor.AdminViews.TenantSecurityViews.Handlers.Impl

@implements IAsyncDisposable
@inject IJSRuntime Js
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject ILogger<ShareLinkDialog> Logger
@inject IStringLocalizer<ShareMessages> L

@* Der Link ist das Ergebnis des Teilens - er gehoert dorthin, wo man ihn in Ruhe kopieren kann, und
   nicht in eine Meldung, die nach drei Sekunden verschwindet. *@

<MudDialog>
    <DialogContent>
        @* Die Reihenfolge folgt dem Zweck: wer verschickt, braucht zuerst den Link; wer den Code einem
           Gegenueber hinhaelt (Kasse, Aushang, zweites Telefon), zuerst das Bild. *@
        @if (QrFirst)
        {
            @QrSection
            @LinkSection
        }
        else
        {
            @LinkSection
            @QrSection
        }

        @* Die Restlaufzeit ist die naechste Frage, die ein Empfaenger hat - und bei einem Ad-hoc-Ticket
           die einzige Antwort darauf, denn zurueckziehen laesst es sich nicht einzeln. *@
        @if (Remaining is { } left)
        {
            <MudAlert Severity="@(left.TotalMinutes <= 5 ? Severity.Warning : Severity.Info)" Dense="true"
                      Class="mt-2">
                @Describe(left)
            </MudAlert>
        }
    </DialogContent>
    <DialogActions>
        @if (Renew != null)
        {
            <MudButton StartIcon="@Icons.Material.Filled.Autorenew" Color="Color.Warning" OnClick="RenewLink"
                       Disabled="renewing">@L["Share_Renew"]</MudButton>
        }
        <MudButton StartIcon="@Icons.Material.Filled.ContentCopy" OnClick="Copy">@L["Share_Copy"]</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="Close">@L["Share_Close"]</MudButton>
    </DialogActions>
</MudDialog>

@code {
    /// <summary>Der Pfad des Moduls, das Speichern und Drucken uebernimmt.</summary>
    private const string ModulePath =
        "./_content/ITVComponents.WebCoreToolkit.Blazor.MudBlazor.AdminViews/share-qr.js";

    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter, EditorRequired] public string Link { get; set; } = string.Empty;

    /// <summary>
    /// Der Titel der Freigabe. Er benennt die gespeicherte Datei und steht auf dem Ausdruck - ein Blatt
    /// mit nichts als einem Quadrat darauf sagt niemandem, wohin es fuehrt.
    /// </summary>
    [Parameter] public string? Title { get; set; }

    /// <summary>
    /// Wann die Freigabe endet, oder null, wenn sie unbefristet ist.
    /// </summary>
    [Parameter] public DateTime? ValidUntil { get; set; }

    /// <summary>
    /// Zeigt sofort den QR-Code und den Link erst auf Wunsch. Fuer Stellen, an denen der Link nicht
    /// verschickt, sondern einem Gegenueber hingehalten wird. Kopieren bleibt in beiden Faellen da.
    /// </summary>
    [Parameter] public bool QrFirst { get; set; }

    /// <summary>
    /// Erneuert das Geheimnis der Freigabe und liefert den neuen Link (oder null, wenn es nicht ging).
    /// Null = kein Knopf. Gesetzt wird es nur fuer gespeicherte, anonyme Freigaben - und nur vom
    /// Besitzer, denn nur er bekommt den Link ueberhaupt zu sehen.
    /// </summary>
    /// <remarks>
    /// Der Weg, einen missbrauchten Aushang zu entwerten, wenn die Vorlage nur eine Freigabe je Ort fuehrt:
    /// eine zweite laesst sich dort nicht mehr ausstellen.
    /// </remarks>
    [Parameter] public Func<Task<string?>>? Renew { get; set; }

    /// <summary>
    /// Wie lange sie noch gilt. Null, wenn unbefristet - abgelaufen ergibt <see cref="TimeSpan.Zero"/>,
    /// damit der Dialog es sagen kann, statt die Angabe wegzulassen.
    /// </summary>
    /// <remarks>
    /// Einmal beim Zeichnen gerechnet und nicht mitlaufend: der Dialog steht Sekunden, nicht Minuten,
    /// und eine tickende Anzeige waere ein Timer je geoeffnetem Dialog fuer nichts.
    /// </remarks>
    private TimeSpan? Remaining
    {
        get
        {
            if (ValidUntil == null)
            {
                return null;
            }

            var left = ValidUntil.Value - DateTime.UtcNow;
            return left < TimeSpan.Zero ? TimeSpan.Zero : left;
        }
    }

    private string Describe(TimeSpan left)
        => left == TimeSpan.Zero ? L["Share_Expired"]
            : left.TotalMinutes < 1 ? L["Share_ExpiresSoon"]
            : left.TotalHours < 1 ? L["Share_RemainingMinutes", (int)left.TotalMinutes]
            : left.TotalDays < 1 ? L["Share_RemainingHours", (int)left.TotalHours]
            : L["Share_RemainingDays", (int)left.TotalDays];

    private ShareQrResult? qr;
    private IJSObjectReference? module;
    private bool linkShown = true;

    /// <summary>
    /// Ob das Linkfeld zu sehen ist. Scheitert der QR-Code, steht es immer da - sonst saesse man im
    /// QR-zuerst-Modus vor einer Fehlermeldung und haette nichts in der Hand.
    /// </summary>
    private bool LinkVisible => linkShown || qr is { Success: false };

    /// <summary>Der gezeigte Link - nach dem Erneuern ein anderer als der uebergebene.</summary>
    private string currentLink = string.Empty;
    private bool renewing;

    protected override void OnInitialized()
    {
        currentLink = Link;
        if (QrFirst)
        {
            linkShown = false;
            ShowQr();
        }
    }

    private RenderFragment LinkSection => __builder =>
    {
        if (LinkVisible)
        {
            <MudTextField T="string" Value="@currentLink" Label="@L["Share_LinkLabel"]" ReadOnly="true" Lines="3" Class="itv-share-link mt-3" />
            <MudText Typo="Typo.caption" Class="mt-2">
                @L["Share_LinkHint"]
            </MudText>
        }
        else
        {
            <MudButton StartIcon="@Icons.Material.Filled.Link" OnClick="ShowLink" Class="mt-3">
                @L["Share_ShowLink"]
            </MudButton>
        }
    };

    // Der QR-Code entsteht erst auf Wunsch - es sei denn, der Aufrufer sagt mit QrFirst, dass genau er
    // gefragt ist: die meisten Freigaben werden verschickt, und wer sie verschickt, braucht kein Bild.
    // Gefragt ist er dort, wo der Link auf ein Mobilgeraet oder auf Papier soll - beides ohne Abtippen.
    private RenderFragment QrSection => __builder =>
    {
        if (qr is null)
        {
            <MudButton StartIcon="@Icons.Material.Filled.QrCode2" OnClick="ShowQr" Class="mt-3">
                @L["Share_ShowQr"]
            </MudButton>
        }
        else if (!qr.Success)
        {
            <MudAlert Severity="Severity.Warning" Dense="true" Class="mt-3">@L[qr.Error ?? "Share_QrFailed"]</MudAlert>
        }
        else
        {
            <MudPaper Outlined="true" Class="mt-3 pa-3 d-flex flex-column align-center">
                @* Weisser Grund fest verdrahtet, unabhaengig vom Farbschema: ein invertierter QR-Code wird
                   von vielen Kameras nicht gelesen, und gedruckt wird er ohnehin schwarz auf weiss. Die
                   Angaben stehen hier und nicht in einer .razor.css - scoped CSS erreicht den Dialog nicht,
                   weil der MudDialogProvider ihn ausserhalb dieser Komponente zeichnet. *@
                <img src="@qr.DataUri" alt="@L["Share_QrAlt"]" width="220" height="220"
                     style="max-width:100%;height:auto;background:#fff;padding:8px;border-radius:4px;image-rendering:pixelated" />
                <MudStack Row="true" Spacing="1" Class="mt-2">
                    <MudButton StartIcon="@Icons.Material.Filled.Download" OnClick="SaveQr">@L["Share_SavePng"]</MudButton>
                    <MudButton StartIcon="@Icons.Material.Filled.Print" OnClick="PrintQr">@L["Share_Print"]</MudButton>
                    <MudButton OnClick="HideQr">@L["Share_Hide"]</MudButton>
                </MudStack>
            </MudPaper>
        }
    };

    private void Close() => MudDialog.Close();

    private void ShowQr() => qr = ShareQrCode.Create(currentLink, Logger);

    private void HideQr() => qr = null;

    private void ShowLink() => linkShown = true;

    private async Task RenewLink()
    {
        if (Renew == null)
        {
            return;
        }

        var ok = await DialogService.ShowMessageBoxAsync(L["Share_RenewTitle"], L["Share_RenewConfirm"],
            yesText: L["Share_Renew"], cancelText: L["Share_Cancel"]);
        if (ok != true)
        {
            return;
        }

        renewing = true;
        try
        {
            var renewed = await Renew();
            if (string.IsNullOrEmpty(renewed))
            {
                // Warum, steht im Log. Ob das alte Geheimnis schon ersetzt ist, weiss der Dialog nicht - deshalb
                // der Verweis auf die Uebersicht und keine Behauptung ueber den alten Link.
                Snackbar.Add(L["Share_RenewFailed"], Severity.Error);
                return;
            }

            currentLink = renewed;
            if (qr != null)
            {
                // Das alte Bild zeigt auf einen toten Link - es darf nicht stehen bleiben.
                ShowQr();
            }

            Snackbar.Add(L["Share_Renewed"], Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add(L["Share_RenewFailed"], Severity.Error);
            Logger.LogError(ex, "Could not renew a share link.");
        }
        finally
        {
            renewing = false;
        }
    }

    private async Task Copy()
    {
        try
        {
            await Js.InvokeVoidAsync("navigator.clipboard.writeText", currentLink);
            Snackbar.Add(L["Share_Copied"], Severity.Success);
        }
        catch (Exception ex)
        {
            // Die Zwischenablage ist nicht ueberall erreichbar (kein sicherer Kontext, verweigerte
            // Berechtigung). Das Feld zeigt den Link weiterhin - im QR-zuerst-Modus wird es dafuer
            // aufgeklappt -, der Benutzer ist also nicht aufgeschmissen, aber wir verschweigen den Grund nicht.
            linkShown = true;
            Snackbar.Add(L["Share_CopyFailed"], Severity.Warning);
            Logger.LogWarning(ex, "Could not write a share link to the clipboard.");
        }
    }

    private async Task SaveQr()
    {
        if (qr is not { Success: true })
        {
            return;
        }

        try
        {
            var js = await LoadModuleAsync();
            await js.InvokeVoidAsync("save", ShareQrCode.FileName(Title), qr.PngBase64);
        }
        catch (Exception ex)
        {
            // Das Bild bleibt sichtbar - es laesst sich immer noch ueber das Kontextmenue des Browsers
            // sichern. Warum der bequeme Weg nicht ging, gehoert trotzdem ins Log.
            Snackbar.Add(L["Share_SaveFailed"], Severity.Warning);
            Logger.LogError(ex, "Could not hand the QR code of a share link to the browser for saving.");
        }
    }

    private async Task PrintQr()
    {
        if (qr is not { Success: true })
        {
            return;
        }

        try
        {
            var js = await LoadModuleAsync();
            await js.InvokeVoidAsync("printCode", Title ?? string.Empty, currentLink, qr.PngBase64);
        }
        catch (Exception ex)
        {
            Snackbar.Add(L["Share_PrintFailed"], Severity.Warning);
            Logger.LogError(ex, "Could not open the print view for the QR code of a share link.");
        }
    }

    private async Task<IJSObjectReference> LoadModuleAsync()
        => module ??= await Js.InvokeAsync<IJSObjectReference>("import", ModulePath);

    public async ValueTask DisposeAsync()
    {
        if (module is null)
        {
            return;
        }

        try
        {
            await module.DisposeAsync();
        }
        catch (JSDisconnectedException ex)
        {
            // Wurde der Circuit schon abgebaut (Seite geschlossen, Verbindung weg), gibt es nichts mehr
            // freizugeben. Das ist der Normalfall beim Beenden und kein Fehler.
            Logger.LogDebug(ex, "The QR helper module was already gone when the share link dialog closed.");
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Could not release the QR helper module of the share link dialog.");
        }
    }
}
