<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <Nullable>enable</Nullable>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageReference Include="MSTest.TestAdapter" Version="4.5.1" />
    <PackageReference Include="MSTest.TestFramework" Version="4.5.1" />
    <!-- Nur fuer die Buchung der Webhook-Meldungen: die laeuft ueber einen DbContext, und genau ihre
         Idempotenz ist das, was geprueft werden muss. Kein Anbieter und kein Netz noetig. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.InMemory" Version="10.0.13" />
  </ItemGroup>
  <ItemGroup>
    <!-- The provider-neutral billing library: the money arithmetic and the price model are pure, and proving
         them needs neither a container nor a provider account. -->
    <ProjectReference Include="..\ITVComponents.WebCoreToolkit.EntityFramework.Billing\ITVComponents.WebCoreToolkit.EntityFramework.Billing.csproj" />
    <!-- Die Agent-Seite der Geraete-Einstellungen: was die Maske aus der Selbstbeschreibung eines Terminals
         erzeugt, muss die strenge Pruefung am Agenten annehmen. -->
    <ProjectReference Include="..\ITVComponents.AgentServices\ITVComponents.AgentServices.csproj" />
    <!-- Und der Stripe-Teil, aber nur fuer die Spiegelung des Connect-Kontos: auch die ist eine reine
         Abbildung, die ohne Netz und ohne Anbieter-Konto zu pruefen ist - und die einzige Stelle, an der
         eine falsche Uebersetzung unmittelbar Geld bewegt. -->
    <ProjectReference Include="..\ITVComponents.WebCoreToolkit.Billing.Stripe\ITVComponents.WebCoreToolkit.Billing.Stripe.csproj" />
    <!-- Payrexx und wallee aus demselben Grund - und aus einem zweiten: bis hierher referenzierte sie
         niemand, und in der Projektmappe standen sie auch nicht. Ein Fehler in ihnen waere nie
         aufgefallen, weil sie schlicht nie mitgebaut wurden. Schon die Referenz allein haelt sie im Bau. -->
    <ProjectReference Include="..\ITVComponents.WebCoreToolkit.Billing.Payrexx\ITVComponents.WebCoreToolkit.Billing.Payrexx.csproj" />
    <ProjectReference Include="..\ITVComponents.WebCoreToolkit.Billing.Wallee\ITVComponents.WebCoreToolkit.Billing.Wallee.csproj" />
    <ProjectReference Include="..\ITVComponents.WebCoreToolkit.Billing.SumUp\ITVComponents.WebCoreToolkit.Billing.SumUp.csproj" />
    <!-- Der Zugangsdaten-Speicher der eigenen Anbieter-Zugaenge (Leitfaden §92). -->
    <ProjectReference Include="..\ITVComponents.WebCoreToolkit.EntityFramework.Billing.TenantSecurity\ITVComponents.WebCoreToolkit.EntityFramework.Billing.TenantSecurity.csproj" />
  </ItemGroup>
</Project>