@page "/Util/HealthScripts"
@rendermode @(RenderMode.InteractiveServer)
@attribute [Microsoft.AspNetCore.Authorization.Authorize]

@using Microsoft.AspNetCore.Components.Authorization

@inject IHealthScriptAdminHandler Handler
@inject AuthenticationStateProvider AuthState
@inject IDialogService DialogService
@inject ISnackbar Snackbar

<PageTitle>Health scripts</PageTitle>

<MudText Typo="Typo.h5" GutterBottom="true">Health scripts</MudText>

<SecureView RequiredPermissions="HealthChecks.View,HealthChecks.Write,Sysadmin" RequiredFeatures="ITVAdminViews">
    <Permitted>
@if (currentUser is null)
{
    <MudProgressCircular Indeterminate="true" />
}
else
{
    <MudDataGrid T="HealthScriptViewModel"
                 @ref="grid"
                 ServerData="LoadData"
                 SortMode="SortMode.Single"
                 RowsPerPage="25"
                 Hover="true"
                 Dense="true">
        <ToolBarContent>
            <RefreshButton OnClick="ReloadGrid" />
            <MudText Typo="Typo.h6">Health scripts</MudText>
            <MudSpacer />
            <MudTextField @bind-Value="search"
                          Placeholder="Search…"
                          Adornment="Adornment.Start"
                          AdornmentIcon="@Icons.Material.Filled.Search"
                          IconSize="Size.Medium"
                          Class="mt-0"
                          DebounceInterval="300"
                          OnDebounceIntervalElapsed="ReloadGrid" />
            <SecureView RequiredPermissions="HealthChecks.Write,Sysadmin">
                <Permitted>
                <MudButton StartIcon="@Icons.Material.Filled.Add" Variant="Variant.Filled" Color="Color.Primary" Class="ml-2" OnClick="OpenCreate">
                    Add script
                </MudButton>
                </Permitted>
            </SecureView>
        </ToolBarContent>
        <Columns>
            <PropertyColumn Property="x => x.HealthScriptName" Title="Name" />
            <TemplateColumn T="HealthScriptViewModel" Title="" Sortable="false">
                <CellTemplate>
                    <SecureView RequiredPermissions="HealthChecks.Write,Sysadmin">
                        <Permitted>
                        <MudStack Row="true" Spacing="1">
                            <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" OnClick="@(() => OpenEdit(context.Item))" />
                            <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error" OnClick="@(() => Delete(context.Item))" />
                        </MudStack>
                        </Permitted>
                    </SecureView>
                </CellTemplate>
            </TemplateColumn>
        </Columns>
        <PagerContent>
            <MudDataGridPager T="HealthScriptViewModel" />
        </PagerContent>
    </MudDataGrid>
}
    </Permitted>
    <NotPermitted>
        <MudAlert Severity="Severity.Warning">No permission to view health scripts.</MudAlert>
    </NotPermitted>
</SecureView>

@code {
    private MudDataGrid<HealthScriptViewModel>? grid;
    private System.Security.Claims.ClaimsPrincipal? currentUser;
    private bool hasView;
    private bool hasWrite;
    private string? search;

    protected override async Task OnInitializedAsync()
    {
        var auth = await AuthState.GetAuthenticationStateAsync();
        currentUser = auth.User;
        hasView = Handler.HasPermission(currentUser, "HealthChecks.View", "HealthChecks.Write", "Sysadmin");
        hasWrite = Handler.HasPermission(currentUser, "HealthChecks.Write", "Sysadmin");
    }

    private async Task<GridData<HealthScriptViewModel>> LoadData(GridState<HealthScriptViewModel> state, CancellationToken ct)
    {
        if (currentUser is null) return new GridData<HealthScriptViewModel> { Items = Array.Empty<HealthScriptViewModel>(), TotalItems = 0 };
        var sort = state.SortDefinitions.FirstOrDefault();
        var query = new ListQuery
        {
            Page = state.Page,
            PageSize = state.PageSize,
            SortColumn = sort?.SortBy,
            SortDescending = sort?.Descending ?? false,
            Search = search
        };
        var result = await Handler.ListAsync(currentUser, query);
        return new GridData<HealthScriptViewModel> { Items = result.Items, TotalItems = result.TotalCount };
    }

    private async Task ReloadGrid()
    {
        if (grid is not null) await grid.ReloadServerData();
    }

    private async Task OpenCreate()
    {
        var parameters = new DialogParameters<HealthScriptDialog> { { d => d.Model, new HealthScriptViewModel() }, { d => d.IsCreate, true } };
        var dlg = await DialogService.ShowAsync<HealthScriptDialog>("Create health script", parameters, EditDialogDefaults.Edit);
        var result = await dlg.Result;
        if (result is { Canceled: false, Data: HealthScriptViewModel input })
        {
            var created = await Handler.CreateAsync(currentUser!, input);
            if (created != null) { Snackbar.Add("Health script created", Severity.Success); await ReloadGrid(); }
            else Snackbar.Add("Failed to create", Severity.Error);
        }
    }

    private async Task OpenEdit(HealthScriptViewModel item)
    {
        var copy = new HealthScriptViewModel
        {
            HealthScriptId = item.HealthScriptId,
            HealthScriptName = item.HealthScriptName,
            Script = item.Script
        };
        var parameters = new DialogParameters<HealthScriptDialog> { { d => d.Model, copy }, { d => d.IsCreate, false } };
        var dlg = await DialogService.ShowAsync<HealthScriptDialog>("Edit health script", parameters, EditDialogDefaults.Edit);
        var result = await dlg.Result;
        if (result is { Canceled: false, Data: HealthScriptViewModel input })
        {
            var updated = await Handler.UpdateAsync(currentUser!, input);
            if (updated != null) { Snackbar.Add("Health script updated", Severity.Success); await ReloadGrid(); }
            else Snackbar.Add("Failed to update", Severity.Error);
        }
    }

    private async Task Delete(HealthScriptViewModel item)
    {
        var ok = await DialogService.ShowMessageBoxAsync("Delete health script", $"Really delete '{item.HealthScriptName}'?", yesText: "Delete", cancelText: "Cancel");
        if (ok != true) return;
        var success = await Handler.DeleteAsync(currentUser!, item.HealthScriptId);
        if (success) { Snackbar.Add("Health script deleted", Severity.Success); await ReloadGrid(); }
        else Snackbar.Add("Failed to delete", Severity.Error);
    }
}
