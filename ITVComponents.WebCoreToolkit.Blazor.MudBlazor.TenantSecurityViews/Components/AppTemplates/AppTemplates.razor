@page "/Connectivity/AppTemplates"
@rendermode @(RenderMode.InteractiveServer)
@attribute [Microsoft.AspNetCore.Authorization.Authorize]

@using Microsoft.AspNetCore.Components.Authorization
@using ITVComponents.WebCoreToolkit.TenantSecurityViews.Blazor.Components.CrossGrids

@inject IAppTemplateAdminHandler Handler
@inject AuthenticationStateProvider AuthState
@inject IDialogService DialogService
@inject ISnackbar Snackbar

<PageTitle>Client app templates</PageTitle>

<MudText Typo="Typo.h5" GutterBottom="true">Client app templates</MudText>

@if (currentUser is null)
{
    <MudProgressCircular Indeterminate="true" />
}
else if (!hasView)
{
    <MudAlert Severity="Severity.Warning">No permission to view templates.</MudAlert>
}
else
{
    <MudDataGrid T="ClientAppTemplateViewModel"
                 @ref="grid"
                 ServerData="LoadData"
                 SortMode="SortMode.Single"
                 RowsPerPage="25"
                 Hover="true"
                 Dense="true">
        <ToolBarContent>
            <RefreshButton OnClick="ReloadGrid" />
            <MudText Typo="Typo.h6">Client app templates</MudText>
            <MudSpacer />
            <MudTextField @bind-Value="search"
                          Placeholder="Search…"
                          Adornment="Adornment.Start"
                          AdornmentIcon="@Icons.Material.Filled.Search"
                          IconSize="Size.Medium"
                          Class="mt-0"
                          DebounceInterval="300"
                          OnDebounceIntervalElapsed="ReloadGrid" />
            @if (hasWrite)
            {
                <MudButton StartIcon="@Icons.Material.Filled.Add" Variant="Variant.Filled" Color="Color.Primary" Class="ml-2" OnClick="OpenCreate">
                    Add template
                </MudButton>
            }
        </ToolBarContent>
        <Columns>
            <HierarchyColumn T="ClientAppTemplateViewModel" />
            <PropertyColumn Property="x => x.Name" Title="Name" />
            <TemplateColumn T="ClientAppTemplateViewModel" Title="" Sortable="false">
                <CellTemplate>
                    @if (hasWrite)
                    {
                        <MudStack Row="true" Spacing="1">
                            <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" OnClick="@(() => OpenEdit(context.Item))" />
                            <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error" OnClick="@(() => Delete(context.Item))" />
                        </MudStack>
                    }
                </CellTemplate>
            </TemplateColumn>
        </Columns>
        <ChildRowContent>
            <MudPaper Elevation="0" Class="pa-2">
                <MudTabs Elevation="0" Rounded="true">
                    <MudTabPanel Text="Permission sets">
                        <PermissionSetsForTemplateGrid ClientAppTemplateId="@context.Item.ClientAppTemplateId" />
                    </MudTabPanel>
                </MudTabs>
            </MudPaper>
        </ChildRowContent>
        <PagerContent>
            <MudDataGridPager T="ClientAppTemplateViewModel" />
        </PagerContent>
    </MudDataGrid>
}

@code {
    private MudDataGrid<ClientAppTemplateViewModel>? grid;
    private System.Security.Claims.ClaimsPrincipal? currentUser;
    private bool hasView;
    private bool hasWrite;
    private string? search;

    protected override async Task OnInitializedAsync()
    {
        var auth = await AuthState.GetAuthenticationStateAsync();
        currentUser = auth.User;
        hasView = Handler.HasPermission(currentUser, "Apps.Templates.View", "Apps.Templates.Write");
        hasWrite = Handler.HasPermission(currentUser, "Apps.PermissionSets.Write");
    }

    private async Task<GridData<ClientAppTemplateViewModel>> LoadData(GridState<ClientAppTemplateViewModel> state, CancellationToken ct)
    {
        if (currentUser is null) return new GridData<ClientAppTemplateViewModel> { Items = Array.Empty<ClientAppTemplateViewModel>(), TotalItems = 0 };
        var sort = state.SortDefinitions.FirstOrDefault();
        var query = new ListQuery
        {
            Page = state.Page,
            PageSize = state.PageSize,
            SortColumn = sort?.SortBy,
            SortDescending = sort?.Descending ?? false,
            Search = search
        };
        var result = await Handler.ListAsync(currentUser, query);
        return new GridData<ClientAppTemplateViewModel> { Items = result.Items, TotalItems = result.TotalCount };
    }

    private async Task ReloadGrid()
    {
        if (grid is not null) await grid.ReloadServerData();
    }

    private async Task OpenCreate()
    {
        var parameters = new DialogParameters<AppTemplateDialog> { { d => d.Model, new ClientAppTemplateViewModel() }, { d => d.IsCreate, true } };
        var dlg = await DialogService.ShowAsync<AppTemplateDialog>("Create template", parameters, EditDialogDefaults.Edit);
        var result = await dlg.Result;
        if (result is { Canceled: false, Data: ClientAppTemplateViewModel input })
        {
            var created = await Handler.CreateAsync(currentUser!, input);
            if (created != null) { Snackbar.Add("Template created", Severity.Success); await ReloadGrid(); }
            else Snackbar.Add("Failed to create", Severity.Error);
        }
    }

    private async Task OpenEdit(ClientAppTemplateViewModel item)
    {
        var copy = new ClientAppTemplateViewModel
        {
            ClientAppTemplateId = item.ClientAppTemplateId,
            Name = item.Name
        };
        var parameters = new DialogParameters<AppTemplateDialog> { { d => d.Model, copy }, { d => d.IsCreate, false } };
        var dlg = await DialogService.ShowAsync<AppTemplateDialog>("Edit template", parameters, EditDialogDefaults.Edit);
        var result = await dlg.Result;
        if (result is { Canceled: false, Data: ClientAppTemplateViewModel input })
        {
            var updated = await Handler.UpdateAsync(currentUser!, input);
            if (updated != null) { Snackbar.Add("Template updated", Severity.Success); await ReloadGrid(); }
            else Snackbar.Add("Failed to update", Severity.Error);
        }
    }

    private async Task Delete(ClientAppTemplateViewModel item)
    {
        var ok = await DialogService.ShowMessageBoxAsync("Delete template", $"Really delete '{item.Name}'?", yesText: "Delete", cancelText: "Cancel");
        if (ok != true) return;
        var success = await Handler.DeleteAsync(currentUser!, item.ClientAppTemplateId);
        if (success) { Snackbar.Add("Template deleted", Severity.Success); await ReloadGrid(); }
        else Snackbar.Add("Failed to delete", Severity.Error);
    }
}
