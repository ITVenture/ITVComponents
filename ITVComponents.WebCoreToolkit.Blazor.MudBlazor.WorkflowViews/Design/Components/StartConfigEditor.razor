@using ITVComponents.Scheduling
@using ITVComponents.Workflow.Model
@inject IDialogService DialogService

@*
    Tab-basierter Editor fuer den Start-Knoten. Reiter: General (Identitaet), Signature (was aus den
    uebergebenen Werten wird), Start form (was ein Mensch beim Start von Hand eingibt).

    Die Reiter bilden genau die Trennung ab, die man hier nicht verwechseln darf:
    - Die SIGNATUR gilt fuer JEDEN Einstieg - Start von Hand, programmatischer Start, Aufruf als
      Subworkflow.
    - Die MASKE ist rein beschreibend und betrifft nur den Start von Hand; die Engine liest sie nicht.
    Der Feldname der Maske ist der Name der uebergebenen Variable - also genau das, wogegen die Signatur
    anschliessend aufgeloest wird. Deshalb steht der Hinweis auf verworfene Felder beim FORMULAR und
    nicht bei der Signatur: dort faellt er auf, waehrend man die Felder anlegt.

    KeepPanelsAlive, damit das Monaco-Feld (Beschreibung) auch dann fuer FlushAsync erreichbar ist, wenn
    sein Reiter nicht aktiv ist.
*@

@if (Node is not null)
{
  <MudTabs Elevation="0" Rounded="true" ApplyEffectsToContainer="true" PanelClass="pt-4"
           KeepPanelsAlive="true" MinimumTabWidth="70px">
    <MudTabPanel Text="General" Icon="@Icons.Material.Filled.Info">
        <MudTextField Value="@Node.Id" Label="Id" ReadOnly="true" Margin="Margin.Dense" />
        <MudTextField @bind-Value="Node.Name" Label="Name" Margin="Margin.Dense" />
        <MudText Typo="Typo.caption" Class="mt-1">Kind: @Node.Kind</MudText>

        <SectionSelect Node="Node" Def="Def" />
    </MudTabPanel>

    <MudTabPanel Text="Signature" Icon="@Icons.Material.Filled.Login">
    <MudText Typo="Typo.caption" Class="mud-text-secondary">
        The declared signature of this workflow. Each row becomes an instance variable, resolved against the
        values the caller passed in — no matter whether a person, a program or a calling workflow started it.
    </MudText>
    <InputBindingTable Bindings="Node.Inputs" Title="Start parameters" AddLabel="Add parameter"
                       NameHeader="Variable" NameLabel="Variable" />

    <ScopeModeSection Mode="Node.ScopeMode" ModeChanged="@(m => Node.ScopeMode = m)"
                      RetainVariables="Node.RetainVariables"
                      SwitchLabel="Strict signature (replace)"
                      HelperText="@("The instance starts with exactly the parameters above plus the variables kept here - anything else the caller passed is dropped.")" />
    </MudTabPanel>

    <MudTabPanel Text="Start form" Icon="@Icons.Material.Filled.DynamicForm">
    <MudText Typo="Typo.caption" Class="mud-text-secondary">
        What a person fills in when starting this workflow by hand (Instances → New instance). The field name
        is the name of the passed variable — the signature is resolved against it. No fields = the
        workflow is started without input.
    </MudText>

    <MudTable Items="@Node.FormFields" Hover="true" Dense="true" Breakpoint="Breakpoint.Sm" Class="mt-2"
              RowsPerPageOptions="@(new[] { 5, 10, 25 })">
        <ToolBarContent>
            <MudButton StartIcon="@Icons.Material.Filled.Add" Size="Size.Small" Variant="Variant.Outlined"
                       Color="Color.Primary" OnClick="AddField">Add field</MudButton>
            <MudSpacer />
        </ToolBarContent>
        <HeaderContent>
            <MudTh>Field name</MudTh>
            <MudTh>Type</MudTh>
            <MudTh>Required</MudTh>
            <MudTh Style="width:1%"></MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="Field name">@context.Name</MudTd>
            <MudTd DataLabel="Type">@context.Kind</MudTd>
            <MudTd DataLabel="Required">
                @if (context.Required)
                {
                    <MudIcon Icon="@Icons.Material.Filled.Check" Size="Size.Small" Color="Color.Primary" />
                }
            </MudTd>
            <MudTd>
                <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small"
                               OnClick="@(() => EditField(context))" />
            </MudTd>
        </RowTemplate>
        <PagerContent>
            <MudTablePager />
        </PagerContent>
    </MudTable>

    @if (Node.FormFields.Count > 0 && Node.Inputs.Count > 0 && Node.ScopeMode == ActivityScopeMode.Replace)
    {
        @* Strikte Signatur + Maske: nur was oben deklariert ist, ueberlebt den Start. Ein Feld, das dort
           fehlt, wird stillschweigend verworfen - das faellt sonst erst zur Laufzeit auf. *@
        <MudAlert Severity="@(UndeclaredFields.Count > 0 ? Severity.Warning : Severity.Info)" Dense="true" Class="mt-2">
            @if (UndeclaredFields.Count > 0)
            {
                <span>
                    The signature is strict, so these fields would be dropped right after the start:
                    <b>@string.Join(", ", UndeclaredFields)</b>. Declare them on the <b>Signature</b> tab
                    (or keep them via the retained variables) if the workflow needs them.
                </span>
            }
            else
            {
                <span>The signature is strict — every form field is declared on the Signature tab and survives the start.</span>
            }
        </MudAlert>
    }

    <MudText Typo="Typo.caption" Class="mt-3">Form description (plain text or culture JSON)</MudText>
    <MudText Typo="Typo.caption" Class="mud-text-secondary">
        Optional guidance shown above the fields — e.g.
        <code>{"de":"Neuen Fall eroeffnen","fr":"Ouvrir un nouveau dossier"}</code>. Same convention as the
        task titles.
    </MudText>
    <CScriptField @ref="descField" Language="json" Height="90" Value="@(Node.FormDescription ?? string.Empty)"
                  ValueChanged="@(v => Node.FormDescription = string.IsNullOrEmpty(v) ? null : v)" />
    </MudTabPanel>

    @* Woraufhin dieser Einstieg von SELBST anlaeuft. Bewusst ein eigener Reiter neben Signatur und
       Maske: die beiden beschreiben, WAS hineingeht - hier steht, WER den Prozess ueberhaupt startet. *@
    <MudTabPanel Text="Triggers" Icon="@Icons.Material.Filled.Bolt">
    <MudText Typo="Typo.caption" Class="mud-text-secondary">
        Without a trigger this workflow only starts when someone (or something) starts it — by hand, from
        code or as a subworkflow. A trigger lets it start <b>by itself</b>, for every tenant that runs it.
    </MudText>
    @if (Def?.IsPublic == true)
    {
        <MudAlert Severity="Severity.Info" Dense="true" Class="mt-2">
            This is a <b>public</b> definition. It does not fire for anybody on its own — a tenant has to
            take it over first. Tick <i>May be taken over by a tenant</i> below to offer it; who is allowed
            to take it is decided by the feature and permission in the definition settings.
        </MudAlert>
    }

    @* --- Nachricht --- *@
    <MudSwitch T="bool" Value="@(Node.MessageStart is not null)" ValueChanged="ToggleMessageStart"
               Color="Color.Primary" Size="Size.Small" Class="mt-3"
               Label="Start when a message arrives" />

    @if (Node.MessageStart is not null)
    {
        <div class="ml-6">
            <MudTextField @bind-Value="Node.MessageStart.SignalName" Label="Message name"
                          Margin="Margin.Dense" />

            <MudSelect T="MessageStartMode" @bind-Value="Node.MessageStart.Mode" Label="When one is already running"
                       Dense="true" Margin="Margin.Dense" Class="mt-2">
                <MudSelectItem T="MessageStartMode" Value="MessageStartMode.AlwaysStart">Always start a new instance</MudSelectItem>
                <MudSelectItem T="MessageStartMode" Value="MessageStartMode.CorrelateOrStart">Continue the waiting one, otherwise start</MudSelectItem>
                <MudSelectItem T="MessageStartMode" Value="MessageStartMode.StartIfNoneRunning">Only start when none is running</MudSelectItem>
            </MudSelect>
            <MudText Typo="Typo.caption" Class="mud-text-secondary">
                @switch (Node.MessageStart.Mode)
                {
                    case MessageStartMode.CorrelateOrStart:
                        <text>
                            If the message reached a waiting instance with the same correlation key, no new one
                            is created. For "continue the case, or open it".
                        </text>
                        break;
                    case MessageStartMode.StartIfNoneRunning:
                        <text>
                            The message is dropped while an instance with the same correlation key is running —
                            the bolt against duplicates (clicked twice, delivered twice).
                        </text>
                        break;
                    default:
                        <text>
                            Every message opens a new case; waiting steps are untouched by it. The predictable
                            default: what happens is in the model, not in the current state of the system.
                        </text>
                        break;
                }
            </MudText>

            <MudSwitch T="bool" @bind-Value="Node.MessageStart.AdoptCorrelationKey" Color="Color.Primary"
                       Size="Size.Small" Class="mt-2"
                       Label="Adopt the correlation key of the message" />
            <MudText Typo="Typo.caption" Class="mud-text-secondary">
                So a later message finds this case again. Turn it off only if the business reference is
                created inside the process.
            </MudText>

            @if (Node.MessageStart.Mode == MessageStartMode.StartIfNoneRunning
                 && !Node.MessageStart.AdoptCorrelationKey)
            {
                @* Dasselbe, was der Validator meldet - nur hier, wo man es gerade verstellt hat. *@
                <MudAlert Severity="Severity.Warning" Dense="true" Class="mt-2">
                    Without adopting the key no instance ever has one — the check can never find a running
                    instance and will never block anything.
                </MudAlert>
            }

            <MudSwitch T="bool" @bind-Value="Node.MessageStart.AllowTenantlessStart" Color="Color.Warning"
                       Size="Size.Small" Class="mt-3"
                       Label="Also start on a message without an origin tenant" />
            <MudText Typo="Typo.caption" Class="mud-text-secondary">
                A message carries the tenant it came from, and only that one starts anything. Without this
                switch a message <b>without</b> an origin (a system message, host code with no context)
                starts nothing at all — deliberately: otherwise one nameless message opens a case in every
                single tenant listening for that name. Turn it on where you mean exactly that
                ("year-end has begun, everywhere"). It has nothing to do with broadcast: a broadcast sent
                from a tenant's instance does carry an origin.
            </MudText>

            @if (Def?.IsPublic == true)
            {
                <MudSwitch T="bool" @bind-Value="Node.MessageStart.AllowLocalActivation" Color="Color.Primary"
                           Size="Size.Small" Class="mt-3"
                           Label="May be taken over by a tenant" />
            }
        </div>
    }

    <MudDivider Class="my-4" />

    @* --- Zeitplan --- *@
    <MudSwitch T="bool" Value="@(Node.ScheduleStart is not null)" ValueChanged="ToggleScheduleStart"
               Color="Color.Primary" Size="Size.Small"
               Label="Start on a schedule" />

    @if (Node.ScheduleStart is not null)
    {
        <div class="ml-6">
            <MudTextField Value="@Node.ScheduleStart.Pattern" ValueChanged="@((string v) => SetPattern(v))"
                          Label="Schedule pattern" Margin="Margin.Dense" Immediate="true"
                          Error="@(PatternError is not null)" ErrorText="@PatternError"
                          Adornment="Adornment.End" AdornmentIcon="@Icons.Material.Filled.EditCalendar"
                          OnAdornmentClick="OpenPatternDesigner"
                          AdornmentAriaLabel="Build the schedule"
                          HelperText="@("e.g. d20200101080001 = daily at 08:00, counted from 2020-01-01. A trailing t means: run once immediately. Use the calendar button to build it.")" />

            @if (PatternPreview.Count > 0)
            {
                @* Die Vorschau ist der eigentliche Grund, warum das Feld benutzbar ist: das Muster ist ein
                   Maschinenformat, und niemand liest daran ab, wann etwas laeuft. *@
                <MudAlert Severity="Severity.Success" Dense="true" Class="mt-2">
                    <MudText Typo="Typo.caption"><b>Next runs (local time):</b></MudText>
                    @foreach (DateTime due in PatternPreview)
                    {
                        <MudText Typo="Typo.caption">@due.ToLocalTime().ToString("g")</MudText>
                    }
                </MudAlert>
            }

            <MudText Typo="Typo.caption" Class="mud-text-secondary mt-2">
                Computed in <b>local time</b> — "daily at 8" means eight o'clock on site, also after the
                switch to summer time. Stored in UTC.
            </MudText>

            <MudSwitch T="bool" @bind-Value="Node.ScheduleStart.SkipWhilePreviousRuns" Color="Color.Primary"
                       Size="Size.Small" Class="mt-3"
                       Label="Skip while the previous run is still going" />
            <MudText Typo="Typo.caption" Class="mud-text-secondary">
                Off by default: the date is the date. Use with care — a process waiting for a user task counts
                as "still going" and stops the whole schedule; skipped dates are written to the log.
            </MudText>

            @if (Def?.IsPublic == true)
            {
                <MudDivider Class="my-3" />
                <MudText Typo="Typo.subtitle2">Taking it over</MudText>

                <MudSwitch T="bool" @bind-Value="Node.ScheduleStart.AllowLocalActivation" Color="Color.Primary"
                           Size="Size.Small" Class="mt-2"
                           Label="May be taken over by a tenant" />
                <MudText Typo="Typo.caption" Class="mud-text-secondary">
                    Offers this schedule under <i>Central workflows</i>, where a tenant ticks it to run it
                    for himself. This answers a different question than the feature and permission in the
                    definition settings: those say <b>who may</b>, this one says whether it is
                    <b>meant to be taken over at all</b>.
                </MudText>

                @if (Node.ScheduleStart.AllowLocalActivation)
                {
                    <div class="ml-6">
                        <MudSwitch T="bool" @bind-Value="Node.ScheduleStart.AllowReschedule" Color="Color.Primary"
                                   Size="Size.Small" Class="mt-2"
                                   Label="Let the tenant set his own pattern" />
                        <MudText Typo="Typo.caption" Class="mud-text-secondary">
                            For "I want it, but on the 25th instead of the last day". Off means the central
                            pattern applies to everybody. Taking the permission back later leaves the
                            tenant's pattern in place but stops honouring it — he goes back to the central
                            one, and that is written to the log.
                        </MudText>

                        <MudSwitch T="bool" @bind-Value="Node.ScheduleStart.AllowOwnVariables" Color="Color.Primary"
                                   Size="Size.Small" Class="mt-2"
                                   Label="Let the tenant set his own start values" />
                        <MudText Typo="Typo.caption" Class="mud-text-secondary">
                            Off means the fixed values above apply to everybody alike.
                        </MudText>
                    </div>
                }
            }

            <MudText Typo="Typo.subtitle2" Class="mt-4">Start values</MudText>
            <MudText Typo="Typo.caption" Class="mud-text-secondary">
                There is nobody to fill in a form — these values take the place of the start mask and are
                resolved against the signature just like passed-in values.
            </MudText>
            <MudTable Items="@ScheduleVariableRows" Hover="true" Dense="true" Elevation="0"
                      Breakpoint="Breakpoint.Sm" Class="mt-1" T="KeyValuePair<string, object>">
                <ToolBarContent>
                    <MudButton StartIcon="@Icons.Material.Filled.Add" Size="Size.Small" Variant="Variant.Outlined"
                               Color="Color.Primary" OnClick="AddScheduleVariable">Add value</MudButton>
                    <MudSpacer />
                </ToolBarContent>
                <HeaderContent>
                    <MudTh>Variable</MudTh>
                    <MudTh>Value</MudTh>
                    <MudTh Style="width:1%"></MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="Variable">@context.Key</MudTd>
                    <MudTd DataLabel="Value">@context.Value</MudTd>
                    <MudTd>
                        <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small"
                                       OnClick="@(() => EditScheduleVariable(context.Key))" />
                    </MudTd>
                </RowTemplate>
            </MudTable>
        </div>
    }
    </MudTabPanel>
  </MudTabs>
}

@code {
    /// <summary>Der zu konfigurierende Start-Knoten.</summary>
    [Parameter] public StartNode? Node { get; set; }

    /// <summary>Die Definition - fuer die Abschnitts-Zuordnung.</summary>
    [Parameter] public WorkflowDefinition? Def { get; set; }

    private CScriptField? descField;

    /// <summary>Die Fehlermeldung zum Zeitplan-Muster, oder null - laufend beim Tippen aktualisiert.</summary>
    private string? PatternError;

    /// <summary>Die naechsten Termine des Musters (UTC) - leer, wenn es keinen hergibt.</summary>
    private List<DateTime> PatternPreview = new();

    /// <summary>Wie viele Termine die Vorschau zeigt - genug, um den Rhythmus zu erkennen.</summary>
    private const int PreviewCount = 3;

    /// <summary>Die festen Startwerte als stabile Liste je Render (MudTable braucht IEnumerable&lt;T&gt;).</summary>
    private List<KeyValuePair<string, object>> ScheduleVariableRows
        => Node?.ScheduleStart?.Variables?.ToList() ?? new List<KeyValuePair<string, object>>();

    protected override void OnParametersSet() => RefreshPattern();

    /// <summary>
    /// Schaltet den Nachrichten-Ausloeser an oder aus. Ausschalten wirft die Einstellungen weg - das ist
    /// gewollt: ein Ausloeser, der "aus" ist, aber noch einen Namen traegt, waere beim naechsten Oeffnen
    /// nicht von einem aktiven zu unterscheiden.
    /// </summary>
    private void ToggleMessageStart(bool on)
    {
        if (Node is null)
        {
            return;
        }

        Node.MessageStart = on ? new MessageStartTrigger() : null;
    }

    /// <summary>Schaltet den Zeitplan an oder aus (siehe <see cref="ToggleMessageStart"/>).</summary>
    private void ToggleScheduleStart(bool on)
    {
        if (Node is null)
        {
            return;
        }

        Node.ScheduleStart = on ? new ScheduleStartTrigger() : null;
        RefreshPattern();
    }

    private void SetPattern(string value)
    {
        if (Node?.ScheduleStart is null)
        {
            return;
        }

        Node.ScheduleStart.Pattern = value;
        RefreshPattern();
    }

    /// <summary>
    /// Oeffnet den Zusammenbau des Musters. Das Textfeld bleibt daneben bestehen: wer das Format kennt,
    /// tippt schneller - und ein aus einer anderen Anlage kopiertes Muster laesst sich einfuegen, ohne es
    /// erst nachzuklicken.
    /// </summary>
    private async Task OpenPatternDesigner()
    {
        if (Node?.ScheduleStart is null)
        {
            return;
        }

        var parameters = new DialogParameters<SchedulePatternDialog>
        {
            { d => d.Pattern, Node.ScheduleStart.Pattern }
        };
        var options = new DialogOptions
        {
            MaxWidth = MaxWidth.Medium, FullWidth = true, CloseOnEscapeKey = true
        };
        IDialogReference dialog = await DialogService.ShowAsync<SchedulePatternDialog>(
            "Build the schedule", parameters, options);
        DialogResult? result = await dialog.Result;
        if (result is { Canceled: false, Data: string built } && !string.IsNullOrWhiteSpace(built))
        {
            SetPattern(built);
        }
    }

    /// <summary>
    /// Prueft das Muster und rechnet die Vorschau - beim Tippen, damit ein Tippfehler auffaellt, solange
    /// man noch davorsitzt.
    /// </summary>
    /// <remarks>
    /// Geprueft wird dasselbe wie im Validator, und zwar aus derselben Quelle: nicht nur, ob das Muster
    /// lesbar ist, sondern ob es ueberhaupt je einen Termin ergibt. Ein Muster wie "31. Februar" ist
    /// formal in Ordnung und schweigt trotzdem fuer immer.
    /// </remarks>
    private void RefreshPattern()
    {
        PatternError = null;
        PatternPreview = new List<DateTime>();

        string? pattern = Node?.ScheduleStart?.Pattern;
        if (string.IsNullOrWhiteSpace(pattern))
        {
            return;
        }

        if (!ScheduleEvaluator.TryValidate(pattern, out string error))
        {
            PatternError = error;
            return;
        }

        PatternPreview = ScheduleEvaluator.Preview(pattern, DateTime.UtcNow, PreviewCount).ToList();
    }

    private async Task AddScheduleVariable()
    {
        if (Node?.ScheduleStart is null)
        {
            return;
        }

        var parameters = new DialogParameters { { nameof(KeyValueEditDialog.IsNew), true } };
        var options = new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true, CloseOnEscapeKey = true };
        IDialogReference dialog = await DialogService.ShowAsync<KeyValueEditDialog>(string.Empty, parameters, options);
        DialogResult? result = await dialog.Result;
        if (result?.Data is KeyValueEditDialog.Result r && !r.Delete && !string.IsNullOrWhiteSpace(r.Key))
        {
            Node.ScheduleStart.Variables[r.Key] = r.Value;
        }
    }

    private async Task EditScheduleVariable(string key)
    {
        if (Node?.ScheduleStart is null
            || !Node.ScheduleStart.Variables.TryGetValue(key, out object? current))
        {
            return;
        }

        var parameters = new DialogParameters
        {
            { nameof(KeyValueEditDialog.Key), key },
            { nameof(KeyValueEditDialog.Value), current?.ToString() ?? string.Empty },
            { nameof(KeyValueEditDialog.IsNew), false }
        };
        var options = new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true, CloseOnEscapeKey = true };
        IDialogReference dialog = await DialogService.ShowAsync<KeyValueEditDialog>(string.Empty, parameters, options);
        DialogResult? result = await dialog.Result;
        if (result?.Data is not KeyValueEditDialog.Result r)
        {
            return;
        }

        if (r.Delete)
        {
            Node.ScheduleStart.Variables.Remove(r.OriginalKey ?? key);
            return;
        }

        // Umbenennung: den alten Eintrag entfernen, bevor der neue gesetzt wird.
        if (!string.IsNullOrEmpty(r.OriginalKey) && !string.Equals(r.OriginalKey, r.Key, StringComparison.Ordinal))
        {
            Node.ScheduleStart.Variables.Remove(r.OriginalKey);
        }

        Node.ScheduleStart.Variables[r.Key] = r.Value;
    }

    /// <summary>
    /// Die Felder der Maske, die in der Signatur NICHT deklariert sind. Nur bei strikter Signatur
    /// interessant - dort verschwinden sie unmittelbar nach dem Start.
    /// </summary>
    private List<string> UndeclaredFields
        => Node is null
            ? new List<string>()
            : Node.FormFields
                .Where(f => f is not null && !string.IsNullOrWhiteSpace(f.Name))
                .Select(f => f.Name)
                .Where(name => !Node.Inputs.Any(i =>
                    string.Equals(i.Parameter, name, StringComparison.OrdinalIgnoreCase))
                    && !Node.RetainVariables.Any(r =>
                        string.Equals(r, name, StringComparison.OrdinalIgnoreCase)))
                .ToList();

    /// <summary>
    /// Holt den Text des Monaco-Feldes (Beschreibung) ins Modell. Monaco meldet seinen Wert erst beim
    /// Verlassen - der Aufrufer (NodePropertiesDialog) ruft dies vor dem Schliessen.
    /// </summary>
    public async Task FlushAsync()
    {
        if (Node is null || descField is null)
        {
            return;
        }

        string v = await descField.GetValueAsync();
        Node.FormDescription = string.IsNullOrEmpty(v) ? null : v;
    }

    private async Task AddField()
    {
        if (Node is null)
        {
            return;
        }

        var fresh = new UserTaskField();
        UserTaskFieldEditDialog.Result? result = await ShowFieldDialog(fresh, isNew: true);
        if (result is { Delete: false } && !string.IsNullOrWhiteSpace(result.Field.Name)
            && !Node.FormFields.Any(f => string.Equals(f.Name, result.Field.Name, StringComparison.OrdinalIgnoreCase)))
        {
            Node.FormFields.Add(result.Field);
        }
    }

    private async Task EditField(UserTaskField field)
    {
        if (Node is null)
        {
            return;
        }

        int idx = Node.FormFields.IndexOf(field);
        if (idx < 0)
        {
            return;
        }

        UserTaskFieldEditDialog.Result? result = await ShowFieldDialog(Clone(field), isNew: false);
        if (result is null)
        {
            return;
        }

        if (result.Delete)
        {
            Node.FormFields.RemoveAt(idx);
        }
        else if (!string.IsNullOrWhiteSpace(result.Field.Name))
        {
            Node.FormFields[idx] = result.Field;
        }
    }

    /// <summary>
    /// Oeffnet den Feld-Dialog OHNE die Payload-Optionen: beim Start gibt es keinen Payload, aus dem
    /// vorbelegt oder angezeigt werden koennte.
    /// </summary>
    private async Task<UserTaskFieldEditDialog.Result?> ShowFieldDialog(UserTaskField field, bool isNew)
    {
        var parameters = new DialogParameters
        {
            { nameof(UserTaskFieldEditDialog.Field), field },
            { nameof(UserTaskFieldEditDialog.IsNew), isNew },
            { nameof(UserTaskFieldEditDialog.ShowPayloadOptions), false }
        };
        var options = new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true, CloseOnEscapeKey = true };
        IDialogReference dialog = await DialogService.ShowAsync<UserTaskFieldEditDialog>(string.Empty, parameters, options);
        DialogResult? result = await dialog.Result;
        return result?.Data as UserTaskFieldEditDialog.Result;
    }

    private static UserTaskField Clone(UserTaskField f) => new()
    {
        Name = f.Name,
        Label = f.Label,
        Kind = f.Kind,
        Required = f.Required,
        HelpText = f.HelpText,
        Choices = f.Choices?.Select(c => new UserTaskChoice { Value = c.Value, Label = c.Label }).ToList()
                  ?? new List<UserTaskChoice>()
    };
}
