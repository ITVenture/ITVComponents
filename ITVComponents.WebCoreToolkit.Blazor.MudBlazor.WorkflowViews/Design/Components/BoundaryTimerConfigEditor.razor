@using ITVComponents.Workflow.Model
@inject IDialogService DialogService

@*
    Konfiguriert einen Fristen-Timer am Schritt. Er haengt an einem Schritt, an dem ein Token PARKT, und
    loest nach Ablauf einen Nebenpfad aus - der Hauptfluss laeuft dabei unveraendert weiter. Das ist der
    Unterschied zum AND-Split: dort muesste jeder Strang wieder gejoint werden, und der Hauptfluss haenge
    bis zum Ablauf der Frist.
*@

@if (Node is not null)
{
    <MudSelect T="string" Value="@Node.AttachedToNodeId" Label="Attached to" Margin="Margin.Dense"
               Dense="true" ValueChanged="@(v => Node.AttachedToNodeId = v)">
        @foreach (WorkflowNode host in Hosts)
        {
            <MudSelectItem T="string" Value="@host.Id">@HostLabel(host)</MudSelectItem>
        }
    </MudSelect>
    <MudText Typo="Typo.caption" Class="mud-text-secondary">
        Only steps where the token actually parks can carry a deadline: user tasks, subworkflow calls and
        activities with an execution target. A plain activity runs straight through — a timer there would
        never fire.
    </MudText>

    @* Die Fristen. Beim unterbrechenden Timer gibt es genau EINE: danach steht das Token woanders, eine
       zweite käme nie dran. Deshalb dort kein Grid, sondern die eine Frist - sonst böte die Oberfläche
       etwas an, das nachweislich wirkungslos bleibt. *@
    <MudText Typo="Typo.subtitle2" Class="mt-4">@(Node.Interrupting ? "Deadline" : "Deadlines")</MudText>
    <MudText Typo="Typo.caption" Class="mud-text-secondary">
        @if (Node.Interrupting)
        {
            <text>When the step is abandoned. An expression returning a TimeSpan, a DateTime or a number of hours.</text>
        }
        else
        {
            <text>
                In order: the first counts from the moment the step parks, each further one from the previous
                trigger. Each is an expression returning a TimeSpan, a DateTime or a number of hours.
            </text>
        }
    </MudText>

    <MudTable Items="@Deadlines" Hover="true" Dense="true" Elevation="0" Class="mt-1"
              Breakpoint="Breakpoint.Sm" T="BoundaryDeadline">
        <ToolBarContent>
            @if (!Node.Interrupting || Deadlines.Count == 0)
            {
                <MudButton StartIcon="@Icons.Material.Filled.Add" Size="Size.Small" Variant="Variant.Outlined"
                           Color="Color.Primary" OnClick="AddDeadline">Add deadline</MudButton>
            }
            <MudSpacer />
        </ToolBarContent>
        <HeaderContent>
            <MudTh Style="width:1%">#</MudTh>
            <MudTh>Expression</MudTh>
            <MudTh Style="width:1%">Mode</MudTh>
            <MudTh Style="width:1%"></MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="#">@(Deadlines.IndexOf(context) + 1)</MudTd>
            <MudTd DataLabel="Expression">
                <span style="font-family:var(--mud-typography-caption-family, monospace)">@Summary(context)</span>
            </MudTd>
            <MudTd DataLabel="Mode">
                <MudChip T="string" Size="Size.Small" Variant="Variant.Text">@context.ExpressionMode</MudChip>
            </MudTd>
            <MudTd>
                @if (!Node.Interrupting)
                {
                    <MudIconButton Icon="@Icons.Material.Filled.ArrowUpward" Size="Size.Small" Title="Move up"
                                   Disabled="@(Deadlines.IndexOf(context) == 0)"
                                   OnClick="@(() => Move(context, -1))" />
                    <MudIconButton Icon="@Icons.Material.Filled.ArrowDownward" Size="Size.Small" Title="Move down"
                                   Disabled="@(Deadlines.IndexOf(context) == Deadlines.Count - 1)"
                                   OnClick="@(() => Move(context, 1))" />
                }
                <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" Title="Edit"
                               OnClick="@(() => EditDeadline(context))" />
            </MudTd>
        </RowTemplate>
    </MudTable>

    @if (Deadlines.Count == 0)
    {
        <MudAlert Severity="Severity.Error" Dense="true" Class="mt-1">
            Without a deadline this timer can never fire.
        </MudAlert>
    }

    @if (!Node.Interrupting)
    {
        <MudSwitch T="bool" Value="@Node.RepeatLast" ValueChanged="@(v => Node.RepeatLast = v)"
                   Color="Color.Primary" Label="Repeat the last deadline forever" Class="mt-2" />
        <MudText Typo="Typo.caption" Class="mud-text-secondary">
            „24" then „2" plus this = after 24h, then every 2 hours until the step moves on. Without it the
            timer goes quiet once the list is used up. The repeated entry must return a <b>duration</b> — an
            absolute time would be in the past from the second round on, and the timer stops.
        </MudText>
    }

    <MudTextField T="string" Value="@Node.CountVariable" ValueChanged="@(v => Node.CountVariable = v)"
                  Label="Count variable (optional)" Margin="Margin.Dense" Class="mt-3"
                  HelperText="Receives the number of this trigger (1 the first time) — lets the escalation word itself differently the third time round." />

    <MudDivider Class="my-3" />
    <MudSwitch T="bool" Value="@Node.Interrupting" ValueChanged="@(v => Node.Interrupting = v)"
               Color="Color.Error" Label="Interrupting (cancels the step)" />
    <MudText Typo="Typo.caption" Class="mud-text-secondary">
        Off (normal): a side path runs and the step keeps waiting — use it to remind someone. On: the
        <b>main</b> token takes this path and the step is cancelled — a waiting task disappears from the
        work list. Interrupting fires once; further intervals have no effect.
        The graph shows the difference: <b>blue and dashed</b> while it only reminds, <b>orange and
        solid</b> once it cancels the step.
    </MudText>

    @if (Node.Interrupting)
    {
        <MudAlert Severity="Severity.Warning" Dense="true" Class="mt-2">
            The step is abandoned when the deadline passes. Make sure the path leads somewhere that closes
            the case — it continues as the main flow, so it may end at the workflow's end node.
        </MudAlert>
    }
    else
    {
        <MudAlert Severity="Severity.Info" Dense="true" Class="mt-2">
            The side path must not reach the end node — close it with a <b>side-path end</b>. Its variables
            are a copy: what the escalation computes does not flow back into the main branch.
        </MudAlert>
    }
}

@code {
    /// <summary>Der zu konfigurierende Fristen-Timer.</summary>
    [Parameter] public BoundaryTimerNode? Node { get; set; }

    /// <summary>Die Definition - fuer die Auswahl des Schritts, an dem der Timer haengt.</summary>
    [Parameter] public WorkflowDefinition Def { get; set; } = default!;

    /// <summary>
    /// Die Schritte, an denen ein Token parken kann. Andere anzubieten hiesse, einen Timer zu erlauben,
    /// der nie feuert - der Validator meldet das ohnehin, aber gar nicht erst anbieten ist besser.
    /// </summary>
    private IEnumerable<WorkflowNode> Hosts
        => (Def?.Nodes ?? new List<WorkflowNode>()).Where(BoundaryTimerNode.CanHost);

    private static string HostLabel(WorkflowNode node)
        => string.IsNullOrWhiteSpace(node.Name) ? $"{node.Kind} ({node.Id})" : $"{node.Name} ({node.Id})";

    /// <summary>Die Fristen des Timers (nie null, damit die Tabelle nicht sonderbehandelt werden muss).</summary>
    private List<BoundaryDeadline> Deadlines
        => Node is null
            ? new List<BoundaryDeadline>()
            : Node.Deadlines ??= new List<BoundaryDeadline>();

    /// <summary>
    /// Holt eine noch als Stunden-Liste gespeicherte Definition einmalig in die neue Form. Beim ÖFFNEN und
    /// nicht beim Laufenlassen: so steht die migrierte Fassung beim nächsten Speichern in der Datenbank,
    /// und der Vortrieb muss die Definition nie umschreiben.
    /// </summary>
    protected override void OnParametersSet()
    {
        Node?.MigrateLegacyDeadlines();
    }

    /// <summary>Die Kurzfassung einer Frist für die Tabelle - einzeilig, gekürzt.</summary>
    private static string Summary(BoundaryDeadline deadline)
    {
        string text = (deadline.Expression ?? string.Empty)
            .Replace("\r", " ").Replace("\n", " ").Trim();
        while (text.Contains("  "))
        {
            text = text.Replace("  ", " ");
        }

        if (text.Length == 0)
        {
            return "(empty)";
        }

        return text.Length <= 70 ? text : text.Substring(0, 68) + "…";
    }

    private async Task AddDeadline()
    {
        var fresh = new BoundaryDeadline();
        BoundaryDeadlineEditDialog.Result? result = await ShowDeadlineDialog(fresh, isNew: true,
            repeatsForever: false);
        if (result is { Delete: false } && !string.IsNullOrWhiteSpace(result.Deadline.Expression))
        {
            Deadlines.Add(result.Deadline);
        }
    }

    private async Task EditDeadline(BoundaryDeadline deadline)
    {
        int index = Deadlines.IndexOf(deadline);
        if (index < 0)
        {
            return;
        }

        bool repeats = Node is { Interrupting: false, RepeatLast: true } && index == Deadlines.Count - 1;
        BoundaryDeadlineEditDialog.Result? result = await ShowDeadlineDialog(Clone(deadline), isNew: false,
            repeatsForever: repeats);
        if (result is null)
        {
            return;
        }

        if (result.Delete)
        {
            Deadlines.RemoveAt(index);
        }
        else
        {
            Deadlines[index] = result.Deadline;
        }
    }

    /// <summary>Verschiebt eine Frist in der Reihenfolge - sie ist die Fachaussage, nicht bloss Sortierung.</summary>
    private void Move(BoundaryDeadline deadline, int delta)
    {
        int index = Deadlines.IndexOf(deadline);
        int target = index + delta;
        if (index < 0 || target < 0 || target >= Deadlines.Count)
        {
            return;
        }

        Deadlines.RemoveAt(index);
        Deadlines.Insert(target, deadline);
    }

    private async Task<BoundaryDeadlineEditDialog.Result?> ShowDeadlineDialog(BoundaryDeadline deadline,
        bool isNew, bool repeatsForever)
    {
        var parameters = new DialogParameters
        {
            { nameof(BoundaryDeadlineEditDialog.Deadline), deadline },
            { nameof(BoundaryDeadlineEditDialog.IsNew), isNew },
            { nameof(BoundaryDeadlineEditDialog.RepeatsForever), repeatsForever }
        };
        var options = new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true, CloseOnEscapeKey = true };
        IDialogReference dialog = await DialogService.ShowAsync<BoundaryDeadlineEditDialog>(string.Empty,
            parameters, options);
        DialogResult? result = await dialog.Result;
        return result?.Data as BoundaryDeadlineEditDialog.Result;
    }

    private static BoundaryDeadline Clone(BoundaryDeadline deadline) => new()
    {
        Expression = deadline.Expression,
        ExpressionMode = deadline.ExpressionMode
    };
}
