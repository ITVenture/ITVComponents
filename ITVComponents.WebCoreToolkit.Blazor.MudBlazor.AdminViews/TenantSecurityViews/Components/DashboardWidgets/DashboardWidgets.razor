@page "/Util/DashboardWidgets"
@rendermode @(RenderMode.InteractiveServer)
@attribute [Microsoft.AspNetCore.Authorization.Authorize]

@using Microsoft.AspNetCore.Components.Authorization

@inject IDashboardWidgetAdminHandler Handler
@inject AuthenticationStateProvider AuthState
@inject IDialogService DialogService
@inject ISnackbar Snackbar

<PageTitle>Dashboard widgets</PageTitle>

<MudText Typo="Typo.h5" GutterBottom="true">Dashboard widgets</MudText>

<SecureView RequiredPermissions="DashboardWidgets.View,DashboardWidgets.Write" RequiredFeatures="ITVAdminViews">
    <Permitted>
@if (currentUser is null)
{
    <MudProgressCircular Indeterminate="true" />
}
else
{
    <MudDataGrid T="DashboardWidgetViewModel"
                 @ref="grid"
                 ServerData="LoadData"
                 SortMode="SortMode.Single"
                 RowsPerPage="25"
                 Hover="true"
                 Dense="true">
        <ToolBarContent>
            <RefreshButton OnClick="ReloadGrid" />
            <MudText Typo="Typo.h6">Dashboard widgets</MudText>
            <MudSpacer />
            <MudTextField @bind-Value="search"
                          Placeholder="Search…"
                          Adornment="Adornment.Start"
                          AdornmentIcon="@Icons.Material.Filled.Search"
                          IconSize="Size.Medium"
                          Class="mt-0"
                          DebounceInterval="300"
                          OnDebounceIntervalElapsed="ReloadGrid" />
            <SecureView RequiredPermissions="DashboardWidgets.Write">
                <Permitted>
                    <MudButton StartIcon="@Icons.Material.Filled.Add" Variant="Variant.Filled" Color="Color.Primary" Class="ml-2" OnClick="OpenCreate">
                        Add widget
                    </MudButton>
                </Permitted>
            </SecureView>
        </ToolBarContent>
        <Columns>
            <HierarchyColumn T="DashboardWidgetViewModel" />
            <PropertyColumn Property="x => x.SystemName" Title="System name" />
            <PropertyColumn Property="x => x.DisplayName" Title="Display name" />
            <PropertyColumn Property="x => x.Area" Title="Area" />
            <TemplateColumn T="DashboardWidgetViewModel" Title="" Sortable="false">
                <CellTemplate>
                    <SecureView RequiredPermissions="DashboardWidgets.Write">
                        <Permitted>
                        <MudStack Row="true" Spacing="1">
                            <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" OnClick="@(() => OpenEdit(context.Item))" />
                            <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error" OnClick="@(() => Delete(context.Item))" />
                        </MudStack>
                        </Permitted>
                    </SecureView>
                </CellTemplate>
            </TemplateColumn>
        </Columns>
        <ChildRowContent>
            <MudPaper Elevation="0" Class="pa-2">
                <MudTabs Elevation="0" Rounded="true">
                    <MudTabPanel Text="Parameters">
                        <DashboardParamsGrid DashboardWidgetId="@context.Item.DashboardWidgetId" CanWrite="@hasWrite" />
                    </MudTabPanel>
                    <MudTabPanel Text="Localizations">
                        <WidgetLocalizationsGrid DashboardWidgetId="@context.Item.DashboardWidgetId" CanWrite="@hasWrite" />
                    </MudTabPanel>
                </MudTabs>
            </MudPaper>
        </ChildRowContent>
        <PagerContent>
            <MudDataGridPager T="DashboardWidgetViewModel" />
        </PagerContent>
    </MudDataGrid>
}
    </Permitted>
    <NotPermitted>
        <MudAlert Severity="Severity.Warning">No permission to view dashboard widgets.</MudAlert>
    </NotPermitted>
</SecureView>

@code {
    private MudDataGrid<DashboardWidgetViewModel>? grid;
    private System.Security.Claims.ClaimsPrincipal? currentUser;
    private bool hasView;
    private bool hasWrite;
    private string? search;

    protected override async Task OnInitializedAsync()
    {
        var auth = await AuthState.GetAuthenticationStateAsync();
        currentUser = auth.User;
        hasView = Handler.HasPermission(currentUser, "DashboardWidgets.View", "DashboardWidgets.Write");
        hasWrite = Handler.HasPermission(currentUser, "DashboardWidgets.Write");
    }

    private async Task<GridData<DashboardWidgetViewModel>> LoadData(GridState<DashboardWidgetViewModel> state, CancellationToken ct)
    {
        if (currentUser is null) return new GridData<DashboardWidgetViewModel> { Items = Array.Empty<DashboardWidgetViewModel>(), TotalItems = 0 };
        var sort = state.SortDefinitions.FirstOrDefault();
        var query = new ListQuery
        {
            Page = state.Page,
            PageSize = state.PageSize,
            SortColumn = sort?.SortBy,
            SortDescending = sort?.Descending ?? false,
            Search = search
        };
        var result = await Handler.ListAsync(currentUser, query);
        return new GridData<DashboardWidgetViewModel> { Items = result.Items, TotalItems = result.TotalCount };
    }

    private async Task ReloadGrid()
    {
        if (grid is not null) await grid.ReloadServerData();
    }

    private async Task OpenCreate()
    {
        var parameters = new DialogParameters<DashboardWidgetDialog> { { d => d.Model, new DashboardWidgetViewModel() }, { d => d.IsCreate, true } };
        var dlg = await DialogService.ShowAsync<DashboardWidgetDialog>("Create widget", parameters, EditDialogDefaults.Edit);
        var result = await dlg.Result;
        if (result is { Canceled: false, Data: DashboardWidgetViewModel input })
        {
            var created = await Handler.CreateAsync(currentUser!, input);
            if (created != null) { Snackbar.Add("Widget created", Severity.Success); await ReloadGrid(); }
            else Snackbar.Add("Failed to create", Severity.Error);
        }
    }

    private async Task OpenEdit(DashboardWidgetViewModel item)
    {
        var copy = new DashboardWidgetViewModel
        {
            DashboardWidgetId = item.DashboardWidgetId,
            DisplayName = item.DisplayName,
            TitleTemplate = item.TitleTemplate,
            SystemName = item.SystemName,
            DiagnosticsQueryId = item.DiagnosticsQueryId,
            Area = item.Area,
            CustomQueryString = item.CustomQueryString,
            Template = item.Template
        };
        var parameters = new DialogParameters<DashboardWidgetDialog> { { d => d.Model, copy }, { d => d.IsCreate, false } };
        var dlg = await DialogService.ShowAsync<DashboardWidgetDialog>("Edit widget", parameters, EditDialogDefaults.Edit);
        var result = await dlg.Result;
        if (result is { Canceled: false, Data: DashboardWidgetViewModel input })
        {
            var updated = await Handler.UpdateAsync(currentUser!, input);
            if (updated != null) { Snackbar.Add("Widget updated", Severity.Success); await ReloadGrid(); }
            else Snackbar.Add("Failed to update", Severity.Error);
        }
    }

    private async Task Delete(DashboardWidgetViewModel item)
    {
        var ok = await DialogService.ShowMessageBoxAsync("Delete widget", $"Really delete '{item.SystemName}'?", yesText: "Delete", cancelText: "Cancel");
        if (ok != true) return;
        var success = await Handler.DeleteAsync(currentUser!, item.DashboardWidgetId);
        if (success) { Snackbar.Add("Widget deleted", Severity.Success); await ReloadGrid(); }
        else Snackbar.Add("Failed to delete", Severity.Error);
    }
}
