@page "/Connectivity/ClientApps"
@rendermode @(RenderMode.InteractiveServer)
@attribute [Microsoft.AspNetCore.Authorization.Authorize]

@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.Extensions.Localization
@using ITVComponents.WebCoreToolkit.Blazor.MudBlazor.AdminViews.TenantSecurityViews.Components.CrossGrids
@using ITVComponents.WebCoreToolkit.Blazor.MudBlazor.AdminViews.TenantSecurityViews.ViewModels
@using ITVComponents.WebCoreToolkit.Blazor.MudBlazor.AdminViews.TenantSecurityViews.Handlers

@inject IClientAppAdminHandler Handler
@inject IStringLocalizer<ClientAppMessages> L
@inject AuthenticationStateProvider AuthState
@inject IDialogService DialogService
@inject ISnackbar Snackbar

<PageTitle>@L["App_Title"]</PageTitle>

<MudText Typo="Typo.h5" GutterBottom="true">@L["App_Title"]</MudText>

@* ITVCustomerViews, nicht ITVAdminViews: diese Maske bedient der KUNDE - er verwaltet die Anwendungen
   seines eigenen Mandanten. ITVAdminViews ist den System-Administratoren vorbehalten und steht hier nur
   mit, damit beim Upgrade niemand die Maske verliert. *@
<SecureView RequiredPermissions="Apps.View,Apps.Write" RequiredFeatures="ITVCustomerViews,ITVAdminViews">
    <Permitted>
        @if (currentUser is null)
        {
            <MudProgressCircular Indeterminate="true" />
        }
        else
        {
            <MudDataGrid T="ClientAppViewModel"
                         @ref="grid"
                         ServerData="LoadData"
                         SortMode="SortMode.Single"
                         RowsPerPage="25"
                         Hover="true"
                         Dense="true">
                <ToolBarContent>
                    <CrudGridToolbar OnRefresh="ReloadGrid" @bind-Search="search" OnSearch="ReloadGrid">
                        <TitleContent>@L["App_Title"]</TitleContent>
                        <ChildContent>
                            <SecureView RequiredPermissions="Apps.Write">
                                <Permitted>
                                    <MudButton StartIcon="@Icons.Material.Filled.Add" Variant="Variant.Filled"
                                               Color="Color.Primary" Class="ml-2" OnClick="OpenCreate">
                                        @L["App_Add"]
                                    </MudButton>
                                </Permitted>
                            </SecureView>
                        </ChildContent>
                    </CrudGridToolbar>
                </ToolBarContent>
                <Columns>
                    <HierarchyColumn T="ClientAppViewModel" />
                    <PropertyColumn Property="x => x.ClientName" Title="@L["App_Col_Name"]" />
                    <PropertyColumn Property="x => x.TemplateName" Title="@L["App_Col_Template"]" />
                    <TemplateColumn T="ClientAppViewModel" Title="@L["App_Col_State"]" Sortable="false">
                        <CellTemplate>
                            @if (!context.Item.Enabled)
                            {
                                <MudChip T="string" Color="Color.Error" Size="Size.Small">@L["App_State_Off"]</MudChip>
                            }
                            else
                            {
                                <MudChip T="string" Color="Color.Success" Size="Size.Small">@L["App_State_On"]</MudChip>
                            }
                        </CellTemplate>
                    </TemplateColumn>
                    <PropertyColumn Property="x => x.ActiveAccessCount" Title="@L["App_Col_Devices"]" />
                    <TemplateColumn T="ClientAppViewModel" Title="" Sortable="false">
                        <CellTemplate>
                            <SecureView RequiredPermissions="Apps.Write">
                                <Permitted>
                                    <MudStack Row="true" Spacing="1">
                                        <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small"
                                                       OnClick="@(() => OpenEdit(context.Item))" />
                                        <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small"
                                                       Color="Color.Error" OnClick="@(() => Delete(context.Item))" />
                                    </MudStack>
                                </Permitted>
                            </SecureView>
                        </CellTemplate>
                    </TemplateColumn>
                </Columns>
                <ChildRowContent>
                    <MudPaper Elevation="0" Class="pa-2">
                        <MudTabs Elevation="0" Rounded="true">
                            <MudTabPanel Text="@L["App_Tab_Sets"]">
                                <PermissionSetsForAppGrid ClientAppId="@context.Item.ClientAppId" />
                            </MudTabPanel>
                            <MudTabPanel Text="@L["App_Tab_Devices"]">
                                <ClientAppAccessesGrid ClientAppId="@context.Item.ClientAppId" />
                            </MudTabPanel>
                        </MudTabs>
                    </MudPaper>
                </ChildRowContent>
                <PagerContent>
                    <MudDataGridPager T="ClientAppViewModel" />
                </PagerContent>
            </MudDataGrid>
        }
    </Permitted>
    <NotPermitted>
        <MudAlert Severity="Severity.Warning">@L["App_NoPermission"]</MudAlert>
    </NotPermitted>
</SecureView>

@code {
    private MudDataGrid<ClientAppViewModel>? grid;
    private System.Security.Claims.ClaimsPrincipal? currentUser;
    private string? search;
    private IReadOnlyList<ClientAppTemplateViewModel> templates = Array.Empty<ClientAppTemplateViewModel>();

    protected override async Task OnInitializedAsync()
    {
        var auth = await AuthState.GetAuthenticationStateAsync();
        currentUser = auth.User;
        templates = await Handler.ListTemplatesAsync(currentUser);
    }

    private async Task<GridData<ClientAppViewModel>> LoadData(GridState<ClientAppViewModel> state, CancellationToken ct)
    {
        if (currentUser is null)
        {
            return new GridData<ClientAppViewModel> { Items = Array.Empty<ClientAppViewModel>(), TotalItems = 0 };
        }

        var query = state.ToListQuery(search);
        var result = await Handler.ListAsync(currentUser, query);
        return new GridData<ClientAppViewModel> { Items = result.Items, TotalItems = result.TotalCount };
    }

    private async Task ReloadGrid()
    {
        if (grid is not null) await grid.ReloadServerData();
    }

    private async Task OpenCreate()
    {
        if (templates.Count == 0)
        {
            // Ohne Template gibt es nichts anzulegen - und ohne diesen Hinweis sucht jemand den Fehler
            // in der Maske statt in der fehlenden Vorlage.
            Snackbar.Add(L["App_NoTemplate"], Severity.Warning);
            return;
        }

        var parameters = new DialogParameters<ClientAppDialog>
        {
            { d => d.Model, new ClientAppViewModel() },
            { d => d.IsCreate, true },
            { d => d.Templates, templates }
        };
        var dlg = await DialogService.ShowAsync<ClientAppDialog>(L["App_Create_Title"], parameters, EditDialogDefaults.Edit);
        var result = await dlg.Result;
        if (result is { Canceled: false, Data: ClientAppViewModel input })
        {
            var created = await Handler.CreateAsync(currentUser!, input);
            if (created != null)
            {
                Snackbar.Add(L["App_Created"], Severity.Success);
                await ReloadGrid();
            }
            else
            {
                Snackbar.Add(L["App_CreateFailed"], Severity.Error);
            }
        }
    }

    private async Task OpenEdit(ClientAppViewModel item)
    {
        var copy = new ClientAppViewModel
        {
            ClientAppId = item.ClientAppId,
            ClientName = item.ClientName,
            ClientAppTemplateId = item.ClientAppTemplateId,
            TemplateName = item.TemplateName,
            ClientKey = item.ClientKey,
            Enabled = item.Enabled
        };
        var parameters = new DialogParameters<ClientAppDialog>
        {
            { d => d.Model, copy },
            { d => d.IsCreate, false },
            { d => d.Templates, templates }
        };
        var dlg = await DialogService.ShowAsync<ClientAppDialog>(L["App_Edit_Title"], parameters, EditDialogDefaults.Edit);
        var result = await dlg.Result;
        if (result is { Canceled: false, Data: ClientAppViewModel input })
        {
            var updated = await Handler.UpdateAsync(currentUser!, input);
            if (updated != null)
            {
                Snackbar.Add(L["App_Updated"], Severity.Success);
                await ReloadGrid();
            }
            else
            {
                Snackbar.Add(L["App_UpdateFailed"], Severity.Error);
            }
        }
    }

    private async Task Delete(ClientAppViewModel item)
    {
        var ok = await DialogService.ShowMessageBoxAsync(L["App_Delete_Title"],
            L["App_Delete_Question", item.ClientName], yesText: L["App_Delete_Yes"], cancelText: L["App_Cancel"]);
        if (ok != true) return;

        if (await Handler.DeleteAsync(currentUser!, item.ClientAppId))
        {
            Snackbar.Add(L["App_Deleted"], Severity.Success);
        }
        else
        {
            // Der haeufigste Grund: es haengen noch nicht widerrufene Zugaenge daran.
            Snackbar.Add(L["App_DeleteFailed"], Severity.Error);
        }

        await ReloadGrid();
    }
}
