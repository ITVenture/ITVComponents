@using ITVComponents.WebCoreToolkit.Net.Extensions
@using ITVComponents.WebCoreToolkit.Extensions
@using ITVComponents.WebCoreToolkit.Net.TelerikUi.AdminViews.Extensions
@using ITVComponents.WebCoreToolkit.Net.TelerikUi.AdminViews.TenantSecurityViews.ViewModel
@using Kendo.Mvc.UI
@using TextsAndMessagesHelper = ITVComponents.WebCoreToolkit.Net.TelerikUi.AdminViews.TenantSecurityViews.Resources.TextsAndMessagesHelper
@*
    Die Rechtebuendel EINES Templates.

    Diese Datei war bis PRE241 eine wortgleiche Kopie der Buendel-Maske: sie zeigte ein
    Berechtigungs-Raster (PermissionViewModel) und las es vom PermissionSet-Controller mit einem
    parentId, das hier niemand setzt. Aufgeklappt sah man also die falsche Tabelle, leer - und
    AppTemplateController.ReadPermissions, das genau fuer diese Stelle geschrieben ist, rief niemand auf.

    Angelegt wird hier und nicht in der Buendel-Maske: das Template steht fest, es gibt nichts zu
    waehlen und nichts falsch zu waehlen. Das Template reist als Routenwert mit - es steht in der
    Adresse, die der Server gerendert hat, und nicht in der geposteten Zeile.
*@
@{
    var templateId = ViewData["clientAppTemplateId"];
    // Je Vorlage eigen: dieses Teilstueck wird pro aufgeklappter Vorlage EINMAL in die Seite geladen -
    // eine feste Kennung gaebe doppelte script-Ids, sobald zwei Vorlagen offen sind.
    var detailScriptId = $"PermsOfSetIn{templateId}";
    var mayWrite = Context.RequestServices.VerifyUserPermissions(new[] { "Apps.PermissionSets.Write" });
    var tmp = Html.Kendo().Grid<AppPermissionViewModel>().Name($"PermissionSetsFor{templateId}")
        .Columns(columns =>
        {
            columns.Bound(c => c.PermissionSetName).Filterable(true).Title(TextsAndMessagesHelper.IWCN_General_Name);
            if (mayWrite)
            {
                columns.Command(ga =>
                {
                    ga.Edit();
                    ga.PopupConfirmDelete();
                }).Width(180);
            }
        })
        .ToolBar(toolbar =>
        {
            toolbar.RefreshTable();
            if (mayWrite)
            {
                toolbar.Create();
            }
        })
        .Editable(e => e.Mode(GridEditMode.InLine))
        .DataSource(dataSource =>
        {
            var src = dataSource
                .Ajax()
                .Read(read => read.Action("ReadPermissions", "AppTemplate", new { parentId = templateId }));
            if (mayWrite)
            {
                src.Create(create => create.Action("CreatePermission", "AppTemplate", new { parentId = templateId }))
                    .Update(update => update.Action("UpdatePermission", "AppTemplate", new { parentId = templateId }))
                    .Destroy(destroy => destroy.Action("DestroyPermission", "AppTemplate", new { parentId = templateId }));
            }

            src.Model(m =>
                {
                    m.Id(t => t.AppPermissionSetId);
                    m.Field(t => t.PermissionSetName).Editable(true);
                })
                .Sort(n => n.Add(m => m.PermissionSetName));
        })
        .Pageable(p => p.Input(false).Numeric(true).Info(true).PreviousNext(true).PageSizes(true))
        .Sortable(c => c.Enabled(true))
        .Filterable(f => f.Enabled(true))
        .Resizable(c => c.Columns(true))
        // Ohne das Aufklappen waere ein neu angelegtes Buendel eine leere Huelle: die Rechte darin
        // liessen sich nur auf der Buendel-Maske setzen, also genau dort nicht, wo man es anlegt.
        .ClientDetailTemplateId(detailScriptId);
}
@tmp
@Html.DetailViewScript(detailScriptId, "PermsOfSet#=AppPermissionSetId#", "~/Connectivity/PermissionSet/PermissionTable?parentId=#=AppPermissionSetId#")
