@page "/Account/Manage/SetPassword"
@rendermode @(RenderMode.InteractiveServer)

@layout ManageLayout
@attribute [Microsoft.AspNetCore.Authorization.Authorize]

@using System.ComponentModel.DataAnnotations
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.Extensions.Localization
@using ITVComponents.WebCoreToolkit.Blazor.MudBlazor.IdentityPages.Components.Account.Shared
@using ITVComponents.WebCoreToolkit.IdentityShared.Areas.Identity
@using ITVComponents.WebCoreToolkit.IdentityShared.Areas.Identity.Pages.Account.Manage
@using ITVComponents.WebCoreToolkit.IdentityShared.PageHandlers.Identity.Account.Manage

@inject IPageHandlerProvider<SetPasswordModel, ISetPasswordHandler> HandlerProvider
@inject AuthenticationStateProvider AuthState
@inject IStringLocalizer<IdentityMessages> L
@inject NavigationManager Nav

<PageTitle>@L["Set password"]</PageTitle>

<MudText Typo="Typo.h5" GutterBottom="true">@L["Set your password"]</MudText>

@if (loading)
{
    <MudProgressCircular Indeterminate="true" />
}
else if (!usePage)
{
    <MudAlert Severity="Severity.Info">@L["This page is not available."]</MudAlert>
}
else if (notFound)
{
    <MudAlert Severity="Severity.Error">@notFoundMessage</MudAlert>
}
else
{
    @if (!string.IsNullOrEmpty(StatusMessage))
    {
        <MudAlert Severity="Severity.Success" Class="mb-3">@StatusMessage</MudAlert>
    }

    <MudAlert Severity="Severity.Info" Class="mb-3">
        @L["You do not have a local username/password for this site. Add a local account so you can log in without an external login."]
    </MudAlert>

    <EditForm Model="Input" OnValidSubmit="OnSubmit">
        <ToolkitDataAnnotationsValidator />

        @if (errors.Count > 0)
        {
            <MudAlert Severity="Severity.Error" Class="mb-3">
                @foreach (var err in errors) { <div>@err</div> }
            </MudAlert>
        }

        <MudTextField @bind-Value="Input.NewPassword" Label="@L["New password"]" For="@(() => Input.NewPassword)"
                      InputType="InputType.Password" autocomplete="new-password" Class="mb-3" />

        <MudTextField @bind-Value="Input.ConfirmPassword" Label="@L["Confirm new password"]" For="@(() => Input.ConfirmPassword)"
                      InputType="InputType.Password" autocomplete="new-password" Class="mb-3" />

        <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary" Disabled="@busy">
            @L["Set password"]
        </MudButton>
    </EditForm>
}

@code {
    private bool loading = true;
    private bool usePage;
    private bool notFound;
    private string? notFoundMessage;
    private bool busy;
    private List<string> errors = new();

    private InputModel Input { get; set; } = new();

    [SupplyParameterFromQuery(Name = "status")]
    private string? StatusMessage { get; set; }

    protected override async Task OnInitializedAsync()
    {
        await using var op = HandlerProvider.BeginOperation();
        usePage = op.Handler.UsePage;
        if (!usePage)
        {
            loading = false;
            return;
        }

        var principal = (await AuthState.GetAuthenticationStateAsync()).User;
        var user = await op.Handler.FetchUser(principal);
        try
        {
            if (!user.UserExists)
            {
                notFound = true;
                notFoundMessage = L["Unable to load user with ID '{0}'.", op.Handler.GetUserId(principal)];
                return;
            }

            if (user.HasPassword)
            {
                Nav.NavigateTo("Account/Manage/ChangePassword");
            }
        }
        finally
        {
            op.Handler.ReleaseUser(user);
            loading = false;
        }
    }

    private async Task OnSubmit()
    {
        await using var op = HandlerProvider.BeginOperation();
        busy = true;
        errors.Clear();
        var principal = (await AuthState.GetAuthenticationStateAsync()).User;
        var user = await op.Handler.FetchUser(principal);
        try
        {
            if (!user.UserExists)
            {
                notFound = true;
                notFoundMessage = L["Unable to load user with ID '{0}'.", op.Handler.GetUserId(principal)];
                return;
            }

            var result = await op.Handler.AddPassword(user, Input.NewPassword);
            if (!result.Succeeded)
            {
                errors = result.Errors.Select(e => e.Description).ToList();
                return;
            }

            // Ein neu gesetztes Passwort aendert den Security-Stamp â€” Cookie ueber den Endpunkt neu ausstellen.
            ManageRedirects.RefreshSignIn(Nav, "Account/Manage/SetPassword", L["Your password has been set."].Value);
        }
        finally
        {
            op.Handler.ReleaseUser(user);
            busy = false;
        }
    }

    public sealed class InputModel
    {
        [Required]
        [StringLength(100, MinimumLength = 6)]
        [DataType(DataType.Password)]
        public string NewPassword { get; set; } = "";

        [DataType(DataType.Password)]
        [Compare("NewPassword")]
        public string ConfirmPassword { get; set; } = "";
    }
}
