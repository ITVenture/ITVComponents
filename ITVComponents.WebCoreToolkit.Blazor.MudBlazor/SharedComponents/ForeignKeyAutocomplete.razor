@namespace ITVComponents.WebCoreToolkit.Blazor.SharedComponents
@typeparam T
@implements IDisposable

@using ITVComponents.EFRepo.Expressions.Models
@using ITVComponents.EFRepo.Helpers
@using ITVComponents.WebCoreToolkit.EntityFramework.Extensions
@using ITVComponents.WebCoreToolkit.EntityFramework.Models
@using Microsoft.Extensions.Logging
@using SortDirection = ITVComponents.EFRepo.Expressions.Models.SortDirection

@inject IServiceProvider Services
@inject ILogger<ForeignKeyAutocomplete<T>> Logger

@* Mud autocomplete (typeahead) over FK options resolved via Toolkit's ContextForFkQuery.
   - ServerFilter=false (default): loads the full list once, filters client-side on Label.
     When the EntityWriteTracker is active, the cached list reloads as soon as the backing
     table is written (e.g. a new entry added in another window).
   - ServerFilter=true: queries IWrappedFkSource.ReadForeignKey(table, postedFilter: ...) per
     keystroke with a Contains-on-Label filter from EFRepo.Expressions.Models — already live.  *@

<MudAutocomplete T="T"
                 Value="Value"
                 ValueChanged="ValueChanged"
                 SearchFunc="DoSearch"
                 ToStringFunc="@CaptionFor"
                 Label="@Label"
                 Required="@Required"
                 Clearable="@Clearable"
                 Disabled="@(Disabled || _loading)"
                 HelperText="@StateHelperText"
                 ResetValueOnEmptyText="false"
                 CoerceText="false"
                 DebounceInterval="@DebounceMilliseconds" />
@if (_loading)
{
    @* Waehrend die Liste laedt gibt es sonst kein Signal: das Feld waere einfach leer und der Benutzer
       koennte nicht unterscheiden, ob geladen wird oder ob es nichts zu waehlen gibt. *@
    <MudProgressLinear Indeterminate="true" Size="Size.Small" Color="Color.Primary" />
}

@code {
    [Parameter] public T Value { get; set; } = default!;
    [Parameter] public EventCallback<T> ValueChanged { get; set; }
    [Parameter] public string Label { get; set; } = string.Empty;
    [Parameter] public string Connection { get; set; } = "sys";
    [Parameter, EditorRequired] public string Table { get; set; } = string.Empty;
    [Parameter] public bool Required { get; set; }
    [Parameter] public bool Clearable { get; set; } = true;
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public int DebounceMilliseconds { get; set; } = 300;

    /// <summary>
    /// Hint shown below the field. It is replaced by the loading / no-entries message while either
    /// applies — those states say more about the field than a static hint does.
    /// </summary>
    [Parameter] public string? HelperText { get; set; }

    /// <summary>
    /// Shown while the option-list is being fetched. This package deliberately ships no language files
    /// (see <c>DeclaredFieldsForm</c>) — a consumer that wants it translated passes its own text.
    /// </summary>
    [Parameter] public string LoadingText { get; set; } = "Loading entries…";

    /// <summary>
    /// Shown once the option-list is loaded and turns out to be empty — so an empty field is
    /// distinguishable from one that is still filling.
    /// </summary>
    [Parameter] public string NoDataText { get; set; } = "No entries available";

    /// <summary>
    /// false (default): full list fetched once, filtered client-side on Label substring.
    /// true: SearchFunc queries the FK source per keystroke with a Contains-on-Label filter.
    /// </summary>
    [Parameter] public bool ServerFilter { get; set; }

    private record Item(T Key, string Label);
    private readonly List<Item> _all = new();
    private readonly Dictionary<object, string> _captions = new();
    private IEntityWriteTracker? _tracker;
    private bool _loading;
    private bool _loaded;

    /// <summary>
    /// The state of the option-list wins over <see cref="HelperText"/>: while it loads, and when it
    /// turned out to be empty, that is what the user needs to know.
    /// </summary>
    private string? StateHelperText
        => _loading ? LoadingText
            : !ServerFilter && _loaded && _all.Count == 0 ? NoDataText
            : HelperText;

    protected override async Task OnInitializedAsync()
    {
        // Ohne das Flag VOR dem Yield waere der erste Frame ein Feld ohne jeden Hinweis - genau die
        // Luecke, in der es aussah, als gaebe es nichts zu waehlen.
        _loading = !ServerFilter;
        await Task.Yield();
        try
        {
            if (!ServerFilter)
            {
                await LoadAllAsync();

                // Optional active refresh for the cached full list (only present with UseEntityTracker on).
                _tracker = Services.TrackerForContext(Connection, null);
                if (_tracker != null)
                {
                    _tracker.TablesWritten += OnTablesWritten;
                }
            }
            else if (Value is not null)
            {
                // Resolve the label for the current bound value so the input does not display
                // the raw key while the user has not searched yet.
                var src = Services.ContextForFkQuery(Connection, null);
                var one = src?.ReadForeignKey<T>(Table, id: Value.ToString())
                    .FirstOrDefault();
                if (one is { Key: not null })
                {
                    _captions[one.Key] = one.Label;
                }
            }
        }
        catch(Exception ex)
        {
            Logger.LogError(ex, "Error occurred while initializing ForeignKeyAutocomplete.");
        }
        finally
        {
            // Auch im Fehlerfall: der Ladezustand ist beendet. Bliebe er stehen, waere das Feld
            // dauerhaft gesperrt und der Hinweis eine Luege.
            _loading = false;
            _loaded = true;
        }
    }

    private Task LoadAllAsync()
    {
        _all.Clear();
        var src = Services.ContextForFkQuery(Connection, null);
        if (src is null) return Task.CompletedTask;
        var raw = src.ReadForeignKey<T>(Table);
        foreach (var obj in raw)
        {
            if (obj.Key is null) continue;
            _all.Add(new Item(obj.Key, obj.Label));
            _captions[obj.Key] = obj.Label;
        }

        return Task.CompletedTask;
    }

    private Task<IEnumerable<T>> DoSearch(string text, CancellationToken ct)
    {
        text ??= string.Empty;

        if (!ServerFilter)
        {
            return Task.FromResult<IEnumerable<T>>(
                _all.Where(i => string.IsNullOrEmpty(text)
                                || i.Label.Contains(text, StringComparison.OrdinalIgnoreCase))
                    .Select(i => i.Key));
        }

        try
        {
            var src = Services.ContextForFkQuery(Connection, null);
            if (src is null) return Task.FromResult<IEnumerable<T>>(Array.Empty<T>());
            var filter = new Dictionary<string, object>
            {
                {
                    "parsedfilter", new CompareFilter{Value = text, Operator = CompareOperator.Contains, PropertyName = "Label"}
                },
                {
                    "parsedsort", new[]{new Sort{Direction = SortDirection.Ascending, MemberName = "Label"} }
                },
                {
                    "Filter", text
                }
            };
            var raw = src.ReadForeignKey<T>(Table, postedFilter: filter);
            var result = new List<T>();
            foreach (var obj in raw)
            {
                if (obj.Key is null) continue;
                _captions[obj.Key] = obj.Label;
                result.Add(obj.Key);
            }
            return Task.FromResult<IEnumerable<T>>(result);
        }
        catch (Exception ex)
        {
            // Die Suche soll die Maske nicht abschiessen - aber ohne Log waere eine gescheiterte
            // Server-Suche von "es gibt keine Treffer" nicht zu unterscheiden.
            Logger.LogError(ex, "Server-side search for foreign key options in table {Table} failed (filter: {Filter}).", Table, text);
            return Task.FromResult<IEnumerable<T>>(Array.Empty<T>());
        }
    }

    private void OnTablesWritten(string[] tables)
    {
        if (tables.All(table => !string.Equals(table, Table, StringComparison.OrdinalIgnoreCase)))
        {
            return;
        }

        // The tracker raises on the writer's thread (possibly another circuit) → marshal to ours.
        _ = InvokeAsync(async () =>
        {
            _loading = true;
            StateHasChanged();
            try
            {
                await LoadAllAsync();
            }
            catch (Exception ex)
            {
                Logger.LogError(ex, "Error reloading ForeignKeyAutocomplete options for table {Table}", Table);
            }
            finally
            {
                _loading = false;
            }

            StateHasChanged();
        });
    }

    /// <summary>
    /// Turns a key into what the user reads. Falling back to the raw key was the reason an unset
    /// int-FK showed up as "0": <c>default(T)</c> is a perfectly ordinary zero, it just never has a
    /// caption. An unset key is nothing — and nothing is what it should look like.
    /// </summary>
    private string CaptionFor(T v)
    {
        if (v is null) return string.Empty;
        if (_captions.TryGetValue(v, out var lbl)) return lbl;

        // Kein Schluessel gesetzt: bei T=int ist das die 0, bei anderen Werttypen ihr Nullwert.
        if (EqualityComparer<T>.Default.Equals(v, default!)) return string.Empty;

        // Ein gesetzter Schluessel ohne Beschriftung: solange geladen wird, ist sie nur noch nicht da -
        // die rohe Zahl zu zeigen behauptete einen Namen, wo keiner steht. Danach ist der Schluessel die
        // ehrlichere Auskunft: er verweist auf einen Eintrag, den es nicht (mehr) gibt.
        return _loading ? string.Empty : v.ToString() ?? string.Empty;
    }

    public void Dispose()
    {
        if (_tracker != null)
        {
            _tracker.TablesWritten -= OnTablesWritten;
        }
    }
}
