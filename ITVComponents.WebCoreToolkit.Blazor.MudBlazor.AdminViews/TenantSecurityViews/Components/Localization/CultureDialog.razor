<EditDialogShell Model="Model" IsCreate="IsCreate" SaveVariant="Variant.Filled" InvalidMessage="Please correct invalid fields">
    <MudTextField @bind-Value="Model.Name" Label="Name (e.g. de-CH)" Required="true" MaxLength="128" />
</EditDialogShell>

@code {
    [Parameter, EditorRequired] public CultureViewModel Model { get; set; } = default!;
    [Parameter] public bool IsCreate { get; set; }
}
