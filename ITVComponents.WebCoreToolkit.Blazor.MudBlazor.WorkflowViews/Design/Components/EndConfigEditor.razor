@using ITVComponents.Workflow.Model

@*
    Konfiguriert das ERGEBNIS eines Abschluss-Knotens. Ist etwas deklariert, besteht der Variablen-Stack
    beim Abschluss genau daraus - und damit sieht ein Aufrufer (CallWorkflow) genau dieses Ergebnis.
    Leer = wie bisher, der komplette Stack ist das Ergebnis.

    Bewusst gegen IResultNode und nicht gegen den End-Knoten: der Terminate-Knoten deklariert sein
    Ergebnis nach denselben Regeln, und zwei Editoren dafuer liefen mit der Zeit auseinander - genau wie
    zwei Auswertungen in der Engine.
*@

@if (Node is not null)
{
    <MudText Typo="Typo.caption" Class="mt-4">Result</MudText>
    <MudText Typo="Typo.caption" Class="mud-text-secondary">
        @(HelperText ?? DefaultHelperText)
    </MudText>
    <OutputBindingTable Bindings="Node.Outputs" Title="Result" AddLabel="Add result"
                        SourceLabel="Variable" TargetLabel="Result name" />

    @if (Node.Outputs.Count > 0)
    {
        <ScopeModeSection ShowSwitch="false" Mode="ActivityScopeMode.Replace" RetainVariables="Node.RetainVariables"
                          HelperText="@("Variables kept here survive besides the result.")" />
    }
}

@code {
    private const string DefaultHelperText =
        "Map instance variables to result names. Declared here, the scope is reduced to exactly this result "
        + "when the workflow completes - that result is what a calling workflow receives. Leave empty to "
        + "return the whole variable stack.";

    /// <summary>Der zu konfigurierende Abschluss-Knoten (End oder Terminate).</summary>
    [Parameter] public IResultNode? Node { get; set; }

    /// <summary>Abweichender Hinweistext; null = der Standardtext für den End-Knoten.</summary>
    [Parameter] public string? HelperText { get; set; }
}
