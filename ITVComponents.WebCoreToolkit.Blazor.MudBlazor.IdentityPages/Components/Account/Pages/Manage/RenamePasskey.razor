@page "/Account/Manage/RenamePasskey/{Id}"
@rendermode @(RenderMode.InteractiveServer)

@layout ManageLayout
@attribute [Microsoft.AspNetCore.Authorization.Authorize]

@using System.Buffers.Text
@using System.ComponentModel.DataAnnotations
@using System.Linq
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Identity
@using Microsoft.Extensions.Localization
@using ITVComponents.WebCoreToolkit.IdentityShared.Areas.Identity

@inject IPageHandlerProvider<PasskeyPageModel, IPasskeyHandler> PasskeyProvider
@inject AuthenticationStateProvider AuthState
@inject IStringLocalizer<IdentityMessages> L
@inject NavigationManager Nav

<PageTitle>@L["Rename passkey"]</PageTitle>

@if (loading)
{
    <MudProgressCircular Indeterminate="true" />
}
else if (!usePage)
{
    <MudAlert Severity="Severity.Info">@L["This page is not available."]</MudAlert>
}
else if (loadError is not null)
{
    <MudAlert Severity="Severity.Error">@loadError</MudAlert>
}
else if (passkey is not null)
{
    <MudText Typo="Typo.h5" GutterBottom="true">
        @if (passkey.Name is { } name)
        {
            @string.Format(L["Rename passkey '{0}'"], name)
        }
        else
        {
            @L["Name your new passkey"]
        }
    </MudText>

    <EditForm Model="Input" OnValidSubmit="Rename">
        <ToolkitDataAnnotationsValidator />

        @if (!string.IsNullOrEmpty(errorMessage))
        {
            <MudAlert Severity="Severity.Error" Class="mb-3">@errorMessage</MudAlert>
        }

        <ValidationSummary class="itv-field-error" role="alert" />

        <MudTextField @bind-Value="Input.Name" Label="@L["Passkey name"]" For="@(() => Input.Name)"
                      Placeholder="@L["My laptop"]" Class="mb-3" />

        <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary" Disabled="@busy">
            @L["Save"]
        </MudButton>
    </EditForm>
}

@code {
    private UserPasskeyInfo? passkey;
    private string? loadError;
    private string? errorMessage;
    private bool busy;
    private bool loading = true;
    private bool usePage;

    [Parameter]
    public string? Id { get; set; }

    private InputModel Input { get; set; } = new();

    protected override async Task OnInitializedAsync()
    {
        try
        {
            await using var op = PasskeyProvider.BeginOperation();
            usePage = op.Handler.UsePage;
            if (!usePage)
            {
                return;
            }

            if (string.IsNullOrEmpty(Id))
            {
                loadError = L["Missing credential identifier."];
                return;
            }

            byte[] credentialId;
            try
            {
                credentialId = Base64Url.DecodeFromChars(Id);
            }
            catch (FormatException)
            {
                loadError = L["The passkey identifier is not in a valid format."];
                return;
            }

            var principal = (await AuthState.GetAuthenticationStateAsync()).User;
            passkey = await op.Handler.GetUserPasskeyAsync(principal, credentialId);
            if (passkey is null)
            {
                loadError = L["The requested passkey could not be found."];
                return;
            }

            // Vorbelegen, damit ein bestehender Name im Feld steht - der Formular-Post brachte ihn frueher mit.
            Input.Name = passkey.Name ?? string.Empty;
        }
        finally
        {
            loading = false;
        }
    }

    private async Task Rename()
    {
        if (!usePage || passkey is null)
        {
            return;
        }

        busy = true;
        try
        {
            await using var op = PasskeyProvider.BeginOperation();
            passkey.Name = Input.Name;
            var principal = (await AuthState.GetAuthenticationStateAsync()).User;
            var result = await op.Handler.AddOrUpdateUserPasskeyAsync(principal, passkey);
            if (!result.Succeeded)
            {
                errorMessage = string.Join(", ", result.Errors.Select(e => e.Description));
                return;
            }

            Nav.NavigateTo(
                Nav.GetUriWithQueryParameters("Account/Manage/Passkeys",
                    new Dictionary<string, object?> { ["status"] = L["Passkey renamed."].Value }));
        }
        finally
        {
            busy = false;
        }
    }

    public sealed class InputModel
    {
        [Required]
        [StringLength(200, MinimumLength = 1)]
        public string Name { get; set; } = "";
    }
}
