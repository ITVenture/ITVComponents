@using System.Globalization
@using ITVComponents.WebCoreToolkit.Extensions

@inject IWorkflowMonitorHandler Handler
@inject AuthenticationStateProvider AuthState
@inject IStringLocalizer<WorkflowMonitorMessages> L

@*
    Startet eine neue Instanz von Hand. Die Maske ist NICHT hier verdrahtet, sondern kommt aus der
    Definition: der Start-Knoten deklariert seine Felder (StartNode.FormFields) genauso wie eine
    Benutzer-Aufgabe die ihren - gerendert vom selben UserTaskFieldsForm. Die eingegebenen Werte sind die
    UEBERGEBENEN Startvariablen; was daraus wird, entscheidet danach die Signatur (StartNode.Inputs).
*@

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">
            <MudIcon Icon="@Icons.Material.Filled.PlayArrow" Class="mr-2" />
            <span>@L["StartDialogTitle"]</span>
        </MudText>
    </TitleContent>
    <DialogContent>
        @if (loading)
        {
            <MudProgressCircular Indeterminate="true" />
        }
        else if (definitions.Count == 0)
        {
            <MudAlert Severity="Severity.Info">@L["StartNoneAvailable"]</MudAlert>
        }
        else
        {
            <MudSelect T="string" Value="@definitionId" ValueChanged="OnDefinitionChanged" Label="@L["StartWorkflowLabel"]"
                       Dense="true" Margin="Margin.Dense">
                @foreach (WorkflowStartableDefinition def in definitions)
                {
                    <MudSelectItem T="string" Value="@def.Id">@DefinitionLabel(def)</MudSelectItem>
                }
            </MudSelect>

            @if (formLoading)
            {
                <MudProgressCircular Indeterminate="true" Class="mt-3" />
            }
            else if (form is not null)
            {
                @if (!string.IsNullOrWhiteSpace(Description))
                {
                    <MudText Typo="Typo.body2" Class="mt-3">@Description</MudText>
                }

                <MudTextField @bind-Value="correlationKey" Label="@L["StartCorrelationLabel"]"
                              Margin="Margin.Dense" Class="mt-3"
                              HelperText="@L["StartCorrelationHelp"].Value" />

                <WorkflowPrioritySelect @bind-Value="priority" Label="@L["StartPriorityLabel"]" Class="mt-3"
                                        InheritLabel="@L["StartPriorityInherit"]"
                                        HelperText="@L["StartPriorityHelp"].Value" />

                @if (form.Fields.Count == 0 && scheduleValues.Count == 0)
                {
                    <MudAlert Severity="Severity.Info" Class="mt-3">@L["StartNoForm"]</MudAlert>
                }
                else if (form.Fields.Count > 0)
                {
                    <MudDivider Class="my-3" />
                    @* Payload = die Vorbelegung. Deklarierte Felder, fuer die der Zeitplan einen festen
                       Wert kennt, stehen damit schon ausgefuellt da - der Benutzer sieht, womit ein
                       zeitgesteuerter Lauf starten wuerde, und kann es aendern. *@
                    <UserTaskFieldsForm @ref="fields"
                                        Fields="form.Fields"
                                        Payload="form.ScheduleDefaults.Count == 0 ? null : declaredDefaults"
                                        AllowReadOnly="false"
                                        TranslateText="Translate"
                                        ResetKey="@form.DefinitionId" />
                }

                @if (scheduleValues.Count > 0)
                {
                    @* Die festen Werte des Zeitplans. Sie stehen hier, damit ein Start von Hand nicht
                       anders losläuft als der zeitgesteuerte - und zwar SICHTBAR und aenderbar: wer von
                       Hand startet, tut das meist gerade, um etwas anders zu machen. *@
                    <MudDivider Class="my-3" />
                    <MudText Typo="Typo.subtitle2">@L["StartFromSchedule"]</MudText>
                    <MudText Typo="Typo.caption" Class="mud-text-secondary">@L["StartFromScheduleHint"]</MudText>
                    @foreach (string key in scheduleValues.Keys.ToList())
                    {
                        string name = key;
                        <MudTextField T="string" Value="@scheduleValues[name]" Label="@name"
                                      Margin="Margin.Dense" Class="mt-2"
                                      ValueChanged="@(v => scheduleValues[name] = v)" />
                    }
                }

                @if (form.StrictSignature)
                {
                    @* Bei strikter Signatur ueberlebt nur, was in StartNode.Inputs steht - ein Feld, das
                       dort fehlt, ist nach dem Start weg. Das sieht man der Maske sonst nicht an. *@
                    <MudAlert Severity="Severity.Warning" Dense="true" Class="mt-3">@L["StartStrictSignature"]</MudAlert>
                }
            }
        }

        @if (!string.IsNullOrEmpty(error))
        {
            <MudAlert Severity="Severity.Error" Class="mt-3">@error</MudAlert>
        }
    </DialogContent>
    <DialogActions>
        <DialogMaximizeToggle NormalMaxWidth="MaxWidth.Medium" />
        <MudSpacer />
        <MudButton OnClick="Cancel" Disabled="@starting">@L["Cancel"]</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.PlayArrow"
                   OnClick="Start" Disabled="@(starting || form is null)">@L["StartAction"]</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;

    /// <summary>Die (optional) gewählte Workflow-Umgebung; null = die Standard-Umgebung.</summary>
    [Parameter] public string? Environment { get; set; }

    /// <summary>Optional vorausgewählte Definition (z.B. aus der Definitions-Übersicht heraus gestartet).</summary>
    [Parameter] public string? DefinitionId { get; set; }

    private IReadOnlyList<WorkflowStartableDefinition> definitions = Array.Empty<WorkflowStartableDefinition>();
    private WorkflowStartForm? form;
    private UserTaskFieldsForm? fields;
    private ClaimsPrincipal? currentUser;
    private string? definitionId;
    private string? correlationKey;
    private int? priority;
    private string? error;
    private bool loading = true;
    private bool formLoading;
    private bool starting;

    /// <summary>
    /// Die festen Werte des Zeitplans, wie sie in der Maske stehen - als Text, weil sie hier bearbeitbar
    /// sind. Leer, wenn die Definition keinen Zeitplan hat.
    /// </summary>
    /// <remarks>
    /// Ein Feld, das der Start-Knoten OHNEHIN deklariert, kommt hier nicht noch einmal: es steht schon in
    /// der Maske, und zweimal dieselbe Angabe waere eine Einladung, sie widerspruechlich auszufuellen.
    /// </remarks>
    private Dictionary<string, string?> scheduleValues = new(StringComparer.OrdinalIgnoreCase);

    /// <summary>
    /// Die Zeitplan-Werte, fuer die es ein deklariertes Feld GIBT - sie gehen als Vorbelegung in die
    /// Maske statt in die Liste darunter.
    /// </summary>
    private Dictionary<string, object> declaredDefaults = new(StringComparer.Ordinal);

    private string? Description => Translate(form?.Description);

    protected override async Task OnInitializedAsync()
    {
        AuthenticationState auth = await AuthState.GetAuthenticationStateAsync();
        currentUser = auth.User;
        definitions = await Handler.ListStartableDefinitionsAsync(currentUser, Environment);
        loading = false;

        // Vorauswahl: die mitgegebene Definition, sonst - wenn es nur eine gibt - eben diese. Ein Dialog
        // mit genau einer Wahl soll sie nicht erst abgefragt haben wollen.
        string? preselect = !string.IsNullOrWhiteSpace(DefinitionId)
                            && definitions.Any(d => d.Id == DefinitionId)
            ? DefinitionId
            : definitions.Count == 1 ? definitions[0].Id : null;

        if (preselect is not null)
        {
            await OnDefinitionChanged(preselect);
        }
    }

    private async Task OnDefinitionChanged(string? value)
    {
        definitionId = value;
        form = null;
        error = null;
        if (string.IsNullOrWhiteSpace(value))
        {
            return;
        }

        formLoading = true;
        try
        {
            form = await Handler.GetStartFormAsync(currentUser!, value!, Environment);
            if (form is null)
            {
                error = L["StartLoadFailed"];
                return;
            }

            // Nur die Zeitplan-Werte, fuer die es KEIN deklariertes Feld gibt - der Rest gehoert in die
            // Maske und wird dort vorbelegt.
            var declared = new HashSet<string>(
                form.Fields.Where(f => !string.IsNullOrWhiteSpace(f.Name)).Select(f => f.Name),
                StringComparer.OrdinalIgnoreCase);
            scheduleValues = form.ScheduleDefaults
                .Where(p => !declared.Contains(p.Key))
                .ToDictionary(p => p.Key, p => p.Value?.ToString(), StringComparer.OrdinalIgnoreCase);

            // Und umgekehrt: was deklariert IST, geht als Vorbelegung in die Maske. Der Feldname muss
            // dabei so geschrieben sein wie im Feld, nicht wie im Zeitplan - die Maske sucht ihn exakt.
            declaredDefaults = form.ScheduleDefaults
                .Where(p => declared.Contains(p.Key) && p.Value is not null)
                .ToDictionary(
                    p => form.Fields.First(f =>
                        string.Equals(f.Name, p.Key, StringComparison.OrdinalIgnoreCase)).Name,
                    p => p.Value!,
                    StringComparer.Ordinal);
        }
        finally
        {
            formLoading = false;
        }
    }

    private async Task Start()
    {
        if (form is null || starting)
        {
            return;
        }

        error = null;

        // Kein Formular = keine Werte; sonst muessen die Pflichtfelder sitzen, bevor eine Instanz entsteht.
        var variables = new Dictionary<string, object>(StringComparer.Ordinal);
        if (form.Fields.Count > 0)
        {
            if (fields is null || !fields.TryGetResult(out variables))
            {
                return;
            }
        }

        // Die Zeitplan-Werte dazu - NACH der Maske, aber ohne zu ueberschreiben: was der Benutzer in ein
        // deklariertes Feld getippt hat, ist die spezifischere Angabe. (Ueberschneiden koennen sie sich
        // ohnehin nicht, die Maske filtert sie beim Laden heraus - der Vorrang steht hier trotzdem, damit
        // er nicht vom Filter abhaengt.)
        foreach (KeyValuePair<string, string?> pair in scheduleValues)
        {
            if (!variables.ContainsKey(pair.Key) && !string.IsNullOrWhiteSpace(pair.Value))
            {
                variables[pair.Key] = pair.Value;
            }
        }

        starting = true;
        try
        {
            var request = new WorkflowStartRequest
            {
                DefinitionId = form.DefinitionId,
                CorrelationKey = correlationKey,
                Priority = priority,
                Variables = variables
            };

            WorkflowStartResult result = await Handler.StartInstanceAsync(currentUser!, request, Environment);
            if (!result.Started)
            {
                error = result.Error ?? L["StartFailed"];
                return;
            }

            MudDialog.Close(DialogResult.Ok(result.InstanceId));
        }
        finally
        {
            starting = false;
        }
    }

    private void Cancel() => MudDialog.Cancel();

    private static string DefinitionLabel(WorkflowStartableDefinition def)
        => string.IsNullOrWhiteSpace(def.Name) ? $"{def.Id} (v{def.Version})" : $"{def.Name} — {def.Id} (v{def.Version})";

    /// <summary>
    /// Loest Kultur-JSON aus der Definition in die Kultur des Lesers auf (dieselbe Konvention wie bei den
    /// Navigations-Eintraegen und den Aufgaben-Titeln).
    /// </summary>
    private string? Translate(string? value)
        => string.IsNullOrEmpty(value) ? value : value.Translate(CultureInfo.CurrentUICulture?.Name);
}
