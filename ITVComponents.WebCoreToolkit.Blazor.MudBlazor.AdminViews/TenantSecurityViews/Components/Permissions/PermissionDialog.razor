<EditDialogShell Model="Model" IsCreate="IsCreate">
    <MudTextField @bind-Value="Model.PermissionName" Label="Permission name" Required="true" RequiredError="Permission name is required" />
    <MudTextField @bind-Value="Model.Description" Label="Description" Lines="3" />
</EditDialogShell>

@code {
    [Parameter, EditorRequired] public PermissionViewModel Model { get; set; } = default!;
    [Parameter] public bool IsCreate { get; set; }
}
