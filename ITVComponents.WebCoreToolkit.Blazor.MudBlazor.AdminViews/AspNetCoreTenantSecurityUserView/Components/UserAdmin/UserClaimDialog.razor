<EditDialogShell Model="Model" IsCreate="IsCreate" CreateLabel="Add">
    <MudTextField @bind-Value="Model.ClaimType" Label="Type" Required="true" RequiredError="Type is required" />
    <MudTextField @bind-Value="Model.ClaimValue" Label="Value" Lines="3" />
</EditDialogShell>

@code {
    [Parameter, EditorRequired] public UserClaimViewModel Model { get; set; } = default!;
    [Parameter] public bool IsCreate { get; set; }
}
