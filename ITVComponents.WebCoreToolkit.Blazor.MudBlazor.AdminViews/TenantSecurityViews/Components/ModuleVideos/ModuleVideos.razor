@page "/Help/Videos"
@rendermode @(RenderMode.InteractiveServer)
@attribute [Microsoft.AspNetCore.Authorization.Authorize]

@using Microsoft.AspNetCore.Components.Authorization

@inject IModuleVideoAdminHandler Handler
@inject AuthenticationStateProvider AuthState
@inject IDialogService DialogService
@inject ISnackbar Snackbar

<PageTitle>Module videos</PageTitle>

<MudText Typo="Typo.h5" GutterBottom="true">Module videos</MudText>

@if (currentUser is null)
{
    <MudProgressCircular Indeterminate="true" />
}
else if (!hasView)
{
    <MudAlert Severity="Severity.Warning">No permission to view module videos.</MudAlert>
}
else
{
    <MudDataGrid T="VideoTutorialViewModel"
                 @ref="grid"
                 ServerData="LoadData"
                 SortMode="SortMode.None"
                 RowsPerPage="25" Hover="true" Dense="true">
        <ToolBarContent>
            <RefreshButton OnClick="@(() => grid is null ? Task.CompletedTask : grid.ReloadServerData())" />
            <MudText Typo="Typo.h6">Module videos</MudText>
            <MudSpacer />
            <MudTextField @bind-Value="search" Placeholder="Search…" DebounceInterval="300" OnDebounceIntervalElapsed="@(() => grid is null ? Task.CompletedTask : grid.ReloadServerData())" Class="mt-0" />
            @if (hasWrite)
            {
                <MudButton StartIcon="@Icons.Material.Filled.Add" Variant="Variant.Filled" Color="Color.Primary" Class="ml-2" OnClick="OpenCreate">Add video</MudButton>
            }
        </ToolBarContent>
        <Columns>
            <HierarchyColumn T="VideoTutorialViewModel" />
            <PropertyColumn Property="x => x.SortableName" Title="Sortable name" />
            <PropertyColumn Property="x => x.DisplayName" Title="Display name" />
            <PropertyColumn Property="x => x.ModuleUrl" Title="Module URL" />
            <TemplateColumn T="VideoTutorialViewModel" Title="" Sortable="false">
                <CellTemplate>
                    @if (hasWrite)
                    {
                        <MudStack Row="true" Spacing="1">
                            <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" OnClick="@(() => OpenEdit(context.Item))" />
                            <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error" OnClick="@(() => Delete(context.Item))" />
                        </MudStack>
                    }
                </CellTemplate>
            </TemplateColumn>
        </Columns>
        <ChildRowContent>
            <MudPaper Elevation="0" Class="pa-2">
                <TutorialStreamsGrid VideoTutorialId="@context.Item.VideoTutorialId" />
            </MudPaper>
        </ChildRowContent>
        <PagerContent><MudDataGridPager T="VideoTutorialViewModel" /></PagerContent>
    </MudDataGrid>
}

@code {
    private MudDataGrid<VideoTutorialViewModel>? grid;
    private System.Security.Claims.ClaimsPrincipal? currentUser;
    private bool hasView, hasWrite;
    private string? search;

    protected override async Task OnInitializedAsync()
    {
        var auth = await AuthState.GetAuthenticationStateAsync();
        currentUser = auth.User;
        hasView = Handler.HasPermission(currentUser, "ModuleHelp.View", "ModuleHelp.Write");
        hasWrite = Handler.HasPermission(currentUser, "ModuleHelp.Write");
    }

    private async Task<GridData<VideoTutorialViewModel>> LoadData(GridState<VideoTutorialViewModel> state, CancellationToken ct)
    {
        if (currentUser is null || !hasView) return new GridData<VideoTutorialViewModel>();
        var result = await Handler.ListTutorialsAsync(currentUser, new ListQuery { Page = state.Page, PageSize = state.PageSize, Search = search });
        return new GridData<VideoTutorialViewModel> { Items = result.Items, TotalItems = result.TotalCount };
    }

    private async Task OpenCreate()
    {
        var p = new DialogParameters<VideoTutorialDialog> { { d => d.Model, new VideoTutorialViewModel() }, { d => d.IsCreate, true } };
        var dlg = await DialogService.ShowAsync<VideoTutorialDialog>("Create video", p, EditDialogDefaults.Edit);
        var r = await dlg.Result;
        if (r is { Canceled: false, Data: VideoTutorialViewModel m } && await Handler.CreateTutorialAsync(currentUser!, m) != null)
        { Snackbar.Add("Video created", Severity.Success); if (grid is not null) await grid.ReloadServerData(); }
    }

    private async Task OpenEdit(VideoTutorialViewModel item)
    {
        var copy = new VideoTutorialViewModel { VideoTutorialId = item.VideoTutorialId, SortableName = item.SortableName, DisplayName = item.DisplayName, Description = item.Description, ModuleUrl = item.ModuleUrl };
        var p = new DialogParameters<VideoTutorialDialog> { { d => d.Model, copy }, { d => d.IsCreate, false } };
        var dlg = await DialogService.ShowAsync<VideoTutorialDialog>("Edit video", p, EditDialogDefaults.Edit);
        var r = await dlg.Result;
        if (r is { Canceled: false, Data: VideoTutorialViewModel m } && await Handler.UpdateTutorialAsync(currentUser!, m) != null)
        { Snackbar.Add("Video updated", Severity.Success); if (grid is not null) await grid.ReloadServerData(); }
    }

    private async Task Delete(VideoTutorialViewModel item)
    {
        var ok = await DialogService.ShowMessageBoxAsync("Delete video", $"Really delete '{item.DisplayName}'?", yesText: "Delete", cancelText: "Cancel");
        if (ok != true) return;
        if (await Handler.DeleteTutorialAsync(currentUser!, item.VideoTutorialId))
        { Snackbar.Add("Video deleted", Severity.Success); if (grid is not null) await grid.ReloadServerData(); }
        else Snackbar.Add("Failed to delete", Severity.Error);
    }
}
