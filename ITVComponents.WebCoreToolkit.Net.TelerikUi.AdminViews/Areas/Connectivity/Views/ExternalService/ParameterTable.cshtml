@using ITVComponents.WebCoreToolkit.Extensions
@using ITVComponents.WebCoreToolkit.Net.TelerikUi.AdminViews.Extensions
@using ITVComponents.WebCoreToolkit.Net.TelerikUi.AdminViews.TenantSecurityViews.Resources
@using ITVComponents.WebCoreToolkit.Net.TelerikUi.AdminViews.TenantSecurityViews.ViewModel
@using Kendo.Mvc.UI
@{
    var oauthServiceId = ViewData["OAuthServiceId"];
    var canWrite = Context.RequestServices.VerifyUserPermissions(new[] { "Services.Connections.Write" });
}
<small class="form-text text-muted">@TextsAndMessagesHelper.IWCN_ES_ParamHint</small>
@if (ViewData["SupportsParameters"] is not true)
{
    <small class="form-text text-warning">@TextsAndMessagesHelper.IWCN_ES_ParamNotSupported</small>
}
@(Html.Kendo().Grid<ExternalOAuthServiceParameterViewModel>().Name($"OAuthParamTab{oauthServiceId}")
    .Columns(columns =>
    {
        columns.Bound(c => c.ParameterName).Title(TextsAndMessagesHelper.IWCN_General_ParameterName);
        columns.Bound(c => c.ParameterValue).Title(TextsAndMessagesHelper.IWCN_General_Value);
        if (canWrite)
        {
            columns.Command(ga =>
            {
                ga.Edit();
                ga.PopupConfirmDelete();
            }).Width(180);
        }
    })
    .ToolBar(toolbar =>
    {
        toolbar.RefreshTable();
        if (canWrite)
        {
            toolbar.Create();
        }
    })
    .DataSource(dataSource =>
    {
        var src = dataSource
            .Ajax()
            .Read(read => read.Action("ReadParameters", "ExternalService", new { area = "Connectivity", oauthServiceId }))
            .Sort(s => s.Add(m => m.ParameterName).Ascending());
        if (canWrite)
        {
            src.Create(create => create.Action("CreateParameter", "ExternalService", new { area = "Connectivity", oauthServiceId }))
                .Update(update => update.Action("UpdateParameter", "ExternalService", new { area = "Connectivity" }))
                .Destroy(destroy => destroy.Action("DestroyParameter", "ExternalService", new { area = "Connectivity" }));
        }
        src.Model(m =>
        {
            m.Id(t => t.OAuthServiceParameterId);
            m.Field(t => t.OAuthServiceId).DefaultValue(oauthServiceId is int i ? i : 0);
        });
    })
    .Scrollable(s => s.Height("auto"))
    .Resizable(c => c.Columns(true)))
