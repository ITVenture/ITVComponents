@page "/Workflow/Definitions/{Key:int}"
@page "/Workflow/env/{Environment}/Definitions/{Key:int}"
@rendermode @(RenderMode.InteractiveServer)
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@using ITVComponents.Workflow.Model

@inject IWorkflowDesignHandler Handler
@inject AuthenticationStateProvider AuthState

<PageTitle>Workflow definition</PageTitle>

<SecureView RequiredPermissions="Workflow.Design" RequiredFeatures="ITVWorkflow">
    <Permitted>
        <MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-3">
            @* Ziele relativ (ohne fuehrenden Slash) - siehe Kommentar in WorkflowDefinitions.razor. *@
            <MudIconButton Icon="@Icons.Material.Filled.ArrowBack" Href="@($"{EnvPrefix}/Definitions")" Title="Back" />
            <MudText Typo="Typo.h5">
                @(string.IsNullOrEmpty(definition?.Name) ? definition?.TechnicalName : definition!.Name)
                <MudText Typo="Typo.caption" Class="ml-2" Inline="true">@definition?.TechnicalName (v@definition?.Version) &middot; #@Key</MudText>
            </MudText>
            <MudSpacer />
            <MudButton StartIcon="@Icons.Material.Filled.Edit" Variant="Variant.Filled" Color="Color.Primary"
                       Href="@($"{EnvPrefix}/Definitions/{Key}/edit")">Edit</MudButton>
        </MudStack>

        @if (!loaded)
        {
            <MudProgressCircular Indeterminate="true" />
        }
        else if (definition is null)
        {
            <MudAlert Severity="Severity.Warning">Definition not found.</MudAlert>
        }
        else
        {
            <MudPaper Class="pa-2">
                <WorkflowGraph Definition="definition" />
            </MudPaper>
        }
    </Permitted>
    <NotPermitted>
        <MudAlert Severity="Severity.Warning">No permission to view workflow definitions.</MudAlert>
    </NotPermitted>
</SecureView>

@code {
    /// <summary>Der Primaerschluessel der Definitionszeile - der Aufhaenger dieser Ansicht.</summary>
    [Parameter] public int Key { get; set; }

    /// <summary>Die (optional) über das Nav-Segment vorgegebene Umgebung; null = Standard.</summary>
    [Parameter] public string? Environment { get; set; }

    private WorkflowDefinition? definition;
    private bool loaded;

    private string EnvPrefix => string.IsNullOrEmpty(Environment)
        ? "Workflow"
        : $"Workflow/env/{Uri.EscapeDataString(Environment!)}";

    protected override async Task OnParametersSetAsync()
    {
        loaded = false;
        var auth = await AuthState.GetAuthenticationStateAsync();
        definition = await Handler.GetDefinitionByKeyAsync(auth.User, Key, Environment);
        loaded = true;
    }
}
