@page "/Account/Manage/ExternalLoginsCallback"
@attribute [Microsoft.AspNetCore.Components.ExcludeFromInteractiveRouting]

@layout ManageLayout
@attribute [Microsoft.AspNetCore.Authorization.Authorize]

@using Microsoft.AspNetCore.Authentication
@using Microsoft.AspNetCore.Http
@using Microsoft.AspNetCore.Identity
@using Microsoft.Extensions.Localization
@using ITVComponents.WebCoreToolkit.Blazor.MudBlazor.IdentityPages.Components.Account.Shared
@using ITVComponents.WebCoreToolkit.IdentityShared.Areas.Identity
@using ITVComponents.WebCoreToolkit.IdentityShared.Areas.Identity.Pages.Account.Manage
@using ITVComponents.WebCoreToolkit.IdentityShared.PageHandlers.Identity.Account.Manage

@inject IPageHandlerProvider<ExternalLoginsModel, IExternalLoginsHandler> HandlerProvider
@inject IStringLocalizer<IdentityMessages> L
@inject NavigationManager Nav

@code {
    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    protected override async Task OnInitializedAsync()
    {
        if (!HandlerProvider.Handler.UsePage)
        {
            Nav.NavigateTo("Account/Manage/ExternalLogins", forceLoad: true);
            return;
        }

        var user = await HandlerProvider.Handler.FetchUser(HttpContext.User);
        try
        {
            if (!user.UserExists)
            {
                throw new InvalidOperationException(
                    L["Unable to load user with ID '{0}'.", HandlerProvider.Handler.GetUserId(HttpContext.User)]);
            }

            var result = await HandlerProvider.Handler.AddExternalLogin(user);
            if (!result.Success && result.IdentityResult == null)
            {
                throw new InvalidOperationException(
                    $"Unexpected error occurred loading external login info for user with ID '{result.UserId}'.");
            }

            string status;
            if (!result.Success)
            {
                status = L["The external login was not added. External logins can only be associated with one account."].Value;
            }
            else
            {
                await HttpContext.SignOutAsync(IdentityConstants.ExternalScheme);
                status = L["The external login was added."].Value;
            }

            Nav.NavigateTo(
                Nav.GetUriWithQueryParameters("Account/Manage/ExternalLogins",
                    new Dictionary<string, object?> { ["status"] = status }),
                forceLoad: true);
        }
        finally
        {
            HandlerProvider.Handler.ReleaseUser(user);
        }
    }
}
