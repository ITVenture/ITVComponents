@page "/Onboarding/BillingProfiles"
@rendermode @(RenderMode.InteractiveServer)
@attribute [Microsoft.AspNetCore.Authorization.Authorize]

@using Microsoft.AspNetCore.Components.Authorization

@inject IOnboardingAdminHandler Handler
@inject AuthenticationStateProvider AuthState
@inject IDialogService DialogService
@inject ISnackbar Snackbar

<PageTitle>Billing profiles</PageTitle>

<MudText Typo="Typo.h5" GutterBottom="true">Billing profiles</MudText>

<SecureView RequiredPermissions="ManageEmployees" RequiredFeatures="ITVAdminViews">
    <Permitted>
        @if (loading)
        {
            <MudProgressCircular Indeterminate="true" />
        }
        else if (currentTenant is null)
        {
            <MudAlert Severity="Severity.Warning">No tenant is currently selected, or you are not a member of it.</MudAlert>
        }
        else
        {
            <MudText Typo="Typo.body2" Class="mb-2">Tenant: <b>@currentTenant.DisplayName</b></MudText>
            <MudDataGrid T="BillingProfileAdminViewModel" Items="profiles" Dense="true" Hover="true">
                <ToolBarContent>
                    <RefreshButton OnClick="Reload" />
                    <MudText Typo="Typo.h6">Profiles</MudText>
                    <MudSpacer />
                    <MudButton StartIcon="@Icons.Material.Filled.Add" Variant="Variant.Filled" Color="Color.Primary" OnClick="OpenCreate">
                        Add profile
                    </MudButton>
                </ToolBarContent>
                <Columns>
                    <PropertyColumn Property="x => x.DisplayName" Title="Name" />
                    <PropertyColumn Property="x => x.ProfileType" Title="Type" />
                    <PropertyColumn Property="x => x.Email" Title="Email" />
                    <PropertyColumn Property="x => x.EmployeeCount" Title="Employees" />
                    <TemplateColumn T="BillingProfileAdminViewModel" Title="" Sortable="false">
                        <CellTemplate>
                            <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" Title="Manage" OnClick="@(() => OpenManage(context.Item))" />
                        </CellTemplate>
                    </TemplateColumn>
                </Columns>
            </MudDataGrid>
        }
    </Permitted>
    <NotPermitted>
        <MudAlert Severity="Severity.Warning">No permission to manage billing profiles.</MudAlert>
    </NotPermitted>
</SecureView>

@code {
    private System.Security.Claims.ClaimsPrincipal? currentUser;
    private TenantPickerItem? currentTenant;
    private BillingProfileAdminViewModel[] profiles = Array.Empty<BillingProfileAdminViewModel>();
    private bool loading = true;

    protected override async Task OnInitializedAsync()
    {
        var auth = await AuthState.GetAuthenticationStateAsync();
        currentUser = auth.User;
        currentTenant = await Handler.GetCurrentTenantAsync(currentUser);
        await Reload();
        loading = false;
    }

    private async Task Reload()
    {
        if (currentUser is null || currentTenant is null)
        {
            profiles = Array.Empty<BillingProfileAdminViewModel>();
            return;
        }

        profiles = await Handler.ListBillingProfilesAsync(currentUser);
    }

    private Task OpenCreate() => OpenDialog(0);

    private Task OpenManage(BillingProfileAdminViewModel profile) => OpenDialog(profile.BillingProfileId);

    private async Task OpenDialog(int billingProfileId)
    {
        var parameters = new DialogParameters<BillingProfileAdminDialog>
        {
            { d => d.BillingProfileId, billingProfileId }
        };
        var title = billingProfileId == 0 ? "New billing profile" : "Billing profile";
        var dlg = await DialogService.ShowAsync<BillingProfileAdminDialog>(title, parameters, EditDialogDefaults.Detail);
        await dlg.Result;
        await Reload();
    }
}
