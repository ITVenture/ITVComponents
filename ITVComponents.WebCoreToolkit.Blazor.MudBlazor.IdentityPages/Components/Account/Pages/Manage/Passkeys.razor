@page "/Account/Manage/Passkeys"
@rendermode @(RenderMode.InteractiveServer)

@layout ManageLayout
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@implements IAsyncDisposable

@using System.Buffers.Text
@using System.Linq
@using Microsoft.AspNetCore.Antiforgery
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.AspNetCore.Identity
@using Microsoft.Extensions.Localization
@using Microsoft.Extensions.Logging
@using Microsoft.Extensions.Options
@using Microsoft.JSInterop
@using ITVComponents.WebCoreToolkit.Blazor.MudBlazor.IdentityPages.Components.Account.Shared
@using ITVComponents.WebCoreToolkit.IdentityShared.Areas.Identity

@inject IPageHandlerProvider<PasskeyPageModel, IPasskeyHandler> PasskeyProvider
@inject AuthenticationStateProvider AuthState
@inject IStringLocalizer<IdentityMessages> L
@inject ILogger<Passkeys> Logger
@inject IJSRuntime JS
@inject NavigationManager Nav
@inject AntiforgeryStateProvider AntiforgeryState
@inject IOptions<AntiforgeryOptions> AntiforgeryOptions

<PageTitle>@L["Passkeys"]</PageTitle>

<MudText Typo="Typo.h5" GutterBottom="true">@L["Passkeys"]</MudText>

@if (loading)
{
    <MudProgressCircular Indeterminate="true" />
}
else if (!usePage)
{
    <MudAlert Severity="Severity.Info">@L["This page is not available."]</MudAlert>
}
else
{
    @if (!string.IsNullOrEmpty(status))
    {
        <MudAlert Severity="Severity.Info" Class="mb-3">@status</MudAlert>
    }

    @if (currentPasskeys is { Count: > 0 })
    {
        <MudTable Items="currentPasskeys" Hover="true" Dense="true" Class="mb-3" Breakpoint="Breakpoint.Sm">
            <HeaderContent>
                <MudTh>@L["Name"]</MudTh>
                <MudTh Style="width: 120px;">@L["Actions"]</MudTh>
            </HeaderContent>
            <RowTemplate Context="passkey">
                @{
                    var credentialId = Base64Url.EncodeToString(passkey.CredentialId);
                }
                <MudTd DataLabel="@L["Name"]">@(passkey.Name ?? L["Unnamed passkey"].Value)</MudTd>
                <MudTd>
                    <MudIconButton Icon="@Icons.Material.Filled.Edit"
                                   Href="@($"Account/Manage/RenamePasskey/{credentialId}")"
                                   Color="Color.Primary"
                                   Title="@L["Rename"]" />
                    <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                   Color="Color.Error"
                                   Disabled="@busy"
                                   Title="@L["Delete"]"
                                   OnClick="@(() => DeletePasskey(credentialId))" />
                </MudTd>
            </RowTemplate>
        </MudTable>
    }
    else
    {
        <MudText Class="mb-3">@L["You have no passkeys registered."]</MudText>
    }

    @if (currentPasskeys is { Count: var c } && c >= maxPasskeysPerUser)
    {
        <MudAlert Severity="Severity.Warning">@L["You have reached the maximum number of passkeys."]</MudAlert>
    }
    else
    {
        @* Der Klick wird in JS abgefangen (siehe PasskeySubmit.js/attachPasskeyCreate) - dort laeuft
           navigator.credentials.create() noch in der Benutzer-Geste. Erst das fertige Credential reist
           per .NET-Referenz hierher zurueck. Der Knopf traegt nur eine id, damit JS ihn findet. *@
        <MudButton id="@AddButtonId" Variant="Variant.Filled" Color="Color.Primary" Disabled="@(busy || !canAdd)">
            @L["Add a new passkey"]
        </MudButton>
    }
}

@code {
    private const string AddButtonId = "itv-passkey-add";

    private IList<UserPasskeyInfo>? currentPasskeys;
    private bool loading = true;
    private bool usePage;
    private bool busy;
    private bool canAdd;
    private int maxPasskeysPerUser;
    private IJSObjectReference? module;
    private DotNetObjectReference<Passkeys>? selfRef;

    private string? status;

    [SupplyParameterFromQuery(Name = "status")]
    private string? StatusMessage { get; set; }

    protected override async Task OnInitializedAsync()
    {
        status = StatusMessage;
        await using (var op = PasskeyProvider.BeginOperation())
        {
            usePage = op.Handler.UsePage;
        }

        if (!usePage)
        {
            loading = false;
            return;
        }

        await LoadAsync();
        loading = false;
    }

    private async Task LoadAsync()
    {
        await using var op = PasskeyProvider.BeginOperation();
        var principal = (await AuthState.GetAuthenticationStateAsync()).User;
        currentPasskeys = await op.Handler.GetUserPasskeysAsync(principal);

        // Die Anmelde-Optionen entstehen NICHT hier: MakePasskeyCreationOptionsAsync geht ueber den
        // SignInManager an den HttpContext, den es auf dem Circuit nicht gibt. Sie kommen vom Endpunkt
        // Account/Manage/PasskeyCreationOptions, den das JS-Modul beim Anhaengen ruft.
        maxPasskeysPerUser = op.Handler.MaxPasskeysPerUser;
        canAdd = currentPasskeys is not { Count: var n } || n < maxPasskeysPerUser;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!usePage || !canAdd || module is not null)
        {
            return;
        }

        module ??= await JS.InvokeAsync<IJSObjectReference>("import",
            "./_content/ITVComponents.WebCoreToolkit.Blazor.MudBlazor.IdentityPages/PasskeySubmit.js");
        selfRef ??= DotNetObjectReference.Create(this);

        // Der Endpunkt prueft den Antiforgery-Token ausdruecklich, weil der JS-Aufruf ihn als Kopfzeile
        // schickt und nicht als Formularfeld. Auf einer interaktiven Seite gibt es keinen HttpContext, um
        // ihn wie im static-SSR-Pendant ueber IAntiforgery zu ziehen - der AntiforgeryStateProvider fuehrt
        // ihn aus dem Vorab-Rendering mit.
        var token = AntiforgeryState.GetAntiforgeryToken();
        await module.InvokeVoidAsync("attachPasskeyCreate", AddButtonId, selfRef,
            AntiforgeryOptions.Value.HeaderName, token?.Value);
    }

    /// <summary>
    /// Gerufen, NACHDEM der Endpunkt das Credential geprueft und abgelegt hat. Pruefen und Ablegen gehen
    /// nicht von hier aus: <c>PerformPasskeyAttestationAsync</c> liest die Herausforderung aus dem Cookie,
    /// das <c>MakePasskeyCreationOptionsAsync</c> geschrieben hat - beides braucht einen HttpContext, den
    /// der Circuit nicht hat. Hier bleibt nur der Weitersprung zum Benennen.
    /// </summary>
    [JSInvokable]
    public Task OnPasskeyRegisteredAsync(string credentialIdBase64Url)
    {
        // Weiche Navigation - der Bereich ist interaktiv.
        Nav.NavigateTo($"Account/Manage/RenamePasskey/{credentialIdBase64Url}");
        return Task.CompletedTask;
    }

    [JSInvokable]
    public Task OnPasskeyFailedAsync(string message)
    {
        status = message;
        StateHasChanged();
        return Task.CompletedTask;
    }

    private async Task DeletePasskey(string credentialIdBase64Url)
    {
        busy = true;
        try
        {
            byte[] credentialId;
            try
            {
                credentialId = Base64Url.DecodeFromChars(credentialIdBase64Url);
            }
            catch (FormatException)
            {
                status = L["The passkey identifier is not in a valid format."].Value;
                return;
            }

            var principal = (await AuthState.GetAuthenticationStateAsync()).User;
            await using (var op = PasskeyProvider.BeginOperation())
            {
                var result = await op.Handler.RemoveUserPasskeyAsync(principal, credentialId);
                if (!result.Succeeded)
                {
                    status = string.Join(", ", result.Errors.Select(e => e.Description));
                    return;
                }
            }

            status = L["Passkey deleted."].Value;
            await LoadAsync();
        }
        finally
        {
            busy = false;
        }
    }

    public async ValueTask DisposeAsync()
    {
        selfRef?.Dispose();
        if (module is not null)
        {
            try
            {
                await module.DisposeAsync();
            }
            catch (JSDisconnectedException ex)
            {
                // Circuit ist schon weg (Tab geschlossen) - das Modul stirbt mit ihm, das ist der Normalfall.
                // Trotzdem vermerken, damit ein ANDERER Grund fuer ein gescheitertes Dispose nicht unsichtbar
                // bleibt: sonst sieht man hier gar nichts und sucht spaeter an der falschen Stelle.
                Logger.LogDebug(ex, "Passkey-Modul konnte nicht freigegeben werden - Circuit bereits beendet.");
            }
        }
    }
}
