@using Microsoft.AspNetCore.Components.Authorization

@inject IDashboardWidgetAdminHandler Handler
@inject AuthenticationStateProvider AuthState
@inject IDialogService DialogService
@inject ISnackbar Snackbar

<MudDataGrid T="DashboardParamViewModel"
             @ref="grid"
             ServerData="LoadData"
             SortMode="SortMode.None"
             RowsPerPage="10"
             Hover="true"
             Dense="true">
    <ToolBarContent>
        <CrudGridToolbar OnRefresh="@(() => grid is null ? Task.CompletedTask : grid.ReloadServerData())" Title="Parameters" TitleTypo="Typo.subtitle2">
            <SecureView RequiredPermissions="DashboardWidgets.Write">
                <Permitted>
                <MudButton StartIcon="@Icons.Material.Filled.Add" Variant="Variant.Outlined" Size="Size.Small" OnClick="OpenCreate">
                    Add parameter
                </MudButton>
                </Permitted>
            </SecureView>
        </CrudGridToolbar>
    </ToolBarContent>
    <Columns>
        <PropertyColumn Property="x => x.ParameterName" Title="Name" />
        <PropertyColumn Property="x => x.InputType" Title="Type" />
        <PropertyColumn Property="x => x.InputConfig" Title="Config" />
        <TemplateColumn T="DashboardParamViewModel" Title="" Sortable="false">
            <CellTemplate>
                <SecureView RequiredPermissions="DashboardWidgets.Write">
                    <Permitted>
                    <MudStack Row="true" Spacing="1">
                        <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" OnClick="@(() => OpenEdit(context.Item))" />
                        <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error" OnClick="@(() => Delete(context.Item))" />
                    </MudStack>
                    </Permitted>
                </SecureView>
            </CellTemplate>
        </TemplateColumn>
    </Columns>
    <PagerContent>
        <MudDataGridPager T="DashboardParamViewModel" />
    </PagerContent>
</MudDataGrid>

@code {
    [Parameter, EditorRequired] public int DashboardWidgetId { get; set; }
    [Parameter] public bool CanWrite { get; set; }

    private MudDataGrid<DashboardParamViewModel>? grid;
    private System.Security.Claims.ClaimsPrincipal? currentUser;

    protected override async Task OnInitializedAsync()
    {
        var auth = await AuthState.GetAuthenticationStateAsync();
        currentUser = auth.User;
    }

    private async Task<GridData<DashboardParamViewModel>> LoadData(GridState<DashboardParamViewModel> state, CancellationToken ct)
    {
        if (currentUser is null) return new GridData<DashboardParamViewModel> { Items = Array.Empty<DashboardParamViewModel>(), TotalItems = 0 };
        var query = new ListQuery { Page = state.Page, PageSize = state.PageSize };
        var result = await Handler.ListParamsAsync(currentUser, DashboardWidgetId, query);
        return new GridData<DashboardParamViewModel> { Items = result.Items, TotalItems = result.TotalCount };
    }

    private async Task OpenCreate()
    {
        var parameters = new DialogParameters<DashboardParamDialog>
        {
            { d => d.Model, new DashboardParamViewModel() },
            { d => d.IsCreate, true }
        };
        var dlg = await DialogService.ShowAsync<DashboardParamDialog>("Add parameter", parameters, EditDialogDefaults.Edit);
        var result = await dlg.Result;
        if (result is { Canceled: false, Data: DashboardParamViewModel input })
        {
            var created = await Handler.CreateParamAsync(currentUser!, DashboardWidgetId, input);
            if (created != null) { Snackbar.Add("Parameter added", Severity.Success); if (grid is not null) await grid.ReloadServerData(); }
            else Snackbar.Add("Failed to add", Severity.Error);
        }
    }

    private async Task OpenEdit(DashboardParamViewModel item)
    {
        var copy = new DashboardParamViewModel
        {
            DashboardParamId = item.DashboardParamId,
            DashboardWidgetId = item.DashboardWidgetId,
            ParameterName = item.ParameterName,
            InputType = item.InputType,
            InputConfig = item.InputConfig
        };
        var parameters = new DialogParameters<DashboardParamDialog>
        {
            { d => d.Model, copy },
            { d => d.IsCreate, false }
        };
        var dlg = await DialogService.ShowAsync<DashboardParamDialog>("Edit parameter", parameters, EditDialogDefaults.Edit);
        var result = await dlg.Result;
        if (result is { Canceled: false, Data: DashboardParamViewModel input })
        {
            var updated = await Handler.UpdateParamAsync(currentUser!, input);
            if (updated != null) { Snackbar.Add("Parameter updated", Severity.Success); if (grid is not null) await grid.ReloadServerData(); }
            else Snackbar.Add("Failed to update", Severity.Error);
        }
    }

    private async Task Delete(DashboardParamViewModel item)
    {
        var ok = await DialogService.ShowMessageBoxAsync("Delete parameter", $"Really delete '{item.ParameterName}'?", yesText: "Delete", cancelText: "Cancel");
        if (ok != true) return;
        var success = await Handler.DeleteParamAsync(currentUser!, item.DashboardParamId);
        if (success) { Snackbar.Add("Parameter deleted", Severity.Success); if (grid is not null) await grid.ReloadServerData(); }
        else Snackbar.Add("Failed to delete", Severity.Error);
    }
}
