@using Microsoft.AspNetCore.Components.Authorization

@inject IOnboardingAdminHandler Handler
@inject AuthenticationStateProvider AuthState
@inject ISnackbar Snackbar

<MudDialog>
    <DialogContent>
        <MudTabs Elevation="0" Rounded="true" Outlined="true" PanelClass="pa-2">
            <MudTabPanel Text="Mapping">
                <MudForm @ref="form" Model="Model">
                    <MudGrid Spacing="2">
                        <MudItem xs="12" sm="6">
                            <MudSelect T="EmployeeRoleMappingKind" @bind-Value="Model.Kind" Label="Kind">
                                @foreach (var k in System.Enum.GetValues<EmployeeRoleMappingKind>())
                                {
                                    <MudSelectItem T="EmployeeRoleMappingKind" Value="@k">@k</MudSelectItem>
                                }
                            </MudSelect>
                        </MudItem>

                        @if (Model.EmployeeRoleMappingId == 0)
                        {
                            <MudItem xs="12" sm="6">
                                <MudSelect T="int" @bind-Value="Model.RoleId" Label="Underlying role">
                                    <MudSelectItem T="int" Value="0">(create new role)</MudSelectItem>
                                    @foreach (var r in roles)
                                    {
                                        <MudSelectItem T="int" Value="@r.RoleId">@r.RoleName</MudSelectItem>
                                    }
                                </MudSelect>
                            </MudItem>
                            @if (Model.RoleId == 0)
                            {
                                <MudItem xs="12">
                                    <MudTextField @bind-Value="Model.NewRoleName" Label="New role name" Required="true" For="@(() => Model.NewRoleName)" />
                                </MudItem>
                            }
                        }
                        else
                        {
                            <MudItem xs="12" sm="6">
                                <MudTextField Value="@Model.RoleName" Label="Underlying role" ReadOnly="true" />
                            </MudItem>
                        }

                        <MudItem xs="12">
                            <MudTextField @bind-Value="Model.DisplayNameJson" Label="Display label (optional JSON)" Lines="2"
                                          HelperText="Multilingual label as JSON, e.g. {&quot;en&quot;:&quot;Master data&quot;,&quot;de&quot;:&quot;Stammdaten&quot;}. Leave empty to use the role name." />
                        </MudItem>
                    </MudGrid>

                    <MudButton Variant="Variant.Filled" Color="Color.Primary" Class="mt-2" Disabled="@busy" OnClick="Save">Save mapping</MudButton>
                </MudForm>
            </MudTabPanel>
            <MudTabPanel Text="Permission sets">
                @if (Model.Kind != EmployeeRoleMappingKind.DirectRole)
                {
                    <MudAlert Severity="Severity.Info">Permission sets can only be activated on a DirectRole mapping.</MudAlert>
                }
                else if (Model.EmployeeRoleMappingId == 0)
                {
                    <MudAlert Severity="Severity.Info">Save the mapping first to activate permission sets on it.</MudAlert>
                }
                else
                {
                    <PermissionSetsGrid DirectMappingId="Model.EmployeeRoleMappingId" />
                }
            </MudTabPanel>
        </MudTabs>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Close">Close</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;
    [Parameter, EditorRequired] public EmployeeRoleMappingViewModel Model { get; set; } = default!;

    private System.Security.Claims.ClaimsPrincipal? currentUser;
    private TenantRoleOption[] roles = Array.Empty<TenantRoleOption>();
    private MudForm? form;
    private bool busy;

    protected override async Task OnInitializedAsync()
    {
        var auth = await AuthState.GetAuthenticationStateAsync();
        currentUser = auth.User;
        roles = await Handler.ListTenantRolesAsync(currentUser);
    }

    private async Task Save()
    {
        if (form is null || currentUser is null)
        {
            return;
        }

        await form.Validate();
        if (!form.IsValid)
        {
            Snackbar.Add("Please correct invalid fields", Severity.Warning);
            return;
        }

        busy = true;
        try
        {
            var id = await Handler.SaveRoleMappingAsync(currentUser, Model);
            if (id is null)
            {
                Snackbar.Add("Failed to save mapping", Severity.Error);
                return;
            }

            Model.EmployeeRoleMappingId = id.Value;
            if (Model.RoleId == 0 && !string.IsNullOrWhiteSpace(Model.NewRoleName))
            {
                // Reflect the freshly created/linked role so the read-only field + tabs behave on re-render.
                Model.RoleName = Model.NewRoleName;
            }

            Snackbar.Add("Mapping saved", Severity.Success);
        }
        finally
        {
            busy = false;
        }
    }

    private void Close() => MudDialog.Close();
}
