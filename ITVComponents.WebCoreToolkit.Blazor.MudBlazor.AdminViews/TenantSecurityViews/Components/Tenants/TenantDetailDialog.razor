@using ITVComponents.WebCoreToolkit.Blazor.MudBlazor.AdminViews.TenantSecurityViews.Components.Permissions
@using ITVComponents.WebCoreToolkit.Blazor.MudBlazor.AdminViews.TenantSecurityViews.Components.Roles
@using ITVComponents.WebCoreToolkit.Blazor.MudBlazor.AdminViews.TenantSecurityViews.Components.PlugIns
@using ITVComponents.WebCoreToolkit.Blazor.MudBlazor.AdminViews.TenantSecurityViews.Components.Sequences
@using ITVComponents.WebCoreToolkit.Blazor.MudBlazor.AdminViews.TenantSecurityViews.Handlers
@using Microsoft.Extensions.DependencyInjection
@using Microsoft.AspNetCore.Components.Authorization

@inject IServiceProvider Services
@inject ITenantAdminHandler Handler
@inject AuthenticationStateProvider AuthState

<MudDialog Class="itv-fill-dialog">
    <DialogContent>
        <DialogFillStyles />
        <MudTabs Elevation="0" Rounded="true" Outlined="true" PanelClass="pa-2" Class="itv-fill-tabs">
            <MudTabPanel Text="Settings">
                <TenantSettingsGrid TenantId="@Tenant.TenantId" />
            </MudTabPanel>
            <MudTabPanel Text="Feature activations">
                <TenantFeatureActivationsGrid TenantId="@Tenant.TenantId" />
            </MudTabPanel>
            <MudTabPanel Text="Navigation">
                <TenantNavigationGrid TenantId="@Tenant.TenantId" />
            </MudTabPanel>
            <MudTabPanel Text="Permissions">
                <Permissions EmbeddedTenantId="@Tenant.TenantId" />
            </MudTabPanel>
            <MudTabPanel Text="Roles">
                <Roles EmbeddedTenantId="@Tenant.TenantId" />
            </MudTabPanel>
            @if (usersGridType is not null)
            {
                <MudTabPanel Text="Users">
                    <DynamicComponent Type="usersGridType" Parameters="usersGridParameters" />
                </MudTabPanel>
            }
            <MudTabPanel Text="Plug-ins">
                <PlugIns EmbeddedTenantId="@Tenant.TenantId" />
            </MudTabPanel>
            <MudTabPanel Text="Plug-in constants">
                <PlugInConstants EmbeddedTenantId="@Tenant.TenantId" />
            </MudTabPanel>
            <MudTabPanel Text="Sequences">
                <Sequences EmbeddedTenantId="@Tenant.TenantId" />
            </MudTabPanel>
            @if (canExtractTemplate)
            {
                <MudTabPanel Text="Extract Template">
                    <TenantExtractTemplatePanel TenantId="@Tenant.TenantId" />
                </MudTabPanel>
            }
        </MudTabs>
    </DialogContent>
    <DialogActions>
        <DialogMaximizeToggle NormalMaxWidth="MaxWidth.ExtraLarge" />
        <MudSpacer />
        <MudButton OnClick="Close">Close</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;
    [Parameter, EditorRequired] public TenantViewModel Tenant { get; set; } = default!;

    private Type? usersGridType;
    private IDictionary<string, object> usersGridParameters = new Dictionary<string, object>();
    private bool canExtractTemplate;

    protected override void OnParametersSet()
    {
        usersGridType = Services.GetService<TenantUsersGridDescriptor>()?.GridComponentType;
        usersGridParameters = new Dictionary<string, object> { ["TenantId"] = Tenant.TenantId };
    }

    protected override async Task OnInitializedAsync()
    {
        var auth = await AuthState.GetAuthenticationStateAsync();
        canExtractTemplate = Handler.HasPermission("TenantTemplates.Write");
    }

    private void Close() => MudDialog.Close();
}
