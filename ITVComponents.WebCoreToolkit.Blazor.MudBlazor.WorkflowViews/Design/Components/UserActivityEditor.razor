@using ITVComponents.Workflow.Model
@inject IDialogService DialogService

@*
    Tab-basierter Editor für einen UserActivityNode (Benutzer-Aufgabe). Reiter: General (Identität +
    Zuständigkeit), Variable mapping (Datenfluss + Scope), View settings (Darstellung/Übersetzung),
    Input settings (Felder der generischen Maske). KeepPanelsAlive, damit die Monaco-Felder (Assignment/
    FormatData) auch dann für FlushAsync erreichbar sind, wenn ihr Reiter gerade nicht aktiv ist.
    Der Aufrufer (NodePropertiesDialog) ruft FlushAsync() vor dem Schliessen.
*@

@if (Node is not null)
{
    <MudTabs Elevation="0" Rounded="true" ApplyEffectsToContainer="true" PanelClass="pt-4"
             KeepPanelsAlive="true" MinimumTabWidth="70px">
        @* --- General --- *@
        <MudTabPanel Text="General" Icon="@Icons.Material.Filled.Info">
            <MudTextField Value="@Node.Id" Label="Id" ReadOnly="true" Margin="Margin.Dense" />
            <MudTextField @bind-Value="Node.Name" Label="Name" Margin="Margin.Dense" />
            <MudTextField @bind-Value="Node.TaskKey" Label="Task key" Margin="Margin.Dense"
                          HelperText="The business key of this kind of task (e.g. ApproveInvoice). Filters the work list and resolves the form." />
            <ForeignKeyNameAutocomplete TKey="int" Table="Permissions" @bind-Value="Node.RequiredPermission"
                                        Label="Required permission" Clearable="true" />
            <MudText Typo="Typo.caption" Class="mud-text-secondary">
                Who may see and complete tasks of this node. Empty = the general task permission is enough.
            </MudText>

            <MudText Typo="Typo.caption" Class="mt-3">Assignment (CScript → user name)</MudText>
            <MudText Typo="Typo.caption" Class="mud-text-secondary">
                Optional. Evaluated ONCE when the task appears. Empty = the task goes to the pool. An expression
                that fails faults the instance on purpose — an unassigned task would be visible to everyone.
            </MudText>
            <CScriptField @ref="assignField" Height="120" Value="@Node.Assignment"
                          ValueChanged="@(v => Node.Assignment = v)"
                          Mode="Node.AssignmentMode" ModeChanged="@(m => Node.AssignmentMode = m)" />

            <MudNumericField T="double?" @bind-Value="Node.DueInHours" Label="Due in hours" Margin="Margin.Dense"
                             Class="mt-3" Min="0"
                             HelperText="Display and sorting only — an overdue task does NOT continue by itself (use a timer in a parallel branch)." />

            <MudSwitch T="bool" @bind-Value="Node.RunsInAssistant" Color="Color.Primary" Class="mt-3"
                       Label="Runs in an assistant" />
            <MudText Typo="Typo.caption" Class="mud-text-secondary">
                The task belongs to a <b>guided section</b>: after it is completed, a screen that can do so
                leads straight on to the next step instead of closing. This is a property of the NODE, not of
                how the task was opened — someone who closes the assistant halfway and later opens the task
                from their work list gets the same guided run.
            </MudText>

            <MudText Typo="Typo.caption" Class="mt-3">Ends the assistant (CScript → true/false)</MudText>
            <MudText Typo="Typo.caption" Class="mud-text-secondary">
                Optional, and only relevant inside a guided section. <b>true</b> means: with this task the
                guided part is over — the screen closes instead of waiting for the next step. Evaluated on
                completion, <i>after</i> the results were applied, so it may depend on what the user just
                entered. Without it the section ends by itself as soon as a step no longer belongs to it —
                only then the screen has waited for that step first. A failing expression does not fault the
                instance; it counts as "does not end" and lands in the log and the instance history.
            </MudText>
            <CScriptField @ref="endsAssistantField" Height="90" Value="@Node.EndsAssistant"
                          ValueChanged="@(v => Node.EndsAssistant = v)"
                          Mode="Node.EndsAssistantMode" ModeChanged="@(m => Node.EndsAssistantMode = m)" />

            <SectionSelect Node="Node" Def="Def" />
        </MudTabPanel>

        @* --- Variable mapping --- *@
        <MudTabPanel Text="Variable mapping" Icon="@Icons.Material.Filled.SwapHoriz">
            <MudText Typo="Typo.caption" Class="mud-text-secondary mb-1">
                Inputs are resolved when the task is opened (so the form shows the current state); outputs map the
                form result (for the generic form: the field names) onto variables. An output may also be a
                <b>path</b> — into a result value (<code>order.Number</code>) or into a payload value
                (<code>consultant.EMail</code>), which is how a value from the form's own data reaches a variable.
                A payload value without a path stays out: it can be a value handle, and variables are persisted.
            </MudText>
            <BindingMappingTables Inputs="Node.Inputs" Outputs="Node.Outputs"
                                  InputsTitle="Form inputs (payload)" OutputsTitle="Form outputs"
                                  AddInputLabel="Add payload value" AddOutputLabel="Add output"
                                  InputNameHeader="Payload name" InputNameLabel="Payload name"
                                  OutputSourceLabel="Field, result or path" OutputTargetLabel="Variable"
                                  AllowValueHandle="true" HandleDeliveryUsable="false" />

            @* Was zurueckgeschrieben wird, steht nur EINMAL da: hier stehen die Parameter, wohin im
               Datensatz sagt der Feld-Pfad - und der ist zugleich das Lese-Ziel. *@
            <MudText Typo="Typo.subtitle2" Class="mt-4">Write back to the value handler</MudText>
            <MudText Typo="Typo.caption" Class="mud-text-secondary">
                Which payload values go back to their handler when the task is completed. <b>Where</b> in the
                record they go is the field path itself (see the form fields) — so what the mask shows is what
                it writes back, and there is no second mapping table to keep in step. Written once, inside the
                completion, after all checks.
            </MudText>
            @foreach (string parameter in HandleParameters())
            {
                <MudSwitch T="bool" Color="Color.Primary"
                           Value="@Node.WriteBackParameters.Contains(parameter)"
                           ValueChanged="@(v => SetWriteBack(parameter, v))"
                           Label="@parameter" />
            }
            @if (!HandleParameters().Any())
            {
                <MudText Typo="Typo.caption" Class="mud-text-secondary">
                    No payload value comes from a value handler yet — nothing to write back.
                </MudText>
            }

            <ScopeModeSection Mode="Node.ScopeMode" ModeChanged="@(m => Node.ScopeMode = m)"
                              RetainVariables="Node.RetainVariables"
                              SwitchLabel="Consolidate scope (replace)"
                              HelperText="@("After the task the scope consists of exactly the mapped results plus the variables kept here.")" />
        </MudTabPanel>

        @* --- View settings --- *@
        <MudTabPanel Text="View settings" Icon="@Icons.Material.Filled.Visibility">
            <MudTextField @bind-Value="Node.ViewKey" Label="View key" Margin="Margin.Dense"
                          HelperText="Optional: the key of a component the host registered. Empty = the task key is tried, then the generic form." />

            @* Titel und Beschreibung sind mehrsprachig (Kultur-JSON) - deshalb als JSON-Editor. *@
            <MudText Typo="Typo.caption" Class="mt-3">Title (plain text or culture JSON)</MudText>
            <MudText Typo="Typo.caption" Class="mud-text-secondary">@CultureHint</MudText>
            <CScriptField @ref="titleJsonField" Language="json" Height="90" Value="@Node.Title"
                          ValueChanged="@(v => Node.Title = v)" />

            <MudText Typo="Typo.caption" Class="mt-3">Description (plain text or culture JSON)</MudText>
            <MudText Typo="Typo.caption" Class="mud-text-secondary">@CultureHint</MudText>
            <CScriptField @ref="descField" Language="json" Height="90" Value="@Node.Description"
                          ValueChanged="@(v => Node.Description = v)" />

            @* Format data: EIN Datenobjekt fuer die Formatierung von Titel UND Beschreibung. *@
            <MudText Typo="Typo.caption" Class="mt-3">Format data (CScript object for title &amp; description)</MudText>
            <MudText Typo="Typo.caption" Class="mud-text-secondary">
                Optional. Returns an object whose members fill placeholders in <b>title and description</b> —
                for a text like <code>Invoice [InvoiceNo:0000000000]</code>.
                An object literal must not <b>start</b> the expression (there a <code>{</code> would open a
                block), so write it as an assignment: <code>x = { InvoiceNo: invoiceNumber }</code> — or use
                the <i>Script block</i> mode with <code>return { … };</code>. The helper name is irrelevant and
                is thrown away: expressions are evaluated against a copy of the variables. Gets it wrong and
                title and description stay as the raw pattern — the reason lands in the log and in the instance
                history. Empty = title and description are shown as-is.
            </MudText>
            <MudText Typo="Typo.caption" Class="mud-text-secondary">
                <b>When it is evaluated:</b> for the <b>title</b> once, when the task appears — it is frozen
                into the work list with the values of that moment. For the <b>description</b> every time the
                task is opened, so it shows the current state. Multilingual texts stay multilingual: every
                culture is formatted as its own prototype.
            </MudText>
            <CScriptField @ref="formatDataField" Height="120" Value="@Node.FormatData"
                          ValueChanged="@(v => Node.FormatData = v)"
                          Mode="Node.FormatDataMode" ModeChanged="@(m => Node.FormatDataMode = m)" />
        </MudTabPanel>

        @* --- Input settings (generische Maske) --- *@
        <MudTabPanel Text="Input settings" Icon="@Icons.Material.Filled.ListAlt">
            <MudText Typo="Typo.caption" Class="mud-text-secondary mb-2">
                The generic form — only used when no component is registered for this task. No fields = the task
                is just confirmed.
            </MudText>
            <MudTable Items="@Node.FormFields" Hover="true" Dense="true" Breakpoint="Breakpoint.Sm"
                      RowsPerPageOptions="@(new[] { 5, 10, 25 })">
                <ToolBarContent>
                    <MudButton StartIcon="@Icons.Material.Filled.Add" Size="Size.Small" Variant="Variant.Outlined"
                               Color="Color.Primary" OnClick="AddField">Add field</MudButton>
                    <MudSpacer />
                </ToolBarContent>
                <HeaderContent>
                    <MudTh>Field name</MudTh>
                    <MudTh>Type</MudTh>
                    <MudTh Style="width:1%"></MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="Field name">@context.Name</MudTd>
                    <MudTd DataLabel="Type">@context.Kind</MudTd>
                    <MudTd>
                        <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small"
                                       OnClick="@(() => EditField(context))" />
                    </MudTd>
                </RowTemplate>
                <PagerContent>
                    <MudTablePager />
                </PagerContent>
            </MudTable>
        </MudTabPanel>
    </MudTabs>
}

@code {
    /// <summary>Der zu konfigurierende Aufgaben-Knoten.</summary>
    [Parameter] public UserActivityNode? Node { get; set; }

    /// <summary>Die Definition - fuer die Abschnitts-Zuordnung.</summary>
    [Parameter] public WorkflowDefinition? Def { get; set; }

    private const string CultureHint =
        "Plain text, or a per-culture record like {\"de\":\"Freigabe\",\"fr\":\"Approbation\"} — the same convention as navigation entries.";

    /// <summary>Die Payload-Parameter, die von einem Wert-Handler kommen - nur die koennen zurueck.</summary>
    private IEnumerable<string> HandleParameters()
        => Node?.Inputs?
               .Where(b => b is { Kind: ParameterBindingKind.ValueHandle }
                           && !string.IsNullOrWhiteSpace(b.Parameter))
               .Select(b => b.Parameter!)
               .Distinct()
           ?? Enumerable.Empty<string>();

    /// <summary>Nimmt einen Parameter in die Rueckschreib-Liste auf oder wieder heraus.</summary>
    private void SetWriteBack(string parameter, bool writeBack)
    {
        if (Node is null)
        {
            return;
        }

        Node.WriteBackParameters ??= new List<string>();
        if (writeBack)
        {
            if (!Node.WriteBackParameters.Contains(parameter))
            {
                Node.WriteBackParameters.Add(parameter);
            }
        }
        else
        {
            Node.WriteBackParameters.Remove(parameter);
        }
    }

    private CScriptField? assignField;
    private CScriptField? titleJsonField;
    private CScriptField? descField;
    private CScriptField? formatDataField;
    private CScriptField? endsAssistantField;

    /// <summary>
    /// Holt den aktuellen Text der Monaco-Felder (Assignment, EndsAssistant, Title, Description, FormatData)
    /// ins Modell. Monaco meldet seinen Wert erst beim Verlassen - der Editor ruft dies vor jedem
    /// Speichern/Schliessen.
    /// </summary>
    public async Task FlushAsync()
    {
        if (Node is null)
        {
            return;
        }

        if (assignField is not null)
        {
            Node.Assignment = await assignField.GetValueAsync();
        }

        if (endsAssistantField is not null)
        {
            Node.EndsAssistant = await endsAssistantField.GetValueAsync();
        }

        if (titleJsonField is not null)
        {
            Node.Title = await titleJsonField.GetValueAsync();
        }

        if (descField is not null)
        {
            Node.Description = await descField.GetValueAsync();
        }

        if (formatDataField is not null)
        {
            Node.FormatData = await formatDataField.GetValueAsync();
        }
    }

    private async Task AddField()
    {
        if (Node is null)
        {
            return;
        }

        var fresh = new UserTaskField();
        var result = await ShowFieldDialog(fresh, isNew: true);
        if (result is { Delete: false } && !string.IsNullOrWhiteSpace(result.Field.Name)
            && !Node.FormFields.Any(f => string.Equals(f.Name, result.Field.Name, StringComparison.OrdinalIgnoreCase)))
        {
            Node.FormFields.Add(result.Field);
        }
    }

    private async Task EditField(UserTaskField field)
    {
        if (Node is null)
        {
            return;
        }

        int idx = Node.FormFields.IndexOf(field);
        if (idx < 0)
        {
            return;
        }

        var result = await ShowFieldDialog(Clone(field), isNew: false);
        if (result is null)
        {
            return;
        }

        if (result.Delete)
        {
            Node.FormFields.RemoveAt(idx);
        }
        else if (!string.IsNullOrWhiteSpace(result.Field.Name))
        {
            Node.FormFields[idx] = result.Field;
        }
    }

    private async Task<UserTaskFieldEditDialog.Result?> ShowFieldDialog(UserTaskField field, bool isNew)
    {
        var parameters = new DialogParameters
        {
            { nameof(UserTaskFieldEditDialog.Field), field },
            { nameof(UserTaskFieldEditDialog.IsNew), isNew }
        };
        var options = new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true, CloseOnEscapeKey = true };
        IDialogReference dialog = await DialogService.ShowAsync<UserTaskFieldEditDialog>(string.Empty, parameters, options);
        DialogResult? result = await dialog.Result;
        return result?.Data as UserTaskFieldEditDialog.Result;
    }

    private static UserTaskField Clone(UserTaskField f) => new()
    {
        Name = f.Name,
        Label = f.Label,
        Kind = f.Kind,
        Required = f.Required,
        ReadOnly = f.ReadOnly,
        PayloadName = f.PayloadName,
        HelpText = f.HelpText,
        Choices = f.Choices?.Select(c => new UserTaskChoice { Value = c.Value, Label = c.Label }).ToList()
                  ?? new List<UserTaskChoice>()
    };
}
