@namespace ITVComponents.WebCoreToolkit.Blazor.SharedComponents
@typeparam TKey
@implements IDisposable

@using ITVComponents.EFRepo.Helpers
@using ITVComponents.WebCoreToolkit.EntityFramework.Extensions
@using ITVComponents.WebCoreToolkit.EntityFramework.Models
@using Microsoft.Extensions.Logging

@inject IServiceProvider Services
@inject ILogger<ForeignKeyNameAutocomplete<TKey>> Logger

@* Wie <ForeignKeyAutocomplete/>, aber der gebundene Wert ist das LABEL (der Name), nicht der numerische
   Schlüssel. Für portable Referenzen, die den Namen speichern müssen: z.B. eine Workflow-Definition
   verweist auf eine Permission über deren NAMEN (der über Umgebungen stabil ist), nicht über die Id.
   Lädt die volle Liste einmal (Label als Wert und Anzeige) und aktualisiert sie über den
   EntityWriteTracker, wenn die Quelle geschrieben wird. CoerceValue lässt einen bereits gespeicherten
   Wert stehen, auch wenn er (noch) nicht in der Liste ist. *@

<MudAutocomplete T="string" Value="Value" ValueChanged="ValueChanged" SearchFunc="DoSearch"
                 Label="@Label" Required="@Required" Clearable="@Clearable" Disabled="@Disabled"
                 ResetValueOnEmptyText="false" CoerceText="false" CoerceValue="true"
                 DebounceInterval="@DebounceMilliseconds" />

@code {
    /// <summary>Der gebundene Wert = der ausgewählte Name (Label), nicht der Schlüssel.</summary>
    [Parameter] public string Value { get; set; } = default!;

    [Parameter] public EventCallback<string> ValueChanged { get; set; }
    [Parameter] public string Label { get; set; } = string.Empty;

    /// <summary>Name des DbContext-Plugins (FK-Quelle). Default "sys".</summary>
    [Parameter] public string Connection { get; set; } = "sys";

    /// <summary>Der Name der FK-Quelle (Tabelle), z.B. "Permissions".</summary>
    [Parameter, EditorRequired] public string Table { get; set; } = string.Empty;

    [Parameter] public bool Required { get; set; }
    [Parameter] public bool Clearable { get; set; } = true;
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public int DebounceMilliseconds { get; set; } = 300;

    private readonly List<string> _names = new();
    private IEntityWriteTracker? _tracker;

    protected override async Task OnInitializedAsync()
    {
        await Task.Yield();
        try
        {
            await LoadAllAsync();
            _tracker = Services.TrackerForContext(Connection, null);
            if (_tracker != null)
            {
                _tracker.TablesWritten += OnTablesWritten;
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error occurred while initializing ForeignKeyNameAutocomplete.");
        }
    }

    private Task LoadAllAsync()
    {
        _names.Clear();
        var src = Services.ContextForFkQuery(Connection, null);
        if (src is null)
        {
            return Task.CompletedTask;
        }

        var raw = src.ReadForeignKey<TKey>(Table);
        foreach (var obj in raw)
        {
            if (string.IsNullOrEmpty(obj.Label) || _names.Contains(obj.Label))
            {
                continue;
            }

            _names.Add(obj.Label);
        }

        return Task.CompletedTask;
    }

    private Task<IEnumerable<string>> DoSearch(string text, CancellationToken ct)
    {
        text ??= string.Empty;
        return Task.FromResult<IEnumerable<string>>(
            _names.Where(n => string.IsNullOrEmpty(text) || n.Contains(text, StringComparison.OrdinalIgnoreCase)));
    }

    private void OnTablesWritten(string[] tables)
    {
        if (tables.All(table => !string.Equals(table, Table, StringComparison.OrdinalIgnoreCase)))
        {
            return;
        }

        // Der Tracker feuert auf dem Thread des Schreibers (evtl. ein anderer Circuit) → auf unseren holen.
        _ = InvokeAsync(async () =>
        {
            try
            {
                await LoadAllAsync();
            }
            catch (Exception ex)
            {
                Logger.LogError(ex, "Error reloading ForeignKeyNameAutocomplete options for table {Table}", Table);
            }

            StateHasChanged();
        });
    }

    public void Dispose()
    {
        if (_tracker != null)
        {
            _tracker.TablesWritten -= OnTablesWritten;
        }
    }
}
