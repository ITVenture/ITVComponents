@using ITVComponents.WebCoreToolkit.TenantSecurityViews.Blazor.Components.Permissions
@using ITVComponents.WebCoreToolkit.TenantSecurityViews.Blazor.Components.Roles
@using ITVComponents.WebCoreToolkit.TenantSecurityViews.Blazor.Components.PlugIns
@using ITVComponents.WebCoreToolkit.TenantSecurityViews.Blazor.Components.Sequences
@using ITVComponents.WebCoreToolkit.TenantSecurityViews.Blazor.Handlers
@using Microsoft.Extensions.DependencyInjection

@inject IServiceProvider Services

<MudDialog>
    <DialogContent>
        <MudTabs Elevation="0" Rounded="true" Outlined="true" PanelClass="pa-2">
            <MudTabPanel Text="Settings">
                <TenantSettingsGrid TenantId="@Tenant.TenantId" />
            </MudTabPanel>
            <MudTabPanel Text="Feature activations">
                <TenantFeatureActivationsGrid TenantId="@Tenant.TenantId" />
            </MudTabPanel>
            <MudTabPanel Text="Navigation">
                <TenantNavigationGrid TenantId="@Tenant.TenantId" />
            </MudTabPanel>
            <MudTabPanel Text="Permissions">
                <Permissions EmbeddedTenantId="@Tenant.TenantId" />
            </MudTabPanel>
            <MudTabPanel Text="Roles">
                <Roles EmbeddedTenantId="@Tenant.TenantId" />
            </MudTabPanel>
            @if (usersGridType is not null)
            {
                <MudTabPanel Text="Users">
                    <DynamicComponent Type="usersGridType" Parameters="usersGridParameters" />
                </MudTabPanel>
            }
            <MudTabPanel Text="Plug-ins">
                <PlugIns EmbeddedTenantId="@Tenant.TenantId" />
            </MudTabPanel>
            <MudTabPanel Text="Plug-in constants">
                <PlugInConstants EmbeddedTenantId="@Tenant.TenantId" />
            </MudTabPanel>
            <MudTabPanel Text="Sequences">
                <Sequences EmbeddedTenantId="@Tenant.TenantId" />
            </MudTabPanel>
        </MudTabs>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Close">Close</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;
    [Parameter, EditorRequired] public TenantViewModel Tenant { get; set; } = default!;

    private Type? usersGridType;
    private IDictionary<string, object> usersGridParameters = new Dictionary<string, object>();

    protected override void OnParametersSet()
    {
        usersGridType = Services.GetService<TenantUsersGridDescriptor>()?.GridComponentType;
        usersGridParameters = new Dictionary<string, object> { ["TenantId"] = Tenant.TenantId };
    }

    private void Close() => MudDialog.Close();
}
