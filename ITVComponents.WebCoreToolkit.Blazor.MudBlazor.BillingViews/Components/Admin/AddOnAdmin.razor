@page "/Billing/AddOns"
@rendermode @(RenderMode.InteractiveServer)
@attribute [Microsoft.AspNetCore.Authorization.Authorize]

@inject IBillingHandler Handler
@inject AuthenticationStateProvider AuthState
@inject ISnackbar Snackbar

<PageTitle>Add-ons</PageTitle>

<MudText Typo="Typo.h5" GutterBottom="true">Add-ons</MudText>

@if (currentUser is null)
{
    <MudProgressCircular Indeterminate="true" />
}
else if (!canAdmin)
{
    <MudAlert Severity="Severity.Warning">You don't have permission to manage add-ons.</MudAlert>
}
else
{
    <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" Class="mb-3" OnClick="@(() => Edit(new AddOnViewModel()))">
        New add-on
    </MudButton>

    <MudTable Items="addOns" Dense="true" Hover="true">
        <HeaderContent>
            <MudTh>Name</MudTh>
            <MudTh>Price</MudTh>
            <MudTh>Interval</MudTh>
            <MudTh>Active</MudTh>
            <MudTh>Provider price</MudTh>
            <MudTh></MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="Name">@context.Name</MudTd>
            <MudTd DataLabel="Price">@PriceSummary(context)</MudTd>
            <MudTd DataLabel="Interval">@context.BillingInterval</MudTd>
            <MudTd DataLabel="Active">@(context.IsActive ? "yes" : "no")</MudTd>
            <MudTd DataLabel="Provider price">@PushSummary(context)</MudTd>
            <MudTd>
                <MudStack Row="true" Spacing="1">
                    <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" OnClick="@(() => Edit(context))" />
                    <MudButton Size="Size.Small" StartIcon="@Icons.Material.Filled.CloudUpload" Disabled="@busy" OnClick="@(() => Push(context.AddOnId))">
                        Push to provider
                    </MudButton>
                </MudStack>
            </MudTd>
        </RowTemplate>
    </MudTable>

    @if (editModel is not null)
    {
        <MudPaper Class="pa-4 mt-4" Outlined="true">
            <MudText Typo="Typo.h6">@(editModel.AddOnId == 0 ? "New add-on" : $"Edit {editModel.Name}")</MudText>
            <MudGrid>
                <MudItem xs="12" sm="6"><MudTextField @bind-Value="editModel.Name" Label="Name" Required="true" /></MudItem>
                <MudItem xs="12" sm="6"><MudTextField @bind-Value="editModel.Description" Label="Description" /></MudItem>
                <MudItem xs="6" sm="3">
                    <MudSelect T="BillingInterval" @bind-Value="editModel.BillingInterval" Label="Interval">
                        @foreach (var interval in System.Enum.GetValues<BillingInterval>())
                        {
                            <MudSelectItem T="BillingInterval" Value="@interval">@interval</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
                <MudItem xs="12"><MudTextField @bind-Value="featureKeysText" Label="Feature keys (comma-separated)" /></MudItem>
                <MudItem xs="12"><MudCheckBox T="bool" @bind-Value="editModel.IsActive" Label="Active" /></MudItem>

                <MudItem xs="12">
                    <MudText Typo="Typo.subtitle2" Class="mt-2">Prices per currency</MudText>
                    @foreach (var price in editModel.Prices)
                    {
                        <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center" Class="my-1">
                            <MudTextField @bind-Value="price.Currency" Label="Currency" Style="max-width:120px" Immediate="true" />
                            <MudNumericField T="decimal" @bind-Value="price.Amount" Label="Amount" Style="max-width:160px" />
                            <MudText Typo="Typo.caption">@(string.IsNullOrEmpty(price.ProviderPriceId) ? "not pushed" : price.ProviderPriceId)</MudText>
                            <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" OnClick="@(() => editModel.Prices.Remove(price))" />
                        </MudStack>
                    }
                    <MudButton Size="Size.Small" StartIcon="@Icons.Material.Filled.Add" OnClick="AddPrice">Add price</MudButton>
                </MudItem>
            </MudGrid>
            <MudStack Row="true" Spacing="2" Class="mt-2">
                <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="@busy" OnClick="Save">Save</MudButton>
                <MudButton Variant="Variant.Text" OnClick="@(() => editModel = null)">Cancel</MudButton>
            </MudStack>
        </MudPaper>
    }
}

@code {
    private System.Security.Claims.ClaimsPrincipal? currentUser;
    private bool canAdmin;
    private bool busy;
    private IReadOnlyList<AddOnViewModel> addOns = System.Array.Empty<AddOnViewModel>();
    private AddOnViewModel? editModel;
    private string featureKeysText = "";

    protected override async Task OnInitializedAsync()
    {
        var auth = await AuthState.GetAuthenticationStateAsync();
        currentUser = auth.User;
        canAdmin = Handler.CanAdminister(currentUser);
        if (canAdmin)
        {
            await Reload();
        }
    }

    private async Task Reload() => addOns = await Handler.GetAllAddOnsAsync();

    private void Edit(AddOnViewModel model)
    {
        editModel = new AddOnViewModel
        {
            AddOnId = model.AddOnId,
            Name = model.Name,
            Description = model.Description,
            BillingInterval = model.BillingInterval,
            IsActive = model.IsActive,
            Prices = model.Prices.Select(p => new PriceViewModel { Currency = p.Currency, Amount = p.Amount, ProviderPriceId = p.ProviderPriceId }).ToList(),
            FeatureKeys = new List<string>(model.FeatureKeys)
        };
        featureKeysText = string.Join(", ", editModel.FeatureKeys);
    }

    private void AddPrice() => editModel?.Prices.Add(new PriceViewModel { Currency = "EUR" });

    private string PriceSummary(AddOnViewModel addOn)
        => addOn.Prices.Count == 0 ? "—" : string.Join(", ", addOn.Prices.Select(p => $"{p.Amount:0.00} {p.Currency.ToUpperInvariant()}"));

    private string PushSummary(AddOnViewModel addOn)
        => addOn.Prices.Count == 0 ? "—" : $"{addOn.Prices.Count(p => !string.IsNullOrEmpty(p.ProviderPriceId))}/{addOn.Prices.Count}";

    private async Task Save()
    {
        if (editModel is null)
        {
            return;
        }

        editModel.FeatureKeys = featureKeysText
            .Split(',', System.StringSplitOptions.RemoveEmptyEntries | System.StringSplitOptions.TrimEntries)
            .ToList();

        busy = true;
        try
        {
            await Handler.SaveAddOnAsync(editModel);
            Snackbar.Add("Add-on saved", Severity.Success);
            editModel = null;
            await Reload();
        }
        catch (System.Exception ex)
        {
            Snackbar.Add($"Save failed: {ex.Message}", Severity.Error);
        }
        finally
        {
            busy = false;
        }
    }

    private async Task Push(int addOnId)
    {
        busy = true;
        try
        {
            await Handler.PushAddOnAsync(addOnId);
            Snackbar.Add("Pushed to provider", Severity.Success);
            await Reload();
        }
        catch (System.Exception ex)
        {
            Snackbar.Add($"Push failed: {ex.Message}", Severity.Error);
        }
        finally
        {
            busy = false;
        }
    }
}
