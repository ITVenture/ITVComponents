@inject ISnackbar Snackbar

<MudDialog>
    <DialogContent>
        <MudForm @ref="form" Model="Model">
            @if (IsCreate)
            {
                <MudNumericField @bind-Value="Model.TenantId" Label="Tenant ID" Required="true" Min="1" />
            }
            else
            {
                <MudTextField Value="@($"{Model.TenantDisplayName} (#{Model.TenantId})")" Label="Tenant" Disabled="true" />
            }
            <MudDatePicker Date="Model.ActivationStart" DateChanged="@(d => Model.ActivationStart = d)"
                           Label="Activation start" Clearable="true" />
            <MudDatePicker Date="Model.ActivationEnd" DateChanged="@(d => Model.ActivationEnd = d)"
                           Label="Activation end" Clearable="true" />
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Cancel</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="Save">@(IsCreate ? "Create" : "Save")</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;
    [Parameter, EditorRequired] public FeatureActivationViewModel Model { get; set; } = default!;
    [Parameter] public bool IsCreate { get; set; }

    private MudForm? form;

    private async Task Save()
    {
        if (form is null) return;
        await form.Validate();
        if (!form.IsValid) { Snackbar.Add("Please correct invalid fields", Severity.Warning); return; }
        MudDialog.Close(DialogResult.Ok(Model));
    }

    private void Cancel() => MudDialog.Cancel();
}
