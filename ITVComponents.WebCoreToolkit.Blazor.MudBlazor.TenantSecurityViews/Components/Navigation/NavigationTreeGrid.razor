@inject INavigationAdminHandler Handler
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject IJSRuntime JS
@implements IAsyncDisposable

<div @ref="hostEl" data-nav-dnd-host="@hostId">
<MudDataGrid T="NavigationMenuViewModel"
             @ref="grid"
             ServerData="LoadData"
             SortMode="SortMode.None"
             RowsPerPage="25"
             Hover="true"
             Dense="true">
    <ToolBarContent>
        <RefreshButton OnClick="ReloadGrid" />
        <MudText Typo="Typo.subtitle1">@(ParentId is null ? "Top level" : "Child items")</MudText>
        <MudSpacer />
        <MudTextField @bind-Value="search"
                      Placeholder="Search…"
                      Adornment="Adornment.Start"
                      AdornmentIcon="@Icons.Material.Filled.Search"
                      IconSize="Size.Medium"
                      Class="mt-0"
                      DebounceInterval="300"
                      OnDebounceIntervalElapsed="ReloadGrid" />
        @if (HasWrite)
        {
            <MudButton StartIcon="@Icons.Material.Filled.Add" Variant="Variant.Filled" Color="Color.Primary" Class="ml-2" OnClick="OpenCreate">
                Add item
            </MudButton>
        }
    </ToolBarContent>
    <Columns>
        @if (HasWrite)
        {
            <TemplateColumn T="NavigationMenuViewModel" Title="" Sortable="false">
                <CellTemplate>
                    @* Single drag/drop cell — source AND target. JS picks above/into/below from mouse-Y. *@
                    <span draggable="true"
                          data-nav-dnd-id="@context.Item.NavigationMenuId"
                          title="Drag to reorder or to move under another parent"
                          style="display:inline-flex;align-items:center;padding:0 4px;">
                        <MudIcon Icon="@Icons.Material.Filled.DragIndicator" Size="Size.Small" />
                    </span>
                </CellTemplate>
            </TemplateColumn>
        }
        <HierarchyColumn T="NavigationMenuViewModel" ButtonDisabledFunc="@(item => item.ChildCount == 0)" />
        <PropertyColumn Property="x => x.DisplayName" Title="Name" />
        <PropertyColumn Property="x => x.Url" Title="URL" />
        <PropertyColumn Property="x => x.SortOrder" Title="Sort" />
        <PropertyColumn Property="x => x.IsPublic" Title="Public" />
        <TemplateColumn T="NavigationMenuViewModel" Title="" Sortable="false">
            <CellTemplate>
                @if (HasWrite)
                {
                    <MudStack Row="true" Spacing="1">
                        <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" OnClick="@(() => OpenEdit(context.Item))" />
                        <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error" OnClick="@(() => Delete(context.Item))" />
                    </MudStack>
                }
            </CellTemplate>
        </TemplateColumn>
    </Columns>
    <ChildRowContent>
        <MudPaper Elevation="0" Class="pa-2 ml-4">
            @* Pass OnDataChanged straight through (no self-reload). This bubbles only the page-level
               choices refresh upward; it deliberately does NOT reload ancestor grids, so their
               expansion state is preserved when a drop happens in a descendant. *@
            <NavigationTreeGrid ParentId="@context.Item.NavigationMenuId"
                                CurrentUser="@CurrentUser"
                                HasWrite="@HasWrite"
                                AllParents="@AllParents"
                                AllTenants="@AllTenants"
                                OnDataChanged="@OnDataChanged" />
        </MudPaper>
    </ChildRowContent>
    <PagerContent>
        <MudDataGridPager T="NavigationMenuViewModel" />
    </PagerContent>
</MudDataGrid>
</div>

@code {
    [Parameter] public int? ParentId { get; set; }
    [Parameter, EditorRequired] public System.Security.Claims.ClaimsPrincipal CurrentUser { get; set; } = default!;
    [Parameter] public bool HasWrite { get; set; }
    [Parameter] public IReadOnlyList<NavigationParentChoice> AllParents { get; set; } = Array.Empty<NavigationParentChoice>();
    [Parameter] public IReadOnlyList<TenantChoice> AllTenants { get; set; } = Array.Empty<TenantChoice>();
    [Parameter] public EventCallback OnDataChanged { get; set; }

    private MudDataGrid<NavigationMenuViewModel>? grid;
    private string? search;

    private ElementReference hostEl;
    private readonly string hostId = Guid.NewGuid().ToString("N");
    private DotNetObjectReference<NavigationTreeGrid>? selfRef;
    private bool jsAttached;

    private async Task<GridData<NavigationMenuViewModel>> LoadData(GridState<NavigationMenuViewModel> state, CancellationToken ct)
    {
        var query = new ListQuery
        {
            Page = state.Page,
            PageSize = state.PageSize,
            Search = search
        };
        var result = await Handler.ListAsync(CurrentUser, ParentId, query);
        return new GridData<NavigationMenuViewModel> { Items = result.Items, TotalItems = result.TotalCount };
    }

    private async Task ReloadGrid()
    {
        if (grid is not null) await grid.ReloadServerData();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && HasWrite && !jsAttached)
        {
            selfRef = DotNetObjectReference.Create(this);
            try
            {
                // Side-effect import — first call fetches and runs the helper (installs
                // document-level listeners + window.itvNavDnd); subsequent calls hit the
                // module cache. _content path matches this assembly's name.
                await JS.InvokeAsync<IJSObjectReference>("import",
                    "./_content/ITVComponents.WebCoreToolkit.Blazor.MudBlazor.TenantSecurityViews/navigation-dnd.js");
                await JS.InvokeVoidAsync("itvNavDnd.attach", hostEl, selfRef);
                jsAttached = true;
            }
            catch (Microsoft.JSInterop.JSDisconnectedException) { /* circuit gone */ }
            catch { /* swallow — grid stays usable without DnD */ }
        }
    }

    [JSInvokable]
    public async Task HandleDrop(int draggedId, int anchorId, string zone)
    {
        if (!HasWrite) return;
        var anchor = zone switch
        {
            "above" => NavigationMoveAnchor.Above,
            "below" => NavigationMoveAnchor.Below,
            _ => NavigationMoveAnchor.Into
        };
        var ok = await Handler.MoveAsync(CurrentUser, draggedId, anchorId, anchor);
        if (ok)
        {
            Snackbar.Add("Navigation item moved", Severity.Success);
            await ReloadGrid();
            if (OnDataChanged.HasDelegate) await OnDataChanged.InvokeAsync();
        }
        else
        {
            Snackbar.Add("Move not allowed (cycle or missing permission)", Severity.Warning);
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (jsAttached)
        {
            try { await JS.InvokeVoidAsync("itvNavDnd.detach", hostEl); }
            catch (Microsoft.JSInterop.JSDisconnectedException) { }
            catch { /* element gone */ }
        }
        selfRef?.Dispose();
    }

    private async Task OpenCreate()
    {
        var parameters = new DialogParameters<NavigationDialog>
        {
            { d => d.Model, new NavigationMenuViewModel { ParentId = ParentId } },
            { d => d.IsCreate, true },
            { d => d.AllParents, AllParents },
            { d => d.AllTenants, AllTenants }
        };
        var dlg = await DialogService.ShowAsync<NavigationDialog>("Create navigation item", parameters, EditDialogDefaults.Edit);
        var result = await dlg.Result;
        if (result is { Canceled: false, Data: NavigationMenuViewModel input })
        {
            var created = await Handler.CreateAsync(CurrentUser, input);
            if (created != null)
            {
                Snackbar.Add("Navigation item created", Severity.Success);
                await ReloadGrid();
                if (OnDataChanged.HasDelegate) await OnDataChanged.InvokeAsync();
            }
            else Snackbar.Add("Failed to create", Severity.Error);
        }
    }

    private async Task OpenEdit(NavigationMenuViewModel item)
    {
        var copy = new NavigationMenuViewModel
        {
            NavigationMenuId = item.NavigationMenuId,
            DisplayName = item.DisplayName,
            Url = item.Url,
            ParentId = item.ParentId,
            SortOrder = item.SortOrder,
            PermissionId = item.PermissionId,
            FeatureId = item.FeatureId,
            SpanClass = item.SpanClass,
            IsPublic = item.IsPublic,
            Tenants = item.Tenants.ToArray(),
            ChildCount = item.ChildCount
        };
        var parameters = new DialogParameters<NavigationDialog>
        {
            { d => d.Model, copy },
            { d => d.IsCreate, false },
            { d => d.AllParents, AllParents },
            { d => d.AllTenants, AllTenants }
        };
        var dlg = await DialogService.ShowAsync<NavigationDialog>("Edit navigation item", parameters, EditDialogDefaults.Edit);
        var result = await dlg.Result;
        if (result is { Canceled: false, Data: NavigationMenuViewModel input })
        {
            var updated = await Handler.UpdateAsync(CurrentUser, input);
            if (updated != null)
            {
                Snackbar.Add("Navigation item updated", Severity.Success);
                await ReloadGrid();
                if (OnDataChanged.HasDelegate) await OnDataChanged.InvokeAsync();
            }
            else Snackbar.Add("Failed to update", Severity.Error);
        }
    }

    private async Task Delete(NavigationMenuViewModel item)
    {
        var ok = await DialogService.ShowMessageBoxAsync("Delete navigation item", $"Really delete '{item.DisplayName}'?", yesText: "Delete", cancelText: "Cancel");
        if (ok != true) return;
        var success = await Handler.DeleteAsync(CurrentUser, item.NavigationMenuId);
        if (success)
        {
            Snackbar.Add("Navigation item deleted", Severity.Success);
            await ReloadGrid();
            if (OnDataChanged.HasDelegate) await OnDataChanged.InvokeAsync();
        }
        else Snackbar.Add("Failed to delete", Severity.Error);
    }
}
