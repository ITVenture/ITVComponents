@using ITVComponents.WebCoreToolkit.Models

<EditDialogShell Model="Model" IsCreate="IsCreate" CreateLabel="Add">
    <MudTextField @bind-Value="Model.PropertyName" Label="Name" Required="true" RequiredError="Name is required" />
    <MudTextField @bind-Value="Model.Value" Label="Value" Required="true" RequiredError="Value is required" Lines="3" />
    <MudSelect T="CustomUserPropertyType" @bind-Value="Model.PropertyType" Label="Type">
        @foreach (var t in Enum.GetValues<CustomUserPropertyType>())
        {
            <MudSelectItem Value="t">@t</MudSelectItem>
        }
    </MudSelect>
</EditDialogShell>

@code {
    [Parameter, EditorRequired] public CustomUserPropertyViewModel Model { get; set; } = default!;
    [Parameter] public bool IsCreate { get; set; }
}
