@inject ISnackbar Snackbar

<MudDialog>
    <DialogContent>
        <MudForm @ref="form" Model="Model">
            <MudGrid Spacing="2">
                <MudItem xs="12">
                    <MudTextField @bind-Value="Model.EMail" Label="Email" Required="true" For="@(() => Model.EMail)" />
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudTextField @bind-Value="Model.FirstName" Label="First name" For="@(() => Model.FirstName)" />
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudTextField @bind-Value="Model.LastName" Label="Last name" For="@(() => Model.LastName)" />
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudSelect T="InvitationStatus" @bind-Value="Model.InvitationStatus" Label="Status">
                        @foreach (var st in System.Enum.GetValues<InvitationStatus>())
                        {
                            <MudSelectItem T="InvitationStatus" Value="@st">@st</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
            </MudGrid>
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Cancel</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="Save">Save</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;
    [Parameter, EditorRequired] public EmployeeViewModel Model { get; set; } = default!;

    private MudForm? form;

    private async Task Save()
    {
        if (form is null) return;
        await form.Validate();
        if (!form.IsValid) { Snackbar.Add("Please correct invalid fields", Severity.Warning); return; }
        MudDialog.Close(DialogResult.Ok(Model));
    }

    private void Cancel() => MudDialog.Cancel();
}
