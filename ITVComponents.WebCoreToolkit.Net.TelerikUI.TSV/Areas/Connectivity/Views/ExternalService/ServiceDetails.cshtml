@using ITVComponents.WebCoreToolkit.Net.TelerikUi.TenantSecurityViews.Resources
@using Kendo.Mvc.UI
@{
    var id = ViewData["OAuthServiceId"];
    var nm = $"TenantDetailsTab{id}";
}

@(Html.Kendo().TabStrip()
    .Name(nm)
    .SelectedIndex(0)
    .Items(item =>
    {
        item.Add().Text(TextsAndMessagesHelper.IWCN_ES_DetailsTitle_Params).LoadContentFrom("ServiceDetailInfoTable", "ExternalService", new { area = "Connectivity", oauthServiceId = ViewData["OAuthServiceId"] });
        if (ViewData["IsConnected"] is true)
        {
            item.Add().Text(TextsAndMessagesHelper.IWCN_ES_DetailsTitle_Test).LoadContentFrom("TestForm", "ExternalService", new {area="Connectivity", oauthServiceId = ViewData["OAuthServiceId"] });
        }
    })
)