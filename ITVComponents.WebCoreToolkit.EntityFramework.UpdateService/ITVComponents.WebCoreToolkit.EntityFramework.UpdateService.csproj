<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <Version>5.0.0-PRE275</Version>
    <Authors>mw</Authors>
    <Company>IT-Venture GmbH</Company>
    <Description>The web side of the ITVComponents update service: releases of applications and modules (platform-wide), their packages (file volume or database), the feed the update services read, and the module assignment per client app.</Description>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <Nullable>enable</Nullable>
    <RepositoryUrl>https://github.com/ITVenture/ITVComponents</RepositoryUrl>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.13" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\ITVComponents.UpdateService.Abstractions\ITVComponents.UpdateService.Abstractions.csproj" />
    <ProjectReference Include="..\ITVComponents.WebCoreToolkit.EntityFramework.AgentServices\ITVComponents.WebCoreToolkit.EntityFramework.AgentServices.csproj" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="ITVComponents.WebCoreToolkit.EntityFramework.UpdateService.Test" />
  </ItemGroup>
</Project>
