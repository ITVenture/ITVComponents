        </td>
        <td>@Model.TokenEndpoint</td>
    </tr>
    <tr>
        <td>
            RevocationEndpoint
        </td>
        <td>@Model.RevocationEndpoint</td>
    </tr>
    <tr>
        <td>
            ClientId
        </td>
        <td>@Model.ClientId</td>
    </tr>
    <tr>
        <td>
            ClientSecret
        </td>
        <td>@Model.ClientSecret</td>
    </tr>
    <tr>
        <td>
            Scope
        </td>
        <td>@Model.Scope</td>
    </tr>
    <tr>
        <td>
