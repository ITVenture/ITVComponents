@inject IWorkflowMonitorHandler Handler
@inject AuthenticationStateProvider AuthState

@*
    Nimmt eine fehlgeschlagene Instanz an der Fehlerstelle wieder auf. Der Token steht beim Fault noch
    AKTIV auf seinem Knoten - es wird also nichts zurueckgespult und nichts uebersprungen, sondern genau
    der Schritt wiederholt, der scheiterte. Gezeigt und korrigiert werden die Variablen im Scope EBEN
    DIESES Tokens (in einer parallelen Region der Zweig-Scope) - also genau das, was der Schritt liest.
*@

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">
            <MudIcon Icon="@Icons.Material.Filled.RestartAlt" Class="mr-2" />
            <span>Retry failed workflow</span>
        </MudText>
    </TitleContent>
    <DialogContent>
        @if (info is null)
        {
            <MudProgressCircular Indeterminate="true" />
        }
        else
        {
            <MudAlert Severity="Severity.Error" Dense="true" Class="mb-3">
                @(info.FaultMessage ?? "The instance failed without a message.")
            </MudAlert>

            @if (!info.CanRetry)
            {
                <MudAlert Severity="Severity.Warning">@info.Reason</MudAlert>
            }
            else
            {
                <MudText Typo="Typo.body2">
                    Resumes at <b>@(info.NodeName ?? info.NodeId)</b>@(info.FailedUtc is null
                        ? (MarkupString)""
                        : (MarkupString)$" (failed {info.FailedUtc:g} UTC)"). The step is executed again —
                    nothing before it is repeated.
                </MudText>

                <MudDivider Class="my-3" />
                <MudText Typo="Typo.caption">Data the step will see</MudText>
                <MudText Typo="Typo.caption" Class="mud-text-secondary mb-2">
                    Correct what made it fail. Empty clears the variable; composite values (objects, lists)
                    are shown read-only.
                </MudText>

                <MudTable Items="@rows" Dense="true" Hover="true" Breakpoint="Breakpoint.Sm"
                          RowsPerPageOptions="@(new[] { 10, 25, 50 })">
                    <HeaderContent>
                        <MudTh Style="width:30%">Variable</MudTh>
                        <MudTh>Value</MudTh>
                        <MudTh Style="width:1%"></MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd DataLabel="Variable">
                            <MudText Typo="Typo.body2">@context.Name</MudText>
                            <MudText Typo="Typo.caption" Class="mud-text-secondary">@context.Kind</MudText>
                        </MudTd>
                        <MudTd DataLabel="Value">
                            @if (context.Kind == WorkflowVariableKind.Complex)
                            {
                                <MudText Typo="Typo.caption" Class="mud-text-secondary">@context.Text</MudText>
                            }
                            else if (context.Kind == WorkflowVariableKind.Boolean)
                            {
                                <MudSelect T="string" Value="@context.Text" Dense="true" Margin="Margin.Dense"
                                           ValueChanged="@(v => context.Text = v)">
                                    <MudSelectItem T="string" Value="@("true")">true</MudSelectItem>
                                    <MudSelectItem T="string" Value="@("false")">false</MudSelectItem>
                                </MudSelect>
                            }
                            else
                            {
                                <MudTextField T="string" Value="@context.Text" Margin="Margin.Dense"
                                              ValueChanged="@(v => context.Text = v)" />
                            }
                        </MudTd>
                        <MudTd>
                            @if (context.IsNew)
                            {
                                <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small"
                                               Color="Color.Error" OnClick="@(() => rows.Remove(context))" />
                            }
                            else if (context.Changed)
                            {
                                <MudTooltip Text="@($"was: {context.Original}")">
                                    <MudIcon Icon="@Icons.Material.Filled.Edit" Size="Size.Small" Color="Color.Warning" />
                                </MudTooltip>
                            }
                        </MudTd>
                    </RowTemplate>
                </MudTable>

                @* Der Fehler ist oft eine FEHLENDE Variable - dann muss man eine anlegen koennen. *@
                <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center" Class="mt-2">
                    <MudTextField T="string" @bind-Value="newName" Placeholder="new variable"
                                  Margin="Margin.Dense" Style="max-width:200px" />
                    <MudSelect T="WorkflowVariableKind" @bind-Value="newKind" Dense="true" Margin="Margin.Dense"
                               Style="max-width:150px">
                        <MudSelectItem T="WorkflowVariableKind" Value="WorkflowVariableKind.Text">Text</MudSelectItem>
                        <MudSelectItem T="WorkflowVariableKind" Value="WorkflowVariableKind.Number">Number</MudSelectItem>
                        <MudSelectItem T="WorkflowVariableKind" Value="WorkflowVariableKind.Boolean">Yes/No</MudSelectItem>
                        <MudSelectItem T="WorkflowVariableKind" Value="WorkflowVariableKind.DateTime">Date</MudSelectItem>
                    </MudSelect>
                    <MudIconButton Icon="@Icons.Material.Filled.Add" Size="Size.Small" Color="Color.Primary"
                                   OnClick="AddVariable" />
                </MudStack>
            }
        }

        @if (!string.IsNullOrEmpty(error))
        {
            <MudAlert Severity="Severity.Error" Class="mt-3">@error</MudAlert>
        }
    </DialogContent>
    <DialogActions>
        <DialogMaximizeToggle NormalMaxWidth="MaxWidth.Medium" />
        <MudSpacer />
        <MudButton OnClick="Cancel" Disabled="@retrying">Cancel</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.RestartAlt"
                   OnClick="Retry" Disabled="@(retrying || info is null || !info.CanRetry)">Retry</MudButton>
    </DialogActions>
</MudDialog>

@code {
    /// <summary>Eine bearbeitbare Zeile der Variablen-Tabelle.</summary>
    private sealed class Row
    {
        public string Name { get; init; } = "";
        public string Original { get; init; } = "";
        public string? Text { get; set; }
        public WorkflowVariableKind Kind { get; init; }
        public bool IsNew { get; init; }

        /// <summary>Wurde der Wert angefasst? Nur geaenderte Werte werden ueberhaupt geschickt.</summary>
        public bool Changed => IsNew || !string.Equals(Text ?? string.Empty, Original, StringComparison.Ordinal);
    }

    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;

    /// <summary>Die fehlgeschlagene Instanz.</summary>
    [Parameter] public string InstanceId { get; set; } = default!;

    /// <summary>Die (optional) gewählte Workflow-Umgebung.</summary>
    [Parameter] public string? Environment { get; set; }

    private WorkflowRetryInfo? info;
    private List<Row> rows = new();
    private ClaimsPrincipal? currentUser;
    private string? newName;
    private WorkflowVariableKind newKind = WorkflowVariableKind.Text;
    private string? error;
    private bool retrying;

    protected override async Task OnInitializedAsync()
    {
        AuthenticationState auth = await AuthState.GetAuthenticationStateAsync();
        currentUser = auth.User;
        info = await Handler.GetRetryInfoAsync(currentUser, InstanceId, Environment);
        if (info is null)
        {
            error = "This instance could not be loaded.";
            return;
        }

        rows = info.Variables
            .Select(v => new Row { Name = v.Name, Original = v.Value, Text = v.Value, Kind = v.Kind })
            .ToList();
    }

    private void AddVariable()
    {
        if (string.IsNullOrWhiteSpace(newName)
            || rows.Any(r => string.Equals(r.Name, newName, StringComparison.OrdinalIgnoreCase)))
        {
            return;
        }

        rows.Add(new Row
        {
            Name = newName!.Trim(),
            Original = string.Empty,
            Text = newKind == WorkflowVariableKind.Boolean ? "false" : string.Empty,
            Kind = newKind,
            IsNew = true
        });
        newName = null;
    }

    private async Task Retry()
    {
        if (info is null || !info.CanRetry || retrying)
        {
            return;
        }

        error = null;
        retrying = true;
        try
        {
            // Nur das schicken, was der Benutzer tatsaechlich angefasst hat - sonst wuerde jeder Retry
            // den ganzen Scope neu schreiben und dabei Typen umformen, die niemand aendern wollte.
            var updates = rows
                .Where(r => r.Kind != WorkflowVariableKind.Complex && r.Changed)
                .ToDictionary(r => r.Name, r => WorkflowVariableValue.Parse(r.Text, r.Kind),
                    StringComparer.Ordinal);

            WorkflowRetryResult result = await Handler.RetryAsync(currentUser!, InstanceId, updates, Environment);
            if (!result.Resumed)
            {
                error = result.Error ?? "The instance could not be resumed.";
                return;
            }

            MudDialog.Close(DialogResult.Ok(true));
        }
        finally
        {
            retrying = false;
        }
    }

    private void Cancel() => MudDialog.Cancel();
}
