@using ITVComponents.WebCoreToolkit.Net.Extensions
@using Microsoft.AspNetCore.Mvc.ModelBinding.Metadata
@using System.Text.Encodings.Web
@using System.Collections
@using ITVComponents.WebCoreToolkit.Extensions
@using ITVComponents.WebCoreToolkit.Net.TelerikUi.AdminViews.Extensions
@using ITVComponents.WebCoreToolkit.Net.TelerikUi.AdminViews.Options
@using ITVComponents.WebCoreToolkit.Net.TelerikUi.AdminViews.TenantSecurityViews.Resources
@using ITVComponents.WebCoreToolkit.Net.TelerikUi.AdminViews.TenantSecurityViews.ViewModel
@using ITVComponents.WebCoreToolkit.Net.ViewModel
@using ITVComponents.WebCoreToolkit.Routing
@using Kendo.Mvc.UI
@using Microsoft.Extensions.Options
@inject IOptions<ViewOptions> viewOptions
@{
    Layout = viewOptions.Value.LayoutPage;
}
@{

    ViewBag.Title = TextsAndMessagesHelper.IWCN_Titles_DbResources;
    bool stringsRebuildable = (bool)ViewData["CanResetStrings"];
}

<script src="@("/_content/ITVComponents.WebCoreToolkit.Net.TelerikUi.AdminViews/js/viewScripts.min.js".ExtendUrlWithVersion())"></script>
@(Html.Kendo().Grid<LocalizationViewModel>().Name("DbResourcesList")
        //.HtmlAttributes(new { style = "width:50vw;" })
        .Columns(columns =>
        {
            columns.Bound(c => c.Identifier).Title(TextsAndMessagesHelper.IWCN_General_Name);
            /*columns.ForeignKey(p => p.PermissionId, ds =>
            {
                ds.Ajax().Read(cfg =>
                {
                    cfg.Url("/ForeignKey/sys/Permissions");
                }).ServerOperation(true);
            }, "Key", "Label");*/
if (Context.RequestServices.VerifyUserPermissions(new[] { "DbResources.Write" }))
            {
                columns.Command(ga =>
                {
                    ga.Edit();
                    ga.PopupConfirmDelete();
                }).Width(180);
            }

        })
        .ToolBar(toolbar =>
        {
            toolbar.RefreshTable();
if (Context.RequestServices.VerifyUserPermissions(new[] { "DbResources.Write" }))
            {
                toolbar.Create();
                toolbar.Custom().Name("ResetFactory").Text(TextsAndMessagesHelper.IWCN_DRI_ResetFactory).HtmlAttributes(new Dictionary<string, object>
                {
                    { "onclick", "ITVenture.Pages.Util.DbResources.ResetLocalization()" }
                });
            }
        })
        //.Events(e => e.UseForeignKeyFilter())
        .DataSource(dataSource =>
        {
            var src = dataSource
                .Ajax()
                .Read(read => read.Action("Read", "DbResource"));
            if (Context.RequestServices.VerifyUserPermissions(new[] { "DbResources.Write" }))
            {
                src.Create(create => create.Action("Create", "DbResource"))
        .Update(update => update.Action("Update", "DbResource"))
        .Destroy(destroy => destroy.Action("Destroy", "DbResource"));
            }
            src.Model(m => m.Id(t => t.LocalizationId))
                .Sort(n => n.Add(m => m.Identifier));
        })
        .Scrollable(s => s.Height("auto"))
        .Pageable(p => p.Input(false).Numeric(true).Info(true).PreviousNext(true).PageSizes(true))
        .Sortable(c => c.Enabled(true))
    .Resizable(c => c.Columns(true))
    .Filterable(f => f.Enabled(true))
    .ClientDetailTemplateId("AttachedCultures"))

@Html.DetailViewScript("AttachedCultures", "AttachedCultures#=LocalizationId#", "~/Util/DbResource/Cultures?localizationId=#=LocalizationId#")
@Html.DetailViewScript("CultureDetails", "CultureDetails#=LocalizationCultureId#", "~/Util/DbResource/Strings?localizationCultureId=#=LocalizationCultureId#")
