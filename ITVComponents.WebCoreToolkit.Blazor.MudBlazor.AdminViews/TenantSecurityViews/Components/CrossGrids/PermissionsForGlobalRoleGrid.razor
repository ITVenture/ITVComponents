@using Microsoft.AspNetCore.Components.Authorization

@inject IGlobalRoleAdminHandler Handler
@inject AuthenticationStateProvider AuthState
@inject ISnackbar Snackbar

@if (!hasView)
{
    <MudAlert Severity="Severity.Info">No permission to view global-role permissions.</MudAlert>
}
else
{
    <MudDataGrid T="GlobalPermissionAssignmentViewModel"
                 @ref="grid"
                 ServerData="LoadData"
                 SortMode="SortMode.None"
                 RowsPerPage="10"
                 Hover="true"
                 Dense="true">
        <ToolBarContent>
            <RefreshButton OnClick="@(() => grid is null ? Task.CompletedTask : grid.ReloadServerData())" />
            <MudText Typo="Typo.subtitle2">Permissions</MudText>
            <MudSpacer />
        </ToolBarContent>
        <Columns>
            <TemplateColumn T="GlobalPermissionAssignmentViewModel" Title="" Sortable="false">
                <CellTemplate>
                    <MudCheckBox T="bool"
                                 Value="context.Item.Assigned"
                                 Disabled="!hasWrite"
                                 ValueChanged="@(v => Toggle(context.Item, v))" />
                </CellTemplate>
            </TemplateColumn>
            <PropertyColumn Property="x => x.PermissionName" Title="Permission" />
            <PropertyColumn Property="x => x.Description" Title="Description" />
        </Columns>
        <PagerContent>
            <MudDataGridPager T="GlobalPermissionAssignmentViewModel" />
        </PagerContent>
    </MudDataGrid>
}

@code {
    [Parameter, EditorRequired] public int GlobalRoleId { get; set; }

    private MudDataGrid<GlobalPermissionAssignmentViewModel>? grid;
    private System.Security.Claims.ClaimsPrincipal? currentUser;
    private bool hasView;
    private bool hasWrite;

    protected override async Task OnInitializedAsync()
    {
        var auth = await AuthState.GetAuthenticationStateAsync();
        currentUser = auth.User;
        hasView = Handler.HasPermission(currentUser, "GlobalRoles.View", "GlobalRoles.AssignPermission", "Sysadmin");
        hasWrite = Handler.HasPermission(currentUser, "GlobalRoles.AssignPermission", "Sysadmin");
    }

    private async Task<GridData<GlobalPermissionAssignmentViewModel>> LoadData(GridState<GlobalPermissionAssignmentViewModel> state, CancellationToken ct)
    {
        if (currentUser is null || !hasView)
            return new GridData<GlobalPermissionAssignmentViewModel> { Items = Array.Empty<GlobalPermissionAssignmentViewModel>(), TotalItems = 0 };
        var query = new ListQuery { Page = state.Page, PageSize = state.PageSize };
        var result = await Handler.ListPermissionsForGlobalRoleAsync(currentUser, GlobalRoleId, query);
        return new GridData<GlobalPermissionAssignmentViewModel> { Items = result.Items, TotalItems = result.TotalCount };
    }

    private async Task Toggle(GlobalPermissionAssignmentViewModel item, bool newValue)
    {
        if (!hasWrite || currentUser is null) return;
        var ok = await Handler.SetPermissionAssignmentForGlobalRoleAsync(currentUser, GlobalRoleId, item.PermissionId, newValue);
        if (ok)
        {
            item.Assigned = newValue;
            Snackbar.Add(newValue ? "Permission assigned" : "Permission unassigned", Severity.Success);
        }
        else
        {
            Snackbar.Add("Failed to update assignment", Severity.Error);
            if (grid is not null) await grid.ReloadServerData();
        }
    }
}
