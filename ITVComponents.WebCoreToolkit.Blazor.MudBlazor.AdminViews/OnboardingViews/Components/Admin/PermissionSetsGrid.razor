@using Microsoft.AspNetCore.Components.Authorization

@inject IOnboardingAdminHandler Handler
@inject AuthenticationStateProvider AuthState
@inject ISnackbar Snackbar
@inject IStringLocalizer<OnboardingMessages> L

<MudDataGrid T="PermissionSetActivationViewModel" Items="sets" SortMode="SortMode.None" Dense="true" Hover="true">
    <ToolBarContent>
        <RefreshButton OnClick="Reload" />
        <MudText Typo="Typo.subtitle2">@L["OnbAdm_Ps_Title"]</MudText>
        <MudSpacer />
    </ToolBarContent>
    <Columns>
        <TemplateColumn T="PermissionSetActivationViewModel" Title="" Sortable="false">
            <CellTemplate>
                <SecureView RequiredPermissions="@AssignPermissions">
                    <Permitted>
                        <MudCheckBox T="bool" Value="context.Item.Active" ValueChanged="@(v => Toggle(context.Item, v))" />
                    </Permitted>
                    <NotPermitted>
                        <MudCheckBox T="bool" Value="context.Item.Active" Disabled="true" />
                    </NotPermitted>
                </SecureView>
            </CellTemplate>
        </TemplateColumn>
        <PropertyColumn Property="x => x.Label" Title="@L["OnbAdm_Ps_Col"]" />
    </Columns>
</MudDataGrid>

@code {
    [Parameter, EditorRequired] public int DirectMappingId { get; set; }

    /// <summary>
    /// Comma-separated permissions required to toggle a set's activation (checkbox). Set by the parent per the
    /// expandable row's kind: DirectRole needs DirectRole|Write; a Delegation parent also accepts the weaker
    /// delegate-assign tier. Defaults to the DirectRole permissions.
    /// </summary>
    [Parameter] public string AssignPermissions { get; set; } = "Onboarding.Admin.RoleMappings.DirectRole,Onboarding.Admin.RoleMappings.Write";

    private System.Security.Claims.ClaimsPrincipal? currentUser;
    private PermissionSetActivationViewModel[] sets = Array.Empty<PermissionSetActivationViewModel>();

    protected override async Task OnInitializedAsync()
    {
        var auth = await AuthState.GetAuthenticationStateAsync();
        currentUser = auth.User;
        await Reload();
    }

    private async Task Reload()
    {
        if (currentUser is null)
        {
            return;
        }

        sets = await Handler.ListActivatablePermissionSetsAsync(currentUser, DirectMappingId);
    }

    private async Task Toggle(PermissionSetActivationViewModel item, bool newValue)
    {
        if (currentUser is null) return;
        var ok = await Handler.SetPermissionSetActivationAsync(currentUser, DirectMappingId, item.PermissionSetMappingId, newValue);
        if (ok)
        {
            item.Active = newValue;
            Snackbar.Add(L["OnbAdm_Ps_Updated"], Severity.Success);
        }
        else
        {
            Snackbar.Add(L["OnbAdm_Ps_Failed"], Severity.Error);
            await Reload();
        }
    }
}
