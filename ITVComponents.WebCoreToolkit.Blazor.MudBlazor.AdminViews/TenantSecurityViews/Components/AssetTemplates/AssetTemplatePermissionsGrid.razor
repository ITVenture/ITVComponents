@using Microsoft.AspNetCore.Components.Authorization

@inject IAssetTemplateAdminHandler Handler
@inject AuthenticationStateProvider AuthState
@inject ISnackbar Snackbar

<MudDataGrid T="AssetTemplatePermissionAssignmentViewModel"
             @ref="grid"
             ServerData="LoadData"
             SortMode="SortMode.None"
             RowsPerPage="10"
             Hover="true"
             Dense="true">
    <ToolBarContent>
        <RefreshButton OnClick="@(() => grid is null ? Task.CompletedTask : grid.ReloadServerData())" />
        <MudText Typo="Typo.subtitle2">Permissions</MudText>
        <MudSpacer />
    </ToolBarContent>
    <Columns>
        <TemplateColumn T="AssetTemplatePermissionAssignmentViewModel" Title="" Sortable="false">
            <CellTemplate>
                <SecureView RequiredPermissions="Sysadmin">
                    <Permitted>
                <MudCheckBox T="bool"
                             Value="context.Item.Assigned"
                             ValueChanged="@(v => Toggle(context.Item, v))" />
                    </Permitted>
                    <NotPermitted>
                <MudCheckBox T="bool"
                             Value="context.Item.Assigned"
                             Disabled="true" />
                    </NotPermitted>
                </SecureView>
            </CellTemplate>
        </TemplateColumn>
        <PropertyColumn Property="x => x.PermissionName" Title="Permission" />
        <PropertyColumn Property="x => x.Description" Title="Description" />
    </Columns>
    <PagerContent>
        <MudDataGridPager T="AssetTemplatePermissionAssignmentViewModel" />
    </PagerContent>
</MudDataGrid>

@code {
    [Parameter, EditorRequired] public int AssetTemplateId { get; set; }
    [Parameter] public bool CanWrite { get; set; }

    private MudDataGrid<AssetTemplatePermissionAssignmentViewModel>? grid;
    private System.Security.Claims.ClaimsPrincipal? currentUser;

    protected override async Task OnInitializedAsync()
    {
        var auth = await AuthState.GetAuthenticationStateAsync();
        currentUser = auth.User;
    }

    private async Task<GridData<AssetTemplatePermissionAssignmentViewModel>> LoadData(GridState<AssetTemplatePermissionAssignmentViewModel> state, CancellationToken ct)
    {
        if (currentUser is null) return new GridData<AssetTemplatePermissionAssignmentViewModel> { Items = Array.Empty<AssetTemplatePermissionAssignmentViewModel>(), TotalItems = 0 };
        var query = new ListQuery { Page = state.Page, PageSize = state.PageSize };
        var result = await Handler.ListPermissionsForTemplateAsync(currentUser, AssetTemplateId, query);
        return new GridData<AssetTemplatePermissionAssignmentViewModel> { Items = result.Items, TotalItems = result.TotalCount };
    }

    private async Task Toggle(AssetTemplatePermissionAssignmentViewModel item, bool newValue)
    {
        if (!CanWrite || currentUser is null) return;
        var ok = await Handler.SetPermissionForTemplateAsync(currentUser, AssetTemplateId, item.PermissionId, newValue);
        if (ok)
        {
            item.Assigned = newValue;
            Snackbar.Add(newValue ? "Permission granted" : "Permission revoked", Severity.Success);
        }
        else
        {
            Snackbar.Add("Failed to update", Severity.Error);
            if (grid is not null) await grid.ReloadServerData();
        }
    }
}
