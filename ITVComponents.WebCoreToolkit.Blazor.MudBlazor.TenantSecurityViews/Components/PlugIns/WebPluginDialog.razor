@inject ISnackbar Snackbar

<MudDialog>
    <DialogContent>
        <MudForm @ref="form" Model="Model">
            <MudTextField @bind-Value="Model.UniqueName" Label="Unique name" Required="true" MaxLength="300" />
            <MudTextField @bind-Value="Model.Constructor" Label="Constructor" Lines="4" MaxLength="8192" />
            <MudTextField @bind-Value="Model.StartupRegistrationConstructor" Label="Startup registration constructor" Lines="3" MaxLength="8192" />
            <MudStack Row="true" Spacing="3" Class="mt-2">
                <MudCheckBox @bind-Value="Model.AutoLoad" Label="Auto-load" />
                <MudCheckBox @bind-Value="Model.Transient" Label="Transient" />
            </MudStack>
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Cancel</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="Save">@(IsCreate ? "Create" : "Save")</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;
    [Parameter, EditorRequired] public WebPluginViewModel Model { get; set; } = default!;
    [Parameter] public bool IsCreate { get; set; }

    private MudForm? form;

    private async Task Save()
    {
        if (form is null) return;
        await form.Validate();
        if (!form.IsValid) { Snackbar.Add("Please correct invalid fields", Severity.Warning); return; }
        MudDialog.Close(DialogResult.Ok(Model));
    }

    private void Cancel() => MudDialog.Cancel();
}
