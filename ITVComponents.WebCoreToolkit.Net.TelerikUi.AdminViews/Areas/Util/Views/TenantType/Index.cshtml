@using ITVComponents.WebCoreToolkit.Net.Extensions
@using Microsoft.AspNetCore.Mvc.ModelBinding.Metadata
@using System.Text.Encodings.Web
@using System.Collections
@using ITVComponents.WebCoreToolkit.Extensions
@using ITVComponents.WebCoreToolkit.Net.TelerikUi.AdminViews.Extensions
@using ITVComponents.WebCoreToolkit.Net.TelerikUi.AdminViews.Options
@using ITVComponents.WebCoreToolkit.Net.TelerikUi.AdminViews.Resources
@using ITVComponents.WebCoreToolkit.Net.TelerikUi.AdminViews.TenantSecurityViews.ViewModel
@using ITVComponents.WebCoreToolkit.Net.ViewModel
@using Kendo.Mvc.UI
@using Microsoft.Extensions.Options
@using TextsAndMessagesHelper = ITVComponents.WebCoreToolkit.Net.TelerikUi.AdminViews.TenantSecurityViews.Resources.TextsAndMessagesHelper
@inject IOptions<ViewOptions> viewOptions
@{
    Layout = viewOptions.Value.LayoutPage;
}
@{

    ViewBag.Title = TextsAndMessagesHelper.IWCN_Titles_TenantTypes;
}
<script src="@("/_content/ITVComponents.WebCoreToolkit.Net.TelerikUi.AdminViews/js/viewScripts.min.js".ExtendUrlWithVersion())"></script>
@(Html.Kendo().Grid<TenantTypeViewModel>().Name("TenantTypeGrid")
    //.HtmlAttributes(new { style = "width:50vw;" })
    .Columns(columns =>
    {
        columns.Bound(n => n.TenantTypeName).Title(TextsAndMessagesHelper.IWCN_General_Name);
        columns.Bound(n => n.TypeMetaData).ClientTemplate("<div style='white-space:pre-line;'>#=ITVenture.Tools.HtmlHelper.encode(TypeMetaData!=null?TypeMetaData:'')#</div>").Title(TextsAndMessagesHelper.IWCN_TT_MetaData);
        columns.AjaxFk(n => n.TenantTemplateId, "sys", "TenantTemplates", "TenantTypeId").Title(TextsAndMessagesHelper.IWCN_TT_Template);
        columns.Command(ga =>
        {
            ga.Edit();
            ga.PopupConfirmDelete();
            ga.Custom("Applicate").Text("\u200B").HtmlAttributes(new { @class = "itv-grid-button itv-fa-gbx glyphSprite", title = TextsAndMessagesHelper.IWCN_TT_Apply }).IconClass("fa-duotone fa-hat-witch").Click("ITVenture.Pages.Util.TenantTypes.applyToAllTenants").Visible("ITVenture.Pages.Util.TenantTypes.showApply");
        }).Width(180);
    })
    .ToolBar(toolbar =>
    {
        toolbar.RefreshTable();
        toolbar.Create();
    })
    .DataSource(dataSource =>
    {
        var src = dataSource
            .Ajax()
            .Read(read => read.Action("Read", "TenantType"))
            .Sort(s => s.Add(m => m.TenantTypeName).Ascending())
            .Create(create => create.Action("Create", "TenantType"))
            .Update(update => update.Action("Update", "TenantType"))
            .Destroy(destroy => destroy.Action("Destroy", "TenantType"));
        src.Model(m => m.Id(t => t.TenantTypeId));
    })
    .Scrollable(s => s.Height("auto"))
    .Resizable(c => c.Columns(true)))