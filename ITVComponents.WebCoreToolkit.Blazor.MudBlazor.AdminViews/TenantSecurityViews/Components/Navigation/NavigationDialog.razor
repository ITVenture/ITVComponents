@using ITVComponents.WebCoreToolkit.EntityFramework.Models

<EditDialogShell Model="Model" IsCreate="IsCreate">
    <MudTextField @bind-Value="Model.DisplayName" Label="Display name" Required="true" RequiredError="Name is required" />
    <MudTextField @bind-Value="Model.Url" Label="URL" MaxLength="1024" />
    <MudSelect T="int?" @bind-Value="Model.ParentId" Label="Parent" Clearable="true" AnchorOrigin="Origin.BottomCenter">
        <MudSelectItem T="int?" Value="@((int?)null)">(none)</MudSelectItem>
        @foreach (var p in AllParents.Where(p => p.NavigationMenuId != Model.NavigationMenuId))
        {
            <MudSelectItem T="int?" Value="@((int?)p.NavigationMenuId)">@p.DisplayName</MudSelectItem>
        }
    </MudSelect>
    <MudNumericField T="int?" @bind-Value="Model.SortOrder" Label="Sort order" />
    <ForeignKeyAutocomplete T="int?" Table="Permissions" @bind-Value="Model.PermissionId" Label="Permission" Clearable="true" />
    <ForeignKeyAutocomplete T="int?" Table="Features" @bind-Value="Model.FeatureId" Label="Feature" Clearable="true" />
    <MudTextField @bind-Value="Model.SpanClass" Label="Span class (icon)" />
    <MudCheckBox @bind-Value="Model.IsPublic" Label="Public" />
    <MudTextField @bind-Value="Model.Metadata" Label="Metadata (JSON)" Lines="4"
                  Placeholder="@("{ \"HelpSlug\": \"...\" }")"
                  HelperText="Optional JSON object (key/value), e.g. a HelpSlug for the context-help button."
                  Validation="@((Func<string?, string?>)ValidateMetadata)" />
    @* Die Liste kommt aus dem berechtigungsgefilterten Handler, nicht aus der FK-Quelle - darum
       ueber Items statt Table. *@
    <ForeignKeyMultiSelect T="int"
                           Items="@tenantOptions"
                           Values="@selectedTenants"
                           ValuesChanged="@OnTenantsChanged"
                           Label="Tenants" />
</EditDialogShell>

@code {
    [Parameter, EditorRequired] public NavigationMenuViewModel Model { get; set; } = default!;
    [Parameter] public bool IsCreate { get; set; }
    [Parameter] public IReadOnlyList<NavigationParentChoice> AllParents { get; set; } = Array.Empty<NavigationParentChoice>();
    [Parameter] public IReadOnlyList<TenantChoice> AllTenants { get; set; } = Array.Empty<TenantChoice>();

    private IReadOnlyCollection<int> selectedTenants = Array.Empty<int>();

    /// <summary>
    /// Die Mandantenliste in der Form, die <c>ForeignKeyMultiSelect</c> erwartet. Die Projektion laeuft
    /// bei jedem Parameter-Satz neu, weil der Aufrufer die Liste asynchron nachliefert.
    /// </summary>
    private IReadOnlyList<ForeignKeyData<int>> tenantOptions = Array.Empty<ForeignKeyData<int>>();

    protected override void OnInitialized()
    {
        selectedTenants = Model.Tenants.ToList();
    }

    protected override void OnParametersSet()
    {
        tenantOptions = AllTenants
            .Select(t => new ForeignKeyData<int> { Key = t.TenantId, Label = t.DisplayName })
            .ToArray();
    }

    private void OnTenantsChanged(IReadOnlyCollection<int> values)
    {
        var arr = values.ToArray();
        selectedTenants = arr;
        Model.Tenants = arr;
    }

    // Accept empty metadata; otherwise require a well-formed JSON object so a typo can't slip into navigation.
    private static string? ValidateMetadata(string? json)
    {
        if (string.IsNullOrWhiteSpace(json))
        {
            return null;
        }

        try
        {
            using var doc = System.Text.Json.JsonDocument.Parse(json);
            return doc.RootElement.ValueKind == System.Text.Json.JsonValueKind.Object
                ? null
                : "Metadata must be a JSON object.";
        }
        catch (System.Text.Json.JsonException)
        {
            return "Invalid JSON.";
        }
    }
}
