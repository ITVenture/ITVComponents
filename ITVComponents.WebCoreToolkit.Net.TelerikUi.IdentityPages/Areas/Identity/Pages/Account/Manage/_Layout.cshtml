@using Microsoft.Extensions.Localization
@using Microsoft.Extensions.Options
@inject IStringLocalizer<IdentityMessages> localizer
@inject IOptions<ViewOptions> viewOptions
@{
    Layout = viewOptions.Value.LayoutPage;
    var body = RenderBody();
}

<h2>@localizer["Manage your account"]</h2>

<div>
    <h4>@localizer["Change your account settings"]</h4>
    <hr />
    <div class="row">
        <div class="col-md-3">
            <partial name="_ManageNav" />
        </div>
        <div class="col-md-9">
            @body
        </div>
    </div>
</div>


@if (IsSectionDefined("Scripts"))
{
    @section Scripts {
        @RenderSection("Scripts", required: false)
    }
}
else
{
    @RenderSection("Scripts", required: false)
}
