@using System.Globalization
@using ITVComponents.Workflow.Model

@*
    Freier Editor fuer eine Liste von Eingabe-Bindungen (Konstante / Variable / CScript-Ausdruck).
    Bewusst EINE Komponente fuer alle Knotenarten, die Daten hereinnehmen (generische Aktivitaet,
    Subworkflow-Aufruf, Start-Parameter): die Zeile sah an allen Stellen schon gleich aus, war aber
    dreimal getippt - jede Korrektur haette sonst dreimal gemacht werden muessen. Nur die Beschriftungen
    unterscheiden sich, deshalb sind sie Parameter.
*@

@if (Bindings is not null)
{
    @foreach (var b in Bindings)
    {
        <MudStack Row="true" Spacing="1" AlignItems="AlignItems.Center" Class="mt-1" @key="b">
            <MudTextField T="string" Value="@b.Parameter" ValueChanged="@(v => b.Parameter = v)"
                          Placeholder="@NamePlaceholder" Margin="Margin.Dense" Style="@($"max-width:{NameWidth}")" />
            <MudSelect T="ParameterBindingKind" Value="@b.Kind" ValueChanged="@(k => SetKind(b, k))"
                       Dense="true" Margin="Margin.Dense" Style="max-width:120px">
                <MudSelectItem T="ParameterBindingKind" Value="ParameterBindingKind.Literal">Constant</MudSelectItem>
                <MudSelectItem T="ParameterBindingKind" Value="ParameterBindingKind.Variable">Variable</MudSelectItem>
                <MudSelectItem T="ParameterBindingKind" Value="ParameterBindingKind.Expression">Expression</MudSelectItem>
            </MudSelect>
            @if (b.Kind == ParameterBindingKind.Expression)
            {
                <div style="flex:1 1 auto">
                    <CScriptField @key="b" Value="@(b.Source ?? string.Empty)"
                                  ValueChanged="@(v => b.Source = string.IsNullOrEmpty(v) ? null : v)" Height="60" />
                </div>
            }
            else if (b.Kind == ParameterBindingKind.Variable)
            {
                <MudTextField T="string" Value="@(b.Source ?? string.Empty)"
                              ValueChanged="@(v => b.Source = string.IsNullOrEmpty(v) ? null : v)"
                              Placeholder="@SourcePlaceholder" Margin="Margin.Dense" />
            }
            else
            {
                <MudTextField T="string" Value="@ToStr(b.Literal)"
                              ValueChanged="@(v => b.Literal = string.IsNullOrEmpty(v) ? null : v)"
                              Placeholder="value" Margin="Margin.Dense" />
            }
            <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error"
                           OnClick="@(() => Bindings.Remove(b))" />
        </MudStack>
    }
    <MudStack Row="true" Spacing="1" AlignItems="AlignItems.Center" Class="mt-1">
        <MudTextField T="string" @bind-Value="newName" Placeholder="@AddPlaceholder"
                      Margin="Margin.Dense" Style="max-width:150px" />
        <MudIconButton Icon="@Icons.Material.Filled.Add" Size="Size.Small" Color="Color.Primary" OnClick="Add" />
    </MudStack>
}

@code {
    /// <summary>Die bearbeitete Liste (wird in-place veraendert).</summary>
    [Parameter] public List<ActivityInputBinding>? Bindings { get; set; }

    /// <summary>Platzhalter der Namensspalte (was der Parameter im Ziel bedeutet).</summary>
    [Parameter] public string NamePlaceholder { get; set; } = "name";

    /// <summary>Platzhalter des Quell-Feldes im Modus "Variable".</summary>
    [Parameter] public string SourcePlaceholder { get; set; } = "variable name";

    /// <summary>Platzhalter der Zeile zum Anlegen.</summary>
    [Parameter] public string AddPlaceholder { get; set; } = "new input name";

    /// <summary>Breite der Namensspalte (CSS-Laengenangabe).</summary>
    [Parameter] public string NameWidth { get; set; } = "110px";

    private string? newName;

    private static void SetKind(ActivityInputBinding b, ParameterBindingKind kind)
    {
        if (b.Kind == kind)
        {
            return;
        }

        // Quelle gewechselt: die alten Werte passen nicht mehr. Die Zeile bleibt aber stehen - sie ist
        // die bewusste Deklaration des Nutzers, auch ohne Wert.
        b.Kind = kind;
        b.Literal = null;
        b.Source = null;
    }

    private void Add()
    {
        if (Bindings is null || string.IsNullOrWhiteSpace(newName))
        {
            return;
        }

        if (!Bindings.Any(x => x.Parameter == newName))
        {
            Bindings.Add(new ActivityInputBinding { Parameter = newName, Kind = ParameterBindingKind.Literal });
        }

        newName = null;
    }

    private static string ToStr(object? value)
        => value switch
        {
            null => string.Empty,
            IFormattable f => f.ToString(null, CultureInfo.InvariantCulture),
            _ => value.ToString() ?? string.Empty
        };
}
