<EditDialogShell Model="Model" IsCreate="IsCreate">
    <MudTextField @bind-Value="Model.TenantTypeName" Label="Name" Required="true" RequiredError="Name is required" />
    <ForeignKeySelect T="int?" @bind-Value="Model.TenantTemplateId" Table="TenantTemplates" Label="Tenant template" />
    <MudTextField @bind-Value="Model.TypeMetaData" Label="Type metadata (JSON)" Lines="4" />
</EditDialogShell>

@code {
    [Parameter, EditorRequired] public TenantTypeViewModel Model { get; set; } = default!;
    [Parameter] public bool IsCreate { get; set; }
}
