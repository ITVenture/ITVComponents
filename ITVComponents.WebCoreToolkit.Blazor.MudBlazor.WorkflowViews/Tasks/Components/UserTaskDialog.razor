@using System.Globalization
@using ITVComponents.EFRepo.Helpers
@using ITVComponents.Helpers
@using ITVComponents.Logging
@using ITVComponents.WebCoreToolkit.Blazor.MudBlazor.WorkflowViews.Tasks.Configuration
@using ITVComponents.WebCoreToolkit.Caching
@using ITVComponents.WebCoreToolkit.Extensions
@using ITVComponents.Workflow.EntityFramework
@using Microsoft.Extensions.DependencyInjection
@using Microsoft.Extensions.Options
@implements IAsyncDisposable

@inject IWorkflowTaskHandler Handler
@inject AuthenticationStateProvider AuthState
@inject ISnackbar Snackbar
@inject IStringLocalizer<WorkflowTaskMessages> L
@inject IOptions<WorkflowTaskViewConfiguration> ViewRegistry
@inject IServiceProvider Services

@* Der MANTEL der Aufgabe. Er gehoert genau einmal hierher, weil der teure Teil nicht das Anzeigen ist,
   sondern der Abschluss: Ergebnis-Mapping, weiche Sperre, Doppel-Klick, Versionskonflikt und "war schon
   erledigt". Was darin gerendert wird - eigene Komponente oder generische Maske - ist der austauschbare
   Teil.

   Im FORTLAUFENDEN Betrieb (Continuous) bleibt derselbe Mantel stehen und haengt sich auf die naechste
   Aufgabe derselben Instanz um: der Benutzer arbeitet einen mehrstufigen Vorgang in EINEM Dialog durch,
   statt nach jedem Schritt in die Arbeitsliste zurueckzukehren und die Fortsetzung dort zu suchen. Genau
   deshalb sitzt das hier und nicht in der Arbeitsliste - sie ist nur EINER der Einstiege. *@

<MudDialog>
    <DialogContent>
        @if (loading)
        {
            <MudProgressCircular Indeterminate="true" />
            <MudText Typo="Typo.body2" Class="ml-2">@L["Loading"]</MudText>
        }
        else if (waiting)
        {
            @* Der Vorgang laeuft, haelt aber (noch) nicht bei uns: eine automatische Aktivitaet dazwischen,
               oder der Runner hat den Zweig noch nicht aufgenommen. *@
            <div class="d-flex align-center">
                <MudProgressCircular Indeterminate="true" Size="Size.Small" />
                <MudText Typo="Typo.body2" Class="ml-3">@L["WaitingForNextStep"]</MudText>
            </div>
        }
        else if (handedOn)
        {
            @* Kein Fehler, sondern der Regelfall am Ende eines Abschnitts: der Vorgang liegt jetzt woanders
               (bei einem anderen Bearbeiter, in einer automatischen Strecke) oder ist fertig. *@
            <MudAlert Severity="Severity.Info">
                @L["NoMoreTasks"]
                <br />
                <MudText Typo="Typo.caption">@L["ProcessKeepsRunning"]</MudText>
            </MudAlert>
        }
        else if (taskContext is null)
        {
            <MudAlert Severity="Severity.Warning">@L["TaskGone"]</MudAlert>
        }
        else
        {
            @if (assistantSession)
            {
                @* Im gefuehrten Ablauf wechselt die Aufgabe, die Kopfzeile des Dialogs aber nicht (sie
                   gehoert dem Vorgang, aus dem heraus geoeffnet wurde). Also steht die Aufgabe hier - auch
                   noch beim letzten Schritt, der selbst nicht mehr weiterfuehrt. *@
                <MudText Typo="Typo.subtitle1" Class="mb-2">@TaskTitle</MudText>
            }
            @if (!string.IsNullOrEmpty(claimWarning))
            {
                <MudAlert Severity="Severity.Info" Dense="true" Class="mb-3">@claimWarning</MudAlert>
            }

            @* @key auf der Kaskade: die Maske MUSS beim Wechsel der Aufgabe neu gebaut werden. Ohne den
               Schluessel behielte Blazor die vorhandene Instanz (und mit IsFixed="true" auch den alten
               Kontext) - der Benutzer sähe die Eingaben des vorigen Schritts. *@
            <CascadingValue Value="taskContext" IsFixed="true" @key="@currentTokenId">
                @if (customView is not null)
                {
                    <DynamicComponent Type="customView" @ref="dynamicView" />
                }
                else
                {
                    <GenericTaskForm @ref="form" />
                }
            </CascadingValue>
        }
    </DialogContent>
    <DialogActions>
        <DialogMaximizeToggle NormalMaxWidth="MaxWidth.ExtraLarge" />
        <MudSpacer />
        @if (taskContext is not null && !waiting && !handedOn)
        {
            <MudButton Color="Color.Primary" Variant="Variant.Filled" Disabled="@busy"
                       OnClick="CompleteFromViewAsync">@L["Complete"]</MudButton>
        }
        <MudButton OnClick="CloseAsync">@L["Close"]</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;

    /// <summary>Die Instanz, zu der die Aufgabe gehoert.</summary>
    [Parameter] public string InstanceId { get; set; } = "";

    /// <summary>
    /// Das wartende Token - die Aufgabe selbst. <b>Leer</b> heisst "die naechste offene Aufgabe dieser
    /// Instanz" und wartet, falls gerade keine offen ist: der Einstieg fuer ein Modul, das den Vorgang
    /// selbst gestartet hat und die Instanz-Id kennt, aber noch keine Aufgabe.
    /// </summary>
    [Parameter] public string TokenId { get; set; } = "";

    /// <summary>Die Workflow-Umgebung (Store) dieser Aufgabe; null = Standard.</summary>
    [Parameter] public string? Environment { get; set; }

    /// <summary>
    /// Uebersteuert, ob nach dem Abschluss gleich mit der naechsten Aufgabe derselben Instanz weitergemacht
    /// wird. <b>Null (Vorgabe) heisst: das Modell entscheidet</b> - der Knoten sagt es ueber
    /// <c>RunsInAssistant</c>.
    /// </summary>
    /// <remarks>
    /// Dass die Vorgabe das MODELL fragt, ist der Punkt: sonst haenge der gefuehrte Ablauf daran, wo der
    /// Benutzer eingestiegen ist. Wer den Assistenten mittendrin schliesst und die Aufgabe spaeter aus
    /// seiner Arbeitsliste heraus wieder oeffnet, bekommt ihn damit unveraendert zurueck - die Arbeitsliste
    /// muss dafuer nichts wissen und nichts setzen.
    /// <para>
    /// Ausdruecklich gesetzt wird der Wert nur, wo eine Oberflaeche es besser weiss: <c>true</c> fuehrt auch
    /// durch Schritte, die im Modell nicht als gefuehrt markiert sind, <c>false</c> zeigt bewusst nur den
    /// einen Schritt.
    /// </para>
    /// </remarks>
    [Parameter] public bool? Continuous { get; set; }

    /// <summary>
    /// Wie lange auf den naechsten Schritt gewartet wird, bevor der Dialog sagt, dass der Vorgang
    /// weiterlaeuft.
    /// </summary>
    /// <remarks>
    /// Die Obergrenze ist bewusst knapp: sie deckt die automatischen Aktivitaeten zwischen zwei
    /// Benutzer-Schritten ab, nicht das Warten auf einen Menschen oder einen Timer. Laeuft sie ab, ist das
    /// keine Stoerung - der Vorgang ist dann einfach nicht mehr in dieser Sitzung zu Hause.
    /// </remarks>
    [Parameter] public TimeSpan WaitTimeout { get; set; } = TimeSpan.FromSeconds(30);

    /// <summary>Wie lange die weiche Sperre gilt, wenn niemand sie erneuert.</summary>
    private static readonly TimeSpan ClaimDuration = TimeSpan.FromMinutes(15);

    /// <summary>
    /// Der Takt, in dem beim Warten selbst nachgesehen wird - das Netz unter dem Weckruf.
    /// </summary>
    /// <remarks>
    /// Es ist ausdruecklich NICHT der Hauptweg: kommt der Weckruf, ist die Wartezeit sofort vorbei. Er
    /// traegt aber nur im eigenen Prozess und nur mit aktivem Schreib-Verfolger; ohne beides waere der
    /// Dialog ohne diesen Takt blind. Deshalb ruhig statt hektisch.
    /// </remarks>
    private static readonly TimeSpan PollInterval = TimeSpan.FromSeconds(3);


    private WorkflowTaskContext? taskContext;
    private GenericTaskForm? form;
    private DynamicComponent? dynamicView;
    private Type? customView;
    private ClaimsPrincipal? currentUser;
    private string? claimWarning;

    /// <summary>Die Aufgabe, an der wir gerade sitzen - im fortlaufenden Betrieb wechselt sie.</summary>
    private string currentTokenId = "";

    private IEntityChangeSignal<WorkflowContext>? progressSignal;

    /// <summary>
    /// Der Weckruf als abwartbares Ereignis. Wird VOR jeder Nachfrage neu gesetzt, damit eine Meldung, die
    /// zwischen Nachfrage und Warten eintrifft, nicht verloren geht.
    /// </summary>
    private TaskCompletionSource? progressPulse;

    private bool loading = true;
    private bool busy;
    private bool claimed;
    private bool completed;
    private bool waiting;
    private bool handedOn;
    private bool disposed;

    /// <summary>
    /// True, sobald dieser Dialog einen gefuehrten Ablauf zeigt - er bleibt es bis zum Schliessen.
    /// </summary>
    /// <remarks>
    /// Nicht dasselbe wie <see cref="LeadsOn"/>: der LETZTE Schritt eines Assistenten fuehrt nicht mehr
    /// weiter, gehoert aber noch dazu. Waere die Anzeige an LeadsOn gebunden, verschwaende die Beschriftung
    /// der Aufgabe ausgerechnet auf dem letzten Schritt.
    /// </remarks>
    private bool assistantSession;

    protected override async Task OnInitializedAsync()
    {
        AuthenticationState auth = await AuthState.GetAuthenticationStateAsync();
        currentUser = auth.User;

        SubscribeToProgress();

        if (!string.IsNullOrEmpty(TokenId))
        {
            await OpenAsync(TokenId);
            loading = false;
            return;
        }

        // Ohne Token wird gewartet - aber NICHT hier: ein await in OnInitializedAsync verzoegert das erste
        // Rendern, der Dialog stuende bis zu WaitTimeout leer da. Der Wartezustand wird gerendert, die
        // Suche laeuft danach an.
        // Wer ohne Aufgabe einsteigt, meint den Vorgang und nicht einen Schritt - das IST ein gefuehrter
        // Ablauf, auch bevor die erste Aufgabe da ist.
        assistantSession = true;
        loading = false;
        waiting = true;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && waiting)
        {
            await WaitForNextAsync();
        }
    }

    /// <summary>
    /// Haengt sich an den Weckruf des Workflow-Kontexts, wenn es einen gibt.
    /// </summary>
    /// <remarks>
    /// Der Verfolger wird ZUERST gefragt: das Signal ist offen generisch registriert, seine Aufloesung
    /// wuerde ohne Verfolger nicht null liefern, sondern werfen. Fehlt er, ist das kein Fehler (der
    /// Schalter ist optional) - dann bleibt der eigene Takt, und das gehoert ins Log, sonst sucht man
    /// spaeter, warum der Dialog "langsam" reagiert.
    /// </remarks>
    private void SubscribeToProgress()
    {
        if (Services.GetService<IEntityWriteTracker<WorkflowContext>>() is null)
        {
            LogEnvironment.LogEvent(
                "UserTaskDialog: kein IEntityWriteTracker<WorkflowContext> registriert - der Dialog erfaehrt " +
                "den Fortschritt einer Instanz nicht per Weckruf, sondern nur durch eigenes Nachfragen " +
                $"(alle {PollInterval.TotalSeconds:0} s). Mit ActivationSettings.UseEntityTracker=true und dem " +
                "EntityWriteTrackerInterceptor am Workflow-Kontext ist er sofort da.", LogSeverity.Report);
            return;
        }

        progressSignal = Services.GetService<IEntityChangeSignal<WorkflowContext>>();
        if (progressSignal is not null)
        {
            progressSignal.Changed += OnWorkflowProgressed;
        }
    }

    /// <summary>
    /// Der Weckruf. Er sagt nur, dass sich <b>irgendwo</b> ein Token bewegt hat - deshalb wird hier nichts
    /// entschieden und nichts gezeichnet, sondern nur die Wartezeit beendet; nachgesehen wird danach in der
    /// Datenbank.
    /// </summary>
    /// <remarks>
    /// Laeuft auf einem fremden Thread (der Schreiber verteilt ueber den ThreadPool). Ein
    /// <c>TaskCompletionSource</c> ist genau deshalb das richtige Mittel: kein Zugriff auf den
    /// Renderer-Kontext, keine Marshalling-Frage, kein Zustand, der zwischen zwei Circuits geraten kann.
    /// </remarks>
    private void OnWorkflowProgressed(string topic)
    {
        if (disposed || !string.Equals(topic, WorkflowChangeTopics.Progress, StringComparison.OrdinalIgnoreCase))
        {
            return;
        }

        progressPulse?.TrySetResult();
    }

    /// <summary>
    /// Wartet, bis die Instanz wieder bei diesem Benutzer haelt - und oeffnet dann die Aufgabe. Ohne
    /// Ergebnis innerhalb von <see cref="WaitTimeout"/> endet der Assistent mit der Auskunft, dass der
    /// Vorgang weiterlaeuft.
    /// </summary>
    private async Task WaitForNextAsync()
    {
        DateTime deadline = DateTime.UtcNow
                            + (WaitTimeout > TimeSpan.Zero ? WaitTimeout : TimeSpan.FromSeconds(30));

        while (!disposed)
        {
            // Erst das Ereignis scharf machen, dann nachsehen: umgekehrt faellt eine Meldung, die genau
            // zwischen Nachfrage und Warten eintrifft, in die Luecke - und der Dialog wartet den ganzen
            // Takt ab, obwohl die Aufgabe schon dasteht.
            progressPulse = new TaskCompletionSource(TaskCreationOptions.RunContinuationsAsynchronously);

            if (await TryOpenNextAsync())
            {
                return;
            }

            if (DateTime.UtcNow >= deadline)
            {
                break;
            }

            // Gesammelt wird an der QUELLE (EntitySignalDebounceSettings, fuer dieses Thema per Vorgabe
            // 250 ms): ein Schwung Schreibvorgaenge kommt hier also schon als EIN Weckruf an. Diesen Dialog
            // nochmals bremsen zu lassen, hiesse zweimal dasselbe Fenster - und die Summe waere eine
            // Verzoegerung, die niemand mehr einer Einstellung zuordnen kann.
            await Task.WhenAny(progressPulse.Task, Task.Delay(PollInterval));
        }

        if (disposed)
        {
            return;
        }

        waiting = false;
        handedOn = true;
        StateHasChanged();
    }

    /// <summary>Sucht die naechste Aufgabe und oeffnet sie. False = es gibt (noch) keine.</summary>
    private async Task<bool> TryOpenNextAsync()
    {
        UserTaskListItem? next;
        try
        {
            next = await Handler.FindNextAsync(currentUser!, InstanceId, Environment);
        }
        catch (Exception ex)
        {
            // Nicht durchwerfen: der Dialog steht sonst mit einer Ausnahme im Nichts, obwohl der Vorgang
            // laeuft. Weitersuchen ist richtig - aber nur mit Spur, sonst wartet er stumm bis zum Deckel.
            LogEnvironment.LogEvent(
                $"UserTaskDialog: konnte die naechste Aufgabe der Instanz '{InstanceId}' nicht ermitteln: " +
                $"{ex.OutlineException()}", LogSeverity.Error);
            return false;
        }

        if (next is null)
        {
            return false;
        }

        waiting = false;
        await OpenAsync(next.TokenId);
        return true;
    }

    /// <summary>
    /// Oeffnet eine Aufgabe in diesem Mantel: Beschreibung holen, Maske bestimmen, weiche Sperre setzen.
    /// </summary>
    /// <remarks>
    /// Auch der Weg fuer den WECHSEL im fortlaufenden Betrieb - deshalb wird hier alles zurueckgesetzt, was
    /// zur vorigen Aufgabe gehoerte. Die beiden Masken-Verweise ausdruecklich mit: sie zeigen sonst noch auf
    /// die alte Maske, und der Erledigen-Knopf fragte die falsche nach ihren Werten.
    /// </remarks>
    private async Task OpenAsync(string tokenId)
    {
        currentTokenId = tokenId;
        taskContext = null;
        customView = null;
        form = null;
        dynamicView = null;
        claimWarning = null;
        completed = false;
        handedOn = false;

        UserTaskDescriptor? descriptor =
            await Handler.GetTaskAsync(currentUser!, InstanceId, tokenId, Environment);
        if (descriptor is null)
        {
            StateHasChanged();
            return;
        }

        customView = ResolveView(descriptor);
        taskContext = new WorkflowTaskContext(descriptor, CompleteAsync, Translate);
        assistantSession |= LeadsOn;

        string? foreignOwner = await Handler.ClaimAsync(currentUser!, InstanceId, tokenId, ClaimDuration, Environment);
        claimed = true;
        if (!string.IsNullOrEmpty(foreignOwner))
        {
            claimWarning = string.Format(L["ClaimedByOther"], foreignOwner,
                DateTime.Now.ToString("t", CultureInfo.CurrentCulture));
        }

        StateHasChanged();
    }

    /// <summary>Der Titel der aktuellen Aufgabe - schon uebersetzt und formatiert.</summary>
    private string? TaskTitle => taskContext?.Title;

    /// <summary>
    /// Fuehrt dieser Dialog nach dem Abschluss weiter? Der Aufrufer kann es sagen; sonst entscheidet die
    /// AKTUELLE Aufgabe.
    /// </summary>
    /// <remarks>
    /// Bewusst an der gerade offenen Aufgabe und nicht einmal beim Oeffnen festgelegt: so endet der
    /// gefuehrte Ablauf von selbst, sobald ein Schritt nicht mehr dazugehoert - auch ohne dass jemand
    /// <c>EndsAssistant</c> gepflegt hat. Der Schritt wird dann noch normal gezeigt (er ist geladen und
    /// gehoert diesem Benutzer); danach ist Schluss.
    /// </remarks>
    private bool LeadsOn => Continuous ?? taskContext?.Descriptor.RunsInAssistant ?? false;

    /// <summary>
    /// Findet die Maske: ausdruecklicher <c>ViewKey</c>, sonst die Aufgabenart, sonst die generische
    /// Maske. Ein Schluessel, den niemand registriert hat, faellt ebenfalls auf die generische Maske
    /// zurueck - aber mit Log-Zeile: sonst sieht der Modellierer nur ein unerwartetes Formular und
    /// niemand erfaehrt, dass seine Registrierung fehlt.
    /// </summary>
    private Type? ResolveView(UserTaskDescriptor descriptor)
    {
        WorkflowTaskViewConfiguration registry = ViewRegistry.Value;
        Type? byViewKey = registry.GetTaskViewType(descriptor.ViewKey);
        if (byViewKey is not null)
        {
            return byViewKey;
        }

        if (!string.IsNullOrWhiteSpace(descriptor.ViewKey))
        {
            LogEnvironment.LogEvent(
                $"Workflow task '{descriptor.TaskKey}' (node '{descriptor.NodeId}') requests the view key " +
                $"'{descriptor.ViewKey}', but no component is registered for it - falling back to the generic " +
                "form. Register it via ConfigureWorkflowTaskViews.", LogSeverity.Warning);
        }

        return registry.GetTaskViewType(descriptor.TaskKey);
    }

    private string? Translate(string value)
        => value.Translate(CultureInfo.CurrentUICulture?.Name);

    /// <summary>
    /// Der Erledigen-Knopf der Fusszeile: er fragt die Maske nach ihren Ausgabewerten und schliesst
    /// damit ab. Fuer die generische und eine eigene Maske derselbe Weg - der Mantel weiss nicht, was
    /// im Inhalt steht, und muss es auch nicht.
    /// </summary>
    private async Task CompleteFromViewAsync()
    {
        IUserTaskView? view = customView is null ? form : dynamicView?.Instance as IUserTaskView;
        if (view is null)
        {
            // Kann ueber die Registrierung nicht passieren (RegisterTaskView verlangt den Vertrag
            // schon beim Uebersetzen) - aber still danebengreifen darf es trotzdem nicht.
            LogEnvironment.LogEvent(
                $"UserTaskDialog: the view for task '{taskContext?.TaskKey}' (instance " +
                $"'{InstanceId}', token '{currentTokenId}') does not implement IUserTaskView - the task cannot " +
                "be completed from the dialog.", LogSeverity.Error);
            Snackbar.Add(L["ViewCannotComplete"], Severity.Error);
            return;
        }

        UserTaskViewResult result = await view.ResolveActivityAsync();
        if (!result.CanComplete)
        {
            // Ohne Meldung hat die Maske die fehlenden Stellen selbst markiert - dann waere eine
            // Einblendung nur Laerm.
            if (!string.IsNullOrEmpty(result.Message))
            {
                Snackbar.Add(result.Message, Severity.Warning);
            }

            return;
        }

        await CompleteAsync(result.Outputs);
    }

    /// <summary>
    /// Der EINE Abschlussweg - auch fuer eigene Masken. Er kapselt Doppel-Klick-Schutz, die Meldung je
    /// Ausgang und - je nach Betriebsart - das Schliessen des Dialogs oder den Uebergang zum naechsten
    /// Schritt.
    /// </summary>
    private async Task<UserTaskCompletionStatus> CompleteAsync(IDictionary<string, object>? result)
    {
        if (busy || completed)
        {
            return UserTaskCompletionStatus.AlreadyCompleted;
        }

        busy = true;
        try
        {
            UserTaskCompletionResult completion =
                await Handler.CompleteAsync(currentUser!, InstanceId, currentTokenId, result, Environment);
            switch (completion.Status)
            {
                case UserTaskCompletionStatus.Completed:
                    completed = true;
                    Snackbar.Add(L["Completed"], Severity.Success);
                    break;
                case UserTaskCompletionStatus.AlreadyCompleted:
                    completed = true;
                    Snackbar.Add(L["AlreadyCompleted"], Severity.Warning);
                    break;
                case UserTaskCompletionStatus.Faulted:
                    completed = true;
                    Snackbar.Add(L["CompletionFaulted"], Severity.Error);
                    break;
                default:
                    Snackbar.Add(L["TaskGone"], Severity.Warning);
                    break;
            }

            if (!completed)
            {
                return completion.Status;
            }

            claimed = false; // Mit dem Abschluss ist die Sperre gegenstandslos (der Store raeumt sie ab).

            // Weiter geht es nur nach einem ECHTEN Abschluss. Nach "war schon erledigt" hat dieser Benutzer
            // den Zweig nicht bewegt, und ein Fault braucht Aufmerksamkeit statt des naechsten Schritts -
            // in beiden Faellen waere ein Weiterspringen eine Behauptung ueber einen Vorgang, die nicht
            // stimmt.
            //
            // EndsAssistant kommt aus dem Modell (UserActivityNode): der Knoten sagt, dass mit ihm der
            // gefuehrte Teil endet. Ohne das liefe der Assistent durch den ganzen Prozess weiter - bei
            // dreissig Schritten, von denen fuenf gefuehrt sind, ist das genau falsch herum.
            if (LeadsOn && completion.Status == UserTaskCompletionStatus.Completed
                        && !completion.EndsAssistant)
            {
                taskContext = null;
                completed = false;
                waiting = true;
                StateHasChanged();
                await WaitForNextAsync();
                return completion.Status;
            }

            MudDialog.Close(DialogResult.Ok(true));
            return completion.Status;
        }
        finally
        {
            busy = false;
        }
    }

    private async Task CloseAsync()
    {
        await ReleaseClaimAsync();
        MudDialog.Close(DialogResult.Ok(false));
    }

    /// <summary>
    /// Gibt die weiche Sperre frei, wenn der Dialog verschwindet - auch, wenn der Benutzer ihn mit Escape
    /// oder einem Klick daneben schliesst. Ohne das blieben Aufgaben bis zum Ablauf der Frist als
    /// "wird bearbeitet" markiert. Beendet ausserdem ein laufendes Warten und das Weckruf-Abo.
    /// </summary>
    public async ValueTask DisposeAsync()
    {
        disposed = true;
        if (progressSignal is not null)
        {
            progressSignal.Changed -= OnWorkflowProgressed;
        }

        // Ein Wartender haengt womoeglich gerade am Takt - ihn zu wecken beendet die Schleife sofort
        // (sie prueft danach 'disposed'), statt bis zum naechsten Tick weiterzulaufen.
        progressPulse?.TrySetResult();

        await ReleaseClaimAsync();
    }

    private async Task ReleaseClaimAsync()
    {
        if (!claimed || currentUser is null || string.IsNullOrEmpty(currentTokenId))
        {
            return;
        }

        claimed = false;
        try
        {
            await Handler.ReleaseClaimAsync(currentUser, InstanceId, currentTokenId, Environment);
        }
        catch (Exception ex)
        {
            // Die Freigabe ist Aufraeumarbeit und darf das Schliessen nicht verhindern (der Circuit kann
            // beim Dispose auch schon weg sein) - stillschweigen darf sie aber nicht: sonst bliebe die
            // Aufgabe ohne erkennbaren Grund gesperrt.
            LogEnvironment.LogEvent(
                $"Konnte die Bearbeitungs-Markierung der Aufgabe '{InstanceId}/{currentTokenId}' nicht " +
                $"freigeben: {ex.OutlineException()}", LogSeverity.Warning);
        }
    }
}
