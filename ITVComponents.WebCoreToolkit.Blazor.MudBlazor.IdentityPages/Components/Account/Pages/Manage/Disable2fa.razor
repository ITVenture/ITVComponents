@page "/Account/Manage/Disable2fa"
@rendermode @(RenderMode.InteractiveServer)

@layout ManageLayout
@attribute [Microsoft.AspNetCore.Authorization.Authorize]

@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.Extensions.Localization
@using Microsoft.Extensions.Logging
@using ITVComponents.WebCoreToolkit.Blazor.MudBlazor.IdentityPages.Components.Account.Shared
@using ITVComponents.WebCoreToolkit.IdentityShared.Areas.Identity
@using ITVComponents.WebCoreToolkit.IdentityShared.Areas.Identity.Pages.Account.Manage
@using ITVComponents.WebCoreToolkit.IdentityShared.PageHandlers.Identity.Account.Manage

@inject IPageHandlerProvider<Disable2faModel, IDisable2faHandler> HandlerProvider
@inject AuthenticationStateProvider AuthState
@inject IStringLocalizer<IdentityMessages> L
@inject ILogger<Disable2fa> Logger
@inject NavigationManager Nav

<PageTitle>@L["Disable two-factor authentication (2FA)"]</PageTitle>

<MudText Typo="Typo.h5" GutterBottom="true">@L["Disable two-factor authentication (2FA)"]</MudText>

@if (loading)
{
    <MudProgressCircular Indeterminate="true" />
}
else if (!usePage)
{
    <MudAlert Severity="Severity.Info">@L["This page is not available."]</MudAlert>
}
else if (notFound)
{
    <MudAlert Severity="Severity.Error">@notFoundMessage</MudAlert>
}
else if (!is2faEnabled)
{
    <MudAlert Severity="Severity.Warning">
        @L["Cannot disable 2FA for user with ID '{0}' as it's not currently enabled.", userId]
    </MudAlert>
}
else
{
    <MudAlert Severity="Severity.Warning" Class="mb-3">
        <strong>@L["This action only disables 2FA."]</strong>
        <div>
            @L["Disabling 2FA does not change the keys used in authenticator apps. If you wish to change the key used in an authenticator app you should "]
            <MudLink Href="Account/Manage/ResetAuthenticator">@L["reset your authenticator keys."]</MudLink>
        </div>
    </MudAlert>

    <MudButton Variant="Variant.Filled" Color="Color.Error" Disabled="@busy" OnClick="OnSubmit">
        @L["Disable 2FA"]
    </MudButton>
}

@code {
    private bool loading = true;
    private bool usePage;
    private bool notFound;
    private string? notFoundMessage;
    private bool is2faEnabled;
    private bool busy;
    private string userId = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        await using var op = HandlerProvider.BeginOperation();
        usePage = op.Handler.UsePage;
        if (!usePage)
        {
            loading = false;
            return;
        }

        var principal = (await AuthState.GetAuthenticationStateAsync()).User;
        userId = op.Handler.GetUserId(principal) ?? string.Empty;
        var user = await op.Handler.FetchUser(principal);
        if (!user.UserExists)
        {
            notFound = true;
            notFoundMessage = L["Unable to load user with ID '{0}'.", userId];
            loading = false;
            return;
        }

        try
        {
            is2faEnabled = user.TwoFactorEnabled;
        }
        finally
        {
            op.Handler.ReleaseUser(user);
            loading = false;
        }
    }

    private async Task OnSubmit()
    {
        await using var op = HandlerProvider.BeginOperation();
        busy = true;
        var principal = (await AuthState.GetAuthenticationStateAsync()).User;
        var user = await op.Handler.FetchUser(principal);
        try
        {
            if (!user.UserExists)
            {
                notFound = true;
                notFoundMessage = L["Unable to load user with ID '{0}'.", userId];
                return;
            }

            var result = await op.Handler.SetTwoFactorEnabled(user, false);
            if (!result.Succeeded)
            {
                notFoundMessage = L["Unexpected error occurred disabling 2FA for user with ID '{0}'.", userId];
                notFound = true;
                return;
            }

            Logger.LogInformation("User with ID '{UserId}' has disabled 2fa.", userId);

            // SetTwoFactorEnabledAsync stempelt den Security-Stamp neu. Die statische Fassung navigierte hier
            // nur weiter und liess das Cookie stehen - der Stamp-Validator haette den Benutzer beim naechsten
            // Intervall abgemeldet. Der Ruecksprung stellt es frisch aus.
            ManageRedirects.RefreshSignIn(Nav, "Account/Manage/TwoFactorAuthentication",
                L["2fa has been disabled. You can reenable 2fa when you setup an authenticator app"].Value);
        }
        finally
        {
            op.Handler.ReleaseUser(user);
            busy = false;
        }
    }
}
