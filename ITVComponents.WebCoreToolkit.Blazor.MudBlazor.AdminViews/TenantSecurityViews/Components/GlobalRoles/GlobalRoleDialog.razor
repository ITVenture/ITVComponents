<EditDialogShell Model="Model" IsCreate="IsCreate" InvalidMessage="Please correct invalid fields">
    <MudTextField @bind-Value="Model.RoleName" Label="Name" Required="true" MaxLength="200" />
    <MudTextField @bind-Value="Model.RoleDescription" Label="Description" MaxLength="512" Lines="2" />
</EditDialogShell>

@code {
    [Parameter, EditorRequired] public GlobalRoleViewModel Model { get; set; } = default!;
    [Parameter] public bool IsCreate { get; set; }
}
