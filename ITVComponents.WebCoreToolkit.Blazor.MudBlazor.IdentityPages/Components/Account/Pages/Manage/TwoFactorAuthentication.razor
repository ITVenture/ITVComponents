@page "/Account/Manage/TwoFactorAuthentication"
@rendermode @(RenderMode.InteractiveServer)

@layout ManageLayout
@attribute [Microsoft.AspNetCore.Authorization.Authorize]

@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.Extensions.Localization
@using Microsoft.Extensions.Logging
@using ITVComponents.WebCoreToolkit.Blazor.MudBlazor.IdentityPages.Components.Account.Shared
@using ITVComponents.WebCoreToolkit.IdentityShared.Areas.Identity
@using ITVComponents.WebCoreToolkit.IdentityShared.Areas.Identity.Pages.Account.Manage
@using ITVComponents.WebCoreToolkit.IdentityShared.PageHandlers.Identity.Account.Manage

@inject IPageHandlerProvider<TwoFactorAuthenticationModel, ITwoFactorAuthenticationHandler> HandlerProvider
@inject AuthenticationStateProvider AuthState
@inject IStringLocalizer<IdentityMessages> L
@inject NavigationManager Nav

<PageTitle>@L["Two-factor authentication (2FA)"]</PageTitle>

<MudText Typo="Typo.h5" GutterBottom="true">@L["Two-factor authentication (2FA)"]</MudText>

@if (loading)
{
    <MudProgressCircular Indeterminate="true" />
}
else if (notFound)
{
    <MudAlert Severity="Severity.Error">@notFoundMessage</MudAlert>
}
else
{
    @if (!string.IsNullOrEmpty(StatusMessage))
    {
        <MudAlert Severity="Severity.Info" Class="mb-3">@StatusMessage</MudAlert>
    }

    @if (is2faEnabled)
    {
        @if (recoveryCodesLeft == 0)
        {
            <MudAlert Severity="Severity.Error" Class="mb-3">
                <strong>@L["You have no recovery codes left."]</strong>
                <div>
                    <MudLink Href="Account/Manage/GenerateRecoveryCodes">@L["You must generate a new set of recovery codes before you can log in with a recovery code."]</MudLink>
                </div>
            </MudAlert>
        }
        else if (recoveryCodesLeft <= 3)
        {
            <MudAlert Severity="Severity.Warning" Class="mb-3">
                <strong>@L["You have {0} recovery codes left.", recoveryCodesLeft]</strong>
                <div>
                    <MudLink Href="Account/Manage/GenerateRecoveryCodes">@L["You should generate a new set of recovery codes."]</MudLink>
                </div>
            </MudAlert>
        }

        @* "Browser vergessen" loescht ein Cookie - das geht nur ueber den Endpunkt, nicht auf dem Circuit.
           Angezeigt wird der Knopf bei "gemerkt" UND bei "unbekannt" (null): ob dieser Browser gemerkt ist,
           steht ebenfalls in einem Cookie, und das ist nur waehrend einer Anfrage zu lesen. Kam die Seite
           ohne Vorab-Rendering herein, bleibt die Frage offen - dann lieber einen folgenlosen Knopf zu viel
           als einen fehlenden. *@
        @if (MachineRemembered != false)
        {
            <MudButton Variant="Variant.Outlined" Class="mr-2" Disabled="@busy" OnClick="OnForgetBrowser">@L["Forget this browser"]</MudButton>
        }

        <MudButton Href="Account/Manage/Disable2fa" Variant="Variant.Outlined" Class="mr-2">@L["Disable 2FA"]</MudButton>
        <MudButton Href="Account/Manage/GenerateRecoveryCodes" Variant="Variant.Outlined">@L["Reset recovery codes"]</MudButton>
    }

    <MudText Typo="Typo.h6" Class="mt-4" GutterBottom="true">@L["Authenticator app"]</MudText>

    @if (!hasAuthenticator)
    {
        <MudButton Href="Account/Manage/EnableAuthenticator" Variant="Variant.Outlined">@L["Add authenticator app"]</MudButton>
    }
    else
    {
        <MudButton Href="Account/Manage/EnableAuthenticator" Variant="Variant.Outlined" Class="mr-2">@L["Setup authenticator app"]</MudButton>
        <MudButton Href="Account/Manage/ResetAuthenticator" Variant="Variant.Outlined">@L["Reset authenticator app"]</MudButton>
    }
}

@code {
    private bool notFound;
    private string? notFoundMessage;
    private bool hasAuthenticator;
    private int recoveryCodesLeft;
    private bool is2faEnabled;
    private bool loading = true;
    private bool busy;

    /// <summary>
    /// Ob dieser Browser fuer die Zwei-Faktor-Anmeldung gemerkt ist. Die Antwort steht in einem Cookie und
    /// ist nur waehrend einer Anfrage zu lesen - auf dem Circuit nicht. Sie entsteht darum im
    /// Vorab-Rendering und wird von dort herueber getragen ([PersistentState]).
    ///
    /// <c>null</c> heisst "unbekannt", nicht "nein": bei interner Navigation im Blazor-Router findet kein
    /// Vorab-Rendering statt, dann kommt hier nichts an. Die Anzeige rechnet damit.
    /// </summary>
    [PersistentState]
    public bool? MachineRemembered { get; set; }

    [SupplyParameterFromQuery(Name = "status")]
    private string? StatusMessage { get; set; }

    protected override async Task OnInitializedAsync()
    {
        await using var op = HandlerProvider.BeginOperation();
        var principal = (await AuthState.GetAuthenticationStateAsync()).User;
        var user = await op.Handler.FetchUser(principal);
        if (!user.UserExists)
        {
            notFound = true;
            notFoundMessage = L["Unable to load user with ID '{0}'.", op.Handler.GetUserId(principal)];
            loading = false;
            return;
        }

        try
        {
            hasAuthenticator = user.IsAuthenticatorConfigured;
            is2faEnabled = user.TwoFactorEnabled;
            recoveryCodesLeft = user.RecoveryCodesLeft;

            // Nur belegen, wenn nichts herueber getragen wurde - sonst ueberschriebe der interaktive
            // Durchlauf den im Vorab-Rendering ermittelten Wert mit seinem eigenen "unbekannt".
            MachineRemembered ??= user.MachineRememberForTwoFactor;
        }
        finally
        {
            op.Handler.ReleaseUser(user);
            loading = false;
        }
    }

    private void OnForgetBrowser()
    {
        busy = true;
        ManageRedirects.ForgetBrowser(Nav, "Account/Manage/TwoFactorAuthentication",
            L["The current browser has been forgotten. When you login again from this browser you will be prompted for your 2fa code."].Value);
    }
}
