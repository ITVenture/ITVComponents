@page "/Account/Manage/DeletePersonalData"
@rendermode @(RenderMode.InteractiveServer)

@layout ManageLayout
@attribute [Microsoft.AspNetCore.Authorization.Authorize]

@using System.ComponentModel.DataAnnotations
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.Extensions.Localization
@using Microsoft.Extensions.Logging
@using ITVComponents.WebCoreToolkit.Blazor.MudBlazor.IdentityPages.Components.Account.Shared
@using ITVComponents.WebCoreToolkit.IdentityShared.Areas.Identity
@using ITVComponents.WebCoreToolkit.IdentityShared.Areas.Identity.Pages.Account.Manage
@using ITVComponents.WebCoreToolkit.IdentityShared.PageHandlers.Identity.Account.Manage

@inject IPageHandlerProvider<DeletePersonalDataModel, IDeletePersonalDataHandler> HandlerProvider
@inject AuthenticationStateProvider AuthState
@inject IStringLocalizer<IdentityMessages> L
@inject ILogger<DeletePersonalData> Logger
@inject NavigationManager Nav

<PageTitle>@L["Delete Personal Data"]</PageTitle>

<MudText Typo="Typo.h5" GutterBottom="true">@L["Delete Personal Data"]</MudText>

@if (loading)
{
    <MudProgressCircular Indeterminate="true" />
}
else if (!usePage)
{
    <MudAlert Severity="Severity.Info">@L["This page is not available."]</MudAlert>
}
else if (notFound)
{
    <MudAlert Severity="Severity.Error">@notFoundMessage</MudAlert>
}
else
{
    <MudAlert Severity="Severity.Warning" Class="mb-3">
        <strong>@L["Deleting this data will permanently remove your account, and this cannot be recovered."]</strong>
    </MudAlert>

    <EditForm Model="Input" OnValidSubmit="OnSubmit">
        <ToolkitDataAnnotationsValidator />

        @if (errors.Count > 0)
        {
            <MudAlert Severity="Severity.Error" Class="mb-3">
                @foreach (var err in errors) { <div>@err</div> }
            </MudAlert>
        }

        @if (requirePassword)
        {
            <MudTextField @bind-Value="Input.Password" Label="@L["Password"]" For="@(() => Input.Password)"
                          InputType="InputType.Password" autocomplete="current-password" Class="mb-3" />
        }

        <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Error" Disabled="@busy">
            @L["Delete data and close my account"]
        </MudButton>
    </EditForm>
}

@code {
    private bool loading = true;
    private bool usePage;
    private bool notFound;
    private string? notFoundMessage;
    private bool requirePassword;
    private bool busy;
    private List<string> errors = new();

    private InputModel Input { get; set; } = new();

    protected override async Task OnInitializedAsync()
    {
        await using var op = HandlerProvider.BeginOperation();
        usePage = op.Handler.UsePage;
        if (!usePage)
        {
            loading = false;
            return;
        }

        var principal = (await AuthState.GetAuthenticationStateAsync()).User;
        var user = await op.Handler.FetchUser(principal);
        try
        {
            if (!user.UserExists)
            {
                notFound = true;
                notFoundMessage = L["Unable to load user with ID '{0}'.", op.Handler.GetUserId(principal)];
                return;
            }
            requirePassword = user.HasPassword;
        }
        finally
        {
            op.Handler.ReleaseUser(user);
            loading = false;
        }
    }

    private async Task OnSubmit()
    {
        await using var op = HandlerProvider.BeginOperation();
        busy = true;
        errors.Clear();
        var principal = (await AuthState.GetAuthenticationStateAsync()).User;
        var user = await op.Handler.FetchUser(principal);
        try
        {
            if (!user.UserExists)
            {
                notFound = true;
                notFoundMessage = L["Unable to load user with ID '{0}'.", op.Handler.GetUserId(principal)];
                return;
            }

            requirePassword = user.HasPassword;
            if (requirePassword)
            {
                if (!await op.Handler.CheckPassword(user, Input.Password))
                {
                    errors = new() { L["Incorrect password."] };
                    return;
                }
            }

            // signOut: false â€” die Abmeldung schreibt ein Cookie und geht auf dem Circuit nicht. Sie folgt
            // unmittelbar ueber den Endpunkt; bis dahin zeigt der Cookie auf ein geloeschtes Konto, was nur
            // fuer die Dauer dieser einen Weiterleitung gilt.
            var dropResult = await op.Handler.DeleteAccount(user, signOut: false);
            if (!dropResult.UserDeleted)
            {
                errors = new() { L["Unexpected error occurred deleting user with ID '{0}'.", dropResult.UserId] };
                return;
            }

            Logger.LogInformation("User with ID '{UserId}' deleted themselves.", dropResult.UserId);
            ManageRedirects.SignOut(Nav);
        }
        finally
        {
            op.Handler.ReleaseUser(user);
            busy = false;
        }
    }

    public sealed class InputModel
    {
        [Required]
        [DataType(DataType.Password)]
        public string Password { get; set; } = "";
    }
}
