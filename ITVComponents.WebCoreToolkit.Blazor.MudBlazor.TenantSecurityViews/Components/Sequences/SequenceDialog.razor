@inject ISnackbar Snackbar

<MudDialog>
    <DialogContent>
        <MudForm @ref="form" Model="Model">
            <MudTextField @bind-Value="Model.SequenceName" Label="Name" Required="true" MaxLength="300" />
            <MudNumericField @bind-Value="Model.MinValue" Label="Min value" />
            <MudNumericField @bind-Value="Model.MaxValue" Label="Max value" />
            <MudNumericField @bind-Value="Model.StepSize" Label="Step size" Min="1" />
            <MudCheckBox @bind-Value="Model.Cycle" Label="Cycle" />
            @if (!IsCreate)
            {
                <MudNumericField Value="Model.CurrentValue" Label="Current value" Disabled="true" />
            }
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Cancel</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="Save">@(IsCreate ? "Create" : "Save")</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;
    [Parameter, EditorRequired] public SequenceViewModel Model { get; set; } = default!;
    [Parameter] public bool IsCreate { get; set; }

    private MudForm? form;

    private async Task Save()
    {
        if (form is null) return;
        await form.Validate();
        if (!form.IsValid) { Snackbar.Add("Please correct invalid fields", Severity.Warning); return; }
        MudDialog.Close(DialogResult.Ok(Model));
    }

    private void Cancel() => MudDialog.Cancel();
}
