@namespace ITVComponents.WebCoreToolkit.Blazor.MudBlazor.AdminViews.OnboardingViews.Components.Shared
@inject IStringLocalizer<OnboardingMessages> L

@* Reusable billing-profile editor. The ProfileType toggle drives which set of personal-vs-company
   fields is shown; the @bind on each field still posts to the same view model so a host can switch
   between strategies without losing in-flight data. Address sub-cards stack vertically; the invoice
   address is gated by UseInvoiceAddr. Parent-tenant picker is only rendered for hierarchy hosts. *@

<MudPaper Class="pa-4 mb-3" Outlined="true">
    <MudStack Spacing="3">
        <MudToggleGroup T="ProfileType" SelectionMode="SelectionMode.SingleSelection" Value="Model.ProfileType" ValueChanged="OnProfileTypeChanged" Color="Color.Primary">
            <MudToggleItem Value="@ProfileType.Personal" Text="@(L["Onb_Personal"])" />
            <MudToggleItem Value="@ProfileType.Company" Text="@(L["Onb_Company"])" />
        </MudToggleGroup>

        @if (Model.ProfileType == ProfileType.Personal)
        {
            <MudGrid Spacing="2">
                <MudItem xs="12" sm="6">
                    <MudTextField @bind-Value="Model.FirstName" Label="@(L["Onb_FirstName"])" For="@(() => Model.FirstName)" />
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudTextField @bind-Value="Model.LastName" Label="@(L["Onb_LastName"])" For="@(() => Model.LastName)" />
                </MudItem>
            </MudGrid>
        }
        else
        {
            <MudGrid Spacing="2">
                <MudItem xs="12" sm="8">
                    <MudTextField @bind-Value="Model.CompanyName" Label="@(L["Onb_CompanyName"])" For="@(() => Model.CompanyName)" />
                </MudItem>
                <MudItem xs="12" sm="4">
                    <MudTextField @bind-Value="Model.VatNumber" Label="@(L["Onb_VatNumber"])" For="@(() => Model.VatNumber)" />
                </MudItem>
            </MudGrid>
        }

        <MudGrid Spacing="2">
            <MudItem xs="12" sm="6">
                <MudTextField @bind-Value="Model.Email" Label="@(L["Onb_ContactEmail"])" For="@(() => Model.Email)" />
            </MudItem>
            <MudItem xs="12" sm="6">
                <MudTextField @bind-Value="Model.PhoneNumber" Label="@(L["Onb_Phone"])" For="@(() => Model.PhoneNumber)" />
            </MudItem>
        </MudGrid>
    </MudStack>
</MudPaper>

@if (ShowParentTenantPicker)
{
    <MudPaper Class="pa-4 mb-3" Outlined="true">
        <MudSelect T="int?" Value="Model.ParentTenantId" ValueChanged="v => Model.ParentTenantId = v"
                   Label="@(L["Onb_ParentTenant"])" Clearable="@(!ParentRequired)" Required="@ParentRequired" Dense="true">
            @foreach (var t in EligibleParents)
            {
                <MudSelectItem T="int?" Value="@((int?)t.TenantId)">@t.DisplayName</MudSelectItem>
            }
        </MudSelect>
        <MudText Typo="Typo.caption" Class="mt-1">@L["Onb_ParentHint"]</MudText>
    </MudPaper>
}

<AddressEditor Title="@(L["Onb_DefaultAddress"])" Address="Model.DefaultAddress" />

<MudPaper Class="pa-4 mb-3" Outlined="true">
    <MudSwitch T="bool" Value="Model.UseInvoiceAddr" ValueChanged="v => Model.UseInvoiceAddr = v"
               Label="@(L["Onb_UseInvoiceAddr"])" Color="Color.Primary" />
</MudPaper>

@if (Model.UseInvoiceAddr)
{
    <AddressEditor Title="@(L["Onb_InvoiceAddress"])" Address="Model.InvoiceAddress" />
}

<MudPaper Class="pa-4 mb-3" Outlined="true">
    <MudCheckBox T="bool" Value="Model.AcceptTos" ValueChanged="v => Model.AcceptTos = v"
                 Label="@(L["Onb_AcceptTos"])" Color="Color.Primary" />
</MudPaper>

@code {
    [Parameter, EditorRequired] public BillingProfileViewModel Model { get; set; } = default!;

    /// <summary>Set by the host page to render the parent-tenant picker when the hierarchy strategy is active.</summary>
    [Parameter] public bool ShowParentTenantPicker { get; set; }

    /// <summary>When true, a parent tenant must be picked (roots disallowed, no default fallback configured).</summary>
    [Parameter] public bool ParentRequired { get; set; }

    /// <summary>Tenants the user may pick as a parent. Empty for the flat strategy.</summary>
    [Parameter] public IReadOnlyList<TenantPickerItem> EligibleParents { get; set; } = Array.Empty<TenantPickerItem>();

    private void OnProfileTypeChanged(ProfileType type)
    {
        Model.ProfileType = type;
        if (type == ProfileType.Personal)
        {
            Model.CompanyName = null;
            Model.VatNumber = null;
        }
        else
        {
            Model.FirstName = null;
            Model.LastName = null;
        }
    }
}
