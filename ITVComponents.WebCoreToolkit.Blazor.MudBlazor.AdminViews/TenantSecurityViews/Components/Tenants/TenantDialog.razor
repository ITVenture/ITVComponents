<EditDialogShell Model="Model" IsCreate="IsCreate">
    <MudTextField @bind-Value="Model.TenantName" Label="Tenant name" Required="true" RequiredError="Tenant name is required" />
    <MudTextField @bind-Value="Model.DisplayName" Label="Display name" />
    <MudTextField @bind-Value="Model.TimeZone" Label="Time zone" Placeholder="e.g. Europe/Zurich" />
    <ForeignKeySelect T="int?" @bind-Value="Model.TenantTypeId" Table="TenantTypes" Label="Tenant type" />
    @if (UseHierarchy)
    {
        <ForeignKeySelect T="int?" @bind-Value="Model.ParentTenantId" Table="Tenants" Label="Parent tenant" />
    }
</EditDialogShell>

@code {
    [Parameter, EditorRequired] public TenantViewModel Model { get; set; } = default!;
    [Parameter] public bool IsCreate { get; set; }
    [Parameter] public bool UseHierarchy { get; set; }
}
