@page "/Workflow/Instances"
@page "/Workflow/env/{Environment}/Instances"
@rendermode @(RenderMode.InteractiveServer)
@attribute [Microsoft.AspNetCore.Authorization.Authorize]

@inject IWorkflowMonitorHandler Handler
@inject AuthenticationStateProvider AuthState
@inject IDialogService DialogService
@inject ISnackbar Snackbar

<PageTitle>Workflow instances</PageTitle>

<MudText Typo="Typo.h5" GutterBottom="true">Workflow instances</MudText>

<SecureView RequiredPermissions="Workflow.Monitor" RequiredFeatures="ITVWorkflow">
    <Permitted>
        @if (currentUser is null)
        {
            <MudProgressCircular Indeterminate="true" />
        }
        else
        {
            <MudDataGrid T="WorkflowInstanceListItem"
                         @ref="grid"
                         ServerData="LoadData"
                         SortMode="SortMode.Single"
                         RowsPerPage="25"
                         Hover="true"
                         Dense="true">
                <ToolBarContent>
                    <MudIconButton Icon="@Icons.Material.Filled.Refresh" Title="Refresh" OnClick="ReloadGrid" />
                    <MudText Typo="Typo.h6">Instances</MudText>
                    @if (Environment is null)
                    {
                        <div class="ml-3">
                            <WorkflowEnvironmentPicker Value="@pickedEnvironment" ValueChanged="OnEnvChanged"
                                                       Required="Admin" />
                        </div>
                    }
                    else
                    {
                        <MudChip T="string" Icon="@Icons.Material.Filled.Dns" Size="Size.Small" Class="ml-3">@Environment</MudChip>
                    }
                    @* Der einzige UI-Weg, einen Prozess von Hand zu eroeffnen. Eigenes Recht: einen neuen
                       Geschaeftsfall anzulegen ist etwas anderes als Zusehen oder Eingreifen. *@
                    <SecureView RequiredPermissions="Workflow.Start">
                        <Permitted>
                            <MudButton StartIcon="@Icons.Material.Filled.PlayArrow" Size="Size.Small"
                                       Variant="Variant.Filled" Color="Color.Primary" Class="ml-3"
                                       OnClick="OpenStart">New instance</MudButton>
                        </Permitted>
                    </SecureView>
                    <MudSpacer />
                    <MudSelect T="int?" @bind-Value="statusFilter" Label="Status" Clearable="true" Dense="true"
                               Style="max-width:170px" Margin="Margin.Dense" OnClearButtonClick="ReloadGrid">
                        @foreach (var status in Enum.GetValues<WorkflowStatus>())
                        {
                            <MudSelectItem T="int?" Value="@((int?)(int)status)">@status</MudSelectItem>
                        }
                    </MudSelect>
                    <MudTextField @bind-Value="search"
                                  Placeholder="Search id / definition / correlation…"
                                  Adornment="Adornment.Start"
                                  AdornmentIcon="@Icons.Material.Filled.Search"
                                  Class="mt-0 ml-2"
                                  DebounceInterval="300"
                                  OnDebounceIntervalElapsed="ReloadGrid" />
                </ToolBarContent>
                <Columns>
                    <PropertyColumn Property="x => x.DefinitionId" Title="Definition" />
                    <PropertyColumn Property="x => x.DefinitionVersion" Title="Ver" />
                    <PropertyColumn Property="x => x.Status" Title="Status">
                        <CellTemplate>
                            <MudText Typo="Typo.body2">@context.Item.Status</MudText>
                            @if (context.Item.Suspended)
                            {
                                @* Angehalten steht NEBEN dem Status, nicht darin: die Instanz behaelt
                                   ihren Status und wird nur nicht mehr vorangetrieben. Ohne dieses
                                   Kennzeichen saehe sie aus wie eine, die haengt - und genau danach
                                   wuerde jemand suchen. *@
                                <MudTooltip Text="@(context.Item.SuspendedReason ?? "Suspended")">
                                    <MudChip T="string" Size="Size.Small" Color="Color.Warning"
                                             Icon="@Icons.Material.Filled.PauseCircle">suspended</MudChip>
                                </MudTooltip>
                            }
                        </CellTemplate>
                    </PropertyColumn>
                    @* PropertyColumn (nicht TemplateColumn) mit eigener Zelle: nur so traegt die
                       Sortier-Anforderung den Spaltennamen "Priority", den der Handler kennt. Angezeigt
                       wird der Name statt der Zahl - "Low" liest sich richtig herum, "3" nicht. *@
                    <PropertyColumn Property="x => x.Priority" Title="Priority">
                        <CellTemplate>
                            <MudText Typo="Typo.body2">@WorkflowPriority.Name(context.Item.Priority)</MudText>
                        </CellTemplate>
                    </PropertyColumn>
                    <PropertyColumn Property="x => x.CorrelationKey" Title="Correlation" />
                    <PropertyColumn Property="x => x.UpdatedUtc" Title="Updated (UTC)" />
                    <TemplateColumn T="WorkflowInstanceListItem" Title="" Sortable="false">
                        <CellTemplate>
                            @* Nur bei fehlgeschlagenen Instanzen - bei allen anderen gaebe es nichts zu
                               wiederholen, und der Knopf wuerde nur zum Ausprobieren einladen. *@
                            @if (context.Item.Status == nameof(WorkflowStatus.Faulted))
                            {
                                <SecureView RequiredPermissions="Workflow.Operate">
                                    <Permitted>
                                        <MudIconButton Icon="@Icons.Material.Filled.RestartAlt" Size="Size.Small"
                                                       Color="Color.Warning" Title="Correct data and retry"
                                                       OnClick="@(() => OpenRetry(context.Item))" />
                                    </Permitted>
                                </SecureView>
                            }
                            @* Anhalten/Fortsetzen nur, solange es etwas anzuhalten gibt. Bei einer
                               beendeten Instanz lehnt die Engine ohnehin ab - der Knopf wuerde nur zum
                               Ausprobieren einladen. *@
                            @if (CanSuspend(context.Item))
                            {
                                <SecureView RequiredPermissions="Workflow.Operate">
                                    <Permitted>
                                        <MudIconButton Size="Size.Small" Color="Color.Warning"
                                                       Icon="@(context.Item.Suspended
                                                                 ? Icons.Material.Filled.PlayCircle
                                                                 : Icons.Material.Filled.PauseCircle)"
                                                       Title="@(context.Item.Suspended ? "Resume" : "Suspend")"
                                                       OnClick="@(() => ToggleSuspend(context.Item))" />
                                    </Permitted>
                                </SecureView>
                            }
                            <MudIconButton Icon="@Icons.Material.Filled.Visibility" Size="Size.Small" Title="Details"
                                           OnClick="@(() => OpenDetail(context.Item))" />
                        </CellTemplate>
                    </TemplateColumn>
                </Columns>
                <PagerContent>
                    <MudDataGridPager T="WorkflowInstanceListItem" />
                </PagerContent>
            </MudDataGrid>
        }
    </Permitted>
    <NotPermitted>
        <MudAlert Severity="Severity.Warning">No permission to view workflow instances.</MudAlert>
    </NotPermitted>
</SecureView>

@code {
    /// <summary>Die (optional) über das Nav-Segment vorgegebene Umgebung; null = Auswahl über den Picker.</summary>
    [Parameter] public string? Environment { get; set; }

    private MudDataGrid<WorkflowInstanceListItem>? grid;
    private ClaimsPrincipal? currentUser;
    private string? search;
    private int? statusFilter;
    private string? pickedEnvironment;

    /// <summary>Die wirksame Umgebung: das Nav-Segment gewinnt, sonst die Picker-Auswahl.</summary>
    private string? Env => Environment ?? pickedEnvironment;

    /// <summary>
    /// Laesst sich diese Instanz anhalten bzw. fortsetzen? Nur solange sie nicht beendet ist - dasselbe
    /// Praedikat, das die Engine durchsetzt.
    /// </summary>
    /// <remarks>
    /// <b>Faulted zaehlt dazu.</b> Eine gescheiterte Instanz ist nicht beendet, sondern haengt - und ist
    /// damit genau der Fall, in dem man sie aus dem Aufgriff nehmen will, bis jemand hingesehen hat.
    /// </remarks>
    private static bool CanSuspend(WorkflowInstanceListItem item)
        => item.Status != nameof(WorkflowStatus.Completed)
           && item.Status != nameof(WorkflowStatus.Cancelled);

    /// <summary>Haelt die Instanz an bzw. setzt sie fort und laedt die Liste neu.</summary>
    private async Task ToggleSuspend(WorkflowInstanceListItem item)
    {
        if (currentUser is null)
        {
            return;
        }

        string? reason = null;
        if (!item.Suspended)
        {
            // Nach dem Grund fragen, nicht stillschweigend anhalten: ein angehaltener Vorgang ohne
            // Begruendung ist von einem haengenden nicht zu unterscheiden, und genau danach sucht der
            // Naechste. Abbrechen im Dialog haelt nichts an.
            IDialogReference dlg = await DialogService.ShowAsync<SuspendInstanceDialog>(
                $"Suspend {item.Id}", new DialogParameters(), EditDialogDefaults.Detail);
            DialogResult? answer = await dlg.Result;
            if (answer is not { Canceled: false, Data: string given })
            {
                return;
            }

            reason = string.IsNullOrWhiteSpace(given) ? null : given;
        }

        bool ok = await Handler.SetSuspendedAsync(currentUser, item.Id, !item.Suspended, reason, Env);
        if (ok)
        {
            Snackbar.Add(item.Suspended ? $"Instance {item.Id} resumed." : $"Instance {item.Id} suspended.",
                Severity.Success);
            await ReloadGrid();
            return;
        }

        // Der haeufigste Grund ist ein gleichzeitig laufender Zweig, der das Rennen um den Commit
        // gewonnen hat - das ist kein Fehler, sondern ein "gleich nochmal".
        Snackbar.Add(
            $"Instance {item.Id} could not be {(item.Suspended ? "resumed" : "suspended")}. "
            + "It may have finished, or a branch committed at the same moment - please try again.",
            Severity.Warning);
    }

    protected override async Task OnInitializedAsync()
    {
        var auth = await AuthState.GetAuthenticationStateAsync();
        currentUser = auth.User;
    }

    private async Task<GridData<WorkflowInstanceListItem>> LoadData(GridState<WorkflowInstanceListItem> state,
        CancellationToken ct)
    {
        if (currentUser is null)
        {
            return new GridData<WorkflowInstanceListItem> { Items = Array.Empty<WorkflowInstanceListItem>(), TotalItems = 0 };
        }

        var sort = state.SortDefinitions.FirstOrDefault();
        var query = new ListQuery
        {
            Page = state.Page,
            PageSize = state.PageSize,
            SortColumn = sort?.SortBy,
            SortDescending = sort?.Descending ?? false,
            Search = search,
            Status = statusFilter
        };

        var result = await Handler.ListInstancesAsync(currentUser, query, Env);
        return new GridData<WorkflowInstanceListItem> { Items = result.Items, TotalItems = result.TotalCount };
    }

    private async Task ReloadGrid()
    {
        if (grid is not null)
        {
            await grid.ReloadServerData();
        }
    }

    /// <summary>Umgebung im Picker gewechselt (nur ohne Nav-Segment) - die Liste neu laden.</summary>
    private async Task OnEnvChanged(string? environment)
    {
        pickedEnvironment = environment;
        await ReloadGrid();
    }

    /// <summary>
    /// Oeffnet den Start-Dialog. Nach einem Start wird die Liste neu geladen - die neue Instanz soll man
    /// sofort sehen (und im Split-Betrieb erkennen, dass sie noch auf den Runner wartet).
    /// </summary>
    private async Task OpenStart()
    {
        var parameters = new DialogParameters<StartWorkflowDialog>
        {
            { d => d.Environment, Env }
        };
        IDialogReference dlg = await DialogService.ShowAsync<StartWorkflowDialog>(
            "Start a workflow", parameters, EditDialogDefaults.Detail);
        DialogResult? result = await dlg.Result;
        if (result is { Canceled: false, Data: string instanceId })
        {
            Snackbar.Add($"Instance {instanceId} started.", Severity.Success);
            await ReloadGrid();
        }
    }

    /// <summary>
    /// Oeffnet die Retry-Maske einer fehlgeschlagenen Instanz. Danach neu laden: im Inline-Betrieb ist
    /// der Schritt bereits gelaufen und der Status hat sich geaendert.
    /// </summary>
    private async Task OpenRetry(WorkflowInstanceListItem item)
    {
        var parameters = new DialogParameters<RetryWorkflowDialog>
        {
            { d => d.InstanceId, item.Id },
            { d => d.Environment, Env }
        };
        IDialogReference dlg = await DialogService.ShowAsync<RetryWorkflowDialog>(
            $"Retry {item.Id}", parameters, EditDialogDefaults.Detail);
        DialogResult? result = await dlg.Result;
        if (result is { Canceled: false, Data: true })
        {
            Snackbar.Add($"Instance {item.Id} resumed.", Severity.Success);
            await ReloadGrid();
        }
    }

    private async Task OpenDetail(WorkflowInstanceListItem item)
    {
        var parameters = new DialogParameters<WorkflowInstanceDetailDialog>
        {
            { d => d.InstanceId, item.Id },
            { d => d.Environment, Env }
        };
        var dlg = await DialogService.ShowAsync<WorkflowInstanceDetailDialog>(
            $"Instance {item.Id}", parameters, EditDialogDefaults.Detail);
        var result = await dlg.Result;
        if (result is { Canceled: false, Data: true })
        {
            await ReloadGrid();
        }
    }
}
