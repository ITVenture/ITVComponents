@*
    Reusable in-process file download. Delegates all plugin-handling (resolve, authorize, read) to the shared
    IFileServiceHandler — then streams the returned content to the browser via a DotNetStreamReference
    (no MVC /File endpoint, no pre-built redirect URL).
*@
@namespace ITVComponents.WebCoreToolkit.Blazor.SharedComponents
@using Microsoft.AspNetCore.Components.Authorization
@using ITVComponents.WebCoreToolkit.ServiceShared.FileHandling
@using ITVComponents.WebCoreToolkit.ServiceShared.Service
@using global::MudBlazor
@using Microsoft.Extensions.Logging
@implements IAsyncDisposable
@inject IJSRuntime JS
@inject IFileServiceHandler FileService
@inject AuthenticationStateProvider AuthState
@inject ILogger<FileDownload> Logger

<MudButton StartIcon="@StartIcon" Variant="@Variant" Color="@Color" OnClick="Download" Disabled="@(busy || Disabled)">
    @if (busy)
    {
        <MudProgressCircular Indeterminate="true" Size="Size.Small" Class="mr-2" />
    }
    @ButtonText
</MudButton>

@code {
    /// <summary>Name of the FileHandler plugin that serves the download (resolved in-process via DI).</summary>
    [Parameter, EditorRequired] public string DownloadModule { get; set; } = "";

    [Parameter, EditorRequired] public string DownloadReason { get; set; } = "";

    /// <summary>The file-identifier passed to the handler's ReadFile (e.g. the configuration section to export).</summary>
    [Parameter] public string FileIdentifier { get; set; } = "";

    [Parameter] public string ButtonText { get; set; } = "Download";
    [Parameter] public string StartIcon { get; set; } = Icons.Material.Filled.Download;
    [Parameter] public Variant Variant { get; set; } = Variant.Filled;
    [Parameter] public Color Color { get; set; } = Color.Primary;
    [Parameter] public bool Disabled { get; set; }

    /// <summary>Raised when the download could not be served (handler missing or file not found).</summary>
    [Parameter] public EventCallback<string> OnError { get; set; }

    private bool busy;
    private IJSObjectReference? module;

    private async Task EnsureModuleAsync()
        => module ??= await JS.InvokeAsync<IJSObjectReference>("import",
            "./_content/ITVComponents.WebCoreToolkit.Blazor.MudBlazor/file-transfer.js");

    private async Task Download()
    {
        busy = true;
        try
        {
            var authState = await AuthState.GetAuthenticationStateAsync();
            var result = await FileService.ProcessFileDownload(DownloadModule, DownloadReason, FileIdentifier,
                authState.User, defaultDownloadName: "download.bin", defaultContentType: "application/octet-stream");

            if (result is { Code: FileOperationCode.OkWithContent, Success: true })
            {
                var readResult = result.ReadResult;
                try
                {
                    await EnsureModuleAsync();
                    using var streamRef = new DotNetStreamReference(readResult.FileContent, leaveOpen: false);
                    await module!.InvokeVoidAsync("downloadFromStream", readResult.DownloadName, readResult.ContentType, streamRef);
                }
                finally
                {
                    foreach (var d in readResult.DeferredDisposals)
                    {
                        try
                        {
                            d.Dispose();
                        }
                        catch (Exception ex)
                        {
                            // Das Aufraeumen darf den Download nicht abbrechen - er ist zu diesem
                            // Zeitpunkt bereits beim Benutzer. Verschweigen darf man es trotzdem nicht:
                            // genau hier bliebe ein Handle oder eine temporaere Datei zurueck, und nichts
                            // anderes wuerde je davon berichten.
                            Logger.LogError(ex,
                                "Konnte eine nachgelagerte Ressource des Downloads {Module}/{Reason}/{File} nicht freigeben.",
                                DownloadModule, DownloadReason, FileIdentifier);
                        }
                    }
                }
            }
            else if (result.Code == FileOperationCode.NotFound)
            {
                var message = result.Errors is { Count: > 0 }
                    ? string.Join(Environment.NewLine, result.Errors.Select(e => e.Message))
                    : "The requested file was not found.";
                await OnError.InvokeAsync(message);
            }
            else
            {
                await OnError.InvokeAsync("Permission denied for requested file.");
                Logger.Log(LogLevel.Error, $"File-Request failed for {DownloadModule}/{DownloadReason}/{FileIdentifier}. Result: {result.Code} ({string.Join(Environment.NewLine, result.Errors.Select(n => $"{n.Key}: {n.Message}"))})");
            }
        }
        finally
        {
            busy = false;
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (module is not null)
        {
            try { await module.DisposeAsync(); }
            catch (Microsoft.JSInterop.JSDisconnectedException ex)
            {
                // Erwarteter Normalfall: der Circuit ist vor dem Aufraeumen weg, das JS-Modul damit
                // ohnehin. Nur vermerken, nicht als Fehler.
                Logger.LogDebug(ex, "Circuit vor dem Freigeben des Download-Moduls beendet.");
            }
            catch (Exception ex)
            {
                Logger.LogError(ex, "Konnte das Download-Modul nicht freigeben.");
            }
        }
    }
}
