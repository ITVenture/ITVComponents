@inject ISnackbar Snackbar

<MudDialog>
    <DialogContent>
        <MudForm @ref="form" Model="Model">
            <MudTextField @bind-Value="Model.Name" Label="Name (e.g. de-CH)" Required="true" MaxLength="128" />
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Cancel</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="Save">@(IsCreate ? "Create" : "Save")</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;
    [Parameter, EditorRequired] public CultureViewModel Model { get; set; } = default!;
    [Parameter] public bool IsCreate { get; set; }

    private MudForm? form;

    private async Task Save()
    {
        if (form is null) return;
        await form.Validate();
        if (!form.IsValid) { Snackbar.Add("Please correct invalid fields", Severity.Warning); return; }
        MudDialog.Close(DialogResult.Ok(Model));
    }
    private void Cancel() => MudDialog.Cancel();
}
