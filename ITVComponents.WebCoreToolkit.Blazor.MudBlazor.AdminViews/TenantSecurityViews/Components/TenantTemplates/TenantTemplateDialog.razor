<MudDialog Class="itv-fill-editor">
    <DialogContent>
        <DialogFillStyles />
        <MudForm @ref="form" Model="Model">
            <MudTextField @bind-Value="Model.Name" Label="Name" Required="true" RequiredError="Name is required" />
            <MudTextField @bind-Value="Model.Description" Label="Description" Lines="3" />
            <MudText Typo="Typo.caption" Class="mt-3">Markup</MudText>
            <CodeEditor @ref="markupEditor" Value="@Model.Markup" Language="json" Height="400" Fill="true" />
        </MudForm>
    </DialogContent>
    <DialogActions>
        <DialogMaximizeToggle NormalMaxWidth="MaxWidth.Medium" />
        <MudSpacer />
        <MudButton OnClick="Cancel">Cancel</MudButton>
        <MudButton Color="Color.Primary" OnClick="Save">@(IsCreate ? "Create" : "Save")</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter, EditorRequired] public TenantTemplateViewModel Model { get; set; } = default!;
    [Parameter] public bool IsCreate { get; set; }

    private MudForm? form;
    private CodeEditor? markupEditor;

    private void Cancel() => MudDialog.Cancel();

    private async Task Save()
    {
        if (form is null) return;
        await form.ValidateAsync();
        if (markupEditor is not null) Model.Markup = await markupEditor.GetValueAsync();
        if (!form.IsValid) return;
        MudDialog.Close(DialogResult.Ok(Model));
    }
}
