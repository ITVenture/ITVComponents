@page "/Account/Manage/Passkeys"
@rendermode @(RenderMode.InteractiveServer)

@layout ManageLayout
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@implements IAsyncDisposable

@using System.Buffers.Text
@using System.Linq
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Identity
@using Microsoft.Extensions.Localization
@using Microsoft.Extensions.Logging
@using Microsoft.JSInterop
@using ITVComponents.WebCoreToolkit.Blazor.MudBlazor.IdentityPages.Components.Account.Shared
@using ITVComponents.WebCoreToolkit.IdentityShared.Areas.Identity

@inject IPageHandlerProvider<PasskeyPageModel, IPasskeyHandler> PasskeyProvider
@inject AuthenticationStateProvider AuthState
@inject IStringLocalizer<IdentityMessages> L
@inject ILogger<Passkeys> Logger
@inject IJSRuntime JS
@inject NavigationManager Nav

<PageTitle>@L["Passkeys"]</PageTitle>

<MudText Typo="Typo.h5" GutterBottom="true">@L["Passkeys"]</MudText>

@if (!PasskeyProvider.Handler.UsePage)
{
    <MudAlert Severity="Severity.Info">@L["This page is not available."]</MudAlert>
}
else if (loading)
{
    <MudProgressCircular Indeterminate="true" />
}
else
{
    @if (!string.IsNullOrEmpty(status))
    {
        <MudAlert Severity="Severity.Info" Class="mb-3">@status</MudAlert>
    }

    @if (currentPasskeys is { Count: > 0 })
    {
        <MudTable Items="currentPasskeys" Hover="true" Dense="true" Class="mb-3" Breakpoint="Breakpoint.Sm">
            <HeaderContent>
                <MudTh>@L["Name"]</MudTh>
                <MudTh Style="width: 120px;">@L["Actions"]</MudTh>
            </HeaderContent>
            <RowTemplate Context="passkey">
                @{
                    var credentialId = Base64Url.EncodeToString(passkey.CredentialId);
                }
                <MudTd DataLabel="@L["Name"]">@(passkey.Name ?? L["Unnamed passkey"].Value)</MudTd>
                <MudTd>
                    <MudIconButton Icon="@Icons.Material.Filled.Edit"
                                   Href="@($"Account/Manage/RenamePasskey/{credentialId}")"
                                   Color="Color.Primary"
                                   Title="@L["Rename"]" />
                    <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                   Color="Color.Error"
                                   Disabled="@busy"
                                   Title="@L["Delete"]"
                                   OnClick="@(() => DeletePasskey(credentialId))" />
                </MudTd>
            </RowTemplate>
        </MudTable>
    }
    else
    {
        <MudText Class="mb-3">@L["You have no passkeys registered."]</MudText>
    }

    @if (currentPasskeys is { Count: var c } && c >= PasskeyProvider.Handler.MaxPasskeysPerUser)
    {
        <MudAlert Severity="Severity.Warning">@L["You have reached the maximum number of passkeys."]</MudAlert>
    }
    else
    {
        @* Der Klick wird in JS abgefangen (siehe PasskeySubmit.js/attachPasskeyCreate) - dort laeuft
           navigator.credentials.create() noch in der Benutzer-Geste. Erst das fertige Credential reist
           per .NET-Referenz hierher zurueck. Der Knopf traegt nur eine id, damit JS ihn findet. *@
        <MudButton id="@AddButtonId" Variant="Variant.Filled" Color="Color.Primary" Disabled="@(busy || !canAdd)">
            @L["Add a new passkey"]
        </MudButton>
    }
}

@code {
    private const string AddButtonId = "itv-passkey-add";

    private IList<UserPasskeyInfo>? currentPasskeys;
    private bool loading = true;
    private bool busy;
    private bool canAdd;
    private string? creationOptionsJson;
    private IJSObjectReference? module;
    private DotNetObjectReference<Passkeys>? selfRef;

    private string? status;

    [SupplyParameterFromQuery(Name = "status")]
    private string? StatusMessage { get; set; }

    protected override async Task OnInitializedAsync()
    {
        status = StatusMessage;
        if (!PasskeyProvider.Handler.UsePage)
        {
            loading = false;
            return;
        }

        await LoadAsync();
        loading = false;
    }

    private async Task LoadAsync()
    {
        var principal = (await AuthState.GetAuthenticationStateAsync()).User;
        currentPasskeys = await PasskeyProvider.Handler.GetUserPasskeysAsync(principal);

        // Die Anmelde-Optionen entstehen serverseitig beim Aufbau der Seite und werden dem Klick-Handler
        // mitgegeben - sie erst beim Klick zu holen, wuerde den Gesten-Kontext kosten.
        canAdd = currentPasskeys is not { Count: var n } || n < PasskeyProvider.Handler.MaxPasskeysPerUser;
        if (canAdd)
        {
            creationOptionsJson = await PasskeyProvider.Handler.MakePasskeyCreationOptionsAsync(principal);
            canAdd = creationOptionsJson is not null;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!PasskeyProvider.Handler.UsePage || creationOptionsJson is null || module is not null)
        {
            return;
        }

        module ??= await JS.InvokeAsync<IJSObjectReference>("import",
            "./_content/ITVComponents.WebCoreToolkit.Blazor.MudBlazor.IdentityPages/PasskeySubmit.js");
        selfRef ??= DotNetObjectReference.Create(this);
        await module.InvokeVoidAsync("attachPasskeyCreate", AddButtonId, selfRef, creationOptionsJson);
    }

    [JSInvokable]
    public async Task OnPasskeyCreatedAsync(string credentialJson)
    {
        busy = true;
        try
        {
            var attestation = await PasskeyProvider.Handler.PerformPasskeyAttestationAsync(credentialJson);
            if (!attestation.Succeeded || attestation.Passkey is null)
            {
                status = attestation.Failure?.Message ?? L["Passkey attestation failed."].Value;
                return;
            }

            var principal = (await AuthState.GetAuthenticationStateAsync()).User;
            var add = await PasskeyProvider.Handler.AddOrUpdateUserPasskeyAsync(principal, attestation.Passkey);
            if (!add.Succeeded)
            {
                status = string.Join(", ", add.Errors.Select(e => e.Description));
                return;
            }

            // Direkt zum Benennen des neuen Schluessels - weiche Navigation, der Bereich ist interaktiv.
            var credentialIdBase64Url = Base64Url.EncodeToString(attestation.Passkey.CredentialId);
            Nav.NavigateTo($"Account/Manage/RenamePasskey/{credentialIdBase64Url}");
        }
        finally
        {
            busy = false;
            StateHasChanged();
        }
    }

    [JSInvokable]
    public Task OnPasskeyFailedAsync(string message)
    {
        status = message;
        StateHasChanged();
        return Task.CompletedTask;
    }

    private async Task DeletePasskey(string credentialIdBase64Url)
    {
        busy = true;
        try
        {
            byte[] credentialId;
            try
            {
                credentialId = Base64Url.DecodeFromChars(credentialIdBase64Url);
            }
            catch (FormatException)
            {
                status = L["The passkey identifier is not in a valid format."].Value;
                return;
            }

            var principal = (await AuthState.GetAuthenticationStateAsync()).User;
            var result = await PasskeyProvider.Handler.RemoveUserPasskeyAsync(principal, credentialId);
            if (!result.Succeeded)
            {
                status = string.Join(", ", result.Errors.Select(e => e.Description));
                return;
            }

            status = L["Passkey deleted."].Value;
            await LoadAsync();
        }
        finally
        {
            busy = false;
        }
    }

    public async ValueTask DisposeAsync()
    {
        selfRef?.Dispose();
        if (module is not null)
        {
            try
            {
                await module.DisposeAsync();
            }
            catch (JSDisconnectedException ex)
            {
                // Circuit ist schon weg (Tab geschlossen) - das Modul stirbt mit ihm, das ist der Normalfall.
                // Trotzdem vermerken, damit ein ANDERER Grund fuer ein gescheitertes Dispose nicht unsichtbar
                // bleibt: sonst sieht man hier gar nichts und sucht spaeter an der falschen Stelle.
                Logger.LogDebug(ex, "Passkey-Modul konnte nicht freigegeben werden - Circuit bereits beendet.");
            }
        }
    }
}
