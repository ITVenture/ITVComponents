@inject IWorkflowMonitorHandler Handler
@inject AuthenticationStateProvider AuthState
@inject ISnackbar Snackbar
@inject IDialogService DialogService

<MudDialog>
    <DialogContent>
        @if (instance is null)
        {
            <MudProgressCircular Indeterminate="true" />
        }
        else
        {
            <MudTabs Elevation="0" Rounded="true" PanelClass="pa-4">
                <MudTabPanel Text="Overview">
                    <MudSimpleTable Dense="true" Hover="true">
                        <tbody>
                            <tr><td>Id</td><td>@instance.Id</td></tr>
                            <tr><td>Definition</td><td>@instance.DefinitionId (v@instance.DefinitionVersion)</td></tr>
                            <tr><td>Status</td><td>@instance.Status</td></tr>
                            <tr>
                                <td>Priority</td>
                                <td>
                                    @* Nur solange die Instanz noch etwas vor sich hat - an einer
                                       beendeten Instanz aendert die Stufe nichts mehr. *@
                                    @if (CanChangePriority)
                                    {
                                        <SecureView RequiredPermissions="Workflow.Operate">
                                            <Permitted>
                                                <WorkflowPrioritySelect Value="@instance.Priority"
                                                                        ValueChanged="ChangePriority"
                                                                        Label="" AllowInherit="false"
                                                                        Class="mt-0" />
                                            </Permitted>
                                            <NotPermitted>
                                                @WorkflowPriority.Name(instance.Priority)
                                            </NotPermitted>
                                        </SecureView>
                                    }
                                    else
                                    {
                                        @WorkflowPriority.Name(instance.Priority)
                                    }
                                </td>
                            </tr>
                            <tr><td>Correlation</td><td>@instance.CorrelationKey</td></tr>
                            <tr><td>Created (UTC)</td><td>@instance.CreatedUtc</td></tr>
                            <tr><td>Updated (UTC)</td><td>@instance.UpdatedUtc</td></tr>
                            @if (!string.IsNullOrEmpty(instance.FaultMessage))
                            {
                                <tr><td>Fault</td><td>@instance.FaultMessage</td></tr>
                            }
                        </tbody>
                    </MudSimpleTable>
                </MudTabPanel>
                <MudTabPanel Text="Graph">
                    @if (definition is null)
                    {
                        <MudText Typo="Typo.body2">No definition available for this instance.</MudText>
                    }
                    else
                    {
                        @if (faultedNodeIds.Length > 0)
                        {
                            <MudAlert Severity="Severity.Error" Dense="true" Class="mb-2">
                                @(faultedNodeIds.Length == 1
                                    ? "The step marked in red failed."
                                    : $"{faultedNodeIds.Length} steps marked in red failed.")
                                <SecureView RequiredPermissions="Workflow.Operate">
                                    <Permitted>
                                        <span> Double-click a step to correct its data and retry.</span>
                                    </Permitted>
                                </SecureView>
                            </MudAlert>
                        }
                        <WorkflowGraph Definition="definition"
                                       HighlightedNodeIds="activeNodeIds"
                                       FaultedNodeIds="faultedNodeIds"
                                       OnNodeActivated="OpenBranchCorrection" />
                    }
                </MudTabPanel>
                <MudTabPanel Text="@($"Variables ({instance.Variables.Count})")">
                    @if (instance.Tokens.Any(t => t.Variables is not null))
                    {
                        @* Waehrend einer parallelen Region steht der Instanz-Stack auf dem Stand des Splits;
                           was die Zweige gerade rechnen, steht in deren Kopien (Reiter „Tokens"). *@
                        <MudAlert Severity="Severity.Info" Dense="true" Class="mb-2">
                            A parallel region is open: these are the variables as of the split. What the branches
                            computed so far is in their branch scopes (tab "Tokens") until the join merges them.
                        </MudAlert>
                    }
                    <MudSimpleTable Dense="true" Hover="true">
                        <thead><tr><th>Name</th><th>Value</th></tr></thead>
                        <tbody>
                            @foreach (var kv in instance.Variables)
                            {
                                <tr><td>@kv.Key</td><td>@kv.Value</td></tr>
                            }
                        </tbody>
                    </MudSimpleTable>
                </MudTabPanel>
                <MudTabPanel Text="@($"Tokens ({instance.Tokens.Count})")">
                    <MudSimpleTable Dense="true" Hover="true">
                        <thead><tr><th>Node</th><th>Status</th><th>Waiting for</th><th>Branch scope</th></tr></thead>
                        <tbody>
                            @foreach (var token in instance.Tokens)
                            {
                                <tr>
                                    <td>@token.NodeId</td>
                                    <td>@token.Status</td>
                                    <td>@(token.WaitingSignal ?? (token.DueUtc.HasValue ? $"timer {token.DueUtc:o}" : ""))</td>
                                    <td>@BranchScope(token)</td>
                                </tr>
                            }
                        </tbody>
                    </MudSimpleTable>
                </MudTabPanel>
                <MudTabPanel Text="@($"History ({instance.History.Count})")">
                    <MudSimpleTable Dense="true" Hover="true">
                        <thead><tr><th>Severity</th><th>Time (UTC)</th><th>Event</th><th>Node</th><th>Detail</th></tr></thead>
                        <tbody>
                            @foreach (var entry in instance.History)
                            {
                                <tr>
                                    <td>
                                        <MudChip T="string" Size="Size.Small" Variant="Variant.Text"
                                                 Color="@SeverityColor(entry.Severity)">@entry.Severity</MudChip>
                                    </td>
                                    <td>@entry.TimestampUtc</td><td>@entry.Event</td><td>@entry.NodeId</td><td>@entry.Detail</td>
                                </tr>
                            }
                        </tbody>
                    </MudSimpleTable>
                </MudTabPanel>
            </MudTabs>
        }
    </DialogContent>
    <DialogActions>
        @if (instance is not null && instance.Status == WorkflowStatus.Waiting)
        {
            <SecureView RequiredPermissions="Workflow.Operate">
                <Permitted>
                    <MudTextField @bind-Value="signalName" Placeholder="Signal name" Margin="Margin.Dense"
                                  Class="mr-2" Style="max-width:200px" />
                    <MudButton Color="Color.Primary" OnClick="SendSignal"
                               Disabled="@string.IsNullOrWhiteSpace(signalName)">Send signal</MudButton>
                </Permitted>
            </SecureView>
        }
        @* Auch Faulted: eine fehlgeschlagene Instanz ist nicht beendet, sondern haengt - wer den
           Wiederaufsatz aufgibt, muss den Fall schliessen koennen. *@
        @if (instance is not null
             && (instance.Status == WorkflowStatus.Running || instance.Status == WorkflowStatus.Waiting
                 || instance.Status == WorkflowStatus.Faulted))
        {
            <SecureView RequiredPermissions="Workflow.Operate">
                <Permitted>
                    <MudButton Color="Color.Error" OnClick="Cancel">
                        @(instance.Status == WorkflowStatus.Faulted ? "Give up and cancel" : "Cancel workflow")
                    </MudButton>
                </Permitted>
            </SecureView>
        }
        <MudSpacer />
        <MudButton OnClick="Close">Close</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter] public string InstanceId { get; set; } = "";

    /// <summary>Die Workflow-Umgebung (Store) dieser Instanz; null = Standard.</summary>
    [Parameter] public string? Environment { get; set; }

    private WorkflowInstance? instance;
    private ITVComponents.Workflow.Model.WorkflowDefinition? definition;
    private string[] activeNodeIds = Array.Empty<string>();
    private string[] faultedNodeIds = Array.Empty<string>();
    private ClaimsPrincipal? currentUser;
    private string? signalName;

    /// <summary>
    /// Der Zweig-Scope eines Tokens fuer die Anzeige: die eigene Variablen-Kopie eines parallelen Zweigs,
    /// oder leer, wenn das Token auf dem Instanz-Stack arbeitet. Ohne diese Spalte waere waehrend einer
    /// parallelen Region nicht zu sehen, was ein Zweig gerade gerechnet hat.
    /// </summary>
    private static string BranchScope(Token token)
        => token.Variables is null
            ? string.Empty
            : string.Join(", ", token.Variables.Select(kv => $"{kv.Key}={kv.Value}"));

    /// <summary>
    /// Lässt sich die Stufe hier noch sinnvoll ändern? Sie steuert nur, wie schnell offene Arbeit
    /// aufgegriffen wird — an einer beendeten oder abgebrochenen Instanz gibt es davon keine mehr.
    /// </summary>
    private bool CanChangePriority
        => instance is not null
           && (instance.Status == WorkflowStatus.Running || instance.Status == WorkflowStatus.Waiting);

    /// <summary>
    /// Setzt die Stufe der Instanz neu. Ein verlorenes Rennen gegen einen gerade laufenden Zweig ist
    /// kein Fehler, sondern ein Wiederholungsfall — deshalb eine eigene, sprechende Meldung statt
    /// eines allgemeinen „hat nicht geklappt".
    /// </summary>
    private async Task ChangePriority(int? priority)
    {
        if (instance is null || priority is null || currentUser is null)
        {
            return;
        }

        if (await Handler.SetPriorityAsync(currentUser, InstanceId, priority.Value, Environment))
        {
            Snackbar.Add($"Priority set to {WorkflowPriority.Name(priority.Value)}.", Severity.Success);
        }
        else
        {
            Snackbar.Add(
                "The priority could not be changed — a branch of this instance was being processed at the " +
                "same time. Please try again.", Severity.Warning);
        }

        await LoadAsync();
    }

    private static Color SeverityColor(HistorySeverity severity) => severity switch
    {
        HistorySeverity.Error => Color.Error,
        HistorySeverity.Warning => Color.Warning,
        HistorySeverity.Info => Color.Info,
        _ => Color.Default
    };

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        var auth = await AuthState.GetAuthenticationStateAsync();
        currentUser = auth.User;
        instance = await Handler.GetInstanceAsync(currentUser, InstanceId, Environment);
        faultedNodeIds = Array.Empty<string>();
        if (instance is null)
        {
            return;
        }

        // Aktuelle Token-Positionen: alles, was nicht bereits verbraucht ist, wird im Graphen
        // hervorgehoben.
        activeNodeIds = instance.Tokens
            .Where(t => t.Status != TokenStatus.Consumed && !string.IsNullOrEmpty(t.NodeId))
            .Select(t => t.NodeId!)
            .Distinct()
            .ToArray();
        definition = await Handler.GetDefinitionAsync(currentUser, instance.DefinitionId, instance.DefinitionVersion, Environment);

        // Die Fehlerstellen kommen vom Handler und nicht aus einer eigenen Auswertung: er benutzt
        // WorkflowEngine.FindStalledBranches - dieselbe Quelle, an der der Retry dann wirklich ansetzt.
        if (instance.Status == WorkflowStatus.Faulted)
        {
            WorkflowRetryInfo? retry = await Handler.GetRetryInfoAsync(currentUser, InstanceId, Environment);
            faultedNodeIds = retry?.FaultedNodeIds.ToArray() ?? Array.Empty<string>();
        }
    }

    /// <summary>
    /// Doppelklick auf einen Knoten im Graphen: oeffnet die Korrektur-Maske auf DIESEM Zweig. Nur fuer
    /// gescheiterte Instanzen und nur mit Operate-Recht sinnvoll - der Handler prueft beides noch einmal
    /// selbst, hier geht es nur darum, dem Benutzer keinen leeren Dialog vorzusetzen.
    /// </summary>
    private async Task OpenBranchCorrection(string nodeId)
    {
        if (instance is null || instance.Status != WorkflowStatus.Faulted
            || !Handler.HasPermission(currentUser!, WorkflowSecurity.Operate))
        {
            return;
        }

        var parameters = new DialogParameters<RetryWorkflowDialog>
        {
            { d => d.InstanceId, InstanceId },
            { d => d.Environment, Environment },
            { d => d.FocusNodeId, nodeId }
        };
        IDialogReference dlg = await DialogService.ShowAsync<RetryWorkflowDialog>(
            $"Retry {InstanceId}", parameters, EditDialogDefaults.Detail);
        DialogResult? result = await dlg.Result;
        if (result is { Canceled: false, Data: true })
        {
            Snackbar.Add("Instance resumed.", Severity.Success);
            // Der Stand hat sich geaendert (inline ist der Schritt schon gelaufen) - neu laden statt
            // eine veraltete Ansicht stehen zu lassen.
            await LoadAsync();
            StateHasChanged();
        }
    }

    private async Task SendSignal()
    {
        if (currentUser is null || string.IsNullOrWhiteSpace(signalName))
        {
            return;
        }

        var ok = await Handler.SignalAsync(currentUser, InstanceId, signalName!, Environment);
        if (ok)
        {
            Snackbar.Add("Signal delivered", Severity.Success);
            MudDialog.Close(DialogResult.Ok(true));
        }
        else
        {
            Snackbar.Add("No token was waiting for that signal (or no permission).", Severity.Warning);
        }
    }

    private async Task Cancel()
    {
        if (currentUser is null)
        {
            return;
        }

        var ok = await Handler.CancelAsync(currentUser, InstanceId, Environment);
        if (ok)
        {
            Snackbar.Add("Workflow cancelled", Severity.Success);
            MudDialog.Close(DialogResult.Ok(true));
        }
        else
        {
            Snackbar.Add("Could not cancel (or no permission).", Severity.Warning);
        }
    }

    private void Close()
    {
        MudDialog.Close(DialogResult.Ok(false));
    }
}
