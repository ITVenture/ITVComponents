@*
    Bearbeitet EINEN Konfigurations-Eintrag (Schlüssel + Wert) einer generischen Aktivität in einem
    eigenen Popup. Der Wert darf mehrzeilig/länger sein, deshalb ein eigener Dialog statt der engen
    Inline-Zeile. Gibt Schlüssel/Wert (und den ursprünglichen Schlüssel, für Umbenennung) sowie ein
    Löschkennzeichen über das Result zurück.
*@

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">@(IsNew ? "Add configuration value" : "Edit configuration value")</MudText>
    </TitleContent>
    <DialogContent>
        <MudTextField @bind-Value="Key" Label="Key" Margin="Margin.Dense" />
        <MudTextField @bind-Value="Value" Label="Value" Lines="5" Margin="Margin.Dense" Class="mt-2" />
    </DialogContent>
    <DialogActions>
        <DialogMaximizeToggle NormalMaxWidth="MaxWidth.Small" />
        @if (!IsNew)
        {
            <MudButton StartIcon="@Icons.Material.Filled.Delete" Color="Color.Error" Variant="Variant.Text"
                       OnClick="Delete">Delete</MudButton>
        }
        <MudSpacer />
        <MudButton OnClick="Cancel">Cancel</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="Done"
                   Disabled="@string.IsNullOrWhiteSpace(Key)">Done</MudButton>
    </DialogActions>
</MudDialog>

@code {
    /// <summary>Ergebnis: neuer Schlüssel/Wert, der ursprüngliche Schlüssel (für Umbenennung) und Löschkennzeichen.</summary>
    public record Result(string Key, string Value, string? OriginalKey, bool Delete);

    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;

    /// <summary>Der (anfängliche) Schlüssel. Bei Bearbeitung der bestehende, bei Neu leer.</summary>
    [Parameter] public string Key { get; set; } = string.Empty;

    /// <summary>Der (anfängliche) Wert.</summary>
    [Parameter] public string Value { get; set; } = string.Empty;

    /// <summary>true = neuer Eintrag (kein Löschen, anderer Titel).</summary>
    [Parameter] public bool IsNew { get; set; }

    private string? originalKey;

    protected override void OnInitialized()
    {
        // Den Startschlüssel merken, damit der Aufrufer bei Umbenennung den alten Eintrag entfernen kann.
        originalKey = IsNew ? null : Key;
    }

    private void Done()
    {
        if (string.IsNullOrWhiteSpace(Key))
        {
            return;
        }

        MudDialog.Close(DialogResult.Ok(new Result(Key.Trim(), Value ?? string.Empty, originalKey, false)));
    }

    private void Delete()
        => MudDialog.Close(DialogResult.Ok(new Result(Key, Value ?? string.Empty, originalKey, true)));

    private void Cancel() => MudDialog.Cancel();
}
