@*
    Thin wrapper around BlazorMonaco's StandaloneCodeEditor for the code-editing dialogs
    (DiagnosticsQueries / Dashboard widgets / HealthScripts). Value is supplied once as the initial
    text; the host pulls the edited text back via GetValueAsync() on save (avoids a server round-trip
    per keystroke that a two-way @bind would cause under Blazor Server).

    Consumer host setup — include once in the host page (App.razor / _Host.cshtml), after the Blazor script:
        <script src="_content/BlazorMonaco/jsInterop.js"></script>
        <script src="_content/BlazorMonaco/lib/monaco-editor/min/vs/loader.js"></script>
        <script src="_content/BlazorMonaco/lib/monaco-editor/min/vs/editor/editor.main.js"></script>
*@
@using BlazorMonaco
@using BlazorMonaco.Editor
@inject Microsoft.JSInterop.IJSRuntime JS

<div class="itv-code-editor-host @(Fill ? "itv-code-editor-fill" : "")" style="@HostStyle">
    <StandaloneCodeEditor @ref="editor" ConstructionOptions="BuildOptions" />
</div>

@code {
    /// <summary>Initial editor text. Read back via <see cref="GetValueAsync"/>.</summary>
    [Parameter] public string? Value { get; set; }

    /// <summary>Monaco language id, e.g. "sql", "javascript", "html".</summary>
    [Parameter] public string Language { get; set; } = "plaintext";

    /// <summary>Normal editor height in px. In <see cref="Fill"/> mode this becomes the minimum height.</summary>
    [Parameter] public int Height { get; set; } = 320;

    /// <summary>
    /// When true the editor grows to fill the available vertical space of a flex-column parent (e.g. a
    /// maximized dialog) instead of staying at a fixed <see cref="Height"/>; <see cref="Height"/> is the
    /// minimum. Monaco's AutomaticLayout re-measures on the resulting container resize.
    /// </summary>
    [Parameter] public bool Fill { get; set; }

    [Parameter] public bool ReadOnly { get; set; }

    private StandaloneCodeEditor? editor;

    private string HostStyle
        => $"{(Fill ? $"min-height:{Height}px;" : $"height:{Height}px;")}"
           + "border:1px solid var(--mud-palette-lines-inputs);border-radius:var(--mud-default-borderradius);overflow:hidden;";

    private StandaloneEditorConstructionOptions BuildOptions(StandaloneCodeEditor _)
        => new StandaloneEditorConstructionOptions
        {
            Language = Language,
            Value = Value ?? string.Empty,
            AutomaticLayout = true,
            ReadOnly = ReadOnly,
            Minimap = new EditorMinimapOptions { Enabled = false },
            ScrollBeyondLastLine = false,
            FontSize = 13
        };

    /// <summary>Returns the current editor content (falls back to the initial value if not yet initialised).</summary>
    public async Task<string> GetValueAsync()
        => editor is null ? (Value ?? string.Empty) : await editor.GetValue();

    /// <summary>
    /// Replaces the editor content.
    /// </summary>
    /// <remarks>
    /// Fuer Faelle, in denen der Text NICHT vom Tippen kommt - etwa ein Knopf, der eine Vorlage oder eine
    /// Parameter-Uebersicht einfuegt. Ist der Editor noch nicht da, wird der Anfangswert gesetzt.
    /// </remarks>
    public async Task SetValueAsync(string value)
    {
        Value = value;
        if (editor is not null)
        {
            await editor.SetValue(value);
        }
    }

    /// <summary>
    /// Fuegt Text an der Einfuegemarke ein (ersetzt dabei eine bestehende Auswahl).
    /// </summary>
    /// <remarks>
    /// Der Weg fuer Knoepfe, die eine Vorlage, einen Platzhalter oder einen Verweis beisteuern. Der
    /// naheliegende Umweg ueber <see cref="SetValueAsync"/> haengte den Text stattdessen ans Ende und
    /// verloere die Einfuegemarke; ausserdem zerrisse er die Rueckgaengig-Kette des Editors.
    /// Ist der Editor noch nicht da, wird an den Anfangswert angehaengt - besser als nichts zu tun.
    /// </remarks>
    public async Task InsertAsync(string text)
    {
        if (string.IsNullOrEmpty(text))
        {
            return;
        }

        if (editor is null)
        {
            Value = (Value ?? string.Empty) + text;
            return;
        }

        var selection = await editor.GetSelection();
        var range = selection is null
            ? null
            : new BlazorMonaco.Range
            {
                StartLineNumber = selection.StartLineNumber,
                StartColumn = selection.StartColumn,
                EndLineNumber = selection.EndLineNumber,
                EndColumn = selection.EndColumn
            };

        if (range is null)
        {
            // Ohne Auswahl gibt es keine Stelle, an die eingefuegt werden koennte - dann lieber
            // anhaengen als still nichts tun.
            var current = await editor.GetValue();
            await editor.SetValue(current + text);
            return;
        }

        await editor.ExecuteEdits("itv-insert", new List<IdentifiedSingleEditOperation>
        {
            new IdentifiedSingleEditOperation { Range = range, Text = text, ForceMoveMarkers = true }
        // Der getypte null-Wert ist noetig: ExecuteEdits gibt es auch mit einem CursorStateComputer an
        // dieser Stelle, und ein blankes null traefe beide Ueberladungen gleich gut (CS0121).
        }, (List<BlazorMonaco.Selection>?)null);
        await editor.Focus();
    }

    /// <summary>Switches the syntax highlighting language at runtime without losing the current text.</summary>
    public async Task SetLanguageAsync(string languageId)
    {
        Language = languageId;
        if (editor is null) return;
        var model = await editor.GetModel();
        // Use the IJSRuntime overload: the parameterless one is WASM-only and is a silent no-op under Blazor Server.
        if (model is not null) await Global.SetModelLanguage(JS, model, languageId);
    }
}
