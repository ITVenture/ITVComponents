@page
@using Microsoft.Extensions.Localization
@using Microsoft.AspNetCore.Hosting
@using Microsoft.CodeAnalysis.VisualBasic.Syntax
@model ITVComponents.WebCoreToolkit.Net.TelerikUi.IdentityPages.Areas.Identity.Pages.Account.LoginModel
@inject IStringLocalizer<IdentityMessages> localizer
@inject IWebHostEnvironment hostingEnvironment 
@{
    ViewData["Title"] = localizer["Log in"];

    void RenderExternalProviders()
    {
        @foreach (var provider in Model.ExternalLogins)
        {
            var tmp = hostingEnvironment.WebRootFileProvider.GetFileInfo(provider.LogoFile);
            if (tmp.Exists)
            {
                <button type="submit" class="btn btn-primary" name="provider" value="@provider.AuthenticationSchemeName" title="@localizer["Log in using your {0} account", provider.DisplayName]" style="background-image: url(@(provider.LogoFile)); width: @(provider.ImageWidth + 5)px; height: @(provider.ImageHeight + 5)px; background-position: center; background-repeat: no-repeat; background-size: @(provider.ImageWidth)px auto"></button>
            }
            else
            {
                <button type="submit" class="btn btn-primary" name="provider" value="@provider.AuthenticationSchemeName" title="@localizer["Log in using your {0} account", provider.DisplayName]">@provider.DisplayName</button>
            }
        }
    }
}


<h1>@ViewData["Title"]</h1>
<div class="row">
    @if (Model.UseLocalAccounts)
    {
        <div class="col-md-4">
            <section>
                <form id="account" method="post">
                    <h4>@localizer["Use a local account to log in."]</h4>
                    <hr/>
                    <div asp-validation-summary="All" class="text-danger"></div>
                    @if (Model.UsernameIsEmail)
                    {
                        <div class="form-group">
                            <label asp-for="Input.Email"></label>
                            <input asp-for="Input.Email" class="form-control" required data-val="true" data-val-required="@localizer["E-Mail is required."]"/>
                            <span asp-validation-for="Input.Email" class="text-danger"></span>
                        </div>
                    }
                    else
                    {
                        <div class="form-group">
                            <label asp-for="Input.Username"></label>
                            <input asp-for="Input.Username" class="form-control" required data-val="true" data-val-required="@localizer["Username is required."]"/>
                            <span asp-validation-for="Input.Username" class="text-danger"></span>
                        </div>
                    }
                    <div class="form-group">
                        <label asp-for="Input.Password"></label>
                        <input asp-for="Input.Password" class="form-control"/>
                        <span asp-validation-for="Input.Password" class="text-danger"></span>
                    </div>
                    <div class="form-group">
                        <div class="checkbox">
                            <label asp-for="Input.RememberMe">
                                <input asp-for="Input.RememberMe"/>
                                @Html.DisplayNameFor(m => m.Input.RememberMe)
                            </label>
                        </div>
                    </div>
                    <div class="form-group">
                        <button type="submit" class="btn btn-primary">@localizer["Login_Button"]</button>
                    </div>
                    <div class="form-group">
                        <p>
                            <a id="forgot-password" asp-page="./ForgotPassword">@localizer["Forgot your password?"]</a>
                        </p>
                        @if (Model.RegistrationInfo.AllowRegister)
                        {
                            <p>
                                @if (Model.RegistrationInfo.ControllerLink)
                                {

                                    @if (!String.IsNullOrEmpty(Model.RegistrationInfo.Area))
                                    {
                                        <a asp-area="@Model.RegistrationInfo.Area" asp-controller="@Model.RegistrationInfo.Controller" asp-action="@Model.RegistrationInfo.Action" asp-route-returnUrl="@Model.ReturnUrl">@localizer["Register as a new user"]</a>
                                    }
                                    else
                                    {
                                        <a asp-controller="@Model.RegistrationInfo.Controller" asp-action="@Model.RegistrationInfo.Action" asp-route-returnUrl="@Model.ReturnUrl">@localizer["Register as a new user"]</a>
                                    }

                                }
                                else
                                {
                                    @if (!String.IsNullOrEmpty(Model.RegistrationInfo.Area))
                                    {
                                        <a asp-area="@Model.RegistrationInfo.Area" asp-Page="@Model.RegistrationInfo.Page" asp-route-returnUrl="@Model.ReturnUrl">@localizer["Register as a new user"]</a>
                                    }
                                    else
                                    {
                                        <a asp-Page="@Model.RegistrationInfo.Page" asp-route-returnUrl="@Model.ReturnUrl">@localizer["Register as a new user"]</a>
                                    }
                                }
                            </p>
                        }
                        <p>
                            <a id="resend-confirmation" asp-page="./ResendEmailConfirmation">@localizer["Resend email confirmation"]</a>
                        </p>
                    </div>
                </form>
            </section>
        </div>
    }
    @if (Model.ExternalLoginConfig.UseExternalLogins)
    {
        <div class="col-md-6 col-md-offset-2">
            <section>
                <h4>@localizer["Use another service to log in."]</h4>
                <hr/>

                @if (Model.ExternalLoginConfig.PostToController)
                {
                    @if (!string.IsNullOrEmpty(Model.ExternalLoginConfig.Area))
                    {
                        <form id="external-account" asp-area="@Model.ExternalLoginConfig.Area" asp-controller="@Model.ExternalLoginConfig.Controller" asp-action="@Model.ExternalLoginConfig.Action" asp-route-returnUrl="@Model.ReturnUrl" method="post" class="form-horizontal">
                            <div>
                                <p>
                                    @{ RenderExternalProviders(); }
                                </p>
                            </div>
                        </form>
                    }
                    else
                    {
                        <form id="external-account" asp-controller="@Model.ExternalLoginConfig.Controller" asp-action="@Model.ExternalLoginConfig.Action" asp-route-returnUrl="@Model.ReturnUrl" method="post" class="form-horizontal">
                            <div>
                                <p>
                                    @{
                                        RenderExternalProviders();
                                    }
                                </p>
                            </div>
                        </form>
                    }
                }
                else
                {
                    if (!string.IsNullOrEmpty(Model.ExternalLoginConfig.Area))
                    {
                        <form id="external-account" asp-area="@Model.ExternalLoginConfig.Area" asp-page="@Model.ExternalLoginConfig.Page" asp-route-returnUrl="@Model.ReturnUrl" method="post" class="form-horizontal">
                            <div>
                                <p>
                                    @{
                                        RenderExternalProviders();
                                    }
                                </p>
                            </div>
                        </form>
                    }
                    else
                    {
                        <form id="external-account" asp-page="@Model.ExternalLoginConfig.Page" asp-route-returnUrl="@Model.ReturnUrl" method="post" class="form-horizontal">
                            <div>
                                <p>
                                    @{
                                        RenderExternalProviders();
                                    }
                                </p>
                            </div>
                        </form>
                    }
                }
            </section>
        </div>
    }
</div>
