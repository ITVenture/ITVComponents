@* Was sich an einer bestehenden Freigabe noch aendern laesst - Titel, Gueltigkeit, Empfaenger und
   vor allem: WER sie benutzen darf.

   Nicht dabei ist, worauf sie zeigt. Die Argumentwerte stehen seit dem Anlegen fest; sie hier
   umbiegen zu koennen hiesse, einen verschickten Link stillschweigend auf ein anderes Objekt zu
   richten. *@

@using Microsoft.Extensions.Localization
@inject IStringLocalizer<ShareMessages> L

<EditDialogShell Model="Model" IsCreate="false" SaveLabel="@L["Share_Save"]" CancelLabel="@L["Share_Cancel"]">
    <MudTextField @bind-Value="Model.AssetTitle" Label="@L["Share_Title"]" Required="true" RequiredError="@L["Share_TitleRequired"]"
                  MaxLength="512" />

    @if (!string.IsNullOrEmpty(Model.ArgumentSummary))
    {
        <MudTextField T="string" Value="@Model.ArgumentSummary" Label="@L["Shares_ColPointsAt"]" ReadOnly="true" Class="mt-2"
                      HelperText="@L["ShareEdit_PointsAtHelp"]" />
    }

    <MudDatePicker @bind-Date="Model.NotBefore" Label="@L["ShareEdit_ValidFrom"]" Clearable="true" Class="mt-2" />
    <MudDatePicker @bind-Date="Model.NotAfter" Label="@L["ShareEdit_ValidUntil"]" Clearable="true" />

    <MudTextField @bind-Value="Model.RecipientLabel" Label="@L["Share_Recipient"]" MaxLength="256" Class="mt-2"
                  HelperText="@L["ShareEdit_RecipientHelp"]" />

    <MudText Typo="Typo.subtitle2" Class="mt-4">@L["ShareEdit_WhoMayUse"]</MudText>
    <FilterList Values="Model.UserFilters" Placeholder="@L["ShareEdit_UserLabel"]"
                AllowAnonymous="true" />

    <MudText Typo="Typo.subtitle2" Class="mt-4">@L["ShareEdit_WhichTenants"]</MudText>
    <FilterList Values="Model.TenantFilters" Placeholder="@L["ShareEdit_TenantName"]"
                AllowAnonymous="false" />

    @if (IsPublic)
    {
        <MudAlert Severity="Severity.Error" Dense="true" Class="mt-2">
            @((MarkupString)L["ShareEdit_PublicWarning"].Value)
        </MudAlert>
    }
    else if (IsAnonymous)
    {
        <MudAlert Severity="Severity.Warning" Dense="true" Class="mt-2">
            @L["ShareEdit_AnonymousWarning"]
        </MudAlert>
    }
</EditDialogShell>

@code {
    [Parameter, EditorRequired] public SharedAssetEditViewModel Model { get; set; } = default!;

    private bool IsAnonymous => Model.UserFilters.Any(n => n == FilterList.AnonymousPlaceholder);

    private bool IsPublic => Model.UserFilters.Any(n => n == FilterList.EveryonePlaceholder)
                             || Model.TenantFilters.Any(n => n == FilterList.EveryonePlaceholder);
}
