@page "/Util/SystemLog"
@rendermode @(RenderMode.InteractiveServer)
@attribute [Microsoft.AspNetCore.Authorization.Authorize]

@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.Extensions.Logging

@inject ISystemLogAdminHandler Handler
@inject AuthenticationStateProvider AuthState

<PageTitle>System log</PageTitle>

<MudText Typo="Typo.h5" GutterBottom="true">System log</MudText>

<SecureView RequiredPermissions="SystemLog.View">
    <Permitted>
@if (currentUser is null)
{
    <MudProgressCircular Indeterminate="true" />
}
else
{
    <MudPaper Class="pa-3 mb-3" Elevation="1">
        <MudGrid Spacing="2" Justify="Justify.FlexStart">
            <MudItem xs="6" sm="4" md="2">
                <MudSelect T="LogLevel?" @bind-Value="minLevel" @bind-Value:after="ReloadGrid" Label="Min level" Clearable="true" Dense="true" Margin="Margin.Dense">
                    @foreach (var level in Levels)
                    {
                        <MudSelectItem T="LogLevel?" Value="@((LogLevel?)level)">@level</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>
            <MudItem xs="6" sm="4" md="2">
                <MudSelect T="LogLevel?" @bind-Value="maxLevel" @bind-Value:after="ReloadGrid" Label="Max level" Clearable="true" Dense="true" Margin="Margin.Dense">
                    @foreach (var level in Levels)
                    {
                        <MudSelectItem T="LogLevel?" Value="@((LogLevel?)level)">@level</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>
            <MudItem xs="12" sm="4" md="3">
                <MudTextField @bind-Value="categoryFilter"
                              Label="Category contains"
                              Clearable="true"
                              Margin="Margin.Dense"
                              DebounceInterval="400"
                              OnDebounceIntervalElapsed="ReloadGrid"
                              OnClearButtonClick="ReloadGrid" />
            </MudItem>
            <MudItem xs="12" sm="6" md="3">
                <MudTextField @bind-Value="titleFilter"
                              Label="Title contains"
                              Clearable="true"
                              Margin="Margin.Dense"
                              DebounceInterval="400"
                              OnDebounceIntervalElapsed="ReloadGrid"
                              OnClearButtonClick="ReloadGrid" />
            </MudItem>
            <MudItem xs="12" sm="6" md="2" Class="d-flex align-end">
                <MudButton StartIcon="@Icons.Material.Filled.FilterAltOff" Variant="Variant.Text" OnClick="ClearFilters">Clear</MudButton>
            </MudItem>
        </MudGrid>
    </MudPaper>

    <MudDataGrid T="SystemEventViewModel"
                 @ref="grid"
                 ServerData="LoadData"
                 SortMode="SortMode.None"
                 RowsPerPage="50"
                 Hover="true"
                 Dense="true">
        <ToolBarContent>
            <RefreshButton OnClick="ReloadGrid" />
            <MudText Typo="Typo.h6">System log</MudText>
            <MudSpacer />
            <MudTextField @bind-Value="search"
                          Placeholder="Search all (incl. message)…"
                          Adornment="Adornment.Start"
                          AdornmentIcon="@Icons.Material.Filled.Search"
                          Class="mt-0 ml-2"
                          Clearable="true"
                          DebounceInterval="400"
                          OnDebounceIntervalElapsed="ReloadGrid"
                          OnClearButtonClick="ReloadGrid" />
        </ToolBarContent>
        <Columns>
            <HierarchyColumn T="SystemEventViewModel" ButtonDisabledFunc="@(item => string.IsNullOrEmpty(item.Message))" />
            <TemplateColumn T="SystemEventViewModel" Title="Level" Sortable="false">
                <CellTemplate>
                    <MudChip T="string" Size="Size.Small" Color="@LevelColor(context.Item.LogLevel)">@context.Item.LogLevel</MudChip>
                </CellTemplate>
            </TemplateColumn>
            <PropertyColumn Property="x => x.EventTime" Title="Time" Format="yyyy-MM-dd HH:mm:ss" />
            <PropertyColumn Property="x => x.Category" Title="Category" />
            <PropertyColumn Property="x => x.Title" Title="Title" />
        </Columns>
        <ChildRowContent>
            <MudPaper Elevation="0" Class="pa-3 my-1" Style="background: var(--mud-palette-background-grey);">
                <pre style="margin: 0; font-family: ui-monospace, 'Cascadia Code', Consolas, 'Courier New', monospace; font-size: 0.8125rem; line-height: 1.45; white-space: pre-wrap; word-break: break-word; overflow-x: auto; max-height: 60vh; overflow-y: auto;">@context.Item.Message</pre>
            </MudPaper>
        </ChildRowContent>
        <PagerContent>
            <MudDataGridPager T="SystemEventViewModel" />
        </PagerContent>
    </MudDataGrid>
}
    </Permitted>
    <NotPermitted>
        <MudAlert Severity="Severity.Warning">No permission to view system log.</MudAlert>
    </NotPermitted>
</SecureView>

@code {
    private MudDataGrid<SystemEventViewModel>? grid;
    private System.Security.Claims.ClaimsPrincipal? currentUser;
    private bool hasView;
    private LogLevel? minLevel;
    private LogLevel? maxLevel;
    private string? categoryFilter;
    private string? titleFilter;
    private string? search;

    private static readonly LogLevel[] Levels =
        Enum.GetValues<LogLevel>().Where(l => l != LogLevel.None).ToArray();

    protected override async Task OnInitializedAsync()
    {
        var auth = await AuthState.GetAuthenticationStateAsync();
        currentUser = auth.User;
        hasView = Handler.HasPermission(currentUser, "SystemLog.View");
    }

    private async Task<GridData<SystemEventViewModel>> LoadData(GridState<SystemEventViewModel> state, CancellationToken ct)
    {
        if (currentUser is null || !hasView)
            return new GridData<SystemEventViewModel> { Items = Array.Empty<SystemEventViewModel>(), TotalItems = 0 };
        var query = new SystemLogQuery
        {
            Page = state.Page,
            PageSize = state.PageSize,
            Search = search,
            MinimumLevel = minLevel,
            MaximumLevel = maxLevel,
            Category = categoryFilter,
            Title = titleFilter
        };
        var result = await Handler.ListAsync(currentUser, query);
        return new GridData<SystemEventViewModel> { Items = result.Items, TotalItems = result.TotalCount };
    }

    private async Task ReloadGrid()
    {
        if (grid is not null) await grid.ReloadServerData();
    }

    private async Task ClearFilters()
    {
        minLevel = null;
        maxLevel = null;
        categoryFilter = null;
        titleFilter = null;
        search = null;
        await ReloadGrid();
    }

    private static Color LevelColor(LogLevel level) => level switch
    {
        LogLevel.Trace => Color.Default,
        LogLevel.Debug => Color.Secondary,
        LogLevel.Information => Color.Info,
        LogLevel.Warning => Color.Warning,
        LogLevel.Error => Color.Error,
        LogLevel.Critical => Color.Error,
        _ => Color.Default
    };
}
