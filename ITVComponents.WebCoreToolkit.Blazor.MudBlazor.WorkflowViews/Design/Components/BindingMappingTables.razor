@using ITVComponents.Workflow.Model

@*
    Der Datenfluss eines Knotens: Eingaben und Ausgaben untereinander. Beide Haelften sind eigene
    Komponenten (InputBindingTable / OutputBindingTable), weil es Knoten gibt, die nur das eine haben -
    ein Sende-Knoten nur Eingaben, ein Ende nur Ausgaben. Diese Komponente ist bloss die Klammer fuer
    die Knoten, die beides tragen. Die Listen werden in-place veraendert (per Referenz).
*@

<InputBindingTable Bindings="Inputs" ParameterOptions="InputParameterOptions" Title="@InputsTitle"
                   AddLabel="@AddInputLabel" NameHeader="@InputNameHeader" NameLabel="@InputNameLabel"
                   AllowValueHandle="AllowValueHandle" HandleDeliveryUsable="HandleDeliveryUsable" />

<div class="mt-4">
    <OutputBindingTable Bindings="Outputs" ParameterOptions="OutputParameterOptions"
                        Title="@OutputsTitle" AddLabel="@AddOutputLabel"
                        SourceLabel="@OutputSourceLabel" TargetLabel="@OutputTargetLabel" />
</div>

@code {
    /// <summary>Die Eingabe-Bindungen (in-place veraendert).</summary>
    [Parameter, EditorRequired] public List<ActivityInputBinding> Inputs { get; set; } = default!;

    /// <summary>Die Ausgabe-Bindungen (in-place veraendert).</summary>
    [Parameter, EditorRequired] public List<ActivityOutputBinding> Outputs { get; set; } = default!;

    /// <summary>Optionale Auswahlliste deklarierter Eingabe-Parameternamen (Katalog).</summary>
    [Parameter] public IReadOnlyList<string>? InputParameterOptions { get; set; }

    /// <summary>Optionale Auswahlliste deklarierter Ausgabe-Parameternamen (Katalog).</summary>
    [Parameter] public IReadOnlyList<string>? OutputParameterOptions { get; set; }

    /// <summary>Ueberschrift ueber der Eingabe-Tabelle.</summary>
    [Parameter] public string InputsTitle { get; set; } = "Inputs";

    /// <summary>Ueberschrift ueber der Ausgabe-Tabelle.</summary>
    [Parameter] public string OutputsTitle { get; set; } = "Outputs";

    /// <summary>Beschriftung des Hinzufuegen-Knopfs der Eingaben.</summary>
    [Parameter] public string AddInputLabel { get; set; } = "Add input";

    /// <summary>Beschriftung des Hinzufuegen-Knopfs der Ausgaben.</summary>
    [Parameter] public string AddOutputLabel { get; set; } = "Add output";

    /// <summary>Kopfzeile der Namensspalte der Eingaben.</summary>
    [Parameter] public string InputNameHeader { get; set; } = "Parameter";

    /// <summary>Beschriftung des Namensfelds im Eingabe-Popup.</summary>
    [Parameter] public string InputNameLabel { get; set; } = "Parameter / name";

    /// <summary>Beschriftung der Quell-Spalte der Ausgaben.</summary>
    [Parameter] public string OutputSourceLabel { get; set; } = "Result / parameter";

    /// <summary>Beschriftung der Ziel-Spalte der Ausgaben.</summary>
    [Parameter] public string OutputTargetLabel { get; set; } = "Variable";

    /// <summary>
    /// Darf eine Eingabe ihren Wert von einem Wert-Handler beziehen? Nur wo das Ergebnis den Schritt
    /// nicht ueberlebt - beim Subworkflow-Aufruf etwa nicht, dessen Eingaben werden die Variablen der
    /// Kind-Instanz.
    /// </summary>
    [Parameter] public bool AllowValueHandle { get; set; }

    /// <summary>Bewirkt die Zustellart „Griff" hier etwas? Bei einer Aufgaben-Maske nicht.</summary>
    [Parameter] public bool HandleDeliveryUsable { get; set; } = true;
}
