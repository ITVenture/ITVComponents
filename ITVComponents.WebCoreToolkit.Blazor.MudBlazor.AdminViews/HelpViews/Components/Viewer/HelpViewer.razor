@page "/help"
@page "/help/{Slug}"
@rendermode @(RenderMode.InteractiveServer)
@attribute [Microsoft.AspNetCore.Authorization.AllowAnonymous]
@inject IHelpViewerHandler Viewer
@inject AuthenticationStateProvider AuthState
@inject IStringLocalizer<HelpMessages> L

<PageTitle>@L["Help_Title"]</PageTitle>

<style>
    /* Media in help content is injected via MarkupString, so scoped CSS cannot reach it.
       Force large images/videos to shrink to the container width while keeping aspect-ratio. */
    .itv-help-content img,
    .itv-help-content video,
    .itv-help-content iframe {
        max-width: 100%;
        height: auto;
    }
</style>

<MudGrid>
    @if (ShowNav)
    {
        <MudItem xs="12" md="4" lg="3">
            <MudPaper Outlined="true" Class="pa-1">
                @if (tree.Count > 0)
                {
                    <MudNavMenu>
                        <HelpNavTree Nodes="tree" />
                    </MudNavMenu>
                }
                else
                {
                    <MudText Typo="Typo.body2" Class="pa-2">@L["Help_NoTopics"]</MudText>
                }
            </MudPaper>
        </MudItem>
    }
    <MudItem xs="12" md="@(ShowNav ? 8 : 12)" lg="@(ShowNav ? 9 : 12)">
        @if (current is not null)
        {
            <MudText Typo="Typo.h4" GutterBottom="true">@current.Title</MudText>
            @if (current.Kind == HelpTopicKind.ContentPage && !string.IsNullOrEmpty(current.Html))
            {
                <MudPaper Outlined="true" Class="pa-4 itv-help-content">@((MarkupString)current.Html!)</MudPaper>
            }
            else
            {
                <MudText Typo="Typo.body1">@L["Help_SelectTopic"]</MudText>
            }
        }
        else if (!string.IsNullOrEmpty(Slug))
        {
            <MudAlert Severity="Severity.Info">@L["Help_NotFound"]</MudAlert>
        }
        else
        {
            <MudText Typo="Typo.h4" GutterBottom="true">@L["Help_Title"]</MudText>
            <MudText Typo="Typo.body1">@L["Help_Welcome"]</MudText>
        }
    </MudItem>
</MudGrid>

@code {
    [Parameter] public string? Slug { get; set; }

    private List<HelpTreeNodeViewModel> tree = new();
    private HelpTopicViewViewModel? current;
    private string? loadedSlug;
    private bool treeLoaded;
    private bool authenticated;

    private static string Culture => System.Globalization.CultureInfo.CurrentUICulture.Name;

    /// <summary>
    /// Ein Thema, das bewusst KEINEN Menueeintrag bekommt (verlinkte Dokumente wie AGB oder
    /// Datenschutzerklaerung), wird auch ohne die Navigation angezeigt: wer ueber einen Direktlink kommt,
    /// will das Dokument lesen und nicht den Hilfebaum. Auf der Uebersicht (kein Slug) bleibt sie stehen.
    /// </summary>
    private bool ShowNav => current is null || current.ShowInMenu;

    protected override async Task OnInitializedAsync()
    {
        var auth = await AuthState.GetAuthenticationStateAsync();
        authenticated = auth.User?.Identity?.IsAuthenticated ?? false;
        tree = (await Viewer.GetPublishedTreeAsync(Culture)).ToList();
        treeLoaded = true;
    }

    protected override async Task OnParametersSetAsync()
    {
        if (!treeLoaded)
        {
            return;
        }

        if (Slug != loadedSlug)
        {
            loadedSlug = Slug;
            current = string.IsNullOrEmpty(Slug) ? null : await Viewer.GetPublishedTopicAsync(Slug, Culture, authenticated);
        }
    }
}
