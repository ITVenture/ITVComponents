<MudDialog Class="itv-fill-editor">
    <DialogContent>
        <DialogFillStyles />
        <MudForm @ref="form" Model="Model">
            <MudTextField @bind-Value="Model.DiagnosticsQueryName" Label="Name" Required="true" RequiredError="Name is required" MaxLength="128" />
            <MudTextField @bind-Value="Model.DbContext" Label="DbContext" Required="true" RequiredError="DbContext is required" MaxLength="128" />
            <MudCheckBox @bind-Value="Model.AutoReturn" Label="Auto return" />
            <ForeignKeyAutocomplete T="int" Table="Permissions" @bind-Value="Model.PermissionId" Label="Required permission" />
            <div class="d-flex align-center justify-space-between mt-3">
                <MudText Typo="Typo.caption">Query text</MudText>
                <MudToggleGroup T="string" Value="@editorLanguage" ValueChanged="OnLanguageChanged" Size="Size.Small" Color="Color.Primary" CheckMark="false">
                    <MudToggleItem Value="@("sql")" Text="SQL" />
                    <MudToggleItem Value="@("csharp")" Text="C#" />
                </MudToggleGroup>
            </div>
            <CodeEditor @ref="queryEditor" Value="@Model.QueryText" Language="@editorLanguage" Height="280" Fill="true" />
            <MudSelect T="int" MultiSelection="true"
                       SelectedValues="@selectedTenants"
                       SelectedValuesChanged="@OnTenantsChanged"
                       Label="Tenants"
                       AnchorOrigin="Origin.BottomCenter">
                @foreach (var t in AllTenants)
                {
                    <MudSelectItem T="int" Value="@t.TenantId">@t.DisplayName</MudSelectItem>
                }
            </MudSelect>
        </MudForm>
    </DialogContent>
    <DialogActions>
        <DialogMaximizeToggle NormalMaxWidth="MaxWidth.Medium" />
        <MudSpacer />
        <MudButton OnClick="Cancel">Cancel</MudButton>
        <MudButton Color="Color.Primary" OnClick="Save">@(IsCreate ? "Create" : "Save")</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter, EditorRequired] public DiagnosticsQueryViewModel Model { get; set; } = default!;
    [Parameter] public bool IsCreate { get; set; }
    [Parameter] public IReadOnlyList<TenantChoice> AllTenants { get; set; } = Array.Empty<TenantChoice>();

    private MudForm? form;
    private CodeEditor? queryEditor;
    private string editorLanguage = "sql";
    private IReadOnlyCollection<int> selectedTenants = Array.Empty<int>();

    private async Task OnLanguageChanged(string language)
    {
        editorLanguage = language;
        if (queryEditor is not null) await queryEditor.SetLanguageAsync(language);
    }

    protected override void OnInitialized()
    {
        selectedTenants = Model.Tenants.ToList();
    }

    private void OnTenantsChanged(IEnumerable<int> values)
    {
        var arr = values.ToArray();
        selectedTenants = arr;
        Model.Tenants = arr;
    }

    private void Cancel() => MudDialog.Cancel();

    private async Task Save()
    {
        if (form is null) return;
        await form.Validate();
        if (!form.IsValid) return;
        if (queryEditor is not null) Model.QueryText = await queryEditor.GetValueAsync();
        MudDialog.Close(DialogResult.Ok(Model));
    }
}
