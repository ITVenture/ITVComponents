@namespace ITVComponents.WebCoreToolkit.Blazor.SharedComponents
@typeparam T
@implements IDisposable

@using ITVComponents.EFRepo.Helpers
@using ITVComponents.WebCoreToolkit.EntityFramework.Extensions
@using ITVComponents.WebCoreToolkit.EntityFramework.Models
@using Microsoft.Extensions.Logging

@inject IServiceProvider Services
@inject ILogger<ForeignKeySelect<T>> logger;

@* Mud dropdown that pulls FK options in-process via Toolkit's ContextForFkQuery,
   the same code path the /ForeignKey/{connection}/{table} HTTP endpoint uses.
   Items are expected to expose Id and Caption (Name/DisplayName as fallbacks).
   When the EntityWriteTracker is active, the option list reloads as soon as the
   backing table is written (e.g. a new entry added in another window). *@

<MudSelect T="T"
           Value="Value"
           ValueChanged="ValueChanged"
           Label="@Label"
           Required="@Required"
           Clearable="@Clearable"
           HelperText="@StateHelperText"
           Disabled="@(Disabled || _loading || _items.Count == 0)">
    @foreach (var item in _items)
    {
        <MudSelectItem T="T" Value="@item.Id">@item.Caption</MudSelectItem>
    }
</MudSelect>
@if (_loading)
{
    @* Ohne dieses Signal ist ein deaktiviertes Feld zweideutig: es koennte laden oder leer sein. *@
    <MudProgressLinear Indeterminate="true" Size="Size.Small" Color="Color.Primary" />
}

@code {
    [Parameter] public T Value { get; set; } = default!;
    [Parameter] public EventCallback<T> ValueChanged { get; set; }
    [Parameter] public string Label { get; set; } = string.Empty;
    [Parameter] public string Connection { get; set; } = "sys";
    [Parameter, EditorRequired] public string Table { get; set; } = string.Empty;
    [Parameter] public bool Required { get; set; }
    [Parameter] public bool Clearable { get; set; } = true;
    [Parameter] public bool Disabled { get; set; }

    /// <summary>
    /// Hint shown below the field. Replaced by the loading / no-entries message while either applies.
    /// </summary>
    [Parameter] public string? HelperText { get; set; }

    /// <summary>
    /// Shown while the option-list is being fetched. This package ships no language files of its own —
    /// a consumer that wants it translated passes its own text.
    /// </summary>
    [Parameter] public string LoadingText { get; set; } = "Loading entries…";

    /// <summary>Shown once the option-list is loaded and turns out to be empty.</summary>
    [Parameter] public string NoDataText { get; set; } = "No entries available";

    private record Item(T Id, string Caption);
    private readonly List<Item> _items = new();
    private IEntityWriteTracker? _tracker;
    private bool _loading = true;
    private bool _loaded;

    /// <summary>
    /// A disabled dropdown alone does not say WHY it is disabled - this does.
    /// </summary>
    private string? StateHelperText
        => _loading ? LoadingText
            : _loaded && _items.Count == 0 ? NoDataText
            : HelperText;

    protected override async Task OnInitializedAsync()
    {
        await LoadItemsAsync();

        // Optional active refresh: only present when ActivationSettings.UseEntityTracker is on.
        _tracker = Services.TrackerForContext(Connection, null);
        if (_tracker != null)
        {
            _tracker.TablesWritten += OnTablesWritten;
        }
    }

    private async Task LoadItemsAsync()
    {
        _loading = true;
        await Task.Yield();
        _items.Clear();
        try
        {
            var src = Services.ContextForFkQuery(Connection, null);
            if (src is null) return;
            var raw = src.ReadForeignKey<T>(Table);
            if (raw is null) return;
            foreach (var obj in raw)
            {
                _items.Add(new Item(obj.Key, obj.Label));
            }
        }
        catch (Exception ex)
        {
            logger.LogError(ex, "Error loading foreign key options for table {Table}", Table);
            // Best-effort: swallow loader errors so the dialog still renders. The user
            // can still pick "no value" via Clearable; selecting an unknown value would
            // need the full list, but at least the form does not crash.
        }
        finally
        {
            // Auch bei fruehem return (keine FK-Quelle) und im Fehlerfall: der Ladezustand ist vorbei.
            // Bliebe er stehen, waere das Feld dauerhaft gesperrt.
            _loading = false;
            _loaded = true;
        }
    }

    private void OnTablesWritten(string[] tables)
    {
        if (tables.All(table => !string.Equals(table, Table, StringComparison.OrdinalIgnoreCase)))
        {
            return;
        }

        // The tracker raises on the writer's thread (possibly another circuit) → marshal to ours.
        _ = InvokeAsync(async () =>
        {
            // Erst rendern, dann laden: sonst zeigt das Feld waehrend des Nachladens den alten Stand
            // ohne jeden Hinweis darauf, dass gerade neu geholt wird.
            _loading = true;
            StateHasChanged();
            await LoadItemsAsync();
            StateHasChanged();
        });
    }

    public void Dispose()
    {
        if (_tracker != null)
        {
            _tracker.TablesWritten -= OnTablesWritten;
        }
    }
}
