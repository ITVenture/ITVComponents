@using InputType = ITVComponents.WebCoreToolkit.EntityFramework.Models.InputType

<MudDialog>
    <DialogContent>
        <MudForm @ref="form" Model="Model">
            <MudTextField @bind-Value="Model.ParameterName" Label="Parameter name" Required="true" RequiredError="Name is required" MaxLength="128" />
            <MudSelect T="InputType" @bind-Value="Model.InputType" Label="Input type">
                @foreach (var it in Enum.GetValues<InputType>())
                {
                    <MudSelectItem T="InputType" Value="@it">@it</MudSelectItem>
                }
            </MudSelect>
            <MudTextField @bind-Value="Model.InputConfig" Label="Input config" Lines="3" />
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Cancel</MudButton>
        <MudButton Color="Color.Primary" OnClick="Save">@(IsCreate ? "Create" : "Save")</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter, EditorRequired] public DashboardParamViewModel Model { get; set; } = default!;
    [Parameter] public bool IsCreate { get; set; }

    private MudForm? form;

    private void Cancel() => MudDialog.Cancel();

    private async Task Save()
    {
        if (form is null) return;
        await form.Validate();
        if (!form.IsValid) return;
        MudDialog.Close(DialogResult.Ok(Model));
    }
}
