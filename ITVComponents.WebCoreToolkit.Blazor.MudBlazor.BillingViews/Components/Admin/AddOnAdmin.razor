@page "/Billing/AddOns"
@rendermode @(RenderMode.InteractiveServer)
@attribute [Microsoft.AspNetCore.Authorization.Authorize]

@inject IBillingHandler Handler
@inject AuthenticationStateProvider AuthState
@inject ISnackbar Snackbar

<PageTitle>Add-ons</PageTitle>

<MudText Typo="Typo.h5" GutterBottom="true">Add-ons</MudText>
<MudText Typo="Typo.body2" Class="mb-3">An add-on defines a name and the features it grants. Its price and which plans it can be booked with are configured per plan on the Plans page.</MudText>

@if (currentUser is null)
{
    <MudProgressCircular Indeterminate="true" />
}
else if (!canAdmin)
{
    <MudAlert Severity="Severity.Warning">You don't have permission to manage add-ons.</MudAlert>
}
else
{
    <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" Class="mb-3" OnClick="@(() => Edit(new AddOnViewModel()))">
        New add-on
    </MudButton>

    <MudTable Items="addOns" Dense="true" Hover="true">
        <HeaderContent>
            <MudTh>Name</MudTh>
            <MudTh>Features</MudTh>
            <MudTh>Active</MudTh>
            <MudTh>Provider product</MudTh>
            <MudTh></MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="Name">@context.Name</MudTd>
            <MudTd DataLabel="Features">@FeatureSummary(context)</MudTd>
            <MudTd DataLabel="Active">@(context.IsActive ? "yes" : "no")</MudTd>
            <MudTd DataLabel="Provider product">@ProductSummary(context)</MudTd>
            <MudTd>
                <MudStack Row="true" Spacing="1">
                    <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" OnClick="@(() => Edit(context))" />
                    <MudButton Size="Size.Small" StartIcon="@Icons.Material.Filled.CloudUpload" Disabled="@busy" OnClick="@(() => Push(context.AddOnId))">
                        Push to provider
                    </MudButton>
                </MudStack>
            </MudTd>
        </RowTemplate>
    </MudTable>

    @if (editModel is not null)
    {
        <MudPaper Class="pa-4 mt-4" Outlined="true">
            <MudText Typo="Typo.h6">@(editModel.AddOnId == 0 ? "New add-on" : $"Edit {editModel.Name}")</MudText>
            <MudGrid>
                <MudItem xs="12" sm="6"><MudTextField @bind-Value="editModel.Name" Label="Name" Required="true" /></MudItem>
                <MudItem xs="12" sm="6"><MudTextField @bind-Value="editModel.Description" Label="Description" /></MudItem>
                <MudItem xs="12">
                    <MudSelect T="string" Label="Features" MultiSelection="true"
                               SelectedValues="selectedFeatures" SelectedValuesChanged="OnFeaturesChanged"
                               AnchorOrigin="Origin.BottomCenter">
                        @foreach (var opt in featureOptions)
                        {
                            <MudSelectItem T="string" Value="@opt.Name">@opt.Display</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
                <MudItem xs="12"><MudCheckBox T="bool" @bind-Value="editModel.IsActive" Label="Active" /></MudItem>
            </MudGrid>
            <MudStack Row="true" Spacing="2" Class="mt-2">
                <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="@busy" OnClick="Save">Save</MudButton>
                <MudButton Variant="Variant.Text" OnClick="@(() => editModel = null)">Cancel</MudButton>
            </MudStack>
        </MudPaper>
    }
}

@code {
    private System.Security.Claims.ClaimsPrincipal? currentUser;
    private bool canAdmin;
    private bool busy;
    private IReadOnlyList<AddOnViewModel> addOns = System.Array.Empty<AddOnViewModel>();
    private AddOnViewModel? editModel;
    private IReadOnlyList<FeatureCatalogItemViewModel> catalog = System.Array.Empty<FeatureCatalogItemViewModel>();
    private IReadOnlyCollection<string> selectedFeatures = System.Array.Empty<string>();
    private List<FeatureOption> featureOptions = new();

    private sealed record FeatureOption(string Name, string Display);

    protected override async Task OnInitializedAsync()
    {
        var auth = await AuthState.GetAuthenticationStateAsync();
        currentUser = auth.User;
        canAdmin = Handler.CanAdminister(currentUser);
        if (canAdmin)
        {
            catalog = await Handler.GetFeatureCatalogAsync();
            await Reload();
        }
    }

    private async Task Reload() => addOns = await Handler.GetAllAddOnsAsync();

    private void OnFeaturesChanged(IEnumerable<string> values) => selectedFeatures = values.ToList();

    // Options = catalog features (disabled ones marked) plus any keys already on the add-on that no longer exist
    // in the catalog (marked "unknown"), so editing never silently drops an orphaned key.
    private void BuildFeatureOptions()
    {
        var opts = new List<FeatureOption>();
        var seen = new HashSet<string>(System.StringComparer.OrdinalIgnoreCase);
        foreach (var f in catalog)
        {
            opts.Add(new FeatureOption(f.Name, f.Enabled ? f.Name : $"{f.Name} (disabled)"));
            seen.Add(f.Name);
        }
        foreach (var key in editModel!.FeatureKeys.Where(k => !seen.Contains(k)))
        {
            opts.Add(new FeatureOption(key, $"{key} (unknown)"));
            seen.Add(key);
        }
        featureOptions = opts.OrderBy(o => o.Name).ToList();
    }

    private void Edit(AddOnViewModel model)
    {
        editModel = new AddOnViewModel
        {
            AddOnId = model.AddOnId,
            Name = model.Name,
            Description = model.Description,
            IsActive = model.IsActive,
            FeatureKeys = new List<string>(model.FeatureKeys)
        };
        selectedFeatures = new List<string>(editModel.FeatureKeys);
        BuildFeatureOptions();
    }

    private string FeatureSummary(AddOnViewModel addOn)
        => addOn.FeatureKeys.Count == 0 ? "—" : string.Join(", ", addOn.FeatureKeys);

    private string ProductSummary(AddOnViewModel addOn)
        => "—"; // provider product id is set on push; not surfaced in the identity list

    private async Task Save()
    {
        if (editModel is null)
        {
            return;
        }

        editModel.FeatureKeys = selectedFeatures
            .Where(k => !string.IsNullOrWhiteSpace(k))
            .Distinct(System.StringComparer.OrdinalIgnoreCase)
            .ToList();

        busy = true;
        try
        {
            await Handler.SaveAddOnAsync(editModel);
            Snackbar.Add("Add-on saved", Severity.Success);
            editModel = null;
            await Reload();
        }
        catch (System.Exception ex)
        {
            Snackbar.Add($"Save failed: {ex.Message}", Severity.Error);
        }
        finally
        {
            busy = false;
        }
    }

    private async Task Push(int addOnId)
    {
        busy = true;
        try
        {
            await Handler.PushAddOnAsync(addOnId);
            Snackbar.Add("Pushed to provider", Severity.Success);
            await Reload();
        }
        catch (System.Exception ex)
        {
            Snackbar.Add($"Push failed: {ex.Message}", Severity.Error);
        }
        finally
        {
            busy = false;
        }
    }
}
