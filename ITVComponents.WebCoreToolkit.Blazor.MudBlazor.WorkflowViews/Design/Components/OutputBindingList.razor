@using ITVComponents.Workflow.Model

@*
    Freier Editor fuer eine Liste von Ausgabe-Bindungen (Quelle → Ziel). Gemeinsam fuer generische
    Aktivitaet, Subworkflow-Aufruf und das Workflow-Ergebnis am End-Knoten - dieselbe Zeile, nur andere
    Beschriftungen.
*@

@if (Bindings is not null)
{
    @foreach (var b in Bindings)
    {
        <MudStack Row="true" Spacing="1" AlignItems="AlignItems.Center" Class="mt-1" @key="b">
            <MudTextField T="string" Value="@b.Parameter" ValueChanged="@(v => b.Parameter = v)"
                          Placeholder="@SourcePlaceholder" Margin="Margin.Dense" Style="@($"max-width:{SourceWidth}")" />
            <MudIcon Icon="@Icons.Material.Filled.ArrowForward" Size="Size.Small" />
            <MudTextField T="string" Value="@b.Variable" ValueChanged="@(v => b.Variable = v)"
                          Placeholder="@TargetPlaceholder" Margin="Margin.Dense" />
            <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error"
                           OnClick="@(() => Bindings.Remove(b))" />
        </MudStack>
    }
    <MudStack Row="true" Spacing="1" AlignItems="AlignItems.Center" Class="mt-1">
        <MudTextField T="string" @bind-Value="newName" Placeholder="@AddPlaceholder"
                      Margin="Margin.Dense" Style="max-width:150px" />
        <MudIconButton Icon="@Icons.Material.Filled.Add" Size="Size.Small" Color="Color.Primary" OnClick="Add" />
    </MudStack>
}

@code {
    /// <summary>Die bearbeitete Liste (wird in-place veraendert).</summary>
    [Parameter] public List<ActivityOutputBinding>? Bindings { get; set; }

    /// <summary>Platzhalter der Quellspalte (<c>Parameter</c>).</summary>
    [Parameter] public string SourcePlaceholder { get; set; } = "name";

    /// <summary>Platzhalter der Zielspalte (<c>Variable</c>).</summary>
    [Parameter] public string TargetPlaceholder { get; set; } = "variable";

    /// <summary>Platzhalter der Zeile zum Anlegen.</summary>
    [Parameter] public string AddPlaceholder { get; set; } = "new output name";

    /// <summary>Breite der Quellspalte (CSS-Laengenangabe).</summary>
    [Parameter] public string SourceWidth { get; set; } = "130px";

    private string? newName;

    private void Add()
    {
        if (Bindings is null || string.IsNullOrWhiteSpace(newName))
        {
            return;
        }

        if (!Bindings.Any(x => x.Parameter == newName))
        {
            Bindings.Add(new ActivityOutputBinding { Parameter = newName });
        }

        newName = null;
    }
}
