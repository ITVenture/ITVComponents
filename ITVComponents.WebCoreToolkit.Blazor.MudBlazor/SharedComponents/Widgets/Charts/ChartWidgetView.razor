@* Der gemeinsame Teil beider Diagramm-Renderer: aus den Deklarationen werden MudCharts.

   Er kennt weder Scriban noch CScript - die beiden unterscheiden sich nur darin, wie aus dem
   Konfigurationstext Eintraege werden. Alles danach passiert hier.

   Eine Konfiguration darf ein Diagramm beschreiben oder mehrere. Mehrere ordnen sich nach dem Platz:
   nebeneinander, solange jedes noch seine Mindestbreite bekommt, sonst untereinander. Bewusst ueber
   Flex und nicht ueber Breakpoints - wie breit die Kachel wirklich ist, haengt an ihrem ColSpan UND am
   Fenster, und das weiss nur der Browser. *@

@namespace ITVComponents.WebCoreToolkit.Blazor.SharedComponents.Widgets.Charts
@using System.Globalization
@using Microsoft.AspNetCore.Components
@using ITVComponents.WebCoreToolkit.Blazor.SharedComponents.Widgets
@inject NavigationManager Navigation

@if (Errors.Count != 0)
{
    @* Was die ganze Kachel betrifft: unlesbares JSON, ein Skript das wirft. Dann gibt es nichts zu
       zeichnen - im Unterschied zum Fehler eines einzelnen Diagramms weiter unten. *@
    <MudAlert Severity="Severity.Error" Dense="true">
        @ErrorTitle
        <ul class="mt-1">
            @foreach (string error in Errors)
            {
                <li><MudText Typo="Typo.caption">@error</MudText></li>
            }
        </ul>
    </MudAlert>
}
else if (Panels.Count == 1)
{
    @* Der Regelfall - ein Diagramm. Ohne den Flex-Mantel, damit eine bestehende Kachel exakt so aussieht
       wie vorher. *@
    @Panel(Panels[0])
}
else
{
    <div class="d-flex flex-wrap align-stretch">
        @foreach (ChartWidgetPanel panel in Panels)
        {
            <div class="pa-1" style="@PanelStyle(panel)">
                @Panel(panel)
            </div>
        }
    </div>
}

@code {
    /// <summary>What to draw - one entry per chart.</summary>
    [Parameter] public IReadOnlyList<ChartWidgetPanel> Panels { get; set; } = Array.Empty<ChartWidgetPanel>();

    /// <summary>
    /// What was wrong with the configuration AS A WHOLE. Empty = nothing; the individual charts carry
    /// their own complaints.
    /// </summary>
    [Parameter] public IReadOnlyList<string> Errors { get; set; } = Array.Empty<string>();

    /// <summary>Raised when a category was clicked and it carries no navigation target.</summary>
    [Parameter] public EventCallback<WidgetAction> OnAction { get; set; }

    [Parameter] public string ErrorTitle { get; set; } = "This chart cannot be drawn:";

    /// <summary>
    /// Wie viel Platz ein Diagramm beansprucht: seine Mindestbreite, und darueber hinaus zu gleichen
    /// Teilen. <c>min(100%, …)</c> ist die Sicherung fuer den schmalen Fall - ohne sie wuerde eine Kachel,
    /// die selbst schmaler ist als die Mindestbreite, seitlich ueberlaufen.
    /// </summary>
    private static string PanelStyle(ChartWidgetPanel panel)
    {
        int min = panel.Declaration?.MinWidth ?? ChartWidgetDeclaration.DefaultMinWidth;
        return min <= 0
            ? "flex: 1 1 0; min-width: 0;"
            : FormattableString.Invariant($"flex: 1 1 {min}px; min-width: min(100%, {min}px);");
    }

    /// <summary>
    /// Ein einzelnes Diagramm - oder, wenn an ihm etwas nicht stimmt, dessen Meldung an seinem Platz. Die
    /// uebrigen Diagramme der Kachel bleiben davon unberuehrt.
    /// </summary>
    private RenderFragment<ChartWidgetPanel> Panel => panel =>
        @<text>
            @if (!string.IsNullOrEmpty(panel.Declaration?.Title))
            {
                @* Uebersetzt wird HIER und nicht beim Lesen der Deklaration: der Titel darf ein
                   Kultur-Datensatz sein, und die Aufloesung gehoert zur Anzeige. *@
                <MudText Typo="Typo.subtitle2" Align="Align.Center">
                    @WidgetTemplateFunctions.Translate(panel.Declaration!.Title!)
                </MudText>
            }
            @if (panel.Errors.Count != 0)
            {
                <MudAlert Severity="Severity.Error" Dense="true">
                    @ErrorTitle
                    <ul class="mt-1">
                        @foreach (string error in panel.Errors)
                        {
                            <li><MudText Typo="Typo.caption">@error</MudText></li>
                        }
                    </ul>
                </MudAlert>
            }
            else if (panel.Declaration is not null)
            {
                @* Die drei aufbereiteten Felder ausdruecklich - so prueft der Uebersetzer ihre Namen. Der
                   Rest kommt als geprueftes Woerterbuch dazu; T bleibt double, damit es ohne Typinferenz
                   auskommt. *@
                <MudChart T="double"
                          ChartType="@panel.Declaration.Type"
                          ChartLabels="@panel.LabelTexts"
                          ChartSeries="@panel.Declaration.Series"
                          SelectedIndexChanged="@(index => OnSelected(panel, index))"
                          @attributes="@panel.Parameters" />
            }
        </text>;

    /// <summary>
    /// Klick auf ein Segment oder einen Legendeneintrag. Der Regelfall ist der Sprung auf eine Seite;
    /// ohne Ziel bleibt es bei der Aktion, die eine Anwendung ueber OnWidgetAction bekommt - dasselbe,
    /// was ein HTML-Template ueber data-widget-action ausloest.
    /// </summary>
    private void OnSelected(ChartWidgetPanel panel, int index)
    {
        ChartWidgetDeclaration? declaration = panel.Declaration;
        if (declaration is null || index < 0 || index >= declaration.Labels.Count)
        {
            return;
        }

        ChartWidgetLabel label = declaration.Labels[index];
        if (!string.IsNullOrWhiteSpace(label.NavigateTo))
        {
            // Relative Ziele loest NavigateTo gegen die Basis der Anwendung auf - und genau die traegt in
            // einer mandanten-praefixierten Anwendung den Praefix. Ein root-absolutes Ziel ginge daran
            // vorbei (BUG-PRE141); das bleibt Sache dessen, der es so schreibt.
            Navigation.NavigateTo(label.NavigateTo!);
            return;
        }

        if (OnAction.HasDelegate)
        {
            // Der Aktionsname kommt aus der Deklaration: bei mehreren Diagrammen in einer Kachel koennte
            // die Anwendung sonst nicht unterscheiden, welches geklickt wurde.
            _ = OnAction.InvokeAsync(new WidgetAction(declaration.Action, label.Text));
        }
    }
}
