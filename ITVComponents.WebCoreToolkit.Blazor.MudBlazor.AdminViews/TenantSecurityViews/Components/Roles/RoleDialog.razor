<EditDialogShell Model="Model" IsCreate="IsCreate">
    <MudTextField @bind-Value="Model.RoleName" Label="Role name" Required="true" RequiredError="Role name is required" />
    @if (AllowSystemRole)
    {
        <MudCheckBox @bind-Value="Model.IsSystemRole" Label="System role" />
    }
</EditDialogShell>

@code {
    [Parameter, EditorRequired] public RoleViewModel Model { get; set; } = default!;
    [Parameter] public bool IsCreate { get; set; }
    [Parameter] public bool AllowSystemRole { get; set; }
}
