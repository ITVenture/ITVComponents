@page "/Account/Manage/PersonalData"
@rendermode @(RenderMode.InteractiveServer)

@layout ManageLayout
@attribute [Microsoft.AspNetCore.Authorization.Authorize]

@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.Extensions.Localization
@using ITVComponents.WebCoreToolkit.Blazor.MudBlazor.IdentityPages.Components.Account.Shared
@using ITVComponents.WebCoreToolkit.IdentityShared.Areas.Identity
@using ITVComponents.WebCoreToolkit.IdentityShared.Areas.Identity.Pages.Account.Manage
@using ITVComponents.WebCoreToolkit.IdentityShared.PageHandlers.Identity.Account.Manage

@inject IPageHandlerProvider<PersonalDataModel, IPersonalDataHandler> HandlerProvider
@inject AuthenticationStateProvider AuthState
@inject IStringLocalizer<IdentityMessages> L

<PageTitle>@L["Personal Data"]</PageTitle>

<MudText Typo="Typo.h5" GutterBottom="true">@L["Personal Data"]</MudText>

@if (loading)
{
    <MudProgressCircular Indeterminate="true" />
}
else if (!usePage)
{
    <MudAlert Severity="Severity.Info">@L["This page is not available."]</MudAlert>
}
else if (notFound)
{
    <MudAlert Severity="Severity.Error">@notFoundMessage</MudAlert>
}
else
{
    <MudText GutterBottom="true">
        @L["Your account contains personal data that you have given us. This page allows you to download or delete that data."]
    </MudText>
    <MudAlert Severity="Severity.Warning" Class="mb-3">
        <strong>@L["Deleting this data will permanently remove your account, and this cannot be recovered."]</strong>
    </MudAlert>

    @* Bleibt ein echter Browser-Post: die Antwort ist ein Dateidownload, den der Endpunkt als Datei
       zurueckgibt. Ueber den Circuit liesse sich das nur mit einem Umweg ueber JS-Interop nachbauen.
       Ein gewoehnliches <form> statt EditForm, weil EditForm den Submit interaktiv abfangen wuerde;
       der Endpunkt ist mit DisableAntiforgery registriert. *@
    <form method="post" action="Account/Manage/DownloadPersonalData" class="mb-3">
        <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary">
            @L["Download"]
        </MudButton>
    </form>

    <MudButton Href="Account/Manage/DeletePersonalData" Variant="Variant.Filled" Color="Color.Secondary">
        @L["Delete"]
    </MudButton>
}

@code {
    private bool loading = true;
    private bool usePage;
    private bool notFound;
    private string? notFoundMessage;

    protected override async Task OnInitializedAsync()
    {
        await using var op = HandlerProvider.BeginOperation();
        usePage = op.Handler.UsePage;
        if (!usePage)
        {
            loading = false;
            return;
        }

        var principal = (await AuthState.GetAuthenticationStateAsync()).User;
        var userExists = await op.Handler.UserExists(principal);
        if (!userExists)
        {
            notFound = true;
            notFoundMessage = L["Unable to load user with ID '{0}'.", op.Handler.GetUserId(principal)];
        }

        loading = false;
    }
}
