@page "/Account/ForgotPasswordConfirmation"
@attribute [Microsoft.AspNetCore.Components.ExcludeFromInteractiveRouting]

@using Microsoft.Extensions.Localization
@using ITVComponents.WebCoreToolkit.Net.TelerikUi.IdentityPages.Areas.Identity

@inject IStringLocalizer<IdentityMessages> L

<PageTitle>@L["Forgot password confirmation"]</PageTitle>

<MudContainer MaxWidth="MaxWidth.Small" Class="mt-8">
    <MudPaper Elevation="2" Class="pa-6">
        <MudText Typo="Typo.h4" GutterBottom="true">@L["Forgot password confirmation"]</MudText>
        <MudText>@L["Please check your email to reset your password."]</MudText>
    </MudPaper>
</MudContainer>
