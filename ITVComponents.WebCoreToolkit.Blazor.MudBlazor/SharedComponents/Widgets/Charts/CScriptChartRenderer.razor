@* Diagramm-Kachel, deren Konfiguration ein CScript-Ausdruck ist.

   Der Text ist ein Objektliteral ueber demselben Modell, gegen das auch ein Scriban-Template rendert
   (Rows, Row, Count, Params, Title) - mit LINQ und nativen C#-Ausdruecken, wo es passt:

     { type: ChartType.Pie,
       labels: column(Rows, "Status"),
       series: [ { name: "Anzahl", data: column(Rows, "Anzahl") } ] }

   DREI Eigenheiten von CScript, die man kennen muss:
   - Text steht in DOPPELTEN Anfuehrungszeichen. Einfache bezeichnen einen TYP ('System.TimeSpan'), aus
     'pie' wuerde also der Versuch, einen Typ namens pie zu laden.
   - Ein Ausdruck darf grammatikalisch nicht mit '{' beginnen. Das Objektliteral ist aber genau das, was
     hier stehen soll - deshalb klammert dieser Renderer es selbst ein, statt dem Autor die Eigenheit
     aufzubuerden. Wer den Block-Modus waehlt, schreibt ohnehin 'return { ... };'.
   - Es gibt KEINE Lambda-Ausdruecke: Rows.Select(r => r.Status) ist ein Syntaxfehler, und ein
     Funktions-Literal nehmen die LINQ-Methoden nicht an. Dafuer gibt es column(Rows, "Spalte"). Wer mehr
     braucht, nimmt die native Einbettung - echtes C#, auch als Wert mitten in der Deklaration:
       labels: `E(Rows as Rows->DEFAULT)::@"...C#, Zugriff ueber Global.Rows..." with {}
     Das "with {…}" ist PFLICHT, auch leer. using-Anweisungen und Referenzen bringt man ueber
     `U(cfg)"using ...;" bzw. `R(cfg)"Assembly" an - beides sind Anweisungen und gehen darum nur im
     Block-Modus. System.Linq ist in DEFAULT schon enthalten.

   Ausdruck oder Block wird GEWAEHLT und nicht geraten (Einstellung scriptMode): ein Block ohne return
   liefert null, und Parse auf einen Block angewendet wirft nicht, sondern liefert still etwas Falsches.

   MEHRERE Diagramme aus DENSELBEN Daten: statt des einen Objektliterals eine LISTE davon. Die Abfrage
   laeuft dabei genau einmal; jeder Eintrag darf zusaetzlich title, minWidth und action tragen:

     [ { title: "Nach Status", type: ChartType.Pie,  labels: column(Rows, "Status"), … },
       { title: "Verlauf",     type: ChartType.Line, minWidth: 400, … } ] *@

@namespace ITVComponents.WebCoreToolkit.Blazor.SharedComponents.Widgets.Charts
@using System.Collections.Generic
@using Microsoft.AspNetCore.Components
@using ITVComponents.Scripting.CScript.Core
@using Microsoft.Extensions.Logging
@using ITVComponents.WebCoreToolkit.Blazor.SharedComponents.Widgets
@attribute [WidgetRenderer("chart.cscript", DisplayName = "{\"de\":\"Diagramm (CScript)\",\"Default\":\"Chart (CScript)\"}", EditorLanguage = "csharp")]
@implements IWidgetRenderer
@inject ILogger<CScriptChartRenderer> Logger

<ChartWidgetView Panels="@panels"
                 Errors="@errors"
                 OnAction="@OnAction" />

@code {
    /// <inheritdoc />
    [Parameter] public string TemplateSource { get; set; } = "";

    /// <inheritdoc />
    [Parameter] public WidgetTemplateModel? Data { get; set; }

    /// <inheritdoc />
    [Parameter] public IReadOnlyDictionary<string, string?> Options { get; set; }
        = new Dictionary<string, string?>();

    /// <inheritdoc />
    [Parameter] public EventCallback<WidgetAction> OnAction { get; set; }

    /// <inheritdoc />
    [Parameter] public EventCallback<Exception> OnRenderError { get; set; }

    /// <summary>Die Einstellung, mit der zwischen Ausdruck und Block gewaehlt wird.</summary>
    public const string ScriptModeOption = "scriptMode";

    /// <summary>Der Wert der Einstellung, der einen Anweisungsblock mit <c>return</c> meint.</summary>
    public const string BlockMode = "block";

    private IReadOnlyList<ChartWidgetPanel> panels = Array.Empty<ChartWidgetPanel>();
    private List<string> errors = new();

    private string? lastSource;
    private object? lastData;
    private string? lastMode;

    protected override void OnParametersSet()
    {
        // Das Parameter-Woerterbuch der DynamicComponent entsteht bei JEDEM Zeichnen neu - ohne diesen
        // Vergleich liefe die Auswertung bei jedem Render erneut.
        string mode = Mode;
        if (ReferenceEquals(lastSource, TemplateSource) && ReferenceEquals(lastData, Data) && lastMode == mode)
        {
            return;
        }

        lastSource = TemplateSource;
        lastData = Data;
        lastMode = mode;
        Evaluate(mode);
    }

    private string Mode
        => Options != null && Options.TryGetValue(ScriptModeOption, out string? value) && !string.IsNullOrEmpty(value)
            ? value!
            : "expression";

    private void Evaluate(string mode)
    {
        panels = Array.Empty<ChartWidgetPanel>();
        errors = new List<string>();

        if (string.IsNullOrWhiteSpace(TemplateSource))
        {
            errors.Add("The configuration is empty.");
            return;
        }

        try
        {
            Dictionary<string, object> variables = BuildVariables(Data);

            object? result = string.Equals(mode, BlockMode, StringComparison.OrdinalIgnoreCase)
                ? ExpressionParser.ParseBlock(TemplateSource, variables)
                : ExpressionParser.Parse(AsExpression(TemplateSource), variables);

            if (result == null)
            {
                errors.Add(string.Equals(mode, BlockMode, StringComparison.OrdinalIgnoreCase)
                    ? "The script produced no result - is a 'return' missing?"
                    : "The expression produced no result.");
                return;
            }

            IReadOnlyList<object?>? entries = AsEntries(result, errors);
            if (entries == null)
            {
                return;
            }

            panels = ChartWidgetPanel.Build(entries);
        }
        catch (Exception ex)
        {
            // Die Kachel zeigt die Meldung, das Log bekommt den ganzen Vorgang: welcher Modus, welcher
            // Text. Weil beim Speichern nur noch die Syntax geprueft wird, ist DIES die Stelle, an der ein
            // inhaltlicher Fehler sichtbar werden muss - und zwar nachvollziehbar.
            errors.Add(ex.Message);
            Logger.LogError(ex,
                "Die CScript-Diagramm-Konfiguration konnte nicht ausgewertet werden (Modus {Mode}). Text: {Configuration}",
                mode, TemplateSource);
            if (OnRenderError.HasDelegate)
            {
                _ = OnRenderError.InvokeAsync(ex);
            }
        }
    }

    /// <summary>
    /// Reads what the script returned as one entry per chart.
    /// </summary>
    /// <param name="result">what the expression or the block produced</param>
    /// <param name="errors">receives the complaint when it is neither - das betrifft die ganze Kachel</param>
    /// <returns>the entries, or null when the result is not a declaration at all</returns>
    /// <remarks>
    /// Das ObjectLiteral von CScript IST ein Woerterbuch (<c>IScope : IDictionary&lt;string, object&gt;</c>)
    /// - siehe die Anmerkung an <c>ChartWidgetDeclaration.AsMap</c>. Es muss deshalb VOR der Aufzaehlung
    /// geprueft werden: ein Woerterbuch ist selbst aufzaehlbar, und aus einem Diagramm wuerden sonst so
    /// viele "Diagramme", wie die Deklaration Felder hat.
    /// </remarks>
    public static IReadOnlyList<object?>? AsEntries(object? result, List<string> errors)
    {
        ArgumentNullException.ThrowIfNull(errors);
        switch (result)
        {
            case null:
                errors.Add("The configuration produced no chart declaration.");
                return null;

            case IDictionary<string, object?> map:
                return new object?[] { map };

            case string text:
                errors.Add($"The configuration produced the text '{text}', not a chart declaration.");
                return null;

            case System.Collections.IEnumerable list:
                return list.Cast<object?>().ToArray();

            default:
                errors.Add($"The configuration produced a {result.GetType().Name}, not a chart declaration.");
                return null;
        }
    }

    /// <summary>
    /// What the configuration can reach: the data model, the chart type and the same helpers the Scriban
    /// side has. Public, damit der Gleichlauf von Pruefung und Ausfuehrung pruefbar ist.
    /// </summary>
    /// <remarks>
    /// <para>
    /// <c>column</c> ist hier nicht Bequemlichkeit, sondern der Ersatz fuer etwas, das CScript NICHT hat:
    /// Lambda-Ausdruecke. <c>Rows.Select(r =&gt; r.Status)</c> ist ein Syntaxfehler, und ein
    /// Funktions-Literal nehmen die LINQ-Methoden nicht an ("No capable Method found for Select"). Ohne
    /// diesen Helfer bliebe fuer die haeufigste Aufgabe - eine Spalte als Liste - nur die native
    /// Einbettung.
    /// </para>
    /// <para>
    /// <c>ChartType</c> liegt als TYP im Geltungsbereich, damit <c>ChartType.Pie</c> geschrieben werden
    /// kann; Zeichenketten gehen weiterhin. <c>translate</c> loest einen Kultur-Datensatz auf, wie im
    /// Scriban-Template.
    /// </para>
    /// </remarks>
    public static Dictionary<string, object> BuildVariables(WidgetTemplateModel? data)
    {
        var column = (Func<object?, string, IReadOnlyList<object?>>)((rows, name)
            => WidgetRowAccessor.Column(rows as IEnumerable<object?>, name));
        var translate = (Func<object?, string>)(value => WidgetTemplateFunctions.Translate(value));

        return new Dictionary<string, object>
        {
            // IMMER als object[] - und zwar bei der Pruefung wie beim Ausfuehren. Wer im nativen Code
            // castet, braucht einen Typ, auf den er sich verlassen kann; vorher lag hier beim Ausfuehren
            // eine List<object> (so baut sie der Runner) und beim Pruefen ein object[]. Das Ergebnis war
            // das denkbar Schlechteste: was sich speichern liess, scheiterte im Betrieb - und umgekehrt.
            { nameof(WidgetTemplateModel.Rows), data?.Rows?.ToArray() ?? Array.Empty<object?>() },
            { nameof(WidgetTemplateModel.Row), data?.Row! },
            { nameof(WidgetTemplateModel.Count), data?.Count ?? 0 },
            { nameof(WidgetTemplateModel.Params), data?.Params ?? new Dictionary<string, string?>() },
            { nameof(WidgetTemplateModel.Title), data?.Title ?? string.Empty },
            { nameof(ChartType), typeof(ChartType) },
            { "column", column },
            { "translate", translate }
        };
    }

    /// <summary>
    /// Makes an object or array literal usable as an expression.
    /// </summary>
    /// <remarks>
    /// Die Grammatik verbietet einem Ausdruck, mit <c>{</c> zu beginnen (der Interpreter meldet ein
    /// "failed predicate"). Genau so sieht eine Diagramm-Deklaration aber aus - also wird sie geklammert.
    /// Das ist keine Auslegung des Textes, sondern eine reine Syntax-Anpassung: was der Autor schreibt,
    /// bleibt Wort fuer Wort dasselbe. Die Liste MEHRERER Diagramme beginnt mit <c>[</c> und bekommt
    /// dieselbe Klammer - eine Klammer um einen Ausdruck aendert nie seine Bedeutung, und darauf zu
    /// wetten, dass die Grammatik ein Feld-Literal am Anfang mag, waere unnoetig.
    /// </remarks>
    private static string AsExpression(string source)
    {
        string trimmed = source.TrimStart();
        // Die schliessende Klammer MUSS auf eine eigene Zeile: endet der Text mit einem
        // Zeilenkommentar - und genau so endet er, wenn der Knopf "Parameter einfuegen" seine
        // Uebersicht angehaengt hat -, verschluckt der Kommentar sonst die Klammer.
        return trimmed.StartsWith("{", StringComparison.Ordinal)
               || trimmed.StartsWith("[", StringComparison.Ordinal)
            ? $"({source}{Environment.NewLine})"
            : source;
    }

    /// <summary>
    /// The settings this renderer offers - handed to the registry so the editor can ask for them.
    /// </summary>
    public static IReadOnlyList<DeclaredField> DeclaredOptions { get; } = new[]
    {
        new DeclaredField
        {
            Name = ScriptModeOption,
            Label = "Script mode",
            Kind = DeclaredFieldKind.Choice,
            HelpText = "An expression is a single object literal. A script block runs statements and must end with 'return'.",
            Choices = new[]
            {
                new DeclaredChoice { Value = "expression", Label = "Expression" },
                new DeclaredChoice { Value = BlockMode, Label = "Script block" }
            }
        }
    };

    /// <summary>
    /// Lists the pass-through parameters of the chart component - for the editor's "insert parameters"
    /// button. Was hier steht, kommt aus der Komponente selbst und ist damit immer der Stand der
    /// eingesetzten Fassung; die Beispiele dazu stehen in der Hilfe.
    /// </summary>
    public static string DescribeParameters()
        => ChartParameterBinder.Describe(typeof(MudChart<double>), asJson: false);

    /// <summary>
    /// Checks a configuration when the widget is saved - <b>syntactically</b>.
    /// </summary>
    /// <remarks>
    /// Hier wird NICHTS ausgefuehrt. Der frueher gewaehlte Weg - einmal mit leeren Zeilen auswerten -
    /// beanstandete jede voellig richtige Konfiguration, die auf Daten zugreift: <c>Rows[0].Months</c>
    /// scheitert ohne Zeilen mit "Index was outside the bounds of the array", und der Editor liess sich
    /// nicht mehr speichern. Was ein Ausdruck TUT, laesst sich ohne Daten nicht beurteilen; ob er
    /// uebersetzbar ist, schon. Alles Weitere - unbekannte Parameter, unlesbare Deklaration - meldet die
    /// Kachel zur Laufzeit, mit Meldung und Log-Eintrag.
    /// </remarks>
    public static string? Validate(string? configuration, IReadOnlyDictionary<string, string?> options)
    {
        if (string.IsNullOrWhiteSpace(configuration))
        {
            return "The configuration is empty.";
        }

        bool block = options != null
                     && options.TryGetValue(ScriptModeOption, out string? mode)
                     && string.Equals(mode, BlockMode, StringComparison.OrdinalIgnoreCase);

        try
        {
            ExpressionParser.GetRawExpressionTree(
                block ? configuration! : AsExpression(configuration!),
                block ? ExpressionParser.ExpressionMode.Program : ExpressionParser.ExpressionMode.Expression);
        }
        catch (Exception ex)
        {
            return ex.Message;
        }

        // Das eine, was sich am Text sicher sagen laesst: ohne 'return' kann ein Block kein Ergebnis
        // haben. Eine Textsuche genuegt dafuer - kommt das Wort nirgends vor, gibt es auch keinen Pfad,
        // auf dem eines entstuende.
        if (block && configuration!.IndexOf("return", StringComparison.OrdinalIgnoreCase) < 0)
        {
            return "A script block must end with 'return' - without it the configuration has no result.";
        }

        return null;
    }

}
