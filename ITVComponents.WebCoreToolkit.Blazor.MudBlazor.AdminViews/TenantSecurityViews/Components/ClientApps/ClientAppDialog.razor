@using Microsoft.Extensions.Localization
@using ITVComponents.WebCoreToolkit.Blazor.MudBlazor.AdminViews.TenantSecurityViews.ViewModels
@using ITVComponents.WebCoreToolkit.Blazor.MudBlazor.AdminViews.TenantSecurityViews.Handlers

@inject IStringLocalizer<ClientAppMessages> L

<MudDialog>
    <DialogContent>
        <MudForm @ref="form">
            <MudTextField @bind-Value="Model.ClientName"
                          Label="@L["App_Col_Name"]"
                          Required="true"
                          RequiredError="@L["App_Dlg_NameRequired"]"
                          MaxLength="200" />

            @if (IsCreate)
            {
                <MudSelect T="int" @bind-Value="Model.ClientAppTemplateId"
                           Label="@L["App_Col_Template"]"
                           Required="true"
                           RequiredError="@L["App_Dlg_TemplateRequired"]"
                           HelperText="@L["App_Dlg_TemplateHelpCreate"]">
                    @foreach (var t in templates)
                    {
                        <MudSelectItem T="int" Value="@t.ClientAppTemplateId">@t.Name</MudSelectItem>
                    }
                </MudSelect>
            }
            else
            {
                @* Das Template bleibt: ein Wechsel machte die zugeordneten Buendel ungueltig. *@
                <MudTextField Value="@Model.TemplateName" Label="@L["App_Col_Template"]" ReadOnly="true"
                              HelperText="@L["App_Dlg_TemplateHelpEdit"]" />
                <MudTextField Value="@Model.ClientKey" Label="@L["App_Dlg_ClientKey"]" ReadOnly="true"
                              HelperText="@L["App_Dlg_ClientKeyHelp"]" />
            }

            <MudSwitch @bind-Value="Model.Enabled" Label="@L["App_Dlg_Enabled"]" Color="Color.Primary" Class="mt-4" />
            <MudText Typo="Typo.caption">
                @L["App_Dlg_EnabledHint"]
            </MudText>
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">@L["App_Cancel"]</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="Submit">
            @(IsCreate ? L["App_Dlg_Create"] : L["App_Dlg_Save"])
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter, EditorRequired] public ClientAppViewModel Model { get; set; } = new();
    [Parameter] public bool IsCreate { get; set; }
    [Parameter] public IReadOnlyList<ClientAppTemplateViewModel> Templates { get; set; } = Array.Empty<ClientAppTemplateViewModel>();

    private MudForm? form;
    private IReadOnlyList<ClientAppTemplateViewModel> templates = Array.Empty<ClientAppTemplateViewModel>();

    protected override void OnParametersSet()
    {
        templates = Templates;
        if (IsCreate && Model.ClientAppTemplateId == 0 && templates.Count > 0)
        {
            Model.ClientAppTemplateId = templates[0].ClientAppTemplateId;
        }
    }

    private async Task Submit()
    {
        if (form is not null)
        {
            await form.Validate();
            if (!form.IsValid) return;
        }

        if (IsCreate && Model.ClientAppTemplateId == 0)
        {
            return;
        }

        MudDialog.Close(DialogResult.Ok(Model));
    }

    private void Cancel() => MudDialog.Cancel();
}
