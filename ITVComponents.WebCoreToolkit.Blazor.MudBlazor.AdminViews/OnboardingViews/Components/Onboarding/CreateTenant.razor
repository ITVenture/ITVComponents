@namespace ITVComponents.WebCoreToolkit.Blazor.MudBlazor.AdminViews.OnboardingViews.Components.Onboarding
@page "/Account/Onboarding/CreateTenant"
@rendermode @(RenderMode.InteractiveServer)
@using Microsoft.AspNetCore.Authorization
@using System.Text.Json.Nodes
@using ITVComponents.WebCoreToolkit.Blazor.MudBlazor.AdminViews.OnboardingViews.Components.Shared
@attribute [Authorize]

@inject IOnboardingHandler Handler
@inject ICustomCompanyInfoProvider CustomInfo
@inject NavigationManager Nav
@inject ISnackbar Snackbar
@inject AuthenticationStateProvider AuthState
@inject IStringLocalizer<OnboardingMessages> L

<PageTitle>@L["Onb_Register"]</PageTitle>

<MudContainer MaxWidth="MaxWidth.Medium" Class="my-4">
    <MudText Typo="Typo.h4" GutterBottom="true">@L["Onb_Register"]</MudText>
    <MudText Typo="Typo.body1" Class="mb-4">
        @L["Onb_Intro"]
    </MudText>

    <EditForm Model="model" OnValidSubmit="OnSubmitAsync">
        <DataAnnotationsValidator />

        <BillingProfileForm @ref="profileForm" Model="model"
                            ShowParentTenantPicker="@(!HasInvitation && Handler.ParentPolicy.ShowPicker)"
                            ParentRequired="@(!HasInvitation && Handler.ParentPolicy.ParentRequired)"
                            EligibleParents="parents"
                            CustomTabs="customTabs"
                            CustomInfo="customCtx"
                            ProfileTypeChanged="DescribeCustomAsync" />

        @if (HasInvitation)
        {
            <MudAlert Severity="Severity.Info" Class="mb-3">@L["Onb_Inv_ParentPinned"]</MudAlert>
        }

        <MudStack Row="true" Justify="Justify.FlexEnd" Spacing="2" Class="mt-3">
            <MudButton Href="/Account/Onboarding/MyTenants" Variant="Variant.Text" Color="Color.Default">@L["Onb_Cancel"]</MudButton>
            <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary" Disabled="busy">
                @(busy ? L["Onb_Creating"].Value : L["Onb_CreateTenant"].Value)
            </MudButton>
        </MudStack>

        <ValidationSummary />
    </EditForm>
</MudContainer>

@code {
    private BillingProfileViewModel model = new();
    private TenantPickerItem[] parents = Array.Empty<TenantPickerItem>();
    private BillingProfileForm? profileForm;
    private IReadOnlyList<CustomInfoTab>? customTabs;
    private CustomInfoContext? customCtx;
    private System.Security.Claims.ClaimsPrincipal? currentUser;
    private bool busy;

    /// <summary>When set (from an accept link), the parent tenant is pinned by the token; hide the picker.</summary>
    [SupplyParameterFromQuery(Name = "invitation")]
    private string? InvitationToken { get; set; }

    private bool HasInvitation => !string.IsNullOrEmpty(InvitationToken);

    protected override async Task OnInitializedAsync()
    {
        model.InvitationToken = InvitationToken;
        var state = await AuthState.GetAuthenticationStateAsync();
        currentUser = state.User;
        if (state.User.Identity?.IsAuthenticated == true && !HasInvitation)
        {
            parents = await Handler.ListEligibleParentsAsync(state.User);
        }

        await DescribeCustomAsync();
    }

    /// <summary>
    /// Fragt die Zusatzangaben-Module, welche Reiter dieser Fall braucht. Wird auch nach einem Wechsel
    /// der Profilart erneut gerufen - ein Modul darf fuer eine Firma andere Angaben verlangen als fuer
    /// eine Einzelperson.
    /// </summary>
    private async Task DescribeCustomAsync()
    {
        customCtx = new CustomInfoContext
        {
            Mode = CustomInfoMode.Create,
            Origin = HasInvitation ? CustomInfoOrigin.Invitation : CustomInfoOrigin.SelfService,
            ProfileType = model.ProfileType,
            ParentTenantId = model.ParentTenantId,
            User = currentUser
        };
        customTabs = await CustomInfo.DescribeAsync(customCtx);
    }

    private async Task OnSubmitAsync()
    {
        busy = true;
        try
        {
            // Erst die Zusatzangaben einsammeln: fehlt in einem Reiter etwas, springt die Maske ihn an,
            // und wir schicken gar nicht erst ab.
            if (profileForm is not null && !await profileForm.TryCollectCustomAsync())
            {
                return;
            }

            // Der Erfassungsfall traegt jetzt den endgueltigen Stand des Formulars.
            if (customCtx is not null)
            {
                customCtx.ProfileType = model.ProfileType;
                customCtx.ParentTenantId = model.ParentTenantId;

                CustomInfoCheckResult check = await CustomInfo.ValidateAsync(customCtx, Buckets());
                if (!check.Valid)
                {
                    profileForm?.ShowCustomError(check.HandlerKey, check.Message);
                    return;
                }
            }

            var id = await Handler.CreateTenantAsync(currentUser!, model);
            if (id is null)
            {
                Snackbar.Add(L["Onb_CreateFailed"], Severity.Error);
                return;
            }
            Snackbar.Add(L["Onb_TenantCreated"], Severity.Success);
            Nav.NavigateTo("/Account/Onboarding/MyTenants");
        }
        finally
        {
            busy = false;
        }
    }

    /// <summary>Die erfassten Datensaetze ohne die leeren Eintraege.</summary>
    private IReadOnlyDictionary<string, JsonNode> Buckets()
        => model.CustomInfo
            .Where(e => e.Value is not null)
            .ToDictionary(e => e.Key, e => e.Value!, StringComparer.Ordinal);
}
