<EditDialogShell Model="Model" IsCreate="IsCreate" InvalidMessage="Please correct invalid fields">
    <MudTextField @bind-Value="Model.ParameterName" Label="Parameter name" Required="true" MaxLength="1024" />
    <MudTextField @bind-Value="Model.DisplayName" Label="Display name" />
    <MudTextField @bind-Value="Model.ParameterValue"
                  Label="Parameter value"
                  Required="true"
                  Lines="4" />
</EditDialogShell>

@code {
    [Parameter, EditorRequired] public TemplateModuleConfiguratorParameterViewModel Model { get; set; } = default!;
    [Parameter] public bool IsCreate { get; set; }
}
