@using Microsoft.AspNetCore.Components.Authorization
@using ITVComponents.WebCoreToolkit.Models.ExternalServiceConnect

@inject IExternalServiceAdminHandler Handler
@inject AuthenticationStateProvider AuthState
@inject IDialogService DialogService
@inject ISnackbar Snackbar

@* Die Zugangsdaten-Zeilen eines Dienstes: je Besitzer (Mandant oder Plattform) Token und/oder feste Zugangsdaten. Welche
   Zeile zur Laufzeit gilt, entscheidet die Aufloesung (eigene, dann die naechste weitergegebene im Baum, dann die der
   Plattform, falls der Dienst es erlaubt) - Leitfaden §90. *@
<MudDataGrid T="ExternalOAuthServiceTenantLoginViewModel"
             @ref="grid"
             ServerData="LoadData"
             SortMode="SortMode.None"
             RowsPerPage="10"
             Hover="true"
             Dense="true">
    <ToolBarContent>
        <CrudGridToolbar OnRefresh="@(() => grid is null ? Task.CompletedTask : grid.ReloadServerData())" Title="Credentials" TitleTypo="Typo.subtitle2" />
        @if (CanWrite && HasFixedCredentials)
        {
            <MudButton Size="Size.Small" Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Key" Class="ml-2"
                       OnClick="@(() => OpenEdit(false, null))">Set own credentials</MudButton>
            @if (IsSysAdmin && GlobalService)
            {
                <MudButton Size="Size.Small" Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Public" Class="ml-2"
                           OnClick="@(() => OpenEdit(true, null))">Set platform credentials</MudButton>
            }
        }
    </ToolBarContent>
    <Columns>
        <TemplateColumn T="ExternalOAuthServiceTenantLoginViewModel" Title="Owner" Sortable="false">
            <CellTemplate>@(context.Item.IsPlatform ? "Platform" : context.Item.TenantName)</CellTemplate>
        </TemplateColumn>
        <TemplateColumn T="ExternalOAuthServiceTenantLoginViewModel" Title="Credentials" Sortable="false">
            <CellTemplate>@(context.Item.HasCredentials ? "stored" : "—")</CellTemplate>
        </TemplateColumn>
        <TemplateColumn T="ExternalOAuthServiceTenantLoginViewModel" Title="Token" Sortable="false">
            <CellTemplate>@(context.Item.Revoked ? "revoked" : context.Item.HasToken ? "yes" : "—")</CellTemplate>
        </TemplateColumn>
        @if (Handler.SupportsCredentialInheritance)
        {
            <TemplateColumn T="ExternalOAuthServiceTenantLoginViewModel" Title="Passed on to sub-tenants" Sortable="false">
                <CellTemplate>@(context.Item.Inheritable ? "yes" : "no")</CellTemplate>
            </TemplateColumn>
        }
        <TemplateColumn T="ExternalOAuthServiceTenantLoginViewModel" Title="" Sortable="false">
            <CellTemplate>
                @if (CanWrite && context.Item.Editable)
                {
                    @if (HasFixedCredentials)
                    {
                        <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" OnClick="@(() => OpenEdit(context.Item.IsPlatform, context.Item))" />
                    }
                    @if (context.Item.HasToken && !context.Item.Revoked)
                    {
                        <MudButton Size="Size.Small" Color="Color.Warning" Variant="Variant.Outlined" OnClick="@(() => Revoke(context.Item))">Revoke</MudButton>
                    }
                    <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error" OnClick="@(() => Delete(context.Item))" />
                }
            </CellTemplate>
        </TemplateColumn>
    </Columns>
    <PagerContent>
        <MudDataGridPager T="ExternalOAuthServiceTenantLoginViewModel" />
    </PagerContent>
</MudDataGrid>

@code {
    [Parameter, EditorRequired] public int OAuthServiceId { get; set; }
    [Parameter] public ExternalServiceAuthenticationType AuthenticationType { get; set; }
    [Parameter] public bool GlobalService { get; set; }
    [Parameter] public bool IsSysAdmin { get; set; }
    [Parameter] public bool CanWrite { get; set; }

    private MudDataGrid<ExternalOAuthServiceTenantLoginViewModel>? grid;
    private System.Security.Claims.ClaimsPrincipal? currentUser;

    /// <summary>Authorization-Code verbindet sich per OAuth-Anmeldung - dort gibt es nur das Token, keine festen Zugangsdaten.</summary>
    private bool HasFixedCredentials => AuthenticationType != ExternalServiceAuthenticationType.OAuthAuthorizationFlow;

    protected override async Task OnInitializedAsync()
    {
        var auth = await AuthState.GetAuthenticationStateAsync();
        currentUser = auth.User;
    }

    private async Task<GridData<ExternalOAuthServiceTenantLoginViewModel>> LoadData(GridState<ExternalOAuthServiceTenantLoginViewModel> state, CancellationToken ct)
    {
        if (currentUser is null) return new GridData<ExternalOAuthServiceTenantLoginViewModel> { Items = Array.Empty<ExternalOAuthServiceTenantLoginViewModel>(), TotalItems = 0 };
        var query = new ListQuery { Page = state.Page, PageSize = state.PageSize };
        var result = await Handler.ListLoginsAsync(currentUser, OAuthServiceId, query);
        return new GridData<ExternalOAuthServiceTenantLoginViewModel> { Items = result.Items, TotalItems = result.TotalCount };
    }

    private async Task OpenEdit(bool platform, ExternalOAuthServiceTenantLoginViewModel? row)
    {
        var parameters = new DialogParameters<ExternalServiceCredentialDialog>
        {
            { d => d.Model, new ExternalServiceCredentialInputViewModel
                {
                    OAuthServiceId = OAuthServiceId, Platform = platform, Inheritable = row?.Inheritable ?? false
                } },
            { d => d.AuthenticationType, AuthenticationType },
            { d => d.HasStoredSecret, row?.HasCredentials ?? false },
            { d => d.SupportsInheritance, Handler.SupportsCredentialInheritance && !platform }
        };
        var dlg = await DialogService.ShowAsync<ExternalServiceCredentialDialog>(platform ? "Platform credentials" : "Own credentials", parameters, EditDialogDefaults.Edit);
        var result = await dlg.Result;
        if (result is { Canceled: false } && grid is not null)
        {
            Snackbar.Add("Credentials saved", Severity.Success);
            await grid.ReloadServerData();
        }
    }

    private async Task Revoke(ExternalOAuthServiceTenantLoginViewModel item)
    {
        var owner = item.IsPlatform ? "the platform" : $"tenant '{item.TenantName}'";
        var ok = await DialogService.ShowMessageBoxAsync("Revoke token", $"Revoke the token of {owner}?", yesText: "Revoke", cancelText: "Cancel");
        if (ok != true) return;
        if (await Handler.RevokeLoginAsync(currentUser!, item.ExternalOAuthServiceTenantLoginId))
        {
            Snackbar.Add("Token revoked", Severity.Success);
            if (grid is not null) await grid.ReloadServerData();
        }
        else Snackbar.Add("Failed to revoke", Severity.Error);
    }

    private async Task Delete(ExternalOAuthServiceTenantLoginViewModel item)
    {
        var owner = item.IsPlatform ? "the platform" : $"tenant '{item.TenantName}'";
        var ok = await DialogService.ShowMessageBoxAsync("Delete credentials", $"Delete token and credentials of {owner}?", yesText: "Delete", cancelText: "Cancel");
        if (ok != true) return;
        if (await Handler.DeleteCredentialsAsync(currentUser!, item.ExternalOAuthServiceTenantLoginId))
        {
            Snackbar.Add("Credentials deleted", Severity.Success);
            if (grid is not null) await grid.ReloadServerData();
        }
        else Snackbar.Add("Failed to delete", Severity.Error);
    }
}
