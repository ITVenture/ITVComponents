@page "/Security/Tenants"
@rendermode @(RenderMode.InteractiveServer)
@attribute [Microsoft.AspNetCore.Authorization.Authorize]

@using Microsoft.AspNetCore.Components.Authorization
@using ITVComponents.WebCoreToolkit.EntityFramework.TenantSecurity.Shared.Helpers.Models

@inject ITenantAdminHandler Handler
@inject AuthenticationStateProvider AuthState
@inject IDialogService DialogService
@inject ISnackbar Snackbar

<PageTitle>Tenants</PageTitle>

<MudText Typo="Typo.h5" GutterBottom="true">Tenants</MudText>

<SecureView RequiredPermissions="Tenants.View,Tenants.Write" RequiredFeatures="ITVAdminViews">
    <Permitted>
@if (currentUser is null)
{
    <MudProgressCircular Indeterminate="true" />
}
else
{
    <MudDataGrid T="TenantViewModel"
                 @ref="grid"
                 ServerData="LoadData"
                 SortMode="SortMode.Single"
                 RowsPerPage="25"
                 Hover="true"
                 Dense="true">
        <ToolBarContent>
            <CrudGridToolbar OnRefresh="ReloadGrid" Title="Tenants" @bind-Search="search" OnSearch="ReloadGrid">
                <SecureView RequiredPermissions="Tenants.Write">
                    <Permitted>
                        <MudButton StartIcon="@Icons.Material.Filled.Add" Variant="Variant.Filled" Color="Color.Primary" Class="ml-2" OnClick="OpenCreate">
                            Add tenant
                        </MudButton>
                    </Permitted>
                </SecureView>
            </CrudGridToolbar>
        </ToolBarContent>
        <Columns>
            <PropertyColumn Property="x => x.TenantName" Title="Name" />
            <PropertyColumn Property="x => x.DisplayName" Title="Display name" />
            <PropertyColumn Property="x => x.TimeZone" Title="Time zone" />
            @if (Handler.UseHierarchy)
            {
                <ForeignKeyColumn TItem="TenantViewModel" TProperty="int?"
                                  Property="x => x.ParentTenantId"
                                  Table="Tenants"
                                  Title="Parent tenant" />
            }

            <TemplateColumn T="TenantViewModel" Title="" Sortable="false">
                <CellTemplate>
                    <MudStack Row="true" Spacing="1">
                        <MudIconButton Icon="@Icons.Material.Filled.Visibility" Size="Size.Small" Title="Details" OnClick="@(() => OpenDetail(context.Item))" />
                        @if (context.Item.CanReapplyTemplate)
                        {
                            <SecureView RequiredPermissions="TenantTemplates.Write">
                                <Permitted>
                                    <MudIconButton Icon="@Icons.Material.Filled.Autorenew" Size="Size.Small" Color="Color.Primary" Title="Re-apply tenant-type template" OnClick="@(() => ReapplyTemplate(context.Item))" />
                                </Permitted>
                            </SecureView>
                        }
                        <SecureView RequiredPermissions="Tenants.Write">
                            <Permitted>
                            <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" OnClick="@(() => OpenEdit(context.Item))" />
                            <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error" OnClick="@(() => Delete(context.Item))" />
                            </Permitted>
                        </SecureView>
                    </MudStack>
                </CellTemplate>
            </TemplateColumn>
        </Columns>
        <PagerContent>
            <MudDataGridPager T="TenantViewModel" />
        </PagerContent>
    </MudDataGrid>
}
    </Permitted>
    <NotPermitted>
        <MudAlert Severity="Severity.Warning">No permission to view tenants.</MudAlert>
    </NotPermitted>
</SecureView>

@code {
    private MudDataGrid<TenantViewModel>? grid;
    private System.Security.Claims.ClaimsPrincipal? currentUser;
    private bool hasView;
    private bool hasWrite;
    private string? search;

    protected override async Task OnInitializedAsync()
    {
        var auth = await AuthState.GetAuthenticationStateAsync();
        currentUser = auth.User;
        hasView = Handler.HasPermission(currentUser, "Tenants.View", "Tenants.Write");
        hasWrite = Handler.HasPermission(currentUser, "Tenants.Write");
    }

    private async Task<GridData<TenantViewModel>> LoadData(GridState<TenantViewModel> state, CancellationToken ct)
    {
        if (currentUser is null) return new GridData<TenantViewModel> { Items = Array.Empty<TenantViewModel>(), TotalItems = 0 };
        var query = state.ToListQuery(search);
        var result = await Handler.ListTenantsAsync(currentUser, query);
        return new GridData<TenantViewModel> { Items = result.Items, TotalItems = result.TotalCount };
    }

    private async Task ReloadGrid()
    {
        if (grid is not null) await grid.ReloadServerData();
    }

    private async Task OpenCreate()
    {
        var parameters = new DialogParameters<TenantDialog>
        {
            { d => d.Model, new TenantViewModel() },
            { d => d.IsCreate, true },
            {d => d.UseHierarchy, Handler.UseHierarchy}
        };
        var dlg = await DialogService.ShowAsync<TenantDialog>("Create tenant", parameters, EditDialogDefaults.Edit);
        var result = await dlg.Result;
        if (result is { Canceled: false, Data: TenantViewModel input })
        {
            var created = await Handler.CreateTenantAsync(currentUser!, input);
            if (created != null) { Snackbar.Add("Tenant created", Severity.Success); await ReloadGrid(); }
            else Snackbar.Add("Failed to create tenant", Severity.Error);
        }
    }

    private async Task OpenEdit(TenantViewModel tenant)
    {
        var copy = new TenantViewModel
        {
            TenantId = tenant.TenantId,
            TenantName = tenant.TenantName,
            DisplayName = tenant.DisplayName,
            TimeZone = tenant.TimeZone,
            TenantTypeId = tenant.TenantTypeId,
            ParentTenantId = tenant.ParentTenantId
        };
        var parameters = new DialogParameters<TenantDialog>
        {
            { d => d.Model, copy },
            { d => d.IsCreate, false },
            {d => d.UseHierarchy, Handler.UseHierarchy}
        };
        var dlg = await DialogService.ShowAsync<TenantDialog>("Edit tenant", parameters, EditDialogDefaults.Edit);
        var result = await dlg.Result;
        if (result is { Canceled: false, Data: TenantViewModel input })
        {
            var updated = await Handler.UpdateTenantAsync(currentUser!, input);
            if (updated != null) { Snackbar.Add("Tenant updated", Severity.Success); await ReloadGrid(); }
            else Snackbar.Add("Failed to update tenant", Severity.Error);
        }
    }

    private async Task Delete(TenantViewModel tenant)
    {
        var ok = await DialogService.ShowMessageBoxAsync(
            "Delete tenant",
            $"Really delete '{tenant.TenantName}'?",
            yesText: "Delete", cancelText: "Cancel");
        if (ok != true) return;
        var success = await Handler.DeleteTenantAsync(currentUser!, tenant.TenantId);
        if (success) { Snackbar.Add("Tenant deleted", Severity.Success); await ReloadGrid(); }
        else Snackbar.Add("Failed to delete tenant", Severity.Error);
    }

    private async Task ReapplyTemplate(TenantViewModel tenant)
    {
        var title = string.IsNullOrEmpty(tenant.DisplayName) ? $"Re-apply template: {tenant.TenantName}" : $"Re-apply template: {tenant.DisplayName}";
        var dlg = await DialogService.ShowAsync<ReapplyTemplateDialog>(title, EditDialogDefaults.Edit);
        var result = await dlg.Result;
        if (result is { Canceled: false, Data: TemplateApplyMode mode })
        {
            var ok = await Handler.ReapplyTenantTemplateAsync(currentUser!, tenant.TenantId, mode);
            if (ok) { Snackbar.Add("Template re-applied", Severity.Success); await ReloadGrid(); }
            else Snackbar.Add("Failed to re-apply template", Severity.Error);
        }
    }

    private async Task OpenDetail(TenantViewModel tenant)
    {
        var parameters = new DialogParameters<TenantDetailDialog> { { d => d.Tenant, tenant } };
        var title = string.IsNullOrEmpty(tenant.DisplayName) ? $"Tenant: {tenant.TenantName}" : $"Tenant: {tenant.DisplayName}";
        var dlg = await DialogService.ShowAsync<TenantDetailDialog>(title, parameters, EditDialogDefaults.Detail);
        await dlg.Result;
    }
}
