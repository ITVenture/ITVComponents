@page "/Workflow/Editor/new"
@page "/Workflow/env/{Environment}/Editor/new"
@page "/Workflow/Definitions/{DefinitionId}/{Version:int}/edit"
@page "/Workflow/env/{Environment}/Definitions/{DefinitionId}/{Version:int}/edit"
@rendermode @(RenderMode.InteractiveServer)
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@using System.Globalization
@using System.IO
@using System.Text
@using System.Net
@using ITVComponents.Helpers
@using ITVComponents.Logging
@using ITVComponents.Workflow.Activities
@using ITVComponents.Workflow.Model
@using ITVComponents.Workflow.Serialization
@using ITVComponents.Workflow.Validation
@using Microsoft.Extensions.DependencyInjection

@inject IWorkflowDesignHandler Handler
@inject AuthenticationStateProvider AuthState
@inject ISnackbar Snackbar
@inject NavigationManager Nav
@inject IJSRuntime JS
@inject IServiceProvider Services
@inject IDialogService DialogService
@implements IAsyncDisposable

<PageTitle>Workflow editor</PageTitle>

<SecureView RequiredPermissions="Workflow.Design" RequiredFeatures="ITVWorkflow">
    <Permitted>
        @if (!loaded)
        {
            <MudProgressCircular Indeterminate="true" />
        }
        else if (def is null)
        {
            <MudAlert Severity="Severity.Warning">Definition not found.</MudAlert>
        }
        else
        {
            <MudToolBar Dense="true" Class="mb-2">
                <MudIconButton Icon="@Icons.Material.Filled.ArrowBack" Title="Back" OnClick="Back" />
                @if (isNew)
                {
                    <MudTextField @bind-Value="def.Id" Label="Id" Margin="Margin.Dense" Style="max-width:200px" Class="mr-2" />
                }
                else
                {
                    <MudText Typo="Typo.subtitle1" Class="mr-4"><b>@def.Id</b></MudText>
                }
                <MudTextField @bind-Value="def.Name" Label="Name" Margin="Margin.Dense" Style="max-width:240px" Class="mr-2" />
                <MudNumericField @bind-Value="def.Version" Label="Version" Min="1" Margin="Margin.Dense" Style="max-width:100px" />
                @if (def.DisabledForStart)
                {
                    <MudTooltip Text="This definition has validation errors and cannot be started until they are fixed. It is still saved.">
                        <MudChip T="string" Color="Color.Error" Variant="Variant.Filled" Size="Size.Small"
                                 Icon="@Icons.Material.Filled.Block" Class="ml-2">Not startable</MudChip>
                    </MudTooltip>
                }
                <MudSpacer />
                <MudButton StartIcon="@Icons.Material.Filled.Download" Variant="Variant.Text"
                           Class="mr-1" OnClick="ExportToFile">Export</MudButton>
                <label class="mr-2">
                    <InputFile OnChange="ImportFromFile" accept=".json" style="display:none" />
                    <MudButton StartIcon="@Icons.Material.Filled.Upload" Variant="Variant.Text"
                               Class="mr-1" HtmlTag="span">Import</MudButton>
                </label>
                <MudButton StartIcon="@Icons.Material.Filled.Checklist" Variant="Variant.Outlined"
                           Class="mr-2" OnClick="ValidateOnly">Validate</MudButton>
                @if (isNew)
                {
                    <MudButton StartIcon="@Icons.Material.Filled.Save" Variant="Variant.Filled" Color="Color.Primary"
                               OnClick="@(() => Save(asNewVersion: false))">Save</MudButton>
                }
                else
                {
                    <MudMenu Label="Save" Variant="Variant.Filled" Color="Color.Primary"
                             StartIcon="@Icons.Material.Filled.Save" EndIcon="@Icons.Material.Filled.ArrowDropDown">
                        <MudMenuItem OnClick="@(() => Save(asNewVersion: false))">Overwrite v@def.Version</MudMenuItem>
                        <MudMenuItem OnClick="@(() => Save(asNewVersion: true))">Save as new version</MudMenuItem>
                    </MudMenu>
                }
            </MudToolBar>

            @if (issues.Count > 0)
            {
                <MudPaper Outlined="true" Elevation="0" Class="pa-2 mb-2">
                    @foreach (var issue in issues)
                    {
                        <MudAlert Severity="@(issue.Severity == ValidationSeverity.Error ? Severity.Error : Severity.Warning)"
                                  Dense="true" Class="my-1">@issue.Message</MudAlert>
                    }
                </MudPaper>
            }

            <div class="wf-designer">
                <div class="wf-designer-row">
                    @* Toolbox: nur Symbole + Tooltip. Die Icons sind FontAwesome (in den Hosts ohnehin
                       geladen) - Text braucht es nicht, der Tooltip erklaert jedes Element.
                       Jedes Werkzeug laesst sich auch auf die Flaeche ZIEHEN (data-wf-tool): dann
                       entsteht der Knoten dort, wo er losgelassen wird, statt in der Mitte. Beim
                       Fristen-Timer ist das mehr als Bequemlichkeit - auf einem Schritt losgelassen
                       haengt er sich gleich an ihn. *@
                    <MudPaper Class="wf-rail pa-1" Elevation="1">
                        @foreach (var p in Palette)
                        {
                            @* Start und Ende gibt es genau einmal je Definition - der zweite waere ein
                               Validierungsfehler, also gar nicht erst anbieten. *@
                            <MudTooltip Placement="Placement.Right" Delay="200"
                                        Text="@(AlreadyPresent(p.Kind) ? $"A workflow has exactly one {p.Label.ToLowerInvariant()} node." : p.Tooltip)">
                                <MudButton Variant="Variant.Text" Class="wf-rail-btn"
                                           Disabled="@AlreadyPresent(p.Kind)"
                                           OnClick="@(() => { AddNode(p.Kind); })" aria-label="@p.Label"
                                           data-wf-tool="@p.Kind"
                                           draggable="@(AlreadyPresent(p.Kind) ? "false" : "true")">
                                    <i class="@p.Icon"></i>
                                </MudButton>
                            </MudTooltip>
                        }
                    </MudPaper>

                    @* Canvas mit Bedienleiste. Das Canvas fuellt genau die verfuegbare Breite - es wird
                       nie horizontal gescrollt, grosse Graphen erreicht man ueber Zoom/Pan. *@
                    <div class="wf-canvas-wrap">
                        <div class="wf-canvas-bar">
                            <MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Primary"
                                       StartIcon="@Icons.Material.Filled.Tune"
                                       Disabled="@(!HasSelection)" OnClick="OpenProperties">Properties</MudButton>
                            <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Error"
                                       StartIcon="@Icons.Material.Filled.Delete"
                                       Disabled="@(!HasSelection)" OnClick="DeleteSelected">Delete</MudButton>
                            <MudText Typo="Typo.body2" Class="ml-2 wf-sel-label">@SelectionLabel()</MudText>
                            <MudSpacer />
                            <MudText Typo="Typo.caption" Class="mud-text-secondary wf-hint mr-3">
                                Drag to move · double-click to edit · drag from a port to connect ·
                                drop a deadline on a step to attach it
                            </MudText>
                            <MudTooltip Text="Normal path"><span class="wf-legend"><span class="wf-dot wf-dot-ok"></span></span></MudTooltip>
                            <MudTooltip Text="Error path"><span class="wf-legend"><span class="wf-dot wf-dot-err"></span></span></MudTooltip>
                            @* Die beiden Fristen-Timer sehen sonst gleich aus, tun aber Verschiedenes. *@
                            <MudTooltip Text="Deadline, side path — reminds, the step keeps waiting (dashed outline)">
                                <span class="wf-legend"><span class="wf-dot wf-dot-side"></span></span>
                            </MudTooltip>
                            <MudTooltip Text="Deadline, interrupting — cancels the step, the main flow takes the path">
                                <span class="wf-legend"><span class="wf-dot wf-dot-interrupt"></span></span>
                            </MudTooltip>
                        </div>

                        <div class="wf-canvas-host" @ref="hostEl">
                            <svg @ref="svgEl" width="100%" height="100%"
                                 viewBox="@N(viewX) @N(viewY) @N(viewW) @N(viewH)"
                                 style="display:block; background:var(--mud-palette-background); touch-action:none; font-family:var(--mud-typography-body1-family, sans-serif);">
                                <defs>
                                    <marker id="wf-arrow-ed" markerWidth="10" markerHeight="8" refX="8" refY="4" orient="auto">
                                        <path d="M0,0 L8,4 L0,8 z" fill="var(--mud-palette-lines-default)" />
                                    </marker>
                                    @* Eigene Spitze fuer den Fehlerpfad - eine Kante faerbt ihren Marker nicht mit. *@
                                    <marker id="wf-arrow-err" markerWidth="10" markerHeight="8" refX="8" refY="4" orient="auto">
                                        <path d="M0,0 L8,4 L0,8 z" fill="var(--mud-palette-error)" />
                                    </marker>
                                </defs>
                                @CanvasBody()
                            </svg>

                            @* Zoom-/Pan-Bedienung. Zoom auch per Mausrad, Pan durch Ziehen auf leerer Flaeche. *@
                            <div class="wf-zoom">
                                <MudIconButton Icon="@Icons.Material.Filled.ZoomIn" Size="Size.Small"
                                               OnClick="@(() => ZoomBy(0.8))" Title="Zoom in" />
                                <MudIconButton Icon="@Icons.Material.Filled.ZoomOut" Size="Size.Small"
                                               OnClick="@(() => ZoomBy(1.25))" Title="Zoom out" />
                                <MudIconButton Icon="@Icons.Material.Filled.FitScreen" Size="Size.Small"
                                               OnClick="@(() => Fit())" Title="Fit to window" />
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }
    </Permitted>
    <NotPermitted>
        <MudAlert Severity="Severity.Warning">No permission to edit workflow definitions.</MudAlert>
    </NotPermitted>
</SecureView>

@code {
    [Parameter] public string? DefinitionId { get; set; }

    [Parameter] public int Version { get; set; }

    /// <summary>Die (optional) über das Nav-Segment vorgegebene Umgebung; null = Standard.</summary>
    [Parameter] public string? Environment { get; set; }

    /// <summary>URL-Präfix für Navigationsziele - env-scoped, wenn eine Umgebung wirksam ist.</summary>
    private string EnvPrefix => string.IsNullOrEmpty(Environment)
        ? "Workflow"
        : $"Workflow/env/{Uri.EscapeDataString(Environment!)}";

    private WorkflowDefinition? def;
    private bool loaded;
    private bool isNew;

    private WorkflowNode? selectedNode;
    private SequenceFlow? selectedFlow;

    // Sichtfenster (SVG-viewBox). Das Canvas fuellt das Host-Element; welcher Weltausschnitt sichtbar
    // ist, steuert allein die viewBox - so passt der Graph immer ins Fenster und Zoom/Pan aendern nur
    // diese vier Werte. Die JS-Seite manipuliert die viewBox waehrend Geste live und meldet sie danach
    // ueber OnViewChanged zurueck, damit der naechste Server-Render denselben Ausschnitt behaelt.
    private double viewX;
    private double viewY;
    private double viewW = 1200;
    private double viewH = 800;

    private ElementReference hostEl;
    private ElementReference svgEl;
    private DotNetObjectReference<WorkflowEditor>? selfRef;
    private bool jsAttached;

    private List<ValidationIssue> issues = new();

    // Verfuegbare Definition-Ids fuer das Subworkflow-Dropdown (leer -> Freitext im Editor).
    private IReadOnlyList<string>? subDefinitionIds;

    private bool HasSelection => selectedNode is not null || selectedFlow is not null;

    private static readonly (NodeKind Kind, string Label, string Icon, string Tooltip)[] Palette = new[]
    {
        (NodeKind.Start, "Start", "fa-solid fa-play", "Start — where every instance begins. Exactly one per definition; defines the input signature."),
        (NodeKind.AutomatedActivity, "Activity", "fa-solid fa-gears", "Activity — runs an automated step (a registered activity). Can have a red error output."),
        (NodeKind.UserActivity, "User task", "fa-solid fa-user-check", "User task — waits for a person to complete a form from their work list."),
        (NodeKind.CallWorkflow, "Subworkflow", "fa-solid fa-diagram-project", "Subworkflow — runs another definition as a child and waits for it. Can have a red error output."),
        (NodeKind.Wait, "Wait", "fa-solid fa-hourglass-half", "Wait — parks the token until a matching signal arrives (by name and correlation)."),
        (NodeKind.Timer, "Timer", "fa-solid fa-clock", "Timer — parks the token until a due date/time (or after a delay) is reached."),
        (NodeKind.BoundaryTimer, "Deadline", "fa-solid fa-bell", "Deadline — hangs on a step where the token parks and triggers a side path (escalation) when the time is up. Does not hold up the main flow."),
        (NodeKind.ExclusiveGateway, "XOR", "fa-solid fa-code-branch", "Exclusive gateway (XOR) — takes exactly one outgoing path based on conditions."),
        (NodeKind.ParallelGateway, "AND", "fa-solid fa-arrows-split-up-and-left", "Parallel gateway (AND) — splits into all branches, or joins them back together."),
        (NodeKind.SidePathEnd, "Side end", "fa-solid fa-circle-stop", "Side-path end — closes an escalation path. Consumes the token WITHOUT completing the workflow."),
        (NodeKind.End, "End", "fa-solid fa-flag-checkered", "End — completes the instance. Exactly one per definition; defines the result.")
    };

    /// <summary>
    /// Ob von dieser Sorte bereits ein Knoten existiert und deshalb kein weiterer angeboten wird. Gilt nur
    /// fuer Start und Ende: sie gibt es genau einmal je Definition (eindeutige Signatur, eindeutiges
    /// Ergebnis) - der Validator meldet einen zweiten als Fehler.
    /// </summary>
    private bool AlreadyPresent(NodeKind kind)
        => (kind == NodeKind.Start || kind == NodeKind.End)
           && def is not null && def.Nodes.Any(n => n.Kind == kind);

    protected override async Task OnParametersSetAsync()
    {
        loaded = false;
        isNew = string.IsNullOrEmpty(DefinitionId);
        var auth = await AuthState.GetAuthenticationStateAsync();

        if (isNew)
        {
            def = new WorkflowDefinition { Id = "new-workflow", Version = 1, Name = "New workflow" };
        }
        else
        {
            def = await Handler.GetDefinitionAsync(auth.User, DefinitionId!, Version, Environment);
            if (def is not null)
            {
                EnsureDiagram(def);
                // Ist die Definition als „nicht startbar" gespeichert, die Befunde gleich zeigen - der
                // Autor soll sofort sehen, WAS den Start blockiert, nicht erst nach erneutem „Validate".
                if (def.DisabledForStart)
                {
                    issues = WorkflowDefinitionValidator.Validate(def).ToList();
                }
            }
        }

        // Aufrufbare Definitionen fuer das Subworkflow-Dropdown laden (Best-Effort - ohne Liste Freitext).
        try
        {
            var list = await Handler.ListDefinitionsAsync(auth.User,
                new ListQuery { Page = 0, PageSize = 500 }, Environment);
            subDefinitionIds = list.Items.Select(i => i.Id).Distinct().OrderBy(x => x).ToList();
        }
        catch (Exception ex)
        {
            subDefinitionIds = null;
            LogEnvironment.LogEvent(
                $"Workflow-Editor: Subworkflow-Definitionsliste nicht ladbar: {ex.OutlineException()}",
                LogSeverity.Warning);
        }

        selectedNode = null;
        selectedFlow = null;
        Fit();
        loaded = true;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // Erst anhaengen, wenn das SVG wirklich gerendert ist (Definition geladen, sonst kein svgEl).
        if (jsAttached || !loaded || def is null)
        {
            return;
        }

        // Das Flag MUSS vor dem ersten await gesetzt werden: waehrend die beiden Interop-Aufrufe
        // offen sind, laeuft OnAfterRenderAsync erneut und wuerde ein zweites Mal anhaengen. Jede
        // attach-Closure hat ihr eigenes drag-Objekt -> ein Zug erzeugte zwei OnEdgeCreated und damit
        // zwei Verbindungen (sichtbar an zwei gestrichelten Temp-Linien beim Ziehen).
        jsAttached = true;
        selfRef ??= DotNetObjectReference.Create(this);
        try
        {
            await JS.InvokeAsync<IJSObjectReference>("import",
                "./_content/ITVComponents.WebCoreToolkit.Blazor.MudBlazor.WorkflowViews/graph-editor.js");
            await JS.InvokeVoidAsync("itvWfEditor.attach", hostEl, svgEl, selfRef);
        }
        catch (Microsoft.JSInterop.JSDisconnectedException ex)
        {
            // Erwarteter Normalfall (Tab geschlossen, Circuit weg) - nur als Spur, nicht als Fehler.
            jsAttached = false;
            LogEnvironment.LogEvent(
                $"Workflow-Editor: Circuit vor dem Anhaengen des JS-Interop beendet: {ex.Message}",
                LogSeverity.Report);
        }
        catch (Exception ex)
        {
            // Ohne JS bleibt der Editor statisch nutzbar (Palette/Panel); der Grund muss ins Log.
            jsAttached = false;
            LogEnvironment.LogEvent(
                $"Workflow-Editor: JS-Interop nicht initialisiert: {ex.OutlineException()}",
                LogSeverity.Warning);
        }
    }

    // --- Interop callbacks -------------------------------------------------------------------

    /// <summary>Ein Knoten wurde im Canvas verschoben (finale Position in SVG-Koordinaten).</summary>
    /// <remarks>
    /// Ein angedockter Fristen-Timer wird hier bewusst NICHT uebernommen: seine Lage ist abgeleitet (er
    /// klebt am Rand seines Schritts, <c>GraphLayout.DockBoundaryTimers</c>) und wuerde beim naechsten
    /// Render ohnehin wieder ueberschrieben. Die JS-Seite meldet sein Ablegen ueber
    /// <see cref="OnBoundaryTimerDropped"/> - dies ist der zweite Riegel gegen einen veralteten Client,
    /// der sonst still eine tote Koordinate ins Modell schriebe.
    /// </remarks>
    [JSInvokable]
    public void OnNodeMoved(string nodeId, double x, double y)
    {
        WorkflowNode? node = def?.GetNode(nodeId);
        if (node is null)
        {
            return;
        }

        // Nur ein TATSAECHLICH angedockter Timer wird abgewiesen. Ein eben abgelegter Timer hat noch
        // keinen Schritt - er muss frei platzierbar bleiben, bis einer zugewiesen ist (sonst klebte er
        // unverrueckbar dort, wo die Palette ihn hingelegt hat).
        if (node is BoundaryTimerNode timerNode
            && !string.IsNullOrEmpty(timerNode.AttachedToNodeId)
            && def?.GetNode(timerNode.AttachedToNodeId!) is not null)
        {
            LogEnvironment.LogEvent(
                $"Workflow-Editor: Verschieben des Fristen-Timers '{nodeId}' ignoriert - seine Position "
                + $"folgt dem Schritt '{timerNode.AttachedToNodeId}', an dem er haengt.", LogSeverity.Report);
            // Neu zeichnen, damit der Timer sichtbar an seinen Schritt zurueckspringt, statt dort liegen
            // zu bleiben, wo der Client ihn hingezogen hat - sonst zeigt das Bild eine Lage, die das
            // Modell nicht kennt.
            StateHasChanged();
            return;
        }

        node.Diagram ??= new DiagramShape();
        node.Diagram.X = Math.Round(x, 1);
        node.Diagram.Y = Math.Round(y, 1);
        StateHasChanged();
    }

    /// <summary>
    /// Ein Werkzeug wurde aus der Toolbox auf die Zeichenflaeche gezogen: neuer Knoten an der
    /// Ablagestelle. Wurde ein Fristen-Timer ueber einem geeigneten Schritt losgelassen, haengt er
    /// gleich an ihm - genau das ist der Sinn der Geste, sonst muesste man den Schritt anschliessend
    /// im Eigenschaften-Popup auswaehlen.
    /// </summary>
    /// <param name="kind">die Art des Knotens (Name aus <see cref="NodeKind"/>)</param>
    /// <param name="x">Ablagestelle X in Zeichenkoordinaten</param>
    /// <param name="y">Ablagestelle Y</param>
    /// <param name="targetNodeId">der Knoten unter dem Zeiger, oder null</param>
    [JSInvokable]
    public void OnToolDropped(string kind, double x, double y, string? targetNodeId)
    {
        if (def is null)
        {
            return;
        }

        if (!Enum.TryParse(kind, out NodeKind parsed) || !Palette.Any(p => p.Kind == parsed))
        {
            LogEnvironment.LogEvent(
                $"Workflow-Editor: unbekanntes Werkzeug '{kind}' abgelegt - kein Knoten angelegt.",
                LogSeverity.Warning);
            return;
        }

        if (AlreadyPresent(parsed))
        {
            // Die Schaltflaeche ist in diesem Fall gesperrt; ein Zug koennte sie umgehen (veralteter
            // Client, Tastatur-Drag). Zweiter Riegel, damit kein zweiter Start/Ende entsteht.
            LogEnvironment.LogEvent(
                $"Workflow-Editor: '{parsed}' abgelegt, obwohl bereits vorhanden - ignoriert.",
                LogSeverity.Report);
            return;
        }

        WorkflowNode? node = AddNode(parsed, x, y);
        if (node is BoundaryTimerNode timer && !string.IsNullOrEmpty(targetNodeId)
            && BoundaryTimerNode.CanHost(def.GetNode(targetNodeId!)))
        {
            timer.AttachedToNodeId = targetNodeId;
        }

        StateHasChanged();
    }

    /// <summary>
    /// Ein Fristen-Timer wurde im Canvas losgelassen. Auf einem geeigneten Schritt heisst das
    /// <b>andocken</b> (bzw. umhaengen), sonst ist es ein gewoehnliches Verschieben - solange der Timer
    /// noch an keinem Schritt haengt.
    /// </summary>
    /// <remarks>
    /// Ein bereits angedockter Timer, der NEBEN einen gueltigen Schritt fallen gelassen wird, springt
    /// zurueck: seine Lage ist abgeleitet (<c>GraphLayout.DockBoundaryTimers</c>), eine freie Position
    /// waere eine Angabe, die beim naechsten Zeichnen ohnehin verfaellt. Loesen tut man ihn ueber den
    /// Schritt im Eigenschaften-Popup, nicht durch Wegziehen - sonst waere jedes ungenaue Ablegen ein
    /// stilles Abhaengen.
    /// </remarks>
    /// <param name="nodeId">Id des gezogenen Fristen-Timers</param>
    /// <param name="hostNodeId">der Schritt unter dem Zeiger, oder null</param>
    /// <param name="x">Ablagestelle X (linke obere Ecke) in Zeichenkoordinaten</param>
    /// <param name="y">Ablagestelle Y</param>
    [JSInvokable]
    public void OnBoundaryTimerDropped(string nodeId, string? hostNodeId, double x, double y)
    {
        if (def?.GetNode(nodeId) is not BoundaryTimerNode timer)
        {
            LogEnvironment.LogEvent(
                $"Workflow-Editor: Ablegen ignoriert - '{nodeId}' ist kein Fristen-Timer (mehr).",
                LogSeverity.Warning);
            return;
        }

        WorkflowNode? host = string.IsNullOrEmpty(hostNodeId) ? null : def.GetNode(hostNodeId!);
        if (host is not null && BoundaryTimerNode.CanHost(host))
        {
            timer.AttachedToNodeId = host.Id;
            selectedFlow = null;
            selectedNode = timer;
            StateHasChanged();
            return;
        }

        if (!string.IsNullOrEmpty(timer.AttachedToNodeId) && def.GetNode(timer.AttachedToNodeId!) is not null)
        {
            LogEnvironment.LogEvent(
                $"Workflow-Editor: Fristen-Timer '{nodeId}' neben einem Schritt losgelassen - er bleibt "
                + $"an '{timer.AttachedToNodeId}' haengen.", LogSeverity.Report);
            StateHasChanged();
            return;
        }

        // Noch an keinem Schritt: frei platzierbar, sonst klebte er unverrueckbar dort, wo die Toolbox
        // ihn hingelegt hat.
        timer.Diagram ??= new DiagramShape();
        timer.Diagram.X = Math.Round(x, 1);
        timer.Diagram.Y = Math.Round(y, 1);
        StateHasChanged();
    }

    /// <summary>
    /// Der Nutzer hat vom Port des Quellknotens auf einen Zielknoten gezogen.
    /// <paramref name="portKind"/> ist <c>"err"</c>, wenn am roten Fehler-Port gezogen wurde - dann
    /// wird die neue Kante gleich zum Fehler-Ausgang des Knotens.
    /// </summary>
    [JSInvokable]
    public void OnEdgeCreated(string sourceId, string targetId, string? portKind)
    {
        WorkflowNode? source = def?.GetNode(sourceId);
        if (def is null || source is null || sourceId == targetId || def.GetNode(targetId) is null)
        {
            return;
        }

        var flow = new SequenceFlow { Id = NewId("f"), SourceId = sourceId, TargetId = targetId };
        def.Flows.Add(flow);

        if (string.Equals(portKind, "err", StringComparison.Ordinal))
        {
            // Ein zweiter Zug am roten Port ersetzt den bisherigen Fehler-Ausgang; die alte Kante
            // bleibt als normale Verbindung bestehen (loeschen waere ueberraschend).
            SetErrorFlowOf(source, flow.Id);
        }

        selectedNode = null;
        selectedFlow = flow;
        StateHasChanged();
    }

    /// <summary>Ein Knoten wurde ausgewaehlt (einfacher Klick).</summary>
    [JSInvokable]
    public void OnSelectNode(string nodeId)
    {
        selectedFlow = null;
        selectedNode = def?.GetNode(nodeId);
        StateHasChanged();
    }

    /// <summary>Eine Kante wurde ausgewaehlt (einfacher Klick).</summary>
    [JSInvokable]
    public void OnSelectEdge(string edgeId)
    {
        selectedNode = null;
        selectedFlow = def?.Flows.FirstOrDefault(f => f.Id == edgeId);
        StateHasChanged();
    }

    /// <summary>Leere Flaeche angeklickt - Auswahl aufheben.</summary>
    [JSInvokable]
    public void OnSelectNone()
    {
        selectedNode = null;
        selectedFlow = null;
        StateHasChanged();
    }

    /// <summary>Doppelklick auf einen Knoten - Auswahl setzen und das Eigenschaften-Popup oeffnen.</summary>
    [JSInvokable]
    public async Task OnEditNode(string nodeId)
    {
        selectedFlow = null;
        selectedNode = def?.GetNode(nodeId);
        if (selectedNode is not null)
        {
            await OpenProperties();
        }
    }

    /// <summary>Doppelklick auf eine Kante - Auswahl setzen und das Eigenschaften-Popup oeffnen.</summary>
    [JSInvokable]
    public async Task OnEditEdge(string edgeId)
    {
        selectedNode = null;
        selectedFlow = def?.Flows.FirstOrDefault(f => f.Id == edgeId);
        if (selectedFlow is not null)
        {
            await OpenProperties();
        }
    }

    /// <summary>
    /// Neuer Sichtausschnitt nach Zoom/Pan auf der JS-Seite. Wird NUR am Ende einer Geste gemeldet, damit
    /// der naechste Server-Render (Auswahl, Verschieben) denselben Ausschnitt behaelt statt zurueckzuspringen.
    /// Bewusst ohne StateHasChanged - die DOM-viewBox steht bereits, ein Render wuerde nur flackern.
    /// </summary>
    [JSInvokable]
    public void OnViewChanged(double x, double y, double w, double h)
    {
        viewX = x;
        viewY = y;
        viewW = w;
        viewH = h;
    }

    /// <summary>Die Entf-Taste im Canvas - das gerade gewaehlte Element loeschen.</summary>
    [JSInvokable]
    public void OnDeleteKey()
    {
        DeleteSelected();
        StateHasChanged();
    }

    // --- Properties popup --------------------------------------------------------------------

    /// <summary>
    /// Oeffnet das Eigenschaften-Popup fuer die aktuelle Auswahl (Knoten ODER Kante). Die Editoren darin
    /// mutieren dieselben Modell-Objekte per Referenz; hier wird nur eine Loesch-Anforderung ausgefuehrt
    /// und danach neu gerendert.
    /// </summary>
    private async Task OpenProperties()
    {
        if (def is null || !HasSelection)
        {
            return;
        }

        var parameters = new DialogParameters
        {
            { nameof(NodePropertiesDialog.Def), def },
            { nameof(NodePropertiesDialog.Node), selectedNode },
            { nameof(NodePropertiesDialog.Flow), selectedFlow },
            { nameof(NodePropertiesDialog.Environment), Environment },
            { nameof(NodePropertiesDialog.SubDefinitionIds), subDefinitionIds }
        };
        var options = new DialogOptions
        {
            MaxWidth = MaxWidth.Medium,
            FullWidth = true,
            CloseOnEscapeKey = true
        };

        IDialogReference dialog = await DialogService.ShowAsync<NodePropertiesDialog>(string.Empty, parameters, options);
        DialogResult? result = await dialog.Result;
        if (result is { Canceled: false, Data: NodePropertiesDialog.PropAction action }
            && action == NodePropertiesDialog.PropAction.Delete)
        {
            DeleteSelected();
        }

        StateHasChanged();
    }

    // --- Editing -----------------------------------------------------------------------------

    /// <summary>
    /// Legt einen neuen Knoten an und waehlt ihn aus.
    /// </summary>
    /// <param name="kind">die Art des Knotens</param>
    /// <param name="dropX">
    /// Ablagepunkt (Mitte des neuen Knotens) in Zeichenkoordinaten, wenn er per Ziehen aus der Toolbox
    /// entstanden ist - sonst null: dann landet er in der Mitte des Sichtfensters.
    /// </param>
    /// <param name="dropY">Ablagepunkt Y, siehe <paramref name="dropX"/>.</param>
    /// <returns>der neue Knoten, oder null, wenn keiner angelegt werden konnte</returns>
    private WorkflowNode? AddNode(NodeKind kind, double? dropX = null, double? dropY = null)
    {
        if (def is null)
        {
            return null;
        }

        WorkflowNode node = kind switch
        {
            NodeKind.Start => new StartNode(),
            NodeKind.End => new EndNode(),
            NodeKind.AutomatedActivity => new AutomatedActivityNode(),
            NodeKind.UserActivity => new UserActivityNode(),
            NodeKind.CallWorkflow => new CallWorkflowNode(),
            NodeKind.Wait => new WaitNode(),
            NodeKind.Timer => new TimerNode(),
            NodeKind.ExclusiveGateway => new ExclusiveGatewayNode(),
            NodeKind.ParallelGateway => new ParallelGatewayNode(),
            NodeKind.BoundaryTimer => new BoundaryTimerNode(),
            NodeKind.SidePathEnd => new SidePathEndNode(),
            _ => new AutomatedActivityNode()
        };

        node.Id = NewId("n");
        // Der Name aus der Toolbox statt des Enum-Bezeichners: er ist kuerzer und in derselben Sprache
        // wie die Leiste, aus der der Knoten kommt. Bei den kleinen Arten zaehlt das doppelt - ihre
        // Beschriftung steht UNTER der Form und waere sonst breiter als der Knoten selbst.
        int tool = Array.FindIndex(Palette, p => p.Kind == kind);
        node.Name = tool >= 0 ? Palette[tool].Label : kind.ToString();
        (double w, double h) = GraphLayout.SizeOf(kind);
        if (dropX.HasValue && dropY.HasValue)
        {
            // Aus der Toolbox gezogen: der Knoten entsteht MITTIG unter dem Zeiger. Die Groesse kommt
            // vom Layout, weil sie je Art verschieden ist - mit einem festen Versatz laege ein Gateway
            // oder ein Fristen-Timer sichtbar neben der Stelle, auf die gezielt wurde.
            node.Diagram = new DiagramShape
            {
                X = Math.Round(dropX.Value - (w / 2), 1),
                Y = Math.Round(dropY.Value - (h / 2), 1)
            };
        }
        else
        {
            // Ueber die Schaltflaeche angelegt: in die Mitte des aktuellen Sichtfensters (leicht
            // kaskadiert), damit er auch bei gezoomtem/verschobenem Canvas sichtbar landet.
            int cascade = def.Nodes.Count % 6;
            node.Diagram = new DiagramShape
            {
                X = Math.Round(viewX + (viewW / 2) - (w / 2) + (cascade * 24), 1),
                Y = Math.Round(viewY + (viewH / 2) - (h / 2) + (cascade * 24), 1)
            };
        }

        def.Nodes.Add(node);
        def.RebuildIndex();

        selectedFlow = null;
        selectedNode = node;
        return node;
    }

    /// <summary>Loescht das aktuell gewaehlte Element (Knoten oder Kante).</summary>
    private void DeleteSelected()
    {
        if (selectedNode is not null)
        {
            DeleteSelectedNode();
        }
        else if (selectedFlow is not null)
        {
            DeleteSelectedFlow();
        }
    }

    private void DeleteSelectedNode()
    {
        if (def is null || selectedNode is null)
        {
            return;
        }

        string id = selectedNode.Id;
        def.Nodes.Remove(selectedNode);
        // Ids merken, BEVOR die Kanten weg sind: die Kanten, die AUF diesen Knoten zeigen, koennen
        // Fehler-/Default-Ausgang eines Knotens sein, der stehen bleibt.
        List<string> removedFlowIds = def.Flows.Where(f => f.SourceId == id || f.TargetId == id)
            .Select(f => f.Id).ToList();
        def.Flows.RemoveAll(f => f.SourceId == id || f.TargetId == id);
        ForgetFlows(removedFlowIds);
        def.RebuildIndex();
        selectedNode = null;
    }

    private void DeleteSelectedFlow()
    {
        if (def is null || selectedFlow is null)
        {
            return;
        }

        def.Flows.Remove(selectedFlow);
        ForgetFlows(new[] { selectedFlow.Id });
        selectedFlow = null;
    }

    /// <summary>
    /// Loescht Verweise auf nicht mehr existierende Kanten (<c>ErrorFlowId</c> / <c>DefaultFlowId</c>).
    /// Ohne das bleibt eine verwaiste Id am Knoten stehen: der Graph sieht sauber aus, die Instanz
    /// faultet aber zur Laufzeit, weil der Ausgang ins Leere zeigt.
    /// </summary>
    private void ForgetFlows(IEnumerable<string> flowIds)
    {
        if (def is null)
        {
            return;
        }

        var gone = new HashSet<string>(flowIds.Where(x => !string.IsNullOrEmpty(x)), StringComparer.Ordinal);
        if (gone.Count == 0)
        {
            return;
        }

        foreach (WorkflowNode n in def.Nodes)
        {
            switch (n)
            {
                case AutomatedActivityNode a when a.ErrorFlowId is not null && gone.Contains(a.ErrorFlowId):
                    a.ErrorFlowId = null;
                    break;
                case CallWorkflowNode c when c.ErrorFlowId is not null && gone.Contains(c.ErrorFlowId):
                    c.ErrorFlowId = null;
                    break;
                case ExclusiveGatewayNode x when x.DefaultFlowId is not null && gone.Contains(x.DefaultFlowId):
                    x.DefaultFlowId = null;
                    break;
            }
        }
    }

    /// <summary>Der Fehler-Ausgang eines Knotens, oder null (auch bei Arten, die keinen kennen).</summary>
    private static string? ErrorFlowOf(WorkflowNode node) => node switch
    {
        AutomatedActivityNode a => a.ErrorFlowId,
        CallWorkflowNode c => c.ErrorFlowId,
        _ => null
    };

    private static void SetErrorFlowOf(WorkflowNode node, string? flowId)
    {
        switch (node)
        {
            case AutomatedActivityNode a:
                a.ErrorFlowId = flowId;
                break;
            case CallWorkflowNode c:
                c.ErrorFlowId = flowId;
                break;
        }
    }

    /// <summary>Beschreibt die aktuelle Auswahl fuer die Bedienleiste.</summary>
    private string SelectionLabel()
    {
        if (selectedNode is not null)
        {
            return $"Node: {(string.IsNullOrEmpty(selectedNode.Name) ? selectedNode.Id : selectedNode.Name)}";
        }

        if (selectedFlow is not null)
        {
            return $"Connection: {NodeName(selectedFlow.SourceId)} → {NodeName(selectedFlow.TargetId)}";
        }

        return string.Empty;
    }

    /// <summary>Exportiert die aktuelle Definition als (portable) JSON-Datei (Browser-Download).</summary>
    private async Task ExportToFile()
    {
        if (def is null)
        {
            return;
        }

        try
        {
            string json = WorkflowJson.ExportDefinition(def);
            await JS.InvokeVoidAsync("itvWfEditor.downloadText", $"{def.Id}-v{def.Version}.json", json);
        }
        catch (Exception ex)
        {
            LogEnvironment.LogEvent($"Workflow-Editor: Export fehlgeschlagen: {ex.OutlineException()}",
                LogSeverity.Warning);
            Snackbar.Add("Export failed.", Severity.Error);
        }
    }

    /// <summary>
    /// Importiert eine Definition aus einer JSON-Datei in den Editor (ersetzt die Zeichenflaeche). Es wird
    /// NICHT automatisch gespeichert - der Autor prueft und speichert selbst (Id/Version aus der Toolbar).
    /// </summary>
    private async Task ImportFromFile(InputFileChangeEventArgs e)
    {
        if (e.File is null)
        {
            return;
        }

        try
        {
            using var reader = new StreamReader(e.File.OpenReadStream(maxAllowedSize: 8 * 1024 * 1024));
            string json = await reader.ReadToEndAsync();
            WorkflowDefinition imported = WorkflowJson.ImportDefinition(json);
            if (imported?.Nodes is null)
            {
                Snackbar.Add("This file is not a valid workflow definition.", Severity.Error);
                return;
            }

            def = imported;
            EnsureDiagram(def);
            selectedNode = null;
            selectedFlow = null;
            issues = WorkflowDefinitionValidator.Validate(def).ToList();
            Fit();
            Snackbar.Add("Imported. Review, set id/version, and Save to persist.", Severity.Success);
        }
        catch (Exception ex)
        {
            LogEnvironment.LogEvent($"Workflow-Editor: Import fehlgeschlagen: {ex.OutlineException()}",
                LogSeverity.Warning);
            Snackbar.Add("Import failed: not a valid workflow JSON.", Severity.Error);
        }
    }

    /// <summary>Prueft die Definition ohne zu speichern und zeigt die Befunde an.</summary>
    private void ValidateOnly()
    {
        if (def is null)
        {
            return;
        }

        issues = WorkflowDefinitionValidator.Validate(def).ToList();
        if (issues.Count == 0)
        {
            Snackbar.Add("No issues found.", Severity.Success);
        }
    }

    /// <summary>
    /// Speichert die Definition. Bei Fehlern (nicht Warnungen) wird abgebrochen und die Liste
    /// angezeigt. <paramref name="asNewVersion"/> hebt die Version auf die naechste nach der hoechsten
    /// bestehenden - so bleibt die alte Version (und die daran laufenden Instanzen) unangetastet.
    /// </summary>
    private async Task Save(bool asNewVersion)
    {
        if (def is null)
        {
            return;
        }

        if (string.IsNullOrWhiteSpace(def.Id))
        {
            Snackbar.Add("An id is required.", Severity.Warning);
            return;
        }

        // Fehlerhafte Definitionen sind speicherbar (Zwischenstand), werden aber als „nicht startbar"
        // markiert - die Engine verweigert dann den Start. Nur Fehler setzen das Flag, Warnungen nicht.
        issues = WorkflowDefinitionValidator.Validate(def).ToList();
        bool hasErrors = issues.Any(i => i.Severity == ValidationSeverity.Error);
        def.DisabledForStart = hasErrors;

        var auth = await AuthState.GetAuthenticationStateAsync();
        if (asNewVersion)
        {
            WorkflowDefinition? latest = await Handler.GetDefinitionAsync(auth.User, def.Id, null, Environment);
            def.Version = (latest?.Version ?? def.Version) + 1;
        }

        bool ok = await Handler.SaveDefinitionAsync(auth.User, def, Environment);
        if (ok)
        {
            if (hasErrors)
            {
                Snackbar.Add($"Saved '{def.Id}' v{def.Version} WITH ERRORS — it is disabled for start until "
                             + "the errors are fixed.", Severity.Warning);
            }
            else
            {
                Snackbar.Add($"Definition '{def.Id}' v{def.Version} saved", Severity.Success);
            }

            isNew = false;
            // Die Fehlerliste bleibt sichtbar, wenn gespeichert-mit-Fehlern; sonst leeren.
            if (!hasErrors)
            {
                issues = new List<ValidationIssue>();
            }

            // Relativ (ohne fuehrenden Slash) - loest gegen <base href="/{tenant}/"> auf; ein
            // fuehrender Slash verliesse den Tenant und ergaebe 404.
            Nav.NavigateTo($"{EnvPrefix}/Definitions/{Uri.EscapeDataString(def.Id)}/{def.Version}/edit");
        }
        else
        {
            Snackbar.Add("Could not save (see log / permissions).", Severity.Error);
        }
    }

    private void Back()
    {
        Nav.NavigateTo($"{EnvPrefix}/Definitions");
    }

    // --- View (zoom / pan / fit) -------------------------------------------------------------

    private const double MinViewW = 200;
    private const double MaxViewW = 20000;

    /// <summary>Zoomt um die Mitte des Sichtfensters. factor &lt; 1 = hineinzoomen.</summary>
    private void ZoomBy(double factor)
    {
        double cx = viewX + viewW / 2;
        double cy = viewY + viewH / 2;
        double newW = Math.Clamp(viewW * factor, MinViewW, MaxViewW);
        double ratio = viewW == 0 ? 1 : newW / viewW;
        double newH = viewH * ratio;
        viewW = newW;
        viewH = newH;
        viewX = cx - viewW / 2;
        viewY = cy - viewH / 2;
    }

    /// <summary>
    /// Setzt das Sichtfenster so, dass der ganze Graph (mit Rand) hineinpasst. preserveAspectRatio des
    /// SVG haelt dabei das Seitenverhaeltnis - der Ausschnitt wird also ins Host-Element eingepasst.
    /// </summary>
    private void Fit()
    {
        if (def is null || def.Nodes.Count == 0)
        {
            viewX = 0;
            viewY = 0;
            viewW = 1200;
            viewH = 800;
            return;
        }

        GraphLayout layout = GraphLayout.Compute(def);
        double minX = double.MaxValue, minY = double.MaxValue, maxX = double.MinValue, maxY = double.MinValue;
        foreach (LaidOutNode n in layout.Nodes)
        {
            minX = Math.Min(minX, n.X);
            minY = Math.Min(minY, n.Y);
            maxX = Math.Max(maxX, n.X + n.Width);
            // Etwas Luft nach unten fuer die Beschriftung unter Ellipse/Diamant.
            maxY = Math.Max(maxY, n.Y + n.Height + 18);
        }

        if (minX > maxX || minY > maxY)
        {
            viewX = 0;
            viewY = 0;
            viewW = 1200;
            viewH = 800;
            return;
        }

        const double pad = 50;
        viewX = minX - pad;
        viewY = minY - pad;
        viewW = Math.Max(MinViewW, (maxX - minX) + 2 * pad);
        viewH = Math.Max(150, (maxY - minY) + 2 * pad);
    }

    // --- Helpers -----------------------------------------------------------------------------

    private static string NewId(string prefix) => prefix + Guid.NewGuid().ToString("N").Substring(0, 8);

    private string NodeName(string? id)
    {
        WorkflowNode? n = id is null ? null : def?.GetNode(id);
        return n is null ? (id ?? "?") : (string.IsNullOrEmpty(n.Name) ? n.Id : n.Name);
    }

    private static void EnsureDiagram(WorkflowDefinition definition)
    {
        if (definition.Nodes.Count == 0 || definition.Nodes.All(n => n.Diagram != null))
        {
            return;
        }

        // Fehlende Positionen aus dem automatischen Layout materialisieren, damit im Editor jeder
        // Knoten eine feste (ziehbare) Position hat.
        GraphLayout layout = GraphLayout.Compute(definition);
        var byId = layout.Nodes.ToDictionary(n => n.Id, n => n);
        foreach (WorkflowNode node in definition.Nodes)
        {
            if (node.Diagram == null && node.Id != null && byId.TryGetValue(node.Id, out LaidOutNode? laid))
            {
                node.Diagram = new DiagramShape { X = laid.X, Y = laid.Y };
            }
        }
    }

    private static string N(double value) => value.ToString(CultureInfo.InvariantCulture);

    private MarkupString CanvasBody()
    {
        var sb = new StringBuilder();
        if (def is null)
        {
            return new MarkupString(string.Empty);
        }

        GraphLayout layout = GraphLayout.Compute(def);

        // Fehler-Kanten einmal einsammeln: sie werden rot gezeichnet, damit der Graph den Fehlerpfad
        // selbst zeigt, statt ihn nur im Eigenschaften-Panel zu behaupten.
        var errorFlowIds = new HashSet<string>(StringComparer.Ordinal);
        foreach (WorkflowNode n in def.Nodes)
        {
            string? errorFlowId = ErrorFlowOf(n);
            if (!string.IsNullOrEmpty(errorFlowId))
            {
                errorFlowIds.Add(errorFlowId);
            }
        }

        // Fristen-Timer haengen am Rand ihres Schritts; ihre Position ist ABGELEITET (GraphLayout
        // .DockBoundaryTimers hat sie oben schon gesetzt). Damit sie auch WAEHREND des Ziehens am Schritt
        // kleben, bekommt jeder Timer den fertigen Versatz zu seinem Host mit ins Markup - die JS-Seite
        // rechnet ihn nur noch auf die neue Host-Position drauf. Bewusst der Versatz statt der Andock-
        // Formel: sonst laege dieselbe Regel ein zweites Mal in graph-editor.js und beide koennten
        // auseinanderlaufen (wie beim Kanten-Routing, das genau deshalb doppelt gepflegt werden muss).
        var dockHostOf = new Dictionary<string, string>(StringComparer.Ordinal);
        foreach (BoundaryTimerNode timer in def.Nodes.OfType<BoundaryTimerNode>())
        {
            if (!string.IsNullOrEmpty(timer.Id) && !string.IsNullOrEmpty(timer.AttachedToNodeId))
            {
                dockHostOf[timer.Id!] = timer.AttachedToNodeId!;
            }
        }

        var laidById = layout.Nodes.Where(n => n.Id != null).ToDictionary(n => n.Id!, n => n, StringComparer.Ordinal);

        // Kanten zuerst (liegen unter den Knoten).
        foreach (LaidOutEdge edge in layout.Edges)
        {
            bool sel = selectedFlow != null && edge.Id == selectedFlow.Id;
            bool err = errorFlowIds.Contains(edge.Id);
            // Rot schlaegt die Auswahlfarbe - die Fehler-Eigenschaft ist dauerhaft, die Auswahl nicht;
            // ausgewaehlt wird deshalb ueber die Strichstaerke gezeigt.
            string stroke = err ? "var(--mud-palette-error)"
                : sel ? "var(--mud-palette-primary)" : "var(--mud-palette-lines-default)";
            string width = sel ? "2.5" : "1.5";
            string marker = err ? "wf-arrow-err" : "wf-arrow-ed";
            // Unsichtbarer, breiter Zwilling: eine 1.5px-Linie mit vielen Ecken ist sonst kaum zu
            // treffen. Er traegt dieselben data-Attribute und wird deshalb mitgezeichnet und mit-getroffen.
            sb.Append($"<path data-wf-edge data-edge-id=\"{Enc(edge.Id)}\" data-source=\"{Enc(edge.SourceId)}\" data-target=\"{Enc(edge.TargetId)}\" ")
              .Append($"data-err=\"{(err ? "1" : "0")}\" data-src-off=\"{N(edge.SourceOffset)}\" data-tgt-off=\"{N(edge.TargetOffset)}\" ")
              .Append($"d=\"{edge.PathData}\" fill=\"none\" stroke=\"transparent\" stroke-width=\"12\" ")
              .Append("pointer-events=\"stroke\" style=\"cursor:pointer\" />");

            // Der Pfad wird waehrend des Ziehens client-seitig neu berechnet; data-err sagt der
            // JS-Seite, dass diese Kante am festen Fehler-Port haengt, data-src-off/-tgt-off die Spur.
            sb.Append($"<path data-wf-edge data-edge-id=\"{Enc(edge.Id)}\" data-source=\"{Enc(edge.SourceId)}\" data-target=\"{Enc(edge.TargetId)}\" ")
              .Append($"data-err=\"{(err ? "1" : "0")}\" data-src-off=\"{N(edge.SourceOffset)}\" data-tgt-off=\"{N(edge.TargetOffset)}\" ")
              .Append($"d=\"{edge.PathData}\" fill=\"none\" stroke-linejoin=\"round\" ")
              .Append($"stroke=\"{stroke}\" stroke-width=\"{width}\" marker-end=\"url(#{marker})\" style=\"cursor:pointer\" />");
            if (!string.IsNullOrEmpty(edge.Label))
            {
                AppendText(sb, edge.LabelX, edge.LabelY - 4, "middle", "var(--mud-palette-text-secondary)", 11, edge.Label!, null);
            }
        }

        // Knoten als verschiebbare Gruppen (lokale Koordinaten, Position via translate).
        foreach (LaidOutNode node in layout.Nodes)
        {
            bool sel = selectedNode != null && node.Id == selectedNode.Id;
            // Die eigene Konturfarbe (Fristen-Timer: unterbrechend/nicht) schlaegt die Auswahlfarbe -
            // dieselbe Regel wie bei den Fehler-Kanten: die Eigenschaft ist dauerhaft, die Auswahl
            // nicht. Ausgewaehlt zeigt deshalb die Strichstaerke.
            string stroke = node.OutlineColor
                ?? (sel ? "var(--mud-palette-primary)" : "var(--mud-palette-lines-default)");
            string strokeWidth = sel ? "3" : (node.OutlineColor != null ? "2" : "1.5");
            string dash = node.DashedOutline ? " stroke-dasharray=\"5 3\"" : string.Empty;
            string fill = "var(--mud-palette-surface)";
            string style = $"fill=\"{fill}\" stroke=\"{stroke}\" stroke-width=\"{strokeWidth}\"{dash}";
            double w = node.Width;
            double h = node.Height;

            // Angedockter Fristen-Timer: Host + Versatz mitgeben. Damit zieht die JS-Seite ihn mit, wenn
            // sein Schritt bewegt wird, ohne die Andock-Formel ein zweites Mal zu kennen.
            string dock = string.Empty;
            if (node.Id != null && dockHostOf.TryGetValue(node.Id, out string? dockHostId)
                && laidById.TryGetValue(dockHostId, out LaidOutNode? dockHost))
            {
                dock = $" data-wf-dock-host=\"{Enc(dockHostId)}\" data-wf-dock-dx=\"{N(node.X - dockHost.X)}\""
                       + $" data-wf-dock-dy=\"{N(node.Y - dockHost.Y)}\"";
            }

            // Ein Schritt, an dem ein Fristen-Timer haengen darf. Die Regel gehoert dem Modell
            // (BoundaryTimerNode.CanHost) - hier steht nur ihr Ergebnis, damit die JS-Seite beim Ziehen
            // sofort weiss, wo sie ein Andocken anbieten darf, ohne dafuer zurueckzufragen.
            if (BoundaryTimerNode.CanHost(def.GetNode(node.Id)))
            {
                dock += " data-wf-dock-target=\"1\"";
            }

            sb.Append($"<g data-wf-node data-node-id=\"{Enc(node.Id)}\" data-wf-kind=\"{node.Kind}\" ")
              .Append($"data-w=\"{N(w)}\" data-h=\"{N(h)}\"{dock} transform=\"translate({N(node.X)},{N(node.Y)})\">");

            switch (node.Shape)
            {
                case NodeShape.Ellipse:
                    sb.Append($"<ellipse cx=\"{N(w / 2)}\" cy=\"{N(h / 2)}\" rx=\"{N(w / 2)}\" ry=\"{N(h / 2)}\" {style} />");
                    break;
                case NodeShape.Diamond:
                    sb.Append($"<polygon points=\"{N(w / 2)},0 {N(w)},{N(h / 2)} {N(w / 2)},{N(h)} 0,{N(h / 2)}\" {style} />");
                    break;
                case NodeShape.Hexagon:
                    double k = GraphLayout.HexagonInset(w, h);
                    sb.Append($"<polygon points=\"{N(k)},0 {N(w - k)},0 {N(w)},{N(h / 2)} {N(w - k)},{N(h)} {N(k)},{N(h)} 0,{N(h / 2)}\" {style} />");
                    break;
                case NodeShape.Rectangle:
                    sb.Append($"<rect x=\"0\" y=\"0\" width=\"{N(w)}\" height=\"{N(h)}\" {style} />");
                    break;
                default:
                    sb.Append($"<rect x=\"0\" y=\"0\" width=\"{N(w)}\" height=\"{N(h)}\" rx=\"8\" ry=\"8\" {style} />");
                    break;
            }

            if (node.Symbol is { } symbol)
            {
                AppendText(sb, w / 2, h / 2, "middle", "var(--mud-palette-text-primary)",
                    symbol.FontSize, symbol.Text, "central");
            }

            if (node.LabelBelow)
            {
                AppendText(sb, w / 2, h + 13, "middle", "var(--mud-palette-text-primary)", 11, node.Label, null);
            }
            else
            {
                AppendText(sb, w / 2, h / 2, "middle", "var(--mud-palette-text-primary)", 12, Clip(node.Label), "central");
            }

            // Ausgangs-Port(s), an denen Verbindungen gezogen werden. Knoten mit Fehlerbehandlung
            // bekommen zwei: gruen = Erfolgspfad (rechte Mitte), rot = Fehlerpfad (rechts unten).
            // So entsteht der Fehler-Ausgang beim Ziehen und muss nicht hinterher zugeordnet werden.
            if (SupportsErrorFlow(node.Kind))
            {
                AppendPort(sb, w, h / 2, "out", "var(--mud-palette-success)", "Success output");
                AppendPort(sb, w, h * 0.85, "err", "var(--mud-palette-error)", "Error output");
            }
            else
            {
                AppendPort(sb, w, h / 2, "out", "var(--mud-palette-primary)", "Output");
            }

            sb.Append("</g>");
        }

        return new MarkupString(sb.ToString());
    }

    /// <summary>Zeichnet einen Ausgangs-Port. <paramref name="kind"/> landet als Port-Art im Drag.</summary>
    private static void AppendPort(StringBuilder sb, double cx, double cy, string kind, string fill, string title)
    {
        sb.Append($"<circle data-wf-port=\"{kind}\" cx=\"{N(cx)}\" cy=\"{N(cy)}\" r=\"5\" fill=\"{fill}\" ")
          .Append("stroke=\"var(--mud-palette-surface)\" stroke-width=\"1\">")
          .Append($"<title>{Enc(title)}</title></circle>");
    }

    /// <summary>Knotenarten mit Fehler-Ausgang - nur sie bekommen den zweiten (roten) Port.</summary>
    private static bool SupportsErrorFlow(NodeKind kind)
        => kind is NodeKind.AutomatedActivity or NodeKind.CallWorkflow;

    private static void AppendText(StringBuilder sb, double x, double y, string anchor, string fill, int fontSize,
        string content, string? baseline)
    {
        sb.Append($"<text x=\"{N(x)}\" y=\"{N(y)}\" text-anchor=\"{anchor}\" fill=\"{fill}\" font-size=\"{fontSize}\" style=\"pointer-events:none; user-select:none\"");
        if (baseline != null)
        {
            sb.Append($" dominant-baseline=\"{baseline}\"");
        }

        sb.Append('>').Append(Enc(content)).Append("</text>");
    }

    private static string Enc(string? s) => WebUtility.HtmlEncode(s ?? string.Empty);

    private static string Clip(string label) => label.Length <= 18 ? label : label.Substring(0, 16) + "…";

    public async ValueTask DisposeAsync()
    {
        if (jsAttached)
        {
            jsAttached = false;
            try { await JS.InvokeVoidAsync("itvWfEditor.detach", hostEl); }
            catch (Microsoft.JSInterop.JSDisconnectedException ex)
            {
                // Erwarteter Normalfall: Circuit schon weg, damit auch die Listener.
                LogEnvironment.LogEvent(
                    $"Workflow-Editor: detach uebersprungen, Circuit bereits beendet: {ex.Message}",
                    LogSeverity.Report);
            }
            catch (Exception ex)
            {
                LogEnvironment.LogEvent(
                    $"Workflow-Editor: JS-Interop nicht sauber geloest: {ex.OutlineException()}",
                    LogSeverity.Warning);
            }
        }

        selfRef?.Dispose();
    }
}
